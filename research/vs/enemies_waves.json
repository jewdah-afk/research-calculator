    "scaling": {
      "hpXLevelSkill": "Enemies whose `skills` list contains HP_x_Level have their health multiplied by a level factor at spawn; per the wiki this is the PLAYER's level at the moment of spawn and is not updated afterwards. Among Mad Forest entities this covers BAT4, BAT5, FLOWER and every BOSS_ entry.",
      "enemyLevelField": "Each enemy record carries its own `level` (1 for most trash, 10 for the XL enemies, 15/30/100 for bosses). Whether this multiplies health directly or only interacts with HP_x_Level is not documented in the data; recorded as unknown.",
      "normalEnemies": "scale primarily with elapsed run time (wave table), not with player level",
      "bossesAndMinibosses": "scale with both time and player level",
      "curse": "increases enemy Max Health, MoveSpeed and spawn frequency; health multiplier applies to newly spawned enemies only",
      "hyperMode": "increases minimum enemies spawned and enemy move speed; see hyperModifiers above for Mad Forest's shipped values",
      "endlessMode": "enemies gain 100% of base Max Health per cycle",
      "inverseMode": "Mad Forest inverse: +200% enemy health, +5% HP and +0.005 speed per minute (shipped timeMods)",
      "sourceIds": [
        "game-data-v1.16",
        "official-wiki-enemies",
        "official-wiki-curse",
        "official-wiki-stages"
      ]
    },
