  "conflicts": [
    {
      "field": "data.enemies[Zombie].health",
      "values": [
        1,
        10
      ],
      "sourceIds": [
        "game-data-v1.16-enemy",
        "official-wiki-enemies"
      ],
      "note": "Shipped data gives maxHp 1 for ZOMBIE; a wiki snippet gives Health 10. Wiki statboxes appear to show a scaled/display value (roughly 10x) rather than the raw maxHp field. Power 10, speed 100, knockback 0.8 and xp 1 agree exactly between the two, so only the health figure diverges. Which is the in-play number is unresolved."
    },
    {
      "field": "data.enemies[The Reaper].health",
      "values": [
        65535,
        655350
      ],
      "sourceIds": [
        "game-data-v1.16-enemy",
        "fandom-reaper"
      ],
      "note": "Shipped data: maxHp 65535, level 100, skill HP_x_Level. Wiki/community: 655350 multiplied by the player's level at spawn. Same 10x display discrepancy as Zombie. Power 65535 and speed 1200 agree."
    }
  ],
