{
  "name": "MilestoneTree",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "TowerNum": {
        "$path": "vendor/TowerNum.luau",
        "Hyper": { "$path": "vendor/hyper/Hyper.luau" },
        "LICENSE": { "$path": "vendor/LICENSE.luau" }
      },
      "MilestoneTree": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "MilestoneTree": { "$path": "src/server" }
    },
    "ServerStorage": {
      "MilestoneTreeWorker": { "$path": "src/worker" }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "DevComputerMovementMode": "Scriptable",
        "DevTouchMovementMode": "Scriptable",
        "AutoJumpEnabled": false
      },
      "StarterPlayerScripts": {
        "MilestoneTree": { "$path": "src/client" }
      }
    },
    "StarterGui": {
      "$properties": { "ScreenOrientation": "LandscapeSensor" }
    },
    "Players": {
      "$properties": { "CharacterAutoLoads": false }
    },
    "Lighting": {
      "$properties": { "Ambient": [0.2, 0.2, 0.2], "Brightness": 1 }
    }
  }
}
