	end
	if (l == "p") then
		do return end
	end
	if (l == "sp") then
		if player.m.best:gte(26) then
			layerDataReset(nil, "p", JS.A(1, "upgrades"))
		else
			layerDataReset(nil, "p", JS.A(0))
		end
	end
	if (l == "pb") then
