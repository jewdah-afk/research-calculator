end,
	doReset = function(this, l)
	if (l == "pb") then
		do return end
	end
	if (l == "hp") then
		if player.m.best:gte(70) then
			layerDataReset(nil, "pb", JS.A(1, "upgrades"))
		else
			layerDataReset(nil, "pb", JS.A(0))
		end
	end
	if (l == "ap") then
		if player.m.best:gte(81) then
