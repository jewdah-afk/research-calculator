      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">PrefsSchema</string>
          <string name="Source"><![CDATA[--!strict
--[[
	PrefsSchema: the device options, one table for the client (Core/Prefs) and the server (Main: validation and the
	store), so the two can never disagree. They are not part of the game save.

	    motion        SYSTEM | FULL | REDUCED
	    detail        AUTO | HIGH | LOW (the map's texture set)
	    labels        AUTO | ALWAYS | OFF
	    size          90 | 100 | 115 (Interface size, %)
	    weather       OFF | RESETS | AMBIENT (weather on resets; AMBIENT also plays now and then on its own)
	    guide         ON | OFF (hints for significant moments only)
	    notation      SUFFIX | SCIENTIFIC (how numbers read: 1.23M or 1.23e6; the server formats them)
	    tut           0 to 8: the first-run tutorial's next step (8 = done or skipped; Options › Tutorial › Replay sets 0)
	    music, sfx, ambience   0 to 100 in steps of 10
	    seenPrestige  the layers whose first prestige has played its big moment (a list of layer ids)

	A key missing from a stored table takes its default, so saves from before a key existed still load. Unknown keys
	are dropped; a wrong value falls back to the default rather than throwing the whole table away.
]]

local PrefsSchema = {}

local function steps(from: number, to: number, by: number): { number }
	local t = {}
	for v = from, to, by do table.insert(t, v) end
	return t
end

PrefsSchema.CHOICES = {
	motion = { "SYSTEM", "FULL", "REDUCED" },
	detail = { "AUTO", "HIGH", "LOW" },
	labels = { "AUTO", "ALWAYS", "OFF" },
	size = { 90, 100, 115 },
	weather = { "OFF", "RESETS", "AMBIENT" },
	guide = { "ON", "OFF" },
	notation = { "SUFFIX", "SCIENTIFIC" },
	tut = steps(0, 8, 1),
	music = steps(0, 100, 10),
	sfx = steps(0, 100, 10),
	ambience = steps(0, 100, 10),
} :: { [string]: { any } }

PrefsSchema.DEFAULTS = {
	motion = "SYSTEM",
	detail = "AUTO",
	labels = "AUTO",
	size = 100,
	weather = "RESETS",
	guide = "ON",
	notation = "SUFFIX",
	tut = 0,
	music = 60,
	sfx = 70,
	ambience = 60,
} :: { [string]: any }

-- the list keys: at most MAX_SEEN short lowercase layer ids
PrefsSchema.MAX_SEEN = 32

function PrefsSchema.valid(key: string, value: any): boolean
	if key == "seenPrestige" then
		if type(value) ~= "table" then return false end
		local n = 0
		for i, id in value do
			n += 1
			if type(i) ~= "number" or type(id) ~= "string" or #id > 4 or not string.match(id, "^%l+$") then return false end
		end
		return n <= PrefsSchema.MAX_SEEN and n == #value
	end
	local list = PrefsSchema.CHOICES[key]
	return list ~= nil and table.find(list, value) ~= nil
end

-- a full, valid table from anything (a client message or a stored record); nil only when it is not a table
function PrefsSchema.clean(t: any): { [string]: any }?
	if type(t) ~= "table" then return nil end
	local out: { [string]: any } = {}
	for key, default in PrefsSchema.DEFAULTS do
		local v = t[key]
		out[key] = if v ~= nil and PrefsSchema.valid(key, v) then v else default
	end
	local seen = t.seenPrestige
	out.seenPrestige = if seen ~= nil and PrefsSchema.valid("seenPrestige", seen) then table.clone(seen) else {}
	return out
end

function PrefsSchema.defaults(): { [string]: any }
	return PrefsSchema.clean({}) :: { [string]: any }
end

return PrefsSchema
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Products</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Products: the game passes and developer products, one table for the server (ownership, receipts, perks) and the
	client (the Shop). The ids (and the icon image ids) are filled by port/tools/products.js once they exist on Roblox
	(Open Cloud), or by hand from the Creator Dashboard (Monetization > Passes / Developer Products). An item without
	an id shows as "Coming soon" and cannot be bought.

	Passes (one-time):
	    speed      2x Speed      the whole game runs twice as fast (the game's own devSpeed: every second counts as 2)
	    supporter  Supporter     a gold SUPPORTER tag on the points bar and a gold rim; a thank-you
	Products (consumable):
	    warp1 / warp8 / warp24   Time Warp: 1, 8 or 24 hours of progress at once (fed through the next ticks the way
	                             the game catches up offline time)
]]

export type Pass = { key: string, id: number?, name: string, price: number, blurb: string, icon: number?, speed: number? }
export type Product = { key: string, id: number?, name: string, price: number, blurb: string, icon: number?, warp: number? }

local Products = {}

Products.passes = {
	{ key = "speed", id = 1998278588, icon = 124365077861444, name = "2x Speed", price = 399, speed = 2,
		blurb = "The whole game runs twice as fast, forever. Offline time and Time Warps count double too." },
	{ key = "supporter", id = 1998128578, icon = 99548373984898, name = "Supporter", price = 99,
		blurb = "A gold SUPPORTER tag on your points bar and a gold rim. Thank you for supporting the game!" },
} :: { Pass }

Products.products = {
	{ key = "warp1", id = 3714803203, icon = 134852138466837, name = "Time Warp · 1 hour", price = 29, warp = 3600,
		blurb = "1 hour of progress, right now." },
	{ key = "warp8", id = 3714803208, icon = 110877194725457, name = "Time Warp · 8 hours", price = 149, warp = 8 * 3600,
		blurb = "8 hours of progress, right now." },
	{ key = "warp24", id = 3714803211, icon = 118614298139912, name = "Time Warp · 24 hours", price = 349, warp = 24 * 3600,
		blurb = "A whole day of progress, right now." },
} :: { Product }

function Products.pass(key: string): Pass?
	for _, p in Products.passes do
		if p.key == key then return p end
	end
	return nil
end
function Products.passById(id: number): Pass?
	for _, p in Products.passes do
		if p.id == id then return p end
	end
	return nil
end
function Products.productById(id: number): Product?
	for _, p in Products.products do
		if p.id == id then return p end
	end
	return nil
end

return Products
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Realm</string>
          <string name="Source"><![CDATA[--!strict
-- GENERATED by art/roblox/realm_luau.js from art/realm.json + art/edges.json. Do not edit by hand:
--   cd art && node roblox/realm_luau.js          (--check fails when this file is stale)
-- The realm contract of art/REALM.md for the client: camera constants and feel (2, 9.4); layers back to front
-- (1; `back` = the layer has a Back container for a corrupt bloom, centred at bloom.at = realm.json `local`); biome
-- weights and colours (5); ambient sprite groups with their resolved instances (6.1, 6.2; LOW uses the first
-- count.LOW); particle fields (6.3; LOW uses low = 1); the node sockets (art keys: the game id cp is the socket cr);
-- the live connections and the rift hotspot (art/edges.json; ids are game ids). Distances are world px or
-- layer-local px, colours 0..255 RGB.

export type RGB = { number }
export type Channel = { ch: string, type: string, amp: number?, period: number?, phase: number?, speed: number?, from: number?,
	to: number?, a: number?, b: number?, dur: number?, ease: string?, slot: number?, seed: number?, out: string? }
export type Instance = { x: number, y: number, s: number, h: number?, len: number?, t: number?, a: number?, r: number?,
	c: number?, m: { Channel } }
export type SpriteColor = { realm: RGB, rift: RGB, corrupt: RGB }
export type SpriteGroup = { name: string, layer: string, regions: { string }, count: { HIGH: number, LOW: number },
	hangs: boolean, rmHide: boolean, flicker: boolean, palette: { RGB }?, color: SpriteColor?, instances: { Instance } }
export type Particle = { k: string, x: number, y: number, size: number, vx: number, vy: number, bx: number?, by: number?,
	bt: number?, bp: number?, a: number, ta: number?, tt: number?, tp: number?, c: number, tau: number, t: number?,
	cg: number, low: number }
export type FieldKind = { name: string, regions: { string }, palette: { RGB }, rift: RGB, corrupt: RGB }
export type Field = { id: string, f: number, cell: { number }, zHide: number, zShow: number, zFull: number,
	pool: { HIGH: number, LOW: number }, maxSize: number, maxBob: number, kinds: { FieldKind }, particles: { Particle } }
export type Layer = { id: string, depth: number, f: number, w: number, h: number, ax: number, ay: number, zHide: number,
	zShow: number, opaque: boolean, back: boolean, tint: RGB? }
export type Bloom = { layer: string, size: { number }, color: RGB, alpha: number, at: { number } }
export type Biome = {
	rift: { from: number, to: number },
	corrupt: { rect: { number }, cover: { number }, focus: { number }, light: { radius: { number }, falloff: { number } },
		bloom: { Bloom } },
	wash: { realm: { color: RGB, alpha: number }, rift: { color: RGB, alpha: number } },
	vignette: { color: RGB, alpha: number },
}
export type Domain = { minW: number, minH: number, maxW: number, maxH: number, minAspect: number, maxAspect: number }
export type Feel = { dragMouse: number, dragTouch: number, velocityTau: number, inertiaTau: number, inertiaStop: number,
	maxFling: number, pinchReleaseQuiet: number, rubberDistance: number, rubberC: number, rubberReturn: number, wheelFactor: number, wheelTau: number,
	pinchRubber: number, pinchReturn: number, doubleTapFactor: number, doubleTapSeconds: number, flySmoothTime: number,
	flyZoom: number, padSpeed: number, padDeadzone: number, padCurve: number, padZoomRate: number }
export type Edge = { from: string, to: string, p: { number } }
export type Realm = {
	version: string,
	world: { w: number, h: number },
	camera: { zMax: number, zoomSlack: number, overscroll: number, zoomOutFit: number, panMargin: { number }, domain: Domain, start: { number }, introFactor: number,
		introSeconds: number },
	feel: Feel,
	layers: { Layer },
	zOrder: { string },
	biome: Biome,
	palette: { [string]: RGB },
	sprites: { SpriteGroup },
	fields: { Field },
	nodes: { [string]: { number } },
	alias: { [string]: string },
	edges: { Edge },
	rift: { cx: number, cy: number, rx: number, ry: number, fly: { number } },
}

local Realm: Realm = {
	version = "0dc1814abc4a",
	world = { w = 3840, h = 2560 },
	camera = { zMax = 1.25, zoomSlack = 0.06, overscroll = 72, zoomOutFit = 0.96, panMargin = { 960, 720 }, domain = { minW = 568, minH = 320, maxW = 2560, maxH = 1440, minAspect = 0.45, maxAspect = 3.6 }, start = { 1500, 1150 }, introFactor = 1.12, introSeconds = 1.6 },
	feel = { dragMouse = 6, dragTouch = 12, velocityTau = 0.05, inertiaTau = 0.32, inertiaStop = 6, maxFling = 4500, pinchReleaseQuiet = 0.25, rubberDistance = 72, rubberC = 0.55, rubberReturn = 0.18, wheelFactor = 1.12, wheelTau = 0.085, pinchRubber = 0.06, pinchReturn = 0.2, doubleTapFactor = 1.6, doubleTapSeconds = 0.35, flySmoothTime = 0.35, flyZoom = 0.9, padSpeed = 1400, padDeadzone = 0.18, padCurve = 1.6, padZoomRate = 1.8 },
	layers = {
		{ id = "sky", depth = 0, f = 0.05, w = 2784, h = 1616, ax = 1392, ay = 808, zHide = 0, zShow = 0, opaque = true, back = false, tint = { 255, 196, 214 } },
		{ id = "clouds", depth = 1, f = 0.12, w = 3040, h = 1840, ax = 1520, ay = 920, zHide = 0, zShow = 0, opaque = false, back = true, tint = { 255, 170, 196 } },
		{ id = "far", depth = 2, f = 0.25, w = 3552, h = 2272, ax = 1776, ay = 1136, zHide = 0, zShow = 0, opaque = false, back = false, tint = { 255, 186, 205 } },
		{ id = "mid", depth = 3, f = 0.45, w = 4352, h = 2928, ax = 2176, ay = 1464, zHide = 0, zShow = 0, opaque = false, back = false, tint = { 255, 205, 215 } },
		{ id = "near", depth = 4, f = 0.7, w = 5440, h = 3920, ax = 2720, ay = 1960, zHide = 0, zShow = 0, opaque = false, back = true, tint = { 255, 220, 225 } },
		{ id = "world", depth = 5, f = 1, w = 3840, h = 2560, ax = 1920, ay = 1280, zHide = 0, zShow = 0, opaque = false, back = false },
		{ id = "fg", depth = 6, f = 1.3, w = 7600, h = 5380, ax = 3800, ay = 2690, zHide = 0.5, zShow = 0.62, opaque = false, back = false, tint = { 255, 225, 230 } },
	},
	zOrder = { "sky tiles", "sky sprites", "corrupt bloom clouds", "clouds tiles", "clouds sprites", "far tiles", "far sprites", "mid tiles", "mid sprites", "biome wash", "corrupt bloom near", "near tiles", "near sprites", "field motesFar", "world tiles", "world sprites", "fg tiles", "fg sprites", "field motesNear", "node links", "nodes", "field particles", "vignette" },
	biome = {
		rift = { from = 2300, to = 2600 },
		corrupt = { rect = { 3300, 700, 3840, 1700 }, cover = { 0.02, 0.22 }, focus = { 3620, 1180 }, light = { radius = { 420, 650 }, falloff = { 0.55, 1.25 } }, bloom = { { layer = "clouds", size = { 3200, 3400 }, color = { 60, 230, 120 }, alpha = 0.3, at = { 2375.2, 846.4 } }, { layer = "near", size = { 1900, 2500 }, color = { 40, 255, 110 }, alpha = 0.35, at = { 4132, 1869 } } } },
		wash = { realm = { color = { 70, 40, 140 }, alpha = 0.06 }, rift = { color = { 150, 20, 60 }, alpha = 0.12 } },
		vignette = { color = { 8, 4, 16 }, alpha = 0.55 },
	},
	palette = { void = { 7, 5, 13 }, dark = { 12, 6, 22 }, bark = { 34, 20, 62 }, violet = { 179, 92, 255 }, lilac = { 205, 182, 255 }, gold = { 255, 201, 60 }, cyan = { 95, 224, 255 }, crimson = { 255, 46, 99 }, ember = { 255, 90, 31 }, magenta = { 232, 70, 190 }, corrupt = { 57, 255, 20 }, corruptDeep = { 31, 191, 74 } },
	sprites = {
		{ name = "star_twinkle", layer = "sky", regions = { "star4", "stardot" }, count = { HIGH = 72, LOW = 28 }, hangs = false, rmHide = false, flicker = false, palette = { { 255, 255, 255 }, { 210, 190, 255 }, { 170, 220, 255 }, { 255, 225, 190 } }, instances = {
			{ x = 1475.4, y = 982.7, s = 20.6, t = 1, a = 0.685, c = 0, m = { { ch = "alpha", type = "sine", amp = 0.2967, period = 4.2055, phase = 0.4503 }, { ch = "scale", type = "sine", amp = 0.0784, period = 10.0611, phase = 0.42 } } },
			{ x = 1897.4, y = 259.9, s = 13.2, t = 0, a = 0.649, c = 1, m = { { ch = "alpha", type = "sine", amp = 0.3082, period = 2.6207, phase = 0.5971 }, { ch = "scale", type = "sine", amp = 0.0861, period = 7.5105, phase = 0.8443 } } },
			{ x = 2140.4, y = 513.3, s = 21.2, t = 0, a = 0.564, c = 2, m = { { ch = "alpha", type = "sine", amp = 0.3951, period = 3.1796, phase = 0.1465 }, { ch = "scale", type = "sine", amp = 0.0995, period = 7.0833, phase = 0.5534 } } },
			{ x = 2353.9, y = 231.4, s = 25.3, t = 1, a = 0.646, c = 0, m = { { ch = "alpha", type = "sine", amp = 0.1969, period = 4.9763, phase = 0.4973 }, { ch = "scale", type = "sine", amp = 0.0821, period = 6.6226, phase = 0.502 } } },
			{ x = 247.5, y = 1040.9, s = 10.8, t = 0, a = 0.709, c = 3, m = { { ch = "alpha", type = "sine", amp = 0.2742, period = 3.7384, phase = 0.3529 }, { ch = "scale", type = "sine", amp = 0.0439, period = 9.4004, phase = 0.4194 } } },
