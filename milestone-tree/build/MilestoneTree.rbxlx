            <string name="Name">utils_themes</string>
            <string name="Source"><![CDATA[--!nocheck
-- transpiled from utils/themes.js by port/build.js: do not edit
return function()
-- transpiled from utils/themes.js
changeTheme = function(this)
	colors_theme = colors[JS.k((if JS.t(options.theme) then options.theme else "default"))]
	document.body.style:setProperty("--background", colors_theme["background"])
	document.body.style:setProperty("--background_tooltip", colors_theme["background_tooltip"])
	document.body.style:setProperty("--color", colors_theme["color"])
	document.body.style:setProperty("--points", colors_theme["points"])
	document.body.style:setProperty("--locked", colors_theme["locked"])
end
getThemeName = function(this)
	do return (if JS.t(options.themeName) then options.themeName else "Default") end
end
switchTheme = function(this)
	local index = JS.m(themes, "indexOf", options.theme)
	if (((options.theme == JS.NULL) or (JS.tonum(index) >= (JS.len(themes) - 1))) or (JS.tonum(index) < 0)) then
		JS.setk(options, "theme", themes[0])
		JS.setk(options, "themeName", themeNames[0])
	else
		index = (JS.tonum(index) + 1)
		JS.setk(options, "theme", themes[JS.k(index)])
		JS.setk(options, "theme", themes[JS.k(index)])
		JS.setk(options, "themeName", themeNames[JS.k(index)])
		JS.setk(options, "themeName", themeNames[JS.k(index)])
	end
	changeTheme(nil)
	resizeCanvas(nil)
end
themes = JS.A(4, "default", "aqua", "nature", "steel")
themeNames = JS.A(4, "Default", "Aqua", "Nature", "Steel")
colors = JS.O({
	default = JS.O({
	[1] = "#ffffff",
	[2] = "#bfbfbf",
	[3] = "#7f7f7f",
	[4] = "#c25757",
	color = "#dfdfdf",
	points = "#ffffff",
	locked = "#bf8f8f",
	background = "#0f0f0f",
	background_tooltip = "rgba(0, 0, 0, 0.75)"
}, {"color", "points", "locked", "background", "background_tooltip"}),
	aqua = JS.O({
	[1] = "#bfdfff",
	[2] = "#8fa7bf",
	[3] = "#5f6f7f",
	color = "#bfdfff",
	points = "#dfefff",
	locked = "#c4a7b3",
	background = "#001f3f",
	background_tooltip = "rgba(0, 15, 31, 0.75)"
}, {"color", "points", "locked", "background", "background_tooltip"}),
	nature = JS.O({
	[1] = "#7A8579",
	[2] = "#8fa7bf",
	[3] = "#5f6f7f",
	color = "#7A8579",
	points = "#dfefff",
	locked = "#c4a7b3",
	background = "#142811",
	background_tooltip = "rgba(11,22,9,0.75)"
}, {"color", "points", "locked", "background", "background_tooltip"}),
	steel = JS.O({
	[1] = "#BCFD4C",
	[2] = "#8fa7bf",
	[3] = "#5f6f7f",
	color = "#BCFD4C",
	points = "#dfefff",
	locked = "#c4a7b3",
	background = "#191919",
	background_tooltip = "rgba(11,22,9,0.75)"
}, {"color", "points", "locked", "background", "background_tooltip"})
}, {"default", "aqua", "nature", "steel"})

end
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="63">
        <Properties>
          <string name="Name">Leaderboards</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Leaderboards: one OrderedDataStore per board of shared/Boards ("LB_<key>_v1", user id -> a whole number).

	    Leaderboards.submit(userId, keys)    keys = { [board] = stored key }: each board keeps the highest ever sent
	    Leaderboards.addRobux(userId, n)     Robux spent (a granted product, a bought pass) adds to the robux board
	    Leaderboards.page(board)             { ok, board, entries = { { rank, id, name, value } }, error? }: the top
	                                         Config.LB_TOP, names resolved, cached Config.LB_CACHE seconds
	    Leaderboards.mine(board, userId)     the player's own stored value as the board reads it, or nil

	Only the server writes: the Worker sends each player's stats from their own game (Worker "lb"), Shop the Robux. The
	values are what the server's game holds, so a client cannot post one. Config.LB_BANNED ids are never written or
	shown. Every DataStore call is guarded: without DataStores (Studio without API access) a page says so.
]]
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(script.Parent:WaitForChild("Config"))
local Boards = require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("Boards"))

export type Entry = { rank: number, id: number, name: string, value: string }
export type Page = { ok: boolean, board: string, entries: { Entry }, error: string? }

local Leaderboards = {}

local stores: { [string]: OrderedDataStore } = {}
local function store(board: string): OrderedDataStore
	local s: OrderedDataStore? = stores[board]
	if s == nil then
		local made = DataStoreService:GetOrderedDataStore("LB_" .. board .. "_v1")
		stores[board] = made
		return made
	end
	return s :: OrderedDataStore
end

local banned: { [number]: boolean } = {}
for _, id in Config.LB_BANNED do banned[id] = true end
Leaderboards.banned = banned

-- the highest value ever sent stays (a reset in the game never lowers a board); returns how many boards were written
function Leaderboards.submit(userId: number, keys: { [string]: number }): number
	if banned[userId] then return 0 end
	local n = 0
	for board, key in keys do
		if Boards.get(board) == nil or type(key) ~= "number" or key <= 0 or key ~= key then continue end
		local ok = pcall(function()
			store(board):UpdateAsync(tostring(userId), function(old: any): any
				local was = tonumber(old) or 0
				if key <= was then return nil end
				return key
			end)
		end)
		if ok then n += 1 end
	end
	return n
end

function Leaderboards.addRobux(userId: number, amount: number)
	if banned[userId] or type(amount) ~= "number" or amount <= 0 then return end
	local ok, err = pcall(function()
		store("robux"):UpdateAsync(tostring(userId), function(old: any): any
			return (tonumber(old) or 0) + math.floor(amount)
		end)
	end)
	if not ok then warn("[MilestoneTree] could not add Robux spent for " .. userId .. ": " .. tostring(err)) end
end

-- display names, cached for the server's life
local names: { [number]: string } = {}
local function resolve(ids: { number })
	local missing = {}
	for _, id in ids do
		if names[id] == nil then table.insert(missing, id) end
	end
	if #missing == 0 then return end
	local ok, infos = pcall(function()
		return game:GetService("UserService"):GetUserInfosByUserIdsAsync(missing)
	end)
	if ok and type(infos) == "table" then
		for _, info in infos do
			if type(info) == "table" and type(info.Id) == "number" then
				names[info.Id] = if type(info.DisplayName) == "string" and info.DisplayName ~= "" then info.DisplayName else info.Username
			end
		end
	end
	for _, id in missing do
		if names[id] == nil then
			local p = Players:GetPlayerByUserId(id)
			if p then
				names[id] = p.DisplayName
			else
				local okName, name = pcall(function() return Players:GetNameFromUserIdAsync(id) end)
				names[id] = if okName and type(name) == "string" then name else "Player " .. id
			end
		end
	end
end

local pages: { [string]: { t: number, page: Page } } = {}
local loading: { [string]: boolean } = {}
function Leaderboards.page(board: string): Page
	local b = Boards.get(board)
	if b == nil then return { ok = false, board = board, entries = {}, error = "No such board." } end
	local hit = pages[board]
	if hit and os.clock() - hit.t < Config.LB_CACHE then return hit.page end
	-- one read per board at a time: the others wait for it (or take the last page)
	if loading[board] then
		local t0 = os.clock()
		while loading[board] and os.clock() - t0 < 8 do task.wait(0.1) end
		local again = pages[board]
		if again then return again.page end
	end
	loading[board] = true
	local ok, result = pcall(function()
		local sorted = store(board):GetSortedAsync(false, math.min(100, Config.LB_TOP + #Config.LB_BANNED))
		return sorted:GetCurrentPage()
	end)
	local page: Page
	if not ok then
		warn("[MilestoneTree] leaderboard " .. board .. " could not be read: " .. tostring(result))
		page = { ok = false, board = board, entries = {}, error = "Leaderboards are unavailable right now." }
		-- a failed read is kept a short while (not the full cache time), so a hiccup clears soon
		pages[board] = { t = os.clock() - Config.LB_CACHE + 10, page = page }
	else
		local ids = {}
		local rows = {}
		for _, row in result do
			local id = tonumber(row.key)
			if id and not banned[id] and #rows < Config.LB_TOP then
				table.insert(rows, { id = id, key = tonumber(row.value) or 0 })
				table.insert(ids, id)
			end
		end
		resolve(ids)
		local entries: { Entry } = {}
		for i, r in rows do
			table.insert(entries, { rank = i, id = r.id, name = names[r.id] or ("Player " .. r.id), value = Boards.show(b, r.key) })
		end
		page = { ok = true, board = board, entries = entries }
		pages[board] = { t = os.clock(), page = page }
	end
	loading[board] = nil
	return page
end

local mineCache: { [string]: { t: number, v: string? } } = {}
function Leaderboards.mine(board: string, userId: number): string?
	local b = Boards.get(board)
	if b == nil then return nil end
	local ck = board .. ":" .. userId
	local hit = mineCache[ck]
	if hit and os.clock() - hit.t < Config.LB_CACHE then return hit.v end
	local ok, v = pcall(function(): any
		local got = store(board):GetAsync(tostring(userId))
		return got
	end)
	local n = if ok then tonumber(v) else nil
	local out = if n then Boards.show(b, n) else nil
	mineCache[ck] = { t = os.clock(), v = out }
	return out
end
-- a player's own value changed (the Worker just wrote it): read it again next time
function Leaderboards.forget(userId: number)
	for ck in mineCache do
		if string.match(ck, ":(%d+)$") == tostring(userId) then mineCache[ck] = nil end
	end
end

return Leaderboards
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="64">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
--[[
	Milestone Tree NG+ on Roblox: server entry point.

	Each player gets their own game (the web game's JavaScript, transpiled to Luau, see Session and Game) running in
	their own Actor (the Worker in ServerStorage), so players' games run in parallel. This script owns the players,
	the remotes and the rate limits; the Worker owns the game and the save.

	Remotes (ReplicatedStorage.MilestoneTreeRemotes):
	  View    server -> client   screen patches (see Session:view)
	  Act     client -> server   (action, hold?) a button on the screen, or { "key", name } for a hotkey
	  Ready   client -> server   the client wants the whole screen (first load, UI rebuilt, out of sync)
	  Prefs   client -> server   the device options (shared/PrefsSchema: motion, detail, labels, size, weather,
	                             guide, the volumes, seenPrestige); mirrored as JSON in the player's MT_Prefs
	                             attribute and saved apart from the game (Store.savePrefs)
	  Board   client -> server   (RemoteFunction) a leaderboard page: (board key) -> Leaderboards.page + the
	                             player's own value

	Cheating: the game runs here; the client only sends button presses, and an action is carried out only when it
	is on the player's screen (Session:act). The remotes are limited per player (presses: a token bucket; resyncs
	and board pages: one per interval) and a player who keeps flooding past the limits is kicked. Leaderboards are
	written by the server from the server's own game.

	Updates: BindToClose on a live server sends everyone to a holding server while their games save, and the holding
	server sends them back to the new version (SoftShutdown).
]]
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local root = script.Parent
local Config = require(root:WaitForChild("Config"))
local Store = require(root:WaitForChild("Store"))
local Shop = require(root:WaitForChild("Shop"))
local Leaderboards = require(root:WaitForChild("Leaderboards"))
local SoftShutdown = require(root:WaitForChild("SoftShutdown"))
local Boards = require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("Boards"))

local remotes = Instance.new("Folder")
remotes.Name = "MilestoneTreeRemotes"
local function remote(name: string): RemoteEvent
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end
local viewRemote = remote("View")
local actRemote = remote("Act")
local readyRemote = remote("Ready")
local prefsRemote = remote("Prefs")
local boardRemote = Instance.new("RemoteFunction")
boardRemote.Name = "Board"
boardRemote.Parent = remotes
remotes.Parent = ReplicatedStorage

local sessionsFolder = Instance.new("Folder")
sessionsFolder.Name = "Sessions"
sessionsFolder.Parent = root

local template = ServerStorage:WaitForChild("MilestoneTreeWorker") :: Actor

type Prefs = { [string]: any }
type Entry = {
	actor: Actor, tokens: number, last: number,
	drops: number, dropsAt: number, resyncAt: number, resyncHeld: boolean, boardAt: number,
	prefsAt: number, prefsPending: Prefs?, prefsSet: boolean, prefsDirty: boolean, prefsSaveAt: number,
}
local entries: { [Player]: Entry } = {}

local function fatal(player: Player, text: string)
	warn("[MilestoneTree] " .. player.Name .. ": " .. text)
	viewRemote:FireClient(player, { fatal = text })
end

-- ---------------------------------------------------------------------------------------------- device options
-- the keys, choices and defaults are shared/PrefsSchema (the client's table too); a missing key takes its default and
-- a wrong value falls back, so an old stored record still loads
local PrefsSchema = require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("PrefsSchema"))

-- a valid options table from the client or the store, or nil
local function validPrefs(p: any): Prefs?
	return PrefsSchema.clean(p)
end

local function setPrefsAttribute(player: Player, prefs: Prefs)
	player:SetAttribute("MT_Prefs", HttpService:JSONEncode(prefs))
end

local function loadPrefs(player: Player, entry: Entry)
	local saved = validPrefs(Store.loadPrefs(player.UserId))
	-- a change the player made while this was loading wins
	if saved and not entry.prefsSet and entries[player] == entry then setPrefsAttribute(player, saved) end
end

local function savePrefsLater(player: Player, entry: Entry)
	entry.prefsSaveAt = os.clock() + Config.PREFS_SAVE_DELAY
	if entry.prefsDirty then return end
	entry.prefsDirty = true
	task.spawn(function()
		while os.clock() < entry.prefsSaveAt and entries[player] == entry do task.wait(0.5) end
		entry.prefsDirty = false
		local json = player:GetAttribute("MT_Prefs")
		local prefs = if type(json) == "string" then validPrefs(HttpService:JSONDecode(json)) else nil
		if prefs then Store.savePrefs(player.UserId, prefs) end
	end)
end

-- at most one change per PREFS_INTERVAL; a quicker one is held and applied when the interval is over
local function applyPrefs(player: Player, entry: Entry)
	local wait = entry.prefsAt + Config.PREFS_INTERVAL - os.clock()
	if wait > 0 then
		task.delay(wait, function()
			if entries[player] == entry and entry.prefsPending then applyPrefs(player, entry) end
		end)
		return
	end
	local prefs = entry.prefsPending
	if not prefs then return end
	entry.prefsPending = nil
	entry.prefsAt = os.clock()
	entry.prefsSet = true
	setPrefsAttribute(player, prefs)
	savePrefsLater(player, entry)
end

local function start(player: Player)
	if entries[player] then return end
	local a = template:Clone()
	a:SetAttribute("TickShare", Config.TICK_CPU_SHARE)
	a.Name = "Player_" .. player.UserId
	a.Parent = sessionsFolder
	local entry: Entry = {
		actor = a, tokens = Config.ACTIONS_PER_SECOND, last = os.clock(),
		drops = 0, dropsAt = os.clock(), resyncAt = 0, resyncHeld = false, boardAt = 0,
		prefsAt = 0, prefsPending = nil, prefsSet = false, prefsDirty = false, prefsSaveAt = 0,
	}
	entries[player] = entry
	task.spawn(loadPrefs, player, entry)
	-- the Worker binds its messages when it starts running
	local t0 = os.clock()
	while not a:GetAttribute("Ready") and not a:GetAttribute("Error") and os.clock() - t0 < 30 do task.wait() end
	if a:GetAttribute("Error") then
		fatal(player, tostring(a:GetAttribute("Error")))
		return
	elseif not a:GetAttribute("Ready") then
		fatal(player, "The game did not start on the server within 30 seconds (see the Output window).")
		return
	end
	a:SendMessage("start", player)
	-- the player's passes (perks go to the Actor, which keeps them for the session)
	task.spawn(Shop.refresh, player)
end

local stopping = 0 -- saves in flight (BindToClose waits for them)

local function stop(player: Player)
	local entry = entries[player]
	if not entry then return end
	entries[player] = nil
	stopping += 1
	entry.actor:SendMessage("stop")
	local t0 = os.clock()
	while not entry.actor:GetAttribute("Stopped") and os.clock() - t0 < 30 do task.wait(0.1) end
	entry.actor:Destroy()
	stopping -= 1
end

Shop.start(function(player: Player): Actor?
	local entry = entries[player]
	return if entry then entry.actor else nil
end)
-- each game's share of a core: a full server shares its cores (Worker reads the Actor's TickShare)
local function shareCpu()
	local n = 0
	for _ in entries do n += 1 end
	local share = math.clamp(Config.SERVER_CPU / math.max(n, 1), Config.MIN_CPU_SHARE, Config.TICK_CPU_SHARE)
	for _, e in entries do e.actor:SetAttribute("TickShare", share) end
end
-- a holding server (players waiting out an update, see SoftShutdown): no games, just a message and the way back
local HOLDING = SoftShutdown.holding()
local function say(player: Player, text: string)
	viewRemote:FireClient(player, { status = text })
end
Players.PlayerAdded:Connect(function(player: Player)
	if HOLDING then
		-- the client asks for its screen (Ready) once it runs: tell it again then
		SoftShutdown.hold(player, say)
		return
	end
	task.defer(shareCpu)
	start(player)
end)
Players.PlayerRemoving:Connect(function(player: Player)
	stop(player)
	shareCpu()
end)
for _, p in Players:GetPlayers() do
	if HOLDING then SoftShutdown.hold(p, say) else task.spawn(start, p) end
end
task.defer(shareCpu)

-- a token bucket per player: holding a buyable fires 20 presses a second, a burst of clicks a few more
-- a dropped request counts towards the flood limit: FLOOD_DROPS within FLOOD_WINDOW seconds is not a player
local function dropped(player: Player, entry: Entry)
	local now = os.clock()
	if now - entry.dropsAt > Config.FLOOD_WINDOW then
		entry.drops, entry.dropsAt = 0, now
	end
	entry.drops += 1
	if entry.drops == Config.FLOOD_DROPS then
		warn("[MilestoneTree] " .. player.Name .. " (" .. player.UserId .. ") flooded the remotes and was kicked")
		player:Kick("Too many requests. Rejoin to keep playing.")
	end
end
local function allow(player: Player, entry: Entry): boolean
	local now = os.clock()
	entry.tokens = math.min(Config.ACTIONS_PER_SECOND, entry.tokens + (now - entry.last) * Config.ACTIONS_PER_SECOND)
	entry.last = now
	if entry.tokens < 1 then
		dropped(player, entry)
		return false
	end
	entry.tokens -= 1
	return true
end

local function validAction(a: any): boolean
	if type(a) ~= "table" or #a < 1 or #a > 4 then return false end
	for k, v in a do
		if type(k) ~= "number" then return false end
		local tv = type(v)
		if tv == "string" then
			if #v > 100 then return false end
		elseif tv == "table" then
			if #v > 2 then return false end
			for _, w in v do if type(w) ~= "number" and type(w) ~= "string" then return false end end
		elseif tv ~= "number" then
			return false
		end
	end
	return type(a[1]) == "string"
end

actRemote.OnServerEvent:Connect(function(player: Player, a: any, hold: any)
	local entry = entries[player]
	if not entry then return end
	if not validAction(a) then
		dropped(player, entry)
		return
	end
	if not allow(player, entry) then return end
	entry.actor:SendMessage("act", a, hold == true)
end)

prefsRemote.OnServerEvent:Connect(function(player: Player, p: any)
	local entry = entries[player]
	local prefs = validPrefs(p)
	if not entry or not prefs then return end
	local held = entry.prefsPending ~= nil
	entry.prefsPending = prefs
	if not held then applyPrefs(player, entry) end
end)

readyRemote.OnServerEvent:Connect(function(player: Player)
	if HOLDING then
		say(player, "Updating to the new version")
		return
	end
	local entry = entries[player]
	if not entry then return end
	-- a whole screen is costly to build: one per RESYNC_EVERY. A quicker ask is held and sent when the interval is
	-- over (the client asks again at boot when its first ask came before the game was up); a third one meanwhile is
	-- spam
	local now = os.clock()
	local wait = entry.resyncAt + Config.RESYNC_EVERY - now
	if wait > 0 then
		if entry.resyncHeld then
			dropped(player, entry)
			return
		end
		entry.resyncHeld = true
		task.delay(wait, function()
			entry.resyncHeld = false
			entry.resyncAt = os.clock()
			if entries[player] == entry and not entry.actor:GetAttribute("Error") then entry.actor:SendMessage("resync") end
		end)
		return
	end
	entry.resyncAt = now
	if entry.actor:GetAttribute("Error") then
		fatal(player, tostring(entry.actor:GetAttribute("Error")))
	else
		entry.actor:SendMessage("resync")
	end
end)

-- a leaderboard page, and the player's own value on that board
boardRemote.OnServerInvoke = function(player: Player, board: any): any
	local entry = entries[player]
	if not entry or type(board) ~= "string" or #board > 16 or Boards.get(board) == nil then return nil end
	local now = os.clock()
	if now - entry.boardAt < Config.BOARD_EVERY then
		dropped(player, entry)
		return { ok = false, board = board, entries = {}, error = "Slow down a little." }
	end
	entry.boardAt = now
	local page = Leaderboards.page(board)
	return { ok = page.ok, board = page.board, entries = page.entries, error = page.error,
		you = if page.ok then Leaderboards.mine(board, player.UserId) else nil }
end

game:BindToClose(function()
	-- an update: the players go to a holding server and come back to the new version (SoftShutdown); their games
	-- are saved here meanwhile
	SoftShutdown.closing(Players:GetPlayers(), function()
		for player in entries do task.spawn(stop, player) end
		local t0 = os.clock()
		task.wait(0.1)
		while stopping > 0 and os.clock() - t0 < 25 do task.wait(0.1) end
	end, say)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="65">
        <Properties>
          <string name="Name">Runtime</string>
        </Properties>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">BEcore</string>
            <string name="Source"><![CDATA[--!nocheck
-- BEcore: a line-for-line port of the component maths in the game's bundled break_eternity.js.
-- JSRT uses it only when a value is one of break_eternity's special forms (new Decimal(Infinity), Decimal.dInf,
-- and whatever arithmetic on them produces), where the old library's answers differ from any "correct" answer
-- and the game depends on them (e.g. Infinity-cost upgrades count as affordable once you have ee16).
-- Values are triples { s = sign, l = layer, m = mag }.
local abs, floor, log10, huge = math.abs, math.floor, math.log10, math.huge
local EXP_LIMIT = 9e15
local LAYER_DOWN = math.log10(9e15)
local FIRST_NEG_LAYER = 1 / 9e15
local MAX_SIG = 17

local BE = {}
local function sgn(x) if x > 0 then return 1 elseif x < 0 then return -1 elseif x == 0 then return 0 end return x end
local function finite(x) return x == x and x ~= huge and x ~= -huge end
local function pow10(x) return 10 ^ x end
BE.finite = finite

local function NN(s, l, m) return { s = s, l = l, m = m } end
local function normalize(t)
	if t.s == 0 or (t.m == 0 and t.l == 0) then t.s, t.m, t.l = 0, 0, 0; return t end
	if t.l == 0 and t.m < 0 then t.m = -t.m; t.s = -t.s end
	if t.l == 0 and t.m < FIRST_NEG_LAYER then t.l += 1; t.m = log10(t.m); return t end
	local absmag, signmag = abs(t.m), sgn(t.m)
	if absmag >= EXP_LIMIT then
		t.l += 1; t.m = signmag * log10(absmag); return t
	end
	while absmag < LAYER_DOWN and t.l > 0 do
		t.l -= 1
		if t.l == 0 then t.m = pow10(t.m)
		else t.m = signmag * pow10(absmag); absmag = abs(t.m); signmag = sgn(t.m) end
	end
	if t.l == 0 then
		if t.m < 0 then t.m = -t.m; t.s = -t.s
		elseif t.m == 0 then t.s = 0 end
	end
	return t
end
local function FC(s, l, m) return normalize(NN(s, l, m)) end
BE.NN, BE.FC, BE.normalize = NN, FC, normalize

local NaN = 0 / 0
local function dNaN() return NN(NaN, NaN, NaN) end
function BE.fromNumber(x)
	return normalize(NN(sgn(x), 0, abs(x)))
end

function BE.cmpabs(a, b)
	local la = if a.m > 0 then a.l else -a.l
	local lb = if b.m > 0 then b.l else -b.l
	if la > lb then return 1 end
	if la < lb then return -1 end
	if a.m > b.m then return 1 end
	if a.m < b.m then return -1 end
	return 0
end
function BE.cmp(a, b)
	if a.s > b.s then return 1 end
	if a.s < b.s then return -1 end
	return a.s * BE.cmpabs(a, b)
end
function BE.lt(a, b) return BE.cmp(a, b) == -1 end
function BE.gt(a, b) return BE.cmp(a, b) == 1 end
function BE.lte(a, b) return not BE.gt(a, b) end
function BE.gte(a, b) return not BE.lt(a, b) end
function BE.eq(a, b) return a.s == b.s and a.l == b.l and a.m == b.m end

function BE.neg(a) return NN(-a.s, a.l, a.m) end
function BE.abs(a) return NN(if a.s == 0 then 0 else 1, a.l, a.m) end

function BE.add(a0, b0)
	if not finite(a0.l) then return a0 end
	if not finite(b0.l) then return b0 end
	if a0.s == 0 then return b0 end
	if b0.s == 0 then return a0 end
	if a0.s == -b0.s and a0.l == b0.l and a0.m == b0.m then return NN(0, 0, 0) end
	if a0.l >= 2 or b0.l >= 2 then
		if BE.cmpabs(a0, b0) < 0 then return b0 end
		return a0
	end
	local a, b
	if BE.cmpabs(a0, b0) > 0 then a, b = a0, b0 else a, b = b0, a0 end
	if a.l == 0 and b.l == 0 then return BE.fromNumber(a.s * a.m + b.s * b.m) end
	local layera = a.l * sgn(a.m)
	local layerb = b.l * sgn(b.m)
	if layera - layerb >= 2 then return a end
	if layera == 0 and layerb == -1 then
		if abs(b.m - log10(a.m)) > MAX_SIG then return a end
		local magdiff = pow10(log10(a.m) - b.m)
		local mantissa = b.s + a.s * magdiff
		return FC(sgn(mantissa), 1, b.m + log10(abs(mantissa)))
	end
	if layera == 1 and layerb == 0 then
		if abs(a.m - log10(b.m)) > MAX_SIG then return a end
		local magdiff = pow10(a.m - log10(b.m))
		local mantissa = b.s + a.s * magdiff
		return FC(sgn(mantissa), 1, log10(b.m) + log10(abs(mantissa)))
	end
	if abs(a.m - b.m) > MAX_SIG then return a end
	local magdiff = pow10(a.m - b.m)
	local mantissa = b.s + a.s * magdiff
	return FC(sgn(mantissa), 1, b.m + log10(abs(mantissa)))
end
function BE.sub(a, b) return BE.add(a, BE.neg(b)) end

function BE.mul(a0, b0)
	if not finite(a0.l) then return a0 end
	if not finite(b0.l) then return b0 end
	if a0.s == 0 or b0.s == 0 then return NN(0, 0, 0) end
	if a0.l == b0.l and a0.m == -b0.m then return NN(a0.s * b0.s, 0, 1) end
	local a, b
	if a0.l > b0.l or (a0.l == b0.l and abs(a0.m) > abs(b0.m)) then a, b = a0, b0 else a, b = b0, a0 end
	if a.l == 0 and b.l == 0 then return BE.fromNumber(a.s * b.s * a.m * b.m) end
	if a.l >= 3 or (a.l - b.l >= 2) then return FC(a.s * b.s, a.l, a.m) end
	if a.l == 1 and b.l == 0 then return FC(a.s * b.s, 1, a.m + log10(b.m)) end
	if a.l == 1 and b.l == 1 then return FC(a.s * b.s, 1, a.m + b.m) end
	if (a.l == 2 and b.l == 1) or (a.l == 2 and b.l == 2) then
		local nm = BE.add(FC(sgn(a.m), a.l - 1, abs(a.m)), FC(sgn(b.m), b.l - 1, abs(b.m)))
		return FC(a.s * b.s, nm.l + 1, nm.s * nm.m)
	end
	return dNaN()   -- break_eternity throws here; nothing in the game reaches it
end
function BE.recip(a)
	if a.m == 0 then return dNaN() end
	if a.l == 0 then return FC(a.s, 0, 1 / a.m) end
	return FC(a.s, a.l, -a.m)
end
function BE.div(a, b) return BE.mul(a, BE.recip(b)) end

function BE.absLog10(a)
	if a.s == 0 then return dNaN() end
	if a.l > 0 then return FC(sgn(a.m), a.l - 1, abs(a.m)) end
	return FC(1, 0, log10(a.m))
end
function BE.log10(a)
	if a.s <= 0 then return dNaN() end
	if a.l > 0 then return FC(sgn(a.m), a.l - 1, abs(a.m)) end
	return FC(a.s, 0, log10(a.m))
end
function BE.ln(a)
	if a.s <= 0 then return dNaN() end
	if a.l == 0 then return FC(a.s, 0, math.log(a.m)) end
	if a.l == 1 then return FC(sgn(a.m), 0, abs(a.m) * 2.302585092994046) end
	if a.l == 2 then return FC(sgn(a.m), 1, abs(a.m) + 0.36221568869946325) end
	return FC(sgn(a.m), a.l - 1, abs(a.m))
end
function BE.log2(a)
	if a.s <= 0 then return dNaN() end
	if a.l == 0 then return FC(a.s, 0, math.log(a.m, 2)) end
	if a.l == 1 then return FC(sgn(a.m), 0, abs(a.m) * 3.321928094887362) end
	if a.l == 2 then return FC(sgn(a.m), 1, abs(a.m) + 0.5213902276543247) end
	return FC(sgn(a.m), a.l - 1, abs(a.m))
end
function BE.log(a, base)
	if a.s <= 0 then return dNaN() end
	if base.s <= 0 then return dNaN() end
	if base.s == 1 and base.l == 0 and base.m == 1 then return dNaN() end
	if a.l == 0 and base.l == 0 then return FC(a.s, 0, math.log(a.m) / math.log(base.m)) end
	return BE.div(BE.log10(a), BE.log10(base))
end

function BE.pow10(a)
	if not finite(a.l) or not finite(a.m) then return dNaN() end
	if a.l == 0 then
		local nm = 10 ^ (a.s * a.m)
		if finite(nm) and abs(nm) > 0.1 then return FC(1, 0, nm) end
		if a.s == 0 then return NN(1, 0, 1) end
		a = NN(a.s, a.l + 1, log10(a.m))
	end
	if a.s > 0 and a.m > 0 then return FC(a.s, a.l + 1, a.m) end
	if a.s < 0 and a.m > 0 then return FC(-a.s, a.l + 1, -a.m) end
	return NN(1, 0, 1)
end
function BE.toNumber(a)
	if not finite(a.l) then return NaN end
	if a.l == 0 then return a.s * a.m end
	if a.l == 1 then return a.s * 10 ^ a.m end
	if a.m > 0 then return if a.s > 0 then huge else -huge end
	return 0
end
function BE.pow(a, b)
	if a.s == 0 then if BE.eq(b, NN(0, 0, 0)) or b.s == 0 then return NN(1, 0, 1) end return a end
	if a.s == 1 and a.l == 0 and a.m == 1 then return a end
	if b.s == 0 then return NN(1, 0, 1) end
	if b.s == 1 and b.l == 0 and b.m == 1 then return a end
	local result = BE.pow10(BE.mul(BE.absLog10(a), b))
	if a.s == -1 and abs(math.fmod(BE.toNumber(b), 2)) == 1 then return BE.neg(result) end
	return result
end
function BE.root(a, b) return BE.pow(a, BE.recip(b)) end
function BE.sqrt(a)
	if a.l == 0 then local x = a.s * a.m; return BE.fromNumber(if x < 0 then NaN else math.sqrt(x)) end
	if a.l == 1 then return FC(1, 2, log10(a.m) - 0.3010299956639812) end
	local r = BE.div(NN(a.s, a.l - 1, a.m), NN(1, 0, 2))
	r = NN(r.s, r.l + 1, r.m)
	return normalize(r)
end
local function magRound(a, f)
	if a.m < 0 then return NN(0, 0, 0) end
	if a.l == 0 then return FC(a.s, 0, f(a.m)) end
	return a
end
function BE.floor(a) return magRound(a, floor) end
function BE.ceil(a) return magRound(a, math.ceil) end
function BE.round(a) return magRound(a, function(m) return floor(m + 0.5) end) end
function BE.exp(a)
	if a.m < 0 then return NN(1, 0, 1) end
	if a.l == 0 and a.m <= 709.7 then return BE.fromNumber(math.exp(a.s * a.m)) end
	if a.l == 0 then return FC(1, 1, a.s * log10(math.exp(1)) * a.m) end
	if a.l == 1 then return FC(1, 2, a.s * (log10(0.4342944819032518) + a.m)) end
	return FC(1, a.l + 1, a.s * a.m)
end
function BE.max(a, b) if BE.lt(a, b) then return b end return a end
function BE.min(a, b) if BE.gt(a, b) then return b end return a end

return BE
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">Fast</string>
            <string name="Source"><![CDATA[--!nocheck
--[[
	Fast: native versions of the game's hottest per-tick functions, installed after the game chunks load
	(Session:_start). Same behaviour as the transpiled code, down to the RNG draws, the iteration order and the
	sloppy globals the JS leaves behind (`i`, `l`), without the JS-emulation cost in the inner loops. The fuzz parity
	test (./test.sh game) compares every player value with the web game after these run.

	    Fast(JS, ENV)
]]

return function(JS, ENV)
	local layers = ENV.layers
	local cp = layers and layers.cp
	if cp == nil or type(cp.update) ~= "function" then return end

	-- layers/cp.js update(diff): the two "pick the least corrupted cell" passes walk the grid inside a walk of the
	-- grid (49 x 49 twice a tick) through JS property access; they run natively here on arrays of the cells
	local function pass(player, tmp, kind: string, chosenKey: string, cdKey: string)
		local pcp = player.cp
		local grid = pcp.grid
		local keys = {}
		for _, k in JS.keys(grid) do keys[#keys + 1] = k end
		local n = #keys
		-- per cell: its level as a number, whether it is "0" by JS ==, and its type (kept current when a level changes)
		local lv, num, zero, ty = table.create(n), table.create(n), table.create(n), table.create(n)
		for j = 1, n do
			local c = grid[keys[j]]
			local v = c.level
			lv[j], num[j], zero[j], ty[j] = v, JS.tonum(v), JS.eq(v, 0), c.type
		end
		local Math = ENV.Math -- the page's Math (its seeded random)
		local totalC = JS.tonum(pcp.totalCorrupt)
		local a2 = JS.tonum(player.ex.a2Unl) >= 1
		local cdZero = JS.eq(pcp[cdKey], 0)
		local noChal = JS.isnil(player.pm.activeChallenge)
		local lastL = ENV.l
		for j = 1, n do
			local i = keys[j]
			ENV.i = i
			-- per cell, as the page does (the values do not change inside the pass, the RNG draw must happen)
			local rangeMul = Math.floor(totalC / 4)
			local addLevel = Math.floor(totalC / 5) * 1.5
			local _ranType = Math.floor(Math.random() * 1.5)
			local pm13 = if player.pm.best:gte(13) then tmp.pm.pMilestone13Effect else 0
			local range = JS.tonum(JS.add(10, addLevel)) - JS.tonum(pm13)
			local startN = JS.tonum(JS.D(1):add(rangeMul))
			local minCorrupt = 1000
			local mine = a2 and ty[j] == kind and num[j] >= 1 and cdZero
			local myDiff = if mine then num[j] - startN else 0
			-- numbers only in here: JS Math.min and == on finite numbers are math.min and ==; a NaN level would
			-- behave the same too (min(NaN) is NaN in both, NaN == x is false)
			for m = 1, n do
				lastL = keys[m]
				if not zero[m] and ty[m] == kind then
					local d = num[m] - startN
					minCorrupt = if d ~= d or minCorrupt ~= minCorrupt then 0 / 0 elseif d < minCorrupt then d else minCorrupt
				end
				if mine and myDiff == minCorrupt then
					JS.setk(pcp, chosenKey, i)
					break
				end
			end
			local cell = grid[i]
			if JS.cmp(cell.level, ">", range) and noChal then
				JS.setk(cell, "level", JS.tonum(ENV.getGridData(nil, "cp", i).level) - JS.tonum(pm13))
				local v = cell.level
				lv[j], num[j], zero[j] = v, JS.tonum(v), JS.eq(v, 0)
			end
		end
		ENV.l = lastL
	end

	cp.update = function(this, diff)
		local player, tmp = ENV.player, ENV.tmp
		-- everything before the two passes: the transpiled function's own text (layers_cp.luau), unchanged
		local pcp = player.cp
		if ((not JS.isnil(pcp.trojanChosen)) and (JS.tonum(player.ex.a2Unl) >= 1)) then
			JS.setk(pcp, "pointsInCorrupt", pcp.pointsInCorrupt:add(tmp.cp.gainInCorrupt:times(diff)))
		end
		if ((not JS.isnil(pcp.chosenBackdoor)) and (JS.tonum(player.ex.a2Unl) >= 1)) then
			JS.setk(pcp, "peInCorrupt", pcp.peInCorrupt:add(tmp.cp.peGainInCorrupt:times(diff)))
		end
		if (JS.tonum(pcp.cooldown) > 0) then
			JS.setk(pcp, "cooldown", (JS.tonum(pcp.cooldown) - JS.tonum(diff)))
		end
		if (JS.tonum(pcp.cooldown) < 0) then
			JS.setk(pcp, "cooldown", 0)
		end
		if (JS.tonum(pcp.cooldown2) > 0) then
			JS.setk(pcp, "cooldown2", (JS.tonum(pcp.cooldown2) - JS.tonum(diff)))
		end
		if (JS.tonum(pcp.cooldown2) < 0) then
			JS.setk(pcp, "cooldown2", 0)
		end
		if JS.m(pcp.pool, "includes", "pow") then
			JS.setk(pcp, "pool", JS.A(2, "div", "pm"))
		end
		local getGridData, gridEssence, gridCost, doPopup = ENV.getGridData, ENV.gridEssence, ENV.gridCost, ENV.doPopup
		local function fix(key)
			JS.setk(player.cp, "formatted", player.cp.formatted:add(gridEssence(nil, "cp", key)))
			JS.set(player.cp.grid, JS.k(key), JS.O({
				level = 0,
				active = false,
				fixed = false,
				type = getGridData(nil, "cp", key).type,
				cautPower = getGridData(nil, "cp", key).cautPower,
			}, { "level", "active", "fixed", "type", "cautPower" }))
			doPopup(nil, "none", "Corruption was fixed!", "Corruption Info", 3, "black", "lime")
			JS.setk(player.cp, "totalCorrupt", JS.add(player.cp.totalCorrupt, 1))
		end
		local slots = ENV.activeCorruptions(nil)
		local all = JS.m(ENV.Object.keys(pcp.grid), "filter", function(_, x)
			return (JS.cmp(player.cp.grid[JS.k(x)].level, "<", ENV.antiCorrupt(nil)) and (JS.tonum(player.cp.grid[JS.k(x)].level) > 0))
		end)
		for i = 0, JS.cap(0, (JS.len(all)) - 1, 1) do
			if ((player.cm.best:gte(3) and (JS.len(all) > 0)) and JS.isnil(player.pm.activeChallenge)) then
				fix(all[JS.k(i)])
			end
		end
		ENV.setTimeout(nil, 100000)
		if ((((JS.eq(player.mp.activeChallenge, 21) and (JS.tonum(player.ex.a2Unl) >= 1)) and (not JS.isnil(player.cp.trojanChosen))) and (player.cp.pointsInCorrupt:gte(gridCost(nil, "cp", player.cp.trojanChosen)) and (getGridData(nil, "cp", player.cp.trojanChosen).type == "div"))) and (JS.tonum(getGridData(nil, "cp", player.cp.trojanChosen).level) >= 1)) then
			fix(player.cp.trojanChosen)
			JS.setk(player.cp, "cooldown", ENV.buyableEffect(nil, "cp", 33))
			JS.setk(player.cp, "trojanChosen", nil)
			JS.setk(player.cp, "pointsInCorrupt", JS.D(0))
		end
		if ((((JS.eq(player.mp.activeChallenge, 21) and (JS.tonum(player.ex.a2Unl) >= 1)) and (not JS.isnil(player.cp.chosenBackdoor))) and (player.cp.peInCorrupt:gte(gridCost(nil, "cp", player.cp.chosenBackdoor)) and (getGridData(nil, "cp", player.cp.chosenBackdoor).type == "pm"))) and (JS.tonum(getGridData(nil, "cp", player.cp.chosenBackdoor).level) >= 1)) then
			fix(player.cp.chosenBackdoor)
			JS.setk(player.cp, "cooldown2", ENV.buyableEffect(nil, "cp", 34))
			JS.setk(player.cp, "chosenBackdoor", nil)
			JS.setk(player.cp, "peInCorrupt", JS.D(0))
		end
		for i = 0, JS.cap(0, (JS.len(slots)) - 1, 1) do
			if JS.isnil(player.pm.activeChallenge) then
				if ((JS.tonum(player.ex.a2Unl) <= 1) and (player.points:gte(gridCost(nil, "cp", slots[JS.k(i)])) and (getGridData(nil, "cp", slots[JS.k(i)]).type == "div"))) then
					fix(slots[JS.k(i)])
				end
				ENV.setTimeout(nil, 100000)
				if (player.pm.essence:gte(gridCost(nil, "cp", slots[JS.k(i)])) and (getGridData(nil, "cp", slots[JS.k(i)]).type == "pm")) then
					fix(slots[JS.k(i)])
				end
			end
		end
		pass(player, tmp, "div", "trojanChosen", "cooldown")
		pass(player, tmp, "pm", "chosenBackdoor", "cooldown2")
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">JSRT</string>
            <string name="Source"><![CDATA[--!nocheck
-- JSRT: the small slice of JavaScript semantics the transpiled Milestone Tree NG+ needs, plus a break_eternity-style
-- Decimal built on TowerNum. Every JS function value takes `this` as its first parameter.
-- array lengths, key order and key caches are shared by every instance (arrays stay arrays across instances)
local SHARED_LEN = setmetatable({}, { __mode = "k" })
local SHARED_ORDER = setmetatable({}, { __mode = "k" })
local SHARED_KC = setmetatable({}, { __mode = "k" })
return function(TN, BEcore)

local huge, floor, abs, fmod = math.huge, math.floor, math.abs, math.fmod
local sfmt, ssub, sfind, srep, sbyte, schar, slower, supper = string.format, string.sub, string.find, string.rep, string.byte, string.char, string.lower, string.upper
local tinsert, tsort, tconcat, tclear = table.insert, table.sort, table.concat, table.clear

local JS = {}
local LEN = SHARED_LEN     -- array -> length (arrays are 0-based)
local ORDER = SHARED_ORDER   -- object -> string keys in insertion order
local KC = SHARED_KC      -- object -> cached for-in key list (dropped when a key appears/disappears)
JS.LEN, JS.ORDER = LEN, ORDER
JS.NOW = 1.7e12

-- ------------------------------------------------------------------ Decimal (break_eternity API over TowerNum)
local DMT = {}
local DP = {}                                    -- Decimal methods
JS.DMT = DMT
local function isD(x) return type(x) == "table" and getmetatable(x) == DMT end
JS.isD = isD

local parseStr   -- break_eternity's fromString, defined with the other Decimal methods below
local function V(x)
	local t = type(x)
	if t == "number" then return x end
	if t == "table" then
		if getmetatable(x) == DMT then return x.v end
		if rawget(x, "l") ~= nil and rawget(x, "m") ~= nil then return x end   -- a raw TowerNum value
		return 0
	end
	if t == "string" then return (parseStr(x)) end
	return 0
end
-- A NaN carries break_eternity's own components (NaN, 0, NaN), so every operation on it goes through BEcore and
-- answers like the web game (0 * NaN is 0 there; a NaN from x / 0 or log(0) is the layer-NaN kind that stays NaN).
local function mk(v)
	if v ~= v then return setmetatable({ v = v, be = BEcore.NN(0 / 0, 0, 0 / 0) }, DMT) end
	return setmetatable({ v = v }, DMT)
end
local function D(x)
	if isD(x) then local r = mk(x.v); r.be = x.be; return r end
	if type(x) == "string" then local v, be = parseStr(x); local r = mk(v); r.be = be; return r end
	if x == huge or x == -huge then
		local r = mk(x); r.be = BEcore.fromNumber(x); return r      -- break_eternity's layer-1 Infinity
	end
	return mk(V(x))
end
JS.D = function(x) return D(x) end
JS.V = V

-- break_eternity normal form (sign, layer, mag) for the few places that read the fields directly
local EXP_LIMIT = 9e15
local function comps(v)
	if type(v) == "number" then
		if v ~= v then return 0 / 0, 0, 0 / 0 end
		local s = if v > 0 then 1 elseif v < 0 then -1 else 0
		local a = abs(v)
		if a == huge then return s, huge, huge end
		if a < EXP_LIMIT then
			if a < 1 / 9e15 and a > 0 then return s, 1, math.log10(a) end   -- break_eternity's first negative layer
			return s, 0, a
		end
		return s, 1, math.log10(a)
	end
	if v.h ~= nil then return (if v.m < 0 then -1 else 1), huge, huge end
	-- towers {l, m}: l < 0 is the reciprocal 1 / (l-tall tower of m); break_eternity writes that as a negative mag
	local s = if v.m < 0 then -1 else 1
	local l, m = v.l, abs(v.m)
	if l < 0 then l = -l; m = -m end
	while m >= EXP_LIMIT or m <= -EXP_LIMIT do
		l += 1
		m = if m < 0 then -math.log10(-m) else math.log10(m)
	end
	return s, l, m
end
JS.comps = comps
-- method lookups go straight to DP; the break_eternity fields (sign/layer/mag/e/m) are read through JS.P
local function dprop(self, k)
	local be = self.be
	if be then
		if k == "sign" then return be.s elseif k == "layer" then return be.l elseif k == "mag" then return be.m end
	end
	if k == "sign" or k == "layer" or k == "mag" then
		local s, l, m = comps(self.v)
		return if k == "sign" then s elseif k == "layer" then l else m
	end
	if k == "e" or k == "exponent" then
		local s, l, m = comps(self.v)
		if l == 0 then if m == 0 then return 0 end return floor(math.log10(m)) end
		if l == 1 then return floor(m) end
		if l == 2 then return floor(10 ^ m) end
		return huge
	end
	if k == "m" or k == "mantissa" then
		local s, l, m = comps(self.v)
		if l == 0 then
			if m == 0 then return 0 end
			local e = floor(math.log10(m))
			return s * (m / 10 ^ e)
		end
		if l == 1 then return s * 10 ^ (m % 1) end
		return s
	end
	return nil
end
DMT.__index = DP
function JS.P(o, k)
	if type(o) == "table" and getmetatable(o) == DMT then return dprop(o, k) end
	if o == nil then error("Cannot read properties of undefined (reading '" .. k .. "')", 2) end
	if type(o) ~= "table" then return nil end
	return o[k]
end
DMT.__tostring = function(self) return DP.toString(self) end
DMT.__eq = function(a, b) return TN.eq(a.v, b.v) end
DMT.__lt = function(a, b) return TN.lt(V(a), V(b)) end
DMT.__le = function(a, b) return TN.le(V(a), V(b)) end
DMT.__unm = function(a) return mk(TN.neg(a.v)) end

-- ---- break_eternity compatibility -------------------------------------------------------------------------------
-- The game ships an old break_eternity. TowerNum does the arithmetic; where that old version answers differently the
-- game's own answer is reproduced:
--   * new Decimal(Infinity), Decimal.dInf and anything computed from them go through BEcore (a line-for-line port of
--     the old library). E.g. new Decimal(Infinity) ranks BELOW every number from ee15.95 up, so Infinity-cost upgrades
--     become affordable at ee16, and paying that cost leaves the currency unchanged, exactly like the web game.
--   * NaN compares like the old library: gte / lte are true, gt / lt / eq false
--   * log10 / ln / log2 / log of 0 or a negative, x/0 and 1/0 are NaN (not -Infinity / Infinity)
--   * pow of a negative base is |base|^b, negated only for odd integer powers; 0^b is 0 for any b ~= 0
--   * floor / ceil / round / trunc act on the magnitude and keep the sign (floor(-2.5) = -2)
--   * slog is the old linear-approximation version
local BEc = BEcore
local function special(b)
	local t = type(b)
	if t == "table" then return getmetatable(b) == DMT and b.be ~= nil end
	if t == "number" then return b == huge or b == -huge or b ~= b end
	return false
end
local function tri(x)
	if isD(x) then
		if x.be then return x.be end
		local s, l, m = comps(x.v)
		return BEc.NN(s, l, m)
	end
	if type(x) == "number" then return BEc.fromNumber(x) end
	return tri(D(x))
end
local function triToTN(t)
	if t.s == 0 then return 0 end
	if t.l == 0 then return t.s * t.m end
	-- layer l, mag m: 10^(sign(m) * (l-1 tall tower of |m|))
	local x = abs(t.m)
	for _ = 1, t.l - 1 do x = TN.exp10(x) end
	if t.m < 0 then x = TN.neg(x) end
	x = TN.exp10(x)
	if t.s < 0 then x = TN.neg(x) end
	return x
end
local function fromTri(t)
	if BEc.finite(t.l) and BEc.finite(t.m) and t.s == t.s then return mk(triToTN(t)) end
	local d = mk(if t.s ~= t.s or t.l ~= t.l or t.m ~= t.m then 0 / 0 elseif t.s < 0 then -huge elseif t.s > 0 then huge else 0 / 0)
	d.be = t
	return d
end
local function nanL() return fromTri(BEc.NN(0 / 0, 0 / 0, 0 / 0)) end   -- break_eternity's layer-NaN (x / 0, log of 0)
JS.tri, JS.fromTri = tri, fromTri
local function bv_(b)
	local t = type(b)
	if t == "table" and getmetatable(b) == DMT then return b.v end
	if t == "number" then return b end
	return V(b)
end
local tnge, tngt, tnle, tnlt, tneq, tncmp = TN.ge, TN.gt, TN.le, TN.lt, TN.eq, TN.cmp
function DP.gte(a, b)
	if a.be or special(b) then return BEc.gte(tri(a), tri(b)) end
	local av, v = a.v, bv_(b)
	if tnge(av, v) then return true end
	return av ~= av or v ~= v
end
function DP.lte(a, b)
	if a.be or special(b) then return BEc.lte(tri(a), tri(b)) end
	local av, v = a.v, bv_(b)
	if tnle(av, v) then return true end
	return av ~= av or v ~= v
end
function DP.gt(a, b)
	if a.be or special(b) then return BEc.gt(tri(a), tri(b)) end
	local av, v = a.v, bv_(b)
	if av ~= av or v ~= v then return false end    -- TowerNum would rank NaN below towers
	return tngt(av, v)
end
function DP.lt(a, b)
	if a.be or special(b) then return BEc.lt(tri(a), tri(b)) end
	local av, v = a.v, bv_(b)
	if av ~= av or v ~= v then return false end
	return tnlt(av, v)
end
function DP.eq(a, b)
	if a.be or special(b) then return BEc.eq(tri(a), tri(b)) end
	return tneq(a.v, bv_(b))
end
function DP.neq(a, b) return not DP.eq(a, b) end
function DP.cmp(a, b)
	local av, v = a.v, bv_(b)
	if a.be or special(b) or av ~= av or v ~= v then return BEc.cmp(tri(a), tri(b)) end
	return tncmp(av, v)
end
DP.compare = DP.cmp
function DP.max(a, b) if DP.lt(a, b) then return D(b) end return a end
function DP.min(a, b) if DP.gt(a, b) then return D(b) end return a end
function DP.clamp(a, lo, hi) return DP.min(DP.max(a, lo), hi) end
function DP.clampMin(a, lo) return DP.max(a, lo) end
function DP.clampMax(a, hi) return DP.min(a, hi) end
local tnadd, tnsub, tnmul, tndiv = TN.add, TN.sub, TN.mul, TN.div
function DP.add(a, b) if a.be or special(b) then return fromTri(BEc.add(tri(a), tri(b))) end return mk(tnadd(a.v, V(b))) end
function DP.sub(a, b) if a.be or special(b) then return fromTri(BEc.sub(tri(a), tri(b))) end return mk(tnsub(a.v, V(b))) end
function DP.mul(a, b) if a.be or special(b) then return fromTri(BEc.mul(tri(a), tri(b))) end return mk(tnmul(a.v, V(b))) end
function DP.div(a, b)
	if a.be or special(b) then return fromTri(BEc.div(tri(a), tri(b))) end
	local av, bv = a.v, V(b)
	if bv == 0 then return nanL() end
	if type(av) == "number" and type(bv) == "number" and bv < EXP_LIMIT and bv > -EXP_LIMIT then
		local r = av * (1 / bv)      -- break_eternity divides as a * (1/b)
		if r < EXP_LIMIT and r > -EXP_LIMIT then return mk(r) end
	end
	return mk(tndiv(av, bv))
end
DP.plus, DP.minus, DP.times, DP.dividedBy, DP.divide, DP.multiply = DP.add, DP.sub, DP.mul, DP.div, DP.div, DP.mul
local function recipV(v)
	if v == 0 then return 0 / 0 end
	return TN.recip(v)
end
function DP.recip(a) if a.be then return fromTri(BEc.recip(a.be)) end if a.v == 0 then return nanL() end return mk(recipV(a.v)) end
DP.reciprocal = DP.recip
local powV
function powV(av, bv)
	if av == 0 then if bv == 0 then return 1 end return av end
	if av == 1 then return av end
	if bv == 0 then return 1 end
	if bv == 1 then return av end
	if bv ~= bv or av ~= av then return 0 / 0 end
	if type(av) == "number" and type(bv) == "number" and av > 0 and bv < EXP_LIMIT and bv > -EXP_LIMIT then
		-- the old library always goes through logs: 10^(log10(a) * b). Same rounding as the web game.
		local x = math.log10(av) * bv
		if x < EXP_LIMIT and x > -EXP_LIMIT then
			local r = 10 ^ x
			if r == r and r ~= huge and r > 0.1 then return r end
			return fromTri(BEc.pow10(BEc.fromNumber(x))).v
		end
	end
	if type(av) == "number" and av < 0 then
		local r = powV(-av, bv)
		if abs(fmod(TN.toNumber(bv), 2)) == 1 then return TN.neg(r) end
		return r
	end
	if type(av) == "table" and av.h == nil and av.m < 0 then
		local r = TN.pow(TN.neg(av), bv)
		if abs(fmod(TN.toNumber(bv), 2)) == 1 then return TN.neg(r) end
		return r
	end
	return TN.pow(av, bv)
end
JS.powV = powV
function DP.pow(a, b) if a.be or special(b) then return fromTri(BEc.pow(tri(a), tri(b))) end return mk(powV(a.v, V(b))) end
function DP.pow_base(a, b) if a.be or special(b) then return fromTri(BEc.pow(tri(b), tri(a))) end return mk(powV(V(b), a.v)) end
function DP.root(a, n)
	if a.be or special(n) or V(n) == 0 then return fromTri(BEc.root(tri(a), tri(n))) end
	return mk(powV(a.v, recipV(V(n))))
end
function DP.cbrt(a) if a.be then return fromTri(BEc.pow(a.be, BEc.fromNumber(1 / 3))) end return mk(powV(a.v, 1 / 3)) end
function DP.sqrt(a)
	if a.be then return fromTri(BEc.sqrt(a.be)) end
	local v = a.v
	if type(v) == "number" and v ~= 0 and v < 1 / 9e15 and v > -1 / 9e15 then return fromTri(BEc.sqrt(tri(a))) end   -- old library: NaN
	if type(v) == "number" and v < 0 then
		if v > -EXP_LIMIT then return mk(0 / 0) end
		return mk(TN.sqrt(-v))               -- layer 1: the sign is dropped
	end
	if type(v) == "table" and v.h == nil and v.m < 0 then
		local s, l = comps(v)
		local r = TN.sqrt(TN.neg(v))
		if l >= 2 then return mk(TN.neg(r)) end
		return mk(r)
	end
	return mk(TN.sqrt(v))
end
local function positive(v)
	if type(v) == "number" then return v > 0 end
	return v.m > 0
end
function DP.log10(a) if a.be then return fromTri(BEc.log10(a.be)) end if not positive(a.v) then return nanL() end return mk(TN.log10(a.v)) end
function DP.ln(a) if a.be then return fromTri(BEc.ln(a.be)) end if not positive(a.v) then return nanL() end return mk(TN.ln(a.v)) end
function DP.log2(a) if a.be then return fromTri(BEc.log2(a.be)) end if not positive(a.v) then return nanL() end return mk(TN.log2(a.v)) end
local function logV(av, bv)
	if not positive(av) or not positive(bv) or bv == 1 then return 0 / 0 end
	if type(av) == "number" and type(bv) == "number" and av < EXP_LIMIT and bv < EXP_LIMIT then
		return math.log(av) / math.log(bv)
	end
	return TN.div(TN.log10(av), TN.log10(bv))
end
function DP.log(a, base)
	if a.be or special(base) then return fromTri(BEc.log(tri(a), tri(base))) end
	local bv = V(base)
	if not positive(a.v) or not positive(bv) or bv == 1 then return nanL() end
	return mk(logV(a.v, bv))
end
function DP.exp(a)
	if a.be then return fromTri(BEc.exp(a.be)) end
	local v = a.v
	if type(v) == "number" and v <= 709.7 and v >= -709.7 then return mk(math.exp(v)) end
	return fromTri(BEc.exp(tri(a)))
end
local function magRound(a, f, bef)
	if a.be then return fromTri(bef(a.be)) end
	local v = a.v
	if type(v) ~= "number" then
		local s, l, m = comps(v)
		if m < 0 then return mk(0) end      -- tiny (1e-9e15 and below)
		return a
	end
	if v ~= v then return a end
	local m = abs(v)
	if m >= EXP_LIMIT then return a end
	if m < 1 / 9e15 then return mk(0) end
	local r = f(m)
	if v < 0 then r = -r end
	return mk(r)
end
function DP.floor(a) return magRound(a, floor, BEc.floor) end
function DP.ceil(a) return magRound(a, math.ceil, BEc.ceil) end
function DP.round(a) return magRound(a, function(m) return floor(m + 0.5) end, BEc.round) end
function DP.trunc(a) return magRound(a, floor, BEc.floor) end
function DP.abs(a) if a.be then return fromTri(BEc.abs(a.be)) end return mk(TN.abs(a.v)) end
function DP.neg(a) if a.be then return fromTri(BEc.neg(a.be)) end return mk(TN.neg(a.v)) end
DP.negate = DP.neg
function DP.mod(a, b) return mk(TN.mod(a.v, V(b))) end
function DP.tetrate(a, h, payload)
	if h == nil then h = 2 end
	if payload ~= nil and not TN.eq(V(payload), 1) then
		local x = V(payload)
		for _ = 1, floor(TN.toNumber(V(h))) do x = powV(a.v, x) end
		return mk(x)
	end
	return mk(TN.tetrate(a.v, V(h)))
end
function DP.slog(a, base)
	-- the old break_eternity: linear critical section, done on components so every case matches
	local copy = tri(a)
	if copy.m < 0 then return mk(-1) end
	local b = if base == nil then BEc.fromNumber(10) else tri(base)
	local result = 0
	if copy.l - b.l > 3 then
		local loss = copy.l - b.l - 3
		result += loss
		copy = BEc.NN(copy.s, copy.l - loss, copy.m)
	end
	for _ = 1, 100 do
		if BEc.lt(copy, BEc.NN(0, 0, 0)) then
			copy = BEc.pow(b, copy)
			result -= 1
		elseif BEc.lte(copy, BEc.NN(1, 0, 1)) then
			return fromTri(BEc.fromNumber(result + BEc.toNumber(copy) - 1))
		else
			result += 1
			copy = BEc.log(copy, b)
		end
	end
	return fromTri(BEc.fromNumber(result))
end

-- new Decimal(string): the game's break_eternity fromString, step for step. The game leans on its leniency: a number
-- that became a string by accident ("0.02" + a Decimal is "0.021", then "0.0210.02") still reads as its longest
-- numeric prefix (0.021), and text that is no number at all reads as 0, never NaN.
local function jsParseFloat(str_)
	local rest = string.match(str_, "^%s*(.*)$")
	local sign = ssub(rest, 1, 1)
	if sign == "+" or sign == "-" then rest = ssub(rest, 2) else sign = "" end
	if ssub(rest, 1, 8) == "Infinity" then return if sign == "-" then -huge else huge end
	local num = string.match(rest, "^%d+%.?%d*") or string.match(rest, "^%.%d+")
	if num == nil then return 0 / 0 end
	local e = string.match(ssub(rest, #num + 1), "^[eE][%+%-]?%d+")
	local n = tonumber(num .. (e or ""))
	if sign == "-" then n = -n end
	return n
end
JS.parseFloat = jsParseFloat
local function jsSplit(str_, sep)
	local parts, init = {}, 1
	while true do
		local a, b = sfind(str_, sep, init, true)
		if a == nil then parts[#parts + 1] = ssub(str_, init); return parts end
		parts[#parts + 1] = ssub(str_, init, a - 1)
		init = b + 1
	end
end
local function jsFinite(x) return x == x and x ~= huge and x ~= -huge end
local function replaceFirst(str_, a, b)
	local i, j = sfind(str_, a, 1, true)
	if i == nil then return str_ end
	return ssub(str_, 1, i - 1) .. b .. ssub(str_, j + 1)
end
local function tetratedTri(base, height, payload)
	return tri(DP.tetrate(mk(base), height, if payload == 1 then nil else payload))
end
local function beFromString(value)
	value = replaceFirst(value, ",", "")                  -- IGNORE_COMMAS
	local parts = jsSplit(value, "^^^")                   -- x^^^y
	if #parts == 2 then
		local base, height = jsParseFloat(parts[1]), jsParseFloat(parts[2])
		if jsFinite(base) and jsFinite(height) then return tri(mk(TN.pentate(base, height))) end
	end
	parts = jsSplit(value, "^^")                          -- x^^y[;payload]
	if #parts == 2 then
		local base, height = jsParseFloat(parts[1]), jsParseFloat(parts[2])
		local payload = 1
		local hp = jsSplit(parts[2], ";")
		if #hp == 2 then payload = jsParseFloat(hp[2]); if not jsFinite(payload) then payload = 1 end end
		if jsFinite(base) and jsFinite(height) then return tetratedTri(base, height, payload) end
	end
	parts = jsSplit(value, "^")                           -- x^y
	if #parts == 2 then
		local base, exponent = jsParseFloat(parts[1]), jsParseFloat(parts[2])
		if jsFinite(base) and jsFinite(exponent) then return tri(DP.pow(mk(base), exponent)) end
	end
	value = slower(string.match(value, "^%s*(.-)%s*$"))
	for _, sep in { "pt", "p" } do                        -- X pt Y / XpY: 10^^X with payload Y
		parts = jsSplit(value, sep)
		if #parts == 2 then
			local height = jsParseFloat(parts[1])
			local payload = jsParseFloat(replaceFirst(replaceFirst(parts[2], "(", ""), ")", ""))
			if not jsFinite(payload) then payload = 1 end
			if jsFinite(height) then return tetratedTri(10, height, payload) end
		end
	end
	parts = jsSplit(value, "e")
	local ecount = #parts - 1
	if ecount == 0 then
		local n = jsParseFloat(value)
		if jsFinite(n) then return BEc.fromNumber(n) end
	elseif ecount == 1 then
		local n = jsParseFloat(value)
		if jsFinite(n) and n ~= 0 then return BEc.fromNumber(n) end
	end
	local t = BEc.NN(0, 0, 0)
	local newparts = jsSplit(value, "e^")                 -- (e^N)X
	if #newparts == 2 then
		t.s = if ssub(newparts[1], 1, 1) == "-" then -1 else 1
		local np = newparts[2]
		for i = 1, #np do
			local c = sbyte(np, i)
			if not ((c >= 43 and c <= 57) or c == 101) then
				t.l = jsParseFloat(ssub(np, 1, i - 1))
				t.m = jsParseFloat(ssub(np, i + 1))
				if t.l == huge or t.l == -huge then return BEc.NN(0 / 0, 0 / 0, 0 / 0) end   -- the web game hangs here
				return BEc.normalize(t)
			end
		end
	end
	if ecount < 1 then return BEc.NN(0, 0, 0) end
	local mantissa = jsParseFloat(parts[1])
	if mantissa == 0 then return BEc.NN(0, 0, 0) end
	local exponent = jsParseFloat(parts[#parts])
	if ecount >= 2 then
		local me = jsParseFloat(parts[#parts - 1])
		if jsFinite(me) then
			exponent *= (if me > 0 then 1 elseif me < 0 then -1 else me)
			exponent += (if me > 0 then 1 elseif me < 0 then -1 else me) * math.log10(abs(me))
		end
	end
	if not jsFinite(mantissa) then
		t.s = if parts[1] == "-" then -1 else 1
		t.l = ecount
		t.m = exponent
	elseif ecount == 1 then
		t.s = if mantissa > 0 then 1 elseif mantissa < 0 then -1 else mantissa
		t.l = 1
		t.m = exponent + math.log10(abs(mantissa))
	else
		t.s = if mantissa > 0 then 1 elseif mantissa < 0 then -1 else mantissa
		t.l = ecount
		if ecount == 2 then return BEc.mul(BEc.FC(1, 2, exponent), BEc.fromNumber(mantissa)) end
		t.m = exponent
	end
	return BEc.normalize(t)
end
-- strings the game parses are mostly constants ("ee9", "1e1000") read every tick: remember what they came to
local STRCACHE, strCount = {}, 0
function parseStr(x)
	local c = STRCACHE[x]
	if c == nil then
		local t = beFromString(x)
		local d = fromTri(t)
		c = { d.v, d.be }
		if strCount > 4096 then table.clear(STRCACHE); strCount = 0 end
		STRCACHE[x] = c
		strCount += 1
	end
	return c[1], c[2]
end
JS.beFromString = beFromString
function DP.lambertw(a) return mk(TN.lambertw(a.v)) end
function DP.toNumber(a) if a.be then return BEcore.toNumber(a.be) end return TN.toNumber(a.v) end
function DP.sign_(a) return TN.sign(a.v) end
function DP.isNan(a) return TN.isNaN(a.v) end
function DP.isFinite(a) return not TN.isNaN(a.v) and not TN.isInf(a.v) end
function DP.valueOf(a) return DP.toString(a) end
function DP.toJSON(a) return DP.toString(a) end
function DP.fromValue(a, x) a.v = V(x); return a end

-- ------------------------------------------------------------------ JS number -> string
local function jsExp(x) -- shortest round-trip digits + decimal exponent
	-- 15 significant digits always land on the shortest form when they round-trip; else 16, else 17
	for _, p in { 15, 16, 17 } do
		local s = sfmt("%." .. (p - 1) .. "e", x)
		if p == 17 or tonumber(s) == x then
			local mant, ex = string.match(s, "^%-?([%d%.]+)e([%+%-]%d+)$")
			return (string.gsub(mant, "%.", "")), tonumber(ex)
		end
	end
	return "0", 0
end
local INTSTR = {}
local function numToString(x)
	if x == floor(x) and x < 1e15 and x > -1e15 then   -- integers (the common case)
		if x >= 0 and x < 100000 then
			local c = INTSTR[x]
			if c == nil then c = sfmt("%d", x); INTSTR[x] = c end
			return c
		end
		return sfmt("%d", x)
	end
	if x ~= x then return "NaN" end
	if x == huge then return "Infinity" end
	if x == -huge then return "-Infinity" end
	if x == 0 then return "0" end
	local neg = x < 0
	if neg then x = -x end
	local digits, e = jsExp(x)
	digits = string.gsub(digits, "0+$", "")
	if digits == "" then digits = "0" end
	local k, n = #digits, e + 1
	local s
	if k <= n and n <= 21 then s = digits .. srep("0", n - k)
	elseif 0 < n and n <= 21 then s = ssub(digits, 1, n) .. "." .. ssub(digits, n + 1)
	elseif -6 < n and n <= 0 then s = "0." .. srep("0", -n) .. digits
	else
		local es = (if n - 1 >= 0 then "+" else "-") .. tostring(abs(n - 1))
		if k == 1 then s = digits .. "e" .. es else s = ssub(digits, 1, 1) .. "." .. ssub(digits, 2) .. "e" .. es end
	end
	return if neg then "-" .. s else s
end
JS.numToString = numToString

local function toFixed(x, f)
	f = floor(f or 0)
	if x ~= x then return "NaN" end
	if abs(x) >= 1e21 then return numToString(x) end
	local s = sfmt("%." .. f .. "f", x)
	-- JS picks the larger n on an exact tie; C rounds ties to even
	local scaled = abs(x) * 10 ^ f
	if scaled - floor(scaled) == 0.5 and scaled < 2 ^ 52 then
		local up = (floor(scaled) + 1) / 10 ^ f
		s = sfmt("%." .. f .. "f", if x < 0 then -up else up)
	end
	if s == "-0" or string.match(s, "^%-0%.?0*$") then s = ssub(s, 2) end
	return s
end
JS.toFixed = toFixed
local function toPrecision(x, p)
	if x ~= x then return "NaN" end
	if abs(x) == huge then return numToString(x) end
	p = floor(p)
	if x == 0 then return if p > 1 then "0." .. srep("0", p - 1) else "0" end
	local s = sfmt("%." .. (p - 1) .. "e", x)
	local sign, mant, ex = string.match(s, "^(%-?)([%d%.]+)e([%+%-]%d+)$")
	local e = tonumber(ex)
	local digits = string.gsub(mant, "%.", "")
	if e < -6 or e >= p then
		return sign .. ssub(digits, 1, 1) .. (if p > 1 then "." .. ssub(digits, 2) else "") .. "e" .. (if e >= 0 then "+" else "-") .. abs(e)
	end
	if e >= 0 then
		local ip = ssub(digits, 1, e + 1)
		local fp = ssub(digits, e + 2)
		return sign .. ip .. (if #fp > 0 then "." .. fp else "")
	end
	return sign .. "0." .. srep("0", -e - 1) .. digits
end
JS.toPrecision = toPrecision

function DP.toString(a)
	local s, l, m = comps(a.v)
	if s ~= s then return "NaN" end
	if l == huge then return if s < 0 then "-Infinity" else "Infinity" end
	if l == 0 then
		if (m < 1e21 and m > 1e-7) or m == 0 then return numToString(s * m) end
		return numToString(dprop(a, "m")) .. "e" .. numToString(dprop(a, "e"))
	end
	if l == 1 then return numToString(dprop(a, "m")) .. "e" .. numToString(dprop(a, "e")) end
	if l <= 5 then return (if s == -1 then "-" else "") .. srep("e", l) .. numToString(m) end
	return (if s == -1 then "-" else "") .. "(e^" .. l .. ")" .. numToString(m)
end
local function decimalPlaces(v, places)
	local len = places + 1
	local numDigits = math.ceil(math.log10(abs(v)))
	local rounded = math.floor(v * 10 ^ (len - numDigits) + 0.5) * 10 ^ (numDigits - len)
	return toFixed(rounded, math.max(len - numDigits, 0))
end
function DP.toStringWithDecimalPlaces(a, places)
	local s, l, m = comps(a.v)
	if l == 0 then
		if (m < 1e21 and m > 1e-7) or m == 0 then return toFixed(s * m, places) end
		return decimalPlaces(dprop(a, "m"), places) .. "e" .. decimalPlaces(dprop(a, "e"), places)
	end
	if l == 1 then return decimalPlaces(dprop(a, "m"), places) .. "e" .. decimalPlaces(dprop(a, "e"), places) end
	if l <= 5 then return (if s == -1 then "-" else "") .. srep("e", l) .. decimalPlaces(m, places) end
	return (if s == -1 then "-" else "") .. "(e^" .. l .. ")" .. decimalPlaces(m, places)
end
function DP.toFixed(a, places)
	local s, l, m = comps(a.v)
	if l == 0 then return toFixed(s * m, places) end
	return DP.toStringWithDecimalPlaces(a, places)
end
function DP.toPrecision(a, places)
	local e = dprop(a, "e")
	if e <= -7 then return DP.toStringWithDecimalPlaces(a, places - 1) end
	if places > e then return DP.toFixed(a, places - e - 1) end
	return DP.toStringWithDecimalPlaces(a, places - 1)
end

-- static Decimal
local Decimal = {}
JS.Decimal = Decimal
for _, name in { "add", "sub", "mul", "div", "pow", "max", "min", "cmp", "gte", "gt", "lte", "lt", "eq", "log", "root", "tetrate", "slog", "plus", "minus", "times" } do
	Decimal[name] = function(a, ...) return DP[name](D(a), ...) end
end
for _, name in { "log10", "ln", "log2", "exp", "sqrt", "cbrt", "floor", "ceil", "round", "abs", "neg", "recip", "toNumber" } do
	Decimal[name] = function(a) return DP[name](D(a)) end
end
Decimal.fromValue = function(x) return D(x) end
Decimal.fromNumber = Decimal.fromValue
Decimal.fromString = Decimal.fromValue
Decimal.dZero, Decimal.dOne, Decimal.dTen = mk(0), mk(1), mk(10)
Decimal.dInf, Decimal.dNegInf, Decimal.dNaN = mk(huge), mk(-huge), mk(0 / 0)
Decimal.dInf.be = BEcore.NN(1, huge, huge)
Decimal.dNegInf.be = BEcore.NN(-1, huge, huge)
Decimal.dNegOne = mk(-1)
Decimal.affordGeometricSeries = function(res, start, ratio, cur) return mk(TN.affordGeometricSeries(V(res), V(start), V(ratio), V(cur))) end
Decimal.sumGeometricSeries = function(n, start, ratio, cur) return mk(TN.sumGeometricSeries(V(n), V(start), V(ratio), V(cur))) end
Decimal.affordArithmeticSeries = function(res, start, add, cur) return mk(TN.affordArithmeticSeries(V(res), V(start), V(add), V(cur))) end
Decimal.sumArithmeticSeries = function(n, start, add, cur) return mk(TN.sumArithmeticSeries(V(n), V(start), V(add), V(cur))) end
Decimal.isNaN = function(x) return TN.isNaN(V(x)) end

-- ------------------------------------------------------------------ JS core semantics
-- JS null: a real value (object keys can hold it, unlike nil). Falsy, == undefined, typeof "object".
local NULL = setmetatable({}, { __index = function() return nil end, __tostring = function() return "null" end, __jsnull = true })
JS.NULL = NULL
function JS.isnil(x) return x == nil or x == NULL end
function JS.t(x)
	if x == nil or x == false or x == 0 or x == "" or x == NULL then return false end
	if x ~= x then return false end
	return true
end
local truthy = JS.t

function JS.k(k)
	local t = type(k)
	if t == "number" then return k end
	if t == "string" then
		-- canonical integer strings ("0", "11", "-3", no leading zeros) are number keys
		local b = sbyte(k, 1)
		if b and ((b >= 49 and b <= 57) or (b == 48 and #k == 1) or (b == 45 and #k > 1 and sbyte(k, 2) ~= 48)) and #k <= 15
			and not sfind(k, "[^%d]", if b == 45 then 2 else 1) then
			return tonumber(k)
		end
		return k
	end
	if k == nil then return "undefined" end
	if t == "boolean" then return tostring(k) end
	if isD(k) then return JS.k(DP.toString(k)) end
	if t == "table" and LEN[k] then return JS.k(JS.str(k)) end   -- obj[[14]] is obj["14"]
	return k
end

-- loop guards the transpiler puts in (see js2lua guard / forStmt)
function JS.runaway() error("the game got stuck in a loop that never ends", 2) end
function JS.cap(s, l, step)
	if type(s) == "number" and type(l) == "number" and (l - s) / step > 5e6 then JS.runaway() end
	return l
end

function JS.len(x)
	local n = LEN[x]
	if n then return n end
	local t = type(x)
	if t == "string" then return utf8.len(x) or #x end
	if t == "table" then return rawget(x, "length") end
	if t == "function" then return 0 end
	error("Cannot read properties of " .. tostring(x) .. " (reading 'length')", 2)
end
function JS.setlen(a, n)
	KC[a] = nil
	local cur = LEN[a]
	if cur then for i = n, cur - 1 do a[i] = nil end LEN[a] = n return end
	a.length = n
end

function JS.A(n, ...)
	local t = {}
	for i = 1, n do t[i - 1] = (select(i, ...)) end
	LEN[t] = n
	return t
end
local function newArr(list, n) -- 1-based lua list -> JS array
	local t = {}
	n = n or #list
	for i = 1, n do t[i - 1] = list[i] end
	LEN[t] = n
	return t
end
JS.newArr = newArr
local function toList(a) -- JS array -> 1-based list
	local n = LEN[a] or 0
	local l = table.create(n)
	for i = 0, n - 1 do l[i + 1] = a[i] end
	return l, n
end
JS.toList = toList
function JS.isArray(x) return LEN[x] ~= nil end

function JS.O(t, order)
	if order then ORDER[t] = table.clone(order) end
	return t
end
function JS.set(o, k, v)
	local n = LEN[o]
	if n and type(k) == "number" then
		if k >= n then LEN[o] = k + 1 end
		if (rawget(o, k) == nil) ~= (v == nil) then KC[o] = nil end
		o[k] = v
		return
	end
	if type(o) == "table" and (rawget(o, k) == nil) ~= (v == nil) then KC[o] = nil end
	if type(k) == "string" and v ~= nil and rawget(o, k) == nil and type(o) == "table" then
		local ord = ORDER[o]
		if not ord then ord = {}; ORDER[o] = ord end
		ord[#ord + 1] = k
	end
	o[k] = v
end
JS.setk = JS.set

local function sortedKeys(o)
	local nums, strs, seen = {}, {}, {}
	local ord = ORDER[o]
	if ord then
		for _, k in ord do
			if not seen[k] and rawget(o, k) ~= nil then seen[k] = true; strs[#strs + 1] = k end
		end
	end
	local rest = {}
	for k, v in pairs(o) do
		local tk = type(k)
		if tk == "number" then nums[#nums + 1] = k
		elseif tk == "string" and not seen[k] then rest[#rest + 1] = k end
	end
	tsort(nums)
	tsort(rest)
	local out = nums
	for _, k in strs do out[#out + 1] = k end
	for _, k in rest do out[#out + 1] = k end
	return out
end
function JS.keylist(o)
	if o == nil then return {} end
	if type(o) == "string" then local l = {}; for i = 0, #o - 1 do l[i + 1] = i end return l end
	if type(o) ~= "table" or isD(o) then return {} end
	return sortedKeys(o)
end
-- for-in over an array skips an index that is gone by the time the loop gets to it (the game splices arrays while
-- it walks them, e.g. adjustPopupTime); objects keep the fast path
local function liveIdx(st, i)
	local c, a = st[1], st[2]
	while true do
		i += 1
		local k = c[i]
		if k == nil then return nil end
		if type(k) == "number" then
			if k < (LEN[a] or 0) then return i, k end
		elseif rawget(a, k) ~= nil then return i, k end
	end
end
function JS.keys(o)
	if type(o) == "table" then
		local c = KC[o]
		if c == nil then c = JS.keylist(o); KC[o] = c end
		if LEN[o] then return liveIdx, { c, o }, 0 end
		return ipairs(c)
	end
	return ipairs(JS.keylist(o))
end
JS.KC = KC
function JS.vals(o)
	local n = LEN[o]
	if n then local l = {}; for i = 0, n - 1 do l[i + 1] = o[i] end return ipairs(l) end
	if type(o) == "string" then local l = {}; for i = 1, #o do l[i] = ssub(o, i, i) end return ipairs(l) end
	error("not iterable")
end

local function str(x)
	local t = type(x)
	if t == "string" then return x end
	if x == NULL then return "null" end
	if t == "number" then return numToString(x) end
	if x == nil then return "undefined" end
	if t == "boolean" then return if x then "true" else "false" end
	if t == "function" then return "function" end
	if isD(x) then return DP.toString(x) end
	if LEN[x] then
		local l, n = toList(x)
		for i = 1, n do l[i] = if l[i] == nil then "" else str(l[i]) end
		return tconcat(l, ",", 1, n)
	end
	if t == "table" and rawget(x, "toString") then return x:toString() end
	return "[object Object]"
end
JS.str = str

local function tonum(x)
	local t = type(x)
	if t == "number" then return x end
	if t == "string" then
		local s = string.match(x, "^%s*(.-)%s*$")
		if s == "" then return 0 end
		if s == "Infinity" or s == "+Infinity" then return huge end
		if s == "-Infinity" then return -huge end
		local n = tonumber(s)
		if n == nil or string.find(s, "^0[xX]") == nil and string.find(s, "[^%d%.eE%+%-]") then return if n and not string.find(s, "[^%d%.eE%+%-xX]") then n else 0 / 0 end
		return n
	end
	if t == "boolean" then return if x then 1 else 0 end
	if x == nil then return 0 / 0 end
	if x == NULL then return 0 end
	if isD(x) then return tonum(DP.toString(x)) end
	if LEN[x] then local n = LEN[x]; if n == 0 then return 0 end if n == 1 then return tonum(x[0]) end end
	return 0 / 0
end
JS.tonum = tonum

function JS.add(a, b)
	local ta, tb = type(a), type(b)
	if ta == "number" and tb == "number" then return a + b end
	if ta == "string" or tb == "string" or ta == "table" or tb == "table" then return str(a) .. str(b) end
	return tonum(a) + tonum(b)
end

function JS.eq(a, b)
	if a == b then return true end
	if (a == nil or a == NULL) and (b == nil or b == NULL) then return true end
	local ta, tb = type(a), type(b)
	if ta == tb then return false end
	if (ta == "number" and tb == "string") or (ta == "string" and tb == "number") then return tonum(a) == tonum(b) end
	-- a Decimal against a primitive compares its valueOf (its string), as JS does (pm's exponent: points == 14)
	if ta == "table" and (tb == "number" or tb == "string") and isD(a) then return JS.eq(DP.toString(a), b) end
	if tb == "table" and (ta == "number" or ta == "string") and isD(b) then return JS.eq(a, DP.toString(b)) end
	return false
end

function JS.cmp(a, op, b)
	if type(a) == "string" and type(b) == "string" then
		if op == "<" then return a < b elseif op == ">" then return a > b elseif op == "<=" then return a <= b else return a >= b end
	end
	local x, y = tonum(a), tonum(b)
	if op == "<" then return x < y elseif op == ">" then return x > y elseif op == "<=" then return x <= y else return x >= y end
end

function JS.typeof(x)
	local t = type(x)
	if t == "nil" then return "undefined" end
	if t == "table" then
		local mt = getmetatable(x)
		if mt and mt.__call and mt.__jsfunc then return "function" end
		return "object"
	end
	return t
end

function JS.has(o, k) if type(o) ~= "table" then return false end return o[JS.k(k)] ~= nil end
function JS.and_(a, f) if truthy(a) then return f() end return a end
function JS.or_(a, f) if truthy(a) then return a end return f() end
function JS.nc(a, f) if a == nil or a == NULL then return f() end return a end

function JS.mc(o, k, ...)
	local f = o[k]
	if f == nil then error("TypeError: " .. str(k) .. " is not a function", 2) end
	return f(o, ...)
end

-- ------------------------------------------------------------------ regex (only the two this game uses)
function JS.re(p, flags) return { __re = p, flags = flags } end
local function commafy(s) -- /(\d)(?=(\d\d\d)+(?!\d))/g -> "$1,"
	local out, n = {}, #s
	-- apply to every digit run
	local i = 1
	while i <= n do
		local a, b = sfind(s, "%d+", i)
		if not a then out[#out + 1] = ssub(s, i); break end
		out[#out + 1] = ssub(s, i, a - 1)
		local run = ssub(s, a, b)
		local L = #run
		local parts = {}
		local first = L % 3
		if first == 0 then first = 3 end
		parts[1] = ssub(run, 1, first)
		for j = first + 1, L, 3 do parts[#parts + 1] = ssub(run, j, j + 2) end
		out[#out + 1] = tconcat(parts, ",")
		i = b + 1
	end
	return tconcat(out)
end

-- ------------------------------------------------------------------ builtin methods (array / string / number / function)
local function stableSort(list, n, cmp)
	-- merge sort (JS sort is stable)
	if n < 2 then return list end
	local tmp = table.create(n)
	local width = 1
	local src, dst = list, tmp
	while width < n do
		local i = 1
		while i <= n do
			local mid = math.min(i + width, n + 1)
			local hi = math.min(i + 2 * width, n + 1)
			local a, b, k = i, mid, i
			while a < mid and b < hi do
				if cmp(src[b], src[a]) then dst[k] = src[b]; b += 1 else dst[k] = src[a]; a += 1 end
				k += 1
			end
			while a < mid do dst[k] = src[a]; a += 1; k += 1 end
			while b < hi do dst[k] = src[b]; b += 1; k += 1 end
			i += 2 * width
		end
		src, dst = dst, src
		width *= 2
	end
	return src
end

local AM = {}  -- array methods
function AM.push(a, ...) KC[a] = nil;
	local n = LEN[a]
	for i = 1, select("#", ...) do a[n] = (select(i, ...)); n += 1 end
	LEN[a] = n
	return n
end
function AM.pop(a) KC[a] = nil; local n = LEN[a]; if n == 0 then return nil end local v = a[n - 1]; a[n - 1] = nil; LEN[a] = n - 1; return v end
function AM.shift(a) KC[a] = nil;
	local n = LEN[a]; if n == 0 then return nil end
	local v = a[0]
	for i = 1, n - 1 do a[i - 1] = a[i] end
	a[n - 1] = nil; LEN[a] = n - 1
	return v
end
function AM.unshift(a, ...) KC[a] = nil;
	local c = select("#", ...)
	local n = LEN[a]
	for i = n - 1, 0, -1 do a[i + c] = a[i] end
	for i = 1, c do a[i - 1] = (select(i, ...)) end
	LEN[a] = n + c
	return n + c
end
-- a number also finds its string: the port's for-in keys are numbers where JS has strings (a milestone's this.id is
-- 3, JS "3"), and the game looks those ids up in lists of strings (player.m.pseudoBuys.includes(this.id))
-- the string of a small whole number, cached (includes runs thousands of times a tick: hasUpgrade, milestones)
local INTSTR: { [number]: string } = {}
local function intStr(v: number): string
	local s = INTSTR[v]
	if s == nil then
		s = str(v)
		if v == floor(v) and v >= -100000 and v <= 100000 then INTSTR[v] = s end
	end
	return s
end
function AM.includes(a, v)
	local n = LEN[a]
	local vs = if type(v) == "number" then intStr(v) else nil
	for i = 0, n - 1 do
		local x = a[i]
		if x == v or (x ~= x and v ~= v) or (vs ~= nil and x == vs) then return true end
	end
	return false
end
function AM.indexOf(a, v) local n = LEN[a]; for i = 0, n - 1 do if a[i] == v then return i end end return -1 end
function AM.lastIndexOf(a, v) for i = LEN[a] - 1, 0, -1 do if a[i] == v then return i end end return -1 end
function AM.join(a, sep)
	if sep == nil then sep = "," end
	local l, n = toList(a)
	for i = 1, n do l[i] = if l[i] == nil then "" else str(l[i]) end
	return tconcat(l, sep, 1, n)
end
AM.toString = function(a) return AM.join(a) end
local function relIdx(i, n, def)
	if i == nil then return def end
	i = tonum(i)
	if i ~= i then return 0 end
	i = if i < 0 then math.max(n + i, 0) else math.min(i, n)
	return floor(i)
end
function AM.slice(a, s, e)
	local n = LEN[a]
	s, e = relIdx(s, n, 0), relIdx(e, n, n)
	local out, k = {}, 0
	for i = s, e - 1 do out[k] = a[i]; k += 1 end
	LEN[out] = math.max(k, 0)
	return out
end
function AM.splice(a, s, dc, ...) KC[a] = nil;
	local n = LEN[a]
	s = relIdx(s, n, 0)
	if dc == nil then dc = n - s end
	dc = math.max(0, math.min(floor(tonum(dc)), n - s))
	local removed = {}
	for i = 0, dc - 1 do removed[i] = a[s + i] end
	LEN[removed] = dc
	local ins = select("#", ...)
	local l = toList(a)
	local nl = {}
	for i = 1, s do nl[#nl + 1] = l[i] end
	for i = 1, ins do nl[#nl + 1] = (select(i, ...)) end
	for i = s + dc + 1, n do nl[#nl + 1] = l[i] end
	local nn = s + ins + (n - s - dc)
	for i = 0, math.max(n, nn) - 1 do a[i] = nl[i + 1] end
	LEN[a] = nn
	return removed
end
function AM.sort(a, cmpf) KC[a] = nil;
	local l, n = toList(a)
	local less
	if cmpf then less = function(x, y) return tonum(cmpf(nil, x, y)) < 0 end
	else less = function(x, y) return str(x) < str(y) end end
	l = stableSort(l, n, less)
	for i = 1, n do a[i - 1] = l[i] end
	return a
end
function AM.reverse(a) KC[a] = nil; local l, n = toList(a); for i = 1, n do a[i - 1] = l[n - i + 1] end return a end
function AM.map(a, f) local n = LEN[a]; local out = {}; for i = 0, n - 1 do out[i] = f(nil, a[i], i, a) end LEN[out] = n; return out end
function AM.filter(a, f) local n = LEN[a]; local out, k = {}, 0; for i = 0, n - 1 do if truthy(f(nil, a[i], i, a)) then out[k] = a[i]; k += 1 end end LEN[out] = k; return out end
function AM.forEach(a, f) local n = LEN[a]; for i = 0, n - 1 do f(nil, a[i], i, a) end end
function AM.find(a, f) local n = LEN[a]; for i = 0, n - 1 do if truthy(f(nil, a[i], i, a)) then return a[i] end end return nil end
function AM.findIndex(a, f) local n = LEN[a]; for i = 0, n - 1 do if truthy(f(nil, a[i], i, a)) then return i end end return -1 end
function AM.some(a, f) local n = LEN[a]; for i = 0, n - 1 do if truthy(f(nil, a[i], i, a)) then return true end end return false end
function AM.every(a, f) local n = LEN[a]; for i = 0, n - 1 do if not truthy(f(nil, a[i], i, a)) then return false end end return true end
function AM.reduce(a, f, ...)
	local n = LEN[a]
	local i, acc = 0, nil
	if select("#", ...) > 0 then acc = (...) else acc = a[0]; i = 1 end
	while i < n do acc = f(nil, acc, a[i], i, a); i += 1 end
	return acc
end
function AM.concat(a, ...)
	local l, n = toList(a)
	for j = 1, select("#", ...) do
		local b = select(j, ...)
		if LEN[b] then local bl, bn = toList(b); for i = 1, bn do n += 1; l[n] = bl[i] end
		else n += 1; l[n] = b end
	end
	return newArr(l, n)
end
function AM.fill(a, v, s, e) KC[a] = nil; local n = LEN[a]; s, e = relIdx(s, n, 0), relIdx(e, n, n); for i = s, e - 1 do a[i] = v end return a end

local SM = {}  -- string methods
local function plainFind(s, sub, init) return sfind(s, sub, init, true) end
function SM.includes(s, sub) return plainFind(s, str(sub), 1) ~= nil end
function SM.indexOf(s, sub, from) local a = plainFind(s, str(sub), (from or 0) + 1); return if a then a - 1 else -1 end
function SM.startsWith(s, p) return ssub(s, 1, #p) == p end
function SM.endsWith(s, p) return p == "" or ssub(s, -#p) == p end
function SM.toUpperCase(s) return supper(s) end
function SM.toLowerCase(s) return slower(s) end
function SM.trim(s) return (string.match(s, "^%s*(.-)%s*$")) end
function SM.charAt(s, i) i = floor(tonum(i or 0)); return ssub(s, i + 1, i + 1) end
function SM.charCodeAt(s, i) return sbyte(s, floor(tonum(i or 0)) + 1) or (0 / 0) end
function SM.rep(s, n) return srep(s, floor(tonum(n))) end
SM["repeat"] = SM.rep
function SM.slice(s, a, b)
	local n = #s
	a, b = relIdx(a, n, 0), relIdx(b, n, n)
	if b <= a then return "" end
	return ssub(s, a + 1, b)
end
function SM.substring(s, a, b)
	local n = #s
	a = math.max(0, math.min(floor(tonum(a or 0)), n)); b = if b == nil then n else math.max(0, math.min(floor(tonum(b)), n))
	if a > b then a, b = b, a end
	return ssub(s, a + 1, b)
end
function SM.substr(s, a, len) local n = #s; a = relIdx(a, n, 0); len = if len == nil then n - a else floor(len); return ssub(s, a + 1, a + len) end
function SM.padStart(s, len, fill) fill = fill or " "; while #s < len do s = fill .. s end return ssub(s, -len) end
function SM.padEnd(s, len, fill) fill = fill or " "; while #s < len do s = s .. fill end return ssub(s, 1, len) end
function SM.toString(s) return s end
SM.valueOf = SM.toString
function SM.split(s, sep)
	if sep == nil then return newArr({ s }, 1) end
	local out = {}
	if sep == "" then for i = 1, #s do out[i] = ssub(s, i, i) end return newArr(out, #s) end
	local i = 1
	while true do
		local a, b = plainFind(s, sep, i)
		if not a then out[#out + 1] = ssub(s, i); break end
		out[#out + 1] = ssub(s, i, a - 1)
		i = b + 1
	end
	return newArr(out, #out)
end
function SM.replace(s, pat, rep)
	if type(pat) == "table" and pat.__re then
		if pat.__re == "(\\d)(?=(\\d\\d\\d)+(?!\\d))" then return commafy(s) end
		if pat.__re == "([^(?:e|F)]*)$" then
			-- '-$1': put a minus in front of the trailing run of characters that are none of ( ? : e | F )
			local i = #s
			while i >= 1 do
				local c = ssub(s, i, i)
				if c == "(" or c == "?" or c == ":" or c == "e" or c == "|" or c == "F" or c == ")" then break end
				i -= 1
			end
			return ssub(s, 1, i) .. "-" .. ssub(s, i + 1)
		end
		error("unsupported regex " .. pat.__re)
	end
	pat = str(pat)
	local a, b = plainFind(s, pat, 1)
	if not a then return s end
	local r = if type(rep) == "function" then str(rep(nil, pat)) else str(rep)
	return ssub(s, 1, a - 1) .. r .. ssub(s, b + 1)
end
function SM.concat(s, ...) local out = s; for i = 1, select("#", ...) do out ..= str((select(i, ...))) end return out end

local NM = {}  -- number methods
NM.toFixed = function(x, f) return toFixed(x, f) end
NM.toPrecision = function(x, p) if p == nil then return numToString(x) end return toPrecision(x, p) end
NM.toString = function(x, radix)
	if radix == nil or radix == 10 then return numToString(x) end
	local n, digits, neg = floor(abs(x)), {}, x < 0
	if n == 0 then return "0" end
	local chars = "0123456789abcdefghijklmnopqrstuvwxyz"
	while n > 0 do local d = n % radix; tinsert(digits, 1, ssub(chars, d + 1, d + 1)); n = floor(n / radix) end
	return (if neg then "-" else "") .. tconcat(digits)
end
NM.toLocaleString = function(x) return commafy(numToString(x)) end
NM.valueOf = function(x) return x end

local FM = {}  -- function methods
function FM.bind(f, thisArg, ...)
	local bound = table.pack(...)
	if bound.n == 0 then return function(_, ...) return f(thisArg, ...) end end
	return function(_, ...)
		local args = table.pack(...)
		local all = table.create(bound.n + args.n)
		for i = 1, bound.n do all[i] = bound[i] end
		for i = 1, args.n do all[bound.n + i] = args[i] end
		return f(thisArg, table.unpack(all, 1, bound.n + args.n))
	end
end
function FM.call(f, thisArg, ...) return f(thisArg, ...) end
function FM.apply(f, thisArg, arr) if arr == nil then return f(thisArg) end local l, n = toList(arr); return f(thisArg, table.unpack(l, 1, n)) end
FM.toString = function() return "function" end

function JS.m(o, name, ...)
	local t = type(o)
	if t == "table" then
		if LEN[o] then
			local f = AM[name]
			if f then return f(o, ...) end
		end
		local mt = getmetatable(o)
		if mt == DMT then
			local f = DP[name]
			if f then return f(o, ...) end
			error("Decimal has no method " .. name, 2)
		end
		local f = rawget(o, name)
		if f ~= nil then return f(o, ...) end
		if name == "hasOwnProperty" then return rawget(o, JS.k((...))) ~= nil end
		if name == "toString" then return str(o) end
		if name == "valueOf" then return o end
		if name == "toFixed" or name == "toPrecision" then return NM[name](tonum(o), ...) end
		error("TypeError: o." .. name .. " is not a function", 2)
	elseif t == "string" then
		local f = SM[name]
		if f then return f(o, ...) end
	elseif t == "number" then
		local f = NM[name]
		if f then return f(o, ...) end
	elseif t == "function" then
		local f = FM[name]
		if f then return f(o, ...) end
	elseif t == "boolean" then
		if name == "toString" then return str(o) end
	end
	error("TypeError: " .. str(o) .. "." .. name .. " is not a function", 2)
end

-- ------------------------------------------------------------------ globals the game touches
local G = {}
JS.G = G

local function callable(tbl, f) tbl.__jsfunc = true; return setmetatable(tbl, { __call = f, __jsfunc = true }) end

local seed = 12345
local JMath = {
	PI = math.pi, E = math.exp(1), LN10 = math.log(10), LN2 = math.log(2), LOG10E = 1 / math.log(10), LOG2E = 1 / math.log(2), SQRT2 = math.sqrt(2),
	floor = function(x) return floor(tonum(x)) end,
	ceil = function(x) return math.ceil(tonum(x)) end,
	round = function(x) x = tonum(x); return floor(x + 0.5) end,
	trunc = function(x) x = tonum(x); if x < 0 then return math.ceil(x) end return floor(x) end,
	abs = function(x) return abs(tonum(x)) end,
	sign = function(x) x = tonum(x); if x > 0 then return 1 elseif x < 0 then return -1 end return x end,
	pow = function(a, b) a, b = tonum(a), tonum(b); if b ~= b then return 0 / 0 end if b == 0 then return 1 end return a ^ b end,
	sqrt = function(x) x = tonum(x); if x < 0 then return 0 / 0 end return math.sqrt(x) end,
	cbrt = function(x) x = tonum(x); if x < 0 then return -((-x) ^ (1 / 3)) end return x ^ (1 / 3) end,
	exp = function(x) return math.exp(tonum(x)) end,
	log = function(x) x = tonum(x); if x < 0 then return 0 / 0 end return math.log(x) end,
	log10 = function(x) x = tonum(x); if x < 0 then return 0 / 0 end return math.log10(x) end,
	log2 = function(x) x = tonum(x); if x < 0 then return 0 / 0 end return math.log(x, 2) end,
	sin = function(x) return math.sin(tonum(x)) end, cos = function(x) return math.cos(tonum(x)) end, tan = function(x) return math.tan(tonum(x)) end,
	atan = function(x) return math.atan(tonum(x)) end, atan2 = function(y, x) return math.atan2(tonum(y), tonum(x)) end,
	hypot = function(a, b) return math.sqrt(tonum(a) ^ 2 + tonum(b) ^ 2) end,
	max = function(...)
		local r = -huge
		for i = 1, select("#", ...) do local v = tonum((select(i, ...))); if v ~= v then return 0 / 0 end if v > r then r = v end end
		return r
	end,
	min = function(...)
		local r = huge
		for i = 1, select("#", ...) do local v = tonum((select(i, ...))); if v ~= v then return 0 / 0 end if v < r then r = v end end
		return r
	end,
	random = function() seed = fmod(seed * 1103515245 + 12345, 2147483648); return seed / 2147483648 end,
}
JS.Math = JMath
function JS.seed(s) seed = s end

local Date = { now = function() return JS.NOW end }
JS.DateCtor = Date

local Object = {
	keys = function(o) local l = JS.keylist(o); for i, k in l do l[i] = if type(k) == "number" then numToString(k) else k end return newArr(l, #l) end,
	values = function(o) local l = JS.keylist(o); for i, k in l do l[i] = o[k] end return newArr(l, #l) end,
	entries = function(o) local l = JS.keylist(o); for i, k in l do l[i] = JS.A(2, if type(k) == "number" then numToString(k) else k, o[k]) end return newArr(l, #l) end,
	assign = function(t, ...)
		for i = 1, select("#", ...) do
			local s = select(i, ...)
			if s ~= nil then for _, k in JS.keylist(s) do JS.set(t, k, s[k]) end end
		end
		return t
	end,
	freeze = function(o) return o end,
	getOwnPropertyNames = function(o) return G.Object.keys(o) end,
}

local function isNaNf(x) local n = tonum(x); return n ~= n end
local Number = callable({
	isFinite = function(x) return type(x) == "number" and x == x and abs(x) ~= huge end,
	isNaN = function(x) return type(x) == "number" and x ~= x end,
	isInteger = function(x) return type(x) == "number" and x == floor(x) and abs(x) ~= huge end,
	parseFloat = function(x) return G.parseFloat(nil, x) end,
	MAX_VALUE = 1.7976931348623157e308, MIN_VALUE = 5e-324, MAX_SAFE_INTEGER = 9007199254740991, EPSILON = 2 ^ -52,
	POSITIVE_INFINITY = huge, NEGATIVE_INFINITY = -huge, NaN = 0 / 0,
}, function(_, _this, x) if x == nil then return 0 end return tonum(x) end)
local String = callable({}, function(_, _this, x) return str(x) end)
local Boolean = callable({}, function(_, _this, x) return truthy(x) end)
local Array = callable({ isArray = function(x) return LEN[x] ~= nil end, from = function(x) local l, n = toList(x); return newArr(l, n) end },
	function(_, _this, n) local a = {}; LEN[a] = n or 0; return a end)

-- JSON (save strings)
local function jsonEnc(v, out)
	local t = type(v)
	if v == nil or v == NULL then out[#out + 1] = "null"
	elseif t == "boolean" then out[#out + 1] = tostring(v)
	elseif t == "number" then out[#out + 1] = if v ~= v or abs(v) == huge then "null" else numToString(v)
	elseif t == "string" then out[#out + 1] = '"' .. string.gsub(v, '[%c"\\]', function(c)
			if c == '"' then return '\\"' elseif c == "\\" then return "\\\\" elseif c == "\n" then return "\\n"
			elseif c == "\t" then return "\\t" elseif c == "\r" then return "\\r" elseif c == "\b" then return "\\b" elseif c == "\f" then return "\\f" end
			return sfmt("\\u%04x", sbyte(c))
		end) .. '"'
	elseif isD(v) then jsonEnc(DP.toString(v), out)
	elseif LEN[v] then
		out[#out + 1] = "["
		for i = 0, LEN[v] - 1 do if i > 0 then out[#out + 1] = "," end jsonEnc(v[i], out) end
		out[#out + 1] = "]"
	elseif t == "table" then
		out[#out + 1] = "{"
		local first = true
		for _, k in JS.keylist(v) do
			local x = v[k]
			if x ~= nil and type(x) ~= "function" then
				if not first then out[#out + 1] = "," end
				first = false
				jsonEnc(if type(k) == "number" then numToString(k) else k, out)
				out[#out + 1] = ":"
				jsonEnc(x, out)
			end
		end
		out[#out + 1] = "}"
	else out[#out + 1] = "null" end
end
local JSON = {
	stringify = function(v) local out = {}; jsonEnc(v, out); return tconcat(out) end,
	parse = function(s)
		local pos = 1
		local function ws() pos = sfind(s, "[^%s]", pos) or #s + 1 end
		local val
		local function strv()
			local out = {}
			pos += 1
			while true do
				local c = ssub(s, pos, pos)
				if c == '"' then pos += 1; break end
				if c == "\\" then
					local e = ssub(s, pos + 1, pos + 1)
					if e == "u" then out[#out + 1] = utf8.char(tonumber(ssub(s, pos + 2, pos + 5), 16)); pos += 6
					else out[#out + 1] = ({ n = "\n", t = "\t", r = "\r", b = "\b", f = "\f" })[e] or e; pos += 2 end
				else out[#out + 1] = c; pos += 1 end
			end
			return tconcat(out)
		end
		function val()
			ws()
			local c = ssub(s, pos, pos)
			if c == "{" then
				local o = {}
				pos += 1; ws()
				if ssub(s, pos, pos) == "}" then pos += 1 return o end
				while true do
					ws()
					local k = JS.k(strv())
					ws(); pos += 1
					JS.set(o, k, val())
					ws()
					local d = ssub(s, pos, pos); pos += 1
					if d == "}" then return o end
				end
			elseif c == "[" then
				local l = {}
				pos += 1; ws()
				if ssub(s, pos, pos) == "]" then pos += 1 return newArr(l, 0) end
				local n = 0
				while true do
					n += 1; l[n] = val(); ws()
					local d = ssub(s, pos, pos); pos += 1
					if d == "]" then return newArr(l, n) end
				end
			elseif c == '"' then return strv()
			elseif ssub(s, pos, pos + 3) == "true" then pos += 4 return true
			elseif ssub(s, pos, pos + 4) == "false" then pos += 5 return false
			elseif ssub(s, pos, pos + 3) == "null" then pos += 4 return NULL
			else
				local a, b = sfind(s, "^%-?[%d%.eE%+%-]+", pos)
				pos = b + 1
				return tonumber(ssub(s, a, b))
			end
		end
		return val()
	end,
}

local stub
stub = setmetatable({}, { __index = function() return stub end, __call = function() return stub end, __newindex = function() end })

G.Math, G.Decimal, G.Object, G.JSON, G.Number, G.String, G.Boolean, G.Array, G.Date = JMath, Decimal, Object, JSON, Number, String, Boolean, Array, Date
G.console = { log = function(...) print(...) end, warn = function(...) print(...) end, error = function(...) print(...) end }
G.isNaN = function(_, x) return isNaNf(x) end
G.isFinite = function(_, x) local n = tonum(x); return n == n and abs(n) ~= huge end
G.parseFloat = function(_, x)
	if type(x) == "number" then return x end
	return jsParseFloat(str(x))
end
G.parseInt = function(_, x) local n = G.parseFloat(nil, x); if n ~= n then return n end return if n < 0 then math.ceil(n) else floor(n) end
G.localStorage = { getItem = function() return nil end, setItem = function() end, removeItem = function() end }
G.document, G.window, G.navigator = stub, stub, stub
G.Vue = { set = function(o, k, v) JS.set(o, k, v) end, component = function() end, delete = function(o, k) o[k] = nil end }
G.setInterval = function() return 0 end
G.setTimeout = function() return 0 end
G.clearInterval = function() end
G.alert = function() end
G.confirm = function() return true end
G.prompt = function() return nil end

function JS.new(C, ...)
	if C == Date then return { getTime = function() return JS.NOW end } end
	if C == Decimal then return D((...)) end
	if C == Array then return Array(nil, ...) end
	if type(C) == "function" then local o = {}; C(o, ...); return o end
	error("cannot construct")
end
function JS.instanceof(x, C)
	if x == nil or x == NULL then return false end
	if C == Decimal then return isD(x) end
	if C == Array then return LEN[x] ~= nil end
	if C == Object then return type(x) == "table" end
	return false
end

Object.name, Decimal.name, Array.name, Number.name, String.name, Boolean.name = "Object", "Decimal", "Array", "Number", "String", "Boolean"
local FunctionCtor = { name = "Function" }
function JS.get(o, k)
	local t = type(o)
	if k == "constructor" then
		if t == "function" then return FunctionCtor end
		if t == "number" then return Number end
		if t == "string" then return String end
		if t == "boolean" then return Boolean end
		if t ~= "table" then return nil end
		if isD(o) then return Decimal end
		if LEN[o] then return Array end
		local c = rawget(o, "constructor")
		if c ~= nil then return c end
		return Object
	end
	if t == "function" then return FM[k] end
	if t ~= "table" then return nil end
	return o[k]
end

-- ------------------------------------------------------------------ environment for the transpiled chunks
local ENV = setmetatable({}, { __index = G })
ENV.JS = JS
ENV.math = math
ENV.bit32 = bit32
ENV.pcall = pcall
ENV.error = error
ENV.type = type
ENV.print = print
JS.ENV = ENV

-- TMT helpers whose JS versions depend on JS object internals
function JS.overrides()
	ENV.isFunction = function(_, f) return type(f) == "function" end
	ENV.isPlainObject = function(_, o) return type(o) == "table" and getmetatable(o) == nil and LEN[o] == nil end
	-- native versions of two per-tick TMT walkers (same behaviour, no JS-emulation overhead)
	local function updateTempData(_, layerData, tmpData, funcsData, useThis)
		for _, item in JS.keys(funcsData) do
			ENV.item = item
			local ld = layerData[item]
			local tl = type(ld)
			if tl == "table" then
				if LEN[ld] then
					if item ~= "tabFormat" and item ~= "content" then updateTempData(nil, ld, tmpData[item], funcsData[item], useThis) end
				elseif getmetatable(ld) == nil then
					updateTempData(nil, ld, tmpData[item], funcsData[item], useThis)
				end
			elseif tl == "function" and type(tmpData[item]) ~= "function" then
				local value
				if useThis ~= nil then value = ld(useThis) else value = ld(layerData) end
				JS.set(tmpData, item, value)
			end
		end
	end
	ENV.updateTempData = updateTempData
	local function NaNcheck(_, data)
		for _, item in JS.keys(data) do
			local v = data[item]
			if v == nil or v == NULL then
			elseif LEN[v] then NaNcheck(nil, v)
			elseif v ~= v or (isD(v) and TN.isNaN(v.v)) then
				if not ENV.NaNalert then
					ENV.NaNalert = true
					print("NaN in player: '" .. str(item) .. "'")
					return
				end
			elseif isD(v) then
			elseif type(v) == "table" and getmetatable(v) == nil then NaNcheck(nil, v)
			end
		end
	end
	ENV.NaNcheck = NaNcheck
	ENV.toNumber = function(_, x)   -- utils.js: Decimals convert, numbers stay, anything else goes through parseFloat
		if isD(x) then return DP.toNumber(x) end
		if type(x) == "number" then return x end
		return G.parseFloat(nil, x)
	end
end

return JS
end
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="69">
        <Properties>
          <string name="Name">Session</string>
          <string name="Source"><![CDATA[--!nocheck
--[[
	Session: one player's Milestone Tree NG+ game. Pure Luau (no Roblox services), so the same code runs in the
	server's per-player Actor and in the command-line tests.

	    local s = Session.new(deps, saveJson?, optionsJson?, nowMs)
	    s:tick(nowMs)                 -- the page's 50 ms interval body (offline time, updateTemp, gameLoop, ...)
	    s:act(action, nowMs, hold)    -- a button press; only actions that are on the player's screen are run
	    local patch = s:view()        -- what changed on the player's screen since the last view (see below)
	    local save, opts = s:save()   -- JSON strings for the DataStore (nil while the game holds a NaN)

	deps = { TN = TowerNum, JSRT = the JSRT factory, BEcore = BEcore, chunks = { function... } in load order,
	         Fast = Runtime/Fast (optional: native per-tick overrides) }

	A view patch is { set = { [id] = node }, del = { id... }, tab = name, tabStyle = css, keys = { hotkey... },
	ended = bool, full = true on the first patch } plus, once each when they happen: pop = { popup... },
	notice = { text... }, save = "saving" | "saved" (set by the Worker). Nodes are the view builder's (rbx/view.js) flattened: a container's c lists its
	children's ids; ids are paths ("tab.3.1"). The roots are "map" (the realm map: 21 layer nodes then the gate, so
	"map.N" never moves), "hud" and "tab" (the open panel; tab = "none" while the map is alone).
]]

local Session = {}
Session.__index = Session

-- JS value -> plain Luau (1-based arrays, string keys) that RemoteEvents carry
local function plain(JS, x)
	if x == JS.NULL then return nil end   -- JS null is a sentinel table
	local t = type(x)
	if t ~= "table" then
		if t == "number" and x ~= x then return "NaN" end
		return x
	end
	if JS.isD(x) then return JS.str(x) end
	local n = JS.LEN[x]
	if n then
		local out = table.create(n)
		for i = 0, n - 1 do
			local v = plain(JS, x[i])
			if v == nil then v = false end
			out[i + 1] = v
		end
		return out
	end
	local out = {}
	for k, v in x do
		local tk = type(k)
		if (tk == "string" or tk == "number") and type(v) ~= "function" then
			local pv = plain(JS, v)
			if pv ~= nil then out[if tk == "number" then JS.str(k) else k] = pv end
		end
	end
	return out
end
Session.plain = plain

-- a stable text form of an action (arrays nest: ["click", "sp", [14]])
local function actionKey(a): string
	if type(a) ~= "table" then return tostring(a) end
	local parts = table.create(#a)
	for i, v in a do parts[i] = if type(v) == "table" then "[" .. actionKey(v) .. "]" else tostring(v) end
	return table.concat(parts, "\31")
end
Session.actionKey = actionKey

-- deterministic text form of a flattened node, for change detection
local function sig(v): string
	local t = type(v)
	if t ~= "table" then return tostring(v) end
	local keys = {}
	for k in v do table.insert(keys, k) end
	table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
	local parts = table.create(#keys)
	for i, k in keys do parts[i] = tostring(k) .. "=" .. sig(v[k]) end
	return "{" .. table.concat(parts, ",") .. "}"
end

local function flatten(node, id: string, out: { [string]: any })
	if type(node) ~= "table" then node = { t = "html", h = "" } end
	local entry = {}
	for k, v in node do
		if k ~= "c" then entry[k] = v end
	end
	local kids = node.c
	if type(kids) == "table" then
		local ids = table.create(#kids)
		local n = 0
		for _, child in kids do
			if type(child) == "table" then
				n += 1
				local cid = id .. "." .. n
				ids[n] = cid
				flatten(child, cid, out)
			end
		end
		entry.c = ids
	end
	out[id] = entry
end

local function toJS(JS, v)
	if type(v) ~= "table" then return v end
	local n = #v
	local l = table.create(n)
	for i = 1, n do l[i] = toJS(JS, v[i]) end
	return JS.newArr(l, n)
end

-- ------------------------------------------------------------------------------------------------------ notation
-- The player's number notation (the Options setting; not part of the game save). SCIENTIFIC is the game's own
-- format(). SUFFIX shows 1,000 to 1e303 as 1.23K ... 4.56NoNog (the readable -illion names), and from there suffixes
-- the exponent with 4 figures: 1e23,537 -> e23.54K, e1,329,005 -> e1.329M, e1.080e25 -> e10.80Sp (close costs stay
-- apart: e10.93K vs e10.92K). Numbers under 1,000, exponents under 1,000 (2.19e500) and the F (tetration) range keep
-- the game's format.
local FIRST = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No" }
local UNITS = { "", "U", "D", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No" }
local TENS = { "", "Dc", "Vg", "Tg", "Qag", "Qig", "Sxg", "Spg", "Ocg", "Nog" }
local HUNDREDS = { "", "Ce", "Dce", "Tce", "Qace", "Qice", "Sxce", "Spce", "Occe", "Noce" }
-- the suffix of 1e(3k), k >= 1 (k = 1: K, k = 2: M ... k = 100: NoNog)
local function suffix(k: number): string
	if k <= 10 then return FIRST[k] end
	local n = k - 1 -- the -illion index: 1e(3n + 3)
	return UNITS[n % 10 + 1] .. TENS[math.floor(n / 10) % 10 + 1] .. HUNDREDS[math.floor(n / 100) % 10 + 1]
end
Session.suffix = suffix
local MAX_K = 100 -- 1e300 (NoNog) is the last suffix; past it the exponent takes the suffix
-- m in [1, 1000) with `sig` significant figures ("1.23" / "12.3" / "123", or 4: "1.234" / "12.34" / "123.4"); nil
-- when it rounds up to 1000
local function mantissa(m: number, sig: number): string?
	local d = if m < 10 then sig - 1 elseif m < 100 then sig - 2 else sig - 3
	local s = string.format("%." .. math.max(0, d) .. "f", m)
	if tonumber(s) :: number >= 1000 then return nil end
	return s
end
local function suffixFormatter(JS, orig)
	local D = JS.D
	-- d >= 1000 below 1e303 as mantissa + suffix; nil when it is out of that range
	local function suffixed(d, sig: number): string?
		if d:lt(1000) or d:gte("1e303") then return nil end
		local e = math.floor(d:log10():toNumber() + 1e-9)
		local k = math.floor(e / 3)
		local m = d:div(D(10):pow(3 * k)):toNumber()
		local s = mantissa(m, sig)
		if s == nil then
			k += 1
			s = mantissa(m / 1000, sig) or "1"
		end
		if k > MAX_K then return nil end
		return s .. suffix(k)
	end
	local function fmt(this, decimal, precision, small)
		local d = D(decimal)
		local sign = JS.tonum(JS.P(d, "sign"))
		if sign ~= sign or sign == 0 then return orig(this, decimal, precision, small) end
		if sign < 0 then return "-" .. fmt(this, d:neg(), precision, small) end
		-- Infinity (the cost of an upgrade that is not open yet, e.g. p 41-44 from milestone 124) and NaN forms: the
		-- game's own format. Their log10 is themselves, so the exponent step below would never end
		local mag = JS.tonum(JS.P(d, "mag"))
		if mag ~= mag or mag == math.huge then return orig(this, decimal, precision, small) end
		if d:lt(1000) or d:gte("eeee1000") then return orig(this, decimal, precision, small) end
		local s = suffixed(d, 3)
		if s then return s end
		-- past 1e303: the exponent, suffixed with 4 figures (and again for its own exponent, far enough up)
		local E = d:log10()
		if E:lt(1000) or not E:lt(d) then return orig(this, decimal, precision, small) end
		local es = suffixed(E, 4)
		if es then return "e" .. es end
		return "e" .. fmt(this, E, precision, small)
	end
	return fmt
end

function Session:setNotation(mode: string?)
	local ENV = self.ENV
	self.notation = mode
	if ENV == nil then return end
	local orig = rawget(ENV, "__formatOrig") or ENV.format
	rawset(ENV, "__formatOrig", orig)
	ENV.format = if mode == "SUFFIX" then suffixFormatter(self.JS, orig) else orig
	self.prev = {} -- every number on screen is sent again in the new notation
end

-- ------------------------------------------------------------------------------------------------------ perks
-- the player's game passes (Main/Shop): { speed = 2? }. Speed is the game's own devSpeed (every tick's time counts
-- speed times, offline catch-up too); without the pass devSpeed is cleared.
function Session:setPerks(perks: { [string]: any }?)
	self.perks = perks or {}
	self:_applyPerks()
end
function Session:_applyPerks()
	local ENV, JS = self.ENV, self.JS
	if ENV == nil or ENV.player == nil then return end
	local sp = self.perks and self.perks.speed
	local on = type(sp) == "number" and sp > 1
	JS.setk(ENV.player, "devSpeed", if on then sp else nil)
	ENV.rbx_passSpeed = if on then sp else 0 -- the view shows it as the pass (2× SPEED · ACTIVE), not dev speed
end
-- a Time Warp (a developer product): seconds of progress fed through the next ticks the way the game catches up
-- offline time (a tenth of what is left each tick, at least a second), so it is done in about 3 s
function Session:addWarp(seconds: number)
	self.warp = (self.warp or 0) + math.max(0, seconds)
end

-- ------------------------------------------------------------------------------------------------------ lifecycle
function Session.new(deps, saveJson: string?, optionsJson: string?, nowMs: number)
	local self = setmetatable({}, Session)
	self.deps = deps
	self.prev = {}          -- id -> signature of what the client has
	self.allowed = {}       -- action key -> true, for what is on screen
	self.lastPopup = 0
	self.errors = 0
	self.notices = {}       -- messages for the player (NaN recovered...)
	self.saveEvent = nil    -- "saving" / "saved", set by the Worker, sent once
	self:_start(saveJson, optionsJson, nowMs)
	self.goodSave, self.goodOptions = self:save()
	return self
end

function Session:_start(saveJson: string?, optionsJson: string?, nowMs: number)
	local d = self.deps
	local JS = d.JSRT(d.TN, d.BEcore)
	local ENV = JS.ENV
	JS.NOW = nowMs
	JS.seed(math.random(1, 2147483646))
	for _, f in d.chunks do
		setfenv(f, ENV)
		f()
	end
	JS.overrides()
	if d.Fast then d.Fast(JS, ENV) end -- native versions of the hottest per-tick game functions (Runtime/Fast)
	ENV.rbx_boot(nil, saveJson or "", optionsJson or "")
	self.JS, self.ENV = JS, ENV
	if self.notation then self:setNotation(self.notation) end
	if self.perks then self:_applyPerks() end
	self.prev = {}
	self.lastPopup = 0
	-- popups that were on screen when the game was saved are not news
	local pops = ENV.activePopups
	if pops and JS.LEN[pops] then
		for i = 0, JS.LEN[pops] - 1 do self.lastPopup = math.max(self.lastPopup, (pops[i].id or 0) + 1) end
	end
end

-- back to the last good save (the page's "refresh and you will be un-NaNed")
function Session:_recover(nowMs: number, why: string)
	table.insert(self.notices, why)
	self:_start(self.goodSave, self.goodOptions, nowMs)
end

function Session:tick(nowMs: number): boolean
	local JS, ENV = self.JS, self.ENV
	-- a Time Warp: this tick's clock runs ahead by a slice of it; the game's clock (player.time) is set back to the
	-- real time afterwards, so only this tick's elapsed time grows
	-- (it waits while the game still catches up offline time: that code takes max(remain / 10, this tick's time),
	-- so a slice would count twice)
	local extra = 0
	local w = self.warp
	if w and w > 0 and ENV.player and ENV.player.offTime == nil then
		extra = math.min(w, math.max(w / 10, 1))
		self.warp = w - extra
		if self.warp <= 0.001 then
			self.warp = 0
			self.wantSave = true
		end
	end
	JS.NOW = nowMs + extra * 1000
	local ok, err = pcall(ENV.rbx_tick, nil)
	if extra > 0 and ENV.player then
		JS.NOW = nowMs
		JS.setk(ENV.player, "time", nowMs)
	end
	if not ok then
		self.errors += 1
		self.lastError = tostring(err)
		if self.errors >= 3 then
			self.errors = 0
			self:_recover(nowMs, "The game hit an error and went back to your last save: " .. tostring(err))
		end
		return false
	end
	self.errors = 0
	if ENV.NaNalert then
		self:_recover(nowMs, "An invalid value (NaN) appeared, so the game went back to your last save.")
		return false
	end
	return true
end

-- ---------------------------------------------------------------------------------------------------------- actions
local HOLD_KIND = { click = "hold", grid = "gridHold", buy = "buy" }

function Session:act(a, nowMs: number, hold: boolean?): (boolean, string?)
	if type(a) ~= "table" or type(a[1]) ~= "string" or #a > 4 then return false, "bad action" end
	for _, v in a do
		local tv = type(v)
		if tv ~= "string" and tv ~= "number" and tv ~= "table" then return false, "bad action" end
		if tv == "string" and #v > 200 then return false, "bad action" end
	end
	local key = actionKey(a)
	if a[1] == "key" then
		if not self.hotkeys or not self.hotkeys[a[2]] then return false, "not a hotkey" end
	elseif not self.allowed[key] then
		return false, "not on screen"
	end
	if a[1] == "opt" then return self:_option(a[2], nowMs) end
	local JS, ENV = self.JS, self.ENV
	JS.NOW = nowMs
	local call = a
	if hold then
		local k = HOLD_KIND[a[1]]
		if not k then return false, "not holdable" end
		call = { k, a[2], a[3] }
	end
	local ok, err = pcall(ENV.rbx_do, nil, toJS(JS, call))
	if not ok then return false, tostring(err) end
	return true
end

function Session:_option(name: string, nowMs: number): (boolean, string?)
	if name == "save" then
		self.wantSave = true
		table.insert(self.notices, "Game saved.")
		return true
	elseif name == "playAgain" then
		-- the end screen's Play Again: a fresh game, the options kept (saves live in Roblox, so there is no
		-- export, import or hard reset)
		local _, opts = self:save()
		self:_start(nil, opts, nowMs)
		self.goodSave, self.goodOptions = self:save()
		self.wantSave = true
		return true
	end
	local ok, err = pcall(self.ENV.rbx_do, nil, toJS(self.JS, { "opt", name }))
	return ok, if ok then nil else tostring(err)
end

-- ------------------------------------------------------------------------------------------------------------ saves
function Session:save(): (string?, string?)
	local ok, r = pcall(self.ENV.rbx_saveData, nil)
	if not ok or r == nil or r == self.JS.NULL then return nil, nil end
	return r[0], r[1]
end

-- remember the current state as the one to fall back to; returns what to write to the DataStore
function Session:checkpoint(): (string?, string?)
	local s, o = self:save()
	if s then self.goodSave, self.goodOptions = s, o end
	return s, o
end

-- ------------------------------------------------------------------------------------------------------------- view
function Session:view(): any
	local JS, ENV = self.JS, self.ENV
	local ok, v = pcall(ENV.rbx_view, nil)
	if not ok then
		self.lastError = tostring(v)
		v = nil
	end
	local allowed = {}
	local acts = ENV.rbx_actions
	if acts and JS.LEN[acts] then
		for i = 0, JS.LEN[acts] - 1 do allowed[actionKey(plain(JS, acts[i]))] = true end
	end
	self.allowed = allowed
	local p = if v then plain(JS, v) else {
		map = { t = "map", inside = false, c = {} }, hud = { t = "hud", pts = "?", name = "points", fr = false },
		tab = { t = "html", h = "The page failed to draw." }, tabName = "none",
	}
	local hk = {}
	for _, k in p.keys or {} do hk[k] = true end
	self.hotkeys = hk

	local flat = {}
	flatten(p.map, "map", flat)
	flatten(p.hud, "hud", flat)
	flatten(p.tab, "tab", flat)
	local set, del = {}, {}
	local prev = self.prev
	local nextSig = {}
	local any = false
	for id, e in flat do
		local s = sig(e)
		nextSig[id] = s
		if prev[id] ~= s then set[id] = e; any = true end
	end
	for id in prev do
		if nextSig[id] == nil then table.insert(del, id); any = true end
	end
	local full = next(prev) == nil
	self.prev = nextSig

	local patch = { set = set, del = del, tab = p.tabName, tabStyle = p.tabStyle, keys = p.keys, ended = p.ended, full = full or nil }
	-- popups raised since the last view
	local okp, pops = pcall(ENV.rbx_popups, nil, self.lastPopup)
	if okp and pops and JS.LEN[pops] and JS.LEN[pops] > 0 then
		local list = plain(JS, pops)
		for _, pp in list do self.lastPopup = math.max(self.lastPopup, (pp.id or 0) + 1) end
		patch.pop = list
	end
	if #self.notices > 0 then
		patch.notice = self.notices
		self.notices = {}
	end
	if self.saveEvent then
		patch.save = self.saveEvent
		self.saveEvent = nil
	end
	return patch, any
end

-- the client lost its copy (rejoined the UI): the next view sends everything
function Session:resetView()
	self.prev = {}
end

return Session
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="70">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Shop: game passes and developer products on the server (shared/Products lists them).

	    Shop.start(actorOf)   actorOf(player) -> the player's worker Actor while they play, else nil
	    Shop.refresh(player)  read the player's passes again (on join, after a purchase)

	Passes -> perks: the player's Actor gets ("perks", { speed = 2? }) and the player's MT_Perks attribute holds the
	owned pass keys as JSON (the client's Shop and the SUPPORTER tag read it). A pass bought in game counts at once
	(PromptGamePassPurchaseFinished); ownership is read again on every join.

	Robux spent (the Robux leaderboard): a granted receipt's CurrencySpent, a bought pass's price.

	Products -> ProcessReceipt: a Time Warp goes to the player's Actor ("warp", seconds, name). A receipt is granted
	once: Store.receiptGranted / markReceipt. The answer is NotProcessedYet (Roblox retries later, also on the
	player's next join) while the player has no running game or the grant could not be recorded. In Studio without
	DataStores a test purchase is granted without the record.
]]

local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Store = require(script.Parent:WaitForChild("Store"))
local Leaderboards = require(script.Parent:WaitForChild("Leaderboards"))
local Products = require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("Products"))

local Shop = {}

local actorOf: (Player) -> Actor? = function() return nil end
local owned: { [Player]: { [string]: boolean } } = {}

local function perksOf(set: { [string]: boolean }): { [string]: any }
	local perks: { [string]: any } = {}
	for _, p in Products.passes do
		if set[p.key] and p.speed then perks.speed = math.max(perks.speed or 1, p.speed) end
	end
	return perks
end

local function push(player: Player)
	local set: { [string]: boolean } = owned[player] or {}
	local keys = {}
	for k, v in set do
		if v then table.insert(keys, k) end
	end
	table.sort(keys)
	player:SetAttribute("MT_Perks", HttpService:JSONEncode(keys))
	local a = actorOf(player)
	if a then a:SendMessage("perks", perksOf(set)) end
end

function Shop.refresh(player: Player)
	local set = owned[player] or {}
	for _, p in Products.passes do
		local id = p.id
		if id and not set[p.key] then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
			end)
			if ok and has then set[p.key] = true end
		end
	end
	-- the pass checks yield: a player who left meanwhile is not stored again (PlayerRemoving already cleared them)
	if player.Parent then
		owned[player] = set
		push(player)
	end
end

-- a developer product purchase: grant it once
local function processReceipt(info: any): Enum.ProductPurchaseDecision
	local product = Products.productById(info.ProductId)
	if product == nil then
		warn("[MilestoneTree] a receipt for an unknown product " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(info.PurchaseId)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	local a = if player then actorOf(player) else nil
	-- only a game that has loaded and can save keeps a warp (Worker sets CanGrant); else Roblox retries later
	if player == nil or a == nil or a:GetAttribute("CanGrant") ~= true then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local done, err = Store.receiptGranted(purchaseId)
	local studio = RunService:IsStudio() and not Store.available()
	if done == nil and not studio then
		warn("[MilestoneTree] could not check receipt " .. purchaseId .. ": " .. tostring(err))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if done then return Enum.ProductPurchaseDecision.PurchaseGranted end
	if not studio then
		local ok, e = Store.markReceipt(purchaseId, info.PlayerId, info.ProductId)
		if not ok then
			warn("[MilestoneTree] could not record receipt " .. purchaseId .. ": " .. tostring(e))
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
	end
	if product.warp then a:SendMessage("warp", product.warp, product.name) end
	-- the Robux board (once per granted receipt: a granted receipt never comes back here)
	if not studio then task.spawn(Leaderboards.addRobux, info.PlayerId, tonumber(info.CurrencySpent) or product.price) end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function Shop.start(of: (Player) -> Actor?)
	actorOf = of
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
		if not purchased then return end
		local p = Products.passById(passId)
		if p == nil then return end
		task.spawn(Leaderboards.addRobux, player.UserId, p.price)
		local set = owned[player] or {}
		set[p.key] = true
		owned[player] = set
		push(player)
	end)
	Players.PlayerRemoving:Connect(function(player: Player)
		owned[player] = nil
	end)
end

return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="71">
        <Properties>
          <string name="Name">SoftShutdown</string>
          <string name="Source"><![CDATA[--!strict
--[[
	SoftShutdown: publishing an update and shutting the servers down ("Shut down all servers", "Restart servers")
	moves the players over instead of kicking them.

	    SoftShutdown.closing(players, stopAll, say)   BindToClose: every player goes to one reserved "holding" server
	                                                  (teleport data mtSoftShutdown) while stopAll() saves their games
	                                                  here; a player joining meanwhile is sent there too
	    SoftShutdown.holding() -> boolean             this server is a holding server (a reserved server, no owner)
	    SoftShutdown.hold(player, say)                in a holding server: say("Updating...") on the loading screen,
	                                                  then after HOLD_SECONDS teleport the player to a public server of
	                                                  the new version, again until they are gone (up to TRIES times)

	Each player is teleported on their own: a group TeleportAsync from a server that is shutting down is known to fail
	("The Source Game is invalid") once it holds 2+ players. One ReserveServer code keeps them together in the holding
	server. A teleport that fails after it started (TeleportInitFailed) is tried again. The holding server also sets
	workspace MT_Holding, and the client (first/Boot) teleports itself back if it is still there after a while.

	Not in Studio (no teleports there) and not from a holding server itself. The games are saved by the old server
	(the saves release their locks, and a new server waits for a held lock anyway), so the new server loads them as
	usual; HOLD_SECONDS gives those saves time.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local SoftShutdown = {}

local HOLD_SECONDS = 6
local TRIES = 5
local CLOSE_BUDGET = 27 -- BindToClose gets 30 s in all
SoftShutdown.HOLD_SECONDS = HOLD_SECONDS
SoftShutdown.TRIES = TRIES

local FLAG = "mtSoftShutdown"

-- a reserved server (no owner) that players reached through a soft shutdown
function SoftShutdown.holding(): boolean
	if game.PrivateServerId == "" or game.PrivateServerOwnerId ~= 0 then return false end
	for _, p in Players:GetPlayers() do
		local ok, data = pcall(function() return p:GetJoinData() end)
		local td = if ok and type(data) == "table" then data.TeleportData else nil
		if type(td) == "table" and td[FLAG] then return true end
	end
	-- nobody here yet: a reserved server of this game is only ever made by the soft shutdown
	return #Players:GetPlayers() == 0
end

local function teleport(player: Player, options: TeleportOptions?): boolean
	local ok, err = pcall(function()
		TeleportService:TeleportAsync(game.PlaceId, { player }, options)
	end)
	if not ok then warn("[MilestoneTree] teleport of " .. player.Name .. " failed: " .. tostring(err)) end
	return ok
end

-- teleport one player, trying again (a failed call, or a TeleportInitFailed after it) until they are gone
local function here(p: Player): boolean
	return p.Parent ~= nil
end
local failed: { [Player]: number } = {}
TeleportService.TeleportInitFailed:Connect(function(player: Player)
	failed[player] = (failed[player] or 0) + 1
end)
local function send(player: Player, options: TeleportOptions?, tries: number, onTry: ((number) -> ())?)
	for try = 1, tries do
		if not here(player) then return end
		if onTry then onTry(try) end
		local before = failed[player] or 0
		if teleport(player, options) then
			-- started: it either takes them out, or fails with TeleportInitFailed (then try again)
			local t0 = os.clock()
			while here(player) and (failed[player] or 0) == before and os.clock() - t0 < 12 do task.wait(0.25) end
			if not here(player) then return end
		else
			task.wait(math.min(2 * try, 6))
		end
	end
end
SoftShutdown._send = send

function SoftShutdown.closing(players: { Player }, stopAll: () -> (), say: ((Player, string) -> ())?)
	if RunService:IsStudio() or #players == 0 or SoftShutdown.holding() then
		stopAll()
		return
	end
	local t0 = os.clock()
	for _, p in players do
		if say then say(p, "Updating to the new version. Your game is saved, taking you over") end
	end
	-- one reserved server for everyone (a few tries); without it each goes to a public server of the new version
	local code: string? = nil
	for try = 1, 3 do
		local ok, c = pcall(function() return TeleportService:ReserveServer(game.PlaceId) end)
		if ok and type(c) == "string" then
			code = c
			break
		end
		warn("[MilestoneTree] ReserveServer failed: " .. tostring(c))
		task.wait(try * 0.5)
	end
	local options: TeleportOptions? = nil
	if code then
		local o = Instance.new("TeleportOptions")
		o.ReservedServerAccessCode = code
		o:SetTeleportData({ [FLAG] = true })
		options = o
	end
	local function go(p: Player) task.spawn(send, p, options, 3, nil) end
	for _, p in players do go(p) end
	local late = Players.PlayerAdded:Connect(go)
	stopAll()
	-- the teleports take the players out; wait for them within BindToClose's time
	while #Players:GetPlayers() > 0 and os.clock() - t0 < CLOSE_BUDGET do task.wait(0.5) end
	late:Disconnect()
end

function SoftShutdown.hold(player: Player, say: (Player, string) -> ())
	workspace:SetAttribute("MT_Holding", true)
	say(player, "Updating to the new version")
	task.spawn(function()
		task.wait(HOLD_SECONDS)
		send(player, nil, TRIES, function(try: number)
			say(player, if try == 1 then "Taking you back" else "Taking you back (try " .. try .. ")")
		end)
		if here(player) then say(player, "Could not take you back. Please rejoin the game.") end
	end)
end

return SoftShutdown
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="72">
        <Properties>
          <string name="Name">Store</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Store: one DataStore record per player, { save = JSON, options = JSON, time = os.time(), lock = { job, t } }.

	`played` is the real time played in seconds (the playtime leaderboard), kept beside the game.

	The lock keeps two servers from playing the same save at once (a quick server hop): load takes it (waiting for
	a live lock elsewhere to be released, and taking over one older than LOCK_TTL), every save refreshes it, and
	the last save on leaving releases it. A save only writes while this server still holds the lock.

	The device options (motion, map detail, labels, interface size) live apart, under "client_<userId>" in the same
	DataStore: never part of the game save or the export string, and last write wins (no lock). Granted
	developer-product receipts are "receipt_<PurchaseId>" (Store.receiptGranted / markReceipt).
]]
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local Config = require(script.Parent.Config)

local Store = {}

export type Record = { save: string?, options: string?, time: number?, played: number?, lock: { job: string, t: number }? }

local store: DataStore? = nil
local function ds(): DataStore
	if store == nil then store = DataStoreService:GetDataStore(Config.STORE_NAME) end
	return store :: DataStore
end

local function key(userId: number): string
	return "player_" .. userId
end

local function jobId(): string
	return if game.JobId ~= "" then game.JobId else "studio"
end

-- errors no retry fixes: Studio without API access, a place that was never published (a .rbxlx opened from disk).
-- After one of those the store is off for this server, so nobody waits on it again. Only in Studio (or an unpublished
-- place): on a live server every error is a passing one (a 502 "API Services rejected request" is retried), and
-- saving is never switched off for everyone.
local unavailable: string? = nil
local function permanent(err: any): boolean
	if not (RunService:IsStudio() or game.PlaceId == 0) then return false end
	local s = string.lower(tostring(err))
	return string.find(s, "studioaccesstoapisnotallowed", 1, true) ~= nil or string.find(s, "publish", 1, true) ~= nil
		or string.find(s, "api services", 1, true) ~= nil or string.find(s, "not allowed", 1, true) ~= nil
		or string.find(s, "403", 1, true) ~= nil
end

local function retry<T...>(f: () -> T...): (boolean, any)
	if unavailable then return false, unavailable end
	local ok, err
	for attempt = 1, 3 do
		ok, err = pcall(f)
		if ok then return true, err end
		if permanent(err) then
			unavailable = tostring(err)
			warn("[MilestoneTree] saving is off on this server: " .. tostring(err)
				.. " (publish the place and turn on Game Settings > Security > Enable Studio Access to API Services)")
			return false, err
		end
		task.wait(attempt)
	end
	return false, err
end

-- -> record (empty for a new player), or nil + reason when the save could not be read
function Store.load(userId: number): (Record?, string?)
	for _ = 1, 10 do
		local blocked = false
		local ok, result = retry(function()
			return ds():UpdateAsync(key(userId), function(old: Record?): Record?
				local rec: Record = old or {}
				local lock = rec.lock
				if lock and lock.job ~= jobId() and os.time() - lock.t < Config.LOCK_TTL then
					blocked = true
					return nil
				end
				rec.lock = { job = jobId(), t = os.time() }
				return rec
			end)
		end)
		if not ok then return nil, tostring(result) end
		if not blocked then return (result or {}) :: Record, nil end
		task.wait(6) -- another server still has this save open: give it time to save and let go
	end
	-- the other server never let go: take the save over as it is
	local ok, result = retry(function()
		return ds():UpdateAsync(key(userId), function(old: Record?): Record?
			local rec: Record = old or {}
			rec.lock = { job = jobId(), t = os.time() }
			return rec
		end)
	end)
	if not ok then return nil, tostring(result) end
	return (result or {}) :: Record, nil
end

-- write the game; release = true on leaving; played = the real seconds played in all (the playtime board; never
-- lowered). false if the lock was lost (another server took the save over).
function Store.save(userId: number, save: string, options: string?, release: boolean?, played: number?): (boolean, string?)
	local lost = false
	local ok, err = retry(function()
		return ds():UpdateAsync(key(userId), function(old: Record?): Record?
			local rec: Record = old or {}
			if rec.lock and rec.lock.job ~= jobId() then
				lost = true
				return nil
			end
			rec.save = save
			rec.options = options
			rec.time = os.time()
			if played then rec.played = math.max(rec.played or 0, math.floor(played)) end
			rec.lock = if release then nil else { job = jobId(), t = os.time() }
			return rec
		end)
	end)
	if not ok then return false, tostring(err) end
	if lost then return false, "another server has this save open" end
	return true, nil
end

-- the player's device options, or nil (none saved yet, or the store could not be read)
function Store.loadPrefs(userId: number): { [string]: any }?
	local ok, result = retry(function()
		return ds():GetAsync("client_" .. userId)
	end)
	if ok and type(result) == "table" then return result end
	return nil
end

function Store.savePrefs(userId: number, prefs: { [string]: any }): (boolean, string?)
	local ok, err = retry(function()
		return ds():SetAsync("client_" .. userId, prefs)
	end)
	if not ok then return false, tostring(err) end
	return true, nil
end

-- developer-product receipts already granted (Roblox retries a receipt until the game answers PurchaseGranted, so a
-- grant must never repeat): "receipt_<PurchaseId>" in the same DataStore
function Store.receiptGranted(purchaseId: string): (boolean?, string?)
	local ok, result = retry(function()
		return ds():GetAsync("receipt_" .. purchaseId)
	end)
	if not ok then return nil, tostring(result) end
	return result ~= nil, nil
end
function Store.markReceipt(purchaseId: string, userId: number, productId: number): (boolean, string?)
	local ok, err = retry(function()
		return ds():SetAsync("receipt_" .. purchaseId, { user = userId, product = productId, t = os.time() })
	end)
	if not ok then return false, tostring(err) end
	return true, nil
end
function Store.available(): boolean
	return unavailable == nil
end

return Store
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="73">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Actor" referent="74">
      <Properties>
        <string name="Name">MilestoneTreeWorker</string>
        <bool name="NeedsPivotMigration">false</bool>
      </Properties>
      <Item class="Script" referent="75">
        <Properties>
          <string name="Name">Worker</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nocheck
--[[
	Worker: one player's game, in its own Actor so every player's game runs in parallel (Parallel Luau).

	Main clones this Actor into ServerScriptService.MilestoneTree.Sessions for each player and sends it messages:
	  "start" (player)            load the save, start the game
	  "act"   (action, hold)      a button press / hotkey from the player's screen
	  "resync"                    the client wants the whole screen again
	  "stop"                      save, release the save lock, send the leaderboard stats, then set Stopped
	The leaderboard stats (server/Leaderboards) go out LB_EVERY seconds (and 30 s after joining, and on leaving), only
	the boards whose value went up. The Actor's TickShare attribute (Main: SERVER_CPU / players) caps this game's
	share of a core.
	The game ticks in the parallel phase; sending to the client and DataStore calls happen in the serial phase.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local actor = script:GetActor()
local root = ServerScriptService:WaitForChild("MilestoneTree")
local Config = require(root:WaitForChild("Config"))
local Session = require(root:WaitForChild("Session"))
local Store = require(root:WaitForChild("Store"))
local Leaderboards = require(root:WaitForChild("Leaderboards"))
local Boards = require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("Boards"))
local TowerNum = require(ReplicatedStorage:WaitForChild("TowerNum")) :: any
local remotes = ReplicatedStorage:WaitForChild("MilestoneTreeRemotes")
local viewRemote: RemoteEvent = remotes:WaitForChild("View")

-- the game: the runtime, TowerNum and the transpiled game files in load order. If any of it fails to load, Main
-- shows the error on the player's screen (the Error attribute) instead of leaving it blank.
local deps
local okLoad, loadErr = pcall(function()
	local runtime = root:WaitForChild("Runtime")
	local gameFolder = root:WaitForChild("Game")
	local chunks = {}
	for name in string.gmatch(require(gameFolder:WaitForChild("Manifest")), "[^,]+") do
		table.insert(chunks, require(gameFolder:WaitForChild(name, 10)))
	end
	deps = {
		TN = require(ReplicatedStorage:WaitForChild("TowerNum")),
		JSRT = require(runtime:WaitForChild("JSRT")),
		BEcore = require(runtime:WaitForChild("BEcore")),
		Fast = require(runtime:WaitForChild("Fast")),
		chunks = chunks,
	}
end)
if not okLoad then
	warn("[MilestoneTree] the game failed to load: " .. tostring(loadErr))
	actor:SetAttribute("Error", "The game failed to load on the server: " .. tostring(loadErr))
	return
end

local player: Player? = nil
local session = nil
local canSave = false        -- false when the save could not be loaded: never overwrite it with a new game
local stopping = false
local tickEvery = Config.TICK
local tickCost = 0           -- running average seconds per tick
local viewEvery = Config.VIEW
local viewCost = 0           -- running average seconds per screen build
local sinceTick, sinceView, sinceSave, sinceSent = 0, 0, 0, 0
local pushNow = false        -- refresh the screen at the next heartbeat (after a button press)
local perks: { [string]: any } = {} -- from the player's passes (Main/Shop)
local pendingWarp = 0        -- Time Warp seconds bought before the session started
local saving = false
local playedBase, loadedAt = 0, os.clock() -- real seconds played before this session (the save), and when it began
local sinceLb = 0
local lbSent: { [string]: number } = {} -- the keys last sent per board (only a higher one is sent again)
local lbBusy = false

local function playedNow(): number
	return playedBase + (os.clock() - loadedAt)
end

local function nowMs(): number
	return DateTime.now().UnixTimestampMillis
end

local function send(patch)
	if player and player.Parent then viewRemote:FireClient(player, patch) end
end

local function notice(text: string)
	if session then table.insert(session.notices, text) end
	pushNow = true
end

-- serial phase only (DataStore yields). The last save (release) waits for an autosave still in flight, so that the
-- autosave cannot take the save lock back after the release.
local function saveNow(release: boolean?)
	if not session or not player or not canSave then return end
	if saving then
		if not release then return end
		local t0 = os.clock()
		while saving and os.clock() - t0 < 30 do task.wait(0.1) end
	end
	saving = true
	local save, options = session:checkpoint()
	if save then
		-- the capsule's SAVING... / SAVED (patch.save, sent once each)
		session.saveEvent = "saving"
		pushNow = true
		local ok, err = Store.save(player.UserId, save, options, release, playedNow())
		if ok then
			session.saveEvent = "saved"
			pushNow = true
		elseif session.saveEvent == "saving" then
			session.saveEvent = nil
		end
		if not ok then
			warn("[MilestoneTree] save failed for " .. player.Name .. ": " .. tostring(err))
			if err == "another server has this save open" then
				canSave = false
				actor:SetAttribute("CanGrant", false)
				notice("Your save was opened on another server, so this server stopped saving it. Rejoin to keep playing.")
			end
		end
	end
	session.wantSave = false
	saving = false
end

-- the player's number notation lives in their device options (MT_Prefs, set by Main after validation)
local HttpService = game:GetService("HttpService")
local function applyNotation()
	local plr = player
	if session == nil or plr == nil then return end
	local mode = "SUFFIX"
	local json = plr:GetAttribute("MT_Prefs")
	if type(json) == "string" then
		local ok, prefs = pcall(HttpService.JSONDecode, HttpService, json)
		if ok and type(prefs) == "table" and (prefs.notation == "SUFFIX" or prefs.notation == "SCIENTIFIC") then
			mode = prefs.notation
		end
	end
	if session.notation ~= mode then
		session:setNotation(mode)
		pushNow = true
	end
end

-- a game value (a Decimal or a number) as a TowerNum
local function toTN(v: any): any
	if type(v) == "number" then return v end
	local JS = session.JS
	local ok, d = pcall(JS.D, v)
	if not ok or not d then return 0 end
	return TowerNum.fromEN({ Sign = JS.tonum(JS.P(d, "sign")), Layer = JS.tonum(JS.P(d, "layer")), Exp = JS.tonum(JS.P(d, "mag")) })
end
-- the player list (Hud/PlayerList): the points (leaderboard format and its sort key) and the real playtime, on the
-- Player every PUBLISH_EVERY seconds (serial phase)
local PUBLISH_EVERY = 3
local sincePub = PUBLISH_EVERY
local function publish()
	local plr = player
	if not session or not plr or not plr.Parent then return end
	local ok, x = pcall(function() return toTN(session.ENV.player.points) end)
	if ok then
		plr:SetAttribute("MT_Pts", Boards.format(x))
		plr:SetAttribute("MT_PtsKey", TowerNum.sortKey(x))
	end
	plr:SetAttribute("MT_Played", math.floor(playedNow()))
end

-- the leaderboard keys of this game (serial phase: reads the game, then DataStore calls)
local function lbKeys(): { [string]: number }
	local out: { [string]: number } = {}
	local JS, ENV = session.JS, session.ENV
	local ok, arr = pcall(ENV.rbx_lbStats, nil)
	if ok and arr and JS.LEN[arr] then
		for i = 0, JS.LEN[arr] - 1 do
			local pair = arr[i]
			local key, v = pair[0], pair[1]
			local board = Boards.get(tostring(key))
			if board then
				out[board.key] = Boards.keyOf(board, toTN(v))
			end
		end
	end
	out.time = Boards.keyOf(Boards.get("time") :: any, playedNow())
	return out
end
local function sendLb()
	if lbBusy or not session or not player or not canSave or not Store.available() then return end
	lbBusy = true
	local ok, keys = pcall(lbKeys)
	if ok then
		local fresh: { [string]: number } = {}
		for board, key in keys do
			if key > (lbSent[board] or 0) then fresh[board] = key end
		end
		if next(fresh) then
			Leaderboards.submit(player.UserId, fresh)
			for board, key in fresh do lbSent[board] = key end
			Leaderboards.forget(player.UserId)
		end
	else
		warn("[MilestoneTree] leaderboard stats failed: " .. tostring(keys))
	end
	lbBusy = false
end

local function begin(plr: Player)
	player = plr
	plr:GetAttributeChangedSignal("MT_Prefs"):Connect(applyNotation)
	viewRemote:FireClient(plr, { status = "Loading your save..." })
	local rec, err = Store.load(plr.UserId)
	if not plr.Parent then
		if rec then task.spawn(Store.save, plr.UserId, rec.save or "", rec.options, true) end
		actor:SetAttribute("Stopped", true)
		return
	end
	local save, options = nil, nil
	if rec then
		canSave = true
		save, options = rec.save, rec.options
		playedBase = tonumber(rec.played) or 0
	else
		warn("[MilestoneTree] could not load " .. plr.Name .. "'s save: " .. tostring(err))
	end
	local ok, s = pcall(Session.new, deps, save, options, nowMs())
	if not ok then
		warn("[MilestoneTree] " .. plr.Name .. "'s save would not start (" .. tostring(s) .. "); starting a new game without saving")
		canSave = false
		s = Session.new(deps, nil, nil, nowMs())
		table.insert(s.notices, "Your save could not be started, so this is a new game that will NOT be saved. Rejoin to try again.")
	elseif not rec then
		table.insert(s.notices, "Your save could not be loaded (" .. tostring(err) .. "). Playing without saving; rejoin to try again.")
	end
	session = s
	loadedAt = os.clock()
	sinceLb = Config.LB_EVERY - 30 -- the first stats 30 s in, so a new player shows up soon
	applyNotation()
	s:setPerks(perks)
	if pendingWarp > 0 then
		s:addWarp(pendingWarp)
		pendingWarp = 0
	end
	-- Shop grants a Time Warp only while this game can keep it (a game that cannot save would lose it)
	-- (Studio without API access saves nothing: test purchases are still granted there)
	actor:SetAttribute("CanGrant", canSave or (RunService:IsStudio() and not Store.available()))
	pushNow = true
end
-- feed a Time Warp still on its way in full, before a last save (leaving, shutdown): the save then holds all of it
local function drainWarp()
	if not session then return end
	local n = 0
	while (session.warp or 0) > 0 and n < 2000 do
		session:tick(nowMs())
		n += 1
	end
end
actor:BindToMessage("start", function(plr: Player)
	task.spawn(function() -- loading yields (DataStore)
		local ok, err = pcall(begin, plr)
		if not ok then
			warn("[MilestoneTree] could not start " .. plr.Name .. "'s game: " .. tostring(err))
			viewRemote:FireClient(plr, { fatal = "Your game could not start on the server: " .. tostring(err) })
		end
	end)
end)

actor:BindToMessageParallel("act", function(a, hold)
	if not session or stopping then return end
	local ok = session:act(a, nowMs(), hold == true)
	if ok then pushNow = true end
end)

-- passes (Main/Shop): { speed = 2? }; kept for a session that is still loading
actor:BindToMessage("perks", function(p: any)
	perks = if type(p) == "table" then p else {}
	if session then
		session:setPerks(perks)
		pushNow = true
	end
end)
-- a Time Warp bought (a granted developer product): seconds of progress, fed through the next ticks
actor:BindToMessage("warp", function(seconds: any, name: any)
	if type(seconds) ~= "number" or seconds <= 0 then return end
	if session then
		session:addWarp(seconds)
		if stopping then drainWarp() end
		table.insert(session.notices, string.format("%s: %s of progress is on its way!", tostring(name or "Time Warp"),
			if seconds >= 3600 then string.format("%g hour%s", seconds / 3600, if seconds == 3600 then "" else "s") else string.format("%d s", seconds)))
		pushNow = true
	else
		pendingWarp += seconds
	end
end)

actor:BindToMessageParallel("resync", function()
	if not session then return end
	session:resetView()
	pushNow = true
end)

actor:BindToMessage("stop", function()
	stopping = true
	actor:SetAttribute("CanGrant", false)
	task.spawn(function()
		drainWarp()
		saveNow(true)
		sendLb()
		actor:SetAttribute("Stopped", true)
	end)
end)

RunService.Heartbeat:ConnectParallel(function(dt: number)
	if not session or stopping then return end
	sinceTick += dt
	sinceView += dt
	sinceSave += dt
	sinceSent += dt
	sinceLb += dt
	sincePub += dt
	if sinceTick >= tickEvery then
		sinceTick = 0
		local t0 = os.clock()
		session:tick(nowMs())
		local cost = os.clock() - t0
		tickCost = tickCost * 0.9 + cost * 0.1
		-- keep this player's game under its share of a core: slower ticks when they get expensive
		local share = actor:GetAttribute("TickShare")
		tickEvery = math.clamp(tickCost / (if type(share) == "number" and share > 0 then share else Config.TICK_CPU_SHARE),
			Config.TICK, Config.MAX_TICK)
	end
	local wantSave = session.wantSave or sinceSave >= Config.AUTOSAVE
	if not (pushNow or sinceView >= viewEvery or wantSave) then return end
	local patch, changed = nil, false
	if pushNow or sinceView >= viewEvery then
		sinceView = 0
		pushNow = false
		local v0 = os.clock()
		patch, changed = session:view()
		viewCost = viewCost * 0.9 + (os.clock() - v0) * 0.1
		-- refresh less often when building the screen gets expensive (never slower than MAX_VIEW)
		viewEvery = math.clamp(viewCost / Config.VIEW_CPU_SHARE, Config.VIEW, Config.MAX_VIEW)
		if not canSave then patch.unsaved = true end
	end
	task.synchronize()
	if patch and (changed or patch.pop or patch.notice or patch.save or patch.full
		or sinceSent >= Config.KEEPALIVE) then
		sinceSent = 0
		send(patch)
	end
	if wantSave then
		sinceSave = 0
		session.wantSave = false
		task.spawn(saveNow, false)
	end
	if sincePub >= PUBLISH_EVERY then
		sincePub = 0
		publish()
	end
	if sinceLb >= Config.LB_EVERY then
		sinceLb = 0
		task.spawn(sendLb)
	end
end)

actor:SetAttribute("Ready", true)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterGui" referent="76">
    <Properties>
      <string name="Name">StarterGui</string>
      <token name="ScreenOrientation">2</token>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="77">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="AutoJumpEnabled">false</bool>
      <token name="DevComputerMovementMode">3</token>
      <token name="DevTouchMovementMode">5</token>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="78">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="79">
        <Properties>
          <string name="Name">MilestoneTree</string>
        </Properties>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">App</string>
            <string name="Source"><![CDATA[--!strict
--[[
	App: the client (plan 2.1-2.3, 1.11-1.12; DESIGN.md 3-7). The realm map is the home screen. A node opens its
	layer's panel beside the map (the map shrinks to a strip, DESIGN.md 3.6) or full screen on phones; the HUD and the
	overlays sit on top.

	    App.start()      once, from Main.client

	ScreenGuis (plan 2.1): Backing (-1, a black floor so no 3D sky ever shows), MapGui 0, MarkerGui 5, HudGui 10,
	TopbarGui 12, PanelGui 20, OverlayGui 30.

	Patch routing (plan 2.3): View -> ViewStore:apply -> map widgets, HUD, the panel (its own Render), toasts,
	modals, the status chip, the end screen. One PreRender loop: map input -> map view (+ its camera listeners) ->
	Motion. A drawing error resyncs once (Ready); a second one within 10 s shows OUT OF SYNC. No patch for 6 s shows
	RECONNECTING (the server sends at least one every 2 s).

	Panel protocol (plan 1.12): opening fires the node's own `a` once (never for the layer the server already shows),
	the shell draws at once and the body fills when patch.tab is that layer; closing fires map.close. The client's
	own open / close wins for up to 2 s until map.open confirms it; otherwise the panel follows map.open (a hotkey,
	the Multiverse, the end screen) without a fly-to. At boot the map is home: a layer left open by the last session
	is closed (and remembered for the phone start framing).

	Every action is a node's own `a` from the ViewStore, fired as is; the only one built here is {"key", name}.

	Sound (Core/Audio): silent until the realm first shows, then the ambience bed. App plays what it can see the
	reason for: a panel opening / closing, a refused node tap, a READY prestige, a toast, OUT OF SYNC, map and rift
	hovers, HUD presses, and the Multiverse rift's hum while the rift is on screen. A purchase is remembered when it
	is sent and sounds when a later patch shows it went through (Audio.expectBuy / afterPatch); a layer that woke
	sounds from the map (Audio.observeMap).
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local Core = script.Parent:WaitForChild("Core")
local Types = require(script.Parent:WaitForChild("Types"))
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Motion = require(Core:WaitForChild("Motion"))
local Recipes = require(Core:WaitForChild("Recipes"))
local Prefs = require(Core:WaitForChild("Prefs"))
local Audio = require(Core:WaitForChild("Audio"))
local Preload = require(Core:WaitForChild("Preload"))
local ViewStore = require(Core:WaitForChild("ViewStore"))
local InputFolder = script.Parent:WaitForChild("Input")
local Input = require(InputFolder:WaitForChild("Input"))
local Hotkeys = require(InputFolder:WaitForChild("Hotkeys"))
local MapFolder = script.Parent:WaitForChild("Map")
local MapCamera = require(MapFolder:WaitForChild("MapCamera"))
local MapView = require(MapFolder:WaitForChild("MapView"))
local MapInput = require(MapFolder:WaitForChild("MapInput"))
local MapLogic = require(MapFolder:WaitForChild("MapLogic"))
local Nodes = require(MapFolder:WaitForChild("Nodes"))
local Links = require(MapFolder:WaitForChild("Links"))
local Plates = require(MapFolder:WaitForChild("Plates"))
local Markers = require(MapFolder:WaitForChild("Markers"))
local Hud = require(script.Parent:WaitForChild("Hud"):WaitForChild("Hud"))
local Kit = require(script.Parent:WaitForChild("Hud"):WaitForChild("Kit"))
local Overlay = require(script.Parent:WaitForChild("Overlay"):WaitForChild("Overlay"))
local Panel = require(script.Parent:WaitForChild("Panel"):WaitForChild("Panel"))
local Signatures = require(script.Parent:WaitForChild("Signatures"):WaitForChild("Signatures"))

type MapState = Types.MapState
type ARect = Types.Rect

local App = {}

local CRIMSON = Color3.fromHex("ff2e63")
local VIOLET = Color3.fromHex("8a7cff")
local GOLD = Color3.fromHex("ffc233")
local RIFT = Vector2.new(3150, 1350)
local UNIVERSE_WORD = { [true] = "Lives in the Prestige Multiverse", [false] = "Lives in the Normal Universe" }
local INTENT_WAIT = 2 -- seconds the client's own open / close waits for map.open to confirm it
local RECONNECT_AFTER = 6
local REVEAL_FRAMES = 2 -- Heartbeats between the loading screen's last step and its fade: the realm has drawn

-- the engine settings the client owns (plan 2.1, 4); each on its own, so one missing API never stops the rest
local function engineSettings()
	pcall(function() GuiService.TouchControlsEnabled = false end)
	pcall(function()
		local cam = Workspace.CurrentCamera
		if cam then cam.CameraType = Enum.CameraType.Scriptable end
	end)
	for _, t in { Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health, Enum.CoreGuiType.PlayerList } do
		pcall(function() StarterGui:SetCoreGuiEnabled(t, false) end)
	end
end

-- a black floor under everything, covering the whole device (no inset): no 3D sky strip under the top bar, around
-- a phone's notch or behind a full-screen panel
local function backing(): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = "Backing"
	gui.ResetOnSpawn = false
	gui.AutoLocalize = false
	gui.DisplayOrder = -1
	gui.ScreenInsets = Enum.ScreenInsets.None
	pcall(function() gui.SafeAreaCompatibility = Enum.SafeAreaCompatibility.None end)
	local f = Instance.new("Frame")
	f.Name = "Floor"
	f.Size = UDim2.fromScale(1, 1)
	f.BorderSizePixel = 0
	f.BackgroundColor3 = Theme.C.void
	f.Active = false
	f.Parent = gui
	local lp = Players.LocalPlayer
	gui.Parent = lp:WaitForChild("PlayerGui")
	return gui
end

function App.start()
	engineSettings()
	Theme.detect()
	-- sound is never worth a broken start: it is built defensively, and anything unforeseen leaves the game silent
	local okAudio, audioErr = pcall(function() Audio.start() end)
	if not okAudio then warn("[MilestoneTree] audio failed to start: " .. tostring(audioErr)) end
	Input.start()
	Layout.start()
	backing()

	-- ------------------------------------------------------------------------------------------ screens
	local mapGui, mapRoot = Layout.screen("MapGui", 0, Enum.ScreenInsets.None)
	local markerGui = Layout.screen("MarkerGui", 5, Enum.ScreenInsets.DeviceSafeInsets)
	local hudGui = Layout.screen("HudGui", 10, Enum.ScreenInsets.CoreUISafeInsets)
	local topbarGui = Layout.screen("TopbarGui", 12, Enum.ScreenInsets.TopbarSafeInsets)
	local panelGui = Layout.screen("PanelGui", 20, Enum.ScreenInsets.CoreUISafeInsets)
	local overlayGui = Layout.screen("OverlayGui", 30, Enum.ScreenInsets.DeviceSafeInsets)

	local overlay = Overlay.new(overlayGui)
	local screenKind: string? = nil
	local function setScreen(kind: string?, data: any?)
		screenKind = kind
		overlay:screen(kind, data)
	end
	setScreen("loading", { done = 0, total = 1 })

	local view = MapView.new(mapGui, mapRoot, { tier = MapView.chooseTier() })
	local mi = MapInput.new(view, Input)
	Recipes.holdGate = function(): boolean
		return not mi:busy()
	end
	local nodes = Nodes.new(view, mi)
	local links = Links.new(view)
	local plates = Plates.new(view, nodes)
	local markers = Markers.new(markerGui, view, nodes)
	local hud = Hud.new(topbarGui, hudGui)
	local store = ViewStore.new()

	-- ------------------------------------------------------------------------------------------ state
	local actRemote: RemoteEvent? = nil
	local readyRemote: RemoteEvent? = nil
	local lastMs: MapState? = nil
	local gotFirst = false -- the first full view arrived
	local preloaded = false -- every image and font is fetched (or Preload gave up at its timeout)
	local assetsNoted = false -- the status says LOADING ASSETS once the first view waits on them
	local introDone = false
	local fatal = false
	local lastPatchAt = 0
	local reconnecting = false
	local statusOff = false
	local outOfSync = false
	local errorAt = -math.huge
	local wasInside: boolean? = nil
	local endShown = false

	local panelKey: string? = nil -- the layer (or "options-tab") the panel shows
	local intent: { key: string?, at: number }? = nil -- the client's own open / close, until map.open confirms it
	local geoMode: string? = nil -- "side" | "full" while the panel is open
	local appliedSx: number? = nil
	local lastLayer: string? = nil -- the last layer opened (the phone start framing, the fly back)
	local opening = false
	local fullToken = 0

	-- ------------------------------------------------------------------------------------------ actions
	local function fire(a: any, hold: boolean?)
		local r = actRemote
		if r == nil or type(a) ~= "table" or type(a[1]) ~= "string" then return end
		Audio.expectBuy(a, store)
		r:FireServer(a, hold == true)
	end
	local lastPress = 0
	local function resync()
		local r = readyRemote
		if r then r:FireServer() end
	end

	-- ------------------------------------------------------------------------------------------ the panel
	local function panelTip(html: string?, over: GuiObject?)
		if html == nil then
			overlay:tooltip(over, nil)
			return
		end
		if Input.kind() ~= "mouse" then return end
		overlay:tooltip(over, { title = "", body = html, layer = panelKey }, Input.pointer())
	end
	local panel = Panel.new(panelGui, { store = store, tip = panelTip })
	panel:setBand(Layout.mode == "COMPACT")

	local function titleOf(key: string): string
		local ms = lastMs
		return Signatures.title(key, if ms then ms.nodes[key] else nil)
	end
	-- the map's input and art run only while it shows (DESIGN.md 3.6: a full-screen sheet disables the map)
	local function mapShown()
		local on = geoMode ~= "full"
		mapGui.Enabled = on
		markerGui.Enabled = on
		markers:setEnabled(on)
		mi:setEnabled(on)
		view:setAmbient(on)
	end
	local function stripRect(sx: number): ARect
		local ro, rs = mapRoot.AbsolutePosition, mapRoot.AbsoluteSize
		return { x = ro.X, y = ro.Y, w = math.max(1, sx - ro.X), h = rs.Y }
	end
	-- the map beside the panel: the strip (side) or nothing (full), or the whole screen again (closed)
	local function applyGeometry(animate: boolean)
		local key = panelKey
		if key == nil then
			local was = geoMode
			geoMode, appliedSx = nil, nil
			Layout.setSheet(nil)
			view:setRect(nil, { animate = animate and was == "side", time = 0.16 })
			view:setForegroundOpen(true)
			hud:setPanel(nil)
			if was == "full" then mapShown() end
			return
		end
		local g = panel:geometry()
		if g.mode == "side" and g.sx then
			local was = geoMode
			geoMode, appliedSx = "side", g.sx
			Layout.setSheet(g.sx)
			local r = stripRect(g.sx :: number)
			view:setRect(r, { animate = animate })
			view:setForegroundOpen(false)
			hud:setPanel({ layer = key, mode = "side", strip = r, title = titleOf(key) })
			if was == "full" then mapShown() end
		else
			local was = geoMode
			geoMode, appliedSx = "full", nil
			Layout.setSheet(nil)
			hud:setPanel({ layer = key, mode = "full", title = titleOf(key) })
			if was ~= "full" then
				-- the map switches off after the sheet's slide
				fullToken += 1
				local my = fullToken
				local function off()
					if fullToken == my and geoMode == "full" then mapShown() end
				end
				if animate and not Motion.reduced() then task.delay(0.24, off) else off() end
			end
		end
	end
	-- set with the camera helpers below: frames the tree in the strip beside an open panel
	local frameStrip: (key: string) -> () = function(_: string) end
	local function showPanel(key: string, node: any?, fly: boolean)
		local was = panelKey
		if was ~= key then Audio.play("panel_open", if was then { volume = 0.7 } else nil) end
		panelKey = key
		opening = true
		overlay:peek(nil)
		overlay:detail(nil)
		panel:open(key, node)
		opening = false
		nodes:setSelected(if key ~= "options-tab" then key else nil)
		if key ~= "options-tab" then lastLayer = key end
		local g = panel:geometry()
		if was == nil or g.mode ~= geoMode or (g.mode == "side" and g.sx ~= appliedSx) then
			applyGeometry(true)
		else
			hud:setPanel({ layer = key, mode = geoMode or "side", strip = if appliedSx then stripRect(appliedSx :: number) else nil,
				title = titleOf(key) })
		end
		-- keep the tree in view in the strip, the opened node inside it; a panel without a node never flies
		if fly and key ~= "options-tab" and geoMode == "side" then frameStrip(key) end
	end
	local function hidePanel(flyBack: boolean)
		local key = panelKey
		if key == nil then return end
		Audio.play("panel_close")
		local wasFull = geoMode == "full"
		panelKey = nil
		panel:close()
		overlay:detail(nil)
		nodes:setSelected(nil)
		applyGeometry(true)
		-- closing a full-screen sheet flies back to the node that was open (DESIGN.md 3.3)
		if wasFull and flyBack and key ~= "options-tab" then view:focusWorld(nodes:worldPos(key)) end
	end
	local function requestClose(flyBack: boolean?)
		if panelKey == nil then return end
		local ms = lastMs
		if ms and ms.close and (ms.open ~= nil or intent ~= nil) then fire(ms.close) end
		intent = { key = nil, at = os.clock() }
		hidePanel(flyBack ~= false)
	end
	local function openLayer(layer: string, fly: boolean?)
		local ms = lastMs
		if ms == nil or store.ended then return end
		local node = ms.nodes[layer]
		local st = nodes:state(layer)
		if node == nil or not node.show or st == "dormant" or st == "sealed" or st == "frontier" then
			if st == "dormant" then overlay:toasts(nil, { UNIVERSE_WORD[MapLogic.MULTIVERSE[layer] == true] }) end
			-- a hidden layer says what reveals it ("Reach 40 milestones to discover it · 31 / 40")
			local need = node and node.need
			if (st == "sealed" or st == "frontier") and type(need) == "table" then
				overlay:toasts(nil, { string.format("Reach %s %s to discover this layer (%s / %s)", tostring(need.n),
					tostring(need.r), tostring(need.have), tostring(need.n)) })
			end
			Audio.play("error", { volume = 0.7 })
			return
		end
		if panelKey == layer then
			-- the selected node: nothing to send; fly back to it if the camera moved away
			overlay:peek(nil)
			if geoMode == "side" then frameStrip(layer) end
			return
		end
		if ms.open ~= layer or intent ~= nil then fire(node.a) end
		intent = { key = layer, at = os.clock() }
		showPanel(layer, node, fly ~= false)
	end
	local function openOptions()
		local ms = lastMs
		if ms == nil or store.ended or panelKey == "options-tab" then return end
		if ms.open ~= "options-tab" or intent ~= nil then fire(ms.opt) end
		intent = { key = "options-tab", at = os.clock() }
		showPanel("options-tab", nil, false)
	end
	-- follow the server's open layer (plan 1.12 "the server moves the tab")
	local function syncPanel(ms: MapState)
		if store.ended or not ms.ok then return end
		local open = ms.open
		local it = intent
		if it then
			if open == it.key then
				intent = nil
			elseif os.clock() - it.at < INTENT_WAIT then
				return
			else
				intent = nil
			end
		end
		if open == panelKey then return end
		if open == nil then
			hidePanel(false)
		else
			showPanel(open, ms.nodes[open], false)
		end
	end

	panel.act:Connect(function(a: any, hold: boolean?)
		if type(a) ~= "table" then return end
		if a[1] == "tab" and type(a[2]) == "string" then
			-- a panel button that moves the panel (a signature's shortcut to Options, a layer link) opens it the
			-- same way a tap does
			if a[2] == "none" then
				requestClose()
			elseif a[2] == "options-tab" then
				openOptions()
			else
				openLayer(a[2])
			end
			return
		end
		if hold ~= true then
			if os.clock() - lastPress < 0.03 then return end
			lastPress = os.clock()
		end
		fire(a, hold)
	end)
	panel.closeRequested:Connect(function() requestClose() end)
	panel.detail:Connect(function(card: any)
		overlay:detail({ id = card.id, kind = card.kind, node = card.node, layer = card.layer, get = function(id: string): any
			return store:get(id)
		end })
	end)
	panel.flyTo:Connect(function(layer: string) openLayer(layer) end)
	panel.geometryChanged:Connect(function(g: any)
		if opening or panelKey == nil then return end
		if g.mode ~= geoMode or (g.mode == "side" and g.sx ~= appliedSx) then applyGeometry(false) end
	end)
	Layout.changed:Connect(function()
		panel:setBand(Layout.mode == "COMPACT")
	end)

	-- ------------------------------------------------------------------------------------------ camera helpers
	local function nodeBox(list: { string }): ARect?
		if #list == 0 then return nil end
		local x0, y0, x1, y1 = math.huge, math.huge, -math.huge, -math.huge
		for _, l in list do
			local p = nodes:worldPos(l)
			x0, y0 = math.min(x0, p.X - 110), math.min(y0, p.Y - 110)
			x1, y1 = math.max(x1, p.X + 110), math.max(y1, p.Y + 150)
		end
		return { x = x0, y = y0, w = x1 - x0, h = y1 - y0 }
	end
	-- the shown nodes of the current universe (frameNodes, DESIGN.md 3.3)
	local function shownNodes(): { string }
		local out = {}
		local ms = lastMs
		if ms == nil then return out end
		for _, l in ms.order do
			if l ~= "ach" then
				local st = nodes:state(l)
				if st ~= "sealed" and st ~= "frontier" and st ~= "dormant" then table.insert(out, l) end
			end
		end
		return out
	end
	-- the strip beside a side sheet shows the whole tree (every shown node and its plate), zoomed to fit the free
	-- rect, centred between the tree and the opened node so that node never sits at an edge. A close-up (the old
	-- fly-to at zoom .9) left only a node or two and the edge markers in the strip.
	frameStrip = function(key: string)
		local bb = nodeBox(shownNodes())
		local free = view:freeRect()
		local p = nodes:worldPos(key)
		if bb == nil or free.w < 2 or free.h < 2 then
			view:focusWorld(p)
			return
		end
		-- keep the toast band at the strip's top clear: the tree fits the rect below it
		local band = 170 * Layout.s
		local h = math.max(free.h * 0.5, free.h - band)
		local zz = math.min(free.w / bb.w, h / bb.h, 0.9)
		local c = Vector2.new(bb.x + bb.w / 2, bb.y + bb.h / 2)
		-- focusWorld centres its point in the whole free rect; aim higher so the tree sits centred in the lower part
		view:focusWorld(c:Lerp(p, 0.35) - Vector2.new(0, (free.h - h) / 2 / zz), { zoom = zz })
	end
	local function vSize(): MapCamera.Size
		local cam = view:camera()
		return { w = cam.V.X, h = cam.V.Y }
	end
	-- the phone start framing's focus (DESIGN.md 3.3): a new player's M at 60 %; the READY centroid; the last layer
	local function homeFocus(): (Vector2?, number?)
		local h = store:hud()
		if h and h.fr then return nodes:worldPos("m"), 0.6 end
		if Layout.mode ~= "COMPACT" then return nil, nil end
		local ms = lastMs
		if ms then
			local sum, n = Vector2.zero, 0
			for _, list in { ms.ready, ms.canBuy } do
				for _, l in list do
					sum += nodes:worldPos(l)
					n += 1
				end
			end
			if n > 0 then return sum / n, nil end
		end
		if lastLayer then return nodes:worldPos(lastLayer), nil end
		return nil, nil
	end
	local function homeTarget(): (Vector2, number)
		local V = vSize()
		local safe = view:safeRect()
		local ms = lastMs
		if ms and ms.inside then
			local bb = nodeBox(shownNodes())
			if bb then
				local c, z = MapCamera.frameRect(bb, V, safe)
				return Vector2.new(c.x, c.y), z
			end
		end
		local focus, fy = homeFocus()
		local c, z = MapCamera.startFraming(V, safe, Layout.mode, if focus then { x = focus.X, y = focus.Y } else nil, fy)
		return Vector2.new(c.x, c.y), z
	end
	-- the first frame of the realm (with the intro dolly-out outside the Multiverse)
	local function frameBoot()
		local ms = lastMs
		if ms and ms.inside then
			local C, z = homeTarget()
			view:setCamera(C, z)
			return
		end
		local focus, fy = homeFocus()
		view:frameStart({ focus = focus, focusY = fy, intro = true })
	end
	-- HOME: fly to the start framing; already there, toggle to the overview (zMin)
	local function flyHome()
		local C, z = homeTarget()
		local cam = view:camera()
		local atHome = (cam.C - C).Magnitude * cam.z < 12 and math.abs(math.log(cam.z / z)) < 0.03
		if atHome then
			local V = vSize()
			view:flyTo(Vector2.new(MapCamera.WORLD.cx, MapCamera.WORLD.cy), MapCamera.zMin(V), { time = 0.6, ease = "quintInOut" })
		else
			view:flyTo(C, z, { time = 0.6, ease = "quintInOut" })
		end
	end
	local function flyToLayer(layer: string)
		if geoMode == "full" then requestClose(false) end
		view:focusWorld(nodes:worldPos(layer))
	end
	local function openGate()
		if geoMode == "full" then requestClose(false) end
		view:focusWorld(RIFT)
		task.delay(0.3, function()
			local ms = lastMs
			Audio.play("panel_open", { volume = 0.8 })
			overlay:modal("gate", if ms then ms.gate else nil)
		end)
	end

	-- ------------------------------------------------------------------------------------------ tooltips
	local function nodeTip(layer: string): any
		local ms = lastMs
		local node = if ms then ms.nodes[layer] else nil
		local st = nodes:state(layer)
		if st == "sealed" or st == "frontier" then
			local need = node and node.need
			if type(need) == "table" then
				return { title = "???", body = string.format("Reach %s %s to discover this layer.", tostring(need.n), tostring(need.r)),
					rows = { { "Need", tostring(need.n) .. " " .. tostring(need.r) }, { "Have", tostring(need.have) .. " " .. tostring(need.r) } },
					pr = if type(need.pr) == "number" then need.pr / 1000 else nil, layer = layer, hue = Theme.C.muted }
			end
			return { title = "???", body = "Not discovered yet.", layer = layer, hue = Theme.C.muted }
		end
		if st == "dormant" then
			local nm = MapLogic.NAMES[layer]
			return { title = if nm then string.sub(nm, 1, 1) .. string.lower(string.sub(nm, 2)) else layer,
				body = UNIVERSE_WORD[MapLogic.MULTIVERSE[layer] == true], layer = layer }
		end
		if node == nil then return nil end
		local v = node.val
		local title = node.name or layer
		if st == "locked" then title ..= " · Locked" end
		local content: any = { title = title, body = v and v.tip, layer = layer, foot = "Click to open · right-click to peek" }
		if v and not v.lit and v.req then
			content.rows = { { "Need", v.req .. " " .. MapLogic.unit(v.rres) } }
			if v.pr then content.pr = v.pr / 1000 end
		end
		return content
	end
	local hoverLayer: string? = nil
	local riftHover = false
	nodes.hover:Connect(function(layer: string?, abs: Vector2)
		if layer ~= hoverLayer and layer ~= nil and nodes:state(layer) ~= "sealed" then Audio.play("hover") end
		hoverLayer = layer
		if layer == nil then
			overlay:tooltip("node", nil)
			return
		end
		overlay:tooltip("node", nodeTip(layer), abs)
	end)
	nodes.rift:Connect(function(event: string, abs: Vector2)
		local ms = lastMs
		local gate = ms and ms.gate
		if event ~= "hover" then riftHover = false end
		if event == "leave" then
			overlay:tooltip("rift", nil)
		elseif event == "hover" then
			if not riftHover then Audio.play("hover") end
			riftHover = true
			if gate and gate.show then
				overlay:tooltip("rift", { title = "Prestige Multiverse", body = gate.h or "The rift is open.",
					foot = "Click to fly there", hue = CRIMSON }, abs)
			else
				local req = gate and gate.req
				overlay:tooltip("rift", { title = "The rift is sealed", body = "Reach 185 milestones to reveal the Prestige Multiverse.",
					rows = if req then { { "Need", req.need .. " milestones" }, { "Have", req.have .. " milestones" } } else nil,
					pr = if req then req.pr / 1000 else nil, foot = "Click to fly there", hue = CRIMSON }, abs)
			end
		elseif event == "click" then
			openGate()
		end
	end)
	local warnOpen = false
	hud.warnTap:Connect(function(abs: Vector2)
		local h = store:hud()
		warnOpen = not warnOpen
		if not warnOpen or h == nil then
			overlay:tooltip("warn", nil)
			return
		end
		local rows = {}
		for _, w in h.w do table.insert(rows, { string.upper(string.sub(w.k, 1, 1)) .. string.sub(w.k, 2) .. " from", w.v }) end
		overlay:tooltip("warn", { title = "Point production is slowed", body = h.wh or h.x, rows = rows, hue = GOLD }, abs)
		task.delay(6, function()
			if warnOpen then
				warnOpen = false
				overlay:tooltip("warn", nil)
			end
		end)
	end)

	-- ------------------------------------------------------------------------------------------ map, HUD, overlay
	nodes.activated:Connect(function(layer: string) openLayer(layer) end)
	nodes.peek:Connect(function(layer: string)
		local ms = lastMs
		local st = nodes:state(layer)
		if ms == nil or st == "sealed" or st == "frontier" or st == "dormant" then return end
		nodes:setPeek(layer)
		overlay:peek(layer, ms.nodes[layer], nodes:ringRect(layer))
	end)
	mi.emptyTap:Connect(function()
		-- a tap on the strip's empty map closes the side sheet (DESIGN.md 5.1)
		if panelKey and geoMode == "side" then requestClose() end
	end)
	markers.activated:Connect(function(layer: string)
		Audio.play("press")
		view:focusWorld(nodes:worldPos(layer))
	end)
	view.cameraChanged:Connect(function(cam: any) hud:setZoomPct(cam.z) end)
	hud:setZoomPct(view:camera().z)

	hud.shop:Connect(function()
		Audio.play("press")
		overlay:peek(nil)
		overlay:modal("shop")
	end)
	hud.ranks:Connect(function()
		Audio.play("press")
		overlay:peek(nil)
		overlay:modal("ranks")
	end)
	hud.home:Connect(function()
		if panelKey == nil then Audio.play("press") end
		overlay:peek(nil)
		local wasOpen = panelKey ~= nil
		requestClose(false)
		if wasOpen then task.delay(0.26, flyHome) else flyHome() end
	end)
	hud.trophies:Connect(function()
		if panelKey == "ach" then requestClose() else openLayer("ach") end
	end)
	hud.options:Connect(function()
		if panelKey == "options-tab" then requestClose() else openOptions() end
	end)
	hud.portal:Connect(openGate)
	hud.zoomIn:Connect(function()
		Audio.play("press", { volume = 0.7 })
		mi:zoomStep(1)
	end)
	hud.zoomOut:Connect(function()
		Audio.play("press", { volume = 0.7, pitch = 0.94 })
		mi:zoomStep(-1)
	end)
	hud.bandClose:Connect(function() requestClose() end)
	hud.bandSwitch:Connect(function(layer: string) openLayer(layer) end)
	hud.readyTap:Connect(function(layer: string) openLayer(layer) end)
	hud.readyHold:Connect(function(layer: string)
		local ms = lastMs
		local node = if ms then ms.nodes[layer] else nil
		local v = node and node.val
		if v and v.ra then
			Audio.prestige(layer)
			fire(v.ra)
		end
	end)
	hud.readyMore:Connect(function()
		local ms = lastMs
		if ms == nil then return end
		local list = table.clone(ms.ready)
		for _, l in ms.canBuy do table.insert(list, l) end
		local bb = nodeBox(list)
		if bb then view:frameWorld(bb, { time = 0.9 }) end
	end)
	hud.gateHold:Connect(function()
		local ms = lastMs
		local gate = ms and ms.gate
		if gate and gate.a then fire(gate.a) end
	end)

	overlay.act:Connect(function(a: any, hold: boolean?)
		if hold ~= true then Audio.play("press") end
		fire(a, hold)
	end)
	overlay.flyTo:Connect(flyToLayer)
	overlay.openLayer:Connect(function(layer: string) openLayer(layer) end)
	overlay.peekClosed:Connect(function() nodes:setPeek(nil) end)
	overlay.resync:Connect(resync)

	Prefs.changed:Connect(function(key: string)
		if key == "detail" then view:setTier(MapView.chooseTier()) end
	end)

	-- ------------------------------------------------------------------------------------------ patches
	local function onStatus(patch: any)
		local off = patch.unsaved == true
		if reconnecting then return end
		if off then
			hud:setStatus("off")
		elseif patch.save == "saving" or patch.save == "saved" then
			hud:setStatus(patch.save)
		elseif statusOff then
			hud:setStatus(nil)
		end
		statusOff = off
	end
	local function onEnded(first: boolean, changes: any)
		if not (changes.ended or first) then return end
		if store.ended then
			hidePanel(false)
			setScreen("end", store:endScreen())
		elseif endShown and screenKind == "end" then
			setScreen(nil)
		end
		endShown = store.ended
	end
	local function apply(patch: any)
		local changes = store:apply(patch)
		local first = false
		if changes.full then
			if not gotFirst then
				gotFirst, first = true, true
			end
			if outOfSync then
				outOfSync = false
				if screenKind == "outOfSync" then setScreen(nil) end
			end
		end
		local ms = store:map()
		if changes.map or changes.full then
			lastMs = ms
			nodes:update(ms)
			Audio.observeMap(ms)
			links:update(ms)
			plates:update(ms)
			markers:update(ms)
			hud:updateMap(ms)
		end
		if changes.hud or changes.full then
			local h = store:hud()
			if h then
				nodes:setFirstRun(h.fr)
				hud:setFirstRun(h.fr)
				hud:updateHud(h)
			end
		end
		if changes.tab or changes.tabName or changes.full then
			panel:update(store, changes)
			overlay:detailRefresh()
		end
		Audio.afterPatch(store)
		if first then
			-- the realm is home: a layer the last session left open is closed (and remembered)
			if ms.open and not store.ended then
				if ms.open ~= "options-tab" then lastLayer = ms.open end
				if ms.close then fire(ms.close) end
				intent = { key = nil, at = os.clock() }
			end
		end
		syncPanel(ms)
		onEnded(first, changes)
		-- a universe change: the camera frames the other side, with a flash (DESIGN.md 3.5)
		if ms.ok then
			if wasInside ~= nil and wasInside ~= ms.inside then
				overlay:flash(if ms.inside then CRIMSON else VIOLET)
				if geoMode ~= "full" then
					local bb = nodeBox(shownNodes())
					if bb then view:frameWorld(bb, { time = 0.9 }) end
				end
			end
			wasInside = ms.inside
		end
		-- toasts
		local notices = patch.notice
		if type(patch.pop) == "table" and #patch.pop > 0 then Audio.play("toast") end
		if patch.pop or (notices and #notices > 0) then overlay:toasts(patch.pop, notices) end
		onStatus(patch)
	end
	local function onError(err: any)
		warn("[MilestoneTree] drawing the screen failed: " .. tostring(err))
		if os.clock() - errorAt < 10 then
			outOfSync = true
			Audio.play("error")
			setScreen("outOfSync")
		else
			resync()
		end
		errorAt = os.clock()
	end
	local function onPatch(patch: any)
		if type(patch) ~= "table" then return end
		lastPatchAt = os.clock()
		if reconnecting then
			reconnecting = false
			hud:setStatus(if statusOff then "off" else nil)
		end
		if patch.fatal then
			fatal = true
			setScreen("fatal", tostring(patch.fatal))
			return
		end
		if patch.status then
			if not gotFirst and not fatal then
				overlay:screen("loading", tostring(patch.status))
			elseif not fatal then
				-- in the game already: the server is closing for an update (SoftShutdown)
				overlay:toasts(nil, { tostring(patch.status) })
			end
			return
		end
		local ok, err = pcall(function()
			apply(patch)
		end)
		if not ok then onError(err) end
	end

	-- ------------------------------------------------------------------------------------------ keyboard
	Hotkeys.start({
		active = function(): boolean
			return not fatal
		end,
		keys = function(): { [string]: true }
			return store.keys
		end,
		send = function(name: string)
			fire({ "key", name })
		end,
		zoom = function(dir: number)
			if geoMode ~= "full" then mi:zoomStep(dir) end
		end,
		escape = function()
			if overlay:escape() then return end
			if panelKey then requestClose() end
		end,
	})

	-- ------------------------------------------------------------------------------------------ the loop
	-- the loading screen goes when BOTH the first view is on the map and the images are fetched (or timed out)
	local function loadingDone(): boolean
		return gotFirst and preloaded
	end
	-- the Multiverse rift's hum: loudest with the rift large and central on the map, faint while it is sealed, none
	-- while a full-screen panel hides the map
	local function riftLevel(): number
		local ms = lastMs
		if ms == nil or not ms.ok or store.ended or geoMode == "full" then return 0 end
		local cam = view:camera()
		local q = cam.V / 2 + (RIFT - cam.C) * cam.z
		local r = math.max(1, 420 * cam.z)
		local dx = math.max(0, math.abs(q.X - cam.V.X / 2) - cam.V.X / 2)
		local dy = math.max(0, math.abs(q.Y - cam.V.Y / 2) - cam.V.Y / 2)
		local vis = math.clamp(1 - math.sqrt(dx * dx + dy * dy) / r, 0, 1)
		local off = (q - cam.V / 2).Magnitude / math.max(cam.V.X, cam.V.Y, 1)
		local centre = 1 - 0.5 * math.clamp(off / 0.6, 0, 1)
		local size = math.clamp(r / math.max(1, 0.3 * cam.V.Y), 0.3, 1)
		local gate = ms.gate
		return vis * centre * size * (if gate and gate.show then 1 else 0.35)
	end
	local riftAt = 0
	-- ------------------------------------------------------------------------------------------ the tutorial
	-- Overlay/Guide: the state it follows and where its targets are on screen
	local guideAt = 0
	local function guideTick()
		local ms = lastMs
		if ms == nil or not gotFirst or fatal or store.ended then return end
		local function num(layer: string): number
			local n = ms.nodes[layer]
			local v = n and n.val
			local s = if v and type(v.pts) == "string" then v.pts else ""
			if s == "" then return 0 end
			return tonumber((string.gsub(s, ",", ""))) or 1e9 -- a suffixed or exponent form is a lot
		end
		local p = ms.nodes.p
		local m = ms.nodes.m
		overlay:guide({
			panel = panelKey,
			milestones = num("m"),
			pShown = p ~= nil and p.show == true,
			pOwned = num("p") > 0,
			mCan = m ~= nil and m.val ~= nil and m.val.can == true,
			rect = function(target: string): any
				if target == "capsule" then return Layout.rect("hud.capsule") end
				if target == "ready" then return Layout.rect("hud.ready") end
				if string.sub(target, 1, 5) == "node:" then return nodes:ringRect(string.sub(target, 6)) end
				if target == "cta" then
					local pgui = panelGui:FindFirstChild("Root")
					local sheet = pgui and pgui:FindFirstChild("Sheet")
					local hero = sheet and sheet:FindFirstChild("Hero")
					local cta = hero and hero:FindFirstChild("Cta")
					if cta and cta:IsA("GuiObject") and cta.Visible and sheet and (sheet :: GuiObject).Visible then return Kit.rect(cta) end
				end
				return nil
			end,
		})
	end

	local function step(dt: number)
		mi:step(dt)
		view:step(dt)
		Motion.step(dt)
		if gotFirst and not preloaded and not assetsNoted and not fatal and screenKind == "loading" then
			assetsNoted = true
			overlay:screen("loading", "Loading assets")
		end
		if not introDone and loadingDone() and not fatal then
			introDone = true
			frameBoot()
			Audio.setLive(true)
			Audio.loop("ambience", 1)
			-- the framed realm draws under the loading screen for a couple of frames first, so the fade uncovers it
			-- drawn instead of popping in
			local left = REVEAL_FRAMES
			local reveal: RBXScriptConnection? = nil
			reveal = RunService.Heartbeat:Connect(function()
				left -= 1
				if left > 0 then return end
				if reveal then reveal:Disconnect() end
				if screenKind == "loading" then setScreen(nil) end
			end)
		end
		riftAt -= dt
		if riftAt <= 0 and introDone then
			riftAt = 0.1
			Audio.loop("portal_loop", riftLevel())
		end
		Audio.step(dt)
		guideAt -= dt
		if guideAt <= 0 then
			guideAt = 0.2
			guideTick()
		end
		if gotFirst and not reconnecting and not fatal and os.clock() - lastPatchAt > RECONNECT_AFTER then
			reconnecting = true
			hud:setStatus("reconnecting")
		end
	end
	local okPre = pcall(function()
		(RunService :: any).PreRender:Connect(step)
	end)
	if not okPre then RunService.RenderStepped:Connect(step) end

	-- every image the client draws (the map's tiles first) and its fonts, behind the loading screen; never longer
	-- than Preload.TIMEOUT
	task.spawn(function()
		local list = Preload.list(view:images(), MapView.chooseTier())
		if screenKind == "loading" then overlay:screen("loading", "Loading assets") end
		Preload.run(list, function(done: number, total: number)
			if screenKind == "loading" then overlay:screen("loading", { done = done, total = total }) end
		end)
		preloaded = true
	end)

	-- ------------------------------------------------------------------------------------------ the server
	local found: Instance? = nil
	while found == nil do
		found = ReplicatedStorage:WaitForChild("MilestoneTreeRemotes", 10)
		if found == nil and screenKind == "loading" then overlay:screen("loading", "Waiting for the server…") end
	end
	local folder = found :: Instance
	local viewRemote = folder:WaitForChild("View") :: RemoteEvent
	actRemote = folder:WaitForChild("Act") :: RemoteEvent
	readyRemote = folder:WaitForChild("Ready") :: RemoteEvent
	viewRemote.OnClientEvent:Connect(onPatch)
	resync()
	lastPatchAt = os.clock()
end

return App
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="81">
          <Properties>
            <string name="Name">Core</string>
          </Properties>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">Audio</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Audio: the game's sound (MASTER_PLAN 2.6, W6 part 1). Client only; App starts it once. Everything is safe to call
	at any time: before start, with missing asset ids, or with no audio API at all, a cue simply stays silent.

	    Audio.start(o?)                 probe the engine, build the bus graph and the voice pools, follow Prefs
	    Audio.play(name, o?) -> bool    a one-shot cue ("hover", "press", "tab", "panel_open", "panel_close", "buy",
	                                    "toast", "error", "unlock", "prestige_small", "prestige_big");
	                                    o: volume (x), pitch (x), variant (1..n)
	    Audio.pressFor(node)            the click of a view button: "press", or "error" on a locked one
	    Audio.loop(name, level)         a loop ("portal_loop", "ambience") fades toward level 0..1 (0 stops it)
	    Audio.prestige(layer, first?)   the big (first time) or small prestige; first defaults to the one decision,
	                                    Prefs.claimFirstPrestige(layer)
	    Audio.expectBuy(action, store)  a purchase was sent: remember its button (upg / buy actions only)
	    Audio.afterPatch(store)         after a view patch: a remembered purchase whose button changed plays "buy"
	    Audio.observeMap(ms)            after a map change: a layer that woke plays "unlock" (-> the layers)
	    Audio.setLive(on)               cues play only once the realm is on screen (not during boot)
	    Audio.step(dt)                  every frame (the loop fades)
	    Audio.mode                      "api" (the wired Audio API) | "sound" (legacy Sound fallback) | "off"

	The graph (api):
	    UI voices ------> UI fader -------+---------------------------------> Master -> Limiter (-1 dB) -> Output
	                                      +-> UiKey (x0.35) -> Duck.Sidechain
	    Impact voices --> Impacts fader --+-> Master, and -> Duck.Sidechain
	    Ambience loops -> Ambience fader -+-> Duck (AudioCompressor) -> Master
	    (music stems) --> Music fader ----+
	The sound fallback: the same buses as nested SoundGroups (Master > UI, Impacts, Ambience, Music) and a
	CompressorSoundEffect on Ambience and Music keyed by Impacts.

	Voices: round-robin pools of players, one per sheet (ui: the UI bus, fx: Impacts), at most 32 voices on a PC and 16
	on a phone, loops included. Each cue has a RULE: a cooldown, a rate cap (plays in any 1 s), a voice cap, a pitch
	jitter and a priority. A cue past its voice cap steals its own oldest voice, except hover, which is dropped (hover
	spam never stacks). A full pool steals the lowest-priority busy voice, never a higher one. Variants are random with
	no immediate repeat; buy climbs its variants while purchases follow each other (the combo ladder).

	Volumes come from Prefs (music, sfx, ambience: 0..100) through a perceptual curve (v / 100)^2 and follow
	Prefs.changed live. Asset ids come from shared/AudioIds (generated; nil = silent). In Studio, the LocalPlayer
	attribute MT_ForceCaps "all" or "AudioApi" forces the sound fallback and "Audio" turns sound off.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")

local Prefs = require(script.Parent:WaitForChild("Prefs"))

local Audio = {}

export type Rule = {
	pool: string, -- "ui" | "fx"
	cooldown: number, -- seconds between two plays of this cue
	rate: number, -- at most this many plays in any 1 s
	voices: number, -- at most this many at once
	steal: boolean, -- past `voices`: restart its oldest voice (true) or drop the new play (false)
	jitter: number, -- PlaybackSpeed +- (a fraction: .006 = 10 cents)
	priority: number, -- a full pool steals only voices of a lower or equal priority
	gain: number,
	ladder: boolean?, -- variants climb while plays follow each other (buy)
}

Audio.RULES = {
	hover = { pool = "ui", cooldown = 0.075, rate = 7, voices = 2, steal = false, jitter = 0.006, priority = 1, gain = 1 },
	press = { pool = "ui", cooldown = 0.04, rate = 12, voices = 3, steal = true, jitter = 0.02, priority = 4, gain = 1 },
	tab = { pool = "ui", cooldown = 0.06, rate = 8, voices = 2, steal = true, jitter = 0.006, priority = 3, gain = 1 },
	panel_open = { pool = "ui", cooldown = 0.12, rate = 4, voices = 2, steal = true, jitter = 0, priority = 5, gain = 1 },
	panel_close = { pool = "ui", cooldown = 0.12, rate = 4, voices = 2, steal = true, jitter = 0, priority = 5, gain = 1 },
	buy = { pool = "ui", cooldown = 0.06, rate = 9, voices = 6, steal = true, jitter = 0.004, priority = 6, gain = 1, ladder = true },
	toast = { pool = "ui", cooldown = 0.25, rate = 3, voices = 2, steal = true, jitter = 0, priority = 5, gain = 1 },
	error = { pool = "ui", cooldown = 0.25, rate = 3, voices = 1, steal = true, jitter = 0.01, priority = 6, gain = 1 },
	unlock = { pool = "fx", cooldown = 0.8, rate = 2, voices = 2, steal = true, jitter = 0, priority = 8, gain = 1 },
	prestige_small = { pool = "fx", cooldown = 0.35, rate = 3, voices = 2, steal = true, jitter = 0, priority = 8, gain = 1 },
	prestige_big = { pool = "fx", cooldown = 1.5, rate = 1, voices = 1, steal = true, jitter = 0, priority = 10, gain = 1 },
} :: { [string]: Rule }

-- voices per pool (loops: the two loop players); 32 on a PC, 16 on a phone (MASTER_PLAN 5.1)
Audio.BUDGET = {
	pc = { ui = 24, fx = 6, loops = 2 },
	phone = { ui = 11, fx = 3, loops = 2 },
} :: { [string]: { [string]: number } }
-- the mix: each bus's level at 100 % (the user's slider scales it)
Audio.BASE = { UI = 1, Impacts = 1, Ambience = 0.6, Music = 0.8 } :: { [string]: number }
-- each loop's level at level 1
Audio.LOOP_GAIN = { portal_loop = 0.8, ambience = 1 } :: { [string]: number }
Audio.LADDER_GAP = 0.45 -- buys closer than this climb the ladder

Audio.mode = "off" :: string
Audio.live = false
Audio.phone = false
Audio.volumes = { UI = 0, Impacts = 0, Ambience = 0, Music = 0 } :: { [string]: number }
Audio.last = nil :: { name: string, variant: number, speed: number, volume: number }?

type Voice = { inst: Instance, pool: string, name: string?, busyUntil: number, startedAt: number, priority: number }
type Loop = { name: string, inst: Instance?, level: number, target: number, playing: boolean }

local started = false
local ids: any = nil
local root: Instance? = nil
local buses: { [string]: Instance } = {}
local pools: { [string]: { Voice } } = {}
local loops: { [string]: Loop } = {}
local lastAt: { [string]: number } = {}
local recent: { [string]: { number } } = {}
local lastVariant: { [string]: number } = {}
local ladder = { step = -1, at = -math.huge }
local pending: { [string]: { at: number, cls: any, lv: any, tab: any } } = {}
local awakePrev: { [string]: boolean }? = nil
local insidePrev: boolean? = nil
local rng: Random = nil :: any -- made at start (so requiring this module needs no engine globals)
local clock: () -> number = os.clock
local conns: { any } = {} -- Signal connections (Prefs.changed)

-- ------------------------------------------------------------------------------------------------------ helpers
local function isStudio(): boolean
	local ok, v = pcall(function(): boolean
		return RunService:IsStudio()
	end)
	return ok and v == true
end

-- the asset of a sheet: its approved id; in Studio a sheet still in review is tried too (its owner can hear it)
local function idOf(sheet: string): string?
	local s = ids and ids.sheets and ids.sheets[sheet]
	if type(s) ~= "table" then return nil end
	if type(s.id) == "string" and s.id ~= "" then return s.id end
	if type(s.review) == "string" and s.review ~= "" and isStudio() then return s.review end
	return nil
end

local function curve(v: any): number
	local x = math.clamp((tonumber(v) or 0) / 100, 0, 1)
	return x * x
end

local function forced(): string?
	if not isStudio() then return nil end
	local lp = Players.LocalPlayer
	local v = if lp then lp:GetAttribute("MT_ForceCaps") else nil
	if type(v) ~= "string" then return nil end
	for name in string.gmatch(v, "[%w]+") do
		if name == "Audio" then return "off" end
		if name == "all" or name == "AudioApi" then return "sound" end
	end
	return nil
end

local function detectPhone(): boolean
	local phone = false
	pcall(function()
		if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then phone = true end
		if GuiService.ViewportDisplaySize == Enum.DisplaySize.Small then phone = true end
	end)
	return phone
end

local function loadIds(): any
	local ok, t = pcall(function(): any
		local shared = ReplicatedStorage:FindFirstChild("MilestoneTree")
		if shared == nil then shared = ReplicatedStorage:WaitForChild("MilestoneTree", 5) end
		if shared == nil then return nil end
		local mod = shared:FindFirstChild("AudioIds")
		if mod == nil then mod = shared:WaitForChild("AudioIds", 5) end
		if mod == nil or not mod:IsA("ModuleScript") then return nil end
		return (require :: any)(mod)
	end)
	if ok and type(t) == "table" and type(t.sounds) == "table" and type(t.sheets) == "table" then return t end
	return nil
end

-- ------------------------------------------------------------------------------------------------------ probes
local function probeApi(): boolean
	return pcall(function()
		local p = Instance.new("AudioPlayer") :: any
		local f = Instance.new("AudioFader") :: any
		local w = Instance.new("Wire") :: any
		w.SourceInstance = p
		w.TargetInstance = f
		assert(typeof(p.Play) == "function" and typeof(p.Stop) == "function", "no AudioPlayer methods")
		p.PlaybackRegion = NumberRange.new(0, 1)
		f.Volume = 1
		local c = Instance.new("AudioCompressor") :: any
		local l = Instance.new("AudioLimiter") :: any
		local o = Instance.new("AudioDeviceOutput") :: any
		for _, x in { w, p, f, c, l, o } do x:Destroy() end
	end)
end

local function probeSound(): boolean
	return pcall(function()
		local s = Instance.new("Sound") :: any
		local g = Instance.new("SoundGroup") :: any
		s.SoundGroup = g
		assert(typeof(s.Play) == "function" and typeof(s.Stop) == "function", "no Sound methods")
		s.PlaybackRegionsEnabled = true
		s.PlaybackRegion = NumberRange.new(0, 1)
		s:Destroy()
		g:Destroy()
	end)
end

-- ------------------------------------------------------------------------------------------------------ the graph
local POOL_BUS: { [string]: string } = { ui = "UI", fx = "Impacts" } -- each pool's sheet name and bus

local function node(class: string, name: string, props: { [string]: any }?): Instance
	local inst = Instance.new(class :: any) :: any
	inst.Name = name
	for k, v in (props or {}) :: { [string]: any } do inst[k] = v end
	inst.Parent = root
	return inst
end

local function wire(src: Instance, dst: Instance, pin: string?): Instance
	local w = Instance.new("Wire") :: any
	w.Name = "To" .. dst.Name .. (pin or "")
	w.SourceInstance = src
	w.TargetInstance = dst
	if pin then w.TargetName = pin end
	w.Parent = src
	return w
end

local function newRoot(): Instance
	local old = SoundService:FindFirstChild("MT_Audio")
	if old then old:Destroy() end
	local f = Instance.new("Folder")
	f.Name = "MT_Audio"
	f.Parent = SoundService
	return f
end

local function buildApi(budget: { [string]: number })
	root = newRoot()
	pcall(function() (SoundService :: any).DefaultListenerLocation = (Enum :: any).ListenerLocation.None end)
	local out = node("AudioDeviceOutput", "Output")
	local limiter = node("AudioLimiter", "Limiter", { MaxLevel = -1, Release = 0.08 })
	local master = node("AudioFader", "Master", { Volume = 1 })
	for _, b in { "UI", "Impacts", "Ambience", "Music" } do buses[b] = node("AudioFader", b, { Volume = 0 }) end
	local duck = node("AudioCompressor", "Duck", { Threshold = -30, Ratio = 4, Attack = 0.01, Release = 0.6, MakeupGain = 0 })
	local key = node("AudioFader", "UiKey", { Volume = 0.35 })
	wire(buses.UI, master)
	wire(buses.UI, key)
	wire(key, duck, "Sidechain")
	wire(buses.Impacts, master)
	wire(buses.Impacts, duck, "Sidechain")
	wire(buses.Ambience, duck)
	wire(buses.Music, duck)
	wire(duck, master)
	wire(master, limiter)
	wire(limiter, out)
	for pool, bus in POOL_BUS do
		local id = idOf(pool)
		local list: { Voice } = {}
		if id then
			for i = 1, budget[pool] or 0 do
				local p = node("AudioPlayer", pool .. "_" .. i, { AutoLoad = true, Looping = false, Volume = 1 }) :: any
				p.Asset = id
				wire(p, buses[bus])
				table.insert(list, { inst = p, pool = pool, name = nil, busyUntil = -math.huge, startedAt = -math.huge, priority = 0 })
			end
		end
		pools[pool] = list
	end
end

local function buildSound(budget: { [string]: number })
	root = newRoot()
	local master = node("SoundGroup", "Master", { Volume = 1 })
	for _, b in { "UI", "Impacts", "Ambience", "Music" } do
		local g = Instance.new("SoundGroup") :: any
		g.Name = b
		g.Volume = 0
		g.Parent = master
		buses[b] = g
	end
	for _, b in { "Ambience", "Music" } do
		pcall(function()
			local c = Instance.new("CompressorSoundEffect") :: any
			c.Name = "Duck"
			c.Threshold = -30
			c.Ratio = 4
			c.Attack = 0.01
			c.Release = 0.6
			c.SideChain = buses.Impacts
			c.Parent = buses[b]
		end)
	end
	for pool, bus in POOL_BUS do
		local id = idOf(pool)
		local list: { Voice } = {}
		if id then
			for i = 1, budget[pool] or 0 do
				local s = node("Sound", pool .. "_" .. i, { SoundGroup = buses[bus], Looped = false, Volume = 1 }) :: any
				s.SoundId = id
				s.PlaybackRegionsEnabled = true
				table.insert(list, { inst = s, pool = pool, name = nil, busyUntil = -math.huge, startedAt = -math.huge, priority = 0 })
			end
		end
		pools[pool] = list
	end
end

local function setVolume(bus: string, v: number)
	Audio.volumes[bus] = v
	local b: Instance? = buses[bus]
	if b == nil then return end
	pcall(function() (b :: any).Volume = v end)
end

local function applyVolumes()
	local p = Prefs.get() :: any
	local base = Audio.BASE
	setVolume("UI", base.UI * curve(p.sfx))
	setVolume("Impacts", base.Impacts * curve(p.sfx))
	setVolume("Ambience", base.Ambience * curve(p.ambience))
	setVolume("Music", base.Music * curve(p.music))
end

-- ------------------------------------------------------------------------------------------------------ start
export type StartOptions = {
	ids: any?, -- an AudioIds table (tests); default: shared/AudioIds
	force: string?, -- "api" | "sound" | "off"
	phone: boolean?,
	clock: (() -> number)?,
	seed: number?,
}

-- tear everything down (tests; a second start rebuilds)
function Audio.reset()
	for _, c in conns do c:Disconnect() end
	table.clear(conns)
	if root then (root :: Instance):Destroy() end
	root = nil
	table.clear(buses)
	table.clear(pools)
	table.clear(loops)
	table.clear(lastAt)
	table.clear(recent)
	table.clear(lastVariant)
	table.clear(pending)
	ladder.step, ladder.at = -1, -math.huge
	awakePrev, insidePrev = nil, nil
	started = false
	Audio.mode = "off"
	Audio.live = false
	Audio.last = nil
end

function Audio.start(o: StartOptions?)
	if started then return end
	started = true
	local opts: StartOptions = o or {}
	if opts.clock then clock = opts.clock :: () -> number else clock = os.clock end
	rng = if opts.seed then Random.new(opts.seed) else Random.new()
	ids = if opts.ids ~= nil then opts.ids else loadIds()
	Audio.phone = if opts.phone ~= nil then opts.phone == true else detectPhone()
	local budget = Audio.BUDGET[if Audio.phone then "phone" else "pc"]
	local want = opts.force or forced()
	local mode = "off"
	if want ~= "off" and want ~= "sound" and probeApi() then
		mode = if pcall(buildApi, budget) then "api" else "off"
	end
	if mode == "off" and want ~= "off" then
		if root then (root :: Instance):Destroy() end
		root = nil
		table.clear(buses)
		table.clear(pools)
		if probeSound() then mode = if pcall(buildSound, budget) then "sound" else "off" end
	end
	if mode == "off" and root then
		(root :: Instance):Destroy()
		root = nil
		table.clear(buses)
		table.clear(pools)
	end
	Audio.mode = mode
	applyVolumes()
	table.insert(conns, Prefs.changed:Connect(function(key: string)
		if key == "sfx" or key == "music" or key == "ambience" then applyVolumes() end
	end))
end

function Audio.setLive(on: boolean)
	Audio.live = on
end

-- ------------------------------------------------------------------------------------------------------ one-shots
local function pickVariant(name: string, n: number): number
	if n <= 1 then return 1 end
	local last = lastVariant[name]
	local k = rng:NextInteger(1, if last then n - 1 else n)
	if last and k >= last then k += 1 end
	return k
end

-- the combo ladder: 1, 2, .. n while buys follow each other, then the top two alternate
local function ladderVariant(n: number, now: number): number
	if now - ladder.at < Audio.LADDER_GAP then ladder.step += 1 else ladder.step = 0 end
	ladder.at = now
	local s = ladder.step
	if s < n then return s + 1 end
	return if (s - n) % 2 == 0 then math.max(1, n - 1) else n
end

local function startVoice(v: Voice, a: number, len: number, speed: number, volume: number): boolean
	return pcall(function()
		local p = v.inst :: any
		if Audio.mode == "api" then
			if p.IsReady == false then error("not loaded") end
			if p.IsPlaying then p:Stop() end
			p.Looping = false
			p.PlaybackRegion = NumberRange.new(a, a + len)
			p.TimePosition = a
			p.PlaybackSpeed = speed
			p.Volume = volume
			p:Play()
		else
			if p.IsPlaying then p:Stop() end
			p.Looped = false
			p.PlaybackRegion = NumberRange.new(a, a + len)
			p.TimePosition = a
			p.PlaybackSpeed = speed
			p.Volume = volume
			p:Play()
		end
	end)
end

export type PlayOptions = { volume: number?, pitch: number?, variant: number? }

function Audio.play(name: string, o: PlayOptions?): boolean
	if not started or not Audio.live or Audio.mode == "off" then return false end
	local rule = Audio.RULES[name]
	local snd = ids and ids.sounds and ids.sounds[name]
	if rule == nil or type(snd) ~= "table" or snd.loop or type(snd.regions) ~= "table" or #snd.regions == 0 then return false end
	if idOf(snd.sheet) == nil then return false end
	local pool = pools[rule.pool]
	if pool == nil or #pool == 0 then return false end
	local now = clock()
	if now - (lastAt[name] or -math.huge) < rule.cooldown then return false end
	local list = recent[name]
	if list == nil then
		list = {}
		recent[name] = list
	end
	while #list > 0 and now - list[1] >= 1 do table.remove(list, 1) end
	if #list >= rule.rate then return false end
	-- a voice: past the cue's own cap, its oldest (or drop); else a free one; else the weakest busy one
	local mine, oldestMine, free, weakest = 0, nil :: Voice?, nil :: Voice?, nil :: Voice?
	for _, v in pool do
		local busy = v.busyUntil > now
		if busy and v.name == name then
			mine += 1
			if oldestMine == nil or v.startedAt < (oldestMine :: Voice).startedAt then oldestMine = v end
		elseif not busy then
			if free == nil then free = v end
		elseif v.priority <= rule.priority then
			local w = weakest
			if w == nil or v.priority < w.priority or (v.priority == w.priority and v.startedAt < w.startedAt) then weakest = v end
		end
	end
	local voice: Voice?
	if mine >= rule.voices then
		if not rule.steal then return false end
		voice = oldestMine
	else
		voice = free or weakest or (if rule.steal then oldestMine else nil)
	end
	if voice == nil then return false end
	local opts: PlayOptions = o or {}
	local n = #snd.regions
	local k = opts.variant or (if rule.ladder then ladderVariant(n, now) else pickVariant(name, n))
	k = math.clamp(math.floor(k), 1, n)
	local region = snd.regions[k]
	if type(region) ~= "table" then return false end
	local a, len = tonumber(region[1]) or 0, tonumber(region[2]) or 0
	if len <= 0 then return false end
	local speed = (opts.pitch or 1) * (1 + rule.jitter * (2 * rng:NextNumber() - 1))
	local volume = math.clamp((opts.volume or 1) * rule.gain * 10 ^ ((rng:NextNumber() - 0.5) * 1.2 / 20), 0, 4)
	local v = voice :: Voice
	if not startVoice(v, a, len, speed, volume) then return false end
	v.name, v.busyUntil, v.startedAt, v.priority = name, now + len / math.max(speed, 0.01) + 0.02, now, rule.priority
	lastAt[name] = now
	lastVariant[name] = k
	table.insert(list, now)
	Audio.last = { name = name, variant = k, speed = speed, volume = volume }
	return true
end

-- the click of a view button (Render): a locked one answers with the soft "no"
function Audio.pressFor(n: any): boolean
	local cls = if type(n) == "table" then n.cls else nil
	if cls == "locked" or cls == "plocked" then return Audio.play("error", { volume = 0.8 }) end
	return Audio.play("press")
end

function Audio.prestige(layer: string?, first: boolean?): boolean
	local big = first
	if big == nil then big = layer ~= nil and Prefs.claimFirstPrestige(layer :: string) end
	return Audio.play(if big then "prestige_big" else "prestige_small")
end

-- ------------------------------------------------------------------------------------------------------ loops
local function loopInst(name: string, snd: any): Instance?
	local sheet = snd.sheet
	local id = idOf(sheet)
	if id == nil or root == nil or Audio.mode == "off" then return nil end
	local ok, inst = pcall(function(): Instance
		if Audio.mode == "api" then
			local p = node("AudioPlayer", "Loop_" .. name, { AutoLoad = true, Looping = true, Volume = 0 }) :: any
			p.Asset = id
			wire(p, buses.Ambience)
			return p
		end
		local s = node("Sound", "Loop_" .. name, { SoundGroup = buses.Ambience, Looped = true, Volume = 0 }) :: any
		s.SoundId = id
		s.PlaybackRegionsEnabled = true
		return s
	end)
	return if ok then inst else nil
end

function Audio.loop(name: string, level: number)
	local l = loops[name]
	if l == nil then
		l = { name = name, inst = nil, level = 0, target = 0, playing = false }
		loops[name] = l
	end
	(l :: Loop).target = math.clamp(if level == level then level else 0, 0, 1)
end

function Audio.loopLevel(name: string): number
	local l = loops[name]
	return if l then l.level else 0
end

local function stepLoop(l: Loop, dt: number)
	local target = if Audio.live then l.target else 0
	local rate = if target > l.level then dt / 1.2 else dt / 0.8
	if math.abs(target - l.level) <= rate then l.level = target elseif target > l.level then l.level += rate else l.level -= rate end
	if not started or Audio.mode == "off" then return end
	local snd = ids and ids.sounds and ids.sounds[l.name]
	if type(snd) ~= "table" or type(snd.regions) ~= "table" or #snd.regions == 0 then return end
	if l.level > 0 and not l.playing then
		if l.inst == nil then l.inst = loopInst(l.name, snd) end
		local inst = l.inst
		if inst == nil then return end
		local region = snd.regions[1]
		if type(region) ~= "table" then return end
		local a, len = tonumber(region[1]) or 0, tonumber(region[2]) or 0
		l.playing = pcall(function()
			local p = inst :: any
			p.PlaybackRegion = NumberRange.new(a, a + len)
			p.LoopRegion = NumberRange.new(a, a + len)
			if Audio.mode == "api" then p.Looping = true else p.Looped = true end
			p.TimePosition = a
			p:Play()
		end)
	end
	local inst = l.inst
	if inst == nil or not l.playing then return end
	pcall(function() (inst :: any).Volume = l.level * (Audio.LOOP_GAIN[l.name] or 1) end)
	if l.level <= 0 then
		pcall(function() (inst :: any):Stop() end)
		l.playing = false
	end
end

function Audio.step(dt: number)
	for _, l in loops do stepLoop(l, dt) end
end

-- ------------------------------------------------------------------------------------------------------ cues from the view
local BUY_VERBS = { upg = true, buy = true } :: { [string]: boolean }

local function sameAction(a: any, b: any): boolean
	if type(a) ~= "table" or type(b) ~= "table" or #a ~= #b then return false end
	for i = 1, #a do
		if tostring(a[i]) ~= tostring(b[i]) then return false end
	end
	return true
end

-- a purchase was sent (the press, not the result): remember what its button looked like
function Audio.expectBuy(a: any, store: any)
	if type(a) ~= "table" or not BUY_VERBS[a[1]] or type(store) ~= "table" or type(store.nodes) ~= "table" then return end
	for id, n in store.nodes do
		if type(id) == "string" and string.sub(id, 1, 4) == "tab." and type(n) == "table" and n.t == "btn" and sameAction(n.a, a) then
			if n.cls == "can" then pending[id] = { at = clock(), cls = n.cls, lv = n.lv, tab = store.tab } end
			return
		end
	end
end

-- after a patch: a remembered button that is now bought, changed level, or left the same tab was a purchase that
-- went through. A button that only turned locked (spent elsewhere), a new tab, or 2 s of nothing: no sound.
function Audio.afterPatch(store: any): number
	local now = clock()
	local bought = 0
	local okStore = type(store) == "table" and type(store.get) == "function"
	for id, p in pending do
		local n = if okStore then store:get(id) else nil
		if now - p.at > 2 or not okStore or store.tab ~= p.tab then
			pending[id] = nil
		elseif type(n) ~= "table" or n.cls == "bought" or (p.lv ~= nil and n.lv ~= p.lv) then
			pending[id] = nil
			bought += 1
		end
	end
	if bought > 0 then Audio.play("buy") end
	return bought
end

function Audio.pendingBuys(): number
	local n = 0
	for _ in pending do n += 1 end
	return n
end

-- a layer is awake when its node shows and is unlocked (or has no value yet)
local function awake(n: any): boolean
	if type(n) ~= "table" or not n.show then return false end
	local v = n.val
	return v == nil or v.lit == true
end

-- after a map change: layers that woke since the last map play "unlock". The first view and a universe change only
-- set the baseline (many nodes change there at once, and none of them woke).
function Audio.observeMap(ms: any): { string }
	local woke: { string } = {}
	if type(ms) ~= "table" or not ms.ok or type(ms.nodes) ~= "table" then return woke end
	local now: { [string]: boolean } = {}
	for layer, n in ms.nodes do
		if type(layer) == "string" then now[layer] = awake(n) end
	end
	local prev = awakePrev
	if prev == nil or insidePrev ~= ms.inside then
		awakePrev, insidePrev = now, ms.inside
		return woke
	end
	for layer, on in now do
		if on and not (prev :: { [string]: boolean })[layer] and layer ~= "ach" then table.insert(woke, layer) end
	end
	awakePrev = now
	if #woke > 0 then Audio.play("unlock") end
	return woke
end

-- ------------------------------------------------------------------------------------------------------ tests
function Audio.stats(): { mode: string, voices: { [string]: number }, busy: { [string]: number }, total: number, instances: number }
	local now = clock()
	local voices, busy, total = {}, {}, 0
	for pool, list in pools do
		voices[pool] = #list
		local b = 0
		for _, v in list do
			if v.busyUntil > now then b += 1 end
		end
		busy[pool] = b
		total += #list
	end
	for _, l in loops do
		if l.inst then total += 1 end
	end
	return { mode = Audio.mode, voices = voices, busy = busy, total = total, instances = if root then #(root :: Instance):GetDescendants() else 0 }
end

-- how many voices are playing `name` right now
function Audio.playing(name: string): number
	local now = clock()
	local n = 0
	for _, list in pools do
		for _, v in list do
			if v.name == name and v.busyUntil > now then n += 1 end
		end
	end
	return n
end

return Audio
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">Layout</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Layout: breakpoints and the UI scale (DESIGN.md 10), the ScreenGuis (plan 2.1), coordinate conversion (plan 2.9),
	the HUD-rect registry and the free / safe map rects.

	    Layout.mode ("WIDE" | "MEDIUM" | "COMPACT"), Layout.s, Layout.canvas (du), Layout.viewport (points)
	    Layout.changed                      viewport, Interface Size, PreferredTextSize (re-measure; s ignores it)
	    Layout.screen(name, order, insets)  a ScreenGui + its Root (UIScale s, sized V/s in offset; MapGui: none)
	    Layout.duToAbs(gui, p)              screen du from the device top-left -> abs space px
	    Layout.inputToAbs(p)                InputObject.Position -> abs space (the only such conversion)
	    Layout.setRect(key, r) / rects()    HUD rects for plate occlusion and marker push-out (abs space)
	    Layout.setSheet(sx) / free()        the map's free rect while a side sheet covers [sx, W)
	    Layout.safeStartRect()              the start-framing rect V' (without the top and bottom HUD bands)

	Abs space is the space of GuiObject.AbsolutePosition. Rects are { x, y, w, h } in it.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Signal = require(script.Parent:WaitForChild("Signal"))
local Prefs = require(script.Parent:WaitForChild("Prefs"))

type ARect = Types.Rect

local Layout = {}

Layout.mode = "WIDE" :: string
Layout.s = 1
Layout.canvas = Vector2.new(1920, 1080)
Layout.viewport = Vector2.new(1920, 1080)
Layout.changed = Signal.new() :: Signal.Signal<>
Layout.rectsChanged = Signal.new() :: Signal.Signal<>

-- the HUD bands of the start framing and the free rect (DESIGN.md 3.3), in du
Layout.TOP_BAND = 100
Layout.TOP_BAND_COMPACT = 76
Layout.BOTTOM_BAND = 96
Layout.BOTTOM_BAND_COMPACT = 64
Layout.STRIP_MIN = 460 -- a side sheet whose map strip is narrower than this (du) goes full screen

-- ------------------------------------------------------------------------------------------------------ the formula
-- Aspect-ratio scaling (the user's call, 2026-09-26): one layout for every device. The UI is designed on a 1920 x 1080
-- reference canvas and scaled by the tighter axis, so phones, tablets, laptops and consoles all get the same screen,
-- scaled; nothing is hand-tuned per device. S_FLOOR keeps phone text legible (a 844 x 390 phone gets s .55, a
-- 1535 x 709 du canvas). The mode only records how much canvas that leaves (MEDIUM when it is narrower or shorter
-- than the design wants), never a different phone design. userSize is the Interface Size option (.90 / 1 / 1.15).
Layout.REF = Vector2.new(1920, 1080)
Layout.S_FLOOR = 0.55
Layout.S_MIN = { COMPACT = Layout.S_FLOOR, MEDIUM = Layout.S_FLOOR, WIDE = Layout.S_FLOOR } :: { [string]: number }
function Layout.compute(vw: number, vh: number, userSize: number?): (string, number, Vector2)
	local s = math.min(vw / Layout.REF.X, vh / Layout.REF.Y) * (userSize or 1)
	s = math.clamp(s, Layout.S_FLOOR, 2.0)
	local canvas = Vector2.new(vw / s, vh / s)
	local mode = if canvas.X < 1500 or canvas.Y < 860 then "MEDIUM" else "WIDE"
	return mode, s, canvas
end
-- the map strip left of a side sheet that is too narrow keeps the sheet full screen (DESIGN.md 3.6)
function Layout.stripIsFull(stripDu: number, mode: string?): boolean
	return (mode or Layout.mode) == "COMPACT" or stripDu < Layout.STRIP_MIN
end

local function viewportSize(): Vector2
	local cam = Workspace.CurrentCamera
	if cam then
		local v = cam.ViewportSize
		if v.X > 1 and v.Y > 1 then return v end
	end
	return Vector2.new(1920, 1080)
end

type Screen = { gui: ScreenGui, root: Frame, scale: UIScale? }
local screens: { [string]: Screen } = {}

local function fitRoot(sc: Screen)
	if sc.scale == nil then return end
	local size = sc.gui.AbsoluteSize
	if size.X < 1 or size.Y < 1 then size = viewportSize() end
	local s = Layout.s
	sc.scale.Scale = s
	sc.root.Size = UDim2.fromOffset(math.floor(size.X / s + 0.5), math.floor(size.Y / s + 0.5))
end

-- the player's text size setting: s ignores it, but text frames re-measure when it changes (Layout.changed)
Layout.textSize = "Medium"
local function refresh()
	local v = viewportSize()
	local textSize = Layout.textSize
	pcall(function()
		textSize = GuiService.PreferredTextSize.Name
	end)
	local mode, s, canvas = Layout.compute(v.X, v.Y, Prefs.get().size / 100)
	local moved = mode ~= Layout.mode or math.abs(s - Layout.s) > 1e-6 or v ~= Layout.viewport or textSize ~= Layout.textSize
	Layout.mode, Layout.s, Layout.canvas, Layout.viewport, Layout.textSize = mode, s, canvas, v, textSize
	for _, sc in screens do fitRoot(sc) end
	if moved then Layout.changed:Fire() end
end
Layout.refresh = refresh

local started = false
local camConn: RBXScriptConnection? = nil
local function watchCamera()
	if camConn then camConn:Disconnect() end
	local cam = Workspace.CurrentCamera
	if cam then camConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(refresh) end
end
function Layout.start()
	if started then return end
	started = true
	watchCamera()
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		watchCamera()
		refresh()
	end)
	pcall(function()
		GuiService:GetPropertyChangedSignal("PreferredTextSize"):Connect(refresh)
	end)
	Prefs.changed:Connect(function(key: string)
		if key == "size" then refresh() end
	end)
	refresh()
end

-- ------------------------------------------------------------------------------------------------------ ScreenGuis
-- MapGui gets a full-screen black Root with no UIScale (REALM.md 9.1); every other Root carries UIScale s and is sized
-- in offset V / s. IgnoreGuiInset is never set (it rewrites ScreenInsets).
function Layout.screen(name: string, order: number, insets: Enum.ScreenInsets): (ScreenGui, Frame)
	Layout.start()
	local old = screens[name]
	if old and old.gui.Parent then return old.gui, old.root end
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.AutoLocalize = false
	gui.DisplayOrder = order
	gui.ScreenInsets = insets
	if insets == Enum.ScreenInsets.None then
		pcall(function() gui.SafeAreaCompatibility = Enum.SafeAreaCompatibility.None end)
	end
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BorderSizePixel = 0
	root.Active = false
	local sc: Screen = { gui = gui, root = root, scale = nil }
	if name == "MapGui" then
		root.Size = UDim2.fromScale(1, 1)
		root.BackgroundColor3 = Color3.new(0, 0, 0)
		root.BackgroundTransparency = 0
		root.ClipsDescendants = true
	else
		root.BackgroundTransparency = 1
		local u = Instance.new("UIScale")
		u.Name = "UIScale"
		u.Parent = root
		sc.scale = u
	end
	root.Parent = gui
	screens[name] = sc
	fitRoot(sc)
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() fitRoot(sc) end)
	local lp = Players.LocalPlayer
	local pg = if lp then lp:FindFirstChildOfClass("PlayerGui") or lp:WaitForChild("PlayerGui", 10) else nil
	gui.Parent = pg
	return gui, root
end
function Layout.getScreen(name: string): (ScreenGui?, Frame?)
	local sc = screens[name]
	if sc then return sc.gui, sc.root end
	return nil, nil
end

-- ------------------------------------------------------------------------------------------------------ coordinates
-- where the device's top-left corner is in abs space. MapGui (ScreenInsets None) covers the whole device, so its
-- Root's AbsolutePosition is exactly that; before it exists, the classic top inset is assumed.
function Layout.deviceOrigin(): Vector2
	local map = screens.MapGui
	if map and map.root.Parent then return map.root.AbsolutePosition end
	local ok, tl = pcall(function() return (GuiService:GetGuiInset()) end)
	if ok and typeof(tl) == "Vector2" then return Vector2.new(-tl.X, -tl.Y) end
	return Vector2.zero
end
-- screen du from the device top-left -> abs space px
function Layout.duToAbs(_gui: ScreenGui?, p: Vector2): Vector2
	return Layout.deviceOrigin() + p * Layout.s
end
-- abs space px -> the local offset space of a Root (which is sized in offset under its UIScale)
function Layout.absToLocal(root: GuiObject, p: Vector2): Vector2
	local d = p - root.AbsolutePosition
	local off = root.Size.X.Offset
	local k = if off > 0 and root.AbsoluteSize.X > 0 then root.AbsoluteSize.X / off else 1
	return d / k
end
-- InputObject.Position -> abs space. Roblox reports input positions without the top-bar inset, the same space as
-- AbsolutePosition (checked in Studio, plan 8 item 5), so this is the identity; keep every conversion here.
function Layout.inputToAbs(p: Vector2 | Vector3): Vector2
	if typeof(p) == "Vector3" then
		local v = p :: Vector3
		return Vector2.new(v.X, v.Y)
	end
	return p :: Vector2
end
-- the Roblox top-bar buttons area, abs space
function Layout.topbar(): ARect
	local o = Layout.deviceOrigin()
	local ok, r = pcall(function(): Rect return GuiService.TopbarInset end)
	if ok and typeof(r) == "Rect" then
		return { x = o.X + r.Min.X, y = o.Y + r.Min.Y, w = r.Width, h = r.Height }
	end
	return { x = o.X, y = o.Y, w = 0, h = 58 }
end

-- ------------------------------------------------------------------------------------------------------ HUD rects
local rectMap: { [string]: ARect } = {}
local rectList: { ARect }? = nil
-- a registered rect by its key ("hud.capsule", "hud.ready", ...), abs space
function Layout.rect(key: string): ARect?
	return rectMap[key]
end
function Layout.setRect(key: string, r: ARect?)
	local old = rectMap[key]
	if old and r and old.x == r.x and old.y == r.y and old.w == r.w and old.h == r.h then return end
	if old == nil and r == nil then return end
	rectMap[key] = r
	rectList = nil
	Layout.rectsChanged:Fire()
end
function Layout.rects(): { ARect }
	local l = rectList
	if l == nil then
		l = {}
		for _, r in rectMap do table.insert(l :: { ARect }, r) end
		rectList = l
	end
	return l :: { ARect }
end

-- ------------------------------------------------------------------------------------------------------ map rects
local sheetX: number? = nil
function Layout.setSheet(sx: number?)
	if sx == sheetX then return end
	sheetX = sx
	Layout.rectsChanged:Fire()
end
function Layout.sheet(): number?
	return sheetX
end
local function topBand(): number
	return (if Layout.mode == "COMPACT" then Layout.TOP_BAND_COMPACT else Layout.TOP_BAND) * Layout.s
end
local function bottomBand(): number
	return (if Layout.mode == "COMPACT" then Layout.BOTTOM_BAND_COMPACT else Layout.BOTTOM_BAND) * Layout.s
end
-- the free map rect F: the device screen (or the strip left of a side sheet) minus the top HUD band (abs space)
function Layout.free(): ARect
	local o = Layout.deviceOrigin()
	local v = Layout.viewport
	local right = if sheetX then sheetX - o.X else v.X
	local top = topBand()
	return { x = o.X, y = o.Y + top, w = math.max(1, right), h = math.max(1, v.Y - top) }
end
-- DESIGN.md 3.3 V': the screen (or strip) minus the top band and the bottom band (abs space)
function Layout.safeStartRect(): ARect
	local f = Layout.free()
	return { x = f.x, y = f.y, w = f.w, h = math.max(1, f.h - bottomBand()) }
end

return Layout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">Motion</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Motion: every UI animation goes through here (DESIGN.md 8, plan 2.8).

	    Motion.reduced()                      the Options Motion override, else GuiService.ReducedMotionEnabled;
	                                          always true in snapshot mode (LocalPlayer attribute MT_Snapshot)
	    Motion.tween(inst, info, goals, key)  keyed: a new tween of the same key cancels the old one. Over budget
	                                          (6 running in HudGui / TopbarGui, 40 elsewhere; the map is not
	                                          counted) or with reduced motion, the end state is set at once and
	                                          nil is returned. `always` keeps functional tweens under reduced motion.
	    Motion.pop / bump / flash             small UIScale / transparency accents
	    Motion.loop(owner, fn)                fn(dt) every frame while owner is visible; stops when owner is gone
	    Motion.now(), Motion.step(dt)         the clock (7.0 in snapshot mode); step is called by App every frame

	Tween only Position, Size, Rotation, UIScale, transparencies and UIGradient Offset / Rotation.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Signal = require(script.Parent:WaitForChild("Signal"))
local Prefs = require(script.Parent:WaitForChild("Prefs"))

type Handle = Types.Handle

local Motion = {}

Motion.BUDGET_HUD = 6
Motion.BUDGET_UI = 40
Motion.changed = Signal.new() :: Signal.Signal<boolean>

-- ------------------------------------------------------------------------------------------------------ reduced
local function snapshot(): boolean
	local lp = Players.LocalPlayer
	return lp ~= nil and lp:GetAttribute("MT_Snapshot") == true
end
Motion.snapshot = snapshot

local function compute(): boolean
	if snapshot() then return true end
	local m = Prefs.get().motion
	if m == "REDUCED" then return true end
	if m == "FULL" then return false end
	return GuiService.ReducedMotionEnabled
end
local reducedNow: boolean? = nil
local watching = false
local function refresh()
	local r = compute()
	if r ~= reducedNow then
		local first = reducedNow == nil
		reducedNow = r
		if not first then Motion.changed:Fire(r) end
	end
end
local function watch()
	if watching then return end
	watching = true
	GuiService:GetPropertyChangedSignal("ReducedMotionEnabled"):Connect(refresh)
	Prefs.changed:Connect(function(key: string)
		if key == "motion" then refresh() end
	end)
	local lp = Players.LocalPlayer
	if lp then lp:GetAttributeChangedSignal("MT_Snapshot"):Connect(refresh) end
end
function Motion.reduced(): boolean
	if reducedNow == nil then
		watch()
		refresh()
	end
	return reducedNow == true
end

function Motion.now(): number
	if snapshot() then return 7.0 end
	return os.clock()
end

-- ------------------------------------------------------------------------------------------------------ tweens
local running: { [string]: number } = { hud = 0, ui = 0, map = 0 }
local keyed: { [string]: Tween } = {}

local function poolOf(inst: Instance): string
	local gui = inst:FindFirstAncestorWhichIsA("ScreenGui")
	if gui == nil then return "ui" end
	local n = gui.Name
	if n == "HudGui" or n == "TopbarGui" then return "hud" end
	if n == "MapGui" then return "map" end
	return "ui"
end
local function limit(pool: string): number
	if pool == "hud" then return Motion.BUDGET_HUD end
	if pool == "map" then return math.huge end
	return Motion.BUDGET_UI
end
local function setGoals(inst: Instance, goals: { [string]: any })
	for k, v in goals do
		pcall(function() (inst :: any)[k] = v end)
	end
end

function Motion.tween(inst: Instance, info: TweenInfo, goals: { [string]: any }, key: string?, always: boolean?): Tween?
	if key then
		local old = keyed[key]
		if old then
			keyed[key] = nil
			old:Cancel()
		end
	end
	local pool = poolOf(inst)
	if (Motion.reduced() and not always) or running[pool] >= limit(pool) or inst.Parent == nil then
		setGoals(inst, goals)
		return nil
	end
	local ok, tw = pcall(TweenService.Create, TweenService, inst, info, goals)
	if not ok then
		setGoals(inst, goals)
		return nil
	end
	local tween = tw :: Tween
	running[pool] += 1
	local done = false
	tween.Completed:Once(function()
		if done then return end
		done = true
		running[pool] = math.max(0, running[pool] - 1)
		if key and keyed[key] == tween then keyed[key] = nil end
	end)
	if key then keyed[key] = tween end
	tween:Play()
	return tween
end

-- a UIScale child of a GuiObject (created on first use)
local function scaleOf(inst: GuiObject): UIScale
	local s = inst:FindFirstChild("MotionScale")
	if s and s:IsA("UIScale") then return s end
	local u = Instance.new("UIScale")
	u.Name = "MotionScale"
	u.Parent = inst
	return u
end
Motion.scaleOf = scaleOf

-- pop in: 0 -> 1.15 -> 1 (0.25 s Back Out)
function Motion.pop(inst: GuiObject)
	local s = scaleOf(inst)
	if Motion.reduced() then
		s.Scale = 1
		return
	end
	s.Scale = 0
	Motion.tween(s, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }, nil)
end
-- a small bump: 1 + amount -> 1
function Motion.bump(inst: GuiObject, amount: number?)
	if Motion.reduced() then return end
	-- a UIScale grows an item's footprint in its parent's list / grid (the row reflows): flash those instead
	local parent = inst.Parent
	if parent and parent:FindFirstChildWhichIsA("UIGridStyleLayout") then
		Motion.flash(inst)
		return
	end
	local s = scaleOf(inst)
	s.Scale = 1 + (amount or 0.06)
	Motion.tween(s, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }, nil)
end
-- a white flash over the object (the colour flash reduced motion keeps). An object that lays out its own children
-- (a card with a UIListLayout) flashes its outline instead: a flash Frame inside it would be one more list item, as
-- tall as the card, and under AutomaticSize the card would grow with it without end
function Motion.flash(inst: GuiObject)
	if inst:FindFirstChildWhichIsA("UIGridStyleLayout") then
		local old = inst:FindFirstChild("MotionFlash")
		if old then old:Destroy() end
		local st = inst:FindFirstChild("Border") or inst:FindFirstChildWhichIsA("UIStroke")
		if st == nil or not st:IsA("UIStroke") then return end
		local stroke = st :: UIStroke
		-- the resting look, kept across flashes that overlap (a tween in flight is not the resting value)
		local t0 = stroke:GetAttribute("FlashT0")
		local c0 = stroke:GetAttribute("FlashC0")
		if type(t0) ~= "number" or typeof(c0) ~= "Color3" then
			t0, c0 = stroke.Transparency, stroke.Color
			stroke:SetAttribute("FlashT0", t0)
			stroke:SetAttribute("FlashC0", c0)
		end
		stroke.Transparency = 0
		stroke.Color = Color3.new(1, 1, 1)
		local tw = Motion.tween(stroke, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Transparency = t0 :: number, Color = c0 :: Color3 }, "outline:" .. inst:GetFullName(), true)
		local function done()
			stroke:SetAttribute("FlashT0", nil)
			stroke:SetAttribute("FlashC0", nil)
		end
		-- cleared however the tween ends (a newer flash that cancels this one has already read the resting look)
		if tw then tw.Completed:Once(done) else done() end
		return
	end
	local f = inst:FindFirstChild("MotionFlash") :: Frame?
	if f == nil then
		local nf = Instance.new("Frame")
		nf.Name = "MotionFlash"
		nf.Size = UDim2.fromScale(1, 1)
		nf.BackgroundColor3 = Color3.new(1, 1, 1)
		nf.BorderSizePixel = 0
		nf.ZIndex = 50
		nf.Active = false
		local corner = inst:FindFirstChildWhichIsA("UICorner")
		if corner then corner:Clone().Parent = nf end
		nf.Parent = inst
		f = nf
	end
	local frame = f :: Frame
	frame.BackgroundTransparency = 0.55
	Motion.tween(frame, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 },
		nil, true)
end

-- ------------------------------------------------------------------------------------------------------ loops
type Loop = { owner: GuiObject, fn: (dt: number) -> (), alive: boolean }
local loops: { Loop } = {}

function Motion.loop(owner: GuiObject, fn: (dt: number) -> ()): Handle
	local l: Loop = { owner = owner, fn = fn, alive = true }
	table.insert(loops, l)
	local h = {} :: Handle
	function h.stop(_: Handle)
		l.alive = false
	end
	return h
end

-- called once a frame by App (after the map); runs the Luau-driven fills and loops
function Motion.step(dt: number)
	local i = 1
	while i <= #loops do
		local l = loops[i]
		if not l.alive or l.owner.Parent == nil then
			table.remove(loops, i)
			continue
		end
		if l.owner.Visible then
			local ok, err = pcall(function(): any
				l.fn(dt)
				return nil
			end)
			if not ok then
				l.alive = false
				task.spawn(function() error(err, 0) end)
			end
		end
		i += 1
	end
end

return Motion
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">Prefs</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Prefs: the device options (DESIGN.md 6 Options THIS DEVICE, plan 1.10): Motion, Map Detail, Map Labels,
	Interface Size, Weather, Guide, the Music / SFX / Ambience volumes and the first-prestige memory (seenPrestige).
	The keys, choices and defaults are shared/PrefsSchema, the same table the server validates with. They are not
	part of the game save.

	The server keeps them in its own DataStore key and mirrors them into the LocalPlayer attribute MT_Prefs (JSON)
	before the first view. Prefs.set updates at once on this client and sends the table on the Prefs remote (at most
	once a second; the server validates it). Prefs.changed fires (key) for every value that changed.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Signal = require(script.Parent:WaitForChild("Signal"))
local Schema = require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("PrefsSchema"))

type Prefs = Types.Prefs

local Prefs = {}

local ALLOWED: { [string]: { any } } = Schema.CHOICES
Prefs.ALLOWED = ALLOWED
local current: Prefs = Schema.defaults() :: any
Prefs.changed = Signal.new() :: Signal.Signal<string>

local function valid(key: string, value: any): boolean
	return Schema.valid(key, value)
end

local function sameList(a: { string }, b: { string }): boolean
	if #a ~= #b then return false end
	for i, v in a do
		if b[i] ~= v then return false end
	end
	return true
end

-- apply a table of values; fires changed for each key that moved
local function merge(t: { [string]: any })
	local moved = {}
	for key in ALLOWED do
		local v = t[key]
		if v ~= nil and valid(key, v) and (current :: any)[key] ~= v then
			(current :: any)[key] = v
			table.insert(moved, key)
		end
	end
	local seen = t.seenPrestige
	if seen ~= nil and valid("seenPrestige", seen) and not sameList(current.seenPrestige, seen) then
		current.seenPrestige = table.clone(seen)
		table.insert(moved, "seenPrestige")
	end
	for _, k in moved do Prefs.changed:Fire(k) end
end

local started = false
local function readAttribute()
	local lp = Players.LocalPlayer
	if lp == nil then return end
	local raw = lp:GetAttribute("MT_Prefs")
	if type(raw) ~= "string" or raw == "" then return end
	local ok, t = pcall(function() return HttpService:JSONDecode(raw) end)
	if ok and type(t) == "table" then merge(t) end
end
local function start()
	if started then return end
	started = true
	local lp = Players.LocalPlayer
	if lp == nil then return end
	readAttribute()
	lp:GetAttributeChangedSignal("MT_Prefs"):Connect(readAttribute)
end

function Prefs.get(): Prefs
	start()
	local t = table.clone(current)
	t.seenPrestige = table.clone(current.seenPrestige)
	return t
end

-- one send a second at most: the last value wins
local sendQueued = false
local lastSend = -math.huge
local function send()
	local remotes = ReplicatedStorage:FindFirstChild("MilestoneTreeRemotes")
	local remote = if remotes then remotes:FindFirstChild("Prefs") else nil
	if remote == nil or not remote:IsA("RemoteEvent") then return end
	lastSend = os.clock()
	remote:FireServer(Prefs.get())
end
local function queueSend()
	if sendQueued then return end
	local wait = 1 - (os.clock() - lastSend)
	if wait <= 0 then
		send()
		return
	end
	sendQueued = true
	task.delay(wait, function()
		sendQueued = false
		send()
	end)
end

function Prefs.set(key: string, value: any)
	start()
	if key == "seenPrestige" or not valid(key, value) or (current :: any)[key] == value then return end
	(current :: any)[key] = value
	Prefs.changed:Fire(key)
	queueSend()
end

-- has this layer's first prestige already played its big moment on this account?
function Prefs.seen(layer: string): boolean
	start()
	return table.find(current.seenPrestige, layer) ~= nil
end

-- THE "first prestige?" decision (sound now, the VFX pass later): true the first time this layer prestiges on this
-- account, and it is remembered at once. Ask once per prestige and hand the answer to everything that plays it.
function Prefs.claimFirstPrestige(layer: string): boolean
	start()
	if Prefs.seen(layer) or not string.match(layer, "^%l+$") or #layer > 4 then return false end
	Prefs.markSeen(layer)
	return true
end

-- remember that it has (the oldest entry goes once the list is full)
function Prefs.markSeen(layer: string)
	start()
	if Prefs.seen(layer) or not string.match(layer, "^%l+$") or #layer > 4 then return end
	local list = table.clone(current.seenPrestige)
	table.insert(list, layer)
	while #list > Schema.MAX_SEEN do table.remove(list, 1) end
	current.seenPrestige = list
	Prefs.changed:Fire("seenPrestige")
	queueSend()
end

return Prefs
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">Preload</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Preload: every image (and the fonts) the client draws, fetched behind the loading screen so the realm, the UI kit
	and the node gems are on the GPU when the screen fades, instead of popping in one by one.

	    local list = Preload.list(view:images())   the map's own tiles first, then the UI kit, the node atlas, the
	                                               sprite atlas, the Shop icons and one label per font face; deduped
	    Preload.run(list, function(done, total) ... end)   yields until every batch is back or the timeout (~20 s)

	ContentProvider:PreloadAsync runs in batches, side by side, each in its own pcall: a batch that errors counts as
	fetched (the image then loads when it shows, as before), and one that never returns cannot hold the game past
	the timeout. The progress counts each asset once, from PreloadAsync's per-asset callback and a batch's return.
]]

local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(script.Parent:WaitForChild("Theme"))

local Preload = {}

Preload.BATCH = 8 -- assets per PreloadAsync call
Preload.TIMEOUT = 20 -- seconds before the game goes on without what has not arrived
local POLL = 0.05

export type Options = { batch: number?, timeout: number? }

-- ReplicatedStorage.MilestoneTree.<name>, or nil (a module that fails to load never stops the preload)
local function shared(name: string): any
	local ok, m = pcall(function(): any
		local folder = ReplicatedStorage:WaitForChild("MilestoneTree", 10) :: Instance
		return require(folder:WaitForChild(name, 5) :: ModuleScript) :: any
	end)
	return if ok and type(m) == "table" then m else nil
end

local function isId(v: any): boolean
	return type(v) == "string" and v ~= "" and string.find(v, "^rbx") ~= nil
end

-- the images the client draws beside the map's tiles: the UI kit, the node atlas, the UI sprite atlas and textures of
-- the tier in use, the Shop's pass / product icons
function Preload.images(tier: string?): { string }
	local out: { string } = {}
	local function add(v: any)
		if isId(v) then table.insert(out, v :: string) end
	end
	local uiKit = shared("UiKit")
	if uiKit then add(uiKit.id) end
	local nodeAtlas = shared("NodeAtlas")
	if nodeAtlas then add(nodeAtlas.id) end
	local assets = shared("Assets")
	local t = if tier == "LOW" then "LOW" else "HIGH"
	if assets then
		local sp = assets.sprites
		if type(sp) == "table" and type(sp.atlas) == "table" then add(sp.atlas[t]) end
		local ui = assets.ui
		if type(ui) == "table" then
			if type(ui.atlas) == "table" then add(ui.atlas[t]) end
			if type(ui.textures) == "table" then
				for _, tex in ui.textures do
					if type(tex) == "table" then add(tex.id) end
				end
			end
		end
	end
	local products = shared("Products")
	if products then
		for _, group in { products.passes, products.products } do
			if type(group) == "table" then
				for _, item in group do
					if type(item) == "table" and type(item.icon) == "number" then add("rbxassetid://" .. tostring(item.icon)) end
				end
			end
		end
	end
	return out
end

-- one unparented TextLabel per font face of Theme's type roles: PreloadAsync fetches a label's FontFace
function Preload.fonts(): { Instance }
	local out: { Instance } = {}
	local seen: { [string]: true } = {}
	local names: { string } = {}
	for name in Theme.ROLES do table.insert(names, name) end
	table.sort(names)
	for _, name in names do
		local f = Theme.font(name)
		local k = string.format("%s|%s|%s", tostring(f.Family), tostring(f.Weight), tostring(f.Style))
		if not seen[k] then
			seen[k] = true
			local l = Instance.new("TextLabel")
			l.Name = "Preload_" .. name
			l.FontFace = f
			l.Text = "Aa"
			table.insert(out, l)
		end
	end
	return out
end

-- the whole list, deduped, in order: `first` (the map's tiles, farthest layers first), the other images, the fonts
function Preload.list(first: { string }?, tier: string?): { any }
	local out: { any } = {}
	local seen: { [string]: true } = {}
	local function add(id: string)
		if seen[id] then return end
		seen[id] = true
		table.insert(out, id)
	end
	if first then
		for _, id in first do
			if isId(id) then add(id) end
		end
	end
	for _, id in Preload.images(tier) do add(id) end
	for _, l in Preload.fonts() do table.insert(out, l) end
	return out
end

-- PreloadAsync on `list` in batches (yields); onProgress(done, total) after each asset. Returns done, total and
-- whether it gave up at the timeout.
function Preload.run(list: { any }, onProgress: ((done: number, total: number) -> ())?, opts: Options?): (number, number, boolean)
	local total = #list
	if total == 0 then
		if onProgress then onProgress(0, 0) end
		return 0, 0, false
	end
	local size = math.max(1, (opts and opts.batch) or Preload.BATCH)
	local deadline = os.clock() + ((opts and opts.timeout) or Preload.TIMEOUT)
	local done = 0
	local running = 0
	local over = false
	local function report()
		if onProgress and not over then onProgress(math.min(done, total), total) end
	end
	for i = 1, total, size do
		local batch: { any } = table.move(list, i, math.min(i + size - 1, total), 1, {})
		running += 1
		task.spawn(function()
			local got = 0
			pcall(function()
				ContentProvider:PreloadAsync(batch, function()
					-- an Instance may call back once per content id it holds: never count past the batch
					if got >= #batch then return end
					got += 1
					done += 1
					report()
				end)
			end)
			-- back (or failed): whatever the callback did not count is settled now
			if got < #batch then
				done += #batch - got
				got = #batch
				report()
			end
			running -= 1
		end)
	end
	while running > 0 and os.clock() < deadline do
		task.wait(POLL)
	end
	over = true
	return math.min(done, total), total, running > 0
end

return Preload
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">Recipes</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Recipes: the construction recipes R1-R14 of DESIGN.md 13.2. Every builder is idempotent (children are
	get-or-create by name and every property it owns is written on each call), and every one reads Theme.caps and
	falls back when an engine feature is missing (UIShadow, Radial / Conical gradients, TileMode, Path2D) or a sprite
	is not uploaded (Sprites).

	    R1 bevel   R2 glow   R3 title   R4 number   R5 shine   R6 ring   R7 radial
	    R8 dashed  R9 tile   R10 glass  R11 curve   R12 glitch R13 hold  R14 scrim

	Text recipes (R3, R4, R12) keep the text on the label itself (transparent, so its TextBounds and AutomaticSize
	still work) and draw it with child labels: a hard shadow, then the fill with its gradient and stroke. Children
	draw above their parent, so this is how a shadow can sit behind the text. Set the text through the recipe (or the
	label's Text: the children follow it).
]]

local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Theme = require(script.Parent:WaitForChild("Theme"))
local Motion = require(script.Parent:WaitForChild("Motion"))
local Sprites = require(script.Parent:WaitForChild("Sprites"))
local Layout = require(script.Parent:WaitForChild("Layout"))

type Handle = Types.Handle
type ARect = Types.Rect

local Recipes = {}

-- set by App: false while the map is gliding or pinching (DESIGN.md 3.4 hold safety)
Recipes.holdGate = nil :: (() -> boolean)?

local child = Sprites.child
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

local function remove(parent: Instance, name: string)
	local c = parent:FindFirstChild(name)
	if c then c:Destroy() end
end
local function corner(f: GuiObject, r: UDim)
	local c = child(f, "Corner", "UICorner") :: UICorner
	c.CornerRadius = r
end
local function seq3(a: Color3, b: Color3, c: Color3): ColorSequence
	return ColorSequence.new({ ColorSequenceKeypoint.new(0, a), ColorSequenceKeypoint.new(0.5, b), ColorSequenceKeypoint.new(1, c) })
end
local function seq2(a: Color3, b: Color3): ColorSequence
	return ColorSequence.new({ ColorSequenceKeypoint.new(0, a), ColorSequenceKeypoint.new(1, b) })
end
local function nseq(points: { { number } }): NumberSequence
	local k = {}
	for _, p in points do table.insert(k, NumberSequenceKeypoint.new(p[1], math.clamp(p[2], 0, 1))) end
	return NumberSequence.new(k)
end

-- one connection per (object, purpose), replaced on each call
local conns: { [Instance]: { [string]: RBXScriptConnection } } = setmetatable({}, { __mode = "k" }) :: any
local function hook(inst: Instance, purpose: string, c: RBXScriptConnection)
	local t = conns[inst]
	if t == nil then
		t = {}
		conns[inst] = t
	end
	local tt = t :: { [string]: RBXScriptConnection }
	local old = tt[purpose]
	if old then old:Disconnect() end
	tt[purpose] = c
end

-- ------------------------------------------------------------------------------------------------------ R1 bevel
export type BevelOpts = { radius: number, top: Color3, mid: Color3, bottom: Color3, stroke: number?, strokeFrom: Color3?,
	strokeTo: Color3?, sprite: string? }
-- Sleek: bevels are square (no radius, no lip sprite); the gradient and rim stay
function Recipes.bevel(f: GuiObject, o: BevelOpts)
	remove(f, "Corner")
	f.BackgroundColor3 = WHITE
	if f.BackgroundTransparency >= 1 then f.BackgroundTransparency = 0 end
	f.BorderSizePixel = 0
	local g = child(f, "Fill", "UIGradient") :: UIGradient
	g.Rotation = 90
	g.Color = seq3(o.top, o.mid, o.bottom)
	if o.stroke and o.stroke > 0 then
		local s = child(f, "Rim", "UIStroke") :: UIStroke
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		s.LineJoinMode = Enum.LineJoinMode.Miter
		s.Thickness = math.min(o.stroke, 1.5)
		s.Color = WHITE
		s.Transparency = 0
		local sg = child(s, "RimGradient", "UIGradient") :: UIGradient
		sg.Rotation = 90
		sg.Color = seq2(o.strokeFrom or Theme.lift(o.mid, 0.3), o.strokeTo or Theme.shade(o.mid, 0.6))
	else
		remove(f, "Rim")
	end
	-- a 1 du light top edge instead of the lip sprite
	remove(f, "Bevel")
	local e = child(f, "Edge", "Frame") :: Frame
	e.Size = UDim2.new(1, 0, 0, 1)
	e.Position = UDim2.new()
	e.BackgroundColor3 = WHITE
	e.BackgroundTransparency = 0.6
	e.BorderSizePixel = 0
	e.ZIndex = 8
	e.Active = false
end

-- ------------------------------------------------------------------------------------------------------ R2 glow
export type GlowOpts = { color: Color3, alpha: number, blur: number?, spread: number?, shape: string? }
function Recipes.glow(target: GuiObject, o: GlowOpts): Instance?
	local blur = o.blur or 16
	local spread = o.spread or 0
	local key = target.Name .. "_Glow"
	if Theme.caps.UIShadow then
		local parent = target.Parent
		if parent then remove(parent, key) end
		local s = child(target, "Glow", "UIShadow") :: UIShadow
		local ok = pcall(function()
			s.Color = o.color
			s.Transparency = 1 - o.alpha
			s.BlurRadius = UDim.new(0, blur)
			s.Spread = UDim2.fromOffset(spread, spread)
			s.Offset = UDim2.new()
		end)
		if ok then return s end
		s:Destroy()
	end
	remove(target, "Glow")
	local parent = target.Parent
	if parent == nil then return nil end
	if not Theme.caps.Radial and not Sprites.has("glow_rr") then
		remove(parent, key)
		return nil
	end
	local shape = if o.shape == "circle" then "glow_circle" else "glow_rr"
	local l = Sprites.image(shape, parent, { tint = o.color, alpha = o.alpha, key = key })
	local function sync()
		local a = target.AnchorPoint
		local pad = blur + spread
		l.AnchorPoint = a
		l.Position = target.Position + UDim2.fromOffset((2 * a.X - 1) * pad, (2 * a.Y - 1) * pad)
		l.Size = target.Size + UDim2.fromOffset(2 * pad, 2 * pad)
		l.Visible = target.Visible
		l.ZIndex = math.max(0, target.ZIndex - 1)
		l.LayoutOrder = target.LayoutOrder
	end
	sync()
	Sprites.slice(shape, l, blur / 16)
	hook(target, "glowPos", target:GetPropertyChangedSignal("Position"):Connect(sync))
	hook(target, "glowSize", target:GetPropertyChangedSignal("Size"):Connect(sync))
	hook(target, "glowVis", target:GetPropertyChangedSignal("Visible"):Connect(sync))
	hook(target, "glowGone", target.Destroying:Connect(function() l:Destroy() end))
	return l
end

-- ------------------------------------------------------------------------------------------------------ R3 / R4 text
local TEXT_PROPS = { "TextXAlignment", "TextYAlignment", "TextWrapped", "RichText", "TextTruncate", "LineHeight" }
local function textChild(l: TextLabel, name: string, z: number): TextLabel
	local c = child(l, name, "TextLabel") :: TextLabel
	c.BackgroundTransparency = 1
	c.BorderSizePixel = 0
	c.Size = UDim2.fromScale(1, 1)
	c.ZIndex = z
	c.Active = false
	c.Text = l.Text
	c.FontFace = l.FontFace
	c.TextSize = l.TextSize
	for _, p in TEXT_PROPS do
		pcall(function() (c :: any)[p] = (l :: any)[p] end)
	end
	return c
end
local function follow(l: TextLabel, names: { string })
	local function copy()
		for _, n in names do
			local c = l:FindFirstChild(n)
			if c and c:IsA("TextLabel") then
				c.Text = l.Text
				c.TextSize = l.TextSize
				c.FontFace = l.FontFace
			end
		end
	end
	hook(l, "textFollow", l:GetPropertyChangedSignal("Text"):Connect(copy))
	hook(l, "sizeFollow", l:GetPropertyChangedSignal("TextSize"):Connect(copy))
end
-- italic overhang: ceil(.1 x size) of right padding (DESIGN.md 9.1)
local function italicPad(c: TextLabel, italic: boolean)
	if italic then
		local p = child(c, "Overhang", "UIPadding") :: UIPadding
		p.PaddingRight = UDim.new(0, math.ceil(0.1 * c.TextSize))
	else
		remove(c, "Overhang")
	end
end
local function strokeOn(c: TextLabel, thickness: number)
	if thickness > 0 then
		local s = child(c, "Stroke", "UIStroke") :: UIStroke
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		s.LineJoinMode = Enum.LineJoinMode.Round
		s.Color = BLACK
		s.Thickness = thickness
		s.Transparency = 0
	else
		remove(c, "Stroke")
	end
end

export type TitleOpts = { text: string, role: string, from: Color3?, to: Color3?, stroke: number, shadow: number, size: number? }
-- R3: white (or gradient) heavy text, black contextual stroke, hard shadow clone. Display roles only (DESIGN.md 9.2):
-- card / cardSmall titles use it with stroke = 0 and shadow = 0 (no outline under 18 du)
function Recipes.title(l: TextLabel, o: TitleOpts)
	local r = Theme.ROLES[o.role]
	l.FontFace = Theme.font(o.role)
	l.TextSize = o.size or Theme.size(o.role)
	l.LineHeight = Theme.lineHeight(o.role)
	l.Text = o.text
	l.TextTransparency = 1
	l.BackgroundTransparency = 1
	l.TextStrokeTransparency = 1
	local italic = r ~= nil and r.italic
	local shadow = textChild(l, "Shadow", 1)
	shadow.Position = UDim2.fromOffset(0, o.shadow)
	shadow.TextColor3 = BLACK
	shadow.TextTransparency = if o.shadow > 0 then 0.25 else 1
	italicPad(shadow, italic)
	strokeOn(shadow, if o.shadow > 0 then o.stroke else 0)
	local fill = textChild(l, "Fill", 2)
	fill.Position = UDim2.new()
	fill.TextColor3 = WHITE
	fill.TextTransparency = 0
	italicPad(fill, italic)
	strokeOn(fill, o.stroke)
	if o.from or o.to then
		local g = child(fill, "Grad", "UIGradient") :: UIGradient
		g.Rotation = 90
		g.Color = seq2(o.from or WHITE, o.to or WHITE)
	else
		remove(fill, "Grad")
	end
	follow(l, { "Shadow", "Fill" })
end

export type NumberOpts = { text: string, size: number, from: Color3, mid: Color3?, to: Color3, stroke: number, shadow: number,
	glow: Color3?, role: string? }
-- R4: Sarpanch Heavy with a gradient, stroke and shadow; the glow is a soft blob behind the text bounds (never
-- UIShadow on text)
function Recipes.number(l: TextLabel, o: NumberOpts)
	l.FontFace = Theme.font(o.role or "hero")
	l.TextSize = o.size
	l.LineHeight = Theme.lineHeight(o.role or "hero")
	l.Text = o.text
	l.TextTransparency = 1
	l.BackgroundTransparency = 1
	local shadow = textChild(l, "Shadow", 1)
	shadow.Position = UDim2.fromOffset(0, o.shadow)
	shadow.TextColor3 = BLACK
	shadow.TextTransparency = if o.shadow > 0 then 0.2 else 1
	strokeOn(shadow, if o.shadow > 0 then o.stroke else 0)
	local fill = textChild(l, "Fill", 2)
	fill.Position = UDim2.new()
	fill.TextColor3 = WHITE
	fill.TextTransparency = 0
	strokeOn(fill, o.stroke)
	local g = child(fill, "Grad", "UIGradient") :: UIGradient
	g.Rotation = 90
	g.Color = if o.mid then seq3(o.from, o.mid, o.to) else seq2(o.from, o.to)
	follow(l, { "Shadow", "Fill" })
	if o.glow then
		local b = math.max(8, o.size * 0.35)
		local glow = Sprites.image("glow_rr", l, { tint = o.glow, alpha = 0.45, key = "Glow" })
		glow.ZIndex = 0
		local function place()
			local tb = l.TextBounds
			local xa = l.TextXAlignment
			local ax = if xa == Enum.TextXAlignment.Left then 0 elseif xa == Enum.TextXAlignment.Right then 1 else 0.5
			glow.AnchorPoint = Vector2.new(ax, 0.5)
			glow.Position = UDim2.new(ax, (2 * ax - 1) * b, 0.5, 0)
			glow.Size = UDim2.fromOffset(tb.X + 2 * b, tb.Y + 2 * b)
		end
		place()
		Sprites.slice("glow_rr", glow, b / 16)
		hook(l, "glowBounds", l:GetPropertyChangedSignal("TextBounds"):Connect(place))
	else
		remove(l, "Glow")
	end
end

-- ------------------------------------------------------------------------------------------------------ R5 shine
-- a soft white band sweeping across the object every `every` seconds (none with reduced motion)
function Recipes.shine(f: GuiObject, o: { every: number?, dur: number? }?): Handle
	local every = (o and o.every) or 2.8
	local dur = (o and o.dur) or 0.9
	local band = child(f, "Shine", "Frame") :: Frame
	band.Size = UDim2.fromScale(1, 1)
	band.BackgroundColor3 = WHITE
	band.BackgroundTransparency = 0
	band.BorderSizePixel = 0
	band.ZIndex = 9
	band.Active = false
	local pc = f:FindFirstChildWhichIsA("UICorner")
	local bc = child(band, "Corner", "UICorner") :: UICorner
	bc.CornerRadius = if pc then pc.CornerRadius else UDim.new(0, 0)
	local g = child(band, "Sweep", "UIGradient") :: UIGradient
	g.Rotation = 105
	g.Transparency = nseq({ { 0, 1 }, { 0.5, 0.72 }, { 1, 1 } })
	g.Offset = Vector2.new(-1, 0)
	local alive = true
	local h = {} :: Handle
	function h.stop(_: Handle)
		alive = false
		g.Offset = Vector2.new(-1, 0)
	end
	task.spawn(function()
		task.wait(math.random() * every)
		while alive and band.Parent ~= nil do
			if not Motion.reduced() and f.Visible then
				g.Offset = Vector2.new(-1, 0)
				Motion.tween(g, TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Offset = Vector2.new(1, 0) })
			end
			task.wait(every)
		end
	end)
	return h
end

-- ------------------------------------------------------------------------------------------------------ R6 ring
export type Ring = { frame: Frame, set: (self: Ring, p: number) -> (), setColor: (self: Ring, c: Color3) -> (), destroy: (self: Ring) -> () }
local SEGMENTS = 24
-- a progress ring: a stroked circle whose Conical gradient hides the part past p; without Conical, 24 dots
function Recipes.ring(parent: GuiObject, o: { size: number, thick: number, color: Color3, track: number? }): Ring
	local f = child(parent, "Ring", "Frame") :: Frame
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(0.5, 0.5)
	f.Size = UDim2.fromOffset(o.size, o.size)
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Active = false
	f.ZIndex = 6
	corner(f, UDim.new(0.5, 0))
	local ring = {} :: Ring
	ring.frame = f
	local p = 0
	if Theme.caps.Conical then
		remove(f, "Dots")
		local track = child(f, "Track", "UIStroke") :: UIStroke
		track.Thickness = o.thick
		track.Color = o.color
		track.Transparency = o.track or 0.82
		track.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		local arcFrame = child(f, "Arc", "Frame") :: Frame
		arcFrame.Size = UDim2.fromScale(1, 1)
		arcFrame.BackgroundTransparency = 1
		arcFrame.Active = false
		local ac = child(arcFrame, "Corner", "UICorner") :: UICorner
		ac.CornerRadius = UDim.new(0.5, 0)
		local arc = child(arcFrame, "Stroke", "UIStroke") :: UIStroke
		arc.Thickness = o.thick
		arc.Color = o.color
		arc.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		local g = child(arc, "Sweep", "UIGradient") :: UIGradient
		g.Type = Enum.GradientType.Conical
		local function draw()
			if p <= 0.001 then
				arc.Transparency = 1
			elseif p >= 0.999 then
				arc.Transparency = 0
				g.Transparency = NumberSequence.new(0)
			else
				arc.Transparency = 0
				g.Transparency = nseq({ { 0, 0 }, { p, 0 }, { math.min(0.999, p + 0.001), 1 }, { 1, 1 } })
			end
		end
		function ring.set(_: Ring, v: number)
			p = math.clamp(v, 0, 1)
			draw()
		end
		function ring.setColor(_: Ring, c: Color3)
			track.Color = c
			arc.Color = c
		end
		draw()
	else
		remove(f, "Track")
		remove(f, "Arc")
		local holder = child(f, "Dots", "Frame") :: Frame
		holder.Size = UDim2.fromScale(1, 1)
		holder.BackgroundTransparency = 1
		holder.Active = false
		local dots: { Frame } = {}
		local d = math.max(3, o.thick * 1.4)
		for i = 1, SEGMENTS do
			local a = (i - 0.5) / SEGMENTS * 2 * math.pi
			local dot = child(holder, "Dot" .. i, "Frame") :: Frame
			dot.AnchorPoint = Vector2.new(0.5, 0.5)
			dot.Position = UDim2.fromScale(0.5 + 0.5 * math.sin(a), 0.5 - 0.5 * math.cos(a))
			dot.Size = UDim2.fromOffset(d, d)
			dot.BackgroundColor3 = o.color
			dot.BorderSizePixel = 0
			dot.Active = false
			local dc = child(dot, "Corner", "UICorner") :: UICorner
			dc.CornerRadius = UDim.new(0.5, 0)
			dots[i] = dot
		end
		local trackA = o.track or 0.82
		local function draw()
			for i, dot in dots do
				dot.BackgroundTransparency = if (i - 0.5) / SEGMENTS <= p then 0 else trackA
			end
		end
		function ring.set(_: Ring, v: number)
			p = math.clamp(v, 0, 1)
			draw()
		end
		function ring.setColor(_: Ring, c: Color3)
			for _, dot in dots do dot.BackgroundColor3 = c end
		end
		draw()
	end
	function ring.destroy(_: Ring)
		f:Destroy()
	end
	return ring
end

-- ------------------------------------------------------------------------------------------------------ R7 radial
export type Stop = { t: number, c: Color3, a: number? }
-- a radial gradient on the frame's background (gem, aura, vignette, glow blob); without Radial, a soft flat disc
function Recipes.radial(f: GuiObject, stops: { Stop })
	local list = table.clone(stops)
	table.sort(list, function(x: Stop, y: Stop) return x.t < y.t end)
	if #list == 0 then list = { { t = 0, c = WHITE, a = 1 } } end
	if list[1].t > 0 then table.insert(list, 1, { t = 0, c = list[1].c, a = list[1].a }) end
	if list[#list].t < 1 then table.insert(list, { t = 1, c = list[#list].c, a = list[#list].a }) end
	f.BorderSizePixel = 0
	if Theme.caps.Radial then
		f.BackgroundColor3 = WHITE
		f.BackgroundTransparency = 0
		local g = child(f, "Radial", "UIGradient") :: UIGradient
		g.Type = Enum.GradientType.Radial
		local ck, tk = {}, {}
		local last = -1
		for _, s in list do
			local t = math.clamp(s.t, 0, 1)
			if t <= last then t = math.min(1, last + 0.0001) end
			if t <= last then continue end
			last = t
			table.insert(ck, ColorSequenceKeypoint.new(t, s.c))
			table.insert(tk, NumberSequenceKeypoint.new(t, 1 - math.clamp(if s.a ~= nil then s.a else 1, 0, 1)))
		end
		if #ck >= 2 then
			g.Color = ColorSequence.new(ck)
			g.Transparency = NumberSequence.new(tk)
		end
	else
		remove(f, "Radial")
		local inner = list[1]
		f.BackgroundColor3 = inner.c
		f.BackgroundTransparency = 1 - math.clamp((if inner.a ~= nil then inner.a else 1) * 0.55, 0, 1)
		corner(f, UDim.new(0.5, 0))
	end
end

-- ------------------------------------------------------------------------------------------------------ R8 dashed
-- a dashed rim on a stroke; without TileMode a solid stroke at alpha .7
function Recipes.dashed(stroke: UIStroke, o: { color: Color3, alpha: number? })
	local alpha = o.alpha or 1
	stroke.Color = o.color
	if Theme.caps.TileMode then
		stroke.Transparency = 1 - alpha
		local g = child(stroke, "Dash", "UIGradient") :: UIGradient
		g.Rotation = 45
		g.TileMode = Enum.GradientTileMode.Repeat
		g.Scale = 0.08
		g.Transparency = nseq({ { 0, 0 }, { 0.62, 0 }, { 0.63, 1 }, { 1, 1 } })
	else
		remove(stroke, "Dash")
		stroke.Transparency = 1 - alpha * 0.7
	end
end

-- ------------------------------------------------------------------------------------------------------ R9 tile
-- a tiled standalone texture (scanlines, stripes, grid, wave); nil (and nothing drawn) when it is not uploaded
function Recipes.tile(parent: GuiObject, texture: string, o: { alpha: number, tile: number?, tileH: number?, color: Color3? }): ImageLabel?
	local key = "Tex_" .. texture
	local id = Sprites.texture(texture)
	if id == nil then
		remove(parent, key)
		return nil
	end
	local l = child(parent, key, "ImageLabel") :: ImageLabel
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Active = false
	l.Image = id
	l.ScaleType = Enum.ScaleType.Tile
	local tw = o.tile or 32
	l.TileSize = UDim2.fromOffset(tw, o.tileH or tw)
	l.ImageTransparency = 1 - o.alpha
	l.ImageColor3 = o.color or WHITE
	return l
end

-- ------------------------------------------------------------------------------------------------------ R10 glass
-- the HUD glass: a dark translucent fill and a faint white rim (Roblox has no backdrop blur)
function Recipes.glass(f: GuiObject)
	local pt = 1
	pcall(function() pt = GuiService.PreferredTransparency end)
	f.BackgroundColor3 = Theme.C.glass
	f.BackgroundTransparency = math.clamp(0.14 * pt, 0, 1)
	f.BorderSizePixel = 0
	local s = child(f, "GlassRim", "UIStroke") :: UIStroke
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.LineJoinMode = Enum.LineJoinMode.Miter
	s.Color = WHITE
	s.Thickness = 1
	s.Transparency = 0.86
	-- Sleek: square slabs
	local c = f:FindFirstChildWhichIsA("UICorner")
	if c and c.CornerRadius.Scale < 0.5 then c:Destroy() end
end

-- ------------------------------------------------------------------------------------------------------ R11 curve
export type CurveStroke = { c: Color3, a: number, w: number }
export type Curve = {
	parts: { Instance },
	setWidths: (self: Curve, widths: { number }) -> (),
	setColors: (self: Curve, strokes: { CurveStroke }) -> (),
	setVisible: (self: Curve, v: boolean) -> (),
	destroy: (self: Curve) -> (),
}
-- A glowing curve: one Path2D per stroke (halo, glow, core, hot) through cubic Bezier segments. pts are 4 points per
-- cubic in the parent's space (o.space, default the 3840 x 2560 world), written in Scale units of the parent.
-- Without Path2D: 24 rotated thin frames along the curve, drawn with the brightest stroke.
function Recipes.curve(parent: GuiObject, pts: { Vector2 }, strokes: { CurveStroke }, o: { name: string?, space: Vector2?, z: number? }?): Curve
	local name = (o and o.name) or "Curve"
	local space = (o and o.space) or Vector2.new(3840, 2560)
	local z0 = (o and o.z) or 1
	local function toScale(p: Vector2): UDim2
		return UDim2.fromScale(p.X / space.X, p.Y / space.Y)
	end
	local curve = {} :: Curve
	curve.parts = {}
	if Theme.caps.Path2D then
		remove(parent, name .. "_Seg")
		-- control points: every cubic endpoint once, tangents to its handles
		local cps = {}
		local n = math.floor(#pts / 4)
		for i = 0, n - 1 do
			local p0, p1, p2, p3 = pts[i * 4 + 1], pts[i * 4 + 2], pts[i * 4 + 3], pts[i * 4 + 4]
			if i == 0 then
				table.insert(cps, { pos = p0, left = Vector2.zero, right = p1 - p0 })
			else
				cps[#cps].right = p1 - p0
			end
			table.insert(cps, { pos = p3, left = p2 - p3, right = Vector2.zero })
		end
		local list = {}
		for _, c in cps do
			table.insert(list, Path2DControlPoint.new(toScale(c.pos), toScale(c.left), toScale(c.right)))
		end
		for k, s in strokes do
			local path = child(parent, name .. "_" .. k, "Path2D") :: Path2D
			path:SetControlPoints(list)
			path.Color3 = s.c
			path.Transparency = 1 - s.a
			path.Thickness = s.w
			path.ZIndex = z0 + k - 1
			curve.parts[k] = path
		end
		function curve.setWidths(_: Curve, widths: { number })
			for k, w in widths do
				local p = curve.parts[k]
				if p then (p :: Path2D).Thickness = w end
			end
		end
		function curve.setColors(_: Curve, s2: { CurveStroke })
			for k, s in s2 do
				local p = curve.parts[k]
				if p then
					pcall(function()
						(p :: Path2D).Color3 = s.c;
						(p :: Path2D).Transparency = 1 - s.a
					end)
				end
			end
		end
		function curve.setVisible(_: Curve, v: boolean)
			for _, p in curve.parts do (p :: Path2D).Visible = v end
		end
	else
		-- the brightest stroke, as straight segments
		local best = 1
		for k, s in strokes do
			if s.a > strokes[best].a then best = k end
		end
		local holder = child(parent, name .. "_Seg", "Frame") :: Frame
		holder.Size = UDim2.fromScale(1, 1)
		holder.BackgroundTransparency = 1
		holder.Active = false
		holder.ZIndex = z0
		local samples = {}
		local n = math.floor(#pts / 4)
		local per = math.max(1, math.floor(24 / math.max(1, n)))
		for i = 0, n - 1 do
			local p0, p1, p2, p3 = pts[i * 4 + 1], pts[i * 4 + 2], pts[i * 4 + 3], pts[i * 4 + 4]
			for j = (if i == 0 then 0 else 1), per do
				local t = j / per
				local u = 1 - t
				table.insert(samples, p0 * (u * u * u) + p1 * (3 * u * u * t) + p2 * (3 * u * t * t) + p3 * (t * t * t))
			end
		end
		local segs: { Frame } = {}
		for i = 1, #samples - 1 do
			local a, b = samples[i], samples[i + 1]
			local d = b - a
			local seg = child(holder, "S" .. i, "Frame") :: Frame
			seg.AnchorPoint = Vector2.new(0.5, 0.5)
			seg.Position = toScale((a + b) / 2)
			seg.Size = UDim2.new(d.Magnitude / space.X, 1, 0, strokes[best].w)
			seg.Rotation = math.deg(math.atan2(d.Y, d.X))
			seg.BackgroundColor3 = strokes[best].c
			seg.BackgroundTransparency = 1 - strokes[best].a
			seg.BorderSizePixel = 0
			seg.Active = false
			segs[i] = seg
		end
		curve.parts = { holder }
		function curve.setWidths(_: Curve, widths: { number })
			local w = widths[best]
			if w == nil then return end
			for _, seg in segs do seg.Size = UDim2.new(seg.Size.X.Scale, 1, 0, w) end
		end
		function curve.setColors(_: Curve, s2: { CurveStroke })
			local s = s2[best]
			if s == nil then return end
			for _, seg in segs do
				seg.BackgroundColor3 = s.c
				seg.BackgroundTransparency = 1 - s.a
			end
		end
		function curve.setVisible(_: Curve, v: boolean)
			holder.Visible = v
		end
	end
	function curve.destroy(_: Curve)
		for _, p in curve.parts do p:Destroy() end
		table.clear(curve.parts)
	end
	return curve
end

-- ------------------------------------------------------------------------------------------------------ R12 glitch
-- glitch text: white text over a crimson and a cyan clone; the clones jump for 60-140 ms every min..max seconds
function Recipes.glitch(l: TextLabel, o: { min: number, max: number }): Handle
	l.TextTransparency = 1
	l.BackgroundTransparency = 1
	local a = textChild(l, "GlitchA", 1)
	a.TextColor3 = Color3.fromHex("ff2e63")
	a.TextTransparency = 0.3
	a.Position = UDim2.fromOffset(-2, 0)
	local b = textChild(l, "GlitchB", 2)
	b.TextColor3 = Color3.fromHex("2ee6ff")
	b.TextTransparency = 0.45
	b.Position = UDim2.fromOffset(2, 0)
	local main = textChild(l, "Fill", 3)
	main.TextColor3 = WHITE
	main.TextTransparency = 0
	main.Position = UDim2.new()
	follow(l, { "GlitchA", "GlitchB", "Fill" })
	local alive = true
	local h = {} :: Handle
	function h.stop(_: Handle)
		alive = false
		a.Position = UDim2.fromOffset(-2, 0)
		b.Position = UDim2.fromOffset(2, 0)
	end
	task.spawn(function()
		while alive and l.Parent ~= nil do
			task.wait(o.min + math.random() * math.max(0, o.max - o.min))
			if not alive or not l.Parent then break end
			if Motion.reduced() or not l.Visible then continue end
			local dx = 2 + math.random() * 2
			a.Position = UDim2.fromOffset(-2 - dx, math.random(-1, 1))
			b.Position = UDim2.fromOffset(2 + dx, math.random(-1, 1))
			task.wait(0.06 + math.random() * 0.08)
			a.Position = UDim2.fromOffset(-2, 0)
			b.Position = UDim2.fromOffset(2, 0)
		end
	end)
	return h
end

-- ------------------------------------------------------------------------------------------------------ R13 hold
export type Hold = {
	progress: number,
	holding: boolean,
	pressed: boolean, -- a finger or the mouse is down on it (a hold may be about to start)
	consumed: (self: Hold) -> boolean, -- the last press became a hold or moved: the owner skips its Activated
	cancel: (self: Hold) -> (),
	destroy: (self: Hold) -> (),
}
Recipes.HOLD_DELAY = 0.12
Recipes.HOLD_SLOP = 10
-- A hold button (DESIGN.md 3.4): the fill starts after 120 ms with less than 10 pt of movement, never while the map
-- glides or pinches (Recipes.holdGate), cancels on more movement or a scroll, rewinds in 0.12 s when released
-- early, and calls onDone once it is full. The fill is a ring (o.ring) or a bar growing from the left.
function Recipes.hold(b: GuiButton, o: { dur: number, ring: boolean?, onDone: () -> (), label: TextLabel?, color: Color3? }): Hold
	local color = o.color or WHITE
	local ring: Ring? = nil
	local bar: Frame? = nil
	if o.ring then
		local size = math.max(24, math.min(b.AbsoluteSize.X, b.AbsoluteSize.Y))
		ring = Recipes.ring(b, { size = size, thick = math.max(3, size * 0.08), color = color, track = 1 })
		remove(b, "HoldFill")
	else
		remove(b, "Ring")
		local f = child(b, "HoldFill", "Frame") :: Frame
		f.Size = UDim2.fromScale(0, 1)
		f.BackgroundColor3 = color
		f.BackgroundTransparency = 0.72
		f.BorderSizePixel = 0
		f.Active = false
		f.ZIndex = 0
		local pc = b:FindFirstChildWhichIsA("UICorner")
		local fc = child(f, "Corner", "UICorner") :: UICorner
		fc.CornerRadius = if pc then pc.CornerRadius else UDim.new(0, 0)
		bar = f
	end
	local hold = {} :: Hold
	hold.progress = 0
	hold.holding = false
	hold.pressed = false
	local consumed = false
	local input: InputObject? = nil
	local startPos = Vector2.zero
	local startT = 0
	local scroll: ScrollingFrame? = nil
	local scrollStart = Vector2.zero
	local rewinding = false
	local step: RBXScriptConnection? = nil

	local function draw()
		local p = hold.progress
		if ring then ring:set(p) end
		if bar then bar.Size = UDim2.fromScale(p, 1) end
	end
	local function pointer(): Vector2
		local i = input
		if i and i.UserInputType == Enum.UserInputType.Touch then return Layout.inputToAbs(i.Position) end
		return UserInputService:GetMouseLocation()
	end
	local function stopLoop()
		if step then
			step:Disconnect()
			step = nil
		end
	end
	local function release()
		input = nil
		hold.holding = false
		hold.pressed = false
		if hold.progress > 0 then
			rewinding = true
		else
			stopLoop()
		end
	end
	local function loop(dt: number)
		if input == nil then
			if rewinding then
				hold.progress = math.max(0, hold.progress - dt / 0.12)
				draw()
				if hold.progress <= 0 then
					rewinding = false
					stopLoop()
				end
			else
				stopLoop()
			end
			return
		end
		local moved = (pointer() - startPos).Magnitude
		local scrolled = scroll ~= nil and (scroll.CanvasPosition - scrollStart).Magnitude > 2
		if moved > Recipes.HOLD_SLOP or scrolled then
			consumed = true
			release()
			return
		end
		local held = os.clock() - startT
		if held < Recipes.HOLD_DELAY then return end
		hold.holding = true
		consumed = true
		hold.progress = math.min(1, hold.progress + dt / o.dur)
		draw()
		if hold.progress >= 1 then
			input = nil
			hold.holding = false
			hold.pressed = false
			hold.progress = 0
			draw()
			stopLoop()
			task.spawn(o.onDone)
		end
	end
	local began = b.InputBegan:Connect(function(io: InputObject)
		local t = io.UserInputType
		if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
		if input ~= nil then return end
		consumed = false
		local gate = Recipes.holdGate
		if gate and not gate() then return end
		input = io
		hold.pressed = true
		rewinding = false
		startT = os.clock()
		startPos = pointer()
		local sf = b:FindFirstAncestorWhichIsA("ScrollingFrame")
		scroll = sf
		scrollStart = if sf then sf.CanvasPosition else Vector2.zero
		if step == nil then step = RunService.Heartbeat:Connect(loop) end
	end)
	local ended = UserInputService.InputEnded:Connect(function(io: InputObject)
		if input == nil then return end
		if io == input or (io.UserInputType == Enum.UserInputType.MouseButton1 and (input :: InputObject).UserInputType == Enum.UserInputType.MouseButton1) then
			release()
		end
	end)
	function hold.consumed(_: Hold): boolean
		return consumed
	end
	function hold.cancel(_: Hold)
		release()
	end
	function hold.destroy(_: Hold)
		began:Disconnect()
		ended:Disconnect()
		stopLoop()
		if ring then ring:destroy() end
		if bar then bar:Destroy() end
	end
	draw()
	return hold
end

-- ------------------------------------------------------------------------------------------------------ R14 scrim
export type Scrim = { frame: Frame, setHole: (self: Scrim, hole: ARect?) -> (), destroy: (self: Scrim) -> () }
-- a dark scrim over the parent with a soft round hole over `hole` (abs space); without Radial a plain scrim
function Recipes.scrim(parent: GuiObject, hole: ARect?): Scrim
	local f = child(parent, "Scrim", "Frame") :: Frame
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Active = false
	local parts: { [string]: Frame } = {}
	for _, n in { "Top", "Bottom", "Left", "Right", "Hole" } do
		local p = child(f, n, "Frame") :: Frame
		p.BackgroundColor3 = BLACK
		p.BackgroundTransparency = 0.38
		p.BorderSizePixel = 0
		p.Active = false
		parts[n] = p
	end
	local scrim = {} :: Scrim
	scrim.frame = f
	function scrim.setHole(_: Scrim, r: ARect?)
		local top, bottom, left, right, h = parts.Top, parts.Bottom, parts.Left, parts.Right, parts.Hole
		if r == nil or not Theme.caps.Radial then
			top.Position = UDim2.new()
			top.Size = UDim2.fromScale(1, 1)
			for _, p in { bottom, left, right, h } do p.Visible = false end
			top.Visible = true
			return
		end
		local rr = r :: ARect
		local c = Layout.absToLocal(parent, Vector2.new(rr.x + rr.w / 2, rr.y + rr.h / 2))
		local k = 1
		local off = parent.Size.X.Offset
		if off > 0 and parent.AbsoluteSize.X > 0 then k = parent.AbsoluteSize.X / off end
		local side = math.max(rr.w, rr.h) * 1.6 / k
		local x0, y0 = c.X - side / 2, c.Y - side / 2
		top.Position = UDim2.new()
		top.Size = UDim2.new(1, 0, 0, math.max(0, y0))
		bottom.Position = UDim2.fromOffset(0, y0 + side)
		bottom.Size = UDim2.new(1, 0, 1, -(y0 + side))
		left.Position = UDim2.fromOffset(0, y0)
		left.Size = UDim2.fromOffset(math.max(0, x0), side)
		right.Position = UDim2.fromOffset(x0 + side, y0)
		right.Size = UDim2.new(1, -(x0 + side), 0, side)
		h.Position = UDim2.fromOffset(x0, y0)
		h.Size = UDim2.fromOffset(side, side)
		h.BackgroundTransparency = 0
		local g = child(h, "Hole", "UIGradient") :: UIGradient
		g.Type = Enum.GradientType.Radial
		g.Color = seq2(BLACK, BLACK)
		g.Transparency = nseq({ { 0, 1 }, { 0.45, 1 }, { 1, 0.38 } })
		for _, p in { top, bottom, left, right, h } do p.Visible = true end
	end
	function scrim.destroy(_: Scrim)
		f:Destroy()
	end
	scrim:setHole(hole)
	return scrim
end

return Recipes
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">Rich</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Rich: text helpers (DESIGN.md 9).

	    Rich.caps("ready")                   "R E A D Y" with U+200A hair spaces (Roblox has no letter-spacing)
	    Rich.html(html, 13, "p", preLine)   the game's HTML as RichText, game colours remapped (DESIGN.md 11.2)
	    Rich.fit(label, { 56, 48, 40 }, w)  the first size whose text fits the width (display roles only)
	    Rich.num("+e1.073e25 prestige points", { size = 17 })
	                                         numeral runs stay in the label's Sarpanch face, words and units become a
	                                         Montserrat Bold run, exponent markers dim (DESIGN.md 9.9)
	    Rich.pct(0.4) -> "40%"               0 decimals from 10%, 1 below (DESIGN.md 9.9)
	    Rich.short("+e483,525,689") -> "+e4.84e8"   the short form for narrow chips and pills (DESIGN.md 9.9)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Html = require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("Html"))
local Theme = require(script.Parent:WaitForChild("Theme"))

local Rich = {}

Rich.HAIR = utf8.char(0x200A)
-- switch off if the hair space renders as tofu (plan risk R10): caps then use plain upper case
Rich.useHair = true

-- upper case with a hair space between letters (spaces stay spaces)
function Rich.caps(s: string): string
	local up = string.upper(s)
	if not Rich.useHair then return up end
	local out = {}
	local prevLetter = false
	for _, cp in utf8.codes(up) do
		local ch = utf8.char(cp)
		local letter = ch ~= " " and ch ~= "\n"
		if letter and prevLetter then table.insert(out, Rich.HAIR) end
		table.insert(out, ch)
		prevLetter = letter
	end
	return table.concat(out)
end

-- the game's HTML -> RichText at a base size, with the colour remap of the layer
function Rich.html(html: string?, base: number, layer: string?, preLine: boolean?): string
	return Html.rich(html, base, preLine, Theme.remapper(layer))
end

-- the game's HTML as plain text (tooltips, plates)
function Rich.plain(html: string?): string
	return Html.plain(html)
end

-- step-fit: the first size in `sizes` (largest first) at which the label's text is at most maxW wide
function Rich.fit(l: TextLabel, sizes: { number }, maxW: number)
	for i, size in sizes do
		l.TextSize = size
		if i == #sizes or l.TextBounds.X <= maxW then return end
	end
end

-- ------------------------------------------------------------------------------------------------------ numbers
-- DESIGN.md 9.9: re-typeset a game-formatted number string; format() output is never recomputed
Rich.THIN = utf8.char(0x2009)
-- switch off if the thin space renders as tofu (plan risk R10): units then follow a normal space
Rich.useThin = true
Rich.MONTSERRAT = "rbxasset://fonts/families/Montserrat.json"

local DIGIT0, DIGIT9 = 48, 57
local function isDigit(cp: number?): boolean
	return cp ~= nil and cp >= DIGIT0 and cp <= DIGIT9
end
local function isLetter(cp: number?): boolean
	return cp ~= nil and ((cp >= 65 and cp <= 90) or (cp >= 97 and cp <= 122))
end
local E, PLUS, MINUS, UMINUS, TIMES, DOT, COMMA, PCT, X, CARET, SPACE, SLASH = 101, 43, 45, 0x2212, 0xD7, 46, 44, 37, 120, 94, 32, 47
-- an exponent marker: e followed by a digit, or by a sign and a digit
local function expAt(cps: { number }, i: number): boolean
	if cps[i] ~= E then return false end
	local n = cps[i + 1]
	if isDigit(n) then return true end
	return (n == PLUS or n == MINUS) and isDigit(cps[i + 2])
end
-- a numeral run may start here: a digit, an exponent marker, or a sign / × / ^ in front of one
local function startsNumber(cps: { number }, i: number): boolean
	local c = cps[i]
	if isDigit(c) or expAt(cps, i) then
		-- not inside a word such as "C21", "type2" or the zone id "a-02"
		local prev = cps[i - 1]
		if prev == MINUS and isLetter(cps[i - 2]) then return false end
		return not isLetter(prev) and not isDigit(prev)
	end
	if c == PLUS or c == MINUS or c == UMINUS or c == TIMES or c == CARET then
		local prev = cps[i - 1]
		if isLetter(prev) or isDigit(prev) then return false end -- "a-02" is a word
		return isDigit(cps[i + 1]) or expAt(cps, i + 1)
	end
	return false
end

local function escape(t: string): string
	return (string.gsub(string.gsub(string.gsub(t, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"))
end
local function chars(cps: { number }, a: number, b: number): string
	local out = table.create(b - a + 1)
	for i = a, b do table.insert(out, utf8.char(cps[i])) end
	return table.concat(out)
end

-- percentages: 0 decimals from 10%, 1 below; "100%" only at 1 (have >= need)
function Rich.pct(p: number): string
	if p >= 1 then return "100%" end
	local v = math.max(0, p) * 100
	if v >= 10 then return string.format("%d%%", math.min(99, math.floor(v))) end
	local t = math.floor(v * 10) / 10
	if t == math.floor(t) then return string.format("%d%%", t) end
	return string.format("%.1f%%", t)
end

export type NumOpts = {
	size: number?, -- the label's TextSize: word runs are set at .85 of it (at least the small role's size)
	unit: Color3?, -- word-run colour (default: soft); ignored when onFill
	onFill: boolean?, -- on a bright fill / well: word runs keep the label colour at alpha .8
}
-- a game number string -> RichText (the label keeps its Sarpanch FontFace and RichText = true)
function Rich.num(s: string, o: NumOpts?): string
	local opts: NumOpts = o or {}
	local cps: { number } = {}
	for _, cp in utf8.codes(s) do table.insert(cps, cp) end
	local n = #cps
	local wordOpen: string
	do
		local attrs = { string.format('family="%s" weight="700"', Rich.MONTSERRAT) }
		-- words at .85 of the number, never under the mixed-case floor (the small role's size, DESIGN.md 9.5)
		if opts.size then
			local wsize = math.max(math.floor(opts.size * 0.85 + 0.5), Theme.size("small"))
			table.insert(attrs, string.format('size="%d"', wsize))
		end
		if opts.onFill then
			table.insert(attrs, 'transparency="0.2"')
		else
			table.insert(attrs, string.format('color="#%s"', Theme.toHex(opts.unit or Theme.C.soft)))
		end
		wordOpen = "<font " .. table.concat(attrs, " ") .. ">"
	end
	local out: { string } = {}
	local i = 1
	local afterNumber = false
	while i <= n do
		if startsNumber(cps, i) then
			-- one numeral run
			local a = i
			local j = i
			local parts: { string } = {}
			local plainPct = true
			while j <= n do
				local c = cps[j]
				if isDigit(c) then
					table.insert(parts, utf8.char(c))
				elseif (c == DOT or c == COMMA or c == SLASH) and isDigit(cps[j + 1]) and j > a then
					-- "1,329,005", "6.424", "164/185"
					table.insert(parts, utf8.char(c))
					if c ~= DOT then plainPct = false end
				elseif expAt(cps, j) then
					table.insert(parts, '<font transparency="0.3">e</font>')
					plainPct = false
				elseif j == a and (c == PLUS or c == MINUS or c == UMINUS or c == CARET) then
					table.insert(parts, utf8.char(c))
					plainPct = false
				elseif c == TIMES and (j == a or isDigit(cps[j - 1])) then
					-- "× e2.296e21": a thin space between the sign and an exponent
					table.insert(parts, utf8.char(c))
					if cps[j + 1] == E and Rich.useThin then table.insert(parts, Rich.THIN) end
					plainPct = false
				elseif (c == PCT or c == X) and isDigit(cps[j - 1]) and not isLetter(cps[j + 1]) then
					table.insert(parts, utf8.char(c))
					j += 1
					break
				else
					break
				end
				j += 1
			end
			local run = table.concat(parts)
			local last = cps[j - 1]
			-- "63.000%" -> "63%", "4.2%" (DESIGN.md 9.9 rule 3)
			if last == PCT and plainPct then
				local v = tonumber(chars(cps, a, j - 2))
				if v then run = Rich.pct(v / 100) end
			end
			table.insert(out, run)
			afterNumber = true
			i = j
		else
			-- one word run (up to the next number)
			local a = i
			local j = i
			while j <= n and not startsNumber(cps, j) do j += 1 end
			local b = j - 1
			local lead = ""
			if afterNumber and cps[a] == SPACE and Rich.useThin then
				lead = Rich.THIN
				a += 1
			end
			local word = if a <= b then chars(cps, a, b) else ""
			if string.find(word, "%S") then
				table.insert(out, lead .. wordOpen .. escape(word) .. "</font>")
			else
				table.insert(out, lead .. escape(word))
			end
			afterNumber = false
			i = j
		end
	end
	return table.concat(out)
end

-- DESIGN.md 9.9 rule 5: exponent runs with >= 7 digits step to the short form of the same value in narrow slots
-- ("+e483,525,689" -> "+e4.84e8", "1e1,234,567" -> "e1.23e6"); everything else is returned unchanged
function Rich.short(s: string): string
	local sign, mant, expo, rest = string.match(s, "^([%+%-]?)([%d%.]*)e([%d,]+)(.*)$")
	if sign == nil or mant == nil or expo == nil or rest == nil then return s end
	local digits = string.gsub(expo, ",", "")
	if #digits < 7 then return s end
	local e = tonumber(digits)
	if e == nil then return s end
	local m = if mant ~= "" then tonumber(mant) else nil
	-- mant e N (N >= 1e6) is 10^(N + log10 mant); a leading "e" means 10^N already
	local power = e + (if m and m > 0 then math.log10(m) else 0)
	local p = math.floor(math.log10(power))
	local head = power / 10 ^ p
	if head >= 9.995 then
		head /= 10
		p += 1
	end
	return string.format("%se%.2fe%d%s", sign, head, p, rest)
end

return Rich
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">Signal</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Signal: a small synchronous event. Connect / Once / Fire / DisconnectAll. Handlers run in connection order on the
	firing thread (the map's camera listeners rely on that: plan 2.3), over a snapshot, so a handler may connect or
	disconnect others. Pure Luau (no Roblox services).
]]

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}
export type Signal<T...> = {
	Connect: (self: Signal<T...>, fn: (T...) -> ()) -> Connection,
	Once: (self: Signal<T...>, fn: (T...) -> ()) -> Connection,
	Fire: (self: Signal<T...>, T...) -> (),
	DisconnectAll: (self: Signal<T...>) -> (),
}

local Signal = {}

function Signal.new<T...>(): Signal<T...>
	type Slot = { fn: (T...) -> (), conn: Connection }
	local slots: { Slot } = {}
	local self = {} :: Signal<T...>

	local function remove(conn: Connection)
		for i, s in slots do
			if s.conn == conn then
				table.remove(slots, i)
				break
			end
		end
	end
	local function add(fn: (T...) -> ()): Connection
		local conn = {} :: Connection
		conn.Connected = true
		function conn.Disconnect(c: Connection)
			if c.Connected then
				c.Connected = false
				remove(c)
			end
		end
		table.insert(slots, { fn = fn, conn = conn })
		return conn
	end

	function self.Connect(_: Signal<T...>, fn: (T...) -> ()): Connection
		return add(fn)
	end
	function self.Once(_: Signal<T...>, fn: (T...) -> ()): Connection
		local conn: Connection
		conn = add(function(...: T...)
			conn:Disconnect()
			fn(...)
		end)
		return conn
	end
	function self.Fire(_: Signal<T...>, ...: T...)
		for _, s in table.clone(slots) do
			if s.conn.Connected then s.fn(...) end
		end
	end
	function self.DisconnectAll(_: Signal<T...>)
		for _, s in slots do s.conn.Connected = false end
		table.clear(slots)
	end
	return self
end

return Signal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="90">
            <Properties>
              <string name="Name">Skin</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Skin: the Substance-painted UI kit on a GuiObject (art/substance, src/shared/UiKit.luau). A slot is a 9-sliced
	texture drawn by a child ImageLabel named "Skin" behind the object's other children; the object's own procedural
	surface (fill, hairline, top edge) is switched off while the skin shows.

	    Skin.apply(f, "cta", { tint = hue, scale = .75 })   -> the ImageLabel, or nil (no kit id / f lays out a list)
	    Skin.clear(f)                                         the procedural look again
	    Skin.ready()                                          the kit is uploaded

	scale is the SliceScale (the corners' size = slice px x scale). A list layout would lay the Skin child out like
	any item, so an object that holds a UIListLayout / UIGridLayout is never skinned (its caller keeps the Sleek
	surface). Everything is idempotent.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UiKit = require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("UiKit"))

local Skin = {}

local WHITE = Color3.new(1, 1, 1)

function Skin.ready(): boolean
	return UiKit.id ~= nil
end

local function strokes(f: GuiObject, on: boolean)
	for _, c in f:GetChildren() do
		if c:IsA("UIStroke") and c.ApplyStrokeMode == Enum.ApplyStrokeMode.Border then c.Enabled = on end
	end
	local e = f:FindFirstChild("Edge")
	if e and e:IsA("GuiObject") then e.Visible = on end
end

function Skin.clear(f: GuiObject)
	local s = f:FindFirstChild("Skin")
	if s then
		s:Destroy()
		strokes(f, true)
	end
end

export type Opts = { tint: Color3?, scale: number?, alpha: number?, z: number? }
function Skin.apply(f: GuiObject, slot: string, o: Opts?): ImageLabel?
	local id = UiKit.id
	local def = UiKit.slots[slot]
	if id == nil or def == nil or f:FindFirstChildWhichIsA("UIGridStyleLayout") then
		Skin.clear(f)
		return nil
	end
	local opts: Opts = o or ({} :: Opts)
	local im = f:FindFirstChild("Skin") :: ImageLabel?
	if im == nil or not im:IsA("ImageLabel") then
		if im then im:Destroy() end
		local n = Instance.new("ImageLabel")
		n.Name = "Skin"
		n.BackgroundTransparency = 1
		n.BorderSizePixel = 0
		n.Active = false
		n.Size = UDim2.fromScale(1, 1)
		n.Position = UDim2.new()
		n.ScaleType = Enum.ScaleType.Slice
		n.Parent = f
		im = n
	end
	local img = im :: ImageLabel
	-- a (1, 1) child of a padded object covers only the padded area: grow it back over the padding
	local pad = f:FindFirstChildWhichIsA("UIPadding")
	if pad then
		local l, t = pad.PaddingLeft.Offset, pad.PaddingTop.Offset
		img.Position = UDim2.fromOffset(-l, -t)
		img.Size = UDim2.new(1, l + pad.PaddingRight.Offset, 1, t + pad.PaddingBottom.Offset)
	else
		img.Position = UDim2.new()
		img.Size = UDim2.fromScale(1, 1)
	end
	local r, sl = def.rect, def.slice
	img.Image = id
	img.ImageRectOffset = Vector2.new(r[1], r[2])
	img.ImageRectSize = Vector2.new(r[3], r[4])
	img.SliceCenter = Rect.new(sl, sl, r[3] - sl, r[4] - sl)
	img.SliceScale = opts.scale or 0.5
	img.ImageColor3 = if def.tint then (opts.tint or WHITE) else WHITE
	img.ImageTransparency = 1 - (opts.alpha or 1)
	img.ZIndex = opts.z or 0
	f.BackgroundTransparency = 1
	strokes(f, false)
	return img
end

return Skin
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">Sleek</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Sleek: the Style 1 "sleek sci-fi" vocabulary (art/ui/clean/styles.js, STYLES[1]) as idempotent builders. The HUD,
	the panel shell, the cards and the overlays all draw with these, so the look lives in one place.

	    Sleek.plate(f, o?)                 translucent dark slab: a vertical gradient, a 1 px hairline, a lighter top edge
	    Sleek.ticks(f, o?)                 four L-shaped corner ticks drawn just outside (or on) a frame's edge
	    Sleek.accent(f, color, x, w)       the short lit bar on a plate's top edge (one accent per plate)
	    Sleek.reg(parent, name, x, y)      a registration mark (+)
	    Sleek.micro(parent, name, text, c) an index number ("01", "02/04") in Montserrat, tracked
	    Sleek.caps(parent, name, text, o?) a tracked caps micro label (the `caps` role)
	    Sleek.seg(parent, name, n, k, o?)  a segment meter: n cells, k lit
	    Sleek.rule(parent, name, o?)       a 1 px hairline (optionally fading out)
	    Sleek.diamond(parent, name, c, d)  the emblem: a rotated outlined square with a faint fill
	    Sleek.spark(parent, name, values, color, o?)  a sparkline (Path2D when the engine has it, bars otherwise)
	    Sleek.mag(s)                       a sortable magnitude of a formatted game number ("e6.424e23" -> 23.8...)

	Colours: Sleek.C (the neutral cool greys of the style; the layer hue stays the only accent).
]]

local Theme = require(script.Parent:WaitForChild("Theme"))
local Rich = require(script.Parent:WaitForChild("Rich"))

local Sleek = {}

local WHITE = Color3.new(1, 1, 1)

Sleek.C = {
	top = Color3.fromHex("0a0e16"),
	bottom = Color3.fromHex("06090f"),
	text = Color3.fromHex("f3f6fb"),
	soft = Color3.fromHex("aab4c4"),
	micro = Color3.fromHex("6d7686"),
	microHi = Color3.fromHex("7d8797"),
	ink = Color3.fromHex("06101b"),
	good = Color3.fromHex("7fe6a0"),
	goodHi = Color3.fromHex("8ff0ad"),
	goodText = Color3.fromHex("d7f7e1"),
	goodDeep = Color3.fromHex("4be07a"),
	lockText = Color3.fromHex("b9aec3"),
	gold = Color3.fromHex("ffd34d"),
	goldText = Color3.fromHex("ffe08a"),
}
local C = Sleek.C
Sleek.LINE = 0.88 -- the hairline: white at 12 %
Sleek.LINE_HI = 0.74 -- a brighter hairline: white at 26 %

local function get(parent: Instance, name: string, class: string): any
	local c = parent:FindFirstChild(name)
	if c and c.ClassName == class then return c end
	if c then c:Destroy() end
	local n = Instance.new(class :: any)
	n.Name = name
	if n:IsA("GuiObject") then
		local g = n :: GuiObject
		g.BorderSizePixel = 0
		g.BackgroundTransparency = 1
		g.Active = false
	end
	n.Parent = parent
	return n
end
Sleek.get = get
local function drop(parent: Instance, name: string)
	local c = parent:FindFirstChild(name)
	if c then c:Destroy() end
end
Sleek.drop = drop

-- ------------------------------------------------------------------------------------------------------ surfaces
export type PlateOpts = { alpha: number?, top: Color3?, bottom: Color3?, line: number?, edge: boolean?, radius: number?,
	strokeName: string?, tint: Color3?, tintAlpha: number? }
-- a translucent slab: gradient body (alpha is the body's opacity), a 1 px hairline and a 1 px lighter top edge
function Sleek.plate(f: GuiObject, o: PlateOpts?)
	local opts: PlateOpts = o or ({} :: PlateOpts)
	local a = opts.alpha or 0.86
	f.BackgroundColor3 = WHITE
	f.BackgroundTransparency = 1 - a
	f.BorderSizePixel = 0
	local g = get(f, "Fill", "UIGradient") :: UIGradient
	g.Rotation = 90
	local top, bottom = opts.top or C.top, opts.bottom or C.bottom
	if opts.tint then
		top = Theme.mix(top, opts.tint, opts.tintAlpha or 0.1)
		bottom = Theme.mix(bottom, opts.tint, (opts.tintAlpha or 0.1) * 0.35)
	end
	g.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, top), ColorSequenceKeypoint.new(1, bottom) })
	g.Transparency = NumberSequence.new(0)
	local s = get(f, opts.strokeName or "Hair", "UIStroke") :: UIStroke
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.LineJoinMode = Enum.LineJoinMode.Miter
	s.Thickness = 1
	s.Color = WHITE
	s.Transparency = opts.line or Sleek.LINE
	if opts.radius and opts.radius > 0 then
		local c = get(f, "Corner", "UICorner") :: UICorner
		c.CornerRadius = UDim.new(0, opts.radius)
	else
		drop(f, "Corner")
	end
	if opts.edge ~= false then
		local e = get(f, "Edge", "Frame") :: Frame
		e.Size = UDim2.new(1, 0, 0, 1)
		e.Position = UDim2.new()
		e.BackgroundColor3 = WHITE
		e.BackgroundTransparency = math.max(0, (opts.line or Sleek.LINE) - 0.08)
		e.ZIndex = f.ZIndex
	else
		drop(f, "Edge")
	end
end

export type TickOpts = { len: number?, th: number?, color: Color3?, alpha: number?, out: number?, name: string?, z: number? }
-- four L-shaped corner ticks: 8 thin frames in a holder that is `out` du larger than the frame on every side
function Sleek.ticks(f: GuiObject, o: TickOpts?): Frame
	local opts: TickOpts = o or ({} :: TickOpts)
	local len, th, out = opts.len or 10, opts.th or 2, opts.out or 1
	local color, a = opts.color or WHITE, opts.alpha or 0.85
	local h = get(f, opts.name or "Ticks", "Frame") :: Frame
	h.AnchorPoint = Vector2.new(0.5, 0.5)
	h.Position = UDim2.fromScale(0.5, 0.5)
	h.Size = UDim2.new(1, 2 * out, 1, 2 * out)
	h.ZIndex = opts.z or (f.ZIndex + 1)
	local i = 0
	for _, cx in { 0, 1 } do
		for _, cy in { 0, 1 } do
			i += 1
			local hb = get(h, "H" .. i, "Frame") :: Frame
			hb.AnchorPoint = Vector2.new(cx, cy)
			hb.Position = UDim2.fromScale(cx, cy)
			hb.Size = UDim2.fromOffset(len, th)
			hb.BackgroundColor3 = color
			hb.BackgroundTransparency = 1 - a
			hb.ZIndex = h.ZIndex
			local vb = get(h, "V" .. i, "Frame") :: Frame
			vb.AnchorPoint = Vector2.new(cx, cy)
			vb.Position = UDim2.fromScale(cx, cy)
			vb.Size = UDim2.fromOffset(th, len)
			vb.BackgroundColor3 = color
			vb.BackgroundTransparency = 1 - a
			vb.ZIndex = h.ZIndex
		end
	end
	return h
end

-- the lit bar on a plate's top edge (glow where UIShadow exists)
function Sleek.accent(f: GuiObject, color: Color3, x: number, w: number, o: { name: string?, h: number?, glow: boolean? }?): Frame
	local name = if o and o.name then o.name else "Accent"
	local b = get(f, name, "Frame") :: Frame
	b.AnchorPoint = Vector2.new(0, 0.5)
	b.Position = UDim2.fromOffset(x, 0)
	b.Size = UDim2.fromOffset(w, if o and o.h then o.h else 3)
	b.BackgroundColor3 = color
	b.BackgroundTransparency = 0
	b.ZIndex = f.ZIndex + 2
	if (o == nil or o.glow ~= false) and Theme.caps.UIShadow then
		local s = get(b, "Glow", "UIShadow") :: any
		pcall(function()
			s.Color = color
			s.Transparency = 0.35
			s.BlurRadius = UDim.new(0, 10)
			s.Offset = UDim2.new()
		end)
	end
	return b
end

-- a registration mark (+), centred on (x, y) in the parent's offset space
function Sleek.reg(parent: GuiObject, name: string, x: number, y: number, o: { s: number?, alpha: number? }?): Frame
	local s = if o and o.s then o.s else 9
	local a = if o and o.alpha then o.alpha else 0.4
	-- the vertical stroke is the holder, the horizontal one its child (two instances)
	local v = get(parent, name, "Frame") :: Frame
	v.AnchorPoint = Vector2.new(0.5, 0.5)
	v.Position = UDim2.fromOffset(x, y)
	v.Size = UDim2.fromOffset(1, s)
	v.BackgroundColor3 = WHITE
	v.BackgroundTransparency = 1 - a
	v.ZIndex = parent.ZIndex + 1
	local hz = get(v, "H", "Frame") :: Frame
	hz.AnchorPoint = Vector2.new(0.5, 0.5)
	hz.Position = UDim2.fromScale(0.5, 0.5)
	hz.Size = UDim2.fromOffset(s, 1)
	hz.BackgroundColor3 = WHITE
	hz.BackgroundTransparency = 1 - a
	hz.ZIndex = v.ZIndex
	drop(v, "V")
	return v
end

-- ------------------------------------------------------------------------------------------------------ type
-- an index number: Sarpanch Bold, auto width
function Sleek.micro(parent: Instance, name: string, text: string, color: Color3?, size: number?): TextLabel
	local l = get(parent, name, "TextLabel") :: TextLabel
	l.FontFace = Font.fromName("Montserrat", Enum.FontWeight.Bold)
	l.TextSize = size or 13
	l.LineHeight = 1
	l.TextColor3 = color or C.micro
	l.AutomaticSize = Enum.AutomaticSize.X
	l.Size = UDim2.fromOffset(0, size or 13)
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Center
	l.TextWrapped = false
	l.RichText = false
	if l.Text ~= text then l.Text = text end
	return l
end

-- hair spaces between letters: the tracked caps of the style (Roblox text has no letter spacing)
function Sleek.track(s: string): string
	return Rich.caps(s)
end

export type CapsOpts = { color: Color3?, role: string?, weight: Enum.FontWeight?, size: number?, h: number? }
-- a tracked caps micro label: Montserrat Bold 12-13, soft, auto width
function Sleek.caps(parent: Instance, name: string, text: string, o: CapsOpts?): TextLabel
	local opts: CapsOpts = o or ({} :: CapsOpts)
	local l = get(parent, name, "TextLabel") :: TextLabel
	Theme.text(l, opts.role or "caps")
	if opts.size then l.TextSize = opts.size end
	if opts.weight then l.FontFace = Font.fromName("Montserrat", opts.weight) end
	l.TextColor3 = opts.color or C.soft
	l.AutomaticSize = Enum.AutomaticSize.X
	l.Size = UDim2.fromOffset(0, opts.h or l.TextSize)
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Center
	l.TextWrapped = false
	l.RichText = false
	local t = Sleek.track(text)
	if l.Text ~= t then l.Text = t end
	return l
end

-- ------------------------------------------------------------------------------------------------------ data
export type SegOpts = { w: number?, h: number?, gap: number?, on: Color3?, off: number? }
-- a segment meter: a horizontal row of n cells, the first k lit
function Sleek.seg(parent: Instance, name: string, n: number, k: number, o: SegOpts?): Frame
	local opts: SegOpts = o or ({} :: SegOpts)
	local w, h, gap = opts.w or 3, opts.h or 12, opts.gap or 2
	n = math.clamp(math.floor(n), 0, 40)
	local f = get(parent, name, "Frame") :: Frame
	f.Size = UDim2.fromOffset(math.max(0, n * w + (n - 1) * gap), h)
	for i = 1, n do
		local c = get(f, "S" .. i, "Frame") :: Frame
		c.Position = UDim2.fromOffset((i - 1) * (w + gap), 0)
		c.Size = UDim2.fromOffset(w, h)
		c.BackgroundColor3 = if i <= k then opts.on or C.good else WHITE
		c.BackgroundTransparency = if i <= k then 0 else (opts.off or 0.82)
	end
	for _, c in f:GetChildren() do
		local i = tonumber(string.match(c.Name, "^S(%d+)$"))
		if i and i > n then c:Destroy() end
	end
	return f
end

-- a 1 px hairline: full width of the parent by default, fading out to the right when fade is set
function Sleek.rule(parent: Instance, name: string, o: { alpha: number?, fade: boolean?, color: Color3?, vertical: boolean? }?): Frame
	local r = get(parent, name, "Frame") :: Frame
	r.BackgroundColor3 = if o and o.color then o.color else WHITE
	r.BackgroundTransparency = if o and o.alpha then 1 - o.alpha else Sleek.LINE
	if o and o.vertical then
		r.Size = UDim2.new(0, 1, 1, 0)
	else
		r.Size = UDim2.new(1, 0, 0, 1)
	end
	if o and o.fade then
		local g = get(r, "Fade", "UIGradient") :: UIGradient
		g.Rotation = if o.vertical then 90 else 0
		g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	else
		drop(r, "Fade")
	end
	return r
end

-- the emblem: an outlined diamond with a faint fill and an inner fine diamond (the symbol goes on top, unrotated)
function Sleek.diamond(parent: Instance, name: string, color: Color3, d: number, o: { fill: number?, inner: boolean? }?): Frame
	local h = get(parent, name, "Frame") :: Frame
	h.Size = UDim2.fromOffset(d, d)
	local k = d / math.sqrt(2)
	local outer = get(h, "Outer", "Frame") :: Frame
	outer.AnchorPoint = Vector2.new(0.5, 0.5)
	outer.Position = UDim2.fromScale(0.5, 0.5)
	outer.Size = UDim2.fromOffset(math.floor(k * 0.98), math.floor(k * 0.98))
	outer.Rotation = 45
	outer.BackgroundColor3 = color
	outer.BackgroundTransparency = 1 - (if o and o.fill then o.fill else 0.12)
	outer.ZIndex = h.ZIndex
	local s = get(outer, "Line", "UIStroke") :: UIStroke
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.LineJoinMode = Enum.LineJoinMode.Miter
	s.Thickness = if d >= 40 then 1.5 else 1.25
	s.Color = color
	s.Transparency = 0
	if o == nil or o.inner ~= false then
		local inner = get(h, "Inner", "Frame") :: Frame
		inner.AnchorPoint = Vector2.new(0.5, 0.5)
		inner.Position = UDim2.fromScale(0.5, 0.5)
		inner.Size = UDim2.fromOffset(math.floor(k * 0.72), math.floor(k * 0.72))
		inner.Rotation = 45
		inner.ZIndex = h.ZIndex
		local si = get(inner, "Line", "UIStroke") :: UIStroke
		si.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		si.LineJoinMode = Enum.LineJoinMode.Miter
		si.Thickness = 1
		si.Color = color
		si.Transparency = 0.65
	else
		drop(h, "Inner")
	end
	return h
end

-- ------------------------------------------------------------------------------------------------------ sparkline
-- a magnitude that sorts formatted game numbers ("1,234", "4.2e56", "e6.4e23", "ee12", "1e1,234") for a sparkline
function Sleek.mag(s: string?): number?
	if type(s) ~= "string" then return nil end
	local t = string.gsub(string.gsub(string.lower(s), ",", ""), "^%s*[%+]?", "")
	local layers = 0
	while string.sub(t, 1, 1) == "e" do
		layers += 1
		t = string.sub(t, 2)
	end
	local n = tonumber(string.match(t, "^[%d%.]+e?[%+%-]?%d*") or "")
	if n == nil then
		n = tonumber(string.match(t, "^[%d%.]+") or "")
	end
	if n == nil or n ~= n then return nil end
	n = math.min(n, 1e300) -- "1e400" parses to inf; keep the maths finite
	-- inside one layer count, log10 keeps the order; each extra "e" dwarfs the previous layers
	local v = if n > 0 then math.log10(n) else 0
	if layers > 0 then v = if v > 0 then math.log10(v + 1) else 0 end
	return layers * 1000 + v
end

export type SparkOpts = { w: number, h: number, thick: number?, dot: boolean?, bars: boolean? }
-- values are raw; the line is normalised to the frame (a flat series draws a mid line)
function Sleek.spark(parent: Instance, name: string, values: { number }, color: Color3, o: SparkOpts): Frame
	local f = get(parent, name, "Frame") :: Frame
	f.Size = UDim2.fromOffset(o.w, o.h)
	local n = #values
	local lo, hi = math.huge, -math.huge
	for _, v in values do
		lo = math.min(lo, v)
		hi = math.max(hi, v)
	end
	local span = hi - lo
	local function y01(v: number): number
		if n < 2 or not (span > 1e-12 and span < math.huge) then return 0.5 end
		local y = (v - lo) / span
		return if y == y then math.clamp(y, 0, 1) else 0.5
	end
	-- a dim baseline under the data (and all there is until two samples exist)
	local base = get(f, "Base", "Frame") :: Frame
	base.AnchorPoint = Vector2.new(0, 1)
	base.Position = UDim2.fromScale(0, 1)
	base.Size = UDim2.new(1, 0, 0, 1)
	base.BackgroundColor3 = WHITE
	base.BackgroundTransparency = 0.88
	if n < 2 then
		drop(f, "Line")
		for _, c in f:GetChildren() do
			if string.match(c.Name, "^B%d+$") then c:Destroy() end
		end
		drop(f, "Dot")
		return f
	end
	local usePath = not o.bars and Theme.caps.Path2D == true
	if usePath then
		for _, c in f:GetChildren() do
			if string.match(c.Name, "^B%d+$") then c:Destroy() end
		end
		local p = get(f, "Line", "Path2D") :: any
		pcall(function()
			p.Color3 = color
			p.Thickness = o.thick or 1.6
			p.ZIndex = f.ZIndex + 1
			local pts = {}
			for i, v in values do
				local x = (i - 1) / (n - 1)
				local y = 1 - (0.1 + 0.8 * y01(v))
				table.insert(pts, Path2DControlPoint.new(UDim2.fromScale(x, y)))
			end
			p:SetControlPoints(pts)
		end)
	else
		drop(f, "Line")
		local bw = if n > 0 then o.w / n else o.w
		for i, v in values do
			local b = get(f, "B" .. i, "Frame") :: Frame
			local bh = math.max(2, math.floor((0.15 + 0.85 * y01(v)) * o.h + 0.5))
			b.AnchorPoint = Vector2.new(0, 1)
			b.Position = UDim2.new(0, math.floor((i - 1) * bw), 1, 0)
			b.Size = UDim2.fromOffset(math.max(1, math.floor(bw) - 1), bh)
			b.BackgroundColor3 = color
			b.BackgroundTransparency = if i == n then 0 else 0.72
		end
		for _, c in f:GetChildren() do
			local i = tonumber(string.match(c.Name, "^B(%d+)$"))
			if i and i > n then c:Destroy() end
		end
	end
	if o.dot ~= false and n >= 1 then
		local d = get(f, "Dot", "Frame") :: Frame
		d.AnchorPoint = Vector2.new(0.5, 0.5)
		d.Position = UDim2.fromScale(1, 1 - (0.1 + 0.8 * y01(values[n])))
		d.Size = UDim2.fromOffset(5, 5)
		d.BackgroundColor3 = color
		d.BackgroundTransparency = if usePath then 0 else 1
		d.ZIndex = f.ZIndex + 2
		local c = get(d, "Corner", "UICorner") :: UICorner
		c.CornerRadius = UDim.new(0.5, 0)
	else
		drop(f, "Dot")
	end
	return f
end

-- the layer's place in the tree (row, then the game's order): the "LAYER 02 / 21" readout
local ORDER = { "m", "p", "mm", "sp", "pe", "pb", "em", "se", "hp", "pp", "ep", "hb", "ap", "mp", "t", "pm", "pep", "cp", "cm", "ex", "ach" }
Sleek.ORDER = ORDER
function Sleek.layerIndex(key: string): number?
	for i, k in ORDER do
		if k == key then return i end
	end
	return nil
end

return Sleek
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="92">
            <Properties>
              <string name="Name">Sprites</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Sprites: the UI atlas regions and tile textures of Assets.ui (DESIGN.md 14, plan 3.4), with the procedural
	fallback of plan 3.5 for every sprite whose image is not uploaded yet (Assets ids are nil until then).

	    Sprites.image("glow_circle", parent, { tint = c, alpha = .5 })   -- always an ImageLabel
	    Sprites.slice("bevel_card", label, scale)                         -- 9-slice setup of an atlas label
	    Sprites.texture("tile_stripes")                                   -- a standalone tile texture id, or nil
	    Sprites.has(name), Sprites.tier / Sprites.setTier("LOW")

	The fallback keeps the same ImageLabel (so callers size and place it the same way) and draws with its background
	instead: a Radial gradient blob for glows and auras, a gradient lip overlay for bevels, a dashed stroke for the
	dashed ring, a filled disc for circles, one Latin-1 glyph (or a small dot) for icons, nothing for rays.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(script.Parent:WaitForChild("Theme"))

local Sprites = {}

Sprites.tier = "HIGH" :: string

type Region = { x: number, y: number, w: number, h: number, scale: number?, slice: { number }?, tint: boolean? }
type Ui = {
	atlas: { HIGH: string?, LOW: string? },
	size: { HIGH: { number }?, LOW: { number }? }?,
	regions: { [string]: Region },
	textures: { [string]: { id: string?, w: number, h: number } }?,
}

local ui: Ui? = nil
local loaded = false
local function assetsUi(): Ui?
	if loaded then return ui end
	loaded = true
	local ok, assets = pcall(function(): any
		local m: any = require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("Assets"))
		return m
	end)
	if ok and type(assets) == "table" and type(assets.ui) == "table" and type(assets.ui.regions) == "table" then
		ui = assets.ui :: Ui
	end
	return ui
end

function Sprites.setTier(t: string)
	Sprites.tier = if t == "LOW" then "LOW" else "HIGH"
end

local function atlasId(): string?
	local u = assetsUi()
	if u == nil or type(u.atlas) ~= "table" then return nil end
	local id = if Sprites.tier == "LOW" then u.atlas.LOW or u.atlas.HIGH else u.atlas.HIGH
	return if type(id) == "string" and id ~= "" then id else nil
end
local function region(name: string): Region?
	local u = assetsUi()
	if u == nil then return nil end
	local r = u.regions[name]
	return if type(r) == "table" then r else nil
end

-- the atlas is uploaded and has this region
function Sprites.has(name: string): boolean
	return atlasId() ~= nil and region(name) ~= nil
end

-- a standalone tile texture id (R9), nil when not uploaded
function Sprites.texture(name: string): string?
	local u = assetsUi()
	if u == nil or type(u.textures) ~= "table" then return nil end
	local t = (u.textures :: any)[name]
	if type(t) ~= "table" or type(t.id) ~= "string" or t.id == "" then return nil end
	return t.id
end

-- the fallback glyph per icon: Montserrat's Latin-1 set only (DESIGN.md P11); anything else is a small dot
Sprites.FALLBACK_GLYPH = {
	plus = "+", minus = "–", x = "×", warn = "!", info = "i", chev = "›", chevr = "›", right = "›", left = "‹",
	star = "*", sparkle = "*", coin_star = "*", export = "›", import = "‹", copy = "+", trash = "×", check = "·",
	bolt = "!", badge_bolt = "!", badge_bang = "!", up = "+", down = "–", sort = "…", text = "A", target = "·",
} :: { [string]: string }
local ICONS: { [string]: boolean } = {}
for _, n in {
	"gear", "star", "home", "bell", "lock", "plus", "minus", "x", "save", "export", "import", "copy", "trash", "warn", "info",
	"check", "chev", "chevr", "up", "down", "left", "right", "bolt", "sparkle", "swirl", "moon", "bug", "flame", "hand", "clock",
	"eye", "sort", "grid", "motion", "map", "text", "target", "disk", "badge_bolt", "badge_bang", "coin_star", "hex",
	"ember", "sparkle_small",
} do
	ICONS[n] = true
end

local function child<T>(parent: Instance, name: string, class: string): T
	local c = parent:FindFirstChild(name)
	if c and c.ClassName == class then return (c :: any) :: T end
	if c then c:Destroy() end
	local n = Instance.new(class :: any)
	n.Name = name
	n.Parent = parent
	return (n :: any) :: T
end
Sprites.child = child

local function clearFallback(l: ImageLabel)
	for _, n in { "FbCorner", "FbGradient", "FbStroke", "FbGlyph", "FbDot" } do
		local c = l:FindFirstChild(n)
		if c then c:Destroy() end
	end
end

local function fallback(name: string, l: ImageLabel, tint: Color3, alpha: number)
	l.Image = ""
	l.BackgroundTransparency = 1
	l.BackgroundColor3 = tint
	local caps = Theme.caps
	if name == "glow_rr" or name == "glow_circle" or name == "aura" or string.sub(name, 1, 7) == "radial_" then
		if caps.Radial then
			local corner = child(l, "FbCorner", "UICorner") :: UICorner
			corner.CornerRadius = UDim.new(0.5, 0)
			local g = child(l, "FbGradient", "UIGradient") :: UIGradient
			g.Type = Enum.GradientType.Radial
			local a0 = 1 - alpha
			g.Transparency = if name == "aura"
				then NumberSequence.new({
					NumberSequenceKeypoint.new(0, a0),
					NumberSequenceKeypoint.new(0.55, 1 - alpha * 0.27),
					NumberSequenceKeypoint.new(1, 1),
				})
				else NumberSequence.new({
					NumberSequenceKeypoint.new(0, a0),
					NumberSequenceKeypoint.new(0.5, 1 - alpha * 0.45),
					NumberSequenceKeypoint.new(1, 1),
				})
			l.BackgroundTransparency = 0
		end
	elseif name == "bevel_button" or name == "bevel_card" or name == "bevel_ring" then
		-- white lip at the top, clear middle, black lip at the bottom (the same UICorner as the target)
		l.BackgroundColor3 = Color3.new(1, 1, 1)
		l.BackgroundTransparency = 0
		local parent = l.Parent
		local pc = if parent then parent:FindFirstChildWhichIsA("UICorner") else nil
		local corner = child(l, "FbCorner", "UICorner") :: UICorner
		corner.CornerRadius = if name == "bevel_ring" then UDim.new(0.5, 0) elseif pc then pc.CornerRadius else UDim.new(0, 8)
		local g = child(l, "FbGradient", "UIGradient") :: UIGradient
		g.Rotation = 90
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
			ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1)),
			ColorSequenceKeypoint.new(0.51, Color3.new(0, 0, 0)),
			ColorSequenceKeypoint.new(1, Color3.new(0, 0, 0)),
		})
		g.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.82),
			NumberSequenceKeypoint.new(0.12, 1),
			NumberSequenceKeypoint.new(0.8, 1),
			NumberSequenceKeypoint.new(1, 0.7),
		})
	elseif name == "ring_dashed" then
		local corner = child(l, "FbCorner", "UICorner") :: UICorner
		corner.CornerRadius = UDim.new(0.5, 0)
		local st = child(l, "FbStroke", "UIStroke") :: UIStroke
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		st.Color = tint
		st.Thickness = 3
		st.Transparency = if caps.TileMode then 1 - alpha else math.max(1 - alpha, 0.3)
		if caps.TileMode then
			local g = child(st, "Dash", "UIGradient") :: UIGradient
			g.Rotation = 45
			g.TileMode = Enum.GradientTileMode.Repeat
			g.Scale = 0.08
			g.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.6, 0),
				NumberSequenceKeypoint.new(0.61, 1),
				NumberSequenceKeypoint.new(1, 1),
			})
		end
	elseif name == "circle" or name == "halfdisc" or name == "chip" or name == "keycap" or name == "hex" then
		local corner = child(l, "FbCorner", "UICorner") :: UICorner
		corner.CornerRadius = if name == "chip" or name == "keycap" then UDim.new(0.3, 0) else UDim.new(0.5, 0)
		l.BackgroundTransparency = 1 - alpha
	elseif name == "shadow_card" then
		local corner = child(l, "FbCorner", "UICorner") :: UICorner
		corner.CornerRadius = UDim.new(0, 16)
		l.BackgroundColor3 = Color3.new(0, 0, 0)
		l.BackgroundTransparency = 1 - alpha * 0.35
	elseif ICONS[name] then
		local glyph = Sprites.FALLBACK_GLYPH[name]
		if glyph then
			local t = child(l, "FbGlyph", "TextLabel") :: TextLabel
			t.BackgroundTransparency = 1
			t.Size = UDim2.fromScale(1, 1)
			t.Text = glyph
			t.TextScaled = true
			t.TextColor3 = tint
			t.TextTransparency = 1 - alpha
			t.FontFace = Theme.font("small")
			t.Active = false
		else
			-- a small dot in the tint
			local dot = child(l, "FbDot", "Frame") :: Frame
			dot.AnchorPoint = Vector2.new(0.5, 0.5)
			dot.Position = UDim2.fromScale(0.5, 0.5)
			dot.Size = UDim2.fromScale(0.36, 0.36)
			dot.BorderSizePixel = 0
			dot.BackgroundColor3 = tint
			dot.BackgroundTransparency = 1 - alpha * 0.9
			dot.Active = false
			local corner = child(dot, "FbCorner", "UICorner") :: UICorner
			corner.CornerRadius = UDim.new(0.5, 0)
		end
	end
	-- rays and anything unknown: nothing drawn
end

local function applyRegion(l: ImageLabel, id: string, r: Region)
	local k = if Sprites.tier == "LOW" then 0.5 else 1
	l.Image = id
	l.ImageRectOffset = Vector2.new(r.x * k, r.y * k)
	l.ImageRectSize = Vector2.new(r.w * k, r.h * k)
	l.BackgroundTransparency = 1
end

-- An ImageLabel showing a sprite (get-or-create by the parent's child named `name` when a parent is given).
-- o.tint colours white regions and the fallback; o.alpha is the opacity (1 - transparency).
function Sprites.image(name: string, parent: Instance?, o: { tint: Color3?, alpha: number?, key: string? }?): ImageLabel
	local opts: { tint: Color3?, alpha: number?, key: string? } = o or {}
	local key = opts.key or ("Sprite_" .. name)
	local l: ImageLabel
	local existing = if parent then parent:FindFirstChild(key) else nil
	if existing and existing:IsA("ImageLabel") then
		l = existing
	else
		if existing then existing:Destroy() end
		l = Instance.new("ImageLabel")
		l.Name = key
		l.BorderSizePixel = 0
		l.BackgroundTransparency = 1
		l.Active = false
		l.Size = UDim2.fromScale(1, 1)
	end
	local tint = opts.tint or Color3.new(1, 1, 1)
	local alpha = if opts.alpha ~= nil then opts.alpha else 1
	local id = atlasId()
	local r = region(name)
	if id and r then
		clearFallback(l)
		applyRegion(l, id, r)
		l.ImageColor3 = if r.tint == false then Color3.new(1, 1, 1) else tint
		l.ImageTransparency = 1 - alpha
	else
		l.ImageTransparency = 1
		if l.Parent == nil and parent then l.Parent = parent end
		fallback(name, l, tint, alpha)
	end
	if parent and l.Parent ~= parent then l.Parent = parent end
	return l
end

-- 9-slice: SliceCenter from the region spec, SliceScale (the @2x regions display at half size)
function Sprites.slice(name: string, f: ImageLabel, scale: number?)
	local r = region(name)
	if r == nil or atlasId() == nil then return end
	local sl = r.slice
	if sl == nil then return end
	local k = if Sprites.tier == "LOW" then 0.5 else 1
	f.ScaleType = Enum.ScaleType.Slice
	f.SliceCenter = Rect.new(sl[1] * k, sl[2] * k, sl[3] * k, sl[4] * k)
	f.SliceScale = (scale or 1) * (r.scale or 1) / k
end

return Sprites
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="93">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Theme: colour tokens and layer hues (DESIGN.md 11.1), the colour rules (11.2: lift / shade / mix, the game colour
	remap, contrast lifts), the type roles (9) and the engine capability flags (13.1).

	    Theme.C.panel, Theme.hue("m"), Theme.lift(c, .45), Theme.remap("#793784", "p"), Theme.remapper("p")
	    Theme.font("title"), Theme.size("title")           -- the size for the current Layout mode and scale (floors held)
	    Theme.text(label, "body")                          -- FontFace + TextSize + LineHeight of a role (DESIGN.md 9.2)
	    Theme.detect(); Theme.caps.Radial                  -- pcall probes, once at start (App)

	Colour maths uses Color3.new with the channels, so it runs on the test engine too.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Html = require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("Html"))

local Theme = {}

local function hex(h: string): Color3
	return Color3.fromHex(h)
end

-- ------------------------------------------------------------------------------------------------------ tokens
Theme.C = {
	-- base: the cool neutral greys of the Sleek style (Core/Sleek.luau); the layer hue is the only accent
	void = hex("05070c"),
	deep = hex("070a11"),
	panel = hex("0c111a"),
	panel2 = hex("131a25"),
	panel3 = hex("1c2533"),
	stroke = hex("2b3444"),
	strokeHi = hex("4b5668"),
	text = hex("f3f6fb"),
	soft = hex("aab4c4"), -- secondary text, labels, hints (DESIGN.md 9.6; >= 8.4:1 on every dark surface)
	muted = hex("8a94a6"), -- tertiary only, >= 15 du on dark surfaces
	faint = hex("4d5566"), -- never text
	-- state
	bought = hex("4be07a"),
	locked = hex("8a6f7a"),
	complete = hex("ffc233"),
	danger = hex("ff3b5c"),
	gold = hex("ffd34d"),
	-- extra
	info = hex("7a8cff"),
	lockedLink = hex("c7b8f2"),
	ember = hex("ff7a2e"),
	system = hex("9d8cff"),
	-- fixed text colours of the type table (DESIGN.md 9.2 / 9.6, 11.1)
	ownedTitle = hex("d7f7e1"),
	ownedValue = hex("a5efbc"),
	lockedTitle = hex("c9bfd0"),
	notYet = hex("d9b3be"),
	ready = hex("ffe08a"),
	dangerText = hex("f2d7dd"),
	ink = hex("06101b"), -- dark text on light hue fills
	termLime = hex("caffbf"),
	termDim = hex("9fdc92"),
	stableId = hex("5f8a58"),
	glass = hex("06090f"),
	white = Color3.new(1, 1, 1),
	black = Color3.new(0, 0, 0),
}

-- layer hues, keyed by game id (DESIGN.md 11.1)
local HUES: { [string]: string } = {
	m = "b35cff", mm = "d17aff", em = "e88af2", p = "6fc3ff", pe = "ff9a2e", sp = "5fe0ff", pb = "57e0b0", pp = "ff4d6d",
	se = "ff6a1f", hp = "7fd9ff", ep = "9be02c", hb = "6dffb0", ap = "8ff3f3", mp = "ff5a1f", t = "ffe93a", pm = "ff2e63",
	pep = "f2b04d", cp = "39ff14", cm = "1fbf4a", ex = "45e07f", ach = "ffc93c",
}
local hueCache: { [string]: Color3 } = {}
-- a layer's hue; "cp" is the corrupted lime, "options-tab" the system violet, unknown keys the text colour
function Theme.hue(layer: string?): Color3
	if layer == nil then return Theme.C.text end
	local hit = hueCache[layer]
	if hit then return hit end
	local h = HUES[layer]
	local c: Color3 = if h then hex(h) elseif layer == "options-tab" then Theme.C.system else Theme.C.text
	hueCache[layer] = c
	return c
end
Theme.LAYERS = HUES

-- ------------------------------------------------------------------------------------------------------ colour maths
function Theme.mix(a: Color3, b: Color3, t: number): Color3
	return Color3.new(a.R + (b.R - a.R) * t, a.G + (b.G - a.G) * t, a.B + (b.B - a.B) * t)
end
-- toward white by t (the Figma lift)
function Theme.lift(c: Color3, t: number): Color3
	return Theme.mix(c, Color3.new(1, 1, 1), t)
end
-- darker by factor k (c * k)
function Theme.shade(c: Color3, k: number): Color3
	return Color3.new(math.clamp(c.R * k, 0, 1), math.clamp(c.G * k, 0, 1), math.clamp(c.B * k, 0, 1))
end
function Theme.rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end
function Theme.toHex(c: Color3): string
	local function b(x: number): number return math.clamp(math.floor(x * 255 + 0.5), 0, 255) end
	return string.format("%02x%02x%02x", b(c.R), b(c.G), b(c.B))
end

-- WCAG relative luminance and contrast ratio
local function lin(x: number): number
	return if x <= 0.03928 then x / 12.92 else ((x + 0.055) / 1.055) ^ 2.4
end
function Theme.luminance(c: Color3): number
	return 0.2126 * lin(c.R) + 0.7152 * lin(c.G) + 0.0722 * lin(c.B)
end
function Theme.contrast(a: Color3, b: Color3): number
	local la, lb = Theme.luminance(a), Theme.luminance(b)
	if la < lb then la, lb = lb, la end
	return (la + 0.05) / (lb + 0.05)
end

-- rule 3: the smallest lift that makes coloured text readable on the panel (precomputed; others need none)
local TEXT_LIFT: { [string]: number } = { m = 0.25, pp = 0.20, mp = 0.20, se = 0.10, pm = 0.35 }
function Theme.textLift(layer: string?): number
	return if layer then TEXT_LIFT[layer] or 0 else 0
end
-- a layer's hue as body text on the panel
function Theme.textHue(layer: string?): Color3
	return Theme.lift(Theme.hue(layer), Theme.textLift(layer))
end

-- rule 4: small text on these hue fills is dark, without a stroke
local LIGHT_FILL: { [string]: boolean } = {
	t = true, ach = true, cp = true, hb = true, ap = true, sp = true, hp = true, ep = true, pb = true, p = true, pep = true,
	ex = true, em = true,
}
function Theme.darkOnFill(layer: string?): boolean
	return layer ~= nil and LIGHT_FILL[layer] == true
end

-- ------------------------------------------------------------------------------------------------------ the remap
-- rule 2: game colours become tokens wherever they arrive. Keys are CSS names (checked first, lower case) or hex.
local REMAP_NAME: { [string]: string } = {
	black = "@cp", darkgreen = "@cm", gold = "@ach", red = "danger", lime = "@cp", green = "bought", yellow = "complete",
}
local REMAP_HEX: { [string]: string } = {
	["793784"] = "@m",
	["9f2846"] = "danger", c25757 = "danger", ee7070 = "danger", c86a6a = "danger",
	["652021"] = "@pp",
	["648c11"] = "@ep",
	d03800 = "@mp",
	ffff00 = "@t",
	["000000"] = "@cp",
	["006400"] = "@cm",
	ffd700 = "@ach",
	ff0000 = "danger",
	["00ff00"] = "@cp",
	["008000"] = "bought",
}
local function token(key: string): (Color3, string?)
	if string.sub(key, 1, 1) == "@" then
		local layer = string.sub(key, 2)
		return Theme.hue(layer), layer
	end
	return (Theme.C :: any)[key] :: Color3, nil
end
local function lookup(css: string): string?
	local s = string.lower((string.gsub(css, "^%s+", "")))
	s = string.gsub(s, "%s*!important%s*$", "")
	s = string.gsub(s, "%s+$", "")
	local byName = REMAP_NAME[s]
	if byName then return byName end
	local h = Html.hex(s)
	if h then return REMAP_HEX[string.lower(h)] end
	return nil
end
-- a game colour -> the client colour (unknown colours: lift(c, .35)); nil when the CSS is not a colour
function Theme.remap(css: string?, layer: string?): Color3?
	if css == nil then return nil end
	local key = lookup(css)
	if key then return (token(key)) end
	local c = Html.color(css)
	if c == nil then return nil end
	return Theme.lift(c, 0.35)
end
-- the same for backgrounds: black backgrounds are removed (nil)
function Theme.remapBg(css: string?, layer: string?): Color3?
	if css == nil then return nil end
	local h = Html.hex(css)
	if h == nil then return nil end
	local c = Color3.fromHex(h)
	if c.R + c.G + c.B < 0.09 then return nil end
	return Theme.remap(css, layer)
end
-- for Html.rich's remap argument: "rrggbb" -> "rrggbb", with the contrast lift of the target layer applied
local remappers: { [string]: (string) -> string } = {}
function Theme.remapper(layer: string?): (hex: string) -> string
	local k = layer or ""
	local hit = remappers[k]
	if hit then return hit end
	local memo: { [string]: string } = {}
	local f = function(h: string): string
		local hit = memo[h]
		if hit then return hit end
		local key = REMAP_HEX[string.lower(h)]
		local out: Color3
		if key then
			local c, owner = token(key)
			out = if owner then Theme.lift(c, Theme.textLift(owner)) else c
		else
			local ok, c = pcall(Color3.fromHex, h)
			out = if ok then Theme.lift(c, 0.35) else Theme.C.text
		end
		local r = Theme.toHex(out)
		memo[h] = r
		return r
	end
	remappers[k] = f
	return f
end

-- ------------------------------------------------------------------------------------------------------ type roles
-- DESIGN.md 9.2: family, weight, italic, WIDE size (MEDIUM too; Theme.size lifts the floor roles when s < 1), COMPACT
-- size, LineHeight, and the rendered floor class ("caps" = 12 px, "text" = 13 px; DESIGN.md 9.5)
export type FloorClass = "caps" | "text"
export type Role = {
	family: string,
	weight: Enum.FontWeight,
	italic: boolean,
	wide: number,
	compact: number,
	lh: number,
	floor: FloorClass,
}
local function role(family: string, weight: Enum.FontWeight, italic: boolean, wide: number, compact: number, lh: number,
	floor: FloorClass?): Role
	return { family = family, weight = weight, italic = italic, wide = wide, compact = compact, lh = lh, floor = floor or "text" }
end
local W = Enum.FontWeight
local ROLES: { [string]: Role } = {
	-- display: Heavy / Sarpanch Heavy with outline + shadow (the loved look; nothing here shrank)
	hero = role("Sarpanch", W.Heavy, false, 56, 38, 1),
	title = role("Montserrat", W.Heavy, true, 44, 27, 1),
	big = role("Sarpanch", W.Heavy, false, 44, 30, 1),
	capsule = role("Sarpanch", W.Heavy, false, 34, 28, 1),
	index = role("Sarpanch", W.Heavy, false, 28, 22, 1),
	cta = role("Montserrat", W.Heavy, true, 26, 20, 1),
	section = role("Montserrat", W.Heavy, true, 24, 22, 1),
	resource = role("Montserrat", W.Heavy, true, 22, 18, 1),
	-- titles and labels: ExtraBold (Heavy fuses letters below 20 du); italic only on short titles
	card = role("Montserrat", W.ExtraBold, true, 20, 18, 1.1),
	toast = role("Montserrat", W.ExtraBold, true, 18, 16, 1),
	cardSmall = role("Montserrat", W.ExtraBold, true, 17, 16, 1.1),
	tab = role("Montserrat", W.ExtraBold, true, 16, 15, 1),
	plate = role("Montserrat", W.ExtraBold, false, 13, 12, 1.1, "caps"),
	label = role("Montserrat", W.ExtraBold, false, 14, 13, 1),
	-- numbers under ~20 px: Montserrat. Sarpanch's 8 and 9 merge at these sizes ("1e10,927" read as "1e10,827"), so
	-- it stays on the display sizes above only (words and units go through Rich.num)
	numberHeavy = role("Montserrat", W.ExtraBold, false, 18, 17, 1),
	ctaSub = role("Montserrat", W.Bold, false, 17, 15, 1),
	number = role("Montserrat", W.Bold, false, 16, 15, 1),
	plateNum = role("Montserrat", W.Bold, false, 15, 14, 1.1),
	badge = role("Montserrat", W.ExtraBold, false, 14, 13, 1),
	-- reading text: upright, no outline, real line spacing
	body = role("Montserrat", W.SemiBold, false, 16, 15, 1.3),
	small = role("Montserrat", W.SemiBold, false, 14, 13, 1.25),
	caps = role("Montserrat", W.Bold, false, 13, 12, 1, "caps"),
	plateSub = role("Montserrat", W.ExtraBold, false, 13, 12, 1.1, "caps"),
	terminal = role("RobotoMono", W.Medium, false, 15, 14, 1.35),
	terminalBold = role("RobotoMono", W.Bold, false, 15, 14, 1.35),
}
Theme.ROLES = ROLES
-- rendered floors in px (TextSize x UI scale) on every device row, DESIGN.md 9.5
-- text floors in device points: with aspect scaling (Layout.compute) the design sizes hold down to s .55, so the floors
-- only catch text the design already sets very small
Theme.FLOOR = { caps = 7, text = 8, body = 8 }
Theme.COMPACT_FLOOR = 12

local fonts: { [string]: Font } = {}
function Theme.font(name: string): Font
	local hit = fonts[name]
	if hit then return hit end
	local r = ROLES[name] or ROLES.body
	local f = Font.fromName(r.family, r.weight, if r.italic then Enum.FontStyle.Italic else Enum.FontStyle.Normal)
	fonts[name] = f
	return f
end

local layoutModule: any = nil
local function layout(): any
	if layoutModule == nil then layoutModule = require(script.Parent:WaitForChild("Layout")) :: any end
	return layoutModule
end
-- the TextSize of a role. mode defaults to Layout.mode; s to Layout.s when the mode is the current one, else 1.
-- COMPACT has s >= 1, so its table size is already on screen. WIDE / MEDIUM lift a role until size x s reaches its
-- floor: at s .90 the floor roles (small, label, badge, caps, plateSub) are written one du larger.
function Theme.size(name: string, mode: string?, s: number?): number
	local r = ROLES[name] or ROLES.body
	local floorPx = if r.floor == "caps" then Theme.FLOOR.caps else Theme.FLOOR.text
	local m: string = mode or layout().mode
	if m == "COMPACT" then return math.max(r.compact, floorPx) end
	local sc: number = s or (if mode == nil then layout().s else 1)
	return math.max(r.wide, math.ceil(floorPx / math.max(sc, 0.01) - 1e-6))
end
-- the role's LineHeight: 1 for single-line roles, 1.1 for titles that wrap, 1.25-1.35 for running text
function Theme.lineHeight(name: string): number
	return (ROLES[name] or ROLES.body).lh
end
-- FontFace + TextSize + LineHeight of a role on a TextLabel / TextButton / TextBox: the one way a label gets its type
function Theme.text(l: GuiObject, name: string, mode: string?)
	local t = l :: any
	t.FontFace = Theme.font(name)
	t.TextSize = Theme.size(name, mode)
	t.LineHeight = Theme.lineHeight(name)
end

-- ------------------------------------------------------------------------------------------------------ capabilities
export type Caps = {
	UIShadow: boolean,
	Radial: boolean,
	Conical: boolean,
	TileMode: boolean,
	BorderStrokePosition: boolean,
	Path2D: boolean,
	PerCorner: boolean,
	InputSink: boolean,
}
-- every flag false until detect() ran: the plain fallbacks are always safe
Theme.caps = {
	UIShadow = false,
	Radial = false,
	Conical = false,
	TileMode = false,
	BorderStrokePosition = false,
	Path2D = false,
	PerCorner = false,
	InputSink = false,
} :: Caps
local detected = false

local function probe(fn: () -> ()): boolean
	local ok = pcall(fn)
	return ok
end
-- pcall probes on throwaway instances (DESIGN.md 13.1). In Studio, the LocalPlayer attribute MT_ForceCaps
-- ("Radial,Path2D" or "all") forces flags off to check the fallbacks.
function Theme.detect(force: boolean?): Caps
	if detected and not force then return Theme.caps end
	detected = true
	local caps = Theme.caps
	-- each probe writes every property the client sets: a property that exists but is locked to Roblox's own scripts
	-- ("lacking capability RobloxScript", seen on UIShadow.Transparency in Studio) turns the feature off
	caps.UIShadow = probe(function()
		local s = Instance.new("UIShadow") :: any
		s.Color = Color3.new(1, 1, 1)
		s.Transparency = 0.5
		s.BlurRadius = UDim.new(0, 8)
		s.Spread = UDim2.fromOffset(0, 0)
		s.Offset = UDim2.new()
		s:Destroy()
	end)
	caps.Radial = probe(function()
		local g = Instance.new("UIGradient")
		g.Type = Enum.GradientType.Radial
		g:Destroy()
	end)
	caps.Conical = probe(function()
		local g = Instance.new("UIGradient")
		g.Type = Enum.GradientType.Conical
		g:Destroy()
	end)
	caps.TileMode = probe(function()
		local g = Instance.new("UIGradient")
		g.TileMode = Enum.GradientTileMode.Repeat
		g.Scale = 0.1
		g:Destroy()
	end)
	caps.BorderStrokePosition = probe(function()
		local s = Instance.new("UIStroke")
		s.BorderStrokePosition = Enum.BorderStrokePosition.Outer
		s:Destroy()
	end)
	caps.Path2D = probe(function()
		local p = Instance.new("Path2D") :: any
		p.Color3 = Color3.new(1, 1, 1)
		p.Thickness = 2
		p.Transparency = 0
		p.ZIndex = 1
		p.Visible = true
		p:SetControlPoints({ Path2DControlPoint.new(UDim2.fromScale(0, 0)), Path2DControlPoint.new(UDim2.fromScale(1, 1)) })
		p:Destroy()
	end)
	caps.PerCorner = probe(function()
		local c = Instance.new("UICorner")
		c.TopLeftRadius = UDim.new(0, 4)
		c:Destroy()
	end)
	caps.InputSink = probe(function()
		local f = Instance.new("Frame")
		f.InputSink = Enum.InputSink.None
		f:Destroy()
	end)
	-- features that are a Studio-only beta stay off unless shared/Flags says they are live (so Studio shows what
	-- players see)
	pcall(function()
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local shared = ReplicatedStorage:FindFirstChild("MilestoneTree")
		local mod = if shared then shared:FindFirstChild("Flags") else nil
		local flags: any = if mod and mod:IsA("ModuleScript") then require(mod) :: any else nil
		if not (flags and flags.BETA_GRADIENTS == true) then
			caps.Radial, caps.Conical, caps.TileMode = false, false, false
		end
	end)
	-- Studio only: force flags off
	pcall(function()
		local RunService = game:GetService("RunService")
		if not RunService:IsStudio() then return end
		local lp = game:GetService("Players").LocalPlayer
		local forced = if lp then lp:GetAttribute("MT_ForceCaps") else nil
		if type(forced) ~= "string" or forced == "" then return end
		for name in string.gmatch(forced, "[%w]+") do
			if name == "all" then
				for k in caps :: any do (caps :: any)[k] = false end
			elseif (caps :: any)[name] ~= nil then
				(caps :: any)[name] = false
			end
		end
	end)
	local list = {}
	for _, k in { "UIShadow", "Radial", "Conical", "TileMode", "BorderStrokePosition", "Path2D", "PerCorner", "InputSink" } do
		table.insert(list, k .. "=" .. tostring((caps :: any)[k]))
	end
	print("[MilestoneTree] caps " .. table.concat(list, " "))
	return caps
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="94">
            <Properties>
              <string name="Name">ViewStore</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ViewStore: the client's copy of the view (plan 1.8, 2.4). Pure data: no Roblox services, no instances.

	    local store = ViewStore.new()
	    local changes = store:apply(patch)      -- full clears everything; del then set; returns what changed per root
	    store:map()                             -- MapState, rebuilt only after the map root changed
	    store:hud(), store:endScreen(), store:get(id), store:kids(id)

	Nodes arrive flattened: ids are paths ("map.3.1"), a container's `c` lists its children's ids, and the roots are
	"map", "hud" and "tab". The map list is fixed (all 21
	layers in ORDER, then the gate), but this reads nodes by their `t` / `id`, never by position.
]]

local Types = require(script.Parent.Parent:WaitForChild("Types"))

type Patch = Types.Patch
type Changes = Types.Changes
type MapState = Types.MapState
type MapNode = Types.MapNode
type Val = Types.Val
type Gate = Types.Gate
type HudState = Types.HudState
type EndScreen = Types.EndScreen
type Action = Types.Action

export type Store = {
	nodes: { [string]: any },
	tab: string,
	keys: { [string]: true },
	ended: boolean,
	tabStyle: { [string]: string },
	_map: MapState?,
	_hud: HudState?,
	_hudDirty: boolean,
	apply: (self: Store, patch: Patch) -> Changes,
	get: (self: Store, id: string) -> any?,
	kids: (self: Store, id: string) -> { string },
	map: (self: Store) -> MapState,
	hud: (self: Store) -> HudState?,
	endScreen: (self: Store) -> EndScreen?,
}

local ViewStore = {}

-- the fixed map order (plan 1.2): ids map.1 .. map.21, the gate is map.22
local ORDER: { string } = table.freeze({
	"ach", "m", "mm", "em", "p", "pe", "sp", "pb", "pp", "se", "hp", "ep", "hb", "ap", "mp", "t", "pm", "pep", "cp", "cm", "ex",
})
ViewStore.ORDER = ORDER

-- nil, false and a missing key all mean "none"
local function truthy(v: any): boolean
	return v ~= nil and v ~= false
end
local function str(v: any): string?
	return if type(v) == "string" then v elseif type(v) == "number" then tostring(v) else nil
end
local function num(v: any): number?
	return if type(v) == "number" then v else nil
end
local function action(v: any): Action?
	return if type(v) == "table" and #v > 0 then v else nil
end
local function rootOf(id: string): string
	local dot = string.find(id, ".", 1, true)
	return if dot then string.sub(id, 1, dot - 1) else id
end

local function emptyMap(): MapState
	return { ok = false, inside = false, open = nil, close = nil, opt = nil, gate = nil, order = ORDER, nodes = {}, ready = {}, canBuy = {} }
end

local function readVal(n: any): Val
	return {
		t = "val",
		can = truthy(n.can),
		lit = truthy(n.lit),
		glow = truthy(n.glow),
		pulse = truthy(n.pulse),
		pts = str(n.pts),
		res = str(n.res),
		tip = str(n.tip),
		ra = action(n.ra),
		req = str(n.req),
		rres = str(n.rres),
		gain = str(n.gain),
		pr = num(n.pr),
		tot = str(n.tot),
	}
end

local function readGate(self: Store, n: any): Gate
	local req: Types.GateReq? = nil
	if type(n.req) == "table" then
		req = { have = str(n.req.have) or "0", need = str(n.req.need) or "185", pr = num(n.req.pr) or 0 }
	end
	local rs: { string } = {}
	if type(n.rs) == "table" then
		for _, l in n.rs do
			if type(l) == "string" then table.insert(rs, l) end
		end
	end
	return {
		t = "gate",
		show = truthy(n.show),
		inside = truthy(n.inside),
		can = truthy(n.can),
		fin = truthy(n.fin),
		h = str(n.h),
		goal = str(n.goal),
		done = truthy(n.done),
		a = action(n.a),
		req = req,
		rs = rs,
	}
end

local function readNode(self: Store, n: any): MapNode
	local node: MapNode = {
		t = "node",
		id = n.id,
		show = truthy(n.show),
		dor = truthy(n.dor),
		unl = if n.unl ~= nil then truthy(n.unl) else nil,
		col = str(n.col),
		sym = str(n.sym),
		name = str(n.name),
		st = if type(n.st) == "table" then n.st else nil,
		tab = str(n.tab),
		ch = num(n.ch),
		cur = if n.cur ~= nil then truthy(n.cur) else nil,
		br = nil,
		a = action(n.a),
		val = nil,
	}
	if type(n.br) == "table" then
		local br = {}
		for _, b in n.br do
			if type(b) == "table" and type(b.to) == "string" then
				table.insert(br, { to = b.to, col = str(b.col) or "#ffffff", w = num(b.w) })
			end
		end
		node.br = br
	end
	if type(n.c) == "table" then
		for _, cid in n.c do
			local child = if type(cid) == "string" then self.nodes[cid] else nil
			if type(child) == "table" and child.t == "val" then
				node.val = readVal(child)
				break
			end
		end
	end
	return node
end

local function buildMap(self: Store): MapState
	local root = self.nodes.map
	if type(root) ~= "table" or root.t ~= "map" then return emptyMap() end
	local ms = emptyMap()
	ms.ok = true
	ms.inside = truthy(root.inside)
	ms.open = str(root.open)
	ms.close = action(root.close)
	ms.opt = action(root.opt)
	for _, cid in (if type(root.c) == "table" then root.c else {}) :: { any } do
		local n = if type(cid) == "string" then self.nodes[cid] else nil
		if type(n) ~= "table" then continue end
		if n.t == "node" and type(n.id) == "string" then
			ms.nodes[n.id] = readNode(self, n)
		elseif n.t == "gate" then
			ms.gate = readGate(self, n)
		end
	end
	for _, l in ORDER do
		local n = ms.nodes[l]
		local v = if n and n.show then n.val else nil
		if v then
			if v.pulse then
				table.insert(ms.ready, l)
			elseif v.glow then
				table.insert(ms.canBuy, l)
			end
		end
	end
	return ms
end

local function buildHud(self: Store): HudState?
	local n = self.nodes.hud
	if type(n) ~= "table" or n.t ~= "hud" then return nil end
	local w: { Types.HudWarn } = {}
	if type(n.w) == "table" then
		for _, x in n.w do
			if type(x) == "table" and type(x.k) == "string" then
				table.insert(w, { k = x.k, v = str(x.v) or "", e = str(x.e) or "" })
			end
		end
	end
	return {
		t = "hud",
		pts = str(n.pts) or "0",
		name = str(n.name) or "points",
		gen = str(n.gen),
		dev = str(n.dev),
		pass = str(n.pass),
		off = str(n.off),
		w = w,
		wh = str(n.wh),
		x = str(n.x),
		fr = truthy(n.fr),
	}
end

function ViewStore.new(): Store
	local self = {
		nodes = {},
		tab = "none",
		keys = {},
		ended = false,
		tabStyle = {},
		_map = nil,
		_hud = nil,
		_hudDirty = true,
	} :: Store

	function self.apply(s: Store, patch: Patch): Changes
		local changes: Changes = {
			full = patch.full == true,
			map = false,
			hud = false,
			tab = false,
			tabName = false,
			keys = false,
			ended = false,
			mapIds = {},
			tabPatch = { set = {}, del = {}, full = patch.full == true },
		}
		local function touch(id: string)
			local r = rootOf(id)
			if r == "map" then
				changes.map = true
				changes.mapIds[id] = true
			elseif r == "hud" then
				changes.hud = true
			elseif r == "tab" then
				changes.tab = true
			end
		end
		if patch.full then
			table.clear(s.nodes)
			changes.map, changes.hud, changes.tab = true, true, true
		end
		if type(patch.del) == "table" then
			for _, id in patch.del do
				if type(id) ~= "string" then continue end
				s.nodes[id] = nil
				touch(id)
				if rootOf(id) == "tab" then table.insert(changes.tabPatch.del, id) end
			end
		end
		if type(patch.set) == "table" then
			for id, n in patch.set do
				if type(id) ~= "string" then continue end
				s.nodes[id] = n
				touch(id)
				if rootOf(id) == "tab" then changes.tabPatch.set[id] = n end
			end
		end
		if type(patch.tab) == "string" and patch.tab ~= s.tab then
			s.tab = patch.tab
			changes.tabName = true
		end
		if type(patch.keys) == "table" then
			local k: { [string]: true } = {}
			for _, name in patch.keys do
				if type(name) == "string" then k[name] = true end
			end
			s.keys = k
			changes.keys = true
		end
		if patch.ended ~= nil then
			local e = patch.ended == true
			if e ~= s.ended then changes.ended = true end
			s.ended = e
		end
		if type(patch.tabStyle) == "table" then s.tabStyle = patch.tabStyle end
		if changes.map then s._map = nil end
		if changes.hud then s._hudDirty = true end
		return changes
	end

	function self.get(s: Store, id: string): any?
		return s.nodes[id]
	end

	function self.kids(s: Store, id: string): { string }
		local n = s.nodes[id]
		if type(n) == "table" and type(n.c) == "table" then return n.c end
		return {}
	end

	function self.map(s: Store): MapState
		local m = s._map
		if m == nil then
			m = buildMap(s)
			s._map = m
		end
		return m :: MapState
	end

	function self.hud(s: Store): HudState?
		if s._hudDirty then
			s._hud = buildHud(s)
			s._hudDirty = false
		end
		return s._hud
	end

	-- the end screen (plan 1.5): the tab root carries win / took; its two buttons carry the opt actions
	function self.endScreen(s: Store): EndScreen?
		if not s.ended then return nil end
		local root = s.nodes.tab
		if type(root) ~= "table" then return nil end
		local out: EndScreen = { win = str(root.win), took = str(root.took), again = nil, keep = nil }
		local function walk(id: string, depth: number)
			if depth > 6 then return end
			local n = s.nodes[id]
			if type(n) ~= "table" then return end
			local a = action(n.a)
			if a and a[1] == "opt" then
				if a[2] == "playAgain" then
					out.again = a
				elseif a[2] == "keepGoing" then
					out.keep = a
				end
			end
			if type(n.c) == "table" then
				for _, cid in n.c do
					if type(cid) == "string" then walk(cid, depth + 1) end
				end
			end
		end
		walk("tab", 0)
		return out
	end

	return self
end

return ViewStore
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="95">
          <Properties>
            <string name="Name">Hud</string>
          </Properties>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">Band</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Band: the COMPACT panel band (DESIGN.md 5.10) that replaces the capsule while a full-screen panel is open on a
	phone: the layer's emblem, its title (R3, `title` COMPACT step), the READY switcher (up to 3 mini gems of the other
	READY layers + "+N" after a bolt; a tap opens that layer) and a 44 du close button left of the Roblox "···".

	    local part = Band.new(parent)
	    part:show(layer?, title?, sym?)   part:setReady({ { layer, sym } })   part.close ()   part.switch (layer)
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Signal = require(Core:WaitForChild("Signal"))
local Theme = require(Core:WaitForChild("Theme"))
local Sleek = require(Core:WaitForChild("Sleek"))
local Kit = require(script.Parent:WaitForChild("Kit"))
local Ready = require(script.Parent:WaitForChild("Ready"))

export type Entry = { layer: string, sym: string }
export type Band = {
	frame: Frame,
	close: Signal.Signal<>,
	switch: Signal.Signal<string>,
	show: (self: Band, layer: string?, title: string?, sym: string?) -> (),
	setReady: (self: Band, list: { Entry }) -> (),
	destroy: (self: Band) -> (),
}

local Band = {}

function Band.new(parent: GuiObject): Band
	local self = {} :: Band
	self.close = Signal.new() :: Signal.Signal<>
	self.switch = Signal.new() :: Signal.Signal<string>
	local f = Kit.frame(parent, "PanelBand", 8)
	f.AnchorPoint = Vector2.new(0.5, 0)
	f.Position = UDim2.new(0.5, 0, 0, 6)
	f.Size = UDim2.new(1, -24, 0, 44)
	Sleek.plate(f, { alpha = 0.92, line = 0.86 })
	f.Visible = false
	local rim = Sleek.accent(f, Theme.C.text, 14, 56, { name = "Rim" })
	local title = Kit.label(f, "Title", "section", "", Color3.new(1, 1, 1))
	title.Position = UDim2.fromOffset(50, 0)
	title.Size = UDim2.new(1, -110, 1, 0)
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextTruncate = Enum.TextTruncate.AtEnd
	Kit.textStroke(title, 0)
	local closeB = Kit.button(f, "Close")
	closeB.AnchorPoint = Vector2.new(1, 0.5)
	closeB.Position = UDim2.new(1, -4, 0.5, 0)
	closeB.Size = UDim2.fromOffset(44, 44)
	local x = Kit.glyph(closeB, "Icon", "x", Color3.new(1, 1, 1))
	x.AnchorPoint = Vector2.new(0.5, 0.5)
	x.Position = UDim2.fromScale(0.5, 0.5)
	x.Size = UDim2.fromOffset(18, 18)
	closeB.Activated:Connect(function() self.close:Fire() end)
	self.frame = f
	-- the READY switcher, left of the close
	local sw = Kit.frame(f, "Switch", 9)
	sw.AnchorPoint = Vector2.new(1, 0.5)
	sw.Position = UDim2.new(1, -54, 0.5, 0)
	sw.Size = UDim2.fromOffset(0, 38)
	sw.AutomaticSize = Enum.AutomaticSize.X
	Kit.list(sw, "x", 2, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	local current: string? = nil
	local entries: { Entry } = {}
	local swW = 0
	local function drawSwitch()
		for _, c in sw:GetChildren() do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		local shown, more = 0, 0
		for _, e in entries do
			if e.layer ~= current then
				if shown < 3 then
					shown += 1
					local b = Kit.button(sw, "Gem_" .. e.layer)
					b.LayoutOrder = 1 + shown
					b.Size = UDim2.fromOffset(28, 38)
					local g = Ready.gem(b, "Disc", e.layer, e.sym, 28)
					g.AnchorPoint = Vector2.new(0.5, 0.5)
					g.Position = UDim2.fromScale(0.5, 0.5)
					local layer = e.layer
					b.Activated:Connect(function() self.switch:Fire(layer) end)
				else
					more += 1
				end
			end
		end
		swW = 0
		if shown > 0 then
			local bolt = Kit.glyph(sw, "Bolt", "bolt", Color3.fromHex("ffe08a"))
			bolt.LayoutOrder = 1
			bolt.Size = UDim2.fromOffset(14, 14)
			swW = 16 + shown * 30
		end
		if more > 0 then
			local m = Kit.label(sw, "More", "badge", "+" .. more, Color3.fromHex("ffe08a"))
			m.LayoutOrder = 10
			m.AutomaticSize = Enum.AutomaticSize.X
			m.Size = UDim2.fromOffset(0, 38)
			swW += 30
		end
		title.Size = UDim2.new(1, -110 - swW, 1, 0)
	end
	function self.setReady(_: Band, list: { Entry })
		local sig = ""
		for _, e in list do sig ..= e.layer .. "," end
		if sw:GetAttribute("Sig") == sig .. tostring(current) then return end
		sw:SetAttribute("Sig", sig .. tostring(current))
		entries = list
		drawSwitch()
	end
	function self.show(_: Band, layer: string?, text: string?, sym: string?)
		if layer == nil then
			f.Visible = false
			current = nil
			return
		end
		if current ~= layer then
			current = layer
			sw:SetAttribute("Sig", nil)
			drawSwitch()
		end
		-- Sleek: the layer's diamond and a white title; the hue lives on the top accent
		local old = f:FindFirstChild("Emblem")
		if old and not old:FindFirstChild("Outer") then old:Destroy() end
		local hue = Theme.hue(layer)
		local g = Sleek.diamond(f, "Emblem", hue, 32)
		g.AnchorPoint = Vector2.new(0, 0.5)
		g.Position = UDim2.new(0, 10, 0.5, 0)
		local symL = Kit.label(g, "Symbol", "badge", sym or string.upper(layer), Color3.new(1, 1, 1))
		symL.Size = UDim2.fromScale(1, 1)
		symL.TextXAlignment = Enum.TextXAlignment.Center
		symL.ZIndex = g.ZIndex + 2
		rim.BackgroundColor3 = hue
		title.Text = string.upper(text or layer)
		Theme.text(title, "section")
		title.TextSize = 20
		f.Visible = true
	end
	function self.destroy(b: Band)
		b.close:DisconnectAll()
		b.switch:DisconnectAll()
		f:Destroy()
	end
	return self
end

return Band
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">Capsule</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Capsule: the points capsule (DESIGN.md 4.3), in TopbarGui under the Roblox top bar, centred on the SCREEN (the
	top bar's safe area is shifted right by Roblox's own buttons, so its middle is not the screen's).

	    Capsule   640 x 84 (COMPACT 380 x 52), the hero look: dark slab, gold accent, the amount in the panel hero's
	              heavy face (46 du) with a gold glow
	      Coin    Ø68 gold disc breaking out on the left, a spinning star (6 s / rev)
	      Label   "POINTS · NORMAL UNIVERSE" (`caps`, #ffe9a3; not on COMPACT), then the passes in gold
	              ("· 2× SPEED · SUPPORTER", from the player's MT_Perks attribute); a Supporter gets a gold rim
	      Row     Amount (R4 gold gradient number, `capsule` role, steps 34 -> 30 -> 26 past 250 du, left anchored)
	              + Unit ("points" / "pts")
	      GenPill the rate (Rich.num) on a dark green pill hanging from the rim; hidden when hud.gen is nil
	      Warn    a chip right of the capsule with the first warning value; tap -> warnTap (the tooltip lists all)
	      Status  SAVING... / SAVED / NOT SAVING / RECONNECTING... under the pill
	      Info    the game's other head lines under them (hud.x: sp challenge 11's ashes, a burning Spark Milestone;
	              hud.off offline time; hud.dev dev speed; hud.pass as 2× SPEED · ACTIVE), `small` on a glass chip; bottom() counts it

	    local part = Capsule.new(parent)
	    part:update(h)   part:setStatus(kind)   part:setUniverse(inside)   part:setFirstRun(b)   part.warnTap
	    part:rects() -> { capsule, pill?, warn?, status? } (abs space; Hud registers them with Layout)
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Signal = require(Core:WaitForChild("Signal"))
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Motion = require(Core:WaitForChild("Motion"))
local Rich = require(Core:WaitForChild("Rich"))
local Recipes = require(Core:WaitForChild("Recipes"))
local Sleek = require(Core:WaitForChild("Sleek"))
local Skin = require(Core:WaitForChild("Skin"))
local Kit = require(script.Parent:WaitForChild("Kit"))

type ARect = Types.Rect

export type Capsule = {
	frame: Frame,
	pill: Frame,
	warn: Frame,
	status: Frame,
	info: Frame,
	warnTap: Signal.Signal<Vector2>,
	changed: Signal.Signal<>, -- a part moved, appeared or disappeared (Hud re-registers the rects)
	update: (self: Capsule, h: Types.HudState) -> (),
	setStatus: (self: Capsule, kind: string?) -> (),
	setUniverse: (self: Capsule, inside: boolean) -> (),
	setFirstRun: (self: Capsule, b: boolean) -> (),
	setCentre: (self: Capsule, x: number?) -> (),
	centre: (self: Capsule) -> number?,
	bottom: (self: Capsule) -> number, -- du below the Root top where things can hang (pill / status)
	destroy: (self: Capsule) -> (),
}

local Capsule = {}

local GOLD = Color3.fromHex("ffc233")
local GOLD_D = Color3.fromHex("ffd34d")
local CREAM = Color3.fromHex("ffe9a3")
local GOOD = Color3.fromHex("8ff0ad")

local STATUS: { [string]: { text: string, color: Color3, glyph: string } } = {
	saving = { text = "Saving…", color = GOLD, glyph = "clock" },
	saved = { text = "Saved", color = Theme.C.bought, glyph = "check" },
	off = { text = "Not saving", color = Theme.C.danger, glyph = "warn" },
	reconnecting = { text = "Reconnecting…", color = Theme.C.info, glyph = "swirl" },
}

function Capsule.new(parent: GuiObject): Capsule
	local self = {} :: Capsule
	self.warnTap = Signal.new() :: Signal.Signal<Vector2>
	self.changed = Signal.new() :: Signal.Signal<>

	-- Sleek: a translucent slab with a hairline, corner ticks and a gold accent; a gold diamond instead of the coin
	local f = Kit.frame(parent, "Capsule", 5)
	f.AnchorPoint = Vector2.new(0.5, 0)
	Sleek.plate(f, { alpha = 0.88, line = 0.86 })
	Sleek.ticks(f, { len = 10, th = 2, out = 1, color = Color3.new(1, 1, 1), alpha = 0.8, z = 9 })
	Sleek.accent(f, GOLD_D, 24, 64, { name = "Accent" })
	Skin.apply(f, "plate", { scale = 0.5 })
	self.frame = f

	local coin = Sleek.diamond(f, "Coin", GOLD_D, 44, { fill = 0, inner = false })
	coin.AnchorPoint = Vector2.new(0, 0.5)
	coin.ZIndex = 6
	local core = Kit.frame(coin, "Core", 7)
	core.AnchorPoint = Vector2.new(0.5, 0.5)
	core.Position = UDim2.fromScale(0.5, 0.5)
	core.Size = UDim2.fromOffset(8, 8)
	core.Rotation = 45
	core.BackgroundColor3 = GOLD_D
	core.BackgroundTransparency = 0

	local label = Kit.label(f, "Label", "caps", "", Sleek.C.soft)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Size = UDim2.fromOffset(420, 13)

	local row = Kit.frame(f, "Row", 6)
	row.AutomaticSize = Enum.AutomaticSize.X
	Kit.list(row, "x", 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Bottom)
	local amount = Kit.label(row, "Amount", "capsule", "0", Color3.new(1, 1, 1))
	amount.LayoutOrder = 1
	amount.AutomaticSize = Enum.AutomaticSize.X
	amount.TextXAlignment = Enum.TextXAlignment.Left
	amount.TextYAlignment = Enum.TextYAlignment.Bottom
	local unit = Kit.label(row, "Unit", "small", "points", Sleek.C.soft)
	unit.LayoutOrder = 2
	unit.FontFace = Font.fromName("Montserrat", Enum.FontWeight.Bold)
	unit.AutomaticSize = Enum.AutomaticSize.X
	unit.TextYAlignment = Enum.TextYAlignment.Bottom

	-- the rate: a hairline divider, then a sparkline of the last minute over the "↑ rate" line (inside the slab)
	local divider = Kit.frame(f, "Divider", 6)
	divider.BackgroundColor3 = Color3.new(1, 1, 1)
	divider.BackgroundTransparency = Sleek.LINE
	local pill = Kit.frame(parent, "GenPill", 7)
	pill.AnchorPoint = Vector2.new(0.5, 0)
	pill.AutomaticSize = Enum.AutomaticSize.X
	Kit.list(pill, "x", 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local up = Kit.glyph(pill, "Up", "up", GOOD)
	up.LayoutOrder = 1
	local pillLabel = Kit.label(pill, "Label", "number", "", GOOD)
	pillLabel.LayoutOrder = 2
	pillLabel.RichText = true
	pillLabel.AutomaticSize = Enum.AutomaticSize.X
	pill.Visible = false
	self.pill = pill
	local spark = Kit.frame(parent, "Spark", 7)
	spark.AnchorPoint = Vector2.new(0.5, 0)
	spark.Visible = false
	local history: { number } = {}
	local lastSample = -math.huge

	-- the warning chip
	local warn = Kit.frame(parent, "Warn", 6)
	warn.AnchorPoint = Vector2.new(0, 0.5)
	warn.AutomaticSize = Enum.AutomaticSize.X
	Sleek.plate(warn, { alpha = 0.88, line = 0.86, edge = false })
	Kit.stroke(warn, 1, GOLD, 0.5, "Rim").LineJoinMode = Enum.LineJoinMode.Miter
	local wContent = Kit.frame(warn, "Content")
	wContent.AutomaticSize = Enum.AutomaticSize.X
	wContent.Size = UDim2.fromScale(0, 1)
	Kit.list(wContent, "x", 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local wIcon = Kit.glyph(wContent, "Icon", "warn", GOLD)
	wIcon.LayoutOrder = 1
	local wLabel = Kit.label(wContent, "Label", "badge", "", Color3.new(1, 1, 1))
	wLabel.LayoutOrder = 2
	wLabel.RichText = true
	wLabel.AutomaticSize = Enum.AutomaticSize.X
	local wHit = Kit.button(warn, "Hit")
	wHit.Size = UDim2.new(1, 0, 1, 12)
	wHit.Position = UDim2.fromOffset(0, -6)
	wHit.ZIndex = 5
	wHit.Activated:Connect(function()
		local p, s = warn.AbsolutePosition, warn.AbsoluteSize
		self.warnTap:Fire(Vector2.new(p.X + s.X / 2, p.Y + s.Y))
	end)
	warn.Visible = false
	self.warn = warn

	-- the status chip
	local status = Kit.frame(parent, "Status", 6)
	status.AnchorPoint = Vector2.new(0.5, 0)
	status.AutomaticSize = Enum.AutomaticSize.X
	Sleek.plate(status, { alpha = 0.88, line = 0.86, edge = false })
	local sRim = Kit.stroke(status, 1, GOLD, 0.6, "Rim")
	sRim.LineJoinMode = Enum.LineJoinMode.Miter
	Kit.list(status, "x", 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local sLabel = Kit.label(status, "Label", "label", "", Color3.new(1, 1, 1))
	sLabel.LayoutOrder = 2
	sLabel.AutomaticSize = Enum.AutomaticSize.X
	status.Visible = false
	self.status = status

	-- the game's other head lines (sp challenge 11's ashes, a burning Spark Milestone, offline time, dev speed)
	local info = Kit.frame(parent, "Info", 6)
	info.AnchorPoint = Vector2.new(0.5, 0)
	info.AutomaticSize = Enum.AutomaticSize.Y
	Sleek.plate(info, { alpha = 0.88, line = 0.86, edge = false })
	local iLabel = Kit.label(info, "Label", "small", "", Theme.C.text)
	iLabel.AutomaticSize = Enum.AutomaticSize.Y
	iLabel.Size = UDim2.fromScale(1, 0)
	iLabel.TextWrapped = true
	iLabel.RichText = true
	iLabel.TextXAlignment = Enum.TextXAlignment.Center
	info.Visible = false
	self.info = info
	info:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self.changed:Fire()
	end)

	-- ------------------------------------------------------------------------------------------ layout
	local compact = false
	local inside = false
	local firstRun = false
	local hud: Types.HudState? = nil
	local statusKind: string? = nil
	local savedToken = 0

	local W_WIDE, H_WIDE, W_COMPACT, H_COMPACT = 640, 84, 380, 52
	-- the capsule's centre: the screen's middle in the parent's du, or a du x (over the map strip while a side sheet is
	-- open)
	local centreX: number? = nil
	local function screenCx(): number
		local cam = workspace.CurrentCamera
		local vw = if cam then cam.ViewportSize.X else 1920
		if parent.AbsoluteSize.X <= 0 then return vw / 2 / math.max(Layout.s, 0.01) end
		return (vw / 2 - parent.AbsolutePosition.X) / math.max(Layout.s, 0.01)
	end
	local function at(dx: number, y: number): UDim2
		return UDim2.fromOffset((centreX or screenCx()) + dx, y)
	end
	local function place()
		compact = Layout.mode == "COMPACT"
		local w, h = if compact then W_COMPACT else W_WIDE, if compact then H_COMPACT else H_WIDE
		f.Size = UDim2.fromOffset(w, h)
		f.Position = at(0, 4)
		local cd = if compact then 34 else 52
		Sleek.diamond(f, "Coin", GOLD_D, cd, { fill = 0, inner = false })
		coin.Position = UDim2.new(0, if compact then 10 else 16, 0.5, 0)
		core.Size = UDim2.fromOffset(if compact then 6 else 8, if compact then 6 else 8)
		local x0 = (if compact then 10 else 16) + cd + (if compact then 10 else 16)
		label.Visible = not compact
		label.Position = UDim2.fromOffset(x0, 12)
		Theme.text(label, "caps")
		row.Position = UDim2.fromOffset(x0, if compact then 4 else 26)
		row.Size = UDim2.fromOffset(0, if compact then 44 else 52)
		amount.Size = UDim2.fromScale(0, 1)
		unit.Size = UDim2.fromScale(0, 1)
		Theme.text(unit, if compact then "label" else "small")
		unit.FontFace = Font.fromName("Montserrat", Enum.FontWeight.Bold)
		local pad = Kit.child(unit, "Pad", "UIPadding") :: UIPadding
		pad.PaddingBottom = UDim.new(0, if compact then 5 else 6)
		-- the rate column on the right of the slab
		local rx = if compact then 120 else 190 -- the column's width from the right edge
		divider.Position = UDim2.new(1, -rx - 14, 0, 12)
		divider.Size = UDim2.new(0, 1, 1, -24)
		divider.Visible = true
		pill.Size = UDim2.fromOffset(0, 18)
		pill.AnchorPoint = Vector2.new(0, 0)
		pill.Position = at(w / 2 - rx, 4 + (if compact then 17 else 50))
		Theme.text(pillLabel, "number")
		pillLabel.TextSize = if compact then 13 else 14
		pillLabel.Size = UDim2.fromScale(0, 1)
		local gs = if compact then 11 else 12
		up.Size = UDim2.fromOffset(gs, gs)
		spark.AnchorPoint = Vector2.new(0, 0)
		spark.Position = at(w / 2 - rx, 4 + 14)
		spark.Size = UDim2.fromOffset(rx - 16, 28)
		-- warn: right of the capsule
		warn.Size = UDim2.fromOffset(0, if compact then 26 else 30)
		warn.Position = at(w / 2 + 14, 4 + h / 2)
		Kit.pad(warn, 0, 10, 0, 8)
		wIcon.Size = UDim2.fromOffset(16, 16)
		Theme.text(wLabel, "badge")
		wLabel.Size = UDim2.fromScale(0, 1)
		-- status: under the capsule
		status.Size = UDim2.fromOffset(0, 28)
		Kit.pad(status, 0, 10, 0, 8)
		Theme.text(sLabel, "label")
		sLabel.Size = UDim2.fromScale(0, 1)
		info.Size = UDim2.fromOffset(if compact then 340 else 460, 0)
		Kit.pad(info, 6, 12, 6, 12)
		Theme.text(iLabel, "small")
		self.changed:Fire()
	end
	-- the sparkline: one sample of the points' magnitude every 2 s, the last 30 (one minute)
	local function sample(pts: string)
		local now = os.clock()
		if now - lastSample < 2 and #history > 0 then
			history[#history] = Sleek.mag(pts) or history[#history]
		else
			lastSample = now
			local m = Sleek.mag(pts)
			if m then
				table.insert(history, m)
				if #history > 30 then table.remove(history, 1) end
			end
		end
		local show = not compact and not firstRun and pill.Visible and #history >= 1
		spark.Visible = show
		if show then
			Sleek.spark(spark, "Line", history, GOOD, { w = spark.Size.X.Offset, h = 28, thick = 1.8 })
		end
	end

	local function statusY(): number
		local h = if compact then H_COMPACT else H_WIDE
		return 4 + h + 8
	end

	local function infoY(): number
		local y = statusY()
		if status.Visible then y += 28 + 6 end
		return y
	end
	local infoText = ""
	local function writeInfo(h: Types.HudState?)
		local parts = {}
		if h and not firstRun then
			if type(h.x) == "string" and h.x ~= "" then table.insert(parts, Rich.html(h.x, Theme.size("small"), nil)) end
			if type(h.off) == "string" then table.insert(parts, Rich.caps("Offline time") .. "  " .. Rich.num(h.off, { size = Theme.size("small") })) end
			if type(h.dev) == "string" then table.insert(parts, Rich.caps("Dev speed") .. "  " .. Rich.num(h.dev, { size = Theme.size("small") })) end
			if type(h.pass) == "string" then
				table.insert(parts, '<font color="#ffc93c">' .. Rich.caps(h.pass .. " Speed") .. "  ·  " .. Rich.caps("Active") .. "</font>")
			end
		end
		local t = table.concat(parts, "\n")
		if t ~= infoText then
			infoText = t
			iLabel.Text = t
		end
		local show = t ~= ""
		info.Position = at(0, infoY())
		if info.Visible ~= show then
			info.Visible = show
			self.changed:Fire()
		end
	end

	-- the player's passes (MT_Perks, set by the server): 2x SPEED and SUPPORTER ride on the label in gold
	local function perkText(): string
		local lp = game:GetService("Players").LocalPlayer
		local raw = if lp then lp:GetAttribute("MT_Perks") else nil
		if type(raw) ~= "string" then return "" end
		local ok, list = pcall(function() return game:GetService("HttpService"):JSONDecode(raw) end)
		if not ok or type(list) ~= "table" then return "" end
		local out = ""
		for _, k in { "speed", "supporter" } do
			if table.find(list, k) then
				out ..= '<font color="#ffc93c">' .. Rich.caps(if k == "speed" then "  ·  2× Speed" else "  ·  Supporter") .. "</font>"
			end
		end
		return out
	end
	local function writeLabel()
		label.RichText = true
		label.Text = Rich.caps(if inside then "Points · Prestige Multiverse" else "Points · Normal Universe") .. perkText()
		-- the Supporter pass: a gold rim around the bar
		local lp = game:GetService("Players").LocalPlayer
		local raw = if lp then lp:GetAttribute("MT_Perks") else nil
		if type(raw) == "string" and string.find(raw, '"supporter"', 1, true) then
			Kit.stroke(f, 2, GOLD_D, 0.1, "SupporterRim").LineJoinMode = Enum.LineJoinMode.Miter
		else
			local rim = f:FindFirstChild("SupporterRim")
			if rim then rim:Destroy() end
		end
		Sleek.accent(f, if inside then Theme.hue("pm") else GOLD_D, 24, 64, { name = "Accent" })
	end

	local lastPts = ""
	local lastBump = 0
	function self.update(c: Capsule, h: Types.HudState)
		hud = h
		local pts = h.pts
		if pts ~= lastPts then
			local grew = lastPts ~= ""
			lastPts = pts
			-- the hero face (the panel's YOU HAVE number): white into a warm cream, a gold glow behind it
			local steps = if compact then { 32, 28, 24 } else { 46, 40, 34 }
			Recipes.number(amount, { text = pts, size = steps[1], from = Color3.new(1, 1, 1), to = CREAM,
				stroke = 0, shadow = 0, role = "hero", glow = GOLD })
			Rich.fit(amount, steps, if compact then 160 else 300)
			if grew and os.clock() - lastBump >= 1 then
				lastBump = os.clock()
				Motion.bump(row, 0.05)
			end
		end
		local name = h.name
		local unitText = if compact then (if name == "points" then "pts" else name) else name
		if unit.Text ~= unitText then unit.Text = unitText end
		local gen = h.gen
		local showPill = gen ~= nil and gen ~= "" and not firstRun and f.Visible
		if showPill then
			local g = gen :: string
			if compact then g = string.gsub(string.gsub(Rich.short(g), "OOMs/sec", "OOM/s"), "/sec", "/s") end
			local t = Rich.num(g, { size = if compact then 12 else 14, unit = GOOD })
			if pillLabel.Text ~= t then pillLabel.Text = t end
		end
		if pill.Visible ~= showPill then
			pill.Visible = showPill
			c.changed:Fire()
		end
		sample(pts)
		local w = h.w[1]
		local showWarn = w ~= nil and f.Visible
		if w then
			local t = Rich.num(string.upper(w.k) .. " " .. w.v, { size = Theme.size("badge"), unit = CREAM })
			if wLabel.Text ~= t then wLabel.Text = t end
		end
		if warn.Visible ~= showWarn then
			warn.Visible = showWarn
			c.changed:Fire()
		end
		status.Position = at(0, statusY())
		writeInfo(h)
	end

	function self.setStatus(c: Capsule, kind: string?)
		if kind == "saved" then
			savedToken += 1
			local token = savedToken
			task.delay(1.5, function()
				if savedToken == token and statusKind == "saved" then c:setStatus(nil) end
			end)
		end
		if kind == statusKind then return end
		statusKind = kind
		local spec = if kind then STATUS[kind] else nil
		if spec == nil then
			status.Visible = false
			writeInfo(hud)
			c.changed:Fire()
			return
		end
		sRim.Color = spec.color
		sLabel.Text = spec.text
		sLabel.TextColor3 = Theme.lift(spec.color, 0.35)
		local g = Kit.glyph(status, "Icon", spec.glyph, spec.color, Theme.C.deep)
		g.LayoutOrder = 1
		g.Size = UDim2.fromOffset(14, 14)
		status.Position = at(0, statusY())
		status.Visible = true
		writeInfo(hud)
		c.changed:Fire()
	end

	-- x: the du x to centre on (the map strip's middle while a side sheet is open), nil for the Root's middle
	function self.setCentre(c: Capsule, x: number?)
		local w = if compact then W_COMPACT else W_WIDE
		local nx = if x then math.max(w / 2 + 4, x) else nil
		if nx == centreX then return end
		centreX = nx
		place()
		local h = hud
		if h then c:update(h) end
	end
	function self.centre(_: Capsule): number?
		return centreX
	end

	function self.setUniverse(_: Capsule, b: boolean)
		inside = b
		writeLabel()
	end
	function self.setFirstRun(c: Capsule, b: boolean)
		if firstRun == b then return end
		firstRun = b
		local h = hud
		if h then c:update(h) end
	end
	function self.bottom(_: Capsule): number
		local y = infoY()
		if info.Visible then y += math.max(28, info.AbsoluteSize.Y / math.max(Layout.s, 0.01)) + 6 end
		return y
	end
	function self.destroy(c: Capsule)
		c.warnTap:DisconnectAll()
		c.changed:DisconnectAll()
		for _, x in { f, pill, spark, warn, status, info } do x:Destroy() end
	end

	place()
	writeLabel()
	do
		local lp = game:GetService("Players").LocalPlayer
		if lp then lp:GetAttributeChangedSignal("MT_Perks"):Connect(writeLabel) end
	end
	-- the phone band hides the capsule; its detached parts (rate, sparkline, warning) follow it
	f:GetPropertyChangedSignal("Visible"):Connect(function()
		local h = hud
		if h then self:update(h) end
		if not f.Visible then spark.Visible = false end
	end)
	-- the screen centre in the parent's du moves with the parent (the top bar's insets, a resize)
	for _, prop in { "AbsolutePosition", "AbsoluteSize" } do
		parent:GetPropertyChangedSignal(prop):Connect(function()
			if centreX == nil then place() end
		end)
	end
	Layout.changed:Connect(function()
		place()
		lastPts = ""
		local h = hud
		if h then self:update(h) end
	end)
	return self
end

return Capsule
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">Dock</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Dock: HOME / TROPHIES / OPTIONS at the bottom left (DESIGN.md 4.4) and the zoom capsule after it (mouse only).

	    Dock      Home, Trophies (+ Badge "13/18"), Options (+ Dot while the server cannot save), Shop: ImageButtons with the
	              hue bevel, a glyph with a hard shadow, the caption pill below (`label`, Title Case)
	    Zoom      glass: Minus, Pct ("51%", `number`), Plus

	    local part = Dock.new(parent)
	    part:setTrophies(text?)  part:setUnsaved(b)  part:setActive(key?)  part:setZoomPct(z)  part:setCompactStrip(...)
	    part.home, part.trophies, part.options, part.zoomIn, part.zoomOut   ()
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Signal = require(Core:WaitForChild("Signal"))
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Motion = require(Core:WaitForChild("Motion"))
local Rich = require(Core:WaitForChild("Rich"))
local Sleek = require(Core:WaitForChild("Sleek"))
local Skin = require(Core:WaitForChild("Skin"))
local Input = require(script.Parent.Parent:WaitForChild("Input"):WaitForChild("Input"))
local Kit = require(script.Parent:WaitForChild("Kit"))

export type Dock = {
	frame: Frame,
	zoom: Frame,
	home: Signal.Signal<>,
	trophies: Signal.Signal<>,
	options: Signal.Signal<>,
	shop: Signal.Signal<>,
	ranks: Signal.Signal<>,
	zoomIn: Signal.Signal<>,
	zoomOut: Signal.Signal<>,
	changed: Signal.Signal<>,
	setTrophies: (self: Dock, text: string?) -> (),
	setUnsaved: (self: Dock, b: boolean) -> (),
	setActive: (self: Dock, key: string?) -> (),
	setZoomPct: (self: Dock, z: number) -> (),
	setZoomVisible: (self: Dock, b: boolean) -> (),
	setSmall: (self: Dock, b: boolean) -> (), -- 56 du buttons while a side sheet is open
	destroy: (self: Dock) -> (),
}

local Dock = {}

local BUTTONS = {
	{ key = "Home", caption = "Home", hue = Color3.fromHex("2fcf8f"), glyph = "home" },
	{ key = "Trophies", caption = "Trophies", hue = Color3.fromHex("ffb020"), glyph = "star" },
	{ key = "Options", caption = "Options", hue = Color3.fromHex("8a7cff"), glyph = "gear" },
	{ key = "Shop", caption = "Shop", hue = Color3.fromHex("ffc93c"), glyph = "bag" },
	{ key = "Ranks", caption = "Ranks", hue = Color3.fromHex("4fd1ff"), glyph = "podium" },
}

function Dock.new(parent: GuiObject): Dock
	local self = {} :: Dock
	self.home = Signal.new() :: Signal.Signal<>
	self.trophies = Signal.new() :: Signal.Signal<>
	self.options = Signal.new() :: Signal.Signal<>
	self.shop = Signal.new() :: Signal.Signal<>
	self.ranks = Signal.new() :: Signal.Signal<>
	self.zoomIn = Signal.new() :: Signal.Signal<>
	self.zoomOut = Signal.new() :: Signal.Signal<>
	self.changed = Signal.new() :: Signal.Signal<>

	local f = Kit.frame(parent, "Dock", 5)
	f.AnchorPoint = Vector2.new(0, 1)
	self.frame = f
	local small = false
	local active: string? = nil
	local buttons: { [string]: ImageButton } = {}
	local captions: { [string]: Frame } = {}

	for i, spec in BUTTONS do
		local b = Kit.child(f, spec.key, "ImageButton") :: ImageButton
		b.BorderSizePixel = 0
		b.AutoButtonColor = false
		b.Image = ""
		b.ZIndex = 3
		-- Sleek: a dark slab with a hairline and corner ticks, a white line icon, an index number; the active
		-- button gets the button's hue as a rim and a 2 du floor line
		Sleek.plate(b, { alpha = 0.86, line = 0.86 })
		Sleek.ticks(b, { len = 10, th = 2, out = 1, color = Color3.new(1, 1, 1), alpha = 0.8, z = 7 })
		local icon = Kit.glyph(b, "Icon", spec.glyph, Color3.new(1, 1, 1), Sleek.C.top)
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position = UDim2.fromScale(0.5, 0.5)
		icon.Size = UDim2.fromScale(0.42, 0.42)
		icon.ZIndex = 6
		local idx = Sleek.micro(b, "Index", string.format("%02d", i), Sleek.C.micro)
		idx.Position = UDim2.fromOffset(6, 5)
		idx.ZIndex = 6
		local floor = Kit.frame(b, "Floor", 6)
		floor.AnchorPoint = Vector2.new(0, 1)
		floor.Position = UDim2.fromScale(0, 1)
		floor.Size = UDim2.new(1, 0, 0, 2)
		floor.BackgroundColor3 = spec.hue
		floor.BackgroundTransparency = 0
		floor.Visible = false
		local press = Kit.child(b, "Press", "UIScale") :: UIScale
		b.MouseButton1Down:Connect(function()
			Motion.tween(press, TweenInfo.new(0.08), { Scale = 0.94 }, "dockPress" .. spec.key, true)
		end)
		b.MouseButton1Up:Connect(function()
			Motion.tween(press, TweenInfo.new(0.12), { Scale = 1 }, "dockPress" .. spec.key, true)
		end)
		b.MouseLeave:Connect(function()
			press.Scale = 1
		end)
		b.Activated:Connect(function()
			if spec.key == "Home" then
				self.home:Fire()
			elseif spec.key == "Trophies" then
				self.trophies:Fire()
			elseif spec.key == "Shop" then
				self.shop:Fire()
			elseif spec.key == "Ranks" then
				self.ranks:Fire()
			else
				self.options:Fire()
			end
		end)
		buttons[spec.key] = b
		local cap, cl = Kit.chip(f, spec.key .. "Caption", "caps", Rich.caps(spec.caption), { h = 22, pad = 4,
			fg = Color3.fromHex("e6ebf2"), bg = Theme.C.deep, bgA = 0 })
		cap.AnchorPoint = Vector2.new(0.5, 0)
		cap.ZIndex = 3
		cl.ZIndex = 3
		captions[spec.key] = cap
	end
	-- the trophies badge and the options dot
	local badge, badgeLabel = Kit.chip(buttons.Trophies, "Badge", "badge", "", { h = 18, pad = 6, fg = Sleek.C.ink,
		bg = Sleek.C.gold, bgA = 1 })
	badge.AnchorPoint = Vector2.new(1, 0.5)
	badge.Position = UDim2.new(1, 2, 0, -2) -- inside its own tile, so the next tile never covers it
	local bc = badge:FindFirstChildWhichIsA("UICorner")
	if bc then bc:Destroy() end
	badge.ZIndex = 8
	badgeLabel.ZIndex = 8
	Kit.textStroke(badgeLabel, 0)
	badge.Visible = false
	local dot = Kit.frame(buttons.Options, "Dot", 8)
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.9, 0.1)
	dot.Size = UDim2.fromOffset(9, 9)
	dot.Rotation = 45
	dot.BackgroundColor3 = Theme.C.danger
	dot.BackgroundTransparency = 0
	dot.Visible = false

	-- the zoom capsule
	local zoom = Kit.frame(parent, "Zoom", 5)
	zoom.AnchorPoint = Vector2.new(0, 1)
	Sleek.plate(zoom, { alpha = 0.86, line = 0.86 })
	Sleek.ticks(zoom, { len = 10, th = 2, out = 1, color = Color3.new(1, 1, 1), alpha = 0.8, z = 7 })
	-- a ruler under the percentage; the lit part is the zoom level
	local ruler = Kit.frame(zoom, "Ruler", 6)
	ruler.AnchorPoint = Vector2.new(0.5, 1)
	ruler.Position = UDim2.new(0.5, 0, 1, -6)
	ruler.Size = UDim2.fromOffset(60, 3)
	for k = 0, 10 do
		local t = Kit.frame(ruler, "T" .. k, 6)
		t.Position = UDim2.fromOffset(k * 6, 0)
		t.Size = UDim2.fromOffset(1, 3)
		t.BackgroundColor3 = Color3.new(1, 1, 1)
		t.BackgroundTransparency = 0.7
	end
	local lit = Kit.frame(ruler, "Lit", 7)
	lit.Position = UDim2.fromOffset(0, -1)
	lit.Size = UDim2.fromOffset(30, 1)
	lit.BackgroundColor3 = Theme.hue("p")
	lit.BackgroundTransparency = 0
	self.zoom = zoom
	local function zbtn(name: string, glyph: string, x: number, sig: Signal.Signal<>): TextButton
		local b = Kit.button(zoom, name)
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.Position = UDim2.new(x, 0, 0.5, 0)
		b.Size = UDim2.fromOffset(40, 40)
		b.BackgroundTransparency = 1
		local g = Kit.glyph(b, "Icon", glyph, Color3.new(1, 1, 1))
		g.AnchorPoint = Vector2.new(0.5, 0.5)
		g.Position = UDim2.fromScale(0.5, 0.5)
		g.Size = UDim2.fromScale(0.42, 0.42)
		b.Activated:Connect(function() sig:Fire() end)
		return b
	end
	zbtn("Minus", "minus", 0, self.zoomOut).Position = UDim2.new(0, 22, 0.5, 0)
	zbtn("Plus", "plus", 1, self.zoomIn).Position = UDim2.new(1, -22, 0.5, 0)
	local pct = Kit.label(zoom, "Pct", "number", "", Color3.new(1, 1, 1))
	pct.AnchorPoint = Vector2.new(0.5, 0.5)
	pct.Position = UDim2.new(0.5, 0, 0.5, -3)
	pct.Size = UDim2.new(1, -90, 0, 20)
	pct.TextXAlignment = Enum.TextXAlignment.Center
	local zoomWanted = true

	local function place()
		local compact = Layout.mode == "COMPACT"
		local bs = if small then 56 elseif compact then 50 else 64
		local gap = if compact then 18 else 24
		local capH = if compact then 20 else 22
		f.Position = UDim2.new(0, if compact then 12 else 20, 1, if compact then -6 else -8)
		f.Size = UDim2.fromOffset(#BUTTONS * bs + (#BUTTONS - 1) * gap, bs + 2 + capH)
		for i, spec in BUTTONS do
			local b = buttons[spec.key]
			b.Size = UDim2.fromOffset(bs, bs)
			b.Position = UDim2.fromOffset((i - 1) * (bs + gap), 0)
			local cap = captions[spec.key]
			cap.Size = UDim2.fromOffset(0, capH)
			cap.Position = UDim2.fromOffset((i - 1) * (bs + gap) + bs / 2, bs + 2)
			local cl = cap:FindFirstChild("Label") :: TextLabel?
			if cl then
				Theme.text(cl, "caps")
				-- phones: no letter tracking, so the three captions fit their 68 du pitch
				cl.Text = if compact then string.upper(spec.caption) else Rich.caps(spec.caption)
			end
			local on = active == spec.key
			Sleek.plate(b, { alpha = 0.86, line = if on then 0.3 else 0.86 })
			Skin.apply(b, "tile", { scale = bs / 150 })
			local hair = b:FindFirstChild("Hair") :: UIStroke?
			if hair then hair.Color = if on then spec.hue else Color3.new(1, 1, 1) end
			local fl = b:FindFirstChild("Floor") :: Frame?
			if fl then fl.Visible = on end
			local ix = b:FindFirstChild("Index") :: TextLabel?
			if ix then ix.TextColor3 = if on then spec.hue else Sleek.C.micro end
			if cl then cl.TextColor3 = if on then Color3.new(1, 1, 1) else Color3.fromHex("e6ebf2") end
		end
		Theme.text(badgeLabel, "badge")
		badge.Size = UDim2.fromOffset(0, if compact then 20 else 22)
		zoom.Size = UDim2.fromOffset(150, 44)
		zoom.Position = UDim2.new(0, (if compact then 12 else 20) + #BUTTONS * bs + (#BUTTONS - 1) * gap + 24, 1, -(if compact then 6 else 8) - capH - 2 - (bs - 44) / 2)
		Theme.text(pct, "number")
		zoom.Visible = zoomWanted and not compact and Input.kind() == "mouse"
		self.changed:Fire()
	end
	place()
	Layout.changed:Connect(place)
	Input.kindChanged:Connect(place)

	function self.setTrophies(_: Dock, text: string?)
		badge.Visible = text ~= nil
		if text then badgeLabel.Text = text end
	end
	function self.setUnsaved(_: Dock, b: boolean)
		dot.Visible = b
	end
	function self.setActive(_: Dock, key: string?)
		active = key
		place()
	end
	function self.setZoomPct(_: Dock, z: number)
		local t = string.format("%d%%", math.floor(z * 100 + 0.5))
		if pct.Text ~= t then pct.Text = t end
		lit.Size = UDim2.fromOffset(math.clamp(math.floor(z * 60 + 0.5), 1, 60), 1)
	end
	function self.setZoomVisible(_: Dock, b: boolean)
		zoomWanted = b
		place()
	end
	function self.setSmall(_: Dock, b: boolean)
		if small == b then return end
		small = b
		place()
	end
	function self.destroy(d: Dock)
		for _, s in { d.home, d.trophies, d.options, d.shop, d.ranks, d.zoomIn, d.zoomOut, d.changed } do s:DisconnectAll() end
		f:Destroy()
		zoom:Destroy()
	end
	return self
end

return Dock
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Hud: the facade over the HUD (DESIGN.md 4, 12). TopbarGui (TopbarSafeInsets) holds the points capsule with the
	rate pill, warning and status chips, the universe tag and the COMPACT panel band; HudGui (CoreUISafeInsets) holds
	the dock (HOME / TROPHIES / OPTIONS), the zoom capsule, the READY tray / pill and the Multiverse portal. Every part
	registers its rect with Layout.setRect (hud.capsule, hud.pill, ...) so plates and markers keep clear.

	    local hud = Hud.new(topbarGui, hudGui)
	    hud:updateHud(h)   hud:updateMap(ms)   hud:setStatus(kind)   hud:setPanel(p)   hud:setFirstRun(b)   hud:setZoomPct(z)
	    hud:setVisible(b)
	    hud.home, hud.trophies, hud.options, hud.portal, hud.zoomIn, hud.zoomOut, hud.bandClose   ()
	    hud.bandSwitch (layer)                              -- a READY gem in the COMPACT band
	    hud.readyTap (layer), hud.readyHold (layer)        -- the hold already passed the hold safety
	    hud.readyMore ()                                    -- "+N more" in the tray
	    hud.gateHold ()                                     -- the universe tag FINISH / EXIT hold completed
	    hud.warnTap (abs)
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Signal = require(Core:WaitForChild("Signal"))
local Layout = require(Core:WaitForChild("Layout"))
local Kit = require(script.Parent:WaitForChild("Kit"))
local Capsule = require(script.Parent:WaitForChild("Capsule"))
local PlayerList = require(script.Parent:WaitForChild("PlayerList"))
local UniverseTag = require(script.Parent:WaitForChild("UniverseTag"))
local Band = require(script.Parent:WaitForChild("Band"))
local Dock = require(script.Parent:WaitForChild("Dock"))
local Ready = require(script.Parent:WaitForChild("Ready"))
local Portal = require(script.Parent:WaitForChild("Portal"))

type HudState = Types.HudState
type MapState = Types.MapState
type ARect = Types.Rect

export type PanelInfo = { layer: string?, mode: string, strip: ARect?, title: string? } -- mode: "side" | "full"
export type Hud = {
	home: Signal.Signal<>,
	trophies: Signal.Signal<>,
	options: Signal.Signal<>,
	shop: Signal.Signal<>,
	ranks: Signal.Signal<>,
	portal: Signal.Signal<>,
	zoomIn: Signal.Signal<>,
	zoomOut: Signal.Signal<>,
	bandClose: Signal.Signal<>,
	bandSwitch: Signal.Signal<string>,
	readyTap: Signal.Signal<string>,
	readyHold: Signal.Signal<string>,
	readyMore: Signal.Signal<>,
	gateHold: Signal.Signal<>,
	warnTap: Signal.Signal<Vector2>,
	updateHud: (self: Hud, h: HudState) -> (),
	updateMap: (self: Hud, ms: MapState) -> (),
	setStatus: (self: Hud, kind: string?) -> (), -- "saving" | "saved" | "off" | "reconnecting" | nil
	setPanel: (self: Hud, p: PanelInfo?) -> (),
	setFirstRun: (self: Hud, b: boolean) -> (),
	setZoomPct: (self: Hud, z: number) -> (),
	setVisible: (self: Hud, b: boolean) -> (),
	destroy: (self: Hud) -> (),
}

local Hud = {}

function Hud.new(topbar: ScreenGui, hud: ScreenGui): Hud
	local self = {} :: Hud
	self.home = Signal.new() :: Signal.Signal<>
	self.trophies = Signal.new() :: Signal.Signal<>
	self.options = Signal.new() :: Signal.Signal<>
	self.shop = Signal.new() :: Signal.Signal<>
	self.ranks = Signal.new() :: Signal.Signal<>
	self.portal = Signal.new() :: Signal.Signal<>
	self.zoomIn = Signal.new() :: Signal.Signal<>
	self.zoomOut = Signal.new() :: Signal.Signal<>
	self.bandClose = Signal.new() :: Signal.Signal<>
	self.bandSwitch = Signal.new() :: Signal.Signal<string>
	self.readyTap = Signal.new() :: Signal.Signal<string>
	self.readyHold = Signal.new() :: Signal.Signal<string>
	self.readyMore = Signal.new() :: Signal.Signal<>
	self.gateHold = Signal.new() :: Signal.Signal<>
	self.warnTap = Signal.new() :: Signal.Signal<Vector2>

	local topRoot = (topbar:FindFirstChild("Root") or topbar) :: GuiObject
	local hudRoot = (hud:FindFirstChild("Root") or hud) :: GuiObject

	local capsule = Capsule.new(topRoot)
	-- the players in this server, top right (Points | Playtime, highest first)
	local playerList = PlayerList.new(topRoot)
	local tag = UniverseTag.new(topRoot)
	local band = Band.new(topRoot)
	local dock = Dock.new(hudRoot)
	local ready = Ready.new(hudRoot)
	local portal = Portal.new(hudRoot)

	capsule.warnTap:Connect(function(abs: Vector2) self.warnTap:Fire(abs) end)
	tag.hold:Connect(function() self.gateHold:Fire() end)
	band.close:Connect(function() self.bandClose:Fire() end)
	band.switch:Connect(function(l: string) self.bandSwitch:Fire(l) end)
	dock.home:Connect(function() self.home:Fire() end)
	dock.trophies:Connect(function() self.trophies:Fire() end)
	dock.options:Connect(function() self.options:Fire() end)
	dock.shop:Connect(function() self.shop:Fire() end)
	dock.ranks:Connect(function() self.ranks:Fire() end)
	dock.zoomIn:Connect(function() self.zoomIn:Fire() end)
	dock.zoomOut:Connect(function() self.zoomOut:Fire() end)
	ready.tap:Connect(function(l: string) self.readyTap:Fire(l) end)
	ready.hold:Connect(function(l: string) self.readyHold:Fire(l) end)
	ready.more:Connect(function() self.readyMore:Fire() end)
	portal.tap:Connect(function() self.portal:Fire() end)

	local firstRun = false
	local panel: PanelInfo? = nil
	local visible = true
	local lastMs: MapState? = nil

	-- ------------------------------------------------------------------------------------------ rects
	local parts: { [string]: GuiObject } = {
		capsule = capsule.frame, pill = capsule.pill, warn = capsule.warn, status = capsule.status, info = capsule.info, unitag = tag.frame,
		band = band.frame, dock = dock.frame, zoom = dock.zoom, ready = ready.frame, readyPill = ready.pill,
		banner = ready.banner, portal = portal.frame,
	}
	local pending = false
	local function shownOnScreen(g: GuiObject): boolean
		if not g.Visible then return false end
		local p = g.Parent
		while p and p:IsA("GuiObject") do
			if not (p :: GuiObject).Visible then return false end
			p = p.Parent
		end
		local gui = g:FindFirstAncestorWhichIsA("ScreenGui")
		return gui == nil or gui.Enabled
	end
	local function register()
		pending = false
		for key, g in parts do
			if visible and shownOnScreen(g) and g.AbsoluteSize.X > 1 then
				Layout.setRect("hud." .. key, Kit.rect(g))
			else
				Layout.setRect("hud." .. key, nil)
			end
		end
		Layout.setRect("hud.topbar", if visible then Layout.topbar() else nil)
	end
	local function soon()
		if pending then return end
		pending = true
		task.defer(register)
	end
	for _, g in parts do
		g:GetPropertyChangedSignal("AbsoluteSize"):Connect(soon)
		g:GetPropertyChangedSignal("AbsolutePosition"):Connect(soon)
		g:GetPropertyChangedSignal("Visible"):Connect(soon)
	end
	for _, s in { capsule.changed, dock.changed, ready.changed, portal.changed } do s:Connect(soon) end
	Layout.changed:Connect(soon)

	-- ------------------------------------------------------------------------------------------ modes
	local function apply()
		local compact = Layout.mode == "COMPACT"
		local p = panel
		local side = p ~= nil and p.mode == "side"
		local full = p ~= nil and p.mode == "full"
		capsule.frame.Visible = not (full and compact)
		-- beside a side sheet the capsule (and the universe tag) centre over the map strip (DESIGN.md 4.2)
		local strip = if side and p then p.strip else nil
		if strip then
			local ro = topRoot.AbsolutePosition
			local s = math.max(Layout.s, 0.01)
			capsule:setCentre((strip.x + strip.w / 2 - ro.X) / s)
		else
			capsule:setCentre(nil)
		end
		tag:setTop(capsule:bottom(), capsule:centre())
		local bl = if full and compact and p then p.layer else nil
		local bn = if bl and lastMs then (lastMs :: MapState).nodes[bl] else nil
		band:show(bl, if p then p.title else nil, if bn and type(bn.sym) == "string" then bn.sym else nil)
		dock:setSmall(side)
		dock:setZoomVisible(not firstRun and p == nil)
		ready:setMode(if side then "strip" elseif compact then "pill" else "tray")
		ready:setHidden(firstRun or full)
		portal:setHidden(firstRun or side or full)
		local ms = lastMs
		if ms then ready:update(ms) end
		soon()
	end

	function self.updateHud(_: Hud, h: HudState)
		capsule:update(h)
		tag:setTop(capsule:bottom(), capsule:centre())
		soon()
	end
	function self.updateMap(_: Hud, ms: MapState)
		lastMs = ms
		capsule:setUniverse(ms.inside)
		tag:update(ms.gate)
		tag:setTop(capsule:bottom(), capsule:centre())
		ready:update(ms)
		portal:update(ms.gate)
		local list = {}
		for _, l in ms.ready do
			local n = ms.nodes[l]
			table.insert(list, { layer = l, sym = if n and type(n.sym) == "string" then n.sym else string.upper(l) })
		end
		band:setReady(list)
		local ach = ms.nodes.ach
		local v = ach and ach.val
		dock:setTrophies(if ach and ach.show and v and v.pts then v.pts .. "/" .. (v.tot or "18") else nil)
		dock:setActive(if ms.open == "ach" then "Trophies" elseif ms.open == "options-tab" then "Options" else nil)
		soon()
	end
	function self.setStatus(_: Hud, kind: string?)
		capsule:setStatus(kind)
		dock:setUnsaved(kind == "off")
		tag:setTop(capsule:bottom(), capsule:centre())
		soon()
	end
	function self.setPanel(_: Hud, p: PanelInfo?)
		panel = p
		apply()
	end
	function self.setFirstRun(_: Hud, b: boolean)
		if b == firstRun then return end
		firstRun = b
		capsule:setFirstRun(b)
		apply()
	end
	function self.setZoomPct(_: Hud, z: number)
		dock:setZoomPct(z)
	end
	function self.setVisible(_: Hud, b: boolean)
		visible = b
		topbar.Enabled = b
		hud.Enabled = b
		register()
	end
	function self.destroy(h: Hud)
		for _, s in { h.home, h.trophies, h.options, h.shop, h.ranks, h.portal, h.zoomIn, h.zoomOut, h.bandClose, h.gateHold, h.readyMore } do
			s:DisconnectAll()
		end
		h.readyTap:DisconnectAll()
		h.bandSwitch:DisconnectAll()
		h.readyHold:DisconnectAll()
		h.warnTap:DisconnectAll()
		playerList:destroy()
		for key in parts do Layout.setRect("hud." .. key, nil) end
		Layout.setRect("hud.topbar", nil)
		capsule:destroy()
		tag:destroy()
		band:destroy()
		dock:destroy()
		ready:destroy()
		portal:destroy()
	end
	apply()
	return self
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Kit: the small construction helpers the map widgets, the HUD and the overlays share (packages F and G).

	    Kit.frame(parent, name, z?)                 a transparent, inert Frame (get-or-create by name)
	    Kit.label(parent, name, role, text, color)  a TextLabel with the role's type (Theme.text), no background
	    Kit.corner(f, r) / Kit.stroke(f, px, color, a?) / Kit.grad(f, colors, rot?, alphas?) / Kit.pad(f, t, r, b, l)
	    Kit.list(f, dir, gap, h?, v?)               a UIListLayout (SortOrder LayoutOrder)
	    Kit.blob(parent, name, color, alpha)        a soft round glow; the radial fade ends at t = .7 and a UICorner
	                                                keeps it round (a Radial UIGradient on a square frame reaches the
	                                                corners, so a fade to 1 draws a square). nil without Radial.
	    Kit.gem(f, c, dark?)                        the gem fill of nodes, gems and emblems (radial, same rule)
	    Kit.glyph(parent, name, kind, color, bg?)   an icon built from frames (no emoji, no font glyphs): bolt, bang,
	                                                lock, moon, star, home, gear, plus, minus, x, check, up, down,
	                                                chev, swirl, bell, warn, clock, save, ring, bag. Scale units of a
	                                                square holder; size and place the returned Frame.
	    Kit.spin(inst, seconds, dir?)               a rotation loop (none with reduced motion)
	    Kit.button(parent, name)                    a transparent TextButton hit area (AutoButtonColor off)
	    Kit.rect(g)                                 a GuiObject's abs rect (Types.Rect)

	Everything is idempotent where it takes a name: a second call reuses the child.
]]

local TweenService = game:GetService("TweenService")

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Theme = require(Core:WaitForChild("Theme"))
local Motion = require(Core:WaitForChild("Motion"))
local Skin = require(Core:WaitForChild("Skin"))

type ARect = Types.Rect

local Kit = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
Kit.WHITE, Kit.BLACK = WHITE, BLACK

local function child<T>(parent: Instance, name: string, class: string): T
	local c = parent:FindFirstChild(name)
	if c and c.ClassName == class then return (c :: any) :: T end
	if c then c:Destroy() end
	local n = Instance.new(class :: any)
	n.Name = name
	n.Parent = parent
	return (n :: any) :: T
end
Kit.child = child

function Kit.frame(parent: Instance, name: string, z: number?): Frame
	local f = child(parent, name, "Frame") :: Frame
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Active = false
	if z then f.ZIndex = z end
	return f
end

function Kit.label(parent: Instance, name: string, role: string, text: string?, color: Color3?): TextLabel
	local l = child(parent, name, "TextLabel") :: TextLabel
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Active = false
	Theme.text(l, role)
	l.TextColor3 = color or Theme.C.text
	if text ~= nil then l.Text = text end
	return l
end

function Kit.corner(f: GuiObject, r: UDim?): UICorner
	local c = child(f, "Corner", "UICorner") :: UICorner
	c.CornerRadius = r or UDim.new(0.5, 0)
	return c
end

function Kit.stroke(f: GuiObject, px: number, color: Color3, a: number?, name: string?): UIStroke
	local s = child(f, name or "Stroke", "UIStroke") :: UIStroke
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Thickness = px
	s.Color = color
	s.Transparency = 1 - (if a ~= nil then a else 1)
	s.LineJoinMode = Enum.LineJoinMode.Round
	return s
end

-- a black outline on text (UIStroke Contextual): the display and thin-label strokes of DESIGN.md 9.2
function Kit.textStroke(l: GuiObject, px: number, a: number?): UIStroke?
	if px <= 0 then
		local old = l:FindFirstChild("TextStroke")
		if old then old:Destroy() end
		return nil
	end
	local s = child(l, "TextStroke", "UIStroke") :: UIStroke
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Color = BLACK
	s.Thickness = px
	s.Transparency = 1 - (if a ~= nil then a else 1)
	return s
end

-- colors: 1+ colours spread evenly (at: their positions instead); alphas: opacity keypoints { {t, a} }
function Kit.grad(f: Instance, colors: { Color3 }, rot: number?, alphas: { { number } }?, name: string?, at: { number }?): UIGradient
	local g = child(f, name or "Grad", "UIGradient") :: UIGradient
	g.Rotation = rot or 90
	local keys = {}
	local n = #colors
	for i, c in colors do
		local t = if at then at[i] else if n == 1 then 0 else (i - 1) / (n - 1)
		table.insert(keys, ColorSequenceKeypoint.new(t, c))
	end
	if #keys == 1 then table.insert(keys, ColorSequenceKeypoint.new(1, keys[1].Value)) end
	g.Color = ColorSequence.new(keys)
	if alphas then
		local tk = {}
		for _, p in alphas do table.insert(tk, NumberSequenceKeypoint.new(p[1], 1 - math.clamp(p[2], 0, 1))) end
		g.Transparency = NumberSequence.new(tk)
	else
		g.Transparency = NumberSequence.new(0)
	end
	return g
end

function Kit.pad(f: GuiObject, t: number, r: number, b: number, l: number): UIPadding
	local p = child(f, "Pad", "UIPadding") :: UIPadding
	p.PaddingTop, p.PaddingRight, p.PaddingBottom, p.PaddingLeft = UDim.new(0, t), UDim.new(0, r), UDim.new(0, b), UDim.new(0, l)
	return p
end

function Kit.list(f: GuiObject, dir: string, gap: number, h: Enum.HorizontalAlignment?, v: Enum.VerticalAlignment?): UIListLayout
	local l = child(f, "List", "UIListLayout") :: UIListLayout
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.FillDirection = if dir == "x" then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	l.Padding = UDim.new(0, gap)
	l.HorizontalAlignment = h or Enum.HorizontalAlignment.Left
	l.VerticalAlignment = v or Enum.VerticalAlignment.Top
	return l
end

-- ------------------------------------------------------------------------------------------------------ glows
-- a soft round glow filling `parent` child `name` (size and place it). The fade ends at .7 (see the header).
function Kit.blob(parent: Instance, name: string, color: Color3, alpha: number, z: number?): Frame?
	if not Theme.caps.Radial then
		local old = parent:FindFirstChild(name)
		if old then old:Destroy() end
		return nil
	end
	local f = Kit.frame(parent, name, z)
	f.BackgroundColor3 = color
	f.BackgroundTransparency = 0
	local g = child(f, "Radial", "UIGradient") :: UIGradient
	g.Type = Enum.GradientType.Radial
	g.Color = ColorSequence.new(color)
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1 - alpha),
		NumberSequenceKeypoint.new(0.3, 1 - alpha * 0.55),
		NumberSequenceKeypoint.new(0.7, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	Kit.corner(f)
	return f
end

-- a glow around a pill or card: UIShadow where the engine has it, else two soft rims
function Kit.halo(target: GuiObject, color: Color3, alpha: number, blur: number)
	if Theme.caps.UIShadow then
		local ok = pcall(function()
			local s = child(target, "Halo", "UIShadow") :: UIShadow
			s.Color = color
			s.Transparency = 1 - alpha
			s.BlurRadius = UDim.new(0, blur)
			s.Offset = UDim2.new()
		end)
		if ok then return end
	end
	local parent = target.Parent
	if parent == nil then return end
	local pc = target:FindFirstChildWhichIsA("UICorner")
	for i, k in { 0.5, 1 } do
		local name = target.Name .. "_Halo" .. i
		local f = Kit.frame(parent, name)
		local d = math.floor(blur * k + 0.5)
		f.AnchorPoint = target.AnchorPoint
		f.Position = target.Position + UDim2.fromOffset((2 * target.AnchorPoint.X - 1) * d, (2 * target.AnchorPoint.Y - 1) * d)
		f.Size = target.Size + UDim2.fromOffset(2 * d, 2 * d)
		f.BackgroundColor3 = color
		f.BackgroundTransparency = 1 - alpha * (if i == 1 then 0.28 else 0.14)
		f.ZIndex = math.max(0, target.ZIndex - 1)
		f.Visible = target.Visible
		local c = Kit.corner(f, if pc then pc.CornerRadius else UDim.new(0, 12))
		if pc and pc.CornerRadius.Scale == 0 then c.CornerRadius = UDim.new(0, pc.CornerRadius.Offset + d) end
	end
end

-- the gem fill: lift(c,.55) at the centre, c, shade(c,.28) at the rim; the ramp ends at .7 (the inscribed circle)
function Kit.gem(f: GuiObject, c: Color3, o: { hi: number?, lo: number?, flat: boolean? }?)
	local hi = (o and o.hi) or 0.55
	local lo = (o and o.lo) or 0.28
	f.BackgroundColor3 = WHITE
	f.BackgroundTransparency = 0
	f.BorderSizePixel = 0
	Kit.corner(f)
	local g = child(f, "Gem", "UIGradient") :: UIGradient
	g.Transparency = NumberSequence.new(0)
	if Theme.caps.Radial and not (o and o.flat) then
		g.Type = Enum.GradientType.Radial
		g.Rotation = 0
		g.Offset = Vector2.new(-0.08, -0.12)
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Theme.lift(c, hi)),
			ColorSequenceKeypoint.new(0.36, c),
			ColorSequenceKeypoint.new(0.7, Theme.shade(c, lo)),
			ColorSequenceKeypoint.new(1, Theme.shade(c, lo)),
		})
	else
		g.Type = Enum.GradientType.Linear
		g.Rotation = 90
		g.Offset = Vector2.zero
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Theme.lift(c, hi * 0.8)),
			ColorSequenceKeypoint.new(0.5, c),
			ColorSequenceKeypoint.new(1, Theme.shade(c, lo)),
		})
	end
end

-- ------------------------------------------------------------------------------------------------------ glyphs
-- one bar from a to b (scale units of a square holder), thickness th (scale), rounded ends
local function bar(h: Frame, name: string, ax: number, ay: number, bx: number, by: number, th: number, color: Color3, round: boolean?): Frame
	local f = child(h, name, "Frame") :: Frame
	f.BorderSizePixel = 0
	f.Active = false
	f.BackgroundColor3 = color
	f.BackgroundTransparency = 0
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	local dx, dy = bx - ax, by - ay
	local len = math.sqrt(dx * dx + dy * dy)
	f.Position = UDim2.fromScale((ax + bx) / 2, (ay + by) / 2)
	f.Size = UDim2.fromScale(len + (if round then th else 0), th)
	f.Rotation = math.deg(math.atan2(dy, dx))
	if round ~= false then Kit.corner(f) end
	return f
end
local function disc(h: Frame, name: string, cx: number, cy: number, d: number, color: Color3): Frame
	local f = child(h, name, "Frame") :: Frame
	f.BorderSizePixel = 0
	f.Active = false
	f.BackgroundColor3 = color
	f.BackgroundTransparency = 0
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(cx, cy)
	f.Size = UDim2.fromScale(d, d)
	Kit.corner(f)
	return f
end
local function box(h: Frame, name: string, cx: number, cy: number, w: number, hh: number, color: Color3, r: number?, rot: number?): Frame
	local f = child(h, name, "Frame") :: Frame
	f.BorderSizePixel = 0
	f.Active = false
	f.BackgroundColor3 = color
	f.BackgroundTransparency = 0
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(cx, cy)
	f.Size = UDim2.fromScale(w, hh)
	f.Rotation = rot or 0
	if r then Kit.corner(f, UDim.new(r, 0)) end
	return f
end
-- a ring whose stroke follows the holder's size (thickness = k x the holder's width)
local function ring(h: Frame, name: string, cx: number, cy: number, w: number, hh: number, k: number, color: Color3): Frame
	local f = child(h, name, "Frame") :: Frame
	f.BorderSizePixel = 0
	f.Active = false
	f.BackgroundTransparency = 1
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(cx, cy)
	f.Size = UDim2.fromScale(w, hh)
	Kit.corner(f)
	local s = child(f, "Line", "UIStroke") :: UIStroke
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Color = color
	s.Transparency = 0
	local function fit()
		s.Thickness = math.max(1, h.AbsoluteSize.X * k)
	end
	fit()
	h:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	return f
end

export type GlyphKind = string
local DRAW: { [string]: (h: Frame, c: Color3, bg: Color3) -> () } = {
	bolt = function(h, c)
		bar(h, "A", 0.66, 0.06, 0.34, 0.52, 0.17, c, false)
		bar(h, "B", 0.3, 0.52, 0.7, 0.48, 0.17, c, false)
		bar(h, "C", 0.66, 0.48, 0.34, 0.94, 0.17, c, false)
	end,
	bang = function(h, c)
		bar(h, "A", 0.5, 0.16, 0.5, 0.56, 0.2, c, true)
		disc(h, "B", 0.5, 0.8, 0.2, c)
	end,
	lock = function(h, c)
		ring(h, "Shackle", 0.5, 0.36, 0.46, 0.5, 0.1, c)
		box(h, "Body", 0.5, 0.68, 0.72, 0.5, c, 0.18)
		disc(h, "Hole", 0.5, 0.66, 0.14, Theme.shade(c, 0.35))
	end,
	moon = function(h, c, bg)
		disc(h, "A", 0.5, 0.5, 0.8, c)
		disc(h, "B", 0.66, 0.36, 0.66, bg)
	end,
	star = function(h, c)
		box(h, "A", 0.5, 0.5, 0.56, 0.56, c, 0.08, 0)
		box(h, "B", 0.5, 0.5, 0.56, 0.56, c, 0.08, 45)
		disc(h, "C", 0.5, 0.5, 0.5, c)
	end,
	home = function(h, c, bg)
		box(h, "Roof", 0.5, 0.44, 0.5, 0.5, c, 0.1, 45)
		box(h, "Body", 0.5, 0.66, 0.56, 0.4, c, 0.08)
		box(h, "Door", 0.5, 0.74, 0.16, 0.24, bg, 0.2)
	end,
	gear = function(h, c, bg)
		for i = 0, 7 do
			local a = i * math.pi / 4
			box(h, "T" .. i, 0.5 + 0.34 * math.cos(a), 0.5 + 0.34 * math.sin(a), 0.2, 0.2, c, 0.2, math.deg(a))
		end
		disc(h, "Body", 0.5, 0.5, 0.66, c)
		disc(h, "Hole", 0.5, 0.5, 0.26, bg)
	end,
	plus = function(h, c)
		bar(h, "A", 0.2, 0.5, 0.8, 0.5, 0.16, c, true)
		bar(h, "B", 0.5, 0.2, 0.5, 0.8, 0.16, c, true)
	end,
	minus = function(h, c)
		bar(h, "A", 0.2, 0.5, 0.8, 0.5, 0.16, c, true)
	end,
	x = function(h, c)
		bar(h, "A", 0.24, 0.24, 0.76, 0.76, 0.14, c, true)
		bar(h, "B", 0.76, 0.24, 0.24, 0.76, 0.14, c, true)
	end,
	check = function(h, c)
		bar(h, "A", 0.18, 0.52, 0.4, 0.74, 0.15, c, true)
		bar(h, "B", 0.4, 0.74, 0.82, 0.28, 0.15, c, true)
	end,
	up = function(h, c)
		bar(h, "A", 0.5, 0.2, 0.5, 0.84, 0.16, c, true)
		bar(h, "B", 0.5, 0.18, 0.22, 0.46, 0.16, c, true)
		bar(h, "C", 0.5, 0.18, 0.78, 0.46, 0.16, c, true)
	end,
	down = function(h, c)
		bar(h, "A", 0.5, 0.16, 0.5, 0.8, 0.16, c, true)
		bar(h, "B", 0.5, 0.82, 0.22, 0.54, 0.16, c, true)
		bar(h, "C", 0.5, 0.82, 0.78, 0.54, 0.16, c, true)
	end,
	chev = function(h, c)
		bar(h, "A", 0.36, 0.2, 0.66, 0.5, 0.15, c, true)
		bar(h, "B", 0.66, 0.5, 0.36, 0.8, 0.15, c, true)
	end,
	swirl = function(h, c)
		ring(h, "Outer", 0.5, 0.5, 0.84, 0.84, 0.09, c)
		ring(h, "Inner", 0.56, 0.5, 0.44, 0.44, 0.09, c)
		disc(h, "Dot", 0.6, 0.5, 0.16, c)
	end,
	bell = function(h, c)
		box(h, "Body", 0.5, 0.5, 0.56, 0.5, c, 0.4)
		box(h, "Rim", 0.5, 0.7, 0.8, 0.12, c, 0.5)
		disc(h, "Clapper", 0.5, 0.84, 0.18, c)
	end,
	warn = function(h, c)
		ring(h, "Ring", 0.5, 0.5, 0.86, 0.86, 0.09, c)
		bar(h, "A", 0.5, 0.26, 0.5, 0.56, 0.13, c, true)
		disc(h, "B", 0.5, 0.74, 0.14, c)
	end,
	clock = function(h, c)
		ring(h, "Ring", 0.5, 0.5, 0.84, 0.84, 0.09, c)
		bar(h, "A", 0.5, 0.5, 0.5, 0.24, 0.1, c, true)
		bar(h, "B", 0.5, 0.5, 0.7, 0.58, 0.1, c, true)
	end,
	save = function(h, c, bg)
		box(h, "Body", 0.5, 0.5, 0.72, 0.72, c, 0.12)
		box(h, "Label", 0.5, 0.64, 0.44, 0.28, bg, 0.1)
		box(h, "Shutter", 0.5, 0.26, 0.36, 0.14, bg, 0.2)
	end,
	ring = function(h, c)
		ring(h, "Ring", 0.5, 0.5, 0.8, 0.8, 0.12, c)
	end,
	-- the Shop: a shopping bag (a handle loop over a square body with a notch)
	bag = function(h, c, bg)
		ring(h, "Handle", 0.5, 0.24, 0.36, 0.36, 0.05, c)
		box(h, "Body", 0.5, 0.66, 0.78, 0.52, c, 0.08)
		box(h, "Strap", 0.5, 0.5, 0.78, 0.06, bg, 0)
	end,
	-- the leaderboards: a podium (the middle step highest)
	podium = function(h, c)
		box(h, "Left", 0.2, 0.7, 0.26, 0.4, c, 0.06)
		box(h, "Mid", 0.5, 0.58, 0.28, 0.64, c, 0.06)
		box(h, "Right", 0.8, 0.77, 0.26, 0.26, c, 0.06)
	end,
	info = function(h, c)
		ring(h, "Ring", 0.5, 0.5, 0.86, 0.86, 0.09, c)
		disc(h, "Dot", 0.5, 0.3, 0.14, c)
		bar(h, "Bar", 0.5, 0.46, 0.5, 0.74, 0.13, c, true)
	end,
}
Kit.GLYPHS = DRAW

-- an icon in a square holder named `name` (size and place the holder). bg: the colour of the surface under it (for
-- the cut-outs of moon, gear, home, lock).
function Kit.glyph(parent: Instance, name: string, kind: string, color: Color3, bg: Color3?): Frame
	local h = Kit.frame(parent, name)
	local key = kind .. "|" .. Theme.toHex(color) .. "|" .. (if bg then Theme.toHex(bg) else "")
	if h:GetAttribute("Glyph") == key then return h end
	for _, c in h:GetChildren() do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	h:SetAttribute("Glyph", key)
	local draw = DRAW[kind] or DRAW.ring
	draw(h, color, bg or Theme.C.deep)
	return h
end

-- ------------------------------------------------------------------------------------------------------ motion
local spins: { [Instance]: Tween } = setmetatable({}, { __mode = "k" }) :: any
-- rotate `inst` one turn every `seconds` (dir -1 counter-clockwise); off with reduced motion
function Kit.spin(inst: GuiObject | UIGradient, seconds: number, dir: number?)
	local old = spins[inst]
	if old then
		old:Cancel()
		spins[inst] = nil
	end
	if Motion.reduced() or Motion.snapshot() then return end
	local d = dir or 1
	local obj = inst :: any
	obj.Rotation = 0
	local tw = TweenService:Create(inst, TweenInfo.new(seconds, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1),
		{ Rotation = 360 * d })
	spins[inst] = tw
	tw:Play()
end
function Kit.unspin(inst: Instance)
	local old = spins[inst]
	if old then
		old:Cancel()
		spins[inst] = nil
	end
end
-- a back-and-forth loop on one property (a breathing aura, a bobbing chip); off with reduced motion
local loops: { [Instance]: Tween } = setmetatable({}, { __mode = "k" }) :: any
function Kit.breathe(inst: Instance, prop: string, from: any, to: any, seconds: number)
	local old = loops[inst]
	if old then
		old:Cancel()
		loops[inst] = nil
	end
	local obj = inst :: any
	if Motion.reduced() or Motion.snapshot() then
		obj[prop] = from
		return
	end
	obj[prop] = from
	local tw = TweenService:Create(inst, TweenInfo.new(seconds, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { [prop] = to })
	loops[inst] = tw
	tw:Play()
end
function Kit.still(inst: Instance)
	local old = loops[inst]
	if old then
		old:Cancel()
		loops[inst] = nil
	end
end

-- ------------------------------------------------------------------------------------------------------ misc
function Kit.button(parent: Instance, name: string): TextButton
	local b = child(parent, name, "TextButton") :: TextButton
	b.BackgroundTransparency = 1
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.Text = ""
	b.Active = true
	b.Selectable = true
	return b
end

function Kit.rect(g: GuiObject): ARect
	local p, s = g.AbsolutePosition, g.AbsoluteSize
	return { x = p.X, y = p.Y, w = s.X, h = s.Y }
end

-- a button with a word (DESIGN.md 9.8: one line, >= 12 du side padding). style: "primary" (the hue, a darker gradient
-- so white passes 3:1), "gold" (dark ink), "danger", "quiet" (dark glass with a rim)
function Kit.action(parent: Instance, name: string, text: string, o: { style: string?, hue: Color3?, h: number?, role: string?,
	w: number? }): (TextButton, TextLabel)
	local b = Kit.button(parent, name)
	local h = o.h or 52
	b.Size = if o.w then UDim2.fromOffset(o.w, h) else UDim2.fromOffset(0, h)
	b.AutomaticSize = if o.w then Enum.AutomaticSize.None else Enum.AutomaticSize.X
	b.BackgroundTransparency = 0
	b.BackgroundColor3 = Color3.new(1, 1, 1)
	local oc = b:FindFirstChild("Corner")
	if oc then oc:Destroy() end
	Kit.pad(b, 0, 16, 0, 16)
	local style = o.style or "quiet"
	local hue = o.hue or Theme.C.system
	local fg = WHITE
	if style == "primary" then
		Kit.grad(b, { Theme.lift(hue, 0.08), Theme.shade(hue, 0.62) }, 90, nil, "Back")
		Kit.stroke(b, 2, Theme.lift(hue, 0.4), 1, "Rim")
	elseif style == "gold" then
		Kit.grad(b, { Color3.fromHex("b37400"), Color3.fromHex("6b4500") }, 90, nil, "Back")
		Kit.stroke(b, 2, Color3.fromHex("ffd34d"), 1, "Rim")
	elseif style == "danger" then
		Kit.grad(b, { Theme.shade(Theme.C.danger, 0.75), Theme.shade(Theme.C.danger, 0.42) }, 90, nil, "Back")
		Kit.stroke(b, 2, Theme.lift(Theme.C.danger, 0.3), 1, "Rim")
	else
		Kit.grad(b, { Theme.C.panel3, Theme.C.panel2 }, 90, nil, "Back")
		Kit.stroke(b, 1.5, Theme.C.strokeHi, 1, "Rim")
	end
	-- the Substance kit when it is uploaded (the gradients above stay as the fallback)
	local tint = if style == "primary" then Theme.lift(hue, 0.1) elseif style == "gold" then Color3.fromHex("ffc233")
		elseif style == "danger" then Theme.C.danger else nil
	Skin.apply(b, if tint then "cta" else "button", { tint = tint, scale = math.clamp(h / 110, 0.3, 0.6) })
	if tint and Skin.ready() then fg = Color3.fromHex("06101b") end
	local row = Kit.frame(b, "Content")
	row.AutomaticSize = Enum.AutomaticSize.X
	row.Size = UDim2.fromScale(if o.w then 1 else 0, 1)
	Kit.list(row, "x", 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local l = Kit.label(row, "Label", o.role or "tab", text, fg)
	l.LayoutOrder = 2
	l.AutomaticSize = Enum.AutomaticSize.X
	l.Size = UDim2.fromScale(0, 1)
	Kit.textStroke(l, if style == "quiet" or Skin.ready() then 0 else 1.5, 0.8)
	local over = child(l, "Overhang", "UIPadding") :: UIPadding
	over.PaddingRight = UDim.new(0, 3)
	return b, l
end

-- a chip: a rounded frame with a label, AutomaticSize X (height h, side padding pad)
function Kit.chip(parent: Instance, name: string, role: string, text: string, o: { h: number, pad: number?, fg: Color3?, bg: Color3?,
	bgA: number?, line: Color3?, lineA: number? }): (Frame, TextLabel)
	local f = Kit.frame(parent, name)
	f.AutomaticSize = Enum.AutomaticSize.X
	f.Size = UDim2.fromOffset(0, o.h)
	f.BackgroundColor3 = o.bg or Theme.C.deep
	f.BackgroundTransparency = 1 - (if o.bgA ~= nil then o.bgA else 1)
	-- Sleek: square chips with a 1 du hairline
	local oc = f:FindFirstChild("Corner")
	if oc then oc:Destroy() end
	local pad = o.pad or 10
	Kit.pad(f, 0, pad, 0, pad)
	if o.line then
		Kit.stroke(f, 1, o.line, o.lineA).LineJoinMode = Enum.LineJoinMode.Miter
	else
		local s = f:FindFirstChild("Stroke")
		if s then s:Destroy() end
	end
	local l = Kit.label(f, "Label", role, text, o.fg)
	l.AutomaticSize = Enum.AutomaticSize.X
	l.Size = UDim2.fromScale(0, 1)
	return f, l
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">PlayerList</string>
              <string name="Source"><![CDATA[--!strict
--[[
	PlayerList: the players in this server, top right (the Roblox player list is off, see App.engineSettings).

	    Chip    "PLAYERS · N" with a caret; a press (or Tab) opens / closes the list
	    Panel   a Sleek slab: the column heads NAME | POINTS | PLAYTIME, then a row per player sorted by points,
	            highest first (the local player's row lit). Points and playtime are the server's totals, published
	            on each Player every few seconds (Worker: MT_Pts the leaderboard-formatted points, MT_PtsKey their
	            sort key, MT_Played the real seconds played).

	    local list = PlayerList.new(root)
	    list:setOpen(b)   list:isOpen()   list.frame   list:destroy()
]]
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Core = script.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Rich = require(Core:WaitForChild("Rich"))
local Sleek = require(Core:WaitForChild("Sleek"))
local Kit = require(script.Parent:WaitForChild("Kit"))
local Boards = require(game:GetService("ReplicatedStorage"):WaitForChild("MilestoneTree"):WaitForChild("Boards"))

export type PlayerList = {
	frame: Frame,
	setOpen: (self: PlayerList, b: boolean) -> (),
	isOpen: (self: PlayerList) -> boolean,
	destroy: (self: PlayerList) -> (),
}

local PlayerList = {}

local CYAN = Color3.fromHex("4fd1ff")
local function nameOf(p: Player): string
	local d = p.DisplayName
	return if type(d) == "string" and d ~= "" then d else p.Name
end
local function esc(t: string): string
	return (string.gsub(string.gsub(string.gsub(t, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"))
end
local W = 460 -- the panel's width (du)
local ROW = 34

function PlayerList.new(root: GuiObject): PlayerList
	local self = {} :: PlayerList
	local conns: { RBXScriptConnection } = {}
	local open = false

	local f = Kit.frame(root, "PlayerList", 30)
	f.AnchorPoint = Vector2.new(1, 0)
	f.Size = UDim2.fromOffset(W, 0)
	f.AutomaticSize = Enum.AutomaticSize.Y
	self.frame = f
	Kit.list(f, "y", 6, Enum.HorizontalAlignment.Right)

	-- the chip
	local chip = Kit.button(f, "Chip")
	chip.LayoutOrder = 1
	chip.AutoButtonColor = false
	chip.Size = UDim2.fromOffset(0, 32)
	chip.AutomaticSize = Enum.AutomaticSize.X
	chip.BackgroundTransparency = 1
	Sleek.plate(chip, { alpha = 0.88, line = 0.86, edge = false })
	Kit.pad(chip, 0, 12, 0, 12)
	local chipRow = Kit.frame(chip, "Row")
	chipRow.AutomaticSize = Enum.AutomaticSize.X
	chipRow.Size = UDim2.fromScale(0, 1)
	Kit.list(chipRow, "x", 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local chipLabel = Kit.label(chipRow, "Label", "caps", "", Color3.new(1, 1, 1))
	chipLabel.LayoutOrder = 1
	chipLabel.AutomaticSize = Enum.AutomaticSize.X
	chipLabel.Size = UDim2.fromScale(0, 1)
	chipLabel.RichText = true
	local caret = Kit.label(chipRow, "Caret", "caps", "▾", CYAN)
	caret.LayoutOrder = 2
	caret.AutomaticSize = Enum.AutomaticSize.X
	caret.Size = UDim2.fromScale(0, 1)

	-- room under the chip when the capsule's warning chip (SOFTCAP / OVERFLOW) reaches under the panel's corner
	local spacer = Kit.frame(f, "Spacer", 30)
	spacer.LayoutOrder = 2
	spacer.Size = UDim2.fromOffset(1, 0)
	spacer.Visible = false
	local extra = 0

	-- the panel
	local panel = Kit.frame(f, "Panel", 30)
	panel.LayoutOrder = 3
	panel.Size = UDim2.fromOffset(W, 0)
	panel.AutomaticSize = Enum.AutomaticSize.Y
	panel.Visible = false
	Sleek.plate(panel, { alpha = 0.92, line = 0.86 })
	Sleek.accent(panel, CYAN, 18, 60, { name = "Accent" })
	Kit.pad(panel, 10, 12, 10, 12)
	Kit.list(panel, "y", 2, Enum.HorizontalAlignment.Left)
	local heads = Kit.frame(panel, "Heads", 31)
	heads.LayoutOrder = 0
	heads.Size = UDim2.new(1, 0, 0, 22)
	local function col(parent: Instance, name: string, role: string, text: string, color: Color3, x: number, w: number,
		align: Enum.TextXAlignment): TextLabel
		local l = Kit.label(parent, name, role, text, color)
		l.Position = UDim2.new(x, 0, 0, 0)
		l.Size = UDim2.new(w, 0, 1, 0)
		l.TextXAlignment = align
		l.TextTruncate = Enum.TextTruncate.AtEnd
		return l
	end
	col(heads, "Name", "caps", Rich.caps("Player"), Theme.C.soft, 0, 0.38, Enum.TextXAlignment.Left)
	col(heads, "Points", "caps", Rich.caps("Points"), Theme.C.soft, 0.38, 0.4, Enum.TextXAlignment.Right)
	col(heads, "Played", "caps", Rich.caps("Playtime"), Theme.C.soft, 0.78, 0.22, Enum.TextXAlignment.Right)

	local me = Players.LocalPlayer
	local function draw()
		local list = Players:GetPlayers()
		chipLabel.Text = Rich.caps("Players") .. '  <font color="#4fd1ff">' .. #list .. "</font>"
		caret.Text = if open then "▴" else "▾"
		panel.Visible = open
		if not open then return end
		table.sort(list, function(a: Player, b: Player): boolean
			local ka, kb = tonumber(a:GetAttribute("MT_PtsKey")) or 0, tonumber(b:GetAttribute("MT_PtsKey")) or 0
			if ka ~= kb then return ka > kb end
			return nameOf(a) < nameOf(b)
		end)
		local keep: { [string]: boolean } = {}
		for i, p in list do
			local name = "Row_" .. p.UserId
			keep[name] = true
			local r = panel:FindFirstChild(name) :: Frame?
			if r == nil then
				local nr = Kit.frame(panel, name, 31)
				nr.Size = UDim2.new(1, 0, 0, ROW)
				nr.BackgroundColor3 = Theme.mix(Theme.C.deep, CYAN, 0.18)
				col(nr, "Name", "card", "", Color3.new(1, 1, 1), 0, 0.38, Enum.TextXAlignment.Left)
				col(nr, "Points", "numberHeavy", "", Theme.C.text, 0.38, 0.4, Enum.TextXAlignment.Right)
				col(nr, "Played", "label", "", Theme.C.soft, 0.78, 0.22, Enum.TextXAlignment.Right)
				r = nr
			end
			local row = r :: Frame
			row.LayoutOrder = i
			row.BackgroundTransparency = if p == me then 0.15 else 1
			local pts = p:GetAttribute("MT_Pts")
			local played = tonumber(p:GetAttribute("MT_Played"))
			local nl = row:FindFirstChild("Name") :: TextLabel
			local pl = row:FindFirstChild("Points") :: TextLabel
			local tl = row:FindFirstChild("Played") :: TextLabel
			local rank = if i <= 3 then ({ "#ffc93c", "#d7e0ea", "#e39a5b" })[i] else nil
			nl.RichText = true
			nl.Text = (if rank then '<font color="' .. rank .. '">' .. i .. "</font>  " else '<font color="#8a94a6">' .. i .. "</font>  ")
				.. esc(nameOf(p))
			pl.Text = if type(pts) == "string" then pts else "…"
			tl.Text = if played then Boards.duration(played) else "…"
		end
		for _, c in panel:GetChildren() do
			if string.sub(c.Name, 1, 4) == "Row_" and not keep[c.Name] then c:Destroy() end
		end
	end

	local function place()
		-- the top right of the top bar row
		f.Position = UDim2.new(1, -12, 0, 6)
	end
	-- while open, its area is a HUD rect (abs space): the toasts stack below it, plates and markers keep clear. Worked
	-- out from the list's own geometry (the chip, the heads, a row per player) so it holds before layout has run
	local function register()
		if not open then
			Layout.setRect("hud.players", nil)
			return
		end
		local s = math.max(Layout.s, 0.01)
		local rp, rs = root.AbsolutePosition, root.AbsoluteSize
		local left = rp.X + rs.X - (12 + W) * s
		-- on desktop the capsule's warning chip (SOFTCAP / OVERFLOW) reaches y 61 du beside the capsule: the panel
		-- always starts below that row (a fixed gap: the chip's width varies and is not laid out before it shows)
		local want = if Layout.mode == "COMPACT" then 0 else 26
		if want ~= extra then
			extra = want
			spacer.Size = UDim2.fromOffset(1, math.max(0, extra - 6))
			spacer.Visible = extra > 0
		end
		local h = 6 + 32 + 6 + extra + 20 + 22 + #Players:GetPlayers() * (ROW + 2)
		Layout.setRect("hud.players", { x = left, y = rp.Y, w = (12 + W) * s, h = h * s })
	end
	root:GetPropertyChangedSignal("AbsoluteSize"):Connect(register)
	local rectsConn = Layout.rectsChanged:Connect(function()
		if open then register() end
	end)

	function self.setOpen(_: PlayerList, b: boolean)
		open = b
		draw()
		register()
	end
	function self.isOpen(_: PlayerList): boolean
		return open
	end

	chip.Activated:Connect(function() self:setOpen(not open) end)
	table.insert(conns, UserInputService.InputBegan:Connect(function(io: InputObject, processed: boolean)
		if processed then return end
		if io.KeyCode == Enum.KeyCode.Tab then self:setOpen(not open) end
	end))
	local watched: { [Player]: { RBXScriptConnection } } = {}
	table.insert(conns, Players.PlayerAdded:Connect(function() task.defer(register) end))
	table.insert(conns, Players.PlayerRemoving:Connect(function() task.defer(register) end))
	local function watch(p: Player)
		local list = {}
		for _, a in { "MT_Pts", "MT_Played" } do
			table.insert(list, p:GetAttributeChangedSignal(a):Connect(function()
				if open then draw() end
			end))
		end
		watched[p] = list
		draw()
	end
	for _, p in Players:GetPlayers() do watch(p) end
	table.insert(conns, Players.PlayerAdded:Connect(watch))
	table.insert(conns, Players.PlayerRemoving:Connect(function(p: Player)
		local w = watched[p]
		if w then
			for _, c in w do c:Disconnect() end
		end
		watched[p] = nil
		task.defer(draw)
	end))
	local layoutConn = Layout.changed:Connect(place)
	function self.destroy(_: PlayerList)
		for _, c in conns do c:Disconnect() end
		layoutConn:Disconnect()
		rectsConn:Disconnect()
		Layout.setRect("hud.players", nil)
		for _, list in watched do
			for _, c in list do c:Disconnect() end
		end
		f:Destroy()
	end
	place()
	draw()
	return self
end

return PlayerList
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="102">
            <Properties>
              <string name="Name">Portal</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Portal: the Multiverse portal at the bottom right (DESIGN.md 4.6).

	    Portal   140 x 160 (COMPACT 92 x 104)
	      Aura   a soft glow in the state colour (breathing when FINISH)
	      Disc   Ø112 (70): a Conical ring (#ff2e63, #b35cff, #ff5a1f, #ffd34d) rotating 8 s / rev; desaturated and still
	             while sealed
	      Void   the inner void (radial #05030b -> #1a0a24) with a swirl, or "?" while sealed
	      Label  a glass pill hanging from the rim: "MULTIVERSE" (`tab`) over the state line (`label` + `number`);
	             COMPACT the state line alone

	    state      from
	    sealed     gate.show == false: "SEALED 164/185" (hidden in first-run mode)
	    locked     show, not can: LOCKED + lock
	    enter      can, outside: ENTER (crimson)
	    exit       inside, not fin: EXIT EARLY (orange)
	    finish     inside, fin: FINISH (gold aura breathing)

	    local part = Portal.new(parent)
	    part:update(gate?)   part:setHidden(b)   part.tap ()
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Signal = require(Core:WaitForChild("Signal"))
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Rich = require(Core:WaitForChild("Rich"))
local Kit = require(script.Parent:WaitForChild("Kit"))

export type Portal = {
	frame: Frame,
	tap: Signal.Signal<>,
	changed: Signal.Signal<>,
	state: string,
	update: (self: Portal, gate: Types.Gate?) -> (),
	setHidden: (self: Portal, b: boolean) -> (),
	destroy: (self: Portal) -> (),
}

local Portal = {}

local RING = { Color3.fromHex("ff2e63"), Color3.fromHex("b35cff"), Color3.fromHex("ff5a1f"), Color3.fromHex("ffd34d"), Color3.fromHex("ff2e63") }
local GREY = { Color3.fromHex("6a5f8f"), Color3.fromHex("3a3352"), Color3.fromHex("5c5775"), Color3.fromHex("3a3352"), Color3.fromHex("6a5f8f") }
local STATE_COLOR: { [string]: Color3 } = {
	sealed = Color3.fromHex("8d86a8"),
	locked = Color3.fromHex("9a94b8"),
	enter = Color3.fromHex("ff2e63"),
	exit = Color3.fromHex("ff7a2e"),
	finish = Color3.fromHex("ffc233"),
}

function Portal.new(parent: GuiObject): Portal
	local self = {} :: Portal
	self.tap = Signal.new() :: Signal.Signal<>
	self.changed = Signal.new() :: Signal.Signal<>
	self.state = ""

	local f = Kit.frame(parent, "Portal", 5)
	f.AnchorPoint = Vector2.new(1, 1)
	self.frame = f
	local aura = Kit.blob(f, "Aura", STATE_COLOR.enter, 0.55, 1)
	local disc = Kit.frame(f, "Disc", 2)
	disc.AnchorPoint = Vector2.new(0.5, 0)
	disc.BackgroundColor3 = Color3.new(1, 1, 1)
	disc.BackgroundTransparency = 0
	Kit.corner(disc)
	local ringGrad = Kit.child(disc, "Ring", "UIGradient") :: UIGradient
	if Theme.caps.Conical then ringGrad.Type = Enum.GradientType.Conical end
	local void = Kit.frame(disc, "Void", 3)
	void.AnchorPoint = Vector2.new(0.5, 0.5)
	void.Position = UDim2.fromScale(0.5, 0.5)
	void.Size = UDim2.fromScale(0.78, 0.78)
	void.BackgroundColor3 = Color3.new(1, 1, 1)
	void.BackgroundTransparency = 0
	Kit.corner(void)
	local vg = Kit.child(void, "Radial", "UIGradient") :: UIGradient
	if Theme.caps.Radial then vg.Type = Enum.GradientType.Radial end
	vg.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromHex("05030b")),
		ColorSequenceKeypoint.new(0.7, Color3.fromHex("1a0a24")),
		ColorSequenceKeypoint.new(1, Color3.fromHex("1a0a24")),
	})
	local swirl = Kit.glyph(void, "Swirl", "swirl", Color3.fromHex("ff8fb0"))
	swirl.AnchorPoint = Vector2.new(0.5, 0.5)
	swirl.Position = UDim2.fromScale(0.5, 0.5)
	swirl.Size = UDim2.fromScale(0.5, 0.5)
	swirl.ZIndex = 4
	local q = Kit.label(void, "Question", "big", "?", Color3.fromHex("c9c3e6"))
	q.Size = UDim2.fromScale(1, 1)
	q.TextXAlignment = Enum.TextXAlignment.Center
	q.ZIndex = 4
	Kit.textStroke(q, 3, 1)

	local pill = Kit.frame(f, "Label", 6)
	pill.AnchorPoint = Vector2.new(0.5, 1)
	pill.Position = UDim2.fromScale(0.5, 1)
	pill.AutomaticSize = Enum.AutomaticSize.X
	-- Sleek: a dark slab with a 1 du rim in the state colour
	pill.BackgroundColor3 = Color3.fromHex("06090f")
	pill.BackgroundTransparency = 0.12
	local pRim = Kit.stroke(pill, 1, STATE_COLOR.enter, 0.8, "Rim")
	pRim.LineJoinMode = Enum.LineJoinMode.Miter
	Kit.list(pill, "y", 0, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local title = Kit.label(pill, "Title", "label", Rich.caps("Multiverse"), Color3.new(1, 1, 1))
	title.LayoutOrder = 1
	title.AutomaticSize = Enum.AutomaticSize.XY
	Kit.textStroke(title, 1.5, 0.8)
	local line = Kit.frame(pill, "Line")
	line.LayoutOrder = 2
	line.AutomaticSize = Enum.AutomaticSize.XY
	Kit.list(line, "x", 5, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local lock = Kit.glyph(line, "Lock", "lock", Theme.C.gold, Color3.fromHex("0e0b18"))
	lock.LayoutOrder = 1
	lock.Visible = false
	local word = Kit.label(line, "Word", "label", "", Theme.C.soft)
	word.LayoutOrder = 2
	word.AutomaticSize = Enum.AutomaticSize.XY
	local numL = Kit.label(line, "Num", "number", "", Color3.new(1, 1, 1))
	numL.LayoutOrder = 3
	numL.AutomaticSize = Enum.AutomaticSize.XY

	local hit = Kit.button(f, "Hit")
	hit.Size = UDim2.fromScale(1, 1)
	hit.ZIndex = 10
	hit.Activated:Connect(function() self.tap:Fire() end)

	local hidden = false
	local gate: Types.Gate? = nil
	local compact = false

	local function place()
		compact = Layout.mode == "COMPACT"
		local w, h = if compact then 92 else 140, if compact then 104 else 160
		local d = if compact then 70 else 112
		f.Size = UDim2.fromOffset(w, h)
		f.Position = UDim2.new(1, if compact then -10 else -16, 1, if compact then -4 else -8)
		disc.Size = UDim2.fromOffset(d, d)
		disc.Position = UDim2.new(0.5, 0, 0, 0)
		if aura then
			aura.AnchorPoint = Vector2.new(0.5, 0.5)
			aura.Position = UDim2.new(0.5, 0, 0, d / 2)
			aura.Size = UDim2.fromOffset(d * 1.9, d * 1.9)
		end
		pill.Size = UDim2.fromOffset(0, if compact then 26 else 46)
		Kit.pad(pill, 0, 12, 0, 12)
		title.Visible = not compact
		Theme.text(title, "label")
		Theme.text(word, "label")
		Theme.text(numL, "number")
		lock.Size = UDim2.fromOffset(13, 13)
		self.changed:Fire()
	end
	place()

	local function apply()
		local g = gate
		local st: string
		if g == nil or not g.show then
			st = "sealed"
		elseif g.inside then
			st = if g.fin then "finish" else "exit"
		elseif not g.can then
			st = "locked"
		else
			st = "enter"
		end
		local c = STATE_COLOR[st]
		pRim.Color = c
		lock.Visible = st == "locked"
		q.Visible = st == "sealed"
		swirl.Visible = st ~= "sealed"
		numL.Text = ""
		if st == "sealed" then
			local req = g and g.req
			word.Text = if compact then "" else Rich.caps("Sealed")
			numL.Text = if req then req.have .. "/" .. req.need else ""
			word.Visible = not compact
		else
			word.Visible = true
			word.Text = Rich.caps(if st == "locked" then "Locked" elseif st == "enter" then "Enter"
				elseif st == "exit" then "Exit early" else "Finish")
		end
		word.TextColor3 = if st == "sealed" then Theme.C.soft else Theme.lift(c, 0.45)
		numL.Visible = numL.Text ~= ""
		if st ~= self.state then
			self.state = st
			f:SetAttribute("State", st)
			local stops: { Color3 } = if st == "sealed" or st == "locked" then GREY else RING
			local keys = {}
			for i, col in stops do table.insert(keys, ColorSequenceKeypoint.new((i - 1) / (#stops - 1), col)) end
			ringGrad.Color = ColorSequence.new(keys)
			if st == "sealed" or st == "locked" then Kit.unspin(ringGrad) else Kit.spin(ringGrad, 8) end
			local a = aura
			if a then
				a.BackgroundColor3 = c
				local ag = a:FindFirstChild("Radial") :: UIGradient?
				if ag then ag.Color = ColorSequence.new(c) end
				a.Visible = st ~= "sealed"
				if st == "finish" then
					Kit.breathe(a, "BackgroundTransparency", 0, 0.5, 1.2)
				else
					Kit.still(a)
					a.BackgroundTransparency = if st == "locked" then 0.7 else 0.2
				end
			end
		end
	end

	function self.update(_: Portal, g: Types.Gate?)
		gate = g
		apply()
	end
	function self.setHidden(p: Portal, b: boolean)
		if b == hidden then return end
		hidden = b
		f.Visible = not b
		p.changed:Fire()
	end
	function self.destroy(p: Portal)
		p.tap:DisconnectAll()
		p.changed:DisconnectAll()
		Kit.unspin(ringGrad)
		f:Destroy()
	end
	Layout.changed:Connect(function()
		place()
		apply()
	end)
	apply()
	return self
end

return Portal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">Ready</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Ready: the READY tray (desktop) or pill (phones, and the strip beside a side sheet) of DESIGN.md 4.5.

	    Ready      glass tray, gold rim, right edge at W - 170 (left of the portal)
	      Header   bolt + "3 READY" (`toast`, #ffe08a) + "· 4 can buy" (`label`, #ffb3c0) + the gesture hint
	      Gems     Gem_<id>: a 52 du gem (radial hue, symbol), the chip below ("+gain" gold / "BUY" danger rim),
	               96 du pitch, at most 6 + "+N more"; READY gems hold 0.6 s to prestige (a conical ring fills)
	      Banner   while a hold runs: "HOLDING · PRESTIGE <LAYER>  +gain" over "Release to cancel"
	    ReadyPill  up to 3 mini gems + "N READY" over "Tap to list" / "Tap a gem to switch"; a tap opens the tray
	               above it (COMPACT) - in the strip each gem opens its layer

	Entries: every shown node with val.pulse (READY, gain chip), then every node with val.glow (CAN BUY), in the fixed
	map order (MapState.ready / canBuy), so nothing jumps. Hidden when both are empty.

	    local part = Ready.new(parent)
	    part:update(ms)   part:setMode("tray" | "pill" | "strip")   part:setHidden(b)
	    part.tap (layer), part.hold (layer), part.more ()
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Signal = require(Core:WaitForChild("Signal"))
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Motion = require(Core:WaitForChild("Motion"))
local Rich = require(Core:WaitForChild("Rich"))
local Recipes = require(Core:WaitForChild("Recipes"))
local Sleek = require(Core:WaitForChild("Sleek"))
local Skin = require(Core:WaitForChild("Skin"))
local Kit = require(script.Parent:WaitForChild("Kit"))
local NodeAtlas = require(game:GetService("ReplicatedStorage"):WaitForChild("MilestoneTree"):WaitForChild("NodeAtlas"))

type MapState = Types.MapState

export type Ready = {
	frame: Frame,
	pill: Frame,
	banner: Frame,
	tap: Signal.Signal<string>,
	hold: Signal.Signal<string>,
	more: Signal.Signal<>,
	changed: Signal.Signal<>,
	update: (self: Ready, ms: MapState) -> (),
	setMode: (self: Ready, mode: string) -> (),
	setHidden: (self: Ready, b: boolean) -> (),
	destroy: (self: Ready) -> (),
}

local Ready = {}

local MAX_GEMS = 6
local GOLD = Color3.fromHex("ffc233")
local READY_TEXT = Theme.C.ready
local SYMS = {
	ach = "★", m = "M", mm = "MM", em = "EM", p = "P", pe = "PE", sp = "SP", pb = "PB", pp = "PP", se = "SE", hp = "HP",
	ep = "EP", hb = "HB", ap = "AP", mp = "MP", t = "T", pm = "PM", pep = "PEP", cp = "CR", cm = "CM", ex = "EX",
} :: { [string]: string }
local NAMES = {
	m = "Milestone", mm = "Meta", em = "Extra", p = "Prestige", pe = "Energy", sp = "Super", pb = "Boost", pp = "Power",
	se = "Super Energy", hp = "Hyper", ep = "Exotic", hb = "Hyper Boost", ap = "Atomic", mp = "Multiverse", t = "Transcend",
	pm = "Multiverse", pep = "Prestiged Exotic", cp = "Corrupted", cm = "Corrupted Milestone", ex = "Explore", ach = "Achievements",
} :: { [string]: string }

type Entry = { layer: string, ready: boolean, gain: string?, sym: string }

-- a gem: disc + symbol (Sarpanch Heavy) in `size` du
local function gem(parent: Instance, name: string, layer: string, sym: string, size: number): Frame
	local g = Kit.frame(parent, name, 3)
	g.Size = UDim2.fromOffset(size, size)
	-- the layer's crystal from the node atlas (the map's gems); the drawn disc is the fallback before the upload
	local r = NodeAtlas.rects[layer]
	if NodeAtlas.id and r then
		for _, n in { "Grad", "Radial", "Rim", "Corner", "Symbol", "Star" } do
			local old = g:FindFirstChild(n)
			if old then old:Destroy() end
		end
		g.BackgroundTransparency = 1
		local im = Kit.child(g, "Crystal", "ImageLabel") :: ImageLabel
		im.BackgroundTransparency = 1
		im.BorderSizePixel = 0
		im.Image = NodeAtlas.id :: string
		im.ImageRectOffset = Vector2.new(r[1], r[2])
		im.ImageRectSize = Vector2.new(r[3], r[4])
		im.AnchorPoint = Vector2.new(0.5, 0.5)
		im.Position = UDim2.fromScale(0.5, 0.5)
		im.Size = UDim2.fromScale(1.1, 1.1)
		im.ZIndex = 4
		return g
	end
	Kit.gem(g, Theme.hue(layer))
	Kit.stroke(g, 1, Theme.lift(Theme.hue(layer), 0.6), 0.6, "Rim")
	if sym == "★" then
		local st = Kit.glyph(g, "Star", "star", Color3.new(1, 1, 1))
		st.AnchorPoint = Vector2.new(0.5, 0.5)
		st.Position = UDim2.fromScale(0.5, 0.5)
		st.Size = UDim2.fromScale(0.5, 0.5)
		st.ZIndex = 4
	else
		local l = Kit.label(g, "Symbol", "index", sym, Color3.new(1, 1, 1))
		l.Size = UDim2.fromScale(1, 1)
		l.ZIndex = 4
		l.TextXAlignment = Enum.TextXAlignment.Center
		l.TextSize = math.max(13, math.floor(size * (if #sym >= 3 then 0.3 elseif #sym == 2 then 0.36 else 0.44)))
		Kit.textStroke(l, if size >= 40 then 1.5 else 1, 0.35)
	end
	return g
end
Ready.gem = gem

function Ready.new(parent: GuiObject): Ready
	local self = {} :: Ready
	self.tap = Signal.new() :: Signal.Signal<string>
	self.hold = Signal.new() :: Signal.Signal<string>
	self.more = Signal.new() :: Signal.Signal<>
	self.changed = Signal.new() :: Signal.Signal<>

	-- ------------------------------------------------------------------------------------------ the tray
	local tray = Kit.frame(parent, "Ready", 5)
	tray.AnchorPoint = Vector2.new(1, 1)
	-- Sleek: a dark slab with a hairline; its corner ticks live on a sibling that copies the tray's rect (the tray
	-- lays its children out in a list, so it is sized explicitly in layout())
	tray.AutomaticSize = Enum.AutomaticSize.None
	tray.Visible = false
	Sleek.plate(tray, { alpha = 0.88, line = 0.86 })
	Kit.pad(tray, 12, 18, 10, 18)
	local trayTicks = Kit.frame(parent, "ReadyTicks", 4)
	trayTicks.AnchorPoint = Vector2.new(1, 1)
	trayTicks.Visible = false
	Sleek.ticks(trayTicks, { len = 10, th = 2, out = 1, color = Color3.new(1, 1, 1), alpha = 0.8, z = 6 })
	-- the tray lays out a list, so its Substance plate lives on this sibling (same rect, drawn under the tray)
	if Skin.apply(trayTicks, "plate", { scale = 0.5 }) then
		tray.BackgroundTransparency = 1
		local hair = tray:FindFirstChild("Hair") :: UIStroke?
		if hair then hair.Enabled = false end
		local edge = tray:FindFirstChild("Edge") :: GuiObject?
		if edge then edge.Visible = false end
	end
	Kit.list(tray, "y", 8, Enum.HorizontalAlignment.Left)
	self.frame = tray

	local header = Kit.frame(tray, "Header")
	header.LayoutOrder = 1
	header.AutomaticSize = Enum.AutomaticSize.X
	header.Size = UDim2.fromOffset(0, 22)
	Kit.list(header, "x", 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local hb = Kit.glyph(header, "Bolt", "bolt", READY_TEXT)
	hb.LayoutOrder = 1
	hb.Size = UDim2.fromOffset(16, 16)
	local count = Kit.label(header, "Count", "label", "", READY_TEXT)
	count.LayoutOrder = 2
	count.AutomaticSize = Enum.AutomaticSize.X
	count.Size = UDim2.fromScale(0, 1)
	local buy = Kit.label(header, "CanBuy", "small", "", Sleek.C.soft)
	buy.LayoutOrder = 3
	buy.AutomaticSize = Enum.AutomaticSize.X
	buy.Size = UDim2.fromScale(0, 1)
	local hint = Kit.label(header, "Hint", "small", "Tap to open · hold to prestige", Theme.C.soft)
	hint.LayoutOrder = 4
	hint.AutomaticSize = Enum.AutomaticSize.X
	hint.Size = UDim2.fromScale(0, 1)
	local hinted = true

	local gems = Kit.frame(tray, "Gems")
	gems.LayoutOrder = 2
	gems.AutomaticSize = Enum.AutomaticSize.X
	gems.Size = UDim2.fromOffset(0, 82)
	Kit.list(gems, "x", 0, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)

	-- the hold banner
	local banner = Kit.frame(parent, "HoldBanner", 6)
	banner.AnchorPoint = Vector2.new(1, 1)
	banner.AutomaticSize = Enum.AutomaticSize.XY
	Sleek.plate(banner, { alpha = 0.92, line = 0.86, tint = GOLD, tintAlpha = 0.12 })
	banner.BackgroundTransparency = 0.04
	banner.Visible = false
	Kit.stroke(banner, 1, GOLD, 0.5, "Rim").LineJoinMode = Enum.LineJoinMode.Miter
	Kit.pad(banner, 8, 16, 9, 16)
	Kit.list(banner, "y", 4, Enum.HorizontalAlignment.Left)
	local bTop = Kit.frame(banner, "Top")
	bTop.LayoutOrder = 1
	bTop.AutomaticSize = Enum.AutomaticSize.XY
	Kit.list(bTop, "x", 10, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local bTitle = Kit.label(bTop, "Title", "toast", "", READY_TEXT)
	bTitle.LayoutOrder = 1
	bTitle.AutomaticSize = Enum.AutomaticSize.XY
	Kit.textStroke(bTitle, 1.5, 0.8)
	local bGain = Kit.label(bTop, "Gain", "number", "", Color3.new(1, 1, 1))
	bGain.LayoutOrder = 2
	bGain.AutomaticSize = Enum.AutomaticSize.XY
	bGain.RichText = true
	local bSub = Kit.label(banner, "Sub", "small", "Release to cancel", Color3.fromHex("ffe9a3"))
	bSub.LayoutOrder = 2
	bSub.AutomaticSize = Enum.AutomaticSize.XY
	self.banner = banner

	-- ------------------------------------------------------------------------------------------ the pill
	local pill = Kit.frame(parent, "ReadyPill", 5)
	pill.AnchorPoint = Vector2.new(1, 1)
	pill.AutomaticSize = Enum.AutomaticSize.X
	Sleek.plate(pill, { alpha = 0.88, line = 0.86 })
	pill.BackgroundTransparency = 0.06
	pill.Visible = false

	local pillRow = Kit.frame(pill, "Row")
	pillRow.AutomaticSize = Enum.AutomaticSize.X
	pillRow.Size = UDim2.fromScale(0, 1)
	Kit.list(pillRow, "x", 10, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local mini = Kit.frame(pillRow, "Gems")
	mini.LayoutOrder = 1
	mini.AutomaticSize = Enum.AutomaticSize.X
	Kit.list(mini, "x", 2, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local pText = Kit.frame(pillRow, "Text")
	pText.LayoutOrder = 2
	pText.AutomaticSize = Enum.AutomaticSize.XY
	Kit.list(pText, "y", 4, Enum.HorizontalAlignment.Left)
	local pCount = Kit.label(pText, "Count", "toast", "", READY_TEXT)
	pCount.LayoutOrder = 1
	pCount.AutomaticSize = Enum.AutomaticSize.XY
	local pSub = Kit.label(pText, "Sub", "small", "Tap to list", Theme.C.soft)
	pSub.LayoutOrder = 2
	pSub.AutomaticSize = Enum.AutomaticSize.XY
	local pillHit = Kit.button(pill, "Hit")
	pillHit.Size = UDim2.fromScale(1, 1)
	pillHit.ZIndex = 2

	-- ------------------------------------------------------------------------------------------ state
	local mode = "tray"
	local hidden = false
	local expanded = false
	local entries: { Entry } = {}
	local sig = ""
	local holds: { [string]: Recipes.Hold } = {}
	local gains: { [string]: string } = {}

	local function clearGems()
		for _, h in holds do h:destroy() end
		table.clear(holds)
		for _, c in gems:GetChildren() do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		for _, c in mini:GetChildren() do
			if c:IsA("GuiObject") then c:Destroy() end
		end
	end

	local function chipFor(slot: Frame, e: Entry)
		local compact = Layout.mode == "COMPACT"
		local h = if compact then 24 else 26
		if e.ready then
			local text = "+" .. Rich.short(e.gain or "1")
			local c, l = Kit.chip(slot, "Chip", "badge", "", { h = h, pad = 4, fg = Sleek.C.goldText, bgA = 0 })
			l.RichText = true
			l.Text = Rich.num(text, { size = Theme.size("badge"), unit = Sleek.C.goldText })
			c.AnchorPoint = Vector2.new(0.5, 0)
			c.Position = UDim2.new(0.5, 0, 0, 56)
		else
			local c = Kit.chip(slot, "Chip", "caps", Rich.caps("Buy"), { h = h, pad = 4, fg = Theme.lift(Theme.hue(e.layer), 0.45),
				bgA = 0 })
			c.AnchorPoint = Vector2.new(0.5, 0)
			c.Position = UDim2.new(0.5, 0, 0, 56)
		end
	end

	local function buildGems()
		clearGems()
		local shown = math.min(#entries, MAX_GEMS)
		for i = 1, shown do
			local e = entries[i]
			local slot = Kit.frame(gems, "Gem_" .. e.layer)
			slot.LayoutOrder = i
			slot.Size = UDim2.fromOffset(96, 82)
			local g = gem(slot, "Disc", e.layer, e.sym, 52)
			g.AnchorPoint = Vector2.new(0.5, 0)
			g.Position = UDim2.fromScale(0.5, 0)
			chipFor(slot, e)
			local hit = Kit.button(slot, "Hit")
			hit.AnchorPoint = Vector2.new(0.5, 0)
			hit.Position = UDim2.fromScale(0.5, 0)
			hit.Size = UDim2.fromOffset(62, 62)
			hit.ZIndex = 6
			local layer = e.layer
			if e.ready then
				local h = Recipes.hold(hit, { dur = 0.6, ring = true, color = GOLD, onDone = function()
					if hinted then
						hinted = false
						hint.Visible = false
					end
					self.hold:Fire(layer)
				end })
				local ring = hit:FindFirstChild("Ring") :: Frame?
				if ring then ring.Size = UDim2.fromOffset(62, 62) end
				holds[layer] = h
			end
			hit.Activated:Connect(function()
				local h = holds[layer]
				if h and h:consumed() then return end
				self.tap:Fire(layer)
			end)
		end
		if #entries > MAX_GEMS then
			local slot = Kit.frame(gems, "More")
			slot.LayoutOrder = 100
			slot.Size = UDim2.fromOffset(96, 82)
			local c, _ = Kit.chip(slot, "Chip", "label", "+" .. (#entries - MAX_GEMS) .. " more", { h = 28, pad = 10,
				fg = Theme.C.soft, bg = Theme.C.panel3, bgA = 1, line = Theme.C.strokeHi, lineA = 1 })
			c.AnchorPoint = Vector2.new(0.5, 0.5)
			c.Position = UDim2.fromOffset(48, 26)
			local hit = Kit.button(slot, "Hit")
			hit.Size = UDim2.fromScale(1, 1)
			hit.Activated:Connect(function() self.more:Fire() end)
		end
		-- the pill's mini gems
		local compact = Layout.mode == "COMPACT"
		local ms = if compact then 30 else 34
		for i = 1, math.min(3, #entries) do
			local e = entries[i]
			local g = gem(mini, "Mini_" .. e.layer, e.layer, e.sym, ms)
			g.LayoutOrder = i
			local hit = Kit.button(g, "Hit")
			hit.Size = UDim2.fromScale(1, 1)
			hit.ZIndex = 6
			hit.Visible = mode == "strip"
			local layer = e.layer
			hit.Activated:Connect(function() self.tap:Fire(layer) end)
		end
	end

	local function layout()
		local compact = Layout.mode == "COMPACT"
		local nReady, nBuy = 0, 0
		for _, e in entries do
			if e.ready then nReady += 1 else nBuy += 1 end
		end
		local any = #entries > 0
		local usePill = mode == "strip" or (mode == "pill" and not expanded)
		tray.Visible = any and not hidden and not usePill
		pill.Visible = any and not hidden and usePill
		-- positions
		local right = if mode == "tray" then -170 else -14
		local bottom = if compact then -6 else -8
		tray.Position = UDim2.new(1, if mode == "pill" then -14 else right, 1, if mode == "pill" then bottom - 64 else bottom)
		pill.Position = UDim2.new(1, if mode == "strip" then -14 else (if compact then -110 else -170), 1, bottom)
		pill.Size = UDim2.fromOffset(0, if compact then 50 else 56)
		Kit.pad(pill, 0, 14, 0, 8)
		banner.Position = UDim2.new(1, if mode == "tray" then -170 else -14, 1, bottom - 150)
		-- texts
		count.Text = if nReady > 0 then Rich.caps(nReady .. " ready") else Rich.caps(nBuy .. " can buy")
		buy.Text = if nReady > 0 and nBuy > 0 then "· " .. nBuy .. " can buy" else ""
		buy.Visible = nReady > 0 and nBuy > 0
		hint.Visible = hinted and nReady > 0 and not compact
		Theme.text(count, "label")
		Theme.text(pCount, "toast")
		pCount.Text = if nReady > 0 then Rich.caps(nReady .. " ready") else Rich.caps(nBuy .. " can buy")
		pSub.Text = if mode == "strip" then "Tap a gem to switch" else "Tap to list"
		-- the tray's size (it holds a list, so no AutomaticSize): the gem row or the header, whichever is wider
		local shown = math.min(#entries, MAX_GEMS)
		local gemsW = shown * 96 + (if #entries > MAX_GEMS then 96 else 0)
		local headW = 16 + 8 + count.TextBounds.X
		if buy.Visible then headW += 8 + buy.TextBounds.X end
		if hint.Visible then headW += 8 + hint.TextBounds.X end
		tray.Size = UDim2.fromOffset(36 + math.max(gemsW, headW, 240), 12 + 22 + 8 + 82 + 10)
		trayTicks.Position = tray.Position
		trayTicks.Size = tray.Size
		trayTicks.Visible = tray.Visible
		self.changed:Fire()
	end

	-- the banner follows any running hold
	Motion.loop(tray, function()
		local holding: string? = nil
		for layer, h in holds do
			if h.holding then holding = layer end
		end
		local on = holding ~= nil
		if on and holding then
			local name = NAMES[holding] or string.upper(holding)
			bTitle.Text = Rich.caps("Holding") .. " · " .. string.upper("Prestige " .. name)
			local g = gains[holding]
			bGain.Text = if g then Rich.num("+" .. g, { size = Theme.size("number"), unit = Color3.fromHex("ffe9a3") }) else ""
		end
		if banner.Visible ~= on then banner.Visible = on end
	end)

	pillHit.Activated:Connect(function()
		if mode == "pill" then
			expanded = true
			layout()
			task.delay(6, function()
				if expanded then
					expanded = false
					layout()
				end
			end)
		end
	end)

	function self.update(_: Ready, ms: MapState)
		local list: { Entry } = {}
		for _, l in ms.ready do
			local n = ms.nodes[l]
			local v = n and n.val
			table.insert(list, { layer = l, ready = true, gain = if v then v.gain else nil, sym = (n and n.sym) or SYMS[l] or l })
			if v and v.gain then gains[l] = v.gain else gains[l] = nil end
		end
		for _, l in ms.canBuy do
			local n = ms.nodes[l]
			table.insert(list, { layer = l, ready = false, gain = nil, sym = (n and n.sym) or SYMS[l] or l })
		end
		local parts = {}
		for _, e in list do table.insert(parts, e.layer .. (if e.ready then "!" else "?") .. (e.gain or "")) end
		local nsig = table.concat(parts, ",") .. "|" .. mode .. "|" .. Layout.mode
		-- a rebuild destroys the gems and any hold on them: while a gem is pressed, the set waits (with automation
		-- the CAN BUY set can change several times a second, which cancelled every hold)
		local pressed = false
		for _, h in holds do
			if h.pressed or h.holding then pressed = true end
		end
		if pressed then
			local a = string.gsub(sig, "!([^,|]*)", "!")
			local b = string.gsub(nsig, "!([^,|]*)", "!")
			if a ~= b then return end
		end
		entries = list
		if nsig ~= sig then
			-- the gain text alone changed: rewrite the chips, keep the gems (and any running hold)
			local sameSet = true
			local a = string.gsub(sig, "!([^,|]*)", "!")
			local b = string.gsub(nsig, "!([^,|]*)", "!")
			if a ~= b then sameSet = false end
			sig = nsig
			if sameSet then
				for _, e in list do
					local slot = gems:FindFirstChild("Gem_" .. e.layer) :: Frame?
					if slot and e.ready then chipFor(slot, e) end
				end
			else
				buildGems()
			end
		end
		layout()
	end
	function self.setMode(_: Ready, m: string)
		if m == mode then return end
		mode = m
		expanded = false
		sig = ""
		buildGems()
		layout()
	end
	function self.setHidden(_: Ready, b: boolean)
		if b == hidden then return end
		hidden = b
		layout()
	end
	function self.destroy(r: Ready)
		clearGems()
		for _, s in { r.more, r.changed } do s:DisconnectAll() end
		r.tap:DisconnectAll()
		r.hold:DisconnectAll()
		tray:Destroy()
		trayTicks:Destroy()
		pill:Destroy()
		banner:Destroy()
	end
	Layout.changed:Connect(function()
		sig = ""
		buildGems()
		layout()
	end)
	return self
end

return Ready
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">UniverseTag</string>
              <string name="Source"><![CDATA[--!strict
--[[
	UniverseTag: inside the Prestige Multiverse, a tag hanging under the capsule (DESIGN.md 4.3): a swirl, the state in
	sentence case ("Goal met: leaving will finish" / "Goal not met: leaving exits early", `small`, #ffd0dc) and the
	FINISH / EXIT hold chip (dark ink on the gold gradient, a ring glyph for the hold; 1.2 s, Recipes.hold).

	    local part = UniverseTag.new(parent)
	    part:update(gate?)      shown only while gate.inside
	    part:setTop(y)          du below the Root top
	    part.hold ()            the hold completed (Hud forwards it as gateHold)
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Signal = require(Core:WaitForChild("Signal"))
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Rich = require(Core:WaitForChild("Rich"))
local Recipes = require(Core:WaitForChild("Recipes"))
local Kit = require(script.Parent:WaitForChild("Kit"))

export type UniverseTag = {
	frame: Frame,
	hold: Signal.Signal<>,
	update: (self: UniverseTag, gate: Types.Gate?) -> (),
	setTop: (self: UniverseTag, y: number, x: number?) -> (),
	destroy: (self: UniverseTag) -> (),
}

local UniverseTag = {}

local CRIMSON = Color3.fromHex("ff2e63")
local PINK = Color3.fromHex("ffd0dc")
local INK = Color3.fromHex("2a1a00")

function UniverseTag.new(parent: GuiObject): UniverseTag
	local self = {} :: UniverseTag
	self.hold = Signal.new() :: Signal.Signal<>
	local f = Kit.frame(parent, "UniTag", 6)
	f.AnchorPoint = Vector2.new(0.5, 0)
	f.AutomaticSize = Enum.AutomaticSize.X
	f.BackgroundColor3 = Color3.fromHex("1a0a24")
	f.BackgroundTransparency = 0.08
	f.Visible = false
	Kit.corner(f)
	Kit.stroke(f, 1.5, CRIMSON, 0.9, "Rim")
	Kit.list(f, "x", 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	self.frame = f
	local swirl = Kit.glyph(f, "Swirl", "swirl", Theme.lift(CRIMSON, 0.2))
	swirl.LayoutOrder = 1
	local text = Kit.label(f, "Label", "small", "", PINK)
	text.LayoutOrder = 2
	text.AutomaticSize = Enum.AutomaticSize.X

	local chip = Kit.button(f, "Finish")
	chip.LayoutOrder = 3
	chip.AutomaticSize = Enum.AutomaticSize.X
	chip.BackgroundTransparency = 0
	chip.BackgroundColor3 = Color3.new(1, 1, 1)
	Kit.corner(chip)
	Kit.grad(chip, { Color3.fromHex("ffe89a"), Color3.fromHex("ffc233"), Color3.fromHex("d99a1a") }, 90, nil, "Back")
	local inner = Kit.frame(chip, "Content")
	inner.AutomaticSize = Enum.AutomaticSize.X
	inner.Size = UDim2.fromScale(0, 1)
	Kit.list(inner, "x", 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local ring = Kit.glyph(inner, "Ring", "ring", INK)
	ring.LayoutOrder = 1
	local verb = Kit.label(inner, "Verb", "label", "", INK)
	verb.LayoutOrder = 2
	verb.AutomaticSize = Enum.AutomaticSize.X
	local holder = Recipes.hold(chip, { dur = 1.2, ring = false, color = Color3.new(0, 0, 0), onDone = function()
		self.hold:Fire()
	end })
	local _ = holder

	local function place()
		local compact = Layout.mode == "COMPACT"
		local h = if compact then 36 else 40
		f.Size = UDim2.fromOffset(0, h)
		Kit.pad(f, 0, 5, 0, 12)
		swirl.Size = UDim2.fromOffset(18, 18)
		Theme.text(text, "small")
		text.Size = UDim2.fromScale(0, 1)
		chip.Size = UDim2.fromOffset(0, h - 10)
		Kit.pad(chip, 0, 12, 0, 10)
		ring.Size = UDim2.fromOffset(14, 14)
		Theme.text(verb, "label")
		verb.Size = UDim2.fromScale(0, 1)
	end
	place()
	Layout.changed:Connect(place)

	function self.update(_: UniverseTag, gate: Types.Gate?)
		local on = gate ~= nil and gate.inside
		f.Visible = on
		if not on or gate == nil then return end
		text.Text = if gate.fin then "Goal met: leaving will finish" else "Goal not met: leaving exits early"
		verb.Text = Rich.caps(if gate.fin then "Finish" else "Exit")
	end
	function self.setTop(_: UniverseTag, y: number, x: number?)
		f.Position = if x then UDim2.fromOffset(x, y) else UDim2.new(0.5, 0, 0, y)
	end
	function self.destroy(u: UniverseTag)
		u.hold:DisconnectAll()
		holder:destroy()
		f:Destroy()
	end
	return self
end

return UniverseTag
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="105">
          <Properties>
            <string name="Name">Input</string>
          </Properties>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">Hotkeys</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Hotkeys: the keyboard (plan 2.7, DESIGN.md 3.4).

	    the game's own hotkeys   a key whose name is in patch.keys is sent as {"key", name} (the only action the
	                             client builds itself, plan 1.11); names follow the web page: "m", "M" (Shift),
	                             "ctrl+e", "ArrowUp", "Enter", " ", "Tab", digits
	    - / =                    one map zoom notch, unless the game uses the key
	    Esc                      closes the top thing: the modal, the peek, the detail sheet, then the panel

	    local hk = Hotkeys.start(o)    o = { active, keys, send, zoom, escape } (functions, see Opts)
	    Hotkeys.keyName(io) -> string?

	Nothing is sent while a TextBox has focus. Except for Esc, input the engine already used is ignored.
]]

local UserInputService = game:GetService("UserInputService")

local Hotkeys = {}

export type Opts = {
	active: () -> boolean, -- false while something else owns the keyboard
	keys: () -> { [string]: true }, -- the game's hotkeys right now (ViewStore.keys)
	send: (name: string) -> (),
	zoom: (dir: number) -> (),
	escape: () -> (),
}
export type Handle = { disconnect: (self: Handle) -> () }

local NAMED: { [Enum.KeyCode]: string } = {
	[Enum.KeyCode.Up] = "ArrowUp",
	[Enum.KeyCode.Down] = "ArrowDown",
	[Enum.KeyCode.Left] = "ArrowLeft",
	[Enum.KeyCode.Right] = "ArrowRight",
	[Enum.KeyCode.Return] = "Enter",
	[Enum.KeyCode.Space] = " ",
	[Enum.KeyCode.Tab] = "Tab",
	[Enum.KeyCode.Minus] = "-",
	[Enum.KeyCode.Equals] = "=",
}
local ZOOM: { [Enum.KeyCode]: number } = {
	[Enum.KeyCode.Minus] = -1,
	[Enum.KeyCode.KeypadMinus] = -1,
	[Enum.KeyCode.Equals] = 1,
	[Enum.KeyCode.KeypadPlus] = 1,
}

local function down(a: Enum.KeyCode, b: Enum.KeyCode): boolean
	return UserInputService:IsKeyDown(a) or UserInputService:IsKeyDown(b)
end

-- the web page's key name for a key press (the old client's rule): letters (upper case with Shift), digits, the
-- named keys above; Ctrl adds "ctrl+"
function Hotkeys.keyName(io: InputObject): string?
	local kc = io.KeyCode
	local name = NAMED[kc]
	if name == nil then
		local v = kc.Value
		if v >= Enum.KeyCode.A.Value and v <= Enum.KeyCode.Z.Value then
			local s = string.char(97 + v - Enum.KeyCode.A.Value)
			if down(Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift) then s = string.upper(s) end
			name = s
		elseif v >= Enum.KeyCode.Zero.Value and v <= Enum.KeyCode.Nine.Value then
			name = tostring(v - Enum.KeyCode.Zero.Value)
		end
	end
	if name == nil then return nil end
	if down(Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl) then return "ctrl+" .. name end
	return name
end

function Hotkeys.start(o: Opts): Handle
	local conn = UserInputService.InputBegan:Connect(function(io: InputObject, processed: boolean)
		if io.UserInputType ~= Enum.UserInputType.Keyboard then return end
		if not o.active() then return end
		if UserInputService:GetFocusedTextBox() then return end
		if io.KeyCode == Enum.KeyCode.Escape then
			o.escape()
			return
		end
		if processed then return end
		local name = Hotkeys.keyName(io)
		local keys = o.keys()
		if name and keys[name] then
			o.send(name)
			return
		end
		local dir = ZOOM[io.KeyCode]
		if dir and not down(Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl) then o.zoom(dir) end
	end)
	local handle = {} :: Handle
	function handle.disconnect(_: Handle)
		conn:Disconnect()
	end
	return handle
end

return Hotkeys
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="107">
            <Properties>
              <string name="Name">Input</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Input: the raw-input helpers every part of the client shares (plan 2.7, DESIGN.md 3.4).

	    Input.overUi(abs)        true when a HUD, top-bar, marker, panel or overlay element is on top at abs: the map
	                             then ignores the press (and the wheel, so panels can scroll)
	    Input.kind()             "mouse" | "touch" | "gamepad": the last pointer the player used
	    Input.kindChanged        Signal (kind)
	    Input.pointer()          the mouse's last position (abs space; hover tooltips are placed there)
	    Input.HOVER_DELAY, Input.LONG_PRESS, Input.DOUBLE_CLICK

	What blocks: a visible GuiObject under one of those ScreenGuis that is a button, a text box, a scrolling frame,
	Active, or drawn (background less than 95% transparent); never a Root and never something with Interactable off
	(toasts are click-through that way).

	The hold safety itself lives in Recipes.hold (its gate, Recipes.holdGate, is the map's MapInput:busy()).
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Core = script.Parent.Parent:WaitForChild("Core")
local Signal = require(Core:WaitForChild("Signal"))
local Layout = require(Core:WaitForChild("Layout"))

local Input = {}

Input.HOVER_DELAY = 0.25
Input.LONG_PRESS = 0.45
Input.DOUBLE_CLICK = 0.3
Input.kindChanged = Signal.new() :: Signal.Signal<string>

-- the ScreenGuis whose elements take input over the map
Input.BLOCKING = { HudGui = true, TopbarGui = true, MarkerGui = true, PanelGui = true, OverlayGui = true } :: { [string]: boolean }

local function blocks(o: GuiObject): boolean
	if not o.Visible or o.Name == "Root" then return false end
	local ok, interactable = pcall(function(): boolean return o.Interactable end)
	if ok and interactable == false then return false end
	if o:IsA("GuiButton") or o:IsA("TextBox") or o:IsA("ScrollingFrame") then return true end
	if o.Active then return true end
	return o.BackgroundTransparency < 0.95
end

function Input.overUi(abs: Vector2): boolean
	local lp = Players.LocalPlayer
	local pg = if lp then lp:FindFirstChildOfClass("PlayerGui") else nil
	if pg == nil then return false end
	local ok, list = pcall(function(): { GuiObject }
		return (pg :: PlayerGui):GetGuiObjectsAtPosition(abs.X, abs.Y)
	end)
	if not ok then return false end
	for _, o in list do
		local gui = o:FindFirstAncestorWhichIsA("ScreenGui")
		if gui and gui.Enabled and Input.BLOCKING[gui.Name] and blocks(o) then return true end
	end
	return false
end

local current = "mouse"
local function setKind(k: string)
	if k ~= current then
		current = k
		Input.kindChanged:Fire(k)
	end
end
function Input.kind(): string
	return current
end

local pointerAt = Vector2.zero
function Input.pointer(): Vector2
	return pointerAt
end

local started = false
function Input.start()
	if started then return end
	started = true
	UserInputService.InputChanged:Connect(function(io: InputObject)
		if io.UserInputType == Enum.UserInputType.MouseMovement then pointerAt = Layout.inputToAbs(io.Position) end
	end)
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then current = "touch" end
	UserInputService.LastInputTypeChanged:Connect(function(t: Enum.UserInputType)
		if t == Enum.UserInputType.Touch then
			setKind("touch")
		elseif t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseWheel
			or t == Enum.UserInputType.Keyboard then
			setKind("mouse")
		elseif string.sub(t.Name, 1, 7) == "Gamepad" then
			setKind("gamepad")
		end
	end)
end

return Input
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="108">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Milestone Tree NG+ on Roblox: the player's screen.

	The game runs on the server; this draws what it sends and sends button presses back. The realm map is the home
	screen: every layer is a node on the painted tree, and a node opens that layer's panel. App.luau does the work;
	this script only starts it.
]]

local App = require(script.Parent:WaitForChild("App"))

App.start()
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="109">
          <Properties>
            <string name="Name">Map</string>
          </Properties>
          <Item class="ModuleScript" referent="110">
            <Properties>
              <string name="Name">Ambient</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Ambient: the realm's living sprites (art/REALM.md 6.1, 6.2) and the corrupt blooms (5).

	    local amb = Ambient.new({ realm, layers, containers, backs, atlas, tier, reduced })
	    amb:recolor(w, C, z, V)        biome colours of the sprites with a colour object, and the blooms
	    amb:setPaused(true)            a full-screen panel covers the map: every tween paused, loops idle
	    amb:setLayerAlpha("fg", k)     the fg fade (zoom and side sheet)
	    amb:setRiftBoost(a)            the rift hover (DESIGN.md 3.11)
	    amb:destroy()

	Every sprite is built from Realm.sprites (the instances camera.js resolved; LOW uses the first count.LOW) in its
	layer's moving Sprites container, in Scale units of the layer (so it follows the container's zoom for free), and
	animated by TweenService with the closed-form curves of camera.js `channel`: sine = a reversing Sine InOut
	half-period tween, drift / scroll = a partial tween to the end then a Linear loop, pulse and flicker = a small
	loop. With reduced motion nothing moves: each sprite rests at its base (drifts frozen at their phase), and the
	groups REALM.md 9.6 lists are hidden. Without the realm atlas there are no sprites and no blooms.
]]

local TweenService = game:GetService("TweenService")

local MapCamera = require(script.Parent:WaitForChild("MapCamera"))

local Ambient = {}

type Pt = MapCamera.Pt
type Size = MapCamera.Size
type Weights = MapCamera.Weights
type Channel = MapCamera.Channel
type RGB = { number }

export type Atlas = { id: string, regions: { [string]: { number } }, k: number }
export type LayerInfo = { id: string, f: number, w: number, h: number, ax: number, ay: number }
export type Options = {
	realm: any,
	layers: { [string]: LayerInfo },
	containers: { [string]: Frame },
	backs: { [string]: Frame },
	atlas: Atlas?,
	tier: string,
	reduced: boolean,
}

type Sprite = {
	group: any,
	inst: any,
	layer: LayerInfo,
	root: GuiObject, -- the wrapper (or the hanging pivot)
	img: ImageLabel,
	colored: boolean,
	alpha: number, -- the base alpha
	boost: ImageLabel?,
}
type Bloom = { img: ImageLabel, alpha: number }

export type Ambient = {
	recolor: (self: Ambient, w: Weights, C: Pt, z: number, V: Size) -> (),
	setPaused: (self: Ambient, paused: boolean) -> (),
	setLayerAlpha: (self: Ambient, layer: string, k: number) -> (),
	setRiftBoost: (self: Ambient, a: number) -> (),
	destroy: (self: Ambient) -> (),
	count: (self: Ambient) -> number,
}

local function rgb(t: RGB): Color3
	return Color3.fromRGB(math.clamp(t[1], 0, 255), math.clamp(t[2], 0, 255), math.clamp(t[3], 0, 255))
end

function Ambient.new(o: Options): Ambient
	local sprites: { Sprite } = {}
	local blooms: { Bloom } = {}
	local tweens: { Tween } = {}
	local made: { Instance } = {}
	local alive = true
	local paused = false
	local layerAlpha: { [string]: number } = {}
	local atlas = o.atlas
	local realm = o.realm
	local B = realm.biome

	local self = {} :: Ambient

	local function region(img: ImageLabel, name: string): boolean
		if atlas == nil then return false end
		local r = atlas.regions[name]
		if r == nil then return false end
		local k = atlas.k
		img.Image = atlas.id
		img.ImageRectOffset = Vector2.new(r[1] * k, r[2] * k)
		img.ImageRectSize = Vector2.new(r[3] * k, r[4] * k)
		return true
	end
	local function play(tw: Tween, delay: number)
		table.insert(tweens, tw)
		if delay <= 0 then
			if not paused then tw:Play() end
			return
		end
		task.delay(delay, function()
			if alive and not paused then tw:Play() end
		end)
	end
	-- wait that respects pausing and destruction; false when the ambient is gone
	local function waitFor(t: number): boolean
		local left = t
		while left > 0 do
			local dt = task.wait(math.min(left, 0.5))
			if not alive then return false end
			if not paused then left -= dt end
		end
		return alive
	end

	-- ---------------------------------------------------------------------------------------------- channels
	-- sine: base +- amp; start at whichever extreme comes next (closest to the closed form), reversing Sine InOut
	local function sine(target: Instance, prop: string, at: (v: number) -> any, amp: number, period: number, phase: number)
		local tMin = ((0.75 - phase) % 1) * period
		local tMax = ((0.25 - phase) % 1) * period
		local startLow = tMin <= tMax
		local from = if startLow then -amp else amp
		local to = -from
		;(target :: any)[prop] = at(from)
		local tw = TweenService:Create(target, TweenInfo.new(period / 2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { [prop] = at(to) })
		play(tw, math.min(tMin, tMax))
	end
	-- drift / scroll: linear from `from` to `to` (or back when speed < 0), looping; begins at the phase point
	local function drift(target: Instance, prop: string, at: (v: number) -> any, from: number, to: number, speed: number, v0: number)
		if speed == 0 or from == to then
			(target :: any)[prop] = at(v0)
			return
		end
		local a, b = from, to
		if speed < 0 then a, b = to, from end
		local span = math.abs(b - a)
		local loopTime = span / math.abs(speed)
		;(target :: any)[prop] = at(v0)
		local first = TweenService:Create(target, TweenInfo.new(math.max(0.01, math.abs(b - v0) / math.abs(speed)), Enum.EasingStyle.Linear), { [prop] = at(b) })
		local loop = TweenService:Create(target, TweenInfo.new(loopTime, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), { [prop] = at(b) })
		table.insert(tweens, loop)
		first.Completed:Connect(function(state: Enum.PlaybackState)
			if state ~= Enum.PlaybackState.Completed or not alive then return end
			;(target :: any)[prop] = at(a)
			if not paused then loop:Play() end
		end)
		play(first, 0)
	end

	-- ---------------------------------------------------------------------------------------------- one sprite
	local function build(group: any, inst: any, layer: LayerInfo, container: Frame)
		local Lw, Lh = layer.w, layer.h
		local w = inst.s
		local hangs = group.hangs == true
		local len = inst.len or inst.h or inst.s
		local h = if hangs then len else (inst.h or inst.s)
		local baseA = if inst.a ~= nil then inst.a else 1
		local rot = inst.r or 0
		local root: GuiObject
		local img = Instance.new("ImageLabel")
		img.Name = "Img"
		img.BackgroundTransparency = 1
		img.BorderSizePixel = 0
		img.Active = false
		img.ScaleType = Enum.ScaleType.Stretch
		local regionName = group.regions[(inst.t or 0) + 1] or group.regions[1]
		if not region(img, regionName) then
			img:Destroy()
			return
		end
		if hangs then
			local pivot = Instance.new("Frame")
			pivot.Name = group.name
			pivot.BackgroundTransparency = 1
			pivot.BorderSizePixel = 0
			pivot.Active = false
			pivot.AnchorPoint = Vector2.new(0.5, 0.5)
			pivot.Position = UDim2.fromScale(inst.x / Lw, inst.y / Lh)
			pivot.Size = UDim2.fromScale(w / Lw, 2 * len / Lh)
			pivot.Rotation = rot
			img.Position = UDim2.fromScale(0, 0.5)
			img.Size = UDim2.fromScale(1, 0.5)
			img.Parent = pivot
			root = pivot
		else
			local wrap = Instance.new("Frame")
			wrap.Name = group.name
			wrap.BackgroundTransparency = 1
			wrap.BorderSizePixel = 0
			wrap.Active = false
			wrap.AnchorPoint = Vector2.new(0.5, 0.5)
			wrap.Position = UDim2.fromScale(inst.x / Lw, inst.y / Lh)
			wrap.Size = UDim2.fromScale(w / Lw, h / Lh)
			img.AnchorPoint = Vector2.new(0.5, 0.5)
			img.Position = UDim2.fromScale(0.5, 0.5)
			img.Size = UDim2.fromScale(1, 1)
			img.Rotation = rot
			img.Parent = wrap
			root = wrap
		end
		local colored = group.color ~= nil
		local palette = group.palette
		img.ImageColor3 = if colored then rgb(group.color.realm)
			elseif palette then rgb(palette[((inst.c or 0) % #palette) + 1])
			else Color3.new(1, 1, 1)
		img.ImageTransparency = 1 - baseA * (layerAlpha[layer.id] or 1)
		local sp: Sprite = { group = group, inst = inst, layer = layer, root = root, img = img, colored = colored, alpha = baseA }
		root.Parent = container
		table.insert(made, root)
		table.insert(sprites, sp)

		local channels: { Channel } = inst.m or {}
		local hasGrad = false
		for _, m in channels do
			if m.ch == "grad" then hasGrad = true end
		end
		local grad: UIGradient? = nil
		if hasGrad then
			local g = Instance.new("UIGradient")
			g.Rotation = 90
			g.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.55),
				NumberSequenceKeypoint.new(0.38, 0.4),
				NumberSequenceKeypoint.new(0.5, 0),
				NumberSequenceKeypoint.new(0.62, 0.4),
				NumberSequenceKeypoint.new(1, 0.55),
			})
			g.Offset = Vector2.new(0, 0)
			g.Parent = img
			grad = g
		end
		local uiScale: UIScale? = nil
		local function scaleObj(): UIScale
			if uiScale == nil then
				local u = Instance.new("UIScale")
				u.Parent = img
				uiScale = u
			end
			return uiScale :: UIScale
		end
		-- the rift glow gets a second copy for the hover boost
		if group.name == "rift_glow" then
			local boost = img:Clone()
			boost.Name = "Boost"
			boost.AnchorPoint = Vector2.new(0.5, 0.5)
			boost.Position = UDim2.fromScale(0.5, 0.5)
			boost.Size = UDim2.fromScale(1, 1)
			boost.Rotation = 0
			boost.ImageTransparency = 1
			for _, c in boost:GetChildren() do c:Destroy() end
			boost.Parent = img
			sp.boost = boost
		end

		if o.reduced then
			-- rest at the base: alpha a, no offset, gradient offset 0, drifts frozen at their phase
			for _, m in channels do
				if m.type == "drift" then
					local v = MapCamera.channel(m, 0)
					if m.ch == "x" then
						root.Position = UDim2.fromScale((inst.x + v) / Lw, inst.y / Lh)
					elseif m.ch == "y" then
						img.Position = UDim2.fromScale(img.Position.X.Scale, img.Position.Y.Scale + v / h)
					end
				end
			end
			return
		end

		-- pulse channels share one loop (period and phase are shared); flicker channels share another
		local pulses: { Channel } = {}
		local flickers: { Channel } = {}
		for _, m in channels do
			local ty = m.type
			local period = m.period or 1
			local phase = m.phase or 0
			if ty == "pulse" then
				table.insert(pulses, m)
			elseif ty == "flicker" then
				table.insert(flickers, m)
			elseif ty == "sine" then
				local amp = m.amp or 0
				if m.ch == "x" then
					sine(root, "Position", function(v: number): any return UDim2.fromScale((inst.x + v) / Lw, inst.y / Lh) end, amp, period, phase)
				elseif m.ch == "y" then
					if hangs then
						sine(root, "Position", function(v: number): any return UDim2.fromScale(inst.x / Lw, (inst.y + v) / Lh) end, amp, period, phase)
					else
						sine(img, "Position", function(v: number): any return UDim2.fromScale(0.5, 0.5 + v / h) end, amp, period, phase)
					end
				elseif m.ch == "rot" then
					local target: GuiObject = if hangs then root else img
					sine(target, "Rotation", function(v: number): any return rot + v end, amp, period, phase)
				elseif m.ch == "scale" then
					sine(scaleObj(), "Scale", function(v: number): any return 1 + v end, amp, period, phase)
				elseif m.ch == "alpha" then
					local k = layerAlpha[layer.id] or 1
					sine(img, "ImageTransparency", function(v: number): any return 1 - math.clamp(baseA + v, 0, 1) * k end, amp, period, phase)
				end
			elseif ty == "drift" then
				local from, to, speed = m.from or 0, m.to or 0, m.speed or 0
				local v0 = MapCamera.channel(m, 0)
				if m.ch == "x" then
					drift(root, "Position", function(v: number): any return UDim2.fromScale((inst.x + v) / Lw, inst.y / Lh) end, from, to, speed, v0)
				elseif m.ch == "y" then
					if hangs then
						drift(root, "Position", function(v: number): any return UDim2.fromScale(inst.x / Lw, (inst.y + v) / Lh) end, from, to, speed, v0)
					else
						drift(img, "Position", function(v: number): any return UDim2.fromScale(0.5, 0.5 + v / h) end, from, to, speed, v0)
					end
				end
			elseif ty == "scroll" and grad then
				local g = grad :: UIGradient
				local v0 = MapCamera.channel(m, 0)
				drift(g, "Offset", function(v: number): any return Vector2.new(0, v) end, -1, 1, 2 / period, v0)
			end
		end

		if #pulses > 0 then
			local lead = pulses[1]
			local period, dur = lead.period or 1, lead.dur or 1
			local phase = lead.phase or 0
			local function apply(which: string)
				for _, m in pulses do
					local v = if which == "a" then (m.a or 0) else (m.b or 0)
					if m.ch == "x" then
						root.Position = UDim2.fromScale((inst.x + v) / Lw, inst.y / Lh)
					elseif m.ch == "y" then
						img.Position = UDim2.fromScale(img.Position.X.Scale, 0.5 + v / h)
					elseif m.ch == "alpha" then
						img.ImageTransparency = 1 - math.clamp(v, 0, 1)
					elseif m.ch == "scale" then
						scaleObj().Scale = v
					end
				end
			end
			apply("b")
			task.spawn(function()
				if not waitFor(((1 - phase) % 1) * period) then return end
				while alive do
					apply("a")
					local ease = if lead.ease == "linear" then Enum.EasingStyle.Linear else Enum.EasingStyle.Quad
					local info = TweenInfo.new(dur, ease, Enum.EasingDirection.Out)
					for _, m in pulses do
						local b = m.b or 0
						local tw: Tween? = nil
						if m.ch == "x" then
							tw = TweenService:Create(root, info, { Position = UDim2.fromScale((inst.x + b) / Lw, inst.y / Lh) })
						elseif m.ch == "y" then
							tw = TweenService:Create(img, info, { Position = UDim2.fromScale(img.Position.X.Scale, 0.5 + b / h) })
						elseif m.ch == "alpha" then
							tw = TweenService:Create(img, info, { ImageTransparency = 1 - math.clamp(b, 0, 1) })
						elseif m.ch == "scale" then
							tw = TweenService:Create(scaleObj(), info, { Scale = b })
						end
						if tw then tw:Play() end
					end
					if not waitFor(period) then return end
				end
			end)
		end

		if #flickers > 0 then
			local lead = flickers[1]
			local slot, dur = lead.slot or 3, lead.dur or 0.1
			local jitter = 0
			for _, m in flickers do
				if m.out == "jitter" then jitter = m.amp or 0 end
			end
			img.ImageTransparency = 1
			task.spawn(function()
				local rng = Random.new(lead.seed or 1)
				while alive do
					local before = rng:NextNumber() * math.max(0, slot - dur)
					if not waitFor(before) then return end
					local dx = (rng:NextNumber() - 0.5) * 2 * jitter
					root.Position = UDim2.fromScale((inst.x + dx) / Lw, inst.y / Lh)
					if palette then img.ImageColor3 = rgb(palette[rng:NextInteger(1, #palette)]) end
					img.ImageTransparency = 1 - baseA
					if not waitFor(dur) then return end
					img.ImageTransparency = 1
					if not waitFor(math.max(0, slot - dur - before)) then return end
				end
			end)
		end
	end

	-- ---------------------------------------------------------------------------------------------- build
	if atlas then
		for _, group in realm.sprites do
			if o.reduced and group.rmHide then continue end
			local layer = o.layers[group.layer]
			local container = o.containers[group.layer]
			if not layer or not container then continue end
			local n = math.min(group.count[o.tier] or 0, #group.instances)
			for i = 1, n do
				build(group, group.instances[i], layer, container)
			end
		end
		-- the corrupt blooms: behind their layer's tiles, hidden until w.corrupt > 0
		for _, b in B.corrupt.bloom do
			local layer = o.layers[b.layer]
			local back = o.backs[b.layer]
			if not layer or not back then continue end
			local img = Instance.new("ImageLabel")
			img.Name = "Bloom"
			img.BackgroundTransparency = 1
			img.BorderSizePixel = 0
			img.Active = false
			if not region(img, "glow") then
				img:Destroy()
				continue
			end
			img.AnchorPoint = Vector2.new(0.5, 0.5)
			img.Position = UDim2.fromScale(b.at[1] / layer.w, b.at[2] / layer.h)
			img.Size = UDim2.fromScale(b.size[1] / layer.w, b.size[2] / layer.h)
			img.ImageColor3 = rgb(b.color)
			img.ImageTransparency = 1
			img.Visible = false
			img.Parent = back
			table.insert(made, img)
			table.insert(blooms, { img = img, alpha = b.alpha })
		end
	end

	-- ---------------------------------------------------------------------------------------------- API
	local lastCorrupt = 0
	function self.recolor(_: Ambient, w: Weights, C: Pt, z: number, V: Size)
		for _, b in blooms do
			local a = b.alpha * w.corrupt
			b.img.Visible = a > 0.001
			b.img.ImageTransparency = 1 - a
		end
		for _, sp in sprites do
			if not sp.colored then continue end
			local color = sp.group.color
			local p: Pt
			if w.corrupt > 0 or lastCorrupt > 0 then
				-- the world point under the sprite's centre on screen
				local L = sp.layer
				local q = MapCamera.localToScreen(L, C, z, V, { x = sp.inst.x, y = sp.inst.y })
				p = MapCamera.screenToWorld(C, z, V, q)
			else
				p = C
			end
			local c = MapCamera.biomeSpriteColor(color, w, B, p)
			sp.img.ImageColor3 = rgb(c)
		end
		lastCorrupt = w.corrupt
	end
	function self.setPaused(_: Ambient, v: boolean)
		if v == paused then return end
		paused = v
		for _, tw in tweens do
			if v then
				tw:Pause()
			elseif tw.PlaybackState == Enum.PlaybackState.Paused then
				tw:Play()
			end
		end
	end
	function self.setLayerAlpha(_: Ambient, layer: string, k: number)
		if layerAlpha[layer] == k then return end
		layerAlpha[layer] = k
		for _, sp in sprites do
			if sp.layer.id == layer then
				sp.root.Visible = k > 0.001
				sp.img.ImageTransparency = 1 - sp.alpha * k
			end
		end
	end
	function self.setRiftBoost(_: Ambient, a: number)
		for _, sp in sprites do
			local boost = sp.boost
			if boost then
				TweenService:Create(boost, TweenInfo.new(0.2), { ImageTransparency = 1 - math.clamp(a, 0, 1) }):Play()
			end
		end
	end
	function self.count(_: Ambient): number
		return #sprites + #blooms
	end
	function self.destroy(_: Ambient)
		alive = false
		for _, tw in tweens do tw:Cancel() end
		table.clear(tweens)
		for _, inst in made do inst:Destroy() end
		table.clear(made)
		table.clear(sprites)
		table.clear(blooms)
	end
	return self
end

return Ambient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">Fallback</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Fallback: the procedural realm drawn while the painted tiles have no asset ids (plan 3.5), so the map looks
	designed, not broken, before the art upload.

	    Fallback.sky(plane, sprites, layer)       the L0 plane: a void -> deep violet gradient over the whole Box, and in
	                                              the moving sky container (so it parallaxes) a soft sun, two nebula
	                                              glows and 60 seeded stars
	    Fallback.world(sprites, realm)            the L5 world container: a glass socket per node with a rim glow in
	                                              its hue, and the rift's crimson ellipse
	    Fallback.breathe(handle, reduced)         the rift glow's breathing (the rift_glow sprite's curve)

	Everything is Frames with UIGradient / UICorner / UIStroke, in Scale units of its container. Radial gradients are
	used when the engine has them (Theme.caps.Radial); otherwise the glows are flat soft discs or left out.
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Parent:WaitForChild("Core"):WaitForChild("Theme"))
local MapCamera = require(script.Parent:WaitForChild("MapCamera"))

local Fallback = {}

local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end
local function frame(parent: Instance, name: string, z: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BorderSizePixel = 0
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	f.Active = false
	f.ZIndex = z
	f.Parent = parent
	return f
end
local function round(f: GuiObject)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = f
end
-- a soft radial blob (colour, peak alpha) in the container's scale units; nil without Radial gradients
local function blob(parent: Instance, name: string, cx: number, cy: number, w: number, h: number, color: Color3,
	alpha: number, z: number, hard: boolean?): Frame?
	local f = frame(parent, name, z)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(cx, cy)
	f.Size = UDim2.fromScale(w, h)
	f.BackgroundColor3 = color
	if Theme.caps.Radial then
		f.BackgroundTransparency = 0
		local g = Instance.new("UIGradient")
		g.Type = Enum.GradientType.Radial
		-- the radial ramp can run out to the frame's corners (CSS farthest-corner), which leaves a visible square: the
		-- fade ends at 0.7 (the inscribed circle) and the UICorner keeps the blob round however the engine maps it
		g.Transparency = if hard
			then NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1 - alpha),
				NumberSequenceKeypoint.new(0.25, 1 - alpha * 0.8),
				NumberSequenceKeypoint.new(0.7, 1),
				NumberSequenceKeypoint.new(1, 1),
			})
			else NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1 - alpha),
				NumberSequenceKeypoint.new(0.32, 1 - alpha * 0.45),
				NumberSequenceKeypoint.new(0.7, 1),
				NumberSequenceKeypoint.new(1, 1),
			})
		g.Parent = f
	else
		if not hard then
			f:Destroy()
			return nil
		end
		f.BackgroundTransparency = 1 - alpha * 0.5
	end
	round(f)
	return f
end

export type Layer = { w: number, h: number }

-- the sky: `plane` is the non-moving L0 plane (full Box), `sprites` the moving L0 container (layer-local scale units)
function Fallback.sky(plane: Frame, sprites: Frame, layer: Layer): { Instance }
	local made: { Instance } = {}
	local back = frame(plane, "FallbackSky", 0)
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundTransparency = 0
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(7, 5, 13)),
		ColorSequenceKeypoint.new(0.55, Color3.fromRGB(18, 10, 40)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(32, 16, 70)),
	})
	g.Parent = back
	table.insert(made, back)
	-- the cosmic sun at (0.36 w, 0.26 h) of the sky, and two nebula glows: violet over the tree, crimson toward the rift
	local aspect = layer.w / layer.h
	local sun = blob(sprites, "FallbackSun", 0.36, 0.26, 0.34, 0.34 * aspect, Color3.fromRGB(255, 214, 150), 0.32, 0)
	local halo = blob(sprites, "FallbackSunHalo", 0.36, 0.26, 0.09, 0.09 * aspect, Color3.fromRGB(255, 240, 210), 0.55, 0, true)
	local neb1 = blob(sprites, "FallbackNebulaA", 0.3, 0.55, 0.62, 0.5, Color3.fromRGB(120, 60, 220), 0.22, 0)
	local neb2 = blob(sprites, "FallbackNebulaB", 0.78, 0.5, 0.5, 0.6, Color3.fromRGB(200, 30, 90), 0.2, 0)
	for _, b in { sun, halo, neb1, neb2 } do
		if b then table.insert(made, b) end
	end
	-- 60 seeded stars, 2-3 local px, alpha .3-.7
	local rng = MapCamera.rng(7)
	local holder = frame(sprites, "FallbackStars", 0)
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundTransparency = 1
	for i = 1, 60 do
		local d = 2 + rng()
		local s = frame(holder, "Star" .. i, 1)
		s.AnchorPoint = Vector2.new(0.5, 0.5)
		s.Position = UDim2.fromScale(rng(), rng() * 0.92)
		s.Size = UDim2.fromScale(d / layer.w, d / layer.h)
		s.BackgroundColor3 = if rng() < 0.3 then Color3.fromRGB(210, 190, 255) else Color3.fromRGB(255, 250, 240)
		s.BackgroundTransparency = 1 - (0.3 + rng() * 0.4)
		round(s)
	end
	table.insert(made, holder)
	return made
end

export type RealmData = { world: { w: number, h: number }, nodes: { [string]: { number } }, alias: { [string]: string },
	rift: { cx: number, cy: number, rx: number, ry: number } }

-- the art socket key -> the game id (the socket cr is the layer cp)
local function gameId(realm: RealmData, key: string): string
	for id, art in realm.alias do
		if art == key then return id end
	end
	return key
end

export type World = { rift: Frame?, core: Frame?, made: { Instance } }

-- the world: `sprites` is the moving L5 container (world scale units: x / 3840, y / 2560)
function Fallback.world(sprites: Frame, realm: RealmData): World
	local W, H = realm.world.w, realm.world.h
	local made: { Instance } = {}
	local holder = frame(sprites, "FallbackWorld", 0)
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundTransparency = 1
	table.insert(made, holder)
	-- the rift: a crimson ellipse 1150 x 1553 at the gate, a hotter core and the tear
	local r = realm.rift
	local rift = blob(holder, "FallbackRift", r.cx / W, r.cy / H, 1150 / W, 1553 / H, Color3.fromRGB(255, 46, 99), 0.5, 1, true)
	local core = blob(holder, "FallbackRiftCore", r.cx / W, r.cy / H, 520 / W, 960 / H, Color3.fromRGB(232, 70, 190), 0.45, 2, true)
	local tear = frame(holder, "FallbackTear", 3)
	tear.AnchorPoint = Vector2.new(0.5, 0.5)
	tear.Position = UDim2.fromScale(r.cx / W, r.cy / H)
	tear.Size = UDim2.fromScale(46 / W, 760 / H)
	tear.BackgroundColor3 = Color3.fromRGB(255, 190, 215)
	tear.BackgroundTransparency = 0.15
	round(tear)
	if Theme.caps.Radial then
		local tg = Instance.new("UIGradient")
		tg.Type = Enum.GradientType.Radial
		tg.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.6, 0.35),
			NumberSequenceKeypoint.new(1, 1),
		})
		tg.Parent = tear
	end
	-- a glass socket per node with a rim glow in its hue
	local keys = {}
	for k in realm.nodes do table.insert(keys, k) end
	table.sort(keys)
	for _, key in keys do
		local p = realm.nodes[key]
		local hue = Theme.hue(gameId(realm, key))
		blob(holder, "Glow_" .. key, p[1] / W, p[2] / H, 230 / W, 230 / H, hue, 0.25, 4, true)
		local disc = frame(holder, "Socket_" .. key, 5)
		disc.AnchorPoint = Vector2.new(0.5, 0.5)
		disc.Position = UDim2.fromScale(p[1] / W, p[2] / H)
		disc.Size = UDim2.fromScale(150 / W, 150 / H)
		disc.BackgroundColor3 = Theme.C.panel
		disc.BackgroundTransparency = 0.15
		round(disc)
		local st = Instance.new("UIStroke")
		st.Color = Theme.C.stroke
		st.Thickness = 3
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		st.Parent = disc
	end
	return { rift = rift, core = core, made = made }
end

-- the rift glow breathes like the rift_glow sprite: alpha .42 +- .14 and scale 1 +- .035, 2.8 s, in phase
function Fallback.breathe(w: World, reduced: boolean): { Tween }
	local tweens: { Tween } = {}
	local rift = w.rift
	if rift == nil then return tweens end
	local scale = rift:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	scale.Parent = rift
	if reduced then
		scale.Scale = 1
		return tweens
	end
	local info = TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	local base = rift.BackgroundTransparency
	rift.BackgroundTransparency = math.clamp(base + 0.14, 0, 1)
	scale.Scale = 0.965
	local t1 = TweenService:Create(rift, info, { BackgroundTransparency = math.clamp(base - 0.14, 0, 1) })
	local t2 = TweenService:Create(scale, info, { Scale = 1.035 })
	t1:Play()
	t2:Play()
	table.insert(tweens, t1)
	table.insert(tweens, t2)
	return tweens
end

Fallback.rgb = rgb

return Fallback
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="112">
            <Properties>
              <string name="Name">Fields</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Fields: the three particle fields of art/REALM.md 6.3 (motesFar at f .7, motesNear at 1.3, particles at 1.6),
	drawn every frame from pools of ImageLabels in full-Box frames (F_motesFar, F_motesNear, F_particles).

	    local fields = Fields.new({ realm, frames, atlas, tier })
	    fields:step(t, C, z, V, w)      place every visible particle copy (MapCamera.fieldVisit), colour it (5)
	    fields:setAlpha("motesNear", k) the side-sheet fade of motesNear
	    fields:setReduced(b)            reduced motion: motesNear and particles hidden, motesFar frozen at t = 0
	    fields:setEnabled(b)            a full-screen panel covers the map: stop drawing

	Positions are Scale units of the Box (REALM.md 2.6), so nothing here depends on the device scale. A pool entry
	is written only when a value changed. Without the realm atlas the fields are skipped.
]]

local MapCamera = require(script.Parent:WaitForChild("MapCamera"))

local Fields = {}

type Pt = MapCamera.Pt
type Size = MapCamera.Size
type Weights = MapCamera.Weights

export type Atlas = { id: string, regions: { [string]: { number } }, k: number }
export type Options = { realm: any, frames: { [string]: Frame }, atlas: Atlas?, tier: string }
export type Fields = {
	step: (self: Fields, t: number, C: Pt, z: number, V: Size, w: Weights) -> (),
	setAlpha: (self: Fields, id: string, k: number) -> (),
	setReduced: (self: Fields, b: boolean) -> (),
	setEnabled: (self: Fields, b: boolean) -> (),
	destroy: (self: Fields) -> (),
}

type Entry = { img: ImageLabel, region: string, x: number, y: number, s: number, a: number, c: Color3?, shown: boolean }
type Field = { def: any, particles: { any }, frame: Frame, pool: { Entry }, alpha: number, used: number }

function Fields.new(o: Options): Fields
	local atlas = o.atlas
	local B = o.realm.biome
	local list: { Field } = {}
	local reduced = false
	local enabled = true
	local self = {} :: Fields

	if atlas then
		for _, def in o.realm.fields do
			local frame = o.frames[def.id]
			if not frame then continue end
			local parts = {}
			for _, p in def.particles do
				if o.tier ~= "LOW" or p.low == 1 then table.insert(parts, p) end
			end
			local pool: { Entry } = {}
			local n = def.pool[o.tier] or def.pool.HIGH
			for i = 1, n do
				local img = Instance.new("ImageLabel")
				img.Name = "P" .. i
				img.BackgroundTransparency = 1
				img.BorderSizePixel = 0
				img.Active = false
				img.AnchorPoint = Vector2.new(0.5, 0.5)
				img.Image = atlas.id
				img.Visible = false
				img.Parent = frame
				pool[i] = { img = img, region = "", x = -1, y = -1, s = -1, a = -1, c = nil, shown = false }
			end
			table.insert(list, { def = def, particles = parts, frame = frame, pool = pool, alpha = 1, used = 0 })
		end
	end

	local function setRegion(e: Entry, name: string)
		if e.region == name or atlas == nil then return end
		local r = atlas.regions[name]
		if r == nil then return end
		e.region = name
		local k = atlas.k
		e.img.ImageRectOffset = Vector2.new(r[1] * k, r[2] * k)
		e.img.ImageRectSize = Vector2.new(r[3] * k, r[4] * k)
	end
	local function hideFrom(f: Field, from: number)
		for i = from, #f.pool do
			local e = f.pool[i]
			if e.shown then
				e.shown = false
				e.img.Visible = false
			end
		end
	end
	local kindCache: { [any]: { [string]: any } } = {}
	local function kindOf(def: any, name: string): any
		local byName = kindCache[def]
		if byName == nil then
			byName = {}
			for _, k in def.kinds do (byName :: any)[k.name] = k end
			kindCache[def] = byName
		end
		return (byName :: any)[name]
	end

	function self.step(_: Fields, t: number, C: Pt, z: number, V: Size, w: Weights)
		if not enabled then return end
		for _, f in list do
			local def = f.def
			if reduced and def.id ~= "motesFar" then
				hideFrom(f, 1)
				f.frame.Visible = false
				continue
			end
			if f.alpha <= 0.001 then
				hideFrom(f, 1)
				f.frame.Visible = false
				continue
			end
			f.frame.Visible = true
			local time = if reduced then 0 else t
			local used = 0
			local pool = f.pool
			local k = f.alpha
			MapCamera.fieldVisit(def, f.particles, C, z, V, time, function(i: number, x: number, y: number, size: number, alpha: number): boolean?
				used += 1
				local e = pool[used]
				local p = f.particles[i]
				local kind = kindOf(def, p.k)
				if kind then setRegion(e, kind.regions[(p.t or 0) + 1] or kind.regions[1]) end
				local sx, sy = x / V.w, y / V.h
				if sx ~= e.x or sy ~= e.y then
					e.x, e.y = sx, sy
					e.img.Position = UDim2.fromScale(sx, sy)
				end
				if size ~= e.s then
					e.s = size
					e.img.Size = UDim2.fromScale(size / V.w, size / V.h)
				end
				local a = math.floor(alpha * k * 200 + 0.5) / 200
				if a ~= e.a then
					e.a = a
					e.img.ImageTransparency = 1 - a
				end
				if kind then
					local world = MapCamera.screenToWorld(C, z, V, { x = x, y = y })
					local c = MapCamera.biomeFieldColor(kind, p.c or 0, p.cg or 0.5, w, B, world)
					local col = Color3.fromRGB(c[1], c[2], c[3])
					if col ~= e.c then
						e.c = col
						e.img.ImageColor3 = col
					end
				end
				if not e.shown then
					e.shown = true
					e.img.Visible = true
				end
				return used >= #pool
			end)
			f.used = used
			hideFrom(f, used + 1)
		end
	end
	function self.setAlpha(_: Fields, id: string, k: number)
		for _, f in list do
			if f.def.id == id then f.alpha = k end
		end
	end
	function self.setReduced(_: Fields, b: boolean)
		reduced = b
	end
	function self.setEnabled(_: Fields, b: boolean)
		enabled = b
		if not b then
			for _, f in list do hideFrom(f, 1) end
		end
	end
	function self.destroy(_: Fields)
		for _, f in list do
			for _, e in f.pool do e.img:Destroy() end
		end
		table.clear(list)
	end
	return self
end

return Fields
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="113">
            <Properties>
              <string name="Name">Links</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Links: the live connections between nodes (DESIGN.md 3.8). Existence comes from the view's `br` (both ends shown),
	geometry from Realm.edges (the Figma control points plus the MP -> PM bridge), colour from the child's (edge
	`to`) hue, danger for an infected link. Everything is in view.links, in world Scale units.

	    lit      four stacked strokes (Recipes.curve: Path2D halo / glow / core / hot, or segment frames without
	             Path2D), widths from k = max(z, floor), rewritten when the zoom moves by more than 2%. LOW and phones
	             drop the hot stroke. Secondary links (theme slot 3) draw halo and glow at half alpha.
	    locked   HIGH: dots every 15 world px of arc length (at most 400 in all); LOW, phones and past the cap: one
	             thin thread
	    sparks   one glowing spark per edge into a pulse node, a 1.6 s loop (HIGH, not reduced; at most 6)

	    local links = Links.new(view)
	    links:update(ms)        links:onCamera(cam)     -- onCamera is connected to view.cameraChanged already
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Motion = require(Core:WaitForChild("Motion"))
local Recipes = require(Core:WaitForChild("Recipes"))
local Kit = require(script.Parent.Parent:WaitForChild("Hud"):WaitForChild("Kit"))
local MapView = require(script.Parent:WaitForChild("MapView"))
local MapLogic = require(script.Parent:WaitForChild("MapLogic"))

type MapState = Types.MapState
type Camera = Types.Camera

export type Links = {
	update: (self: Links, ms: MapState) -> (),
	onCamera: (self: Links, cam: Camera) -> (),
	count: (self: Links) -> (number, number, number), -- lit curves, dots, sparks (tests / budgets)
	destroy: (self: Links) -> (),
}

local Links = {}

local DOT_STEP = 15
local DOT_CAP = 400
local SPARK_CAP = 6
local LOCKED_COLOR = Theme.C.lockedLink

-- the cubic's point at t
local function bez(p: { number }, t: number): (number, number)
	local u = 1 - t
	local a, b, c, d = u * u * u, 3 * u * u * t, 3 * u * t * t, t * t * t
	return a * p[1] + b * p[3] + c * p[5] + d * p[7], a * p[2] + b * p[4] + c * p[6] + d * p[8]
end
-- n + 1 points equally spaced by arc length (a 64-step table, then interpolated)
local function arcPoints(p: { number }, step: number?, count: number?): { Vector2 }
	local N = 64
	local xs, ys, len = table.create(N + 1), table.create(N + 1), table.create(N + 1)
	local total = 0
	for i = 0, N do
		local x, y = bez(p, i / N)
		xs[i + 1], ys[i + 1] = x, y
		if i > 0 then total += math.sqrt((x - xs[i]) ^ 2 + (y - ys[i]) ^ 2) end
		len[i + 1] = total
	end
	local n = count or math.max(1, math.floor(total / (step or DOT_STEP)))
	local out: { Vector2 } = {}
	local j = 1
	for k = 0, n do
		local target = total * k / n
		while j < N + 1 and len[j + 1] < target do j += 1 end
		local a, b = len[j], len[math.min(j + 1, N + 1)]
		local f = if b > a then (target - a) / (b - a) else 0
		local jj = math.min(j + 1, N + 1)
		table.insert(out, Vector2.new(xs[j] + (xs[jj] - xs[j]) * f, ys[j] + (ys[jj] - ys[j]) * f))
	end
	return out
end
Links.arcPoints = arcPoints

type Rec = {
	key: string,
	link: MapLogic.Link,
	mode: string, -- "lit" | "dots" | "thread"
	curve: Recipes.Curve?,
	dots: Frame?,
	ndots: number,
	spark: Frame?,
	sig: string,
}

function Links.new(view: MapView.MapView): Links
	local realm: any = require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("Realm"))
	local edges: { MapLogic.Edge } = realm.edges
	local self = {} :: Links
	local recs: { [string]: Rec } = {}
	local z, m = 0.5, 1
	local lastK = -1
	local sparkPts: { [string]: { Vector2 } } = {}
	local camConn: { Disconnect: (any) -> () }

	local function lowTier(): boolean
		return view.tier == "LOW" or Layout.mode == "COMPACT"
	end
	local function floorK(): number
		return 36 / 132
	end
	local function widths(): { number }
		local k = math.max(z, floorK())
		return {
			math.max(10, 24 * k) * m,
			math.max(6, 14 * k) * m,
			math.max(2.5, 4 * k) * m,
			math.max(1, 1.5 * k) * m,
		}
	end
	local function strokes(link: MapLogic.Link): { Recipes.CurveStroke }
		local c = if link.infected then Theme.C.danger else Theme.hue(link.to)
		local half = if link.secondary then 0.5 else 1
		local w = widths()
		local list: { Recipes.CurveStroke } = {
			{ c = c, a = 0.14 * half, w = w[1] },
			{ c = c, a = 0.32 * half, w = w[2] },
			{ c = Theme.lift(c, 0.3), a = 1, w = w[3] },
		}
		if not lowTier() then table.insert(list, { c = Color3.new(1, 1, 1), a = 0.85, w = w[4] }) end
		return list
	end
	local function pts(link: MapLogic.Link): { Vector2 }
		local p = link.p
		return { Vector2.new(p[1], p[2]), Vector2.new(p[3], p[4]), Vector2.new(p[5], p[6]), Vector2.new(p[7], p[8]) }
	end

	local function clear(r: Rec)
		if r.curve then (r.curve :: Recipes.Curve):destroy() end
		r.curve = nil
		if r.dots then (r.dots :: Frame):Destroy() end
		r.dots = nil
		r.ndots = 0
		if r.spark then (r.spark :: Frame):Destroy() end
		r.spark = nil
	end

	local function buildDots(r: Rec, budget: number): boolean
		local list = arcPoints(r.link.p, DOT_STEP)
		-- the ends sit under the rings: drop the first and last 3 (about 45 world px)
		local from, to = 4, #list - 3
		local n = math.max(0, to - from + 1)
		if n > budget then return false end
		local holder = Kit.frame(view.links, "Dots_" .. r.key, 1)
		holder.Size = UDim2.fromScale(1, 1)
		local d = math.max(2, math.floor(3 * m + 0.5))
		for i = from, to do
			local p = list[i]
			local dot = Instance.new("Frame")
			dot.Name = "D"
			dot.BorderSizePixel = 0
			dot.Active = false
			dot.AnchorPoint = Vector2.new(0.5, 0.5)
			dot.Position = UDim2.fromScale(p.X / 3840, p.Y / 2560)
			dot.Size = UDim2.fromOffset(d, d)
			dot.BackgroundColor3 = LOCKED_COLOR
			dot.BackgroundTransparency = 0.55
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0.5, 0)
			c.Parent = dot
			dot.Parent = holder
		end
		r.dots = holder
		r.ndots = n
		return true
	end

	local function buildThread(r: Rec)
		r.curve = Recipes.curve(view.links, pts(r.link), { { c = LOCKED_COLOR, a = 0.42, w = 2.5 * m } },
			{ name = "Thread_" .. r.key, z = 1 })
	end

	local function buildLit(r: Rec)
		r.curve = Recipes.curve(view.links, pts(r.link), strokes(r.link), { name = "Edge_" .. r.key, z = 2 })
	end

	-- the flow spark along an edge into a pulse node (HIGH only)
	local function buildSpark(r: Rec)
		local key = r.key
		if sparkPts[key] == nil then sparkPts[key] = arcPoints(r.link.p, nil, 32) end
		local f = Kit.frame(view.links, "Spark_" .. key, 8)
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		local size = math.floor(26 * math.max(z, floorK()) * m + 0.5)
		f.Size = UDim2.fromOffset(size, size)
		local hue = Theme.hue(r.link.to)
		local g = Kit.blob(f, "Glow", Theme.lift(hue, 0.4), 0.95)
		if g then g.Size = UDim2.fromScale(1, 1) end
		local core = Kit.frame(f, "Core", 2)
		core.AnchorPoint = Vector2.new(0.5, 0.5)
		core.Position = UDim2.fromScale(0.5, 0.5)
		core.Size = UDim2.fromScale(0.34, 0.34)
		core.BackgroundColor3 = Color3.new(1, 1, 1)
		core.BackgroundTransparency = 0
		Kit.corner(core)
		r.spark = f
		local phase = math.random()
		Motion.loop(f, function(_dt: number)
			local list = sparkPts[key]
			if list == nil or #list < 2 then return end
			local t = ((os.clock() / 1.6) + phase) % 1
			local fi = t * (#list - 1) + 1
			local i = math.floor(fi)
			local fr = fi - i
			local a, b = list[i], list[math.min(i + 1, #list)]
			local p = a:Lerp(b, fr)
			f.Position = UDim2.fromScale(p.X / 3840, p.Y / 2560)
			local fade = math.min(1, t / 0.15, (1 - t) / 0.15)
			f.Visible = true
			if g then g.BackgroundTransparency = 1 - fade end
			core.BackgroundTransparency = 1 - fade * 0.9
		end)
	end

	function self.update(_: Links, ms: MapState)
		local list = MapLogic.edges(ms, edges)
		local want: { [string]: MapLogic.Link } = {}
		for _, l in list do want[l.from .. "_" .. l.to] = l end
		-- drop the gone
		for key, r in recs do
			if want[key] == nil then
				clear(r)
				recs[key] = nil
			end
		end
		local low = lowTier()
		local reduced = Motion.reduced() or Motion.snapshot()
		-- dots budget: every locked edge in map order until the cap
		local dotBudget = DOT_CAP
		for key, r in recs do
			if r.mode == "dots" and want[key] and not want[key].lit then dotBudget -= r.ndots end
		end
		local sparks = 0
		for key, r in recs do
			if r.spark then sparks += 1 end
		end
		for _, link in list do
			local key = link.from .. "_" .. link.to
			local toNode = ms.nodes[link.to]
			local pulse = toNode ~= nil and toNode.val ~= nil and (toNode.val :: Types.Val).pulse
			local sig = table.concat({ tostring(link.lit), tostring(link.secondary), tostring(link.infected), tostring(low) }, "|")
			local r = recs[key]
			if r == nil or r.sig ~= sig then
				if r then
					if r.mode == "dots" then dotBudget += r.ndots end
					if r.spark then sparks -= 1 end
					clear(r)
				end
				local nr: Rec = { key = key, link = link, mode = "lit", curve = nil, dots = nil, ndots = 0, spark = nil, sig = sig }
				if link.lit then
					buildLit(nr)
				elseif not low and buildDots(nr, dotBudget) then
					nr.mode = "dots"
					dotBudget -= nr.ndots
				else
					nr.mode = "thread"
					buildThread(nr)
				end
				recs[key] = nr
				r = nr
			end
			local rr = r :: Rec
			rr.link = link
			-- sparks into pulse nodes
			local wantSpark = pulse and link.lit and not low and not reduced
			if wantSpark and rr.spark == nil and sparks < SPARK_CAP then
				buildSpark(rr)
				sparks += 1
			elseif not wantSpark and rr.spark then
				(rr.spark :: Frame):Destroy()
				rr.spark = nil
				sparks -= 1
			end
		end
	end

	function self.onCamera(_: Links, cam: Camera)
		z, m = cam.z, cam.m
		local k = math.max(z, floorK()) * m
		if lastK > 0 and math.abs(k - lastK) <= 0.02 * lastK then return end
		lastK = k
		local w = widths()
		for _, r in recs do
			if r.mode == "lit" and r.curve then
				(r.curve :: Recipes.Curve):setWidths(w)
			elseif r.mode == "thread" and r.curve then
				(r.curve :: Recipes.Curve):setWidths({ 2.5 * m })
			end
			local sp = r.spark
			if sp then
				local size = math.floor(26 * math.max(z, floorK()) * m + 0.5)
				sp.Size = UDim2.fromOffset(size, size)
			end
		end
	end

	function self.count(_: Links): (number, number, number)
		local lit, dots, sparks = 0, 0, 0
		for _, r in recs do
			if r.mode == "lit" then lit += 1 end
			dots += r.ndots
			if r.spark then sparks += 1 end
		end
		return lit, dots, sparks
	end

	function self.destroy(_: Links)
		camConn:Disconnect()
		for _, r in recs do clear(r) end
		table.clear(recs)
	end
	camConn = view.cameraChanged:Connect(function(cam: Camera)
		self:onCamera(cam)
	end)
	self:onCamera(view:camera())
	return self
end

return Links
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="114">
            <Properties>
              <string name="Name">MapCamera</string>
              <string name="Source"><![CDATA[--!strict
--[[
	MapCamera: the realm camera contract of art/camera.js, ported line for line (art/REALM.md sections 2, 5, 6).
	Pure Luau: no Roblox services and no requires, so the unit tests run it under plain luau against camera.js
	(port/tools/camera_cases.js -> port/tests/unit/map_camera.luau).

	The names and shapes follow camera.js: points are { x, y }, sizes { w, h }, all in map points (V, screen
	positions) or world / layer-local px (C, p). MapView converts to Vector2 at its edge. On top of camera.js this adds
	what the client chooses inside the contract (DESIGN.md 3.3, 3.5): the HUD-safe start framing, frameRect, the fly-to
	target on the free rect, SmoothDamp, and the whole-pixel tile edges of REALM.md 9.3.
]]

export type Pt = { x: number, y: number }
export type Size = { w: number, h: number }
export type Rect = { x: number, y: number, w: number, h: number }
export type Domain = { minW: number, minH: number, maxW: number, maxH: number, minAspect: number, maxAspect: number }
export type LayerDef = { f: number, w: number, h: number, ax: number?, ay: number? }
export type Scale = { scale: number, w: number, h: number, box: Size }
export type Limits = { x0: number, x1: number, y0: number, y1: number }
export type Cam = { x: number, y: number, z: number }
export type Weights = { rift: number, corrupt: number, cover: number }
export type Channel = { ch: string, type: string, amp: number?, period: number?, phase: number?, speed: number?,
	from: number?, to: number?, a: number?, b: number?, dur: number?, ease: string?, slot: number?, seed: number?,
	out: string? }
export type SpriteInst = { a: number?, m: { Channel }? }
export type SpriteState = { dx: number, dy: number, rot: number, scale: number, alpha: number, grad: number }
export type BiomeDef = {
	rift: { from: number, to: number },
	corrupt: { rect: { number }, cover: { number }, focus: { number }, light: { radius: { number }, falloff: { number } } },
}
export type Particle = { x: number, y: number, size: number, vx: number, vy: number, bx: number?, by: number?,
	bt: number?, bp: number?, a: number, ta: number?, tt: number?, tp: number?, tau: number }
export type FieldDef = { f: number, zHide: number, zShow: number, cell: { number }, maxSize: number, maxBob: number }
export type Placed = { i: number, x: number, y: number, size: number, alpha: number }
export type RGB = { number }

local MapCamera = {}

-- ------------------------------------------------------------------------------------------------ contract constants
-- realm.json repeats these (src/shared/Realm.luau camera); the unit test fails if they ever disagree.
local WORLD = table.freeze({ w = 3840, h = 2560, cx = 1920, cy = 1280 })
local Z_MAX = 1.25
local ZOOM_SLACK = 0.06
local OVERSCROLL = 72
-- zMin is this fraction of the contain fit, so the whole realm shows with a small border (REALM.md 2.4)
local ZOOM_OUT_FIT = 0.96
-- the hard pan margin (world px): how far the visible rect may extend past each world edge, capped at half the view
local PAN_MARGIN: Pt = table.freeze({ x = 960, y = 720 })
local NO_MARGIN: Pt = table.freeze({ x = 0, y = 0 }) -- the world rect itself: the start camera (REALM.md 2.8)
local DOMAIN: Domain = table.freeze({ minW = 568, minH = 320, maxW = 2560, maxH = 1440, minAspect = 0.45, maxAspect = 3.6 })
MapCamera.WORLD, MapCamera.Z_MAX, MapCamera.ZOOM_SLACK, MapCamera.OVERSCROLL, MapCamera.DOMAIN =
	WORLD, Z_MAX, ZOOM_SLACK, OVERSCROLL, DOMAIN
MapCamera.PAN_MARGIN, MapCamera.NO_MARGIN, MapCamera.ZOOM_OUT_FIT = PAN_MARGIN, NO_MARGIN, ZOOM_OUT_FIT
local START: Pt = table.freeze({ x = 1500, y = 1150 })
MapCamera.START = START

local function clamp(x: number, a: number, b: number): number
	return if x < a then a elseif x > b then b else x
end
local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end
local function smoothstep(a: number, b: number, x: number): number
	local t = clamp((x - a) / (b - a), 0, 1)
	return t * t * (3 - 2 * t)
end
local function mod(a: number, n: number): number
	return ((a % n) + n) % n
end
MapCamera.clamp, MapCamera.lerp, MapCamera.smoothstep, MapCamera.mod = clamp, lerp, smoothstep, mod

-- ------------------------------------------------------------------------------------------------ viewport
-- Map-point viewport for a device viewport: big screens scale up, tiny ones down, extreme aspects letterbox.
function MapCamera.mapScale(Vpx: Size, dom: Domain?): Scale
	local d = dom or DOMAIN
	local bw, bh = Vpx.w, Vpx.h
	if bw / bh > d.maxAspect then bw = bh * d.maxAspect end
	if bw / bh < d.minAspect then bh = bw / d.minAspect end
	local s = 1
	if bw > d.maxW or bh > d.maxH then
		s = math.max(bw / d.maxW, bh / d.maxH)
	elseif bw < d.minW or bh < d.minH then
		s = math.min(bw / d.minW, bh / d.minH)
	end
	return { scale = s, w = bw / s, h = bh / s, box = { w = bw, h = bh } }
end

-- ------------------------------------------------------------------------------------------------ zoom
-- the dolly law: a layer's scale is z / (f + (1 - f) z); depth order never flips at any zoom
local function layerZoom(f: number, z: number): number
	return z / (f + (1 - f) * z)
end
MapCamera.layerZoom = layerZoom
function MapCamera.layerZoomInverse(f: number, s: number): number
	return (s * f) / (1 - s * (1 - f))
end
-- the cover fit: the smallest zoom at which the world still fills the viewport. It was zMin before the full zoom-out;
-- now it only bounds the start zoom, so the first view is framed exactly as before (REALM.md 2.8)
local function zCover(V: Size): number
	return math.min(Z_MAX, math.max(V.w / WORLD.w, V.h / WORLD.h))
end
MapCamera.zCover = zCover
-- the smallest zoom: the contain fit times ZOOM_OUT_FIT (the whole world on screen with a small border), but never a
-- view wider or taller than the world plus the pan margin on both sides (REALM.md 2.4)
local function zMin(V: Size): number
	local contain = ZOOM_OUT_FIT * math.min(V.w / WORLD.w, V.h / WORLD.h)
	return math.min(Z_MAX, math.max(contain, V.w / (WORLD.w + 2 * PAN_MARGIN.x), V.h / (WORLD.h + 2 * PAN_MARGIN.y)))
end
MapCamera.zMin = zMin
local function zoomRange(V: Size, slack: boolean?): (number, number)
	local lo = zMin(V)
	local k = if slack then ZOOM_SLACK else 0
	return lo * (1 - k), Z_MAX * (1 + k)
end
MapCamera.zoomRange = zoomRange

-- ------------------------------------------------------------------------------------------------ layers
local function layerCenter(L: LayerDef, C: Pt): Pt
	local ax = if L.ax ~= nil then L.ax else L.w / 2
	local ay = if L.ay ~= nil then L.ay else L.h / 2
	return { x = ax + L.f * (C.x - WORLD.cx), y = ay + L.f * (C.y - WORLD.cy) }
end
MapCamera.layerCenter = layerCenter
-- the screen position of the layer's local (0, 0), its zoom, and its on-screen size
function MapCamera.layerOffset(L: LayerDef, C: Pt, z: number, V: Size): (number, number, number)
	local s = layerZoom(L.f, z)
	local P = layerCenter(L, C)
	return V.w / 2 - s * P.x, V.h / 2 - s * P.y, s
end
function MapCamera.visibleRect(L: LayerDef, C: Pt, z: number, V: Size): Limits
	local s = layerZoom(L.f, z)
	local P = layerCenter(L, C)
	local hw, hh = V.w / (2 * s), V.h / (2 * s)
	return { x0 = P.x - hw, y0 = P.y - hh, x1 = P.x + hw, y1 = P.y + hh }
end
local function localToScreen(L: LayerDef, C: Pt, z: number, V: Size, p: Pt): Pt
	local s = layerZoom(L.f, z)
	local P = layerCenter(L, C)
	return { x = V.w / 2 + s * (p.x - P.x), y = V.h / 2 + s * (p.y - P.y) }
end
MapCamera.localToScreen = localToScreen
function MapCamera.screenToLocal(L: LayerDef, C: Pt, z: number, V: Size, q: Pt): Pt
	local s = layerZoom(L.f, z)
	local P = layerCenter(L, C)
	return { x = P.x + (q.x - V.w / 2) / s, y = P.y + (q.y - V.h / 2) / s }
end
-- the world (f = 1, anchor = the world centre): q = Vc + z (p - C)
function MapCamera.worldToScreen(C: Pt, z: number, V: Size, p: Pt): Pt
	return { x = V.w / 2 + z * (p.x - C.x), y = V.h / 2 + z * (p.y - C.y) }
end
function MapCamera.screenToWorld(C: Pt, z: number, V: Size, q: Pt): Pt
	return { x = C.x + (q.x - V.w / 2) / z, y = C.y + (q.y - V.h / 2) / z }
end
-- camera centre after zooming z -> z2 about screen point S (the world point under S stays put)
function MapCamera.zoomAt(C: Pt, z: number, z2: number, S: Pt, V: Size): Pt
	local qx, qy = C.x + (S.x - V.w / 2) / z, C.y + (S.y - V.h / 2) / z
	return { x = qx - (S.x - V.w / 2) / z2, y = qy - (S.y - V.h / 2) / z2 }
end

-- ------------------------------------------------------------------------------------------------ clamping
-- range of camera centres at zoom z; overscroll in map points (the rubber band), 0 for the hard limit. On each axis
-- the visible rect may extend past the world by m = min(margin, half the view) world px (margin defaults to
-- PAN_MARGIN), so the centre ranges over [h - m, W - h + m] and never leaves the world; wider than W + 2m pins it
local function panLimits(z: number, V: Size, overscroll: number?, margin: Pt?): Limits
	local hw, hh, o = V.w / (2 * z), V.h / (2 * z), (overscroll or 0) / z
	local M = margin or PAN_MARGIN
	local mx, my = math.min(M.x, hw), math.min(M.y, hh)
	local ax0, ax1 = WORLD.cx, WORLD.cx
	if 2 * hw <= WORLD.w + 2 * mx then ax0, ax1 = hw - mx, WORLD.w - hw + mx end
	local ay0, ay1 = WORLD.cy, WORLD.cy
	if 2 * hh <= WORLD.h + 2 * my then ay0, ay1 = hh - my, WORLD.h - hh + my end
	return { x0 = ax0 - o, x1 = ax1 + o, y0 = ay0 - o, y1 = ay1 + o }
end
MapCamera.panLimits = panLimits
-- the hard clamp, or the rubber-band envelope (rubber = true); margin as in panLimits
local function clampCamera(C: Pt, z: number, V: Size, rubber: boolean?, margin: Pt?): Cam
	local lo, hi = zoomRange(V, rubber)
	local zz = clamp(z, lo, hi)
	local lim = panLimits(zz, V, if rubber then OVERSCROLL else 0, margin)
	return { x = clamp(C.x, lim.x0, lim.x1), y = clamp(C.y, lim.y0, lim.y1), z = zz }
end
MapCamera.clampCamera = clampCamera
-- the start zoom frames the whole tree (REALM.md 2.8); its floor is the cover fit, not zMin
local function startZoom(V: Size): number
	return clamp(math.min(V.w / 1500, V.h / 1750), zCover(V), 1)
end
MapCamera.startZoom = startZoom
-- the start camera: START at the start zoom, clamped to the world rect (no pan margin: the first view shows only the
-- world; the player pans into the margin from there)
function MapCamera.startCamera(V: Size): Cam
	return clampCamera(START, startZoom(V), V, false, NO_MARGIN)
end
-- iOS-style resistance: raw overshoot x (>= 0, map points) -> displayed overshoot, approaching d
function MapCamera.rubberBand(x: number, d: number?, c: number?): number
	local dd, cc = d or OVERSCROLL, c or 0.55
	return dd * (1 - 1 / (x * cc / dd + 1))
end

-- ------------------------------------------------------------------------------------------------ biome
-- share of the visible world rect that rect r = { x0, y0, x1, y1 } covers
local function viewCover(r: { number }, C: Pt, z: number, V: Size): number
	local hw, hh = V.w / (2 * z), V.h / (2 * z)
	local ix = math.max(0, math.min(C.x + hw, r[3]) - math.max(C.x - hw, r[1]))
	local iy = math.max(0, math.min(C.y + hh, r[4]) - math.max(C.y - hh, r[2]))
	return (ix * iy) / (4 * hw * hh)
end
MapCamera.viewCover = viewCover
-- biome weights: rift from the camera centre, corrupt from the share of the view the outcrop covers
function MapCamera.biome(C: Pt, B: BiomeDef, z: number, V: Size): Weights
	local rift = smoothstep(B.rift.from, B.rift.to, C.x)
	local c = B.corrupt
	local cover = viewCover(c.rect, C, z, V)
	local corrupt = rift * smoothstep(c.cover[1], c.cover[2], cover)
	return { rift = rift, corrupt = corrupt, cover = cover }
end
-- the outcrop's light at world point p, in [0, 1]
local function corruptLight(B: BiomeDef, p: Pt): number
	local c = B.corrupt
	local L = c.light
	local dx, dy = (p.x - c.focus[1]) / L.radius[1], (p.y - c.focus[2]) / L.radius[2]
	local d = math.sqrt(dx * dx + dy * dy)
	return 1 - smoothstep(L.falloff[1], L.falloff[2], d)
end
MapCamera.corruptLight = corruptLight
local function mixRGB(a: RGB, b: RGB, t: number): RGB
	return { lerp(a[1], b[1], t), lerp(a[2], b[2], t), lerp(a[3], b[3], t) }
end
MapCamera.mixRGB = mixRGB
local WHITE: RGB = table.freeze({ 255, 255, 255 })
-- tile tint (multiply) of a layer with tint rift: mix(white, rift, w.rift); the world (no tint) stays white
function MapCamera.biomeTint(tintRift: RGB?, w: Weights): RGB
	return if tintRift then mixRGB(WHITE, tintRift, w.rift) else { 255, 255, 255 }
end
-- the full-screen wash between mid and near
function MapCamera.biomeWash(W: { realm: { color: RGB, alpha: number }, rift: { color: RGB, alpha: number } }, w: Weights): (RGB, number)
	return mixRGB(W.realm.color, W.rift.color, w.rift), lerp(W.realm.alpha, W.rift.alpha, w.rift)
end
-- a sprite with a colour { realm, rift, corrupt } over world point p
function MapCamera.biomeSpriteColor(color: { realm: RGB, rift: RGB, corrupt: RGB }, w: Weights, B: BiomeDef, p: Pt): RGB
	return mixRGB(mixRGB(color.realm, color.rift, w.rift), color.corrupt, w.corrupt * corruptLight(B, p))
end
-- a field particle (palette index c from 0, threshold cg) of a kind { palette, rift, corrupt } over world point p
function MapCamera.biomeFieldColor(kind: { palette: { RGB }, rift: RGB, corrupt: RGB }, c: number, cg: number, w: Weights,
	B: BiomeDef, p: Pt): RGB
	local g = w.corrupt * corruptLight(B, p)
	local base = mixRGB(kind.palette[(c % #kind.palette) + 1], kind.rift, w.rift)
	return mixRGB(base, kind.corrupt, smoothstep(math.max(0, cg - 0.12), math.min(1, cg + 0.12), g))
end
-- the draw alpha of a corrupt bloom (0 = hidden)
function MapCamera.bloomAlpha(alpha: number, w: Weights): number
	return alpha * w.corrupt
end

-- ------------------------------------------------------------------------------------------------ rng / hashing
-- mulberry32 on unsigned 32-bit words, bit-identical to camera.js rng (Math.imul, >>>, ^, |)
local TWO32 = 4294967296
local function u32(x: number): number
	x = if x >= 0 then math.floor(x) else math.ceil(x)
	return x - math.floor(x / TWO32) * TWO32
end
local function imul(a: number, b: number): number
	local ah, al = bit32.rshift(a, 16), bit32.band(a, 0xFFFF)
	local bh, bl = bit32.rshift(b, 16), bit32.band(b, 0xFFFF)
	local mid = (ah * bl + al * bh) % 65536
	return (al * bl + mid * 65536) % TWO32
end
function MapCamera.rng(seed: number): () -> number
	local s = u32(seed)
	return function(): number
		s = u32(s + 0x6D2B79F5)
		local t = imul(bit32.bxor(s, bit32.rshift(s, 15)), bit32.bor(1, s))
		t = bit32.bxor(u32(t + imul(bit32.bxor(t, bit32.rshift(t, 7)), bit32.bor(61, t))), t)
		return bit32.bxor(t, bit32.rshift(t, 14)) / TWO32
	end
end
local function hash01(a: number, b: number?): number
	return MapCamera.rng(a * 374761393 + (b or 0) * 668265263)()
end
MapCamera.hash01 = hash01

-- ------------------------------------------------------------------------------------------------ motion
-- every channel is a closed form of time t; the client plays the same curves with TweenService (REALM.md 6.2)
local EASE: { [string]: (number) -> number } = {
	linear = function(u: number): number return u end,
	quadOut = function(u: number): number return 1 - (1 - u) * (1 - u) end,
	quintOut = function(u: number): number return 1 - (1 - u) ^ 5 end,
	sineInOut = function(u: number): number return -(math.cos(math.pi * u) - 1) / 2 end,
}
MapCamera.EASE = EASE
-- one channel -> the value to add to the base (x, y, rot, scale) or the absolute value (alpha, grad)
local function channel(m: Channel, t: number): number
	local ty = m.type
	local phase = m.phase or 0
	if ty == "sine" then
		return (m.amp or 0) * math.sin(2 * math.pi * (t / (m.period or 1) + phase))
	elseif ty == "drift" then
		local from, to = m.from or 0, m.to or 0
		local span = to - from
		return from + mod((m.speed or 0) * t + phase * span, span)
	elseif ty == "pulse" then
		local period, dur = m.period or 1, m.dur or 1
		local u = mod(t / period + phase, 1) * period
		local a, b = m.a or 0, m.b or 0
		return if u < dur then lerp(a, b, (EASE[m.ease or "quadOut"] or EASE.quadOut)(u / dur)) else b
	elseif ty == "scroll" then
		return -1 + 2 * mod(t / (m.period or 1) + phase, 1)
	elseif ty == "flicker" then
		local slot, dur, seed = m.slot or 1, m.dur or 0, m.seed or 0
		local k = math.floor(t / slot)
		local start = k * slot + hash01(seed, k) * (slot - dur)
		local on = if t >= start and t < start + dur then 1 else 0
		return if m.out == "jitter" then on * (hash01(seed + 1, k) - 0.5) * 2 * (m.amp or 0) else on
	end
	error("unknown motion type " .. tostring(ty))
end
MapCamera.channel = channel
-- all channels of a sprite instance
function MapCamera.spriteState(inst: SpriteInst, t: number): SpriteState
	local o = { dx = 0, dy = 0, rot = 0, scale = 1, alpha = if inst.a ~= nil then inst.a else 1, grad = 0 }
	local list: { Channel } = inst.m or {}
	for _, m in list do
		local v = channel(m, t)
		local ch = m.ch
		if ch == "x" then
			o.dx += v
		elseif ch == "y" then
			o.dy += v
		elseif ch == "rot" then
			o.rot += v
		elseif ch == "scale" then
			o.scale = if m.type == "pulse" then v else o.scale + v
		elseif ch == "alpha" then
			o.alpha = if m.type == "pulse" then v elseif m.type == "flicker" then o.alpha * v else o.alpha + v
		elseif ch == "grad" then
			o.grad = v
		end
	end
	o.alpha = clamp(o.alpha, 0, 1)
	return o
end

-- ------------------------------------------------------------------------------------------------ particle fields
-- a particle's local position inside the cell at time t (the drift wraps inside the cell: seamless)
local function fieldLocal(p: Particle, cw: number, ch: number, t: number): (number, number)
	local x = mod(p.x + p.vx * t, cw)
	local bx = p.bx
	if bx and bx ~= 0 then x += bx * math.sin(2 * math.pi * (t / (p.bt or 1) + (p.bp or 0))) end
	local y = mod(p.y + p.vy * t, ch)
	local by = p.by
	if by and by ~= 0 then y += by * math.sin(2 * math.pi * (t / (p.bt or 1) + (p.bp or 0) + 0.25)) end
	return x, y
end
MapCamera.fieldLocal = fieldLocal
-- Visit every on-screen copy of a field's particles for camera (C, z, V) at time t: visit(i, x, y, size, alpha) in
-- map points (i = the index in `particles`, size = diameter). A visit returning true stops the walk (pool full).
function MapCamera.fieldVisit(field: FieldDef, particles: { Particle }, C: Pt, z: number, V: Size, t: number,
	visit: (i: number, x: number, y: number, size: number, alpha: number) -> boolean?)
	local vis = smoothstep(field.zHide, field.zShow, z)
	if vis <= 0 then return end
	local s = layerZoom(field.f, z)
	-- the field layer has anchor (0, 0): P = f (C - Wc)
	local Px, Py = field.f * (C.x - WORLD.cx), field.f * (C.y - WORLD.cy)
	local hw, hh = V.w / (2 * s), V.h / (2 * s)
	local x0, x1, y0, y1 = Px - hw, Px + hw, Py - hh, Py + hh
	local cw, ch = field.cell[1], field.cell[2]
	local pad = field.maxSize / 2 + field.maxBob
	local i0, i1 = math.floor((x0 - pad) / cw), math.floor((x1 + pad) / cw)
	local j0, j1 = math.floor((y0 - pad) / ch), math.floor((y1 + pad) / ch)
	local vcx, vcy = V.w / 2, V.h / 2
	for k, p in particles do
		if z < p.tau then continue end
		local ta = p.ta
		local tw = if ta and ta ~= 0 then ta * math.sin(2 * math.pi * (t / (p.tt or 1) + (p.tp or 0))) else 0
		local a = vis * smoothstep(p.tau, p.tau * 1.12, z) * (p.a + tw)
		if a <= 0.004 then continue end
		local qx, qy = fieldLocal(p, cw, ch, t)
		local r = p.size / 2
		for i = i0, i1 do
			for j = j0, j1 do
				local lx, ly = i * cw + qx, j * ch + qy
				if lx + r < x0 or lx - r > x1 or ly + r < y0 or ly - r > y1 then continue end
				if visit(k, vcx + s * (lx - Px), vcy + s * (ly - Py), p.size * s, a) then return end
			end
		end
	end
end
-- camera.js fieldPlace: the list of placed copies (the reference form of fieldVisit)
function MapCamera.fieldPlace(field: FieldDef, particles: { Particle }, C: Pt, z: number, V: Size, t: number): { Placed }
	local out: { Placed } = {}
	MapCamera.fieldVisit(field, particles, C, z, V, t, function(i: number, x: number, y: number, size: number, alpha: number): boolean?
		table.insert(out, { i = i, x = x, y = y, size = size, alpha = alpha })
		return nil
	end)
	return out
end

-- ------------------------------------------------------------------------------------------------ client framing
-- (DESIGN.md 3.3, 3.5, REALM.md 9.4; not in camera.js: the client's choices inside the contract)

-- Unity's SmoothDamp for one scalar: critically damped spring toward target; returns (x, velocity)
function MapCamera.smoothDamp(x: number, target: number, vel: number, smoothTime: number, dt: number): (number, number)
	local st = math.max(0.0001, smoothTime)
	local omega = 2 / st
	local k = omega * dt
	local e = 1 / (1 + k + 0.48 * k * k + 0.235 * k * k * k)
	local change = x - target
	local temp = (vel + omega * change) * dt
	local v = (vel - omega * temp) * e
	local out = target + (change + temp) * e
	-- never overshoot the target
	if (target - x > 0) == (out > target) then
		out = target
		v = (out - target) / math.max(dt, 1e-6)
	end
	return out, v
end

-- The HUD-safe start (DESIGN.md 3.3, REALM.md 2.8). V = the Box in map points, safe = the part of it not under the
-- HUD bands (map points, Box-relative). WIDE / MEDIUM: the whole tree framed on the safe rect. COMPACT: the touch rest
-- zoom 0.34 around `focus` (the READY centroid, the last layer, or the trunk), placed `focusY` of the way down the
-- safe rect (0.5 = centred; a new player's M sits at 0.6). Returns (C, z) clamped to the world rect (NO_MARGIN, like
-- startCamera): the first view shows only the world.
function MapCamera.startFraming(V: Size, safe: Rect, mode: string, focus: Pt?, focusY: number?): (Pt, number)
	local lo = zCover(V) -- the start keeps the cover-fit floor (REALM.md 2.8): the first view is framed as before
	local z: number
	local target = focus or MapCamera.START
	if mode == "COMPACT" then
		z = clamp(0.34, lo, Z_MAX)
	else
		z = clamp(math.min(safe.w / 1500, safe.h / 1750), lo, 1)
	end
	-- the screen point where the target should land: the safe rect's centre (or focusY of the way down)
	local sx = safe.x + safe.w / 2
	local sy = safe.y + safe.h * (focusY or 0.5)
	local C = { x = target.x + (V.w / 2 - sx) / z, y = target.y + (V.h / 2 - sy) / z }
	local c = clampCamera(C, z, V, false, NO_MARGIN)
	return { x = c.x, y = c.y }, c.z
end
-- frameNodes: fit a world rect (the rings and plates of some nodes) into the safe rect; returns the hard-clamped (C, z)
function MapCamera.frameRect(bbox: Rect, V: Size, safe: Rect, zCap: number?): (Pt, number)
	local lo = zMin(V)
	local bw, bh = math.max(bbox.w, 1), math.max(bbox.h, 1)
	local z = clamp(math.min(safe.w / bw, safe.h / bh), lo, math.max(lo, zCap or 1))
	local cx, cy = bbox.x + bbox.w / 2, bbox.y + bbox.h / 2
	local sx, sy = safe.x + safe.w / 2, safe.y + safe.h / 2
	local c = clampCamera({ x = cx + (V.w / 2 - sx) / z, y = cy + (V.h / 2 - sy) / z }, z, V, false)
	return { x = c.x, y = c.y }, c.z
end
-- the fly-to target: node N at the centre of the free rect F (map points, Box-relative), at zoom z, hard-clamped
function MapCamera.flyTarget(N: Pt, z: number, V: Size, free: Rect?): (Pt, number)
	local fx = if free then free.x + free.w / 2 else V.w / 2
	local fy = if free then free.y + free.h / 2 else V.h / 2
	local c = clampCamera({ x = N.x + (V.w / 2 - fx) / z, y = N.y + (V.h / 2 - fy) / z }, z, V, false)
	return { x = c.x, y = c.y }, c.z
end

-- REALM.md 9.3: whole-device-pixel tile edges. edges = a layer's column (or row) edges in local px; o = the
-- container origin and s the layer zoom (map points); m = device px per map point. Writes out[i] and returns it.
function MapCamera.snapEdges(edges: { number }, m: number, o: number, s: number, out: { number }): { number }
	for i, x in edges do
		out[i] = math.round(m * (o + s * x))
	end
	return out
end

return MapCamera
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="115">
            <Properties>
              <string name="Name">MapInput</string>
              <string name="Source"><![CDATA[--!strict
--[[
	MapInput: the map's gestures (art/REALM.md 9.4 camera.feel, DESIGN.md 3.4, Q-M1).

	    local mi = MapInput.new(view, Input)
	    mi:step(dt)                   once a frame before view:step (App's PreRender loop)
	    mi:wasDrag()                  the current / last press became a pan (node taps check it)
	    mi.emptyTap:Connect(fn)       a tap on the map where no node is (App closes a side sheet)
	    mi:zoomStep(dir, abs?)        one wheel notch (the zoom capsule, the - / = keys)
	    mi:busy()                     gliding, pinching or zooming: holds must not start (Recipes.holdGate)
	    mi:setEnabled(b)

	Gestures: drag past 6 pt (mouse) / 12 pt (touch) pans with velocity smoothed over 0.05 s, rubber band at the
	edges, inertia exp(-dt / 0.32) on release (stops under 6 pt/s, capped at 4500 pt/s); wheel x1.12 a notch toward a
	target zoom eased in log space (tau 0.085 s) about the cursor; two-finger pinch about the midpoint with a pan by the
	midpoint (zoom rubber +-6%); double-tap / double-click x1.6 toward the point in 0.35 s; double-tap-and-drag zooms
	(1 pt up = x1.006); gamepad left stick pans (1400 pt/s, deadzone .18, curve 1.6), triggers zoom (x1.8 a second).
	The view springs back into the hard envelope when input stops. Reduced motion: no inertia, a hard clamp while
	dragging, instant zoom steps and no animated double-tap.
	A press starts only when no HUD / panel / overlay element is on top (Input.overUi) and inside the map Box.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Core = script.Parent.Parent:WaitForChild("Core")
local Signal = require(Core:WaitForChild("Signal"))
local Layout = require(Core:WaitForChild("Layout"))
local Motion = require(Core:WaitForChild("Motion"))
local MapCamera = require(script.Parent:WaitForChild("MapCamera"))

local MapInput = {}

type Pt = MapCamera.Pt

export type InputLib = { overUi: (abs: Vector2) -> boolean }
export type MapInput = {
	emptyTap: Signal.Signal<Vector2>,
	wasDrag: (self: MapInput) -> boolean,
	busy: (self: MapInput) -> boolean,
	setEnabled: (self: MapInput, b: boolean) -> (),
	zoomStep: (self: MapInput, dir: number, at: Vector2?) -> (),
	step: (self: MapInput, dt: number) -> (),
	destroy: (self: MapInput) -> (),
}

type Press = { io: InputObject, touch: boolean, start: Vector2, last: Vector2, t0: number }

-- the view's shape as MapInput uses it (MapView.MapView satisfies it)
type View = {
	box: Frame,
	nodes: Frame,
	inputActive: boolean,
	camera: (self: any) -> { C: Vector2, z: number, V: Vector2, m: number },
	setCamera: (self: any, C: Vector2, z: number, rubber: boolean?) -> (),
	flyTo: (self: any, C: Vector2, z: number, o: { time: number?, ease: string? }?) -> (),
	cancelFly: (self: any) -> (),
	absToMap: (self: any, q: Vector2) -> Vector2,
}

function MapInput.new(view: View, input: InputLib?): MapInput
	local Realm: any = require(game:GetService("ReplicatedStorage"):WaitForChild("MilestoneTree"):WaitForChild("Realm"))
	local feel = Realm.feel
	local self = {} :: MapInput
	self.emptyTap = Signal.new() :: Signal.Signal<Vector2>

	local enabled = true
	local presses: { [InputObject]: Press } = {}
	local order: { InputObject } = {}
	local mouse: Vector2? = nil -- the last mouse position (abs)
	local dragging = false
	local dragFrom: { C: Pt, at: Vector2 }? = nil -- the camera and pointer (map pts) where the pan (re)started
	local wasDrag = false
	local vx, vy = 0, 0 -- pointer velocity, map points / s
	local lastPt: Vector2? = nil
	local inertia = false
	local pinch: { d0: number, z0: number, Q: Pt }? = nil
	local pinchEnd = -math.huge -- when the last pinch ended (a release right after it does not fling)
	local zoomDrag: { y0: number, z0: number, at: Vector2 }? = nil
	local wheelZ: number? = nil
	local wheelAt = Vector2.zero
	local lastTap = { t = -math.huge, at = Vector2.zero }
	local stick = Vector2.zero
	local trigR, trigL = 0, 0
	local conns: { RBXScriptConnection } = {}

	local function over(abs: Vector2): boolean
		if input then return input.overUi(abs) end
		return false
	end
	local function inBox(abs: Vector2): boolean
		local p, s = view.box.AbsolutePosition, view.box.AbsoluteSize
		return abs.X >= p.X and abs.Y >= p.Y and abs.X <= p.X + s.X and abs.Y <= p.Y + s.Y
	end
	local function toMap(abs: Vector2): Vector2
		return view:absToMap(abs)
	end
	local function posOf(pr: Press): Vector2
		if pr.touch then return Layout.inputToAbs(pr.io.Position) end
		return mouse or pr.last
	end
	local function reduced(): boolean
		return Motion.reduced()
	end
	local function cam(): (Pt, number, MapCamera.Size, number)
		local c = view:camera()
		return { x = c.C.X, y = c.C.Y }, c.z, { w = c.V.X, h = c.V.Y }, c.m
	end
	local function apply(C: Pt, z: number, rubber: boolean)
		view:setCamera(Vector2.new(C.x, C.y), z, rubber and not reduced())
	end
	-- the pan with the displayed rubber band: overshoot past the hard limit resists (rubberBand of REALM.md 2.5)
	local function rubberPan(C: Pt, z: number, V: MapCamera.Size): Pt
		if reduced() then
			local c = MapCamera.clampCamera(C, z, V, false)
			return { x = c.x, y = c.y }
		end
		local lim = MapCamera.panLimits(z, V, 0)
		local function axis(v: number, lo: number, hi: number): number
			if v < lo then return lo - MapCamera.rubberBand((lo - v) * z) / z end
			if v > hi then return hi + MapCamera.rubberBand((v - hi) * z) / z end
			return v
		end
		return { x = axis(C.x, lim.x0, lim.x1), y = axis(C.y, lim.y0, lim.y1) }
	end
	local function zoomAbout(z2: number, at: Vector2, rubber: boolean)
		local C, z, V = cam()
		local lo, hi = MapCamera.zoomRange(V, rubber and not reduced())
		z2 = math.clamp(z2, lo, hi)
		local S = toMap(at)
		local C2 = MapCamera.zoomAt(C, z, z2, { x = S.X, y = S.Y }, V)
		apply(C2, z2, true)
	end
	local function nodeAt(abs: Vector2): boolean
		local lp = Players.LocalPlayer
		local pg = if lp then lp:FindFirstChildOfClass("PlayerGui") else nil
		if pg == nil then return false end
		local ok, list = pcall(function(): { GuiObject }
			return (pg :: PlayerGui):GetGuiObjectsAtPosition(abs.X, abs.Y)
		end)
		if not ok then return false end
		for _, o in list do
			if o:IsA("GuiButton") and o:IsDescendantOf(view.nodes) then return true end
		end
		return false
	end
	local function count(): number
		return #order
	end
	local function beginPinch()
		local a, b = presses[order[1]], presses[order[2]]
		if a == nil or b == nil then return end
		local pa, pb = toMap(posOf(a)), toMap(posOf(b))
		local C, z, V = cam()
		local mid = (pa + pb) / 2
		pinch = {
			d0 = math.max(8, (pa - pb).Magnitude),
			z0 = z,
			Q = { x = C.x + (mid.X - V.w / 2) / z, y = C.y + (mid.Y - V.h / 2) / z },
		}
		dragging = false
		dragFrom = nil
		zoomDrag = nil
		wasDrag = true
		inertia = false
		vx, vy = 0, 0
	end

	-- ------------------------------------------------------------------------------------------ raw input
	table.insert(conns, UserInputService.InputBegan:Connect(function(io: InputObject, _processed: boolean)
		if not enabled then return end
		local t = io.UserInputType
		if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
		local abs = Layout.inputToAbs(io.Position)
		if t == Enum.UserInputType.MouseButton1 then mouse = abs end
		if not inBox(abs) or over(abs) then return end
		view:cancelFly()
		inertia = false
		vx, vy = 0, 0
		wheelZ = nil
		local pr: Press = { io = io, touch = t == Enum.UserInputType.Touch, start = abs, last = abs, t0 = os.clock() }
		presses[io] = pr
		table.insert(order, io)
		if count() == 1 then
			wasDrag = false
			dragging = false
			dragFrom = nil
			-- a second press right after a tap: double-tap-and-drag zoom (touch) or a double click
			if os.clock() - lastTap.t < 0.3 and (abs - lastTap.at).Magnitude < 30 then
				local _, z = cam()
				zoomDrag = { y0 = abs.Y, z0 = z, at = abs }
			else
				zoomDrag = nil
			end
		elseif count() == 2 and pr.touch then
			beginPinch()
		end
		view.inputActive = true
	end))
	table.insert(conns, UserInputService.InputChanged:Connect(function(io: InputObject, processed: boolean)
		local t = io.UserInputType
		if t == Enum.UserInputType.MouseMovement then
			mouse = Layout.inputToAbs(io.Position)
		elseif t == Enum.UserInputType.MouseWheel then
			if not enabled then return end
			local abs = Layout.inputToAbs(io.Position)
			if not inBox(abs) or over(abs) then return end
			local notch = io.Position.Z
			if notch == 0 then return end
			self:zoomStep(if notch > 0 then 1 else -1, abs)
		elseif t == Enum.UserInputType.Gamepad1 then
			if processed or not enabled then return end
			if io.KeyCode == Enum.KeyCode.Thumbstick1 then
				stick = Vector2.new(io.Position.X, io.Position.Y)
			elseif io.KeyCode == Enum.KeyCode.ButtonR2 then
				trigR = io.Position.Z
			elseif io.KeyCode == Enum.KeyCode.ButtonL2 then
				trigL = io.Position.Z
			end
		end
	end))
	local function finish(io: InputObject)
		local pr = presses[io]
		if pr == nil then return end
		presses[io] = nil
		local i = table.find(order, io)
		if i then table.remove(order, i) end
		local abs = posOf(pr)
		if pinch then
			if count() < 2 then
				pinch = nil
				pinchEnd = os.clock()
			end
			if count() == 1 then
				-- the remaining finger continues as a pan, measured from where it is now: a stale lastPt (the last
				-- one-finger drag) made the first frame's velocity huge and the release flung the map away
				local rest = presses[order[1]]
				if rest then
					local C = cam()
					local at = toMap(posOf(rest))
					dragFrom = { C = C, at = at }
					lastPt = at
					dragging = true
				end
				vx, vy = 0, 0
			end
		elseif zoomDrag then
			local zd = zoomDrag
			zoomDrag = nil
			if (abs - zd.at).Magnitude < 12 then
				-- a double tap: x1.6 toward the point
				local C, z, V = cam()
				local z2 = math.clamp(z * feel.doubleTapFactor, MapCamera.zMin(V), MapCamera.Z_MAX)
				local S = toMap(abs)
				local C2 = MapCamera.zoomAt(C, z, z2, { x = S.X, y = S.Y }, V)
				local hc = MapCamera.clampCamera(C2, z2, V, false)
				view:flyTo(Vector2.new(hc.x, hc.y), hc.z, { time = feel.doubleTapSeconds, ease = "quintOut" })
				lastTap.t = -math.huge
			end
		elseif not dragging and count() == 0 then
			-- a tap
			if not nodeAt(abs) then self.emptyTap:Fire(abs) end
			lastTap.t, lastTap.at = os.clock(), abs
		end
		if count() == 0 then
			-- letting go of a pinch (the fingers lift a moment apart) is not a fling
			if os.clock() - pinchEnd < feel.pinchReleaseQuiet then vx, vy = 0, 0 end
			if dragging and not reduced() then
				-- inertia, except on an axis that is already past the hard limit (the spring takes it back)
				local C, z, V = cam()
				local hard = MapCamera.clampCamera(C, z, V, false)
				local sp = math.sqrt(vx * vx + vy * vy)
				if sp > feel.maxFling then
					vx, vy = vx / sp * feel.maxFling, vy / sp * feel.maxFling
				end
				if math.abs(hard.x - C.x) > 1e-6 then vx = 0 end
				if math.abs(hard.y - C.y) > 1e-6 then vy = 0 end
				inertia = math.sqrt(vx * vx + vy * vy) > feel.inertiaStop
			end
			dragging = false
			dragFrom = nil
			if not inertia and wheelZ == nil then view.inputActive = false end
		end
	end
	table.insert(conns, UserInputService.InputEnded:Connect(function(io: InputObject)
		local t = io.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			finish(io)
		elseif t == Enum.UserInputType.Gamepad1 then
			if io.KeyCode == Enum.KeyCode.Thumbstick1 then stick = Vector2.zero end
			if io.KeyCode == Enum.KeyCode.ButtonR2 then trigR = 0 end
			if io.KeyCode == Enum.KeyCode.ButtonL2 then trigL = 0 end
		end
	end))
	-- trackpads: two-finger pan and pinch arrive as PointerAction (the wheel comes as MouseWheel above)
	table.insert(conns, UserInputService.PointerAction:Connect(function(_wheel: number, pan: Vector2, pinchDelta: number, processed: boolean)
		if processed or not enabled then return end
		local at = mouse or Vector2.zero
		if not inBox(at) or over(at) then return end
		local C, z, V, m = cam()
		if pan.Magnitude > 0 then
			local p = MapCamera.clampCamera({ x = C.x - pan.X / m / z, y = C.y - pan.Y / m / z }, z, V, false)
			apply({ x = p.x, y = p.y }, z, false)
		end
		if pinchDelta ~= 0 then zoomAbout(z * (1 + pinchDelta), at, false) end
	end))

	-- ------------------------------------------------------------------------------------------ API
	function self.wasDrag(_: MapInput): boolean
		return wasDrag
	end
	function self.busy(_: MapInput): boolean
		return pinch ~= nil or inertia or zoomDrag ~= nil or math.sqrt(vx * vx + vy * vy) > feel.inertiaStop and dragging
	end
	function self.setEnabled(_: MapInput, b: boolean)
		enabled = b
		if not b then
			table.clear(presses)
			table.clear(order)
			dragging, pinch, zoomDrag, inertia, wheelZ = false, nil, nil, false, nil
			view.inputActive = false
		end
	end
	function self.zoomStep(_: MapInput, dir: number, at: Vector2?)
		local _, z, V = cam()
		local bp, bs = view.box.AbsolutePosition, view.box.AbsoluteSize
		wheelAt = at or (bp + bs / 2)
		local base = wheelZ or z
		local target = math.clamp(base * feel.wheelFactor ^ dir, MapCamera.zMin(V), MapCamera.Z_MAX)
		view:cancelFly()
		if reduced() then
			wheelZ = nil
			zoomAbout(target, wheelAt, false)
			return
		end
		wheelZ = target
		view.inputActive = true
	end
	function self.step(_: MapInput, dt: number)
		if dt <= 0 then return end
		local C, z, V, m = cam()
		-- one finger / the mouse: pan, or the double-tap-drag zoom
		if not pinch and count() >= 1 then
			local pr = presses[order[1]]
			if pr then
				local abs = posOf(pr)
				pr.last = abs
				local p = toMap(abs)
				if zoomDrag then
					local zd = zoomDrag
					if (abs - zd.at).Magnitude >= 12 then wasDrag = true end
					local dy = (abs.Y - zd.y0) / m
					zoomAbout(zd.z0 * 1.006 ^ (-dy), zd.at, true)
				else
					local moved = (abs - pr.start).Magnitude / m
					local threshold = if pr.touch then feel.dragTouch else feel.dragMouse
					if not dragging and moved > threshold then
						dragging = true
						wasDrag = true
						dragFrom = { C = C, at = p }
						lastPt = p
					end
					if dragging and dragFrom then
						local df = dragFrom
						local raw = { x = df.C.x - (p.X - df.at.X) / z, y = df.C.y - (p.Y - df.at.Y) / z }
						apply(rubberPan(raw, z, V), z, true)
						-- velocity, exponentially smoothed (tau .05 s)
						local lp = lastPt or p
						local ix, iy = (p.X - lp.X) / dt, (p.Y - lp.Y) / dt
						local k = 1 - math.exp(-dt / feel.velocityTau)
						vx += (ix - vx) * k
						vy += (iy - vy) * k
						lastPt = p
					end
				end
			end
		end
		-- two fingers: pinch about the midpoint, pan by its motion
		if pinch and count() >= 2 then
			local a, b = presses[order[1]], presses[order[2]]
			if a and b then
				local pa, pb = toMap(posOf(a)), toMap(posOf(b))
				local mid = (pa + pb) / 2
				local d = math.max(8, (pa - pb).Magnitude)
				local lo, hi = MapCamera.zoomRange(V, not reduced())
				local z2 = math.clamp(pinch.z0 * d / pinch.d0, lo, hi)
				local C2 = { x = pinch.Q.x - (mid.X - V.w / 2) / z2, y = pinch.Q.y - (mid.Y - V.h / 2) / z2 }
				apply(rubberPan(C2, z2, V), z2, true)
			end
		end
		-- inertia
		if inertia then
			local decay = math.exp(-dt / feel.inertiaTau)
			vx *= decay
			vy *= decay
			if math.sqrt(vx * vx + vy * vy) < feel.inertiaStop then
				inertia = false
				vx, vy = 0, 0
				if count() == 0 and wheelZ == nil then view.inputActive = false end
			else
				local c = MapCamera.clampCamera({ x = C.x - vx * dt / z, y = C.y - vy * dt / z }, z, V, false)
				if math.abs(c.x - (C.x - vx * dt / z)) > 1e-6 then vx = 0 end
				if math.abs(c.y - (C.y - vy * dt / z)) > 1e-6 then vy = 0 end
				apply({ x = c.x, y = c.y }, z, false)
			end
		end
		-- the wheel: ease toward the target zoom in log space about the cursor
		if wheelZ then
			local target = wheelZ :: number
			local _, zNow = cam()
			local k = 1 - math.exp(-dt / feel.wheelTau)
			local lz = math.log(zNow) + (math.log(target) - math.log(zNow)) * k
			local z2 = math.exp(lz)
			if math.abs(lz - math.log(target)) < 1e-4 then
				z2 = target
				wheelZ = nil
				if count() == 0 and not inertia then view.inputActive = false end
			end
			zoomAbout(z2, wheelAt, false)
		end
		-- gamepad: stick pan, trigger zoom
		local mag = stick.Magnitude
		if enabled and mag > feel.padDeadzone then
			local k = ((mag - feel.padDeadzone) / (1 - feel.padDeadzone)) ^ feel.padCurve
			local dir = stick / mag
			local speed = feel.padSpeed * k
			local C3, z3, V3 = cam()
			local c = MapCamera.clampCamera({ x = C3.x + dir.X * speed * dt / z3, y = C3.y - dir.Y * speed * dt / z3 }, z3, V3, false)
			view:cancelFly()
			apply({ x = c.x, y = c.y }, z3, false)
		end
		local trig = trigR - trigL
		if enabled and math.abs(trig) > 0.05 then
			local _, z4 = cam()
			local bp, bs = view.box.AbsolutePosition, view.box.AbsoluteSize
			view:cancelFly()
			zoomAbout(z4 * feel.padZoomRate ^ (trig * dt), bp + bs / 2, false)
		end
	end
	function self.destroy(_: MapInput)
		for _, c in conns do c:Disconnect() end
		table.clear(conns)
		self.emptyTap:DisconnectAll()
	end
	return self
end

return MapInput
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="116">
            <Properties>
              <string name="Name">MapLogic</string>
              <string name="Source"><![CDATA[--!strict
--[[
	MapLogic: the pure rules behind the map widgets (DESIGN.md 3.7-3.10), kept apart from instances so the unit tests
	run them under plain luau (port/tests/unit/map_nodes.luau).

	    MapLogic.state(ms, layer)       the node state: sealed | frontier | dormant | locked | available | glow | pulse
	    MapLogic.flags(ms, layer)       { selected, challenge, infected }
	    MapLogic.rank(ms, layer)        the draw / plate priority (selected > pulse > glow > challenge > available > ...)
	    MapLogic.plateName(node)        the whole-word plate name (DESIGN.md 3.9)
	    MapLogic.unit(resource)         the short unit of a resource name ("hyper-prestige points" -> "HP")
	    MapLogic.lod(z, mode, prev)     FULL | CHIP | NONE with the +-.02 hysteresis
	    MapLogic.edges(ms, realmEdges)  the drawn connections { from, to, p, lit, secondary, infected }
	    MapLogic.markers(...)           the edge-marker candidates, pulse first, at most 4
	    MapLogic.place(items, blocked)  the greedy plate placement (collision and occlusion)

	Nothing here touches Roblox services or requires a module.
]]

-- the parts of Types.MapState / MapNode / Rect this reads (structural: the real tables fit)
export type Rect = { x: number, y: number, w: number, h: number }
type Branch = { to: string, col: string, w: number? }
-- read as: MapNode { show, dor, col?, name?, ch?, br: { Branch }?, val: { lit, glow, pulse }? },
-- MapState { inside, open?, gate?, nodes: { [string]: MapNode }, ready, canBuy } (Types.MapState passes as is)
type MapNode = any
type MapState = any

local MapLogic = {}

MapLogic.ORDER = {
	"ach", "m", "mm", "em", "p", "pe", "sp", "pb", "pp", "se", "hp", "ep", "hb", "ap", "mp", "t", "pm", "pep", "cp", "cm", "ex",
}
-- the Prestige Multiverse cluster; everything else is the Normal Universe
MapLogic.MULTIVERSE = { pm = true, pep = true, cp = true, cm = true, ex = true } :: { [string]: boolean }

-- plate names: whole words, the emblem symbol names the family (DESIGN.md 3.9)
MapLogic.NAMES = {
	m = "MILESTONE", mm = "META", em = "EXTRA", p = "PRESTIGE", pe = "ENERGY", sp = "SUPER", pb = "BOOST", pp = "POWER",
	se = "SUPER ENERGY", hp = "HYPER", ep = "EXOTIC", hb = "HYPER BOOST", ap = "ATOMIC", mp = "MULTIVERSE", t = "TRANSCEND",
	pep = "PRESTIGED EXOTIC", cp = "CORRUPTED", cm = "CORRUPTED MILESTONE", ex = "EXPLORE", ach = "ACHIEVEMENTS",
} :: { [string]: string }

-- the fixed unit table keyed by the resource name (the view sends the game's own words)
MapLogic.UNITS = {
	["prestige points"] = "P",
	["super-prestige points"] = "SP",
	["hyper-prestige points"] = "HP",
	["exotic prestige"] = "EP",
	["exotic prestige points"] = "EP",
	["prestige power"] = "PP",
	["atomic-prestige points"] = "AP",
	["multiverse prestige points"] = "MP",
	["transcend points"] = "TP",
	["prestige energy"] = "PE",
	["super energy"] = "SE",
	["prestige boosts"] = "PB",
	["hyper boosts"] = "HB",
	["milestones"] = "milestones",
	["meta-milestones"] = "MM",
	["extra-milestones"] = "EM",
	["fixed corruptions"] = "fixed",
	["prestige essence"] = "essence",
	["prestiged-exotic prestige points"] = "PEP",
	["corrupted milestones"] = "CM",
	["exploration points"] = "XP",
} :: { [string]: string }

-- the malware colours of infected layers (m #9f2846, p #c25757, sp rgb(238,112,112)) and the infected link colour
local INFECTED = { ["#9f2846"] = true, ["#c25757"] = true, ["#ee7070"] = true, ["#c86a6a"] = true } :: { [string]: boolean }
local function normColor(css: string?): string
	if css == nil then return "" end
	local s = string.lower((string.gsub(css, "%s", "")))
	local r, g, b = string.match(s, "^rgba?%((%d+),(%d+),(%d+)")
	if r and g and b then
		return string.format("#%02x%02x%02x", tonumber(r) or 0, tonumber(g) or 0, tonumber(b) or 0)
	end
	return s
end
MapLogic.normColor = normColor
function MapLogic.isInfected(css: string?): boolean
	return INFECTED[normColor(css)] == true
end

-- the Figma parents: an edge from -> to makes `from` a parent of `to` (Realm.edges; ids are game ids)
export type Edge = { from: string, to: string, p: { number } }
local parentsCache: { [any]: { [string]: { string } } } = setmetatable({}, { __mode = "k" }) :: any
function MapLogic.parents(edges: { Edge }): { [string]: { string } }
	local hit = parentsCache[edges]
	if hit then return hit end
	local out: { [string]: { string } } = {}
	for _, e in edges do
		local list = out[e.to]
		if list == nil then
			list = {}
			out[e.to] = list
		end
		table.insert(list, e.from)
	end
	parentsCache[edges] = out
	return out
end

local function shown(ms: MapState, l: string): boolean
	local n = ms.nodes[l]
	return n ~= nil and n.show
end
MapLogic.shown = shown

-- sealed | frontier | dormant | locked | available | glow | pulse
function MapLogic.state(ms: MapState, layer: string, edges: { Edge }?): string
	local n = ms.nodes[layer]
	if n == nil then return "sealed" end
	if not n.show then
		-- dormant: the layer lives in the other universe (the view's `dor` is also true for untouched layers whose
		-- `unlocked` defaults to true, so it counts only once the Multiverse is revealed or entered)
		if n.dor then
			local multi = MapLogic.MULTIVERSE[layer] == true
			local inside = ms.inside == true
			local revealed = inside or (ms.gate ~= nil and ms.gate.show == true)
			if revealed and multi ~= inside then return "dormant" end
		end
		if edges then
			local uni = MapLogic.MULTIVERSE[layer] == true
			for _, p in (MapLogic.parents(edges)[layer] or {}) :: { string } do
				if (MapLogic.MULTIVERSE[p] == true) == uni and shown(ms, p) then return "frontier" end
			end
		end
		return "sealed"
	end
	local v = n.val
	if v == nil then return "available" end
	if not v.lit then return "locked" end
	if v.pulse then return "pulse" end
	if v.glow then return "glow" end
	return "available"
end

export type Flags = { selected: boolean, challenge: boolean, infected: boolean }
function MapLogic.flags(ms: MapState, layer: string): Flags
	local n = ms.nodes[layer]
	local shownNode = n ~= nil and n.show
	return {
		selected = shownNode and ms.open == layer,
		challenge = shownNode and n ~= nil and n.ch ~= nil,
		infected = shownNode and n ~= nil and MapLogic.isInfected(n.col),
	}
end

-- higher draws on top and gets its plate first
local STATE_RANK = { pulse = 60, glow = 50, available = 30, locked = 20, dormant = 10, frontier = 5, sealed = 0 } :: { [string]: number }
function MapLogic.rank(ms: MapState, layer: string, edges: { Edge }?): number
	local st = MapLogic.state(ms, layer, edges)
	local f = MapLogic.flags(ms, layer)
	local r = STATE_RANK[st] or 0
	if f.selected then r = 100 end
	if f.challenge and r < 40 and st ~= "locked" then r = 40 end
	return r
end

-- a plate name with at most ~12 characters a line (one break at the space nearest the middle)
function MapLogic.wrapName(name: string): string
	if #name <= 12 or not string.find(name, " ", 1, true) then return name end
	local best, bestD = nil :: number?, math.huge
	local mid = #name / 2
	local i = 0
	while true do
		local j = string.find(name, " ", i + 1, true)
		if j == nil then break end
		local d = math.abs(j - mid)
		if d < bestD then best, bestD = j, d end
		i = j
	end
	if best == nil then return name end
	return string.sub(name, 1, best - 1) .. "\n" .. string.sub(name, best + 1)
end

function MapLogic.plateName(node: MapNode?, layer: string): string
	if layer == "pm" then
		local sent = if node and node.name then string.upper(node.name) else "???"
		return MapLogic.wrapName(sent)
	end
	return MapLogic.wrapName(MapLogic.NAMES[layer] or string.upper((node and node.name) or layer))
end

-- the game's HTML resource name as plain words
function MapLogic.plain(s: string?): string
	if s == nil then return "" end
	local t = string.gsub(s, "<[^>]*>", "")
	t = string.gsub(t, "&nbsp;", " ")
	t = string.gsub(t, "&amp;", "&")
	t = string.gsub(t, "^%s+", "")
	t = string.gsub(t, "%s+$", "")
	return t
end
function MapLogic.unit(resource: string?): string
	local r = string.lower(MapLogic.plain(resource))
	local hit = MapLogic.UNITS[r]
	if hit then return hit end
	-- infected names keep their base unit ("infected super prestige points")
	local base = string.gsub(r, "^infected%s+", "")
	base = string.gsub(base, " ", "-", 1)
	return MapLogic.UNITS[base] or MapLogic.UNITS[string.gsub(r, "^infected%s+", "")] or r
end

-- plate level of detail (DESIGN.md 3.9); prev keeps the hysteresis
local LOD = { WIDE = { full = 0.40, chip = 0.28 }, COMPACT = { full = 0.30, chip = 0.22 } }
function MapLogic.lod(z: number, mode: string, prev: string?): string
	local t = if mode == "COMPACT" then LOD.COMPACT else LOD.WIDE
	local h = 0.02
	local full = t.full + (if prev == "FULL" then -h elseif prev ~= nil then h else 0)
	local chip = t.chip + (if prev == "FULL" or prev == "CHIP" then -h elseif prev ~= nil then h else 0)
	if z >= full then return "FULL" end
	if z >= chip then return "CHIP" end
	return "NONE"
end

-- the connections to draw: both ends shown and one of them lists the other in `br`
export type Link = { from: string, to: string, p: { number }, lit: boolean, secondary: boolean, infected: boolean }
function MapLogic.edges(ms: MapState, realmEdges: { Edge }): { Link }
	local out: { Link } = {}
	for _, e in realmEdges do
		local a, b = ms.nodes[e.from], ms.nodes[e.to]
		if a == nil or b == nil or not a.show or not b.show then continue end
		local found: Branch? = nil
		for _, br in (a.br or {}) :: { Branch } do
			if br.to == e.to then found = br end
		end
		for _, br in (b.br or {}) :: { Branch } do
			if br.to == e.from then found = br end
		end
		if found == nil then continue end
		local col = normColor(found.col)
		local toVal = b.val
		table.insert(out, {
			from = e.from,
			to = e.to,
			p = e.p,
			lit = toVal ~= nil and toVal.lit,
			secondary = col == "#7f7f7f",
			infected = INFECTED[col] == true or MapLogic.isInfected(b.col),
		})
	end
	return out
end

-- the nodes that want an edge marker, pulse first then glow, map order, at most `max`
function MapLogic.markerCandidates(ms: MapState, max: number?): { string }
	local out = {}
	for _, l in ms.ready do table.insert(out, l) end
	for _, l in ms.canBuy do table.insert(out, l) end
	local cap = max or 4
	while #out > cap do table.remove(out) end
	return out
end

-- where the ray from the centre of r (inset) toward (px, py) leaves it; nil when the point is inside
function MapLogic.edgePoint(r: Rect, px: number, py: number, inset: number): (number?, number?)
	local x0, y0, x1, y1 = r.x + inset, r.y + inset, r.x + r.w - inset, r.y + r.h - inset
	if px >= x0 and px <= x1 and py >= y0 and py <= y1 then return nil, nil end
	local cx, cy = (x0 + x1) / 2, (y0 + y1) / 2
	local dx, dy = px - cx, py - cy
	local t = math.huge
	if dx > 0 then t = math.min(t, (x1 - cx) / dx) elseif dx < 0 then t = math.min(t, (x0 - cx) / dx) end
	if dy > 0 then t = math.min(t, (y1 - cy) / dy) elseif dy < 0 then t = math.min(t, (y0 - cy) / dy) end
	if t == math.huge then return cx, cy end
	return cx + dx * t, cy + dy * t
end

-- ------------------------------------------------------------------------------------------------------ placement
local function overlap(a: Rect, b: Rect): number
	local w = math.min(a.x + a.w, b.x + b.w) - math.max(a.x, b.x)
	local h = math.min(a.y + a.h, b.y + b.h) - math.max(a.y, b.y)
	if w <= 0 or h <= 0 then return 0 end
	return math.min(w, h)
end
MapLogic.overlap = overlap

-- One plate: its slots in preference order (below the ring, above it) for the FULL and CHIP forms.
export type PlateItem = {
	id: string,
	rank: number,
	y: number, -- world y (the tie-break: higher on the map first)
	full: { Rect }?, -- slot rects of the FULL form (nil: FULL not wanted)
	chip: { Rect }?, -- slot rects of the CHIP form (nil: no chip)
	keep: boolean?, -- selected / hovered: never dropped for a collision
}
export type Placed = { id: string, form: string, slot: number, rect: Rect? } -- form: FULL | CHIP | NONE
-- Greedy: in priority order, the first slot of the richest form that meets no blocked rect (HUD) and overlaps no
-- placed plate by more than `slack` px; else the chip; else nothing (the plate fades out, its ring stays).
function MapLogic.place(items: { PlateItem }, blocked: { Rect }, slack: number?): { [string]: Placed }
	local s = slack or 4
	local list = table.clone(items)
	table.sort(list, function(a: PlateItem, b: PlateItem): boolean
		if a.rank ~= b.rank then return a.rank > b.rank end
		if a.y ~= b.y then return a.y < b.y end
		return a.id < b.id
	end)
	local placed: { Rect } = {}
	local out: { [string]: Placed } = {}
	local function free(r: Rect, checkPlaced: boolean): boolean
		for _, b in blocked do
			if overlap(r, b) > 0 then return false end
		end
		if checkPlaced then
			for _, p in placed do
				if overlap(r, p) > s then return false end
			end
		end
		return true
	end
	for _, it in list do
		local done = false
		for _, form in { "FULL", "CHIP" } do
			local slots = if form == "FULL" then it.full else it.chip
			if slots == nil then continue end
			for i, r in slots :: { Rect } do
				if free(r, not it.keep) then
					out[it.id] = { id = it.id, form = form, slot = i, rect = r }
					table.insert(placed, r)
					done = true
					break
				end
			end
			if done then break end
		end
		if not done then out[it.id] = { id = it.id, form = "NONE", slot = 0, rect = nil } end
	end
	return out
end

return MapLogic
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="117">
            <Properties>
              <string name="Name">MapView</string>
              <string name="Source"><![CDATA[--!strict
--[[
	MapView: the realm map's GUI tree and camera (art/REALM.md 9, DESIGN.md 3.1-3.6).

	    local view = MapView.new(gui, root, { tier = "HIGH" })
	    view.box / view.links / view.nodes / view.plates        containers the node widgets, links and plates go in
	    view.cameraChanged:Connect(function(cam) ... end)        after the writes of every frame the camera moved
	    view:setCamera(C, z, rubber?)   view:flyTo(C, z, { time, ease })   view:focusWorld(p)   view:frameWorld(bbox)
	    view:frameStart({ mode, focus, focusY, intro })          the HUD-safe start framing (DESIGN.md 3.3)
	    view:setRect(absRect?, { animate })                      the Box-resize strip beside a side sheet (3.6)
	    view:worldToAbs(p), view:absToWorld(q), view:absToMap(q)
	    view:setTier("LOW"), view:setReduced(b), view:setAmbient(on), view:setForegroundOpen(open), view:images()
	    view:step(dt)                                            once a frame (App's PreRender loop)

	The tree (REALM.md 9.1, siblings take ZIndex = their place in the list):
	    Root (black) > Box (whole device px, ClipsDescendants, no UIScale)
	      L0_sky, L1_clouds, L2_far, L3_mid     planes: Back (clouds only), Tile_i_j..., Sprites (the moving container)
	      Wash, L4_near (Back, tiles, Sprites), F_motesFar, L5_world, L6_fg, F_motesNear
	      Links, Nodes                          moving containers with the world transform (x / 3840, y / 2560 inside)
	      F_particles, Vignette
	      Plates                                full Box, sized Box / s in offset under UIScale s (constant UI size)
	Positions are Scale units of the Box; only tiles are written in offset, snapped to whole device pixels (9.3).
	At rest nothing is written except the particle fields (they drift). Tiles with no asset id are skipped; a missing
	sky or world gets the procedural fallback (Fallback.luau); without the realm atlas there are no ambient sprites.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Signal = require(Core:WaitForChild("Signal"))
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Motion = require(Core:WaitForChild("Motion"))
local Prefs = require(Core:WaitForChild("Prefs"))
local MapCamera = require(script.Parent:WaitForChild("MapCamera"))
local Ambient = require(script.Parent:WaitForChild("Ambient"))
local Fields = require(script.Parent:WaitForChild("Fields"))
local Fallback = require(script.Parent:WaitForChild("Fallback"))

type Camera = Types.Camera
type ARect = Types.Rect
type Pt = MapCamera.Pt
type Size = MapCamera.Size
type Weights = MapCamera.Weights

local MapView = {}

local WORLD = MapCamera.WORLD
local FIELD_ORDER = { motesFar = "F_motesFar", motesNear = "F_motesNear", particles = "F_particles" }

local function quintInOut(u: number): number
	return if u < 0.5 then 16 * u ^ 5 else 1 - ((-2 * u + 2) ^ 5) / 2
end
local EASES: { [string]: (number) -> number } = {
	linear = MapCamera.EASE.linear,
	quadOut = MapCamera.EASE.quadOut,
	quintOut = MapCamera.EASE.quintOut,
	sineInOut = MapCamera.EASE.sineInOut,
	quintInOut = quintInOut,
	quadIn = function(u: number): number return u * u end,
}

-- REALM.md 9.5: LOW on touch-only devices, small displays and low graphics quality; Options can override
function MapView.chooseTier(): string
	local detail = Prefs.get().detail
	if detail == "HIGH" or detail == "LOW" then return detail end
	local low = false
	pcall(function()
		if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then low = true end
		if GuiService.ViewportDisplaySize == Enum.DisplaySize.Small then low = true end
	end)
	pcall(function()
		local settings = UserSettings():GetService("UserGameSettings")
		local q = settings.SavedQualityLevel
		if q == Enum.SavedQualitySetting.QualityLevel1 or q == Enum.SavedQualitySetting.QualityLevel2
			or q == Enum.SavedQualitySetting.QualityLevel3 then
			low = true
		end
	end)
	return if low then "LOW" else "HIGH"
end

type TileRec = { gui: ImageLabel, i: number, j: number }
type LayerRec = {
	def: any, -- Realm layer { id, depth, f, w, h, ax, ay, zHide, zShow, opaque, back, tint }
	plane: Frame,
	sprites: Frame,
	back: Frame?,
	tiles: { TileRec },
	xs: { [number]: number },
	ys: { [number]: number },
	tintKey: string,
	alpha: number, -- last written tile alpha (fg fade)
}
type Flight = {
	mode: string, -- "damp" | "ease"
	C: Pt,
	z: number,
	vx: number,
	vy: number,
	vz: number,
	smooth: number,
	C0: Pt,
	z0: number,
	t: number,
	time: number,
	ease: (number) -> number,
}
type RectAnim = { from: ARect, to: ARect?, t: number, time: number, ease: (number) -> number }

export type MapView = {
	gui: ScreenGui,
	root: Frame,
	box: Frame,
	links: Frame,
	nodes: Frame,
	plates: Frame,
	cameraChanged: Signal.Signal<Camera>,
	tier: string,
	art: { tiles: number, uploaded: number, atlas: boolean },
	inputActive: boolean, -- set by MapInput while a finger, mouse or wheel is driving the camera

	camera: (self: MapView) -> Camera,
	setCamera: (self: MapView, C: Vector2, z: number, rubber: boolean?) -> (),
	flyTo: (self: MapView, C: Vector2, z: number, o: { time: number?, ease: string? }?) -> (),
	cancelFly: (self: MapView) -> (),
	isFlying: (self: MapView) -> boolean,
	focusWorld: (self: MapView, p: Vector2, o: { zoom: number?, time: number? }?) -> (),
	frameWorld: (self: MapView, bbox: ARect, o: { time: number? }?) -> (),
	frameStart: (self: MapView, o: { mode: string?, focus: Vector2?, focusY: number?, intro: boolean? }?) -> (),
	setRect: (self: MapView, r: ARect?, o: { animate: boolean?, time: number?, ease: string? }?) -> (),
	setTier: (self: MapView, t: string) -> (),
	setReduced: (self: MapView, b: boolean) -> (),
	setAmbient: (self: MapView, on: boolean) -> (),
	setForegroundOpen: (self: MapView, open: boolean) -> (),
	setRiftHover: (self: MapView, on: boolean) -> (),
	worldToAbs: (self: MapView, p: Vector2) -> Vector2,
	absToWorld: (self: MapView, q: Vector2) -> Vector2,
	absToMap: (self: MapView, q: Vector2) -> Vector2,
	safeRect: (self: MapView) -> MapCamera.Rect,
	freeRect: (self: MapView) -> MapCamera.Rect,
	images: (self: MapView) -> { string },
	step: (self: MapView, dt: number) -> (),
	destroy: (self: MapView) -> (),
}

local function rgb(t: { number }): Color3
	return Color3.fromRGB(math.clamp(math.floor(t[1] + 0.5), 0, 255), math.clamp(math.floor(t[2] + 0.5), 0, 255),
		math.clamp(math.floor(t[3] + 0.5), 0, 255))
end
local function frame(parent: Instance, name: string, z: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Active = false
	f.ZIndex = z
	f.Size = UDim2.fromScale(1, 1)
	f.Parent = parent
	return f
end
local function hasId(id: any): boolean
	return type(id) == "string" and id ~= ""
end

function MapView.new(gui: ScreenGui, root: Frame, o: { assets: any?, realm: any?, tier: string? }?): MapView
	local opts: { assets: any?, realm: any?, tier: string? } = o or {}
	local realm: any = opts.realm or require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("Realm"))
	local assets: any = opts.assets
	if assets == nil then
		local ok, a = pcall(function(): any
			local m: any = require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("Assets"))
			return m
		end)
		assets = if ok then a else nil
	end
	local lp = Players.LocalPlayer
	local assume = lp ~= nil and lp:GetAttribute("MT_AssumeAssets") == true
	Theme.detect()

	local self = {} :: MapView
	self.gui = gui
	self.root = root
	self.cameraChanged = Signal.new() :: Signal.Signal<Camera>
	self.tier = opts.tier or MapView.chooseTier()
	self.art = { tiles = 0, uploaded = 0, atlas = false }
	self.inputActive = false

	root.BackgroundColor3 = Color3.new(0, 0, 0)
	root.BackgroundTransparency = 0
	local box = frame(root, "Box", 1)
	box.ClipsDescendants = true
	self.box = box

	-- ------------------------------------------------------------------------------------------ state
	local C: Pt = { x = MapCamera.START.x, y = MapCamera.START.y }
	local z = 0.6
	local V: Size = { w = 1920, h = 1080 }
	local m = 1
	local boxW, boxH = 1920, 1080
	local rect: ARect? = nil -- the available area (abs); nil = the whole root
	local rectAnim: RectAnim? = nil
	local flight: Flight? = nil
	local dirty = true
	local reduced = Motion.reduced()
	local ambientOn = true
	local fgOpen = true
	local fgK = 1 -- the side-sheet factor of fg + motesNear, eased over 0.2 s
	local w: Weights = { rift = 0, corrupt = 0, cover = 0 }
	local wTarget: Weights = { rift = 0, corrupt = 0, cover = 0 }
	local wWritten = { rift = -1, corrupt = -1 }
	local lastColorCam = { x = math.huge, y = math.huge, z = 0 }
	local clock0 = os.clock()
	local spring = { x = 0, y = 0, z = 0 } -- SmoothDamp velocities of the spring back

	local layers: { LayerRec } = {}
	local byId: { [string]: LayerRec } = {}
	local fieldFrames: { [string]: Frame } = {}
	local ambient: Ambient.Ambient? = nil
	local fields: Fields.Fields? = nil
	local fallbackWorld: Fallback.World? = nil
	local fallbackTweens: { Tween } = {}
	local fallbackMade: { Instance } = {}
	local tileCount = 0

	-- ------------------------------------------------------------------------------------------ the tree
	local z0 = 0
	local function nextZ(): number
		z0 += 1
		return z0
	end
	local names = { sky = "L0_sky", clouds = "L1_clouds", far = "L2_far", mid = "L3_mid", near = "L4_near", world = "L5_world", fg = "L6_fg" }
	local wash: Frame
	local vignette: ImageLabel? = nil
	local vignetteFrame: Frame? = nil
	local links: Frame
	local nodesF: Frame
	local plates: Frame
	local platesScale: UIScale
	for _, def in realm.layers do
		local plane = frame(box, names[def.id] or ("L_" .. def.id), nextZ())
		local back: Frame? = nil
		if def.back then
			back = frame(plane, "Back", 1)
		end
		local sprites = frame(plane, "Sprites", 3)
		local rec: LayerRec = { def = def, plane = plane, sprites = sprites, back = back, tiles = {}, xs = {}, ys = {}, tintKey = "", alpha = -1 }
		table.insert(layers, rec)
		byId[def.id] = rec
		if def.id == "mid" then
			wash = frame(box, "Wash", nextZ())
			wash.BackgroundTransparency = 1
		elseif def.id == "near" then
			fieldFrames.motesFar = frame(box, FIELD_ORDER.motesFar, nextZ())
		elseif def.id == "fg" then
			fieldFrames.motesNear = frame(box, FIELD_ORDER.motesNear, nextZ())
		end
	end
	links = frame(box, "Links", nextZ())
	nodesF = frame(box, "Nodes", nextZ())
	fieldFrames.particles = frame(box, FIELD_ORDER.particles, nextZ())
	local vz = nextZ()
	plates = frame(box, "Plates", nextZ())
	platesScale = Instance.new("UIScale")
	platesScale.Parent = plates
	self.links, self.nodes, self.plates = links, nodesF, plates
	-- nodes and the rift hotspot take input; everything else in the map is inert. Interactable = false carries down to
	-- descendants, so it goes on each layer beside Nodes, never on the Box that holds Nodes.
	local function inert(c: Instance)
		if c ~= nodesF and c:IsA("GuiObject") then
			pcall(function() c.Interactable = false end)
		end
	end
	for _, c in box:GetChildren() do inert(c) end
	box.ChildAdded:Connect(inert)

	-- ------------------------------------------------------------------------------------------ art
	local function tierLayer(id: string): (any?, string)
		local tiers = assets and assets.tiers
		if tiers == nil then return nil, self.tier end
		local want = tiers[self.tier]
		local other = tiers[if self.tier == "LOW" then "HIGH" else "LOW"]
		local function uploaded(t: any): number
			if t == nil or t.layers[id] == nil then return 0 end
			local n = 0
			for _, tile in t.layers[id].tiles do
				if hasId(tile.id) then n += 1 end
			end
			return n
		end
		if assume or uploaded(want) > 0 or uploaded(other) == 0 then
			return if want then want.layers[id] else nil, self.tier
		end
		return other.layers[id], if self.tier == "LOW" then "HIGH" else "LOW"
	end
	local function atlasInfo(): Ambient.Atlas?
		local sp = assets and assets.sprites
		if sp == nil then return nil end
		local idWant = sp.atlas[self.tier]
		local id, k = idWant, if self.tier == "LOW" then 0.5 else 1
		if not hasId(id) then
			local otherTier = if self.tier == "LOW" then "HIGH" else "LOW"
			id = sp.atlas[otherTier]
			k = if otherTier == "LOW" then 0.5 else 1
		end
		if not hasId(id) then
			if assume then return { id = "", regions = sp.regions, k = if self.tier == "LOW" then 0.5 else 1 } end
			return nil
		end
		return { id = id, regions = sp.regions, k = k }
	end

	local function clearArt()
		if ambient then ambient:destroy() end
		ambient = nil
		if fields then fields:destroy() end
		fields = nil
		for _, t in fallbackTweens do t:Cancel() end
		table.clear(fallbackTweens)
		for _, inst in fallbackMade do inst:Destroy() end
		table.clear(fallbackMade)
		fallbackWorld = nil
		for _, rec in layers do
			for _, t in rec.tiles do t.gui:Destroy() end
			table.clear(rec.tiles)
			table.clear(rec.xs)
			table.clear(rec.ys)
			rec.tintKey = ""
			rec.alpha = -1
		end
		if vignette then vignette:Destroy() end
		vignette = nil
		if vignetteFrame then vignetteFrame:Destroy() end
		vignetteFrame = nil
		tileCount = 0
	end

	local function buildArt()
		clearArt()
		local gutter = (assets and assets.gutter) or 2
		local total, have = 0, 0
		local missing: { [string]: boolean } = {}
		for _, rec in layers do
			local id = rec.def.id
			local tl, usedTier = tierLayer(id)
			if tl == nil then
				missing[id] = true
				continue
			end
			local anyMissing = false
			-- layers grow around their centre (the pan margin, REALM.md 2.5): tiles cut for a different layer size (an
			-- Assets.luau older than Realm.luau) stay centred on the anchor, so the art keeps its registration
			local dx = if tl.w then (rec.def.w - tl.w) / 2 else 0
			local dy = if tl.h then (rec.def.h - tl.h) / 2 else 0
			for _, t in tl.tiles do
				total += 1
				rec.xs[t.i + 1] = t.x + dx
				rec.xs[t.i + 2] = t.x + t.w + dx
				rec.ys[t.j + 1] = t.y + dy
				rec.ys[t.j + 2] = t.y + t.h + dy
				local ok = hasId(t.id)
				if ok then have += 1 end
				if not ok and not assume then
					anyMissing = true
					continue
				end
				local img = Instance.new("ImageLabel")
				img.Name = string.format("Tile_%d_%d", t.i, t.j)
				img.BackgroundTransparency = 1
				img.BorderSizePixel = 0
				img.Active = false
				img.ZIndex = 2
				img.ScaleType = Enum.ScaleType.Stretch
				img.Image = if ok then t.id else ""
				img.ImageRectOffset = Vector2.new(gutter, gutter)
				img.ImageRectSize = Vector2.new(t.rw, t.rh)
				if assume then img:SetAttribute("Asset", string.format("%s/%s_%d_%d", usedTier, id, t.i, t.j)) end
				img.Parent = rec.plane
				table.insert(rec.tiles, { gui = img, i = t.i, j = t.j })
				tileCount += 1
			end
			if anyMissing then missing[id] = true end
		end
		self.art.tiles, self.art.uploaded = total, have
		-- the procedural look where the sky or the world has holes (plan 3.5)
		local sky, world = byId.sky, byId.world
		if sky and missing.sky then
			for _, inst in Fallback.sky(sky.plane, sky.sprites, { w = sky.def.w, h = sky.def.h }) do table.insert(fallbackMade, inst) end
		end
		if world and missing.world then
			local fw = Fallback.world(world.sprites, realm)
			fallbackWorld = fw
			for _, inst in fw.made do table.insert(fallbackMade, inst) end
			for _, t in Fallback.breathe(fw, reduced) do table.insert(fallbackTweens, t) end
		end
		-- sprites, blooms and fields need the realm atlas
		local atlas = atlasInfo()
		self.art.atlas = atlas ~= nil
		local infos = {}
		local containers, backs = {}, {}
		for _, rec in layers do
			local d = rec.def
			infos[d.id] = { id = d.id, f = d.f, w = d.w, h = d.h, ax = d.ax, ay = d.ay }
			containers[d.id] = rec.sprites
			if rec.back then backs[d.id] = rec.back end
		end
		ambient = Ambient.new({ realm = realm, layers = infos, containers = containers, backs = backs, atlas = atlas, tier = self.tier, reduced = reduced })
		fields = Fields.new({ realm = realm, frames = fieldFrames, atlas = atlas, tier = self.tier })
		if fields then
			fields:setReduced(reduced)
			fields:setEnabled(ambientOn)
		end
		if ambient then ambient:setPaused(not ambientOn) end
		-- the vignette: the atlas region (sampled through its inset rect) or a radial darkening
		if atlas and atlas.id ~= "" and atlas.regions.vignette then
			local v = Instance.new("ImageLabel")
			v.Name = "Vignette"
			v.BackgroundTransparency = 1
			v.BorderSizePixel = 0
			v.Active = false
			v.Size = UDim2.fromScale(1, 1)
			v.ZIndex = vz
			local r = (assets.sprites.sample and assets.sprites.sample.vignette) or atlas.regions.vignette
			v.Image = atlas.id
			v.ImageRectOffset = Vector2.new(r[1] * atlas.k, r[2] * atlas.k)
			v.ImageRectSize = Vector2.new(r[3] * atlas.k, r[4] * atlas.k)
			v.ImageColor3 = rgb(realm.biome.vignette.color)
			v.ImageTransparency = 1 - realm.biome.vignette.alpha
			v.Parent = box
			vignette = v
		elseif Theme.caps.Radial then
			local f = frame(box, "Vignette", vz)
			f.BackgroundTransparency = 0
			f.BackgroundColor3 = rgb(realm.biome.vignette.color)
			local g = Instance.new("UIGradient")
			g.Type = Enum.GradientType.Radial
			g.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.62, 1),
				NumberSequenceKeypoint.new(1, 1 - realm.biome.vignette.alpha * 0.8),
			})
			g.Parent = f
			vignetteFrame = f
		end
		dirty = true
		wWritten.rift, wWritten.corrupt = -1, -1
		lastColorCam.x = math.huge
	end

	-- ------------------------------------------------------------------------------------------ box layout
	local function rootSize(): Vector2
		local s = root.AbsoluteSize
		if s.X < 2 or s.Y < 2 then
			local cam = workspace.CurrentCamera
			s = if cam then cam.ViewportSize else Vector2.new(1920, 1080)
		end
		return s
	end
	-- the available rect in root-local px
	local function available(r: ARect?): (number, number, number, number)
		local rs = rootSize()
		if r == nil then return 0, 0, rs.X, rs.Y end
		local ro = root.AbsolutePosition
		local x0 = math.clamp(r.x - ro.X, 0, rs.X)
		local y0 = math.clamp(r.y - ro.Y, 0, rs.Y)
		local x1 = math.clamp(r.x + r.w - ro.X, x0 + 1, rs.X)
		local y1 = math.clamp(r.y + r.h - ro.Y, y0 + 1, rs.Y)
		return x0, y0, x1 - x0, y1 - y0
	end
	-- REALM.md 9.1: Box = the letterboxed mapScale box on whole device px; V = Box / m
	local function layoutBox(r: ARect?)
		local ax, ay, aw, ah = available(r)
		local ms = MapCamera.mapScale({ w = math.max(aw, 1), h = math.max(ah, 1) })
		local bw, bh = math.max(1, math.round(ms.box.w)), math.max(1, math.round(ms.box.h))
		box.Size = UDim2.fromOffset(bw, bh)
		box.Position = UDim2.fromOffset(ax + math.floor((aw - bw) / 2), ay + math.floor((ah - bh) / 2))
		boxW, boxH, m = bw, bh, ms.scale
		V = { w = bw / m, h = bh / m }
		local s = Layout.s
		platesScale.Scale = s
		plates.Size = UDim2.fromOffset(math.floor(bw / s + 0.5), math.floor(bh / s + 0.5))
		dirty = true
	end

	-- ------------------------------------------------------------------------------------------ camera
	local function applyClamp(rubber: boolean)
		local c = MapCamera.clampCamera(C, z, V, rubber)
		C = { x = c.x, y = c.y }
		z = c.z
	end
	function self.camera(_: MapView): Camera
		return { C = Vector2.new(C.x, C.y), z = z, V = Vector2.new(V.w, V.h), m = m }
	end
	function self.setCamera(_: MapView, c: Vector2, zz: number, rubber: boolean?)
		C = { x = c.X, y = c.Y }
		z = zz
		applyClamp(rubber == true and not reduced)
		dirty = true
	end
	function self.cancelFly(_: MapView)
		flight = nil
	end
	function self.isFlying(_: MapView): boolean
		return flight ~= nil
	end
	function self.flyTo(_: MapView, c: Vector2, zz: number, fo: { time: number?, ease: string? }?)
		local target = MapCamera.clampCamera({ x = c.X, y = c.Y }, zz, V, false)
		if reduced then
			flight = nil
			C = { x = target.x, y = target.y }
			z = target.z
			dirty = true
			return
		end
		local ease = fo and fo.ease
		if ease then
			flight = {
				mode = "ease", C = { x = target.x, y = target.y }, z = target.z, vx = 0, vy = 0, vz = 0, smooth = 0,
				C0 = { x = C.x, y = C.y }, z0 = z, t = 0, time = math.max(0.01, (fo and fo.time) or 0.35),
				ease = EASES[ease] or quintInOut,
			}
		else
			local vx, vy, vzz = 0, 0, 0
			if flight and flight.mode == "damp" then vx, vy, vzz = flight.vx, flight.vy, flight.vz end
			flight = {
				mode = "damp", C = { x = target.x, y = target.y }, z = target.z, vx = vx, vy = vy, vz = vzz,
				smooth = (fo and fo.time) or realm.feel.flySmoothTime, C0 = { x = C.x, y = C.y }, z0 = z, t = 0, time = 0,
				ease = quintInOut,
			}
		end
	end

	-- abs space <-> Box map points <-> world
	function self.absToMap(_: MapView, q: Vector2): Vector2
		local bp = box.AbsolutePosition
		return (q - bp) / m
	end
	function self.worldToAbs(_: MapView, p: Vector2): Vector2
		local bp = box.AbsolutePosition
		return Vector2.new(bp.X + m * (V.w / 2 + z * (p.X - C.x)), bp.Y + m * (V.h / 2 + z * (p.Y - C.y)))
	end
	function self.absToWorld(_: MapView, q: Vector2): Vector2
		local bp = box.AbsolutePosition
		return Vector2.new(C.x + ((q.X - bp.X) / m - V.w / 2) / z, C.y + ((q.Y - bp.Y) / m - V.h / 2) / z)
	end
	-- a Layout rect (abs) as Box map points, clipped to the Box
	local function toMapRect(r: ARect): MapCamera.Rect
		local bp = box.AbsolutePosition
		local x0 = math.clamp((r.x - bp.X) / m, 0, V.w)
		local y0 = math.clamp((r.y - bp.Y) / m, 0, V.h)
		local x1 = math.clamp((r.x + r.w - bp.X) / m, x0 + 1, V.w)
		local y1 = math.clamp((r.y + r.h - bp.Y) / m, y0 + 1, V.h)
		return { x = x0, y = y0, w = x1 - x0, h = y1 - y0 }
	end
	function self.safeRect(_: MapView): MapCamera.Rect
		return toMapRect(Layout.safeStartRect())
	end
	function self.freeRect(_: MapView): MapCamera.Rect
		return toMapRect(Layout.free())
	end
	-- fly so world point p sits at the centre of the free rect, at zoom max(current, .9) (REALM.md 9.4, DESIGN.md 3.5)
	function self.focusWorld(_: MapView, p: Vector2, fo: { zoom: number?, time: number? }?)
		local zz = (fo and fo.zoom) or math.max(z, realm.feel.flyZoom)
		local target, tz = MapCamera.flyTarget({ x = p.X, y = p.Y }, zz, V, self:freeRect())
		self:flyTo(Vector2.new(target.x, target.y), tz, { time = fo and fo.time })
	end
	-- frameNodes (DESIGN.md 3.3): fit a world rect into the safe rect; a timed quintInOut flight when o.time is given
	function self.frameWorld(_: MapView, bbox: ARect, fo: { time: number? }?)
		local target, tz = MapCamera.frameRect(bbox, V, self:safeRect())
		local t = fo and fo.time
		self:flyTo(Vector2.new(target.x, target.y), tz, if t then { time = t, ease = "quintInOut" } else nil)
	end
	-- the HUD-safe start with the intro dolly-out from min(1.12 z0, zMax) over 1.6 s quintOut (none when reduced)
	function self.frameStart(_: MapView, fo: { mode: string?, focus: Vector2?, focusY: number?, intro: boolean? }?)
		local mode = (fo and fo.mode) or Layout.mode
		local focus = fo and fo.focus
		local C0, zs = MapCamera.startFraming(V, self:safeRect(), mode,
			if focus then { x = focus.X, y = focus.Y } else nil, fo and fo.focusY)
		flight = nil
		if fo and fo.intro and not reduced and not Motion.snapshot() then
			local zi = math.min(realm.camera.introFactor * zs, MapCamera.Z_MAX)
			local ci = MapCamera.clampCamera(C0, zi, V, false, MapCamera.NO_MARGIN)
			C, z = { x = ci.x, y = ci.y }, ci.z
			dirty = true
			self:flyTo(Vector2.new(C0.x, C0.y), zs, { time = realm.camera.introSeconds, ease = "quintOut" })
		else
			C, z = C0, zs
			dirty = true
		end
	end

	-- the Box-resize strip (DESIGN.md 3.6): C' = C + (Vc_new - Vc_old) / z keeps the world plane still
	local function resizeTo(r: ARect?)
		local oldVc = { x = V.w / 2, y = V.h / 2 }
		layoutBox(r)
		C = { x = C.x + (V.w / 2 - oldVc.x) / z, y = C.y + (V.h / 2 - oldVc.y) / z }
		if flight then
			flight.C.x += (V.w / 2 - oldVc.x) / z
			flight.C.y += (V.h / 2 - oldVc.y) / z
		end
		applyClamp(true)
	end
	local function fullRect(): ARect
		local ro, rs = root.AbsolutePosition, rootSize()
		return { x = ro.X, y = ro.Y, w = rs.X, h = rs.Y }
	end
	local function currentRect(): ARect
		if rect then return rect :: ARect end
		return fullRect()
	end
	function self.setRect(_: MapView, r: ARect?, ro: { animate: boolean?, time: number?, ease: string? }?)
		local from = currentRect()
		rect = r
		if ro and ro.animate and not reduced then
			rectAnim = { from = from, to = r, t = 0, time = ro.time or 0.24, ease = EASES[ro.ease or "quintOut"] or MapCamera.EASE.quintOut }
		else
			rectAnim = nil
			resizeTo(r)
		end
	end

	-- ------------------------------------------------------------------------------------------ switches
	function self.setTier(_: MapView, t: string)
		local nt = if t == "LOW" then "LOW" else "HIGH"
		if nt == self.tier and tileCount > 0 then return end
		self.tier = nt
		buildArt()
	end
	function self.setReduced(_: MapView, b: boolean)
		if b == reduced then return end
		reduced = b
		if b then
			flight = nil
			rectAnim = nil
			resizeTo(rect)
		end
		buildArt()
	end
	function self.setAmbient(_: MapView, on: boolean)
		if on == ambientOn then return end
		ambientOn = on
		if ambient then ambient:setPaused(not on) end
		if fields then fields:setEnabled(on) end
		for _, t in fallbackTweens do
			if on then t:Play() else t:Pause() end
		end
	end
	-- open = false while a side sheet is up: fg and motesNear fade out over 0.2 s (DESIGN.md 3.6)
	function self.setForegroundOpen(_: MapView, open: boolean)
		fgOpen = open
		if reduced then fgK = if open then 1 else 0 end
		dirty = true
	end
	function self.setRiftHover(_: MapView, on: boolean)
		if ambient then ambient:setRiftBoost(if on then 0.15 else 0) end
		local fw = fallbackWorld
		if fw and fw.core then
			Motion.tween(fw.core, TweenInfo.new(0.2), { BackgroundTransparency = if on then 0 else 0.15 }, "riftHover")
		end
	end

	-- ------------------------------------------------------------------------------------------ per frame
	local X: { [number]: number } = {}
	local Y: { [number]: number } = {}
	local function writeLayer(rec: LayerRec, zoomAlpha: number)
		local d = rec.def
		local ox, oy, s = MapCamera.layerOffset(d, C, z, V)
		local pos = UDim2.fromScale(ox / V.w, oy / V.h)
		local size = UDim2.fromScale(d.w * s / V.w, d.h * s / V.h)
		rec.sprites.Position = pos
		rec.sprites.Size = size
		local back = rec.back
		if back then
			back.Position = pos
			back.Size = size
		end
		local alpha = zoomAlpha
		local visible = alpha > 0.001
		if rec.plane.Visible ~= visible then rec.plane.Visible = visible end
		if not visible then return end
		if #rec.tiles > 0 then
			table.clear(X)
			table.clear(Y)
			MapCamera.snapEdges(rec.xs, m, ox, s, X)
			MapCamera.snapEdges(rec.ys, m, oy, s, Y)
			local writeAlpha = alpha ~= rec.alpha
			for _, t in rec.tiles do
				local x0, x1 = X[t.i + 1], X[t.i + 2]
				local y0, y1 = Y[t.j + 1], Y[t.j + 2]
				if x0 == nil or x1 == nil or y0 == nil or y1 == nil then continue end
				local on = x1 > 0 and x0 < boxW and y1 > 0 and y0 < boxH
				if t.gui.Visible ~= on then t.gui.Visible = on end
				if on then
					t.gui.Position = UDim2.fromOffset(x0, y0)
					t.gui.Size = UDim2.fromOffset(x1 - x0, y1 - y0)
				end
				if writeAlpha then t.gui.ImageTransparency = 1 - alpha end
			end
		end
		rec.alpha = alpha
	end
	local function writeColors(force: boolean)
		local moved = math.abs(w.rift - wWritten.rift) > 0.01 or math.abs(w.corrupt - wWritten.corrupt) > 0.01
		if not moved and not force then return end
		if moved then
			for _, rec in layers do
				local tint = rec.def.tint
				if tint then
					local col = rgb(MapCamera.biomeTint(tint, w))
					for _, t in rec.tiles do t.gui.ImageColor3 = col end
				end
			end
			local c, a = MapCamera.biomeWash(realm.biome.wash, w)
			wash.BackgroundColor3 = rgb(c)
			wash.BackgroundTransparency = 1 - a
		end
		local returning = wWritten.corrupt > 0 and w.corrupt == 0
		local camMoved = math.abs(C.x - lastColorCam.x) * z > 24 or math.abs(C.y - lastColorCam.y) * z > 24
			or math.abs(z - lastColorCam.z) > 0.02 * z
		if ambient and (moved or returning or (w.corrupt > 0 and camMoved) or force) then
			ambient:recolor(w, C, z, V)
			lastColorCam.x, lastColorCam.y, lastColorCam.z = C.x, C.y, z
		end
		if moved then wWritten.rift, wWritten.corrupt = w.rift, w.corrupt end
	end
	local function place()
		for _, rec in layers do
			local d = rec.def
			local a = 1
			if d.zShow > d.zHide and d.zShow > 0 then a = MapCamera.smoothstep(d.zHide, d.zShow, z) end
			if d.id == "fg" then a *= fgK end
			writeLayer(rec, a)
			if d.id == "fg" and ambient then ambient:setLayerAlpha("fg", a) end
		end
		-- Links and Nodes: the world transform
		local ox, oy = V.w / 2 - z * C.x, V.h / 2 - z * C.y
		local pos = UDim2.fromScale(ox / V.w, oy / V.h)
		local size = UDim2.fromScale(WORLD.w * z / V.w, WORLD.h * z / V.h)
		links.Position, links.Size = pos, size
		nodesF.Position, nodesF.Size = pos, size
		wTarget = MapCamera.biome(C, realm.biome, z, V)
		if fields then fields:setAlpha("motesNear", fgK) end
	end

	function self.step(_: MapView, dt: number)
		-- the Box-resize animation
		local ra = rectAnim
		if ra then
			ra.t += dt
			local u = math.clamp(ra.t / ra.time, 0, 1)
			local e = ra.ease(u)
			local to = ra.to or fullRect()
			local r = {
				x = ra.from.x + (to.x - ra.from.x) * e,
				y = ra.from.y + (to.y - ra.from.y) * e,
				w = ra.from.w + (to.w - ra.from.w) * e,
				h = ra.from.h + (to.h - ra.from.h) * e,
			}
			if u >= 1 then
				rectAnim = nil
				resizeTo(ra.to)
			else
				resizeTo(r)
			end
		end
		-- flights
		local fl = flight
		if fl then
			if fl.mode == "ease" then
				fl.t += dt
				local u = math.clamp(fl.t / fl.time, 0, 1)
				local e = fl.ease(u)
				C = { x = fl.C0.x + (fl.C.x - fl.C0.x) * e, y = fl.C0.y + (fl.C.y - fl.C0.y) * e }
				z = math.exp(math.log(fl.z0) + (math.log(fl.z) - math.log(fl.z0)) * e)
				if u >= 1 then flight = nil end
			else
				local x, vx = MapCamera.smoothDamp(C.x, fl.C.x, fl.vx, fl.smooth, dt)
				local y, vy = MapCamera.smoothDamp(C.y, fl.C.y, fl.vy, fl.smooth, dt)
				local lz, vzz = MapCamera.smoothDamp(math.log(z), math.log(fl.z), fl.vz, fl.smooth, dt)
				fl.vx, fl.vy, fl.vz = vx, vy, vzz
				C = { x = x, y = y }
				z = math.exp(lz)
				if math.abs(x - fl.C.x) < 0.05 and math.abs(y - fl.C.y) < 0.05 and math.abs(lz - math.log(fl.z)) < 1e-4 then
					C = { x = fl.C.x, y = fl.C.y }
					z = fl.z
					flight = nil
				end
			end
			applyClamp(true)
			dirty = true
		elseif not self.inputActive and rectAnim == nil then
			-- at rest outside the hard envelope (after a rubber band or a strip change): spring back
			local hard = MapCamera.clampCamera(C, z, V, false)
			if math.abs(hard.x - C.x) > 1e-3 or math.abs(hard.y - C.y) > 1e-3 or math.abs(hard.z - z) > 1e-6 then
				if reduced then
					C, z = { x = hard.x, y = hard.y }, hard.z
				else
					local st = realm.feel.rubberReturn
					local sx = spring
					local x, vx = MapCamera.smoothDamp(C.x, hard.x, sx.x, st, dt)
					local y, vy = MapCamera.smoothDamp(C.y, hard.y, sx.y, st, dt)
					local lz, vzz = MapCamera.smoothDamp(math.log(z), math.log(hard.z), sx.z, st, dt)
					sx.x, sx.y, sx.z = vx, vy, vzz
					C, z = { x = x, y = y }, math.exp(lz)
					if math.abs(x - hard.x) < 0.05 and math.abs(y - hard.y) < 0.05 and math.abs(lz - math.log(hard.z)) < 1e-4 then
						C, z = { x = hard.x, y = hard.y }, hard.z
						spring.x, spring.y, spring.z = 0, 0, 0
					end
				end
				dirty = true
			end
		end
		-- the side-sheet fade of fg and motesNear
		local fgGoal = if fgOpen then 1 else 0
		if fgK ~= fgGoal then
			fgK = if reduced then fgGoal elseif fgGoal > fgK then math.min(fgGoal, fgK + dt / 0.2) else math.max(fgGoal, fgK - dt / 0.2)
			dirty = true
		end
		local moved = dirty
		if dirty then
			place()
			dirty = false
			-- the camera on the box (world x, y and zoom): what tests and tools read to follow it
			self.box:SetAttribute("CamX", math.floor(C.x * 10 + 0.5) / 10)
			self.box:SetAttribute("CamY", math.floor(C.y * 10 + 0.5) / 10)
			self.box:SetAttribute("CamZ", math.floor(z * 1e4 + 0.5) / 1e4)
		end
		-- biome weights ease toward the camera's (tau .35 s; instant when reduced)
		local k = if reduced then 1 else 1 - math.exp(-dt / 0.35)
		local wr = w.rift + (wTarget.rift - w.rift) * k
		local wc = w.corrupt + (wTarget.corrupt - w.corrupt) * k
		if math.abs(wr - wTarget.rift) < 1e-3 then wr = wTarget.rift end
		if math.abs(wc - wTarget.corrupt) < 1e-3 then wc = wTarget.corrupt end
		w = { rift = wr, corrupt = wc, cover = wTarget.cover }
		writeColors(false)
		-- particles drift all the time
		if fields and ambientOn then fields:step(os.clock() - clock0, C, z, V, w) end
		if moved then self.cameraChanged:Fire(self:camera()) end
	end

	-- ------------------------------------------------------------------------------------------ preload
	-- the images the map draws, farthest layers first, then the atlas: Core/Preload fetches them behind the loading
	-- screen with the rest of the client's
	function self.images(_: MapView): { string }
		local list: { string } = {}
		for _, rec in layers do
			for _, t in rec.tiles do
				if t.gui.Image ~= "" then table.insert(list, t.gui.Image) end
			end
		end
		local atlas = atlasInfo()
		if atlas and atlas.id ~= "" then table.insert(list, atlas.id) end
		return list
	end

	-- a sky or world whose painted tiles have not come in after 10 s (a failed or still-moderated upload) gets the
	-- procedural look (plan 3.4), but only while NONE of its tiles has loaded: the fallback sits in the layer's own
	-- container over the tiles, so it must never cover painted art. It goes away as soon as a tile arrives (checked
	-- every 2 s for 2 minutes).
	local function watchdog()
		task.delay(10, function()
			if box.Parent == nil then return end
			local recs: { LayerRec } = {}
			if byId.sky then table.insert(recs, byId.sky) end
			if byId.world then table.insert(recs, byId.world) end
			for _, rec in recs do
				local function anyLoaded(): boolean
					for _, t in rec.tiles do
						if t.gui.Image ~= "" and t.gui.IsLoaded then return true end
					end
					return false
				end
				if #rec.tiles == 0 or anyLoaded() then continue end
				if rec.sprites:FindFirstChild("FallbackStars") or rec.sprites:FindFirstChild("FallbackWorld") then continue end
				local made: { Instance }, tweens: { Tween } = {}, {}
				if rec == byId.sky then
					made = Fallback.sky(rec.plane, rec.sprites, { w = rec.def.w, h = rec.def.h })
				else
					local fw = Fallback.world(rec.sprites, realm)
					fallbackWorld = fw
					made = fw.made
					tweens = Fallback.breathe(fw, reduced)
				end
				for _, inst in made do table.insert(fallbackMade, inst) end
				for _, t in tweens do table.insert(fallbackTweens, t) end
				dirty = true
				task.spawn(function()
					for _ = 1, 60 do
						task.wait(2)
						local first: Instance? = made[1]
						if not box.Parent or not first or not first.Parent then return end
						if anyLoaded() then
							for _, t in tweens do t:Cancel() end
							for _, inst in made do inst:Destroy() end
							if rec == byId.world then fallbackWorld = nil end
							dirty = true
							return
						end
					end
				end)
			end
		end)
	end

	function self.destroy(_: MapView)
		clearArt()
		box:Destroy()
		self.cameraChanged:DisconnectAll()
	end

	-- ------------------------------------------------------------------------------------------ start
	layoutBox(nil)
	do
		local s = MapCamera.startCamera(V) -- REALM.md 2.8: inside the world (no pan margin)
		C, z = { x = s.x, y = s.y }, s.z
	end
	buildArt()
	if tileCount > 0 then watchdog() end
	root:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if rectAnim == nil then resizeTo(rect) end
	end)
	Layout.changed:Connect(function()
		layoutBox(if rectAnim then nil else rect)
	end)
	Motion.changed:Connect(function(r: boolean)
		self:setReduced(r)
	end)
	return self
end

return MapView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="118">
            <Properties>
              <string name="Name">Markers</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Markers: the edge markers in MarkerGui (DESIGN.md 3.10). A pulse or glow node whose ring is outside the free map
	rect F gets a marker: a Ø50 (Ø38 COMPACT) emblem with a white pointer toward the node and its bolt or "!" badge,
	where the ray from F's centre crosses F inset by 14 du, pushed out of the HUD rects. At most 4, pulse first. A tap
	fires `activated` (the owner flies to the node). Pop-in: Back Out 0.2 s.

	    local markers = Markers.new(gui, view, nodes)
	    markers:update(ms)      markers:onCamera(cam)      markers.activated (layer)
	onCamera is connected to view.cameraChanged already.
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Signal = require(Core:WaitForChild("Signal"))
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Motion = require(Core:WaitForChild("Motion"))
local Kit = require(script.Parent.Parent:WaitForChild("Hud"):WaitForChild("Kit"))
local MapView = require(script.Parent:WaitForChild("MapView"))
local Nodes = require(script.Parent:WaitForChild("Nodes"))
local MapLogic = require(script.Parent:WaitForChild("MapLogic"))
local NodeWidget = require(script.Parent:WaitForChild("NodeWidget"))
local NodeAtlas = require(game:GetService("ReplicatedStorage"):WaitForChild("MilestoneTree"):WaitForChild("NodeAtlas"))

type MapState = Types.MapState
type Camera = Types.Camera
type ARect = Types.Rect

export type Markers = {
	activated: Signal.Signal<string>,
	update: (self: Markers, ms: MapState) -> (),
	onCamera: (self: Markers, cam: Camera) -> (),
	setEnabled: (self: Markers, on: boolean) -> (),
	destroy: (self: Markers) -> (),
}

local Markers = {}
local MAX = 4

type Rec = { layer: string, frame: Frame, emblem: Frame, pointer: Frame, badge: Frame, kind: string, shown: boolean }

function Markers.new(gui: ScreenGui, view: MapView.MapView, nodes: Nodes.Nodes): Markers
	local self = {} :: Markers
	self.activated = Signal.new() :: Signal.Signal<string>
	local root = gui:FindFirstChild("Root") :: Frame? or gui
	local recs: { [string]: Rec } = {}
	local want: { string } = {}
	local ms: MapState? = nil
	local enabled = true

	local function size(): number
		return if Layout.mode == "COMPACT" then 38 else 50
	end

	local function make(layer: string): Rec
		local hue = Theme.hue(layer)
		local f = Kit.frame(root, "Marker_" .. layer, 5)
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		local d = size()
		f.Size = UDim2.fromOffset(d, d)
		local pointer = Kit.frame(f, "Pointer", 1)
		pointer.AnchorPoint = Vector2.new(0.5, 0.5)
		pointer.Position = UDim2.fromScale(0.5, 0.5)
		pointer.Size = UDim2.fromScale(1.5, 1.5)
		local tip = Kit.frame(pointer, "Tip", 1)
		tip.AnchorPoint = Vector2.new(0.5, 0.5)
		tip.Position = UDim2.fromScale(0.93, 0.5)
		tip.Size = UDim2.fromScale(0.2, 0.2)
		tip.Rotation = 45
		tip.BackgroundColor3 = Color3.new(1, 1, 1)
		tip.BackgroundTransparency = 0
		Kit.corner(tip, UDim.new(0.15, 0))
		local emblem = Kit.frame(f, "Emblem", 2)
		emblem.Size = UDim2.fromScale(1, 1)
		local r0 = NodeAtlas.rects[layer]
		if NodeAtlas.id and r0 then
			-- Sleek: the layer's crystal on a small dark plate with a hue hairline (the map's own gems)
			emblem.BackgroundColor3 = Color3.fromHex("06090f")
			emblem.BackgroundTransparency = 0.15
			Kit.stroke(emblem, 1, hue, 0.35, "Line").LineJoinMode = Enum.LineJoinMode.Miter
			local im = Kit.child(emblem, "Crystal", "ImageLabel") :: ImageLabel
			im.BackgroundTransparency = 1
			im.Image = NodeAtlas.id :: string
			im.ImageRectOffset = Vector2.new(r0[1], r0[2])
			im.ImageRectSize = Vector2.new(r0[3], r0[4])
			im.AnchorPoint = Vector2.new(0.5, 0.5)
			im.Position = UDim2.fromScale(0.5, 0.5)
			im.Size = UDim2.fromScale(0.84, 0.84)
			im.ZIndex = 3
			tip.BackgroundColor3 = hue
			Kit.corner(tip, UDim.new(0, 0))
		else
			Kit.gem(emblem, hue)
		end
		if not NodeAtlas.id then Kit.stroke(emblem, 2.5, Color3.new(1, 1, 1), 0.95, "Line") end
		local sym = Kit.label(emblem, "Symbol", "badge", "", Color3.new(1, 1, 1))
		sym.Size = UDim2.fromScale(1, 1)
		sym.FontFace = Font.fromName("Sarpanch", Enum.FontWeight.Heavy)
		sym.TextXAlignment = Enum.TextXAlignment.Center
		sym.ZIndex = 3
		Kit.textStroke(sym, 2, 1)
		local text = NodeWidget.SYMS[layer] or string.upper(layer)
		if NodeAtlas.id and r0 then
			sym.Visible = false
		elseif text == "★" then
			local g = Kit.glyph(emblem, "Star", "star", Color3.new(1, 1, 1))
			g.AnchorPoint = Vector2.new(0.5, 0.5)
			g.Position = UDim2.fromScale(0.5, 0.5)
			g.Size = UDim2.fromScale(0.5, 0.5)
			g.ZIndex = 3
		else
			sym.Text = text
			sym.TextSize = math.max(13, math.floor(d * (if #text >= 3 then 0.3 elseif #text == 2 then 0.36 else 0.44)))
		end
		local badge = Kit.frame(f, "Badge", 4)
		badge.AnchorPoint = Vector2.new(0.5, 0.5)
		badge.Position = UDim2.fromScale(0.9, 0.1)
		badge.Size = UDim2.fromScale(0.38, 0.38)
		badge.BackgroundTransparency = 0
		Kit.stroke(badge, 1, Color3.fromHex("06090f"), 0.2, "Line").LineJoinMode = Enum.LineJoinMode.Miter
		local hitB = Kit.button(f, "Hit")
		hitB.Size = UDim2.new(1, 16, 1, 16)
		hitB.Position = UDim2.fromOffset(-8, -8)
		hitB.ZIndex = 10
		hitB.Activated:Connect(function()
			self.activated:Fire(layer)
		end)
		local r: Rec = { layer = layer, frame = f, emblem = emblem, pointer = pointer, badge = badge, kind = "", shown = false }
		f.Visible = false
		recs[layer] = r
		return r
	end

	local function setKind(r: Rec, kind: string)
		if r.kind == kind then return end
		r.kind = kind
		local g: Frame
		if kind == "bolt" then
			r.badge.BackgroundColor3 = Theme.C.complete
			g = Kit.glyph(r.badge, "Icon", "bolt", Color3.fromHex("2a1a00"))
		else
			-- CAN BUY: the layer hue (the ring says the rest), not an alarm red
			r.badge.BackgroundColor3 = Theme.hue(r.layer)
			g = Kit.glyph(r.badge, "Icon", "bang", Color3.fromHex("06101b"))
		end
		g.AnchorPoint = Vector2.new(0.5, 0.5)
		g.Position = UDim2.fromScale(0.5, 0.5)
		g.Size = UDim2.fromScale(0.64, 0.64)
	end

	local function layout()
		local state = ms
		local rootAbs = root.AbsolutePosition
		local s = Layout.s
		local F = Layout.free()
		local inset = 14 * s
		local used = 0
		local placed: { ARect } = {}
		for _, layer in want do
			local r = recs[layer] or make(layer)
			local on = false
			if enabled and state and used < MAX then
				local p = view:worldToAbs(nodes:worldPos(layer))
				local ex, ey = MapLogic.edgePoint(F, p.X, p.Y, inset + size() * s / 2)
				if ex and ey then
					-- push out of the HUD rects: slide toward F's centre until clear (a few steps)
					local d = size() * s
					local cx, cy = F.x + F.w / 2, F.y + F.h / 2
					local x, y = ex, ey
					for _ = 1, 12 do
						local rect = { x = x - d / 2, y = y - d / 2, w = d, h = d }
						local hitAny = false
						for _, h in Layout.rects() do
							if MapLogic.overlap(rect, h) > 0 then hitAny = true end
						end
						for _, h in placed do
							if MapLogic.overlap(rect, h) > 0 then hitAny = true end
						end
						if not hitAny then break end
						local dx, dy = cx - x, cy - y
						local len = math.max(1, math.sqrt(dx * dx + dy * dy))
						x += dx / len * d * 0.6
						y += dy / len * d * 0.6
					end
					table.insert(placed, { x = x - d / 2, y = y - d / 2, w = d, h = d })
					r.frame.Position = UDim2.fromOffset((x - rootAbs.X) / s, (y - rootAbs.Y) / s)
					r.pointer.Rotation = math.deg(math.atan2(p.Y - y, p.X - x))
					on = true
					used += 1
				end
			end
			if on ~= r.shown then
				r.shown = on
				r.frame.Visible = on
				if on then Motion.pop(r.frame) end
			end
		end
		for layer, r in recs do
			if r.shown and not table.find(want, layer) then
				r.shown = false
				r.frame.Visible = false
			end
		end
	end

	function self.update(_: Markers, newMs: MapState)
		ms = newMs
		want = MapLogic.markerCandidates(newMs, 21)
		for _, layer in want do
			local r = recs[layer] or make(layer)
			setKind(r, if table.find(newMs.ready, layer) then "bolt" else "bang")
		end
		layout()
	end
	function self.onCamera(_: Markers, _cam: Camera)
		layout()
	end
	function self.setEnabled(_: Markers, on: boolean)
		enabled = on
		layout()
	end
	local conns: { any } = {}
	table.insert(conns, view.cameraChanged:Connect(function(c: Camera) self:onCamera(c) end))
	table.insert(conns, Layout.rectsChanged:Connect(function() task.defer(layout) end))
	table.insert(conns, Layout.changed:Connect(function()
		for _, r in recs do
			local d = size()
			r.frame.Size = UDim2.fromOffset(d, d)
		end
		task.defer(layout)
	end))
	function self.destroy(m: Markers)
		for _, c in conns do c:Disconnect() end
		for _, r in recs do r.frame:Destroy() end
		m.activated:DisconnectAll()
	end
	return self
end

return Markers
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="119">
            <Properties>
              <string name="Name">NodeWidget</string>
              <string name="Source"><![CDATA[--!strict
--[[
	NodeWidget: one map node's instance tree (DESIGN.md 3.7, Figma Map Node 4:40). The widget sits in view.nodes at
	its socket in Scale units of the world (x / 3840, y / 2560), so it zooms with the map; below the floor zoom
	(36 / 132 mouse, 44 / 132 touch) its UIScale holds the ring at the floor size.

	    Node_<id>  Frame 200 x 200 world px, centred on the socket          attribute State (test anchor)
	      Floor    UIScale  max(1, k / z)
	      Body     Frame (+ UIScale Hover: 1.08 hover, .94 press)
	        Glow   soft round glow 2 x the ring, hue (alpha .45; .9 pulse / selected)
	        Ring   Frame 132, 135 deg gradient lift / hue / shade
	          Gem  Frame 104, radial gem, Shine ellipse, Symbol (Sarpanch Heavy; the star glyph for ach)
	      Hit      ImageButton over the ring (InputSink None: the map drag still sees the press)
	    lazy, created on first need and then toggled: Rays, Aura, Select, ChalRing (+ chip), Badge, Lock

	Strokes and the symbol size are pixels, so setZoom(z, m) rewrites them when the zoom moves (Nodes calls it).

	    local w = NodeWidget.new(parent, layer, worldPos)
	    w:update(node, state, flags)     state: sealed | frontier | dormant | locked | available | glow | pulse
	    w:setZoom(z, m, floorK)          w:setHover(b)   w:setPress(b)   w:setRays(b)
	    w.frame, w.hit, w.ring, w.state
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Theme = require(Core:WaitForChild("Theme"))
local Motion = require(Core:WaitForChild("Motion"))
local Layout = require(Core:WaitForChild("Layout"))
local Recipes = require(Core:WaitForChild("Recipes"))
local Kit = require(script.Parent.Parent:WaitForChild("Hud"):WaitForChild("Kit"))
local NodeAtlas = require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("NodeAtlas"))

type MapNode = Types.MapNode

export type Flags = { selected: boolean, challenge: boolean, infected: boolean }
export type NodeWidget = {
	layer: string,
	frame: Frame,
	body: Frame,
	ring: Frame,
	hit: ImageButton,
	state: string,
	flags: Flags,
	update: (self: NodeWidget, node: MapNode?, state: string, flags: Flags) -> (),
	setSelected: (self: NodeWidget, b: boolean) -> (),
	setFloor: (self: NodeWidget, k: number) -> (),
	setZoom: (self: NodeWidget, z: number, m: number, k: number) -> (),
	setRays: (self: NodeWidget, on: boolean) -> (),
	setHover: (self: NodeWidget, on: boolean) -> (),
	setPress: (self: NodeWidget, on: boolean) -> (),
	setPeek: (self: NodeWidget, on: boolean) -> (),
	destroy: (self: NodeWidget) -> (),
}

local NodeWidget = {}

local W = 200 -- the frame, world px
local RING, GEM = 132, 104
local function sc(px: number): number
	return px / W
end

-- symbols of the sockets whose node the view does not send (hidden nodes)
NodeWidget.SYMS = {
	ach = "★", m = "M", mm = "MM", em = "EM", p = "P", pe = "PE", sp = "SP", pb = "PB", pp = "PP", se = "SE", hp = "HP",
	ep = "EP", hb = "HB", ap = "AP", mp = "MP", t = "T", pm = "PM", pep = "PEP", cp = "CR", cm = "CM", ex = "EX",
} :: { [string]: string }

-- the crystal node (art/ui/clean lib.js drawNode, approved): a Blender gem from the node atlas inside an energy ring
-- whose state is a function of time. Without an atlas id the drawn discs below stay.
local ATLAS: string? = NodeAtlas.id
local RING_IMG = RING / (2 * NodeAtlas.ringR) -- the ring sprite's size (world px) that puts its ring on the socket
local CRYSTAL = 128
local LOCK_RING = Color3.fromHex("a39cb3")
local function frac(x: number): number return x - math.floor(x) end
local function hash(i: number): number return frac(math.sin(i * 12.9898 + 78.233) * 43758.5453) end
local function smooth(x: number): number return x * x * (3 - 2 * x) end
-- the CAN BUY flicker: value noise at 13 Hz with occasional dips
local function flicker(t: number): number
	local f = t * 13
	local i = math.floor(f)
	local v = hash(i) + (hash(i + 1) - hash(i)) * smooth(f - i)
	local dip = if hash(math.floor(t * 5.3) + 31) < 0.22 then 0.55 else 1
	return (0.62 + 0.38 * v) * dip
end
NodeWidget.flicker = flicker

local GREY_RING = { Color3.fromHex("898598"), Color3.fromHex("4a4360"), Color3.fromHex("1e1b26") }
local GREY_GEM = Color3.fromHex("3a3352")
local GOLD = Color3.fromHex("ffc233")
local INK = Color3.fromHex("2a1a00")

local function ringGradient(ring: Frame, top: Color3, mid: Color3, bottom: Color3)
	Kit.grad(ring, { top, top, mid, bottom, bottom }, 135, nil, nil, { 0, 0.1, 0.5, 0.9, 1 })
end

function NodeWidget.new(parent: Frame, layer: string, pos: Vector2): NodeWidget
	local f = Kit.frame(parent, "Node_" .. layer)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(pos.X / 3840, pos.Y / 2560)
	f.Size = UDim2.fromScale(W / 3840, W / 2560)
	f:SetAttribute("State", "sealed")
	f:SetAttribute("Layer", layer)
	local floor = Kit.child(f, "Floor", "UIScale") :: UIScale
	floor.Scale = 1

	local body = Kit.frame(f, "Body")
	body.AnchorPoint = Vector2.new(0.5, 0.5)
	body.Position = UDim2.fromScale(0.5, 0.5)
	body.Size = UDim2.fromScale(1, 1)
	local hover = Kit.child(body, "Hover", "UIScale") :: UIScale
	hover.Scale = 1

	local ring = Kit.frame(body, "Ring", 4)
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = UDim2.fromScale(0.5, 0.5)
	ring.Size = UDim2.fromScale(sc(RING), sc(RING))
	ring.BackgroundColor3 = Color3.new(1, 1, 1)
	ring.BackgroundTransparency = 0
	Kit.corner(ring)
	local rim = Kit.stroke(ring, 1, Color3.new(0, 0, 0), 0.55, "Rim")

	local gem = Kit.frame(ring, "Gem", 5)
	gem.AnchorPoint = Vector2.new(0.5, 0.5)
	gem.Position = UDim2.fromScale(0.5, 0.5)
	gem.Size = UDim2.fromScale(GEM / RING, GEM / RING)
	local gemStroke = Kit.stroke(gem, 2, Color3.new(0, 0, 0), 1, "GemStroke")

	local shine = Kit.frame(gem, "Shine", 6)
	shine.AnchorPoint = Vector2.new(0.5, 0.5)
	shine.Position = UDim2.fromScale(0.5, 0.5 - 31 / GEM)
	shine.Size = UDim2.fromScale(60 / GEM, 26 / GEM)
	shine.BackgroundColor3 = Color3.new(1, 1, 1)
	shine.BackgroundTransparency = 0
	Kit.corner(shine)
	Kit.grad(shine, { Color3.new(1, 1, 1) }, 90, { { 0, 0.55 }, { 1, 0 } })

	local symbol = Kit.label(gem, "Symbol", "index", "", Color3.new(1, 1, 1))
	symbol.AnchorPoint = Vector2.new(0.5, 0.5)
	symbol.Position = UDim2.fromScale(0.5, 0.52)
	symbol.Size = UDim2.fromScale(1, 1)
	symbol.ZIndex = 7
	symbol.TextXAlignment = Enum.TextXAlignment.Center
	symbol.TextYAlignment = Enum.TextYAlignment.Center
	symbol.FontFace = Font.fromName("Sarpanch", Enum.FontWeight.Heavy)
	symbol.LineHeight = 1
	local symStroke = Kit.textStroke(symbol, 3, 1) :: UIStroke

	local hit = Kit.child(f, "Hit", "ImageButton") :: ImageButton
	hit.AnchorPoint = Vector2.new(0.5, 0.5)
	hit.Position = UDim2.fromScale(0.5, 0.5)
	hit.Size = UDim2.fromScale(sc(RING), sc(RING))
	hit.BackgroundTransparency = 1
	hit.ImageTransparency = 1
	hit.Image = ""
	hit.AutoButtonColor = false
	hit.BorderSizePixel = 0
	hit.ZIndex = 20
	hit.Selectable = false
	Kit.corner(hit)
	if Theme.caps.InputSink then
		pcall(function() (hit :: any).InputSink = (Enum :: any).InputSink.None end)
	end

	-- crystal parts (made on first use): Pool (light in the socket), Halo (soft ring), Crystal (the gem), Energy (the
	-- ring's core line), Comet (CAN BUY), Ripple (READY)
	local cr: { [string]: ImageLabel }? = nil
	local crMode = "" -- the ring state the loop animates: locked | idle | buy | ready | "" (off)
	local crHue = Color3.new(1, 1, 1)
	local phase = hash(#layer * 7 + string.byte(layer, 1)) * 6
	local function atlasImage(name: string, key: string, size: number, z: number): ImageLabel
		local im = Kit.child(body, name, "ImageLabel") :: ImageLabel
		im.BackgroundTransparency = 1
		im.BorderSizePixel = 0
		im.Active = false
		im.Image = ATLAS or ""
		im.AnchorPoint = Vector2.new(0.5, 0.5)
		im.Position = UDim2.fromScale(0.5, 0.5)
		im.Size = UDim2.fromScale(sc(size), sc(size))
		im.ZIndex = z
		local r = NodeAtlas.rects[key]
		im.ImageRectOffset = Vector2.new(r[1], r[2])
		im.ImageRectSize = Vector2.new(r[3], r[4])
		return im
	end
	local function crystalParts(): { [string]: ImageLabel }
		local c = cr
		if c then return c end
		local made = {
			Pool = atlasImage("Pool", "disc", 150, 2),
			Halo = atlasImage("Halo", "glow", RING_IMG, 3),
			Crystal = atlasImage("Crystal", layer, CRYSTAL, 5),
			Energy = atlasImage("Energy", "ring", RING_IMG, 6),
			Comet = atlasImage("Comet", "comet", RING_IMG, 7),
			Ripple = atlasImage("Ripple", "ring", RING_IMG, 6),
		}
		cr = made
		-- the ring's life: every state is a function of time (reduced motion holds a still frame)
		Motion.loop(f, function()
			local p = made
			if crMode == "" then return end
			local t = if Motion.reduced() then 1.5 else Motion.now() + phase
			local hue = crHue
			local core, glow, pool = 0.34, 0, 0
			p.Comet.Visible = crMode == "buy"
			p.Ripple.Visible = crMode == "ready"
			if crMode == "locked" then
				core = 0.34
			elseif crMode == "idle" then
				local q = 0.5 + 0.5 * math.sin(t / 3 * math.pi * 2)
				core, glow, pool = 0.62 + 0.28 * q, 0.16 + 0.34 * q, 0.1 + 0.08 * q
			elseif crMode == "buy" then
				local fl = flicker(t)
				core, glow, pool = 0.5 + 0.3 * fl, 0.14 + 0.3 * fl, 0.16 + 0.12 * fl
				p.Comet.Rotation = (t / 1.5) * 360 % 360
				p.Comet.ImageTransparency = 1 - (0.6 + 0.4 * fl)
			else
				local ph = frac(t)
				local q = math.exp(-3.2 * ph)
				core, glow, pool = 0.88 + 0.12 * q, 0.45 + 0.5 * q, 0.28 + 0.3 * q
				local k = 1 + 0.42 * smooth(math.min(1, ph * 1.15))
				p.Ripple.Size = UDim2.fromScale(sc(RING_IMG * k), sc(RING_IMG * k))
				p.Ripple.ImageTransparency = 1 - 0.8 * (1 - ph) ^ 2
			end
			p.Energy.ImageTransparency = 1 - core
			p.Halo.ImageTransparency = 1 - math.min(1, glow)
			p.Pool.ImageTransparency = 1 - pool
			local _ = hue
		end)
		return made
	end
	local function setCrystal(mode: string, hue: Color3, locked: boolean)
		if mode == "" then
			crMode = ""
			local c = cr
			if c then
				for _, im in c do im.Visible = false end
			end
			return
		end
		local p = crystalParts()
		crMode = mode
		crHue = hue
		local key = if locked then layer .. "_locked" else layer
		local r = NodeAtlas.rects[key] or NodeAtlas.rects[layer]
		if r then
			p.Crystal.ImageRectOffset = Vector2.new(r[1], r[2])
			p.Crystal.ImageRectSize = Vector2.new(r[3], r[4])
		end
		p.Crystal.Visible = true
		p.Crystal.ImageTransparency = if mode == "locked" then 0.1 else 0
		p.Energy.Visible = true
		p.Energy.ImageColor3 = if mode == "locked" then LOCK_RING else Theme.lift(hue, if mode == "ready" then 0.7 else 0.4)
		p.Halo.Visible = mode ~= "locked"
		p.Halo.ImageColor3 = hue
		p.Pool.Visible = mode ~= "locked"
		p.Pool.ImageColor3 = hue
		p.Comet.ImageColor3 = Theme.lift(hue, 0.55)
		p.Ripple.ImageColor3 = Theme.lift(hue, 0.55)
		p.Comet.Visible = mode == "buy"
		p.Ripple.Visible = mode == "ready"
		if Motion.reduced() or Motion.snapshot() then
			-- one still frame now (the loop keeps it; snapshots are deterministic)
			p.Energy.ImageTransparency = if mode == "locked" then 0.66 else 0.2
			p.Halo.ImageTransparency = if mode == "ready" then 0.2 else 0.6
		end
	end

	local self = {} :: NodeWidget
	self.layer = layer
	self.frame = f
	self.body = body
	self.ring = ring
	self.hit = hit
	self.state = "sealed"
	self.flags = { selected = false, challenge = false, infected = false }

	-- zoom-dependent pixel sizes
	local pz = 0.5 -- device px per world px (z * m)
	local symSize = 44
	local symText = ""
	local isStar = false
	local compact = Layout.mode == "COMPACT"
	local raysOn = false
	local hovered, pressed, peeked = false, false, false
	local lastSel = false

	-- lazy parts
	local glow: Frame? = nil
	local rays: Frame? = nil
	local aura: Frame? = nil
	local select: Frame? = nil
	local chal: Frame? = nil
	local chalChip: Frame? = nil
	local badge: Frame? = nil
	local badgeKind = ""
	local lock: Frame? = nil

	local function writeZoomed()
		local bd = badge
		if bd then
			local sz = math.max(8, math.floor(math.min((if compact then 22 else 26) * Layout.s, RING * pz * floor.Scale * 0.4) + 0.5))
			bd.Size = UDim2.fromOffset(sz, sz)
		end
		symbol.TextSize = math.clamp(math.floor(symSize * pz + 0.5), 1, 100)
		symStroke.Thickness = math.max(1, 4 * pz * 0.8)
		rim.Thickness = math.max(1, 2 * pz)
		gemStroke.Thickness = math.max(1, 3 * pz)
		local s = select
		if s then
			local st = s:FindFirstChild("Line") :: UIStroke?
			if st then st.Thickness = math.max(1.5, 3.5 * pz) end
		end
		local c = chal
		if c then
			local st = c:FindFirstChild("Line") :: UIStroke?
			if st then st.Thickness = math.max(1.5, 3 * pz) end
		end
	end

	local function setSymbol(text: string, color: Color3, a: number)
		local star = text == "★"
		if star ~= isStar then
			isStar = star
			local g = gem:FindFirstChild("Star")
			if g then g:Destroy() end
		end
		if star then
			symbol.Text = ""
			local g = Kit.glyph(gem, "Star", "star", color)
			g.AnchorPoint = Vector2.new(0.5, 0.5)
			g.Position = UDim2.fromScale(0.5, 0.5)
			g.Size = UDim2.fromScale(0.5, 0.5)
			g.ZIndex = 7
			for _, c in g:GetDescendants() do
				if c:IsA("GuiObject") then
					c.ZIndex = 7
					c.BackgroundTransparency = 1 - a
				end
			end
			return
		end
		if text ~= symText then
			symText = text
			local n = utf8.len(text) or #text
			symSize = if n <= 1 then 44 elseif n == 2 then 40.5 else 31.7
			symbol.Text = text
			writeZoomed()
		end
		symbol.TextColor3 = color
		symbol.TextTransparency = 1 - a
		symStroke.Transparency = 1 - a
	end

	local function ensureGlow(): Frame?
		if glow == nil then
			glow = Kit.blob(body, "Glow", Color3.new(1, 1, 1), 1, 1)
			local g = glow
			if g then
				g.AnchorPoint = Vector2.new(0.5, 0.5)
				g.Position = UDim2.fromScale(0.5, 0.5)
				g.Size = UDim2.fromScale(sc(2 * RING), sc(2 * RING))
			end
		end
		return glow
	end
	local function setGlow(c: Color3?, alpha: number)
		if c == nil or alpha <= 0 then
			if glow then (glow :: Frame).Visible = false end
			return
		end
		local g = ensureGlow()
		if g == nil then return end
		g.Visible = true
		g.BackgroundColor3 = c
		g.BackgroundTransparency = 1 - alpha
		local grad = g:FindFirstChild("Radial") :: UIGradient?
		if grad then grad.Color = ColorSequence.new(c) end
	end

	local function setAura(c: Color3?, breathe: boolean)
		if c == nil then
			if aura then
				Kit.still(aura :: Frame);
				(aura :: Frame).Visible = false
			end
			return
		end
		if aura == nil then
			aura = Kit.blob(body, "Aura", c, 0.7, 2)
			local a = aura
			if a then
				a.AnchorPoint = Vector2.new(0.5, 0.5)
				a.Position = UDim2.fromScale(0.5, 0.5)
				a.Size = UDim2.fromScale(sc(220), sc(220))
			end
		end
		local a = aura
		if a == nil then return end
		a.Visible = true
		a.BackgroundColor3 = c
		local grad = a:FindFirstChild("Radial") :: UIGradient?
		if grad then grad.Color = ColorSequence.new(c) end
		if breathe then
			Kit.breathe(a, "BackgroundTransparency", 0, 0.45, 1.2)
		else
			Kit.still(a)
			a.BackgroundTransparency = 0.2
		end
	end

	local function setRaysVisible(c: Color3?)
		if c == nil then
			if rays then
				Kit.unspin(rays :: Frame);
				(rays :: Frame).Visible = false
			end
			return
		end
		if rays == nil then
			local r = Kit.frame(body, "Rays", 1)
			r.AnchorPoint = Vector2.new(0.5, 0.5)
			r.Position = UDim2.fromScale(0.5, 0.5)
			r.Size = UDim2.fromScale(sc(300), sc(300))
			for i = 0, 5 do
				local b = Kit.frame(r, "Ray" .. i)
				b.AnchorPoint = Vector2.new(0.5, 0.5)
				b.Position = UDim2.fromScale(0.5, 0.5)
				b.Size = UDim2.fromScale(1, 0.07)
				b.Rotation = i * 30
				b.BackgroundColor3 = Color3.new(1, 1, 1)
				b.BackgroundTransparency = 0
				Kit.corner(b)
				Kit.grad(b, { Color3.new(1, 1, 1) }, 0, { { 0, 0 }, { 0.3, 0.3 }, { 0.5, 0.9 }, { 0.7, 0.3 }, { 1, 0 } })
			end
			rays = r
		end
		local r = rays :: Frame
		r.Visible = true
		for _, b in r:GetChildren() do
			if b:IsA("Frame") then
				b.BackgroundColor3 = c
				b.BackgroundTransparency = 0.45
			end
		end
		Kit.spin(r, 12)
	end

	local function dashedRing(name: string, d: number, color: Color3, seconds: number, dir: number): Frame
		local fr = Kit.frame(body, name, 3)
		fr.AnchorPoint = Vector2.new(0.5, 0.5)
		fr.Position = UDim2.fromScale(0.5, 0.5)
		fr.Size = UDim2.fromScale(sc(d), sc(d))
		Kit.corner(fr)
		local st = Kit.stroke(fr, 3, color, 1, "Line")
		Recipes.dashed(st, { color = color, alpha = 0.95 })
		Kit.spin(fr, seconds, dir)
		return fr
	end

	local function badgeSize(): number
		-- never more than 40 % of the ring as drawn (a zoomed-out map would otherwise get badges bigger than its gems)
		local ringPx = RING * pz * floor.Scale
		return math.max(8, math.floor(math.min((if compact then 22 else 26) * Layout.s, ringPx * 0.4) + 0.5))
	end
	local function setBadge(kind: string?)
		if kind == nil then
			if badge then (badge :: Frame).Visible = false end
			badgeKind = ""
			return
		end
		if badge == nil then
			local b = Kit.frame(body, "Badge", 9)
			b.AnchorPoint = Vector2.new(0.5, 0.5)
			b.Position = UDim2.fromScale(0.5 + 0.72 * sc(RING / 2), 0.5 - 0.72 * sc(RING / 2))
			b.BackgroundTransparency = 0
			Kit.corner(b)
			Kit.stroke(b, 2, Color3.new(1, 1, 1), 1, "Line")
			badge = b
		end
		local b = badge :: Frame
		local size = badgeSize()
		b.Size = UDim2.fromOffset(size, size)
		local line = b:FindFirstChild("Line") :: UIStroke?
		if line then line.Thickness = math.max(1.5, size / 13) end
		if kind ~= badgeKind then
			local fresh = badgeKind == "" or not b.Visible
			badgeKind = kind
			local g: Frame
			if kind == "bolt" then
				b.BackgroundColor3 = GOLD
				Kit.grad(b, { Color3.fromHex("ffe89a"), GOLD, Color3.fromHex("c98a12") }, 90)
				g = Kit.glyph(b, "Icon", "bolt", INK)
			elseif kind == "bang" then
				b.BackgroundColor3 = Theme.C.danger
				Kit.grad(b, { Theme.lift(Theme.C.danger, 0.25), Theme.C.danger, Theme.shade(Theme.C.danger, 0.7) }, 90)
				g = Kit.glyph(b, "Icon", "bang", Color3.new(1, 1, 1))
			else
				b.BackgroundColor3 = Theme.C.panel2
				Kit.grad(b, { Theme.C.panel3, Theme.C.panel2 }, 90)
				g = Kit.glyph(b, "Icon", "moon", Color3.fromHex("c9c3e6"), Theme.C.panel2)
			end
			g.AnchorPoint = Vector2.new(0.5, 0.5)
			g.Position = UDim2.fromScale(0.5, 0.5)
			g.Size = UDim2.fromScale(0.62, 0.62)
			b.Visible = true
			if fresh then Motion.pop(b) end
		end
		b.Visible = true
	end

	local function setLock(on: boolean)
		if not on then
			if lock then (lock :: Frame).Visible = false end
			return
		end
		if lock == nil then
			local l = Kit.frame(body, "Lock", 9)
			l.AnchorPoint = Vector2.new(0.5, 0.5)
			l.Position = UDim2.fromScale(0.5 + 0.62 * sc(RING / 2), 0.5 + 0.62 * sc(RING / 2))
			l.BackgroundColor3 = Theme.C.deep
			l.BackgroundTransparency = 0.15
			Kit.corner(l)
			local g = Kit.glyph(l, "Icon", "lock", GOLD, Theme.C.deep)
			g.AnchorPoint = Vector2.new(0.5, 0.5)
			g.Position = UDim2.fromScale(0.5, 0.5)
			g.Size = UDim2.fromScale(0.64, 0.64)
			lock = l
		end
		local l = lock :: Frame
		local size = math.floor((if compact then 19 else 22) * Layout.s + 0.5)
		l.Size = UDim2.fromOffset(size, size)
		l.Visible = true
	end

	local function setSelectRing(c: Color3?)
		if c == nil then
			if select then
				Kit.unspin(select :: Frame);
				(select :: Frame).Visible = false
			end
			return
		end
		if select == nil then
			select = dashedRing("Select", 164, c, 20, 1)
		else
			local s = select :: Frame
			s.Visible = true
			local st = s:FindFirstChild("Line") :: UIStroke?
			if st then Recipes.dashed(st, { color = c, alpha = 0.95 }) end
			Kit.spin(s, 20, 1)
		end
		writeZoomed()
	end

	local function setChallenge(id: number?)
		if id == nil then
			if chal then
				Kit.unspin(chal :: Frame);
				(chal :: Frame).Visible = false
			end
			if chalChip then (chalChip :: Frame).Visible = false end
			return
		end
		if chal == nil then
			chal = dashedRing("ChalRing", 150, GOLD, 14, -1)
		else
			(chal :: Frame).Visible = true
			Kit.spin(chal :: Frame, 14, -1)
		end
		local chip, l = Kit.chip(body, "ChalChip", "badge", "C" .. tostring(id), { h = math.floor(22 * Layout.s), pad = 7,
			fg = INK, bg = GOLD, bgA = 1 })
		chip.AnchorPoint = Vector2.new(0.5, 0.5)
		chip.Position = UDim2.fromScale(0.5 - 0.7 * sc(RING / 2), 0.5 + 0.7 * sc(RING / 2))
		chip.ZIndex = 9
		l.ZIndex = 9
		l.TextSize = math.floor(Theme.size("badge") * Layout.s + 0.5)
		chip.Visible = true
		chalChip = chip
		writeZoomed()
	end

	local function applyHover()
		local target = if pressed then 0.94 elseif peeked then 1.25 elseif hovered then 1.08 else 1
		local t = if pressed then 0.08 else 0.12
		if Motion.reduced() and target ~= 1 and not pressed then target = 1.04 end
		Motion.tween(hover, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = target }, "nodeHover_" .. layer)
	end

	function self.update(w: NodeWidget, node: MapNode?, state: string, flags: Flags)
		w.state = state
		w.flags = flags
		f:SetAttribute("State", state)
		f:SetAttribute("Selected", flags.selected)
		compact = Layout.mode == "COMPACT"
		local hue = Theme.hue(layer)
		if flags.infected then hue = Theme.C.danger end
		local sym = (node and node.sym) or NodeWidget.SYMS[layer] or string.upper(layer)
		if sym == "" then sym = NodeWidget.SYMS[layer] or "?" end

		local crystalState = if ATLAS == nil then nil
			elseif state == "locked" or state == "dormant" then "locked"
			elseif state == "available" then "idle"
			elseif state == "glow" then "buy"
			elseif state == "pulse" then "ready"
			else nil
		if crystalState then
			-- the crystal node: no drawn disc or letters (the nameplate names it); the ring says the state
			ring.Visible = false
			setCrystal(crystalState, hue, crystalState == "locked")
			setGlow(nil, 0)
			setBadge(if state == "pulse" then "bolt" elseif state == "dormant" then "moon" else nil)
			setLock(false) -- the grey gem and ring say it
			hit.Visible = true
		else
			setCrystal("", hue, false)
		end
		if crystalState then
			-- (drawn below: rays, aura, selection, challenge)
		elseif state == "sealed" or state == "frontier" then
			ring.Visible = true
			ring.BackgroundTransparency = 1
			rim.Transparency = 1
			Kit.gem(gem, Theme.C.deep, { flat = true })
			Kit.grad(gem, { Theme.C.panel2, Theme.C.deep }, 90, nil, "Gem")
			gem.BackgroundTransparency = if state == "frontier" then 0 else 0.3
			gemStroke.Color = if state == "frontier" then Theme.C.strokeHi else Theme.C.stroke
			gemStroke.Transparency = if state == "frontier" then 0 else 0.4
			shine.Visible = false
			if state == "frontier" then
				setSymbol("?", Color3.fromHex("8d86a8"), 1)
			else
				setSymbol("", Color3.new(1, 1, 1), 0)
			end
			setGlow(nil, 0)
			setBadge(nil)
			setLock(false)
			hit.Visible = state == "frontier"
		elseif state == "dormant" then
			ring.Visible = true
			ring.BackgroundTransparency = 0.2
			rim.Transparency = 0.55
			ringGradient(ring, GREY_RING[1], GREY_RING[2], GREY_RING[3])
			Kit.gem(gem, Color3.fromHex("2a2540"), { hi = 0.25, lo = 0.5 })
			gem.BackgroundTransparency = 0.2
			gemStroke.Color = Theme.C.stroke
			gemStroke.Transparency = 0.3
			shine.Visible = false
			setSymbol(sym, Color3.fromHex("5b5572"), 1)
			setGlow(nil, 0)
			setBadge("moon")
			setLock(false)
			hit.Visible = true
		elseif state == "locked" then
			ring.Visible = true
			ring.BackgroundTransparency = 0
			rim.Transparency = 0.45
			ringGradient(ring, GREY_RING[1], GREY_RING[2], GREY_RING[3])
			Kit.gem(gem, GREY_GEM, { hi = 0.18, lo = 0.4 })
			gem.BackgroundTransparency = 0
			gemStroke.Color = Theme.C.panel
			gemStroke.Transparency = 0.2
			shine.Visible = true
			shine.BackgroundTransparency = 0.6
			setSymbol(sym, Theme.C.lockedTitle, 1)
			setGlow(nil, 0)
			setBadge(nil)
			setLock(true)
			hit.Visible = true
		else
			ring.Visible = true
			ring.BackgroundTransparency = 0
			rim.Transparency = 0.5
			ringGradient(ring, Theme.lift(hue, 0.35), hue, Theme.shade(hue, 0.4))
			Kit.gem(gem, hue)
			gem.BackgroundTransparency = 0
			gemStroke.Color = Theme.shade(hue, 0.28)
			gemStroke.Transparency = 0
			shine.Visible = true
			shine.BackgroundTransparency = 0
			setSymbol(sym, Color3.new(1, 1, 1), 1)
			local strong = state == "pulse" or flags.selected
			setGlow(hue, if strong then 0.9 else 0.45)
			setBadge(if state == "pulse" then "bolt" elseif state == "glow" then "bang" else nil)
			setLock(false)
			hit.Visible = true
		end

		local live = state == "available" or state == "glow" or state == "pulse" or state == "locked"
		-- rays: pulse only, and at most 4 at once (Nodes decides through setRays); the crystal ring replaces both
		setRaysVisible(if raysOn and state == "pulse" and not crystalState then hue else nil)
		setAura(if live and not crystalState and (state == "pulse" or flags.selected) then hue else nil, state == "pulse")
		setSelectRing(if flags.selected then Theme.lift(hue, 0.3) else nil)
		setChallenge(if live and node and node.ch then node.ch else nil)
		if flags.selected ~= lastSel then lastSel = flags.selected end
	end

	function self.setSelected(w: NodeWidget, b: boolean)
		local fl = table.clone(w.flags)
		fl.selected = b
		w:update(nil, w.state, fl)
	end
	function self.setFloor(_: NodeWidget, k: number)
		floor.Scale = k
	end
	function self.setZoom(_: NodeWidget, z: number, m: number, k: number)
		pz = z * m
		local fs = math.max(1, k / math.max(z, 1e-3))
		if math.abs(floor.Scale - fs) > 1e-3 then floor.Scale = fs end
		writeZoomed()
	end
	function self.setRays(w: NodeWidget, on: boolean)
		if on == raysOn then return end
		raysOn = on
		local hue = if w.flags.infected then Theme.C.danger else Theme.hue(layer)
		setRaysVisible(if on and w.state == "pulse" and ATLAS == nil then hue else nil)
	end
	function self.setHover(_: NodeWidget, on: boolean)
		if on == hovered then return end
		hovered = on
		applyHover()
	end
	function self.setPress(_: NodeWidget, on: boolean)
		if on == pressed then return end
		pressed = on
		applyHover()
	end
	function self.setPeek(_: NodeWidget, on: boolean)
		if on == peeked then return end
		peeked = on
		applyHover()
	end
	function self.destroy(w: NodeWidget)
		for _, inst in { rays, aura, select, chal } :: { Frame? } do
			if inst then
				Kit.unspin(inst)
				Kit.still(inst)
			end
		end
		w.frame:Destroy()
	end
	writeZoomed()
	return self
end

return NodeWidget
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="120">
            <Properties>
              <string name="Name">Nodes</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Nodes: the 21 layer node widgets on the map plus the rift hotspot (DESIGN.md 3.7, 3.11): the state machine of
	sealed / frontier / dormant / locked / available / glow / pulse (+ selected, challenge, infected), taps (never
	after a drag, 300 ms double-click debounce), long-press / right-click peek and hover, and the first-run cue.

	    local nodes = Nodes.new(view, mapInput)
	    nodes:update(ms)                  a new MapState (ViewStore:map())
	    nodes:setSelected(layer?)         the open panel's node (overrides ms.open while set)
	    nodes:setFirstRun(b)              the START HERE cue above M (DESIGN.md 7.12)
	    nodes:setPeek(layer?)             the peeked node grows x1.25
	    nodes.activated (layer), nodes.peek (layer), nodes.hover (layer?, abs), nodes.rift (event, abs)
	    nodes:ringRect(layer), nodes:plateRect(layer), nodes:worldPos(layer), nodes:state(layer), nodes:widget(layer)

	Widgets live in view.nodes (the world transform: Position = fromScale(x / 3840, y / 2560)); every widget sets
	the attribute State (plan D16 test anchors). Art socket keys: the game id cp is the socket cr (Realm.alias).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Signal = require(Core:WaitForChild("Signal"))
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Motion = require(Core:WaitForChild("Motion"))
local Rich = require(Core:WaitForChild("Rich"))
local Input = require(script.Parent.Parent:WaitForChild("Input"):WaitForChild("Input"))
local Kit = require(script.Parent.Parent:WaitForChild("Hud"):WaitForChild("Kit"))
local MapView = require(script.Parent:WaitForChild("MapView"))
local MapInput = require(script.Parent:WaitForChild("MapInput"))
local MapLogic = require(script.Parent:WaitForChild("MapLogic"))
local NodeWidget = require(script.Parent:WaitForChild("NodeWidget"))

type MapState = Types.MapState
type ARect = Types.Rect
type Camera = Types.Camera

export type Nodes = {
	activated: Signal.Signal<string>,
	peek: Signal.Signal<string>,
	hover: Signal.Signal<string?, Vector2>,
	rift: Signal.Signal<string, Vector2>, -- "hover" | "leave" | "click"
	changed: Signal.Signal<>, -- after update (states, selection) moved
	update: (self: Nodes, ms: MapState) -> (),
	setSelected: (self: Nodes, layer: string?) -> (),
	setFirstRun: (self: Nodes, b: boolean) -> (),
	setPeek: (self: Nodes, layer: string?) -> (),
	ringRect: (self: Nodes, layer: string) -> ARect?,
	plateRect: (self: Nodes, layer: string) -> ARect?,
	setPlateRect: (self: Nodes, layer: string, r: ARect?) -> (),
	worldPos: (self: Nodes, layer: string) -> Vector2,
	state: (self: Nodes, layer: string) -> string,
	rank: (self: Nodes, layer: string) -> number,
	selected: (self: Nodes) -> string?,
	hovered: (self: Nodes) -> string?,
	peeked: (self: Nodes) -> string?,
	ringRadius: (self: Nodes) -> number, -- world px of the ring radius as drawn (the floor included)
	onCamera: (self: Nodes, cam: Camera) -> (),
	destroy: (self: Nodes) -> (),
}

local Nodes = {}

local MAX_RAYS = 4

function Nodes.new(view: MapView.MapView, mapInput: MapInput.MapInput): Nodes
	local realm: any = require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("Realm"))
	local edges: { MapLogic.Edge } = realm.edges
	local self = {} :: Nodes
	self.activated = Signal.new() :: Signal.Signal<string>
	self.peek = Signal.new() :: Signal.Signal<string>
	self.hover = Signal.new() :: Signal.Signal<string?, Vector2>
	self.rift = Signal.new() :: Signal.Signal<string, Vector2>
	self.changed = Signal.new() :: Signal.Signal<>

	local function socket(layer: string): Vector2
		local key = realm.alias[layer] or layer
		local p = realm.nodes[key]
		if p == nil then return Vector2.new(realm.camera.start[1], realm.camera.start[2]) end
		return Vector2.new(p[1], p[2])
	end

	local widgets: { [string]: NodeWidget.NodeWidget } = {}
	local states: { [string]: string } = {}
	local ranks: { [string]: number } = {}
	local plateRects: { [string]: ARect } = {}
	local conns: { RBXScriptConnection } = {}
	local ms: MapState? = nil
	local selectedOverride: string? = nil
	local hoveredLayer: string? = nil
	local peekLayer: string? = nil
	local lastTap: { [string]: number } = {}
	local z, m = 0.5, 1
	local floorK = 36 / 132

	-- the pointer in abs space: GetMouseLocation counts from the device's top-left corner
	local function mouseAbs(): Vector2
		return Layout.deviceOrigin() + UserInputService:GetMouseLocation()
	end
	local function floorFor(): number
		return if Input.kind() == "touch" then 44 / 132 else 36 / 132
	end

	-- ------------------------------------------------------------------------------------------ widgets + input
	for i, layer in MapLogic.ORDER do
		local w = NodeWidget.new(view.nodes, layer, socket(layer))
		w.frame.ZIndex = 1
		widgets[layer] = w
		states[layer] = "sealed"
		ranks[layer] = 0
		local hit = w.hit
		local touchDown: InputObject? = nil
		local touchAt = Vector2.zero
		local peekFired = false
		table.insert(conns, hit.Activated:Connect(function()
			if mapInput:wasDrag() then return end
			if peekFired then
				peekFired = false
				return
			end
			local now = os.clock()
			if now - (lastTap[layer] or -1) < Input.DOUBLE_CLICK then return end
			lastTap[layer] = now
			self.activated:Fire(layer)
		end))
		table.insert(conns, hit.MouseEnter:Connect(function()
			if Input.kind() == "touch" then return end
			hoveredLayer = layer
			w:setHover(true)
			self.hover:Fire(layer, mouseAbs())
		end))
		table.insert(conns, hit.MouseMoved:Connect(function()
			if Input.kind() == "touch" or hoveredLayer ~= layer then return end
			self.hover:Fire(layer, mouseAbs())
		end))
		table.insert(conns, hit.MouseLeave:Connect(function()
			if hoveredLayer == layer then hoveredLayer = nil end
			w:setHover(false)
			w:setPress(false)
			self.hover:Fire(nil, mouseAbs())
		end))
		table.insert(conns, hit.MouseButton2Click:Connect(function()
			if Input.kind() == "touch" then return end
			self.peek:Fire(layer)
		end))
		table.insert(conns, hit.InputBegan:Connect(function(io: InputObject)
			local t = io.UserInputType
			if t == Enum.UserInputType.MouseButton1 then
				w:setPress(true)
				peekFired = false
			elseif t == Enum.UserInputType.Touch then
				w:setPress(true)
				peekFired = false
				touchDown = io
				touchAt = Layout.inputToAbs(io.Position)
				local mine = io
				task.delay(Input.LONG_PRESS, function()
					if touchDown ~= mine then return end
					local moved = (Layout.inputToAbs(mine.Position) - touchAt).Magnitude
					if moved < 12 and not mapInput:wasDrag() then
						peekFired = true
						w:setPress(false)
						self.peek:Fire(layer)
					end
				end)
			end
		end))
		table.insert(conns, hit.InputEnded:Connect(function(io: InputObject)
			local t = io.UserInputType
			if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
				w:setPress(false)
				if io == touchDown then touchDown = nil end
			end
		end))
		local _ = i
	end
	-- a press that ends outside the button still releases it
	table.insert(conns, UserInputService.InputEnded:Connect(function(io: InputObject)
		local t = io.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			for _, w in widgets do w:setPress(false) end
		end
	end))

	-- ------------------------------------------------------------------------------------------ the rift hotspot
	local rift = Kit.child(view.nodes, "Rift", "ImageButton") :: ImageButton
	do
		local r = realm.rift
		rift.AnchorPoint = Vector2.new(0.5, 0.5)
		rift.Position = UDim2.fromScale(r.cx / 3840, r.cy / 2560)
		rift.Size = UDim2.fromScale(2 * r.rx / 3840, 2 * r.ry / 2560)
		rift.BackgroundTransparency = 1
		rift.ImageTransparency = 1
		rift.Image = ""
		rift.AutoButtonColor = false
		rift.BorderSizePixel = 0
		rift.Selectable = false
		rift.ZIndex = 0
		Kit.corner(rift)
		if Theme.caps.InputSink then
			pcall(function() (rift :: any).InputSink = (Enum :: any).InputSink.None end)
		end
		table.insert(conns, rift.MouseEnter:Connect(function()
			if Input.kind() == "touch" then return end
			view:setRiftHover(true)
			self.rift:Fire("hover", mouseAbs())
		end))
		table.insert(conns, rift.MouseMoved:Connect(function()
			if Input.kind() == "touch" then return end
			self.rift:Fire("hover", mouseAbs())
		end))
		table.insert(conns, rift.MouseLeave:Connect(function()
			view:setRiftHover(false)
			self.rift:Fire("leave", mouseAbs())
		end))
		table.insert(conns, rift.Activated:Connect(function()
			if mapInput:wasDrag() then return end
			self.rift:Fire("click", mouseAbs())
		end))
	end

	-- ------------------------------------------------------------------------------------------ first-run cue
	local cue: Frame? = nil
	local cueOn = false
	local function placeCue()
		local c = cue
		if c == nil or not cueOn then return end
		local p = socket("m")
		local cam = view:camera()
		local s = Layout.s
		local zz = math.max(cam.z, floorK)
		local x = (cam.V.X / 2 + cam.z * (p.X - cam.C.X)) * cam.m / s
		local y = (cam.V.Y / 2 + cam.z * (p.Y - cam.C.Y) - 66 * zz - 10) * cam.m / s
		c.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
	end
	local function buildCue(): Frame
		local c = Kit.frame(view.plates, "FirstRunCue", 30)
		c.AnchorPoint = Vector2.new(0.5, 1)
		c.Size = UDim2.fromOffset(0, 0)
		c.AutomaticSize = Enum.AutomaticSize.XY
		local inner = Kit.frame(c, "Bob")
		inner.AutomaticSize = Enum.AutomaticSize.XY
		inner.Size = UDim2.fromOffset(0, 0)
		Kit.list(inner, "y", 4, Enum.HorizontalAlignment.Center)
		local hue = Theme.hue("m")
		local chip = Kit.frame(inner, "Chip")
		chip.LayoutOrder = 1
		chip.AutomaticSize = Enum.AutomaticSize.XY
		chip.Size = UDim2.fromOffset(0, 0)
		chip.BackgroundColor3 = Theme.shade(hue, 0.35)
		chip.BackgroundTransparency = 0
		Kit.corner(chip, UDim.new(0, 14))
		Kit.stroke(chip, 2, Theme.lift(hue, 0.4), 1)
		Kit.grad(chip, { Theme.shade(hue, 0.42), Theme.shade(hue, 0.3) }, 90)
		local compact = Layout.mode == "COMPACT"
		Kit.pad(chip, 8, 16, 9, 16)
		Kit.list(chip, "y", 2, Enum.HorizontalAlignment.Left)
		local title = Kit.label(chip, "Title", "toast", Rich.caps("Start here"), Color3.new(1, 1, 1))
		title.LayoutOrder = 1
		title.AutomaticSize = Enum.AutomaticSize.XY
		title.Size = UDim2.fromOffset(0, 0)
		Kit.textStroke(title, 1.5, 0.8)
		local sub = Kit.label(chip, "Sub", "body", "Get your first milestone", Color3.new(1, 1, 1))
		sub.LayoutOrder = 2
		sub.AutomaticSize = Enum.AutomaticSize.XY
		sub.Size = UDim2.fromOffset(0, 0)
		local _ = compact
		local arrow = Kit.glyph(inner, "Arrow", "down", Color3.new(1, 1, 1))
		arrow.LayoutOrder = 2
		arrow.Size = UDim2.fromOffset(22, 22)
		return c
	end
	function self.setFirstRun(_: Nodes, b: boolean)
		if b == cueOn then return end
		cueOn = b
		if b then
			if cue == nil then cue = buildCue() end
			local c = cue :: Frame
			c.Visible = true
			local bob = c:FindFirstChild("Bob") :: Frame?
			if bob then Kit.breathe(bob, "Position", UDim2.fromOffset(0, -4), UDim2.fromOffset(0, 4), 1) end
			placeCue()
		elseif cue then
			local c = cue :: Frame
			local bob = c:FindFirstChild("Bob")
			if bob then Kit.still(bob) end
			c.Visible = false
		end
	end

	-- ------------------------------------------------------------------------------------------ state
	local function selectedLayer(): string?
		if selectedOverride then return selectedOverride end
		return if ms then (ms :: MapState).open else nil
	end
	local function refresh()
		local state = ms
		if state == nil then return end
		local sel = selectedLayer()
		local pulses: { string } = {}
		for _, layer in MapLogic.ORDER do
			local w = widgets[layer]
			local st = MapLogic.state(state, layer, edges)
			local fl = MapLogic.flags(state, layer)
			fl.selected = sel == layer and state.nodes[layer] ~= nil and state.nodes[layer].show
			states[layer] = st
			local r = MapLogic.rank(state, layer, edges)
			if fl.selected then r = 100 end
			ranks[layer] = r
			w:update(state.nodes[layer], st, fl)
			w.frame.ZIndex = 1 + math.floor(r / 10)
			if st == "pulse" then table.insert(pulses, layer) end
		end
		-- rays on at most 4 pulse nodes (the selected one first)
		table.sort(pulses, function(a: string, b: string): boolean return ranks[a] > ranks[b] end)
		local on: { [string]: boolean } = {}
		for i, l in pulses do
			if i <= MAX_RAYS then on[l] = true end
		end
		for _, layer in MapLogic.ORDER do widgets[layer]:setRays(on[layer] == true) end
		self.changed:Fire()
	end

	function self.update(_: Nodes, newMs: MapState)
		ms = newMs
		refresh()
	end
	function self.setSelected(_: Nodes, layer: string?)
		selectedOverride = layer
		refresh()
	end
	function self.setPeek(_: Nodes, layer: string?)
		if peekLayer == layer then return end
		local old = peekLayer
		peekLayer = layer
		if old and widgets[old] then widgets[old]:setPeek(false) end
		if layer and widgets[layer] then widgets[layer]:setPeek(true) end
	end
	function self.ringRect(_: Nodes, layer: string): ARect?
		local w = widgets[layer]
		if w == nil or not w.ring.Visible then return nil end
		return Kit.rect(w.ring)
	end
	function self.plateRect(_: Nodes, layer: string): ARect?
		return plateRects[layer]
	end
	function self.setPlateRect(_: Nodes, layer: string, r: ARect?)
		plateRects[layer] = r :: any
	end
	function self.worldPos(_: Nodes, layer: string): Vector2
		return socket(layer)
	end
	function self.state(_: Nodes, layer: string): string
		return states[layer] or "sealed"
	end
	function self.rank(_: Nodes, layer: string): number
		return ranks[layer] or 0
	end
	function self.selected(_: Nodes): string?
		return selectedLayer()
	end
	function self.hovered(_: Nodes): string?
		return hoveredLayer
	end
	function self.peeked(_: Nodes): string?
		return peekLayer
	end
	function self.ringRadius(_: Nodes): number
		return 66 * math.max(1, floorK / math.max(z, 1e-3))
	end

	local lastZ, lastM = -1, -1
	function self.onCamera(_: Nodes, cam: Camera)
		z, m = cam.z, cam.m
		floorK = floorFor()
		if math.abs(z - lastZ) > 0.01 * lastZ or math.abs(m - lastM) > 1e-3 then
			lastZ, lastM = z, m
			for _, w in widgets do w:setZoom(z, m, floorK) end
		end
		placeCue()
	end
	table.insert(conns, (view.cameraChanged :: any):Connect(function(cam: Camera)
		self:onCamera(cam)
	end))
	Input.kindChanged:Connect(function()
		lastZ = -1
		self:onCamera(view:camera())
	end)
	Layout.changed:Connect(function()
		refresh()
	end)
	Motion.changed:Connect(function()
		refresh()
	end)

	function self.destroy(_: Nodes)
		for _, c in conns do c:Disconnect() end
		for _, w in widgets do w:destroy() end
		rift:Destroy()
		if cue then (cue :: Frame):Destroy() end
		self.activated:DisconnectAll()
		self.peek:DisconnectAll()
		self.hover:DisconnectAll()
		self.rift:DisconnectAll()
		self.changed:DisconnectAll()
	end
	self:onCamera(view:camera())
	return self
end

return Nodes
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="121">
            <Properties>
              <string name="Name">Plates</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Plates: the nameplates under the nodes (DESIGN.md 3.9). They live in view.plates (the full Box, sized Box / s under
	UIScale s), so they keep a constant UI size and the type floors of DESIGN.md 9.5.

	    Plate_<id>  Frame (AutomaticSize XY, AnchorPoint .5 / 0, panel2 -> deep at .95, UIStroke 1.5 lift(c, .25))
	      Label     the name: `plate` role, caps with hair spaces, W -> lift(c, .45), a thin outline
	      AmountRow Amount: `plateNum` (Montserrat Bold, lift(c, .55); Rich.num units); locked: lock + requirement + unit
	      Sub       bolt + "READY" (`plateSub`, #ffe08a) on pulse nodes, else "+1.23e45/s" (green) while it generates passively

	Level of detail FULL / CHIP (the amount alone) / NONE by zoom with +-.02 hysteresis (MapLogic.lod); the selected,
	hovered and peeked nodes always get FULL; Options Map Labels ALWAYS / OFF (setMode). Placement is greedy in
	priority order: below the ring, else above it, else the chip, else hidden, never over a HUD rect (Layout.rects),
	past the side sheet's edge, or over another plate by more than 4 du (MapLogic.place). Positions are written on
	every camera frame; placement reruns when the zoom moves 2%, the camera 8 pt, the HUD rects or the node set
	change. Text is written at most 10 times a second (the server refreshes the screen that often) and only when it changed.

	    local plates = Plates.new(view, nodes)
	    plates:update(ms)       plates:onCamera(cam)      plates:setMode(labels)   -- AUTO | ALWAYS | OFF
	onCamera is connected to view.cameraChanged already.
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Rich = require(Core:WaitForChild("Rich"))
local Prefs = require(Core:WaitForChild("Prefs"))
local Kit = require(script.Parent.Parent:WaitForChild("Hud"):WaitForChild("Kit"))
local MapView = require(script.Parent:WaitForChild("MapView"))
local Nodes = require(script.Parent:WaitForChild("Nodes"))
local MapLogic = require(script.Parent:WaitForChild("MapLogic"))

type MapState = Types.MapState
type Camera = Types.Camera
type ARect = Types.Rect

export type Plates = {
	update: (self: Plates, ms: MapState) -> (),
	onCamera: (self: Plates, cam: Camera) -> (),
	setMode: (self: Plates, labels: string) -> (),
	destroy: (self: Plates) -> (),
}

local Plates = {}

local READY = Theme.C.ready
local GAIN = Color3.fromHex("7ee0a0") -- the passive gain line (the capsule's rate green)

type Plate = {
	layer: string,
	frame: Frame,
	label: TextLabel,
	row: Frame,
	amount: TextLabel,
	lock: Frame,
	sub: Frame,
	stroke: UIStroke,
	strokeGrad: UIGradient,
	labelGrad: UIGradient,
	want: { name: string, amount: string, locked: boolean, ready: boolean, gen: string?, hasAmount: boolean }?,
	written: string,
	form: string, -- FULL | CHIP | NONE (as shown)
	slot: number, -- 1 below the ring, 2 above
	sizeFull: Vector2, -- du
	sizeChip: Vector2,
}

local function escape(t: string): string
	return (string.gsub(string.gsub(string.gsub(t, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"))
end
-- caps with hair spaces; pm's redacted blocks at alpha .6
local function nameRich(name: string): string
	local out = escape(Rich.caps(name))
	out = string.gsub(out, "(█+)", '<font transparency="0.4">%1</font>')
	return out
end

function Plates.new(view: MapView.MapView, nodes: Nodes.Nodes): Plates
	local self = {} :: Plates
	local plates: { [string]: Plate } = {}
	local ms: MapState? = nil
	local mode = Prefs.get().labels
	local cam: Camera = view:camera()
	local lod = "FULL"
	local lastPlace = { x = math.huge, y = math.huge, z = 0 }
	local dirty = true
	local lastText = 0
	local textPending = false

	local function compact(): boolean
		return Layout.mode == "COMPACT"
	end

	local function build(layer: string): Plate
		local hue = Theme.hue(layer)
		local f = Kit.frame(view.plates, "Plate_" .. layer, 2)
		f.AnchorPoint = Vector2.new(0.5, 0)
		f.AutomaticSize = Enum.AutomaticSize.XY
		f.Size = UDim2.fromOffset(0, 0)
		f.Visible = false
		-- Sleek: a near-black slab, a white hairline, upright tracked caps and the value in the layer hue
		f.BackgroundColor3 = Color3.fromHex("06090f")
		f.BackgroundTransparency = 0.2
		local st = Kit.stroke(f, 1, Color3.new(1, 1, 1), 0.12, "Rim")
		st.LineJoinMode = Enum.LineJoinMode.Miter
		local sg = Kit.grad(st, { Color3.new(1, 1, 1) }, 90, { { 0, 0.2 }, { 1, 0.1 } }, "RimGrad")
		local list = Kit.list(f, "y", 1, Enum.HorizontalAlignment.Center)
		local _ = list
		local label = Kit.label(f, "Label", "plate", "", Color3.new(1, 1, 1))
		label.LayoutOrder = 1
		label.AutomaticSize = Enum.AutomaticSize.XY
		label.Size = UDim2.fromOffset(0, 0)
		label.RichText = true
		label.TextXAlignment = Enum.TextXAlignment.Center
		local lg = Kit.grad(label, { Color3.new(1, 1, 1) }, 90, nil, "Fill")
		Kit.textStroke(label, 0)
		local over = Kit.child(label, "Overhang", "UIPadding") :: UIPadding
		over.PaddingRight = UDim.new(0, math.ceil(0.1 * label.TextSize))

		local row = Kit.frame(f, "AmountRow")
		row.LayoutOrder = 2
		row.AutomaticSize = Enum.AutomaticSize.XY
		row.Size = UDim2.fromOffset(0, 0)
		Kit.list(row, "x", 4, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		local lock = Kit.glyph(row, "Lock", "lock", Theme.C.gold, Theme.C.deep)
		lock.LayoutOrder = 1
		lock.Size = UDim2.fromOffset(12, 12)
		lock.Visible = false
		local amount = Kit.label(row, "Amount", "plateNum", "", Theme.lift(hue, 0.45))
		amount.LayoutOrder = 2
		amount.AutomaticSize = Enum.AutomaticSize.XY
		amount.Size = UDim2.fromOffset(0, 0)
		amount.RichText = true

		local sub = Kit.frame(f, "Sub")
		sub.LayoutOrder = 3
		sub.AutomaticSize = Enum.AutomaticSize.XY
		sub.Size = UDim2.fromOffset(0, 0)
		Kit.list(sub, "x", 3, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		local bolt = Kit.glyph(sub, "Bolt", "bolt", READY)
		bolt.LayoutOrder = 1
		bolt.Size = UDim2.fromOffset(11, 11)
		local rl = Kit.label(sub, "Text", "plateSub", Rich.caps("Ready"), READY)
		rl.LayoutOrder = 2
		rl.AutomaticSize = Enum.AutomaticSize.XY
		rl.Size = UDim2.fromOffset(0, 0)
		sub.Visible = false

		local p: Plate = {
			layer = layer, frame = f, label = label, row = row, amount = amount, lock = lock, sub = sub, stroke = st,
			strokeGrad = sg, labelGrad = lg, want = nil, written = "", form = "NONE", slot = 1,
			sizeFull = Vector2.new(140, 46), sizeChip = Vector2.new(80, 26),
		}
		plates[layer] = p
		return p
	end
	for _, layer in MapLogic.ORDER do build(layer) end

	local function restyle(p: Plate)
		local c = compact()
		Theme.text(p.label, "plate")
		Theme.text(p.amount, "plateNum")
		local rl = p.sub:FindFirstChild("Text") :: TextLabel?
		if rl then Theme.text(rl, "plateSub") end
		if c then Kit.pad(p.frame, 4, 9, 5, 9) else Kit.pad(p.frame, 5, 12, 6, 12) end
		local g = math.floor(Theme.size("plateNum") * 0.8 + 0.5)
		p.lock.Size = UDim2.fromOffset(g, g)
		local b = p.sub:FindFirstChild("Bolt") :: Frame?
		if b then
			local bs = math.floor(Theme.size("plateSub") * 0.85 + 0.5)
			b.Size = UDim2.fromOffset(bs, bs)
		end
	end
	for _, p in plates do restyle(p) end

	-- ------------------------------------------------------------------------------------------ text
	local function amountText(layer: string, node: Types.MapNode): (string, boolean)
		local v = node.val
		if v == nil then return "", false end
		if not v.lit then
			local req = v.req or ""
			local unit = MapLogic.unit(v.rres)
			return Rich.num(req .. " " .. unit, { size = Theme.size("plateNum"), unit = Theme.C.soft }), req ~= ""
		end
		local pts = v.pts or ""
		if layer == "ach" and v.tot then pts = pts .. " / " .. v.tot end
		if pts == "" then return "", false end
		return Rich.num(pts, { size = Theme.size("plateNum"), unit = Theme.C.soft }), true
	end

	local function writeText(force: boolean)
		local now = os.clock()
		if not force and now - lastText < 0.1 then
			if not textPending then
				textPending = true
				task.delay(0.11 - (now - lastText), function()
					textPending = false
					writeText(true)
				end)
			end
			return
		end
		lastText = now
		for layer, p in plates do
			local w = p.want
			if w == nil then continue end
			local key = w.name .. "|" .. w.amount .. "|" .. tostring(w.locked) .. "|" .. tostring(w.ready) .. "|" .. tostring(w.gen)
			if key == p.written then continue end
			p.written = key
			p.label.Text = nameRich(w.name)
			p.amount.Text = w.amount
			-- the second line: READY, or the passive gain ("+1.23e45/s") once the layer generates on its own
			local rl = p.sub:FindFirstChild("Text") :: TextLabel?
			local bolt = p.sub:FindFirstChild("Bolt") :: GuiObject?
			if rl then
				rl.RichText = true
				if w.ready or w.gen == nil then
					rl.Text = Rich.caps("Ready")
					rl.TextColor3 = READY
				else
					rl.Text = Rich.num("+" .. w.gen .. "/s", { size = Theme.size("plateSub"), unit = Theme.C.soft })
					rl.TextColor3 = GAIN
				end
			end
			if bolt then bolt.Visible = w.ready end
			p.lock.Visible = false -- Sleek: a locked plate is grey; no lock coin in the value row
			local hue = Theme.hue(layer)
			-- Sleek: white hairline plates; a READY node's plate takes the hue on its hairline
			if w.locked then
				p.labelGrad.Color = ColorSequence.new(Theme.C.lockedTitle)
				p.amount.TextColor3 = Theme.C.lockedTitle
				p.strokeGrad.Color = ColorSequence.new(Color3.new(1, 1, 1))
			else
				p.labelGrad.Color = ColorSequence.new(Color3.new(1, 1, 1))
				p.amount.TextColor3 = Theme.lift(hue, 0.45)
				p.strokeGrad.Color = ColorSequence.new(if w.ready then Theme.lift(hue, 0.3) else Color3.new(1, 1, 1))
			end
			p.stroke.Transparency = if w.ready then 0.35 else 0.12
			p.stroke.Thickness = 1
			dirty = true
		end
	end

	-- ------------------------------------------------------------------------------------------ placement
	local function nodeBox(layer: string): (number, number)
		local p = nodes:worldPos(layer)
		return cam.m * (cam.V.X / 2 + cam.z * (p.X - cam.C.X)), cam.m * (cam.V.Y / 2 + cam.z * (p.Y - cam.C.Y))
	end
	-- the plate-local slot rect (du): below the ring (1) or above it (2)
	local function slotRect(layer: string, size: Vector2, slot: number): ARect
		local s = Layout.s
		local bx, by = nodeBox(layer)
		local r = nodes:ringRadius() * cam.z * cam.m
		local x = bx / s - size.X / 2
		local y = if slot == 1 then (by + r) / s + 2 else (by - r) / s - 18 - size.Y
		return { x = x, y = y, w = size.X, h = size.Y }
	end
	local function blockedRects(): { ARect }
		local s = Layout.s
		local bp = view.box.AbsolutePosition
		local out: { ARect } = {}
		for _, r in Layout.rects() do
			table.insert(out, { x = (r.x - bp.X) / s, y = (r.y - bp.Y) / s, w = r.w / s, h = r.h / s })
		end
		local sx = Layout.sheet()
		if sx then table.insert(out, { x = (sx - bp.X) / s, y = -1e5, w = 1e6, h = 2e5 }) end
		return out
	end
	local function measure(p: Plate)
		local a = p.frame.AbsoluteSize
		if a.X > 1 and a.Y > 1 and p.frame.Visible then
			local s = Layout.s
			local d = Vector2.new(a.X / s, a.Y / s)
			if p.form == "FULL" then p.sizeFull = d elseif p.form == "CHIP" then p.sizeChip = d end
		end
	end

	local function place()
		local state = ms
		if state == nil then return end
		local sel, hov, pk = nodes:selected(), nodes:hovered(), nodes:peeked()
		local c = compact()
		local items: { MapLogic.PlateItem } = {}
		for layer, p in plates do
			local w = p.want
			if w == nil then continue end
			measure(p)
			local keep = layer == sel or layer == hov or layer == pk
			local level = lod
			if mode == "ALWAYS" then level = "FULL" elseif mode == "OFF" then level = "NONE" end
			if keep then level = "FULL" end
			if level == "NONE" and not w.ready then continue end
			local full = if level == "FULL" then { slotRect(layer, p.sizeFull, 1), slotRect(layer, p.sizeFull, 2) } else nil
			local chip = if w.hasAmount or w.ready then { slotRect(layer, p.sizeChip, 1), slotRect(layer, p.sizeChip, 2) } else nil
			if level == "NONE" and w.ready then full = nil end
			local _ = c
			table.insert(items, { id = layer, rank = nodes:rank(layer), y = nodes:worldPos(layer).Y, full = full, chip = chip, keep = keep })
		end
		local placed = MapLogic.place(items, blockedRects(), 4)
		for layer, p in plates do
			local pl = placed[layer]
			local form = if pl then pl.form else "NONE"
			local slot = if pl then pl.slot else 1
			local w = p.want
			if form ~= p.form then
				p.form = form
				if form == "NONE" or w == nil then
					p.frame.Visible = false
				else
					p.frame.Visible = true
					p.label.Visible = form == "FULL"
					-- COMPACT FULL shows the amount only on READY, CAN BUY and the selected node (DESIGN.md 3.9)
					local showAmount = form == "CHIP" or not c or w.ready or layer == sel or nodes:state(layer) == "glow"
					p.row.Visible = w.hasAmount and showAmount
					p.sub.Visible = w.ready or (w.gen ~= nil and form == "FULL")
				end
			elseif w and form ~= "NONE" then
				p.sub.Visible = w.ready or (w.gen ~= nil and form == "FULL")
				p.row.Visible = w.hasAmount and (form == "CHIP" or not c or w.ready or layer == sel or nodes:state(layer) == "glow")
			end
			p.slot = slot
			nodes:setPlateRect(layer, if pl and pl.rect then pl.rect else nil)
		end
		lastPlace = { x = cam.C.X, y = cam.C.Y, z = cam.z }
		dirty = false
	end

	local function writePositions()
		local s = Layout.s
		for layer, p in plates do
			if p.form == "NONE" then continue end
			local bx, by = nodeBox(layer)
			local r = nodes:ringRadius() * cam.z * cam.m
			local size = if p.form == "FULL" then p.sizeFull else p.sizeChip
			local y = if p.slot == 1 then (by + r) / s + 2 else (by - r) / s - 18 - size.Y
			p.frame.Position = UDim2.fromOffset(math.floor(bx / s + 0.5), math.floor(y + 0.5))
		end
	end

	-- ------------------------------------------------------------------------------------------ API
	function self.update(_: Plates, newMs: MapState)
		ms = newMs
		local sel = nodes:selected()
		for _, layer in MapLogic.ORDER do
			local p = plates[layer]
			local node = newMs.nodes[layer]
			local st = nodes:state(layer)
			if node == nil or not node.show or node.val == nil or st == "sealed" or st == "frontier" or st == "dormant" then
				p.want = nil
				if p.form ~= "NONE" then
					p.form = "NONE"
					p.frame.Visible = false
				end
				continue
			end
			local amt, has = amountText(layer, node)
			p.want = {
				name = MapLogic.plateName(node, layer),
				amount = amt,
				locked = st == "locked",
				ready = st == "pulse",
				gen = if node.val and type(node.val.gen) == "string" and st ~= "locked" then node.val.gen else nil,
				hasAmount = has,
			}
			local _ = sel
		end
		writeText(false)
		dirty = true
		place()
		writePositions()
	end

	function self.onCamera(_: Plates, c: Camera)
		cam = c
		local newLod = MapLogic.lod(c.z, Layout.mode, lod)
		if newLod ~= lod then
			lod = newLod
			dirty = true
		end
		local moved = math.abs(c.C.X - lastPlace.x) * c.z > 8 or math.abs(c.C.Y - lastPlace.y) * c.z > 8
			or math.abs(c.z - lastPlace.z) > 0.02 * lastPlace.z
		if dirty or moved then place() end
		writePositions()
	end

	function self.setMode(_: Plates, labels: string)
		if labels == mode then return end
		mode = labels
		dirty = true
		place()
		writePositions()
	end

	local conns: { any } = {}
	table.insert(conns, view.cameraChanged:Connect(function(c: Camera)
		self:onCamera(c)
	end))
	table.insert(conns, Layout.rectsChanged:Connect(function()
		dirty = true
		task.defer(function()
			if dirty then
				place()
				writePositions()
			end
		end)
	end))
	table.insert(conns, Layout.changed:Connect(function()
		for _, p in plates do
			restyle(p)
			p.written = ""
		end
		writeText(true)
		dirty = true
	end))
	table.insert(conns, nodes.changed:Connect(function()
		dirty = true
	end))
	table.insert(conns, nodes.hover:Connect(function()
		dirty = true
		task.defer(function()
			if dirty then
				place()
				writePositions()
			end
		end)
	end))
	table.insert(conns, Prefs.changed:Connect(function(key: string)
		if key == "labels" then self:setMode(Prefs.get().labels) end
	end))

	function self.destroy(_: Plates)
		for _, c in conns do c:Disconnect() end
		for _, p in plates do p.frame:Destroy() end
		table.clear(plates)
	end
	return self
end

return Plates
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="122">
          <Properties>
            <string name="Name">Overlay</string>
          </Properties>
          <Item class="ModuleScript" referent="123">
            <Properties>
              <string name="Name">Detail</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Detail: the touch detail sheet (DESIGN.md 7.4). A long-press on an upgrade (or on a buyable) in the panel opens a
	full-width bottom sheet: the whole text (never clamped), CURRENTLY / COST / LEVEL rows, the progress bar, and the
	big action (BUY; HOLD TO BUY repeats for buyables that repeat). Holds happen here, away from the scroll list.
	Dismiss: a tap outside, the handle, or a drag down of 60 du.

	    local d = Detail.new(root)
	    d:show(card?)      card = { id, kind, node, layer, get = fn(id) -> node? }; nil closes
	    d:refresh()        re-reads the card's node (a patch changed the tab)
	    d:isOpen() -> id?
	    d.act (action, hold)     the node's own `a`, read from the store at press time (plan 1.11)
]]

local UserInputService = game:GetService("UserInputService")

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Signal = require(Core:WaitForChild("Signal"))
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Motion = require(Core:WaitForChild("Motion"))
local Rich = require(Core:WaitForChild("Rich"))
local Kit = require(script.Parent.Parent:WaitForChild("Hud"):WaitForChild("Kit"))

export type Card = { id: string, kind: string, node: any, layer: string?, get: ((id: string) -> any)? }
export type Detail = {
	frame: Frame,
	act: Signal.Signal<Types.Action, boolean>,
	show: (self: Detail, card: Card?) -> (),
	refresh: (self: Detail) -> (),
	isOpen: (self: Detail) -> string?,
	destroy: (self: Detail) -> (),
}

local Detail = {}

local WHITE = Color3.new(1, 1, 1)

local function str(v: any): string?
	if type(v) == "string" and v ~= "" then return v end
	if type(v) == "number" then return tostring(v) end
	return nil
end
local function plain(html: string): string
	local s = string.gsub(html, "<br%s*/?>", " ")
	s = string.gsub(s, "<[^>]*>", "")
	s = string.gsub(s, "&nbsp;", " ")
	return (string.gsub(s, "%s+", " "))
end

function Detail.new(root: GuiObject): Detail
	local self = {} :: Detail
	self.act = Signal.new() :: Signal.Signal<Types.Action, boolean>

	local dimmer = Kit.button(root, "DetailDimmer")
	dimmer.Size = UDim2.fromScale(1, 1)
	dimmer.BackgroundColor3 = Color3.new(0, 0, 0)
	dimmer.BackgroundTransparency = 0.5
	dimmer.ZIndex = 55
	dimmer.Visible = false
	local sheet = Kit.frame(root, "Detail", 56)
	sheet.AnchorPoint = Vector2.new(0.5, 1)
	sheet.Position = UDim2.fromScale(0.5, 1)
	sheet.AutomaticSize = Enum.AutomaticSize.Y
	sheet.BackgroundColor3 = WHITE
	sheet.BackgroundTransparency = 0
	sheet.Active = true
	sheet.Visible = false
	Kit.corner(sheet, UDim.new(0, 0)) -- Sleek: square
	Kit.grad(sheet, { Theme.C.panel2, Theme.C.panel }, 90, nil, "Back")
	local rim = Kit.stroke(sheet, 2, Theme.C.strokeHi, 1, "Rim")
	Kit.list(sheet, "y", 12, Enum.HorizontalAlignment.Left)
	self.frame = sheet

	local card: Card? = nil
	local conns: { RBXScriptConnection } = {}
	local holding: InputObject? = nil -- the press of a HOLD TO BUY in progress
	local dirty = false -- a refresh came in while holding: redraw on release

	local function close()
		card = nil
		holding = nil
		dirty = false
		for _, c in conns do c:Disconnect() end
		table.clear(conns)
		sheet.Visible = false
		dimmer.Visible = false
	end
	dimmer.Activated:Connect(close)

	local function node(): any
		local c = card
		if c == nil then return nil end
		local n = if c.get then c.get(c.id) else nil
		if type(n) == "table" then return n end
		return c.node
	end

	local function row(parent: Instance, order: number, key: string, value: string)
		local r = Kit.frame(parent, "Row" .. order)
		r.LayoutOrder = order
		r.Size = UDim2.new(1, 0, 0, 24)
		local k = Kit.label(r, "Key", "caps", Rich.caps(key), Theme.C.soft)
		k.Size = UDim2.fromScale(0.35, 1)
		k.TextXAlignment = Enum.TextXAlignment.Left
		local v = Kit.label(r, "Value", "number", "", WHITE)
		v.AnchorPoint = Vector2.new(1, 0)
		v.Position = UDim2.fromScale(1, 0)
		v.Size = UDim2.fromScale(0.65, 1)
		v.TextXAlignment = Enum.TextXAlignment.Right
		v.RichText = true
		v.Text = Rich.num(value, { size = Theme.size("number"), unit = Theme.C.soft })
	end

	local function draw()
		local c = card
		local n = node()
		if c == nil or n == nil then return end
		for _, x in sheet:GetChildren() do
			if x:IsA("GuiObject") then x:Destroy() end
		end
		for _, x in conns do x:Disconnect() end
		table.clear(conns)
		local compact = Layout.mode == "COMPACT"
		local hue = Theme.hue(c.layer)
		rim.Color = Theme.lift(hue, 0.25)
		sheet.Size = UDim2.fromOffset(math.min(Layout.canvas.X - 24, 760), 0)
		Kit.pad(sheet, 10, if compact then 18 else 24, 18, if compact then 18 else 24)
		-- the handle (a tap or a drag down of 60 du closes)
		local handle = Kit.button(sheet, "Handle")
		handle.LayoutOrder = 1
		handle.Size = UDim2.new(1, 0, 0, 24)
		local bar = Kit.frame(handle, "Bar")
		bar.AnchorPoint = Vector2.new(0.5, 0.5)
		bar.Position = UDim2.fromScale(0.5, 0.5)
		bar.Size = UDim2.fromOffset(56, 5)
		bar.BackgroundColor3 = Theme.C.soft
		bar.BackgroundTransparency = 0.3
		Kit.corner(bar)
		handle.Activated:Connect(close)
		table.insert(conns, handle.InputBegan:Connect(function(io: InputObject)
			if io.UserInputType ~= Enum.UserInputType.Touch and io.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
			local y0 = io.Position.Y
			local moveConn: RBXScriptConnection
			moveConn = UserInputService.InputChanged:Connect(function(m: InputObject)
				if m ~= io and m.UserInputType ~= Enum.UserInputType.MouseMovement then return end
				if m.Position.Y - y0 > 60 * Layout.s then
					moveConn:Disconnect()
					close()
				end
			end)
			table.insert(conns, moveConn)
			table.insert(conns, UserInputService.InputEnded:Connect(function(e: InputObject)
				if e == io or e.UserInputType == Enum.UserInputType.MouseButton1 then moveConn:Disconnect() end
			end))
		end))
		-- the title and the whole text
		local h = str(n.h) or ""
		local titleText = str(n.ti) or plain(string.match(h, "^(.-)<br") or h)
		local title = Kit.label(sheet, "Title", "card", titleText, Theme.lift(hue, 0.55))
		title.LayoutOrder = 2
		title.AutomaticSize = Enum.AutomaticSize.Y
		title.Size = UDim2.fromScale(1, 0)
		title.TextWrapped = true
		title.TextXAlignment = Enum.TextXAlignment.Left
		local text = str(n.ds) or h
		local body = Kit.label(sheet, "Body", "body", "", Theme.C.text)
		body.LayoutOrder = 3
		body.AutomaticSize = Enum.AutomaticSize.Y
		body.Size = UDim2.fromScale(1, 0)
		body.TextWrapped = true
		body.RichText = true
		body.TextXAlignment = Enum.TextXAlignment.Left
		body.Text = Rich.html(text, Theme.size("body"), c.layer, true)
		-- the numbers
		local rows = Kit.frame(sheet, "Rows")
		rows.LayoutOrder = 4
		rows.AutomaticSize = Enum.AutomaticSize.Y
		rows.Size = UDim2.fromScale(1, 0)
		Kit.list(rows, "y", 6, Enum.HorizontalAlignment.Left)
		local order = 0
		local function add(k: string, v: string?)
			if v == nil then return end
			order += 1
			row(rows, order, k, v)
		end
		add("Currently", str(n.ef))
		if str(n.lv) then add("Level", (str(n.lv) :: string) .. (if str(n.max) then " / " .. (str(n.max) :: string) else "")) end
		if str(n.co) then add("Cost", (str(n.co) :: string) .. (if str(n.cur) then " " .. (str(n.cur) :: string) else "")) end
		rows.Visible = order > 0
		local pr = n.pr
		if type(pr) == "number" then
			local track = Kit.frame(sheet, "Bar")
			track.LayoutOrder = 5
			track.Size = UDim2.new(1, 0, 0, 8)
			track.BackgroundColor3 = Theme.C.deep
			track.BackgroundTransparency = 0
			Kit.corner(track)
			local fill = Kit.frame(track, "Fill")
			fill.Size = UDim2.fromScale(math.clamp(pr / 1000, 0, 1), 1)
			fill.BackgroundColor3 = Theme.lift(hue, 0.1)
			fill.BackgroundTransparency = 0
			Kit.corner(fill)
		end
		-- the big action
		local buttons = Kit.frame(sheet, "Buttons")
		buttons.LayoutOrder = 6
		buttons.Size = UDim2.new(1, 0, 0, 56)
		Kit.list(buttons, "x", 12, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
		local cls = str(n.cls) or ""
		local can = cls == "can"
		local word = if cls == "bought" then "Owned" elseif not can then "Not affordable" elseif n.hold then "Hold to buy" else "Buy"
		local b = Kit.action(buttons, "Primary", Rich.caps(word), { style = if can then "primary" else "quiet", hue = hue, h = 56, role = "cta" })
		b:SetAttribute("State", if can then "can" else cls)
		local done = Kit.action(buttons, "Done", Rich.caps("Done"), { style = "quiet", h = 56 })
		done.LayoutOrder = -1
		done.Activated:Connect(close)
		if can then
			b.Activated:Connect(function()
				local cur = node()
				local a = cur and cur.a
				if type(a) == "table" then self.act:Fire(a, false) end
			end)
			if n.hold then
				-- hold to repeat: after 0.25 s, 20 presses a second while the pointer stays down (as in the panel)
				table.insert(conns, b.InputBegan:Connect(function(io: InputObject)
					if io.UserInputType ~= Enum.UserInputType.Touch and io.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
					holding = io
					task.delay(0.25, function()
						while holding == io and sheet.Visible do
							local cur = node()
							local a = cur and cur.a
							if type(a) ~= "table" or cur.cls ~= "can" then break end
							self.act:Fire(a, true)
							task.wait(0.05)
						end
					end)
				end))
			end
		end
	end

	local endConn = UserInputService.InputEnded:Connect(function(io: InputObject)
		local h = holding
		if h == nil then return end
		if io == h or io.UserInputType == h.UserInputType and io.UserInputType == Enum.UserInputType.MouseButton1 then
			holding = nil
			if dirty then
				dirty = false
				draw()
			end
		end
	end)

	function self.show(_: Detail, c: Card?)
		if c == nil then
			close()
			return
		end
		card = c
		draw()
		dimmer.Visible = true
		sheet.Visible = true
		if not Motion.reduced() then
			sheet.Position = UDim2.new(0.5, 0, 1, 40)
			Motion.tween(sheet, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.fromScale(0.5, 1) }, "detailOpen")
		else
			sheet.Position = UDim2.fromScale(0.5, 1)
		end
	end
	function self.refresh(_: Detail)
		if card == nil then return end
		local n = node()
		local sig = if n then tostring(n.cls) .. "|" .. tostring(n.h) .. "|" .. tostring(n.pr) .. "|" .. tostring(n.lv) else ""
		if sheet:GetAttribute("Sig") == sig then return end
		sheet:SetAttribute("Sig", sig)
		if holding then
			dirty = true
		else
			draw()
		end
	end
	function self.isOpen(_: Detail): string?
		return if card then card.id else nil
	end
	function self.destroy(d: Detail)
		close()
		endConn:Disconnect()
		d.act:DisconnectAll()
		sheet:Destroy()
		dimmer:Destroy()
	end
	return self
end

return Detail
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="124">
            <Properties>
              <string name="Name">Guide</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Guide: the first-run tutorial (8 steps). Each step names what to press (a spotlight around it, a gold hairline and
	a card beside it) and moves on by itself when the game shows it was done, so it never blocks: the dim is click-
	through and SKIP is always there. The next step lives in Prefs.tut (8 = done or skipped); Options › Tutorial ›
	Replay starts it again. A player further along than a step skips it.

	    local g = Guide.new(root)
	    g:update(ctx)      every patch and a few times a second (targets move with the camera)
	    g:hide()           g.destroy

	ctx (App): { ms = MapState?, panel = open layer key?, milestones = number, pShown, pOwned (Prestige Points > 0),
	             mCan (M can reset), rect = function(target) -> ARect? (abs) }. Targets: "capsule", "node:<layer>",
	             "cta" (the panel's big action), "ready" (the READY tray), or nil (the card alone, lower centre).

	Steps:  1 points grow · 2 open M · 3 first milestone · 4 keep going (5 reveal a layer) · 5 open Prestige ·
	        6 prestige · 7 upgrades (NEXT) · 8 the READY tray (DONE)
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Prefs = require(Core:WaitForChild("Prefs"))
local Rich = require(Core:WaitForChild("Rich"))
local Sleek = require(Core:WaitForChild("Sleek"))
local Motion = require(Core:WaitForChild("Motion"))
local Kit = require(script.Parent.Parent:WaitForChild("Hud"):WaitForChild("Kit"))

type ARect = { x: number, y: number, w: number, h: number }
export type Ctx = {
	panel: string?,
	milestones: number,
	pShown: boolean,
	pOwned: boolean,
	mCan: boolean,
	rect: (target: string) -> ARect?,
}
type Step = {
	title: string,
	body: string,
	target: string?,
	done: (c: Ctx) -> boolean, -- the step is behind the player: move on
	next: string?, -- a button that moves on (the steps nothing in the game confirms)
}

local GOLD = Color3.fromHex("ffc93c")
local DONE = 8

local STEPS: { Step } = {
	{ title = "Welcome to the tree", target = "capsule",
		body = "Your points grow on their own. Everything in the game is bought with them, starting with Milestones.",
		done = function(c) return c.milestones >= 1 end, next = "Next" },
	{ title = "Open the Milestone layer", target = "node:m",
		body = "Tap the violet M crystal. Each crystal on the tree is a layer.",
		done = function(c) return c.panel == "m" or c.milestones >= 1 end },
	{ title = "Get your first Milestone", target = "cta",
		body = "Press the big button when it lights up. Milestones never reset.",
		done = function(c) return c.milestones >= 1 end },
	{ title = "Milestones boost everything", target = nil,
		body = "Every Milestone makes the next one come sooner. Reach 5 Milestones to reveal a new layer.",
		done = function(c) return c.pShown end },
	{ title = "A new layer: Prestige", target = "node:p",
		body = "Tap the Prestige crystal to open it.",
		done = function(c) return c.panel == "p" or c.pOwned end },
	{ title = "Prestige", target = "cta",
		body = "Prestige trades your points for Prestige Points. When a layer says READY, it is worth doing.",
		done = function(c) return c.pOwned end },
	{ title = "Upgrades", target = nil,
		body = "Spend Prestige Points on the upgrade cards below. Each one multiplies your progress.",
		done = function() return false end, next = "Next" },
	{ title = "The READY tray", target = "ready",
		body = "When layers are READY, their gems line up here. Hold a gem to prestige without opening the layer. Have fun!",
		done = function() return false end, next = "Done" },
}

export type Guide = {
	frame: Frame,
	update: (self: Guide, ctx: Ctx) -> (),
	hide: (self: Guide) -> (),
	step: (self: Guide) -> number,
	destroy: (self: Guide) -> (),
}

local Guide = {}

function Guide.new(root: GuiObject): Guide
	local self = {} :: Guide
	local f = Kit.frame(root, "Guide", 40)
	f.Size = UDim2.fromScale(1, 1)
	f.Visible = false
	self.frame = f

	-- the dim around the target: four click-through panes and a gold hairline ring
	local dim = Kit.frame(f, "Dim", 40)
	dim.Size = UDim2.fromScale(1, 1)
	pcall(function() dim.Interactable = false end)
	local panes: { Frame } = {}
	for i = 1, 4 do
		local p = Kit.frame(dim, "Pane" .. i, 40)
		p.BackgroundColor3 = Color3.new(0, 0, 0)
		p.BackgroundTransparency = 0.5
		panes[i] = p
	end
	local ring = Kit.frame(dim, "Ring", 41)
	local rs = Kit.stroke(ring, 2, GOLD, 1, "Hair")
	rs.LineJoinMode = Enum.LineJoinMode.Miter
	Sleek.ticks(ring, { len = 12, th = 2, out = 4, color = GOLD, alpha = 1, z = 42 })

	-- the card
	local card = Kit.frame(f, "Card", 45)
	card.Size = UDim2.fromOffset(420, 0)
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.Active = true
	Sleek.plate(card, { alpha = 0.96, line = 0.7 })
	Sleek.accent(card, GOLD, 18, 60, { name = "TopAccent" })
	Kit.pad(card, 18, 20, 16, 20)
	Kit.list(card, "y", 8, Enum.HorizontalAlignment.Left)
	local stepL = Kit.label(card, "Step", "caps", "", GOLD)
	stepL.LayoutOrder = 1
	stepL.Size = UDim2.new(1, 0, 0, 16)
	stepL.TextXAlignment = Enum.TextXAlignment.Left
	stepL.RichText = true
	local title = Kit.label(card, "Title", "section", "", Color3.new(1, 1, 1))
	title.LayoutOrder = 2
	title.Size = UDim2.new(1, 0, 0, 28)
	title.TextXAlignment = Enum.TextXAlignment.Left
	local body = Kit.label(card, "Body", "body", "", Theme.C.soft)
	body.LayoutOrder = 3
	body.Size = UDim2.new(1, 0, 0, 0)
	body.AutomaticSize = Enum.AutomaticSize.Y
	body.TextWrapped = true
	body.TextXAlignment = Enum.TextXAlignment.Left
	local row = Kit.frame(card, "Buttons", 45)
	row.LayoutOrder = 4
	row.Size = UDim2.new(1, 0, 0, 44)
	Kit.list(row, "x", 10, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	local skip = Kit.action(row, "Skip", Rich.caps("Skip tutorial"), { style = "quiet", h = 40 })
	skip.LayoutOrder = 1
	local nextB, nextL = Kit.action(row, "Next", Rich.caps("Next"), { style = "gold", h = 40 })
	nextB.LayoutOrder = 2

	local shown = 0 -- the step on screen (0: none)
	local lastCtx: Ctx? = nil
	local replaying = false -- Options › Tutorial › Replay was pressed this session
	Prefs.changed:Connect(function(key: string)
		if key == "tut" and Prefs.get().tut == 0 then replaying = true end
	end)

	local function setStep(n: number)
		Prefs.set("tut", math.clamp(n, 0, DONE))
	end
	skip.Activated:Connect(function() setStep(DONE) end)
	nextB.Activated:Connect(function()
		local cur = Prefs.get().tut
		setStep(cur + 1)
		if lastCtx then self:update(lastCtx) end
	end)

	local function place(target: ARect?)
		local s = Layout.s
		local ra = root.AbsolutePosition
		local W, H = root.AbsoluteSize.X / s, root.AbsoluteSize.Y / s
		local cw, ch = 420, math.max(card.AbsoluteSize.Y / s, 150)
		if target == nil then
			for _, p in panes do p.Visible = false end
			ring.Visible = false
			card.Position = UDim2.fromOffset((W - cw) / 2, H - ch - 150)
			return
		end
		-- the target in root du, padded
		local pad = 10
		local x, y = (target.x - ra.X) / s - pad, (target.y - ra.Y) / s - pad
		local w, h = target.w / s + 2 * pad, target.h / s + 2 * pad
		ring.Visible = true
		ring.Position = UDim2.fromOffset(x, y)
		ring.Size = UDim2.fromOffset(w, h)
		-- the dim: above, below, left, right of the hole
		local rects = { { 0, 0, W, y }, { 0, y + h, W, H - y - h }, { 0, y, x, h }, { x + w, y, W - x - w, h } }
		for i, r in rects do
			local p = panes[i]
			p.Visible = r[3] > 0 and r[4] > 0
			p.Position = UDim2.fromOffset(r[1], r[2])
			p.Size = UDim2.fromOffset(math.max(0, r[3]), math.max(0, r[4]))
		end
		-- the card: below the target when it fits, else above; kept on screen
		local cx = math.clamp(x + w / 2 - cw / 2, 16, W - cw - 16)
		local cy = if y + h + 16 + ch < H - 16 then y + h + 16 else y - ch - 16
		cy = math.clamp(cy, 16, H - ch - 16)
		card.Position = UDim2.fromOffset(cx, cy)
	end

	function self.step(_: Guide): number
		return Prefs.get().tut
	end

	function self.update(_: Guide, c: Ctx)
		lastCtx = c
		local prefs = Prefs.get()
		local n = prefs.tut
		if prefs.guide == "OFF" then n = DONE end
		-- a player well into the game (an old save) is past the whole tutorial, unless they asked for it again
		if c.milestones >= 12 and not replaying then n = DONE end
		-- steps the player is already past move on by themselves (one per update, so a new game shows each)
		while n < DONE and STEPS[n + 1].done(c) do
			n += 1
		end
		if n ~= prefs.tut and prefs.guide ~= "OFF" then setStep(n) end
		if n >= DONE then
			if f.Visible then f.Visible = false end
			shown = 0
			return
		end
		local st = STEPS[n + 1]
		local target = if st.target then c.rect(st.target) else nil
		if shown ~= n + 1 then
			shown = n + 1
			stepL.Text = Rich.caps(string.format("Tutorial  ·  %d / %d", n + 1, DONE))
			title.Text = st.title
			body.Text = st.body
			nextB.Visible = st.next ~= nil
			nextL.Text = Rich.caps(st.next or "Next")
			f.Visible = true
			local sc = Motion.scaleOf(card)
			sc.Scale = 0.96
			Motion.tween(sc, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }, "guideCard")
		end
		place(target)
	end

	function self.hide(_: Guide)
		f.Visible = false
		shown = 0
	end

	function self.destroy(_: Guide)
		f:Destroy()
	end
	return self
end

return Guide
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="125">
            <Properties>
              <string name="Name">Modals</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Modals: the modal chrome and its uses (DESIGN.md 7.5-7.8; mock j). Saves live in Roblox, so there is no export,
	import or hard reset.

	    ModalDimmer  black alpha .6, takes every input (InputSink All); a tap closes (not during a hold)
	    Modal        the card: panel2 -> panel, a hue rim, the head (icon disc + R3 title + a hue sub line), the body,
	                 the Buttons row. Opens with scale .96 -> 1 (0.2 s).
	      gate       the Multiverse gate: PRESTIGE MULTIVERSE, the context, the GOAL box (+ Goal met chip), what
	                 happens (the reset list / completes / returns), STAY + HOLD TO ENTER | EXIT | FINISH (1.2 s);
	                 locked: "Unlock Multiverse (MP) first"; sealed: the requirement with its bar
	      ranks      LEADERBOARDS: a tab per board (24, arrows step through), the player's own best, the top 50
	      shop       SHOP: the game passes (OWNED / R$ price / SOON without an id) and the Time Warps; a press opens
	                 Roblox's purchase prompt (the server grants it, see server/Shop.luau); redraws when MT_Perks changes

	    local modals = Modals.new(root)
	    modals:open(kind?, data?)      nil closes. data: gate = Gate; any other kind shows data as text with OK
	    modals:isOpen() -> kind?
	    modals.act (action, hold?), modals.closed (), modals.notice (text)
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Signal = require(Core:WaitForChild("Signal"))
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Motion = require(Core:WaitForChild("Motion"))
local Rich = require(Core:WaitForChild("Rich"))
local Recipes = require(Core:WaitForChild("Recipes"))
local Kit = require(script.Parent.Parent:WaitForChild("Hud"):WaitForChild("Kit"))
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local Products = require(game:GetService("ReplicatedStorage"):WaitForChild("MilestoneTree"):WaitForChild("Products"))
local Boards = require(game:GetService("ReplicatedStorage"):WaitForChild("MilestoneTree"):WaitForChild("Boards"))

type Action = Types.Action

export type Modals = {
	frame: Frame,
	act: Signal.Signal<Action>,
	closed: Signal.Signal<>,
	notice: Signal.Signal<string>,
	open: (self: Modals, kind: string?, data: any?) -> (),
	isOpen: (self: Modals) -> string?,
	destroy: (self: Modals) -> (),
}

local Modals = {}

local CRIMSON = Color3.fromHex("ff2e63")
local CYAN = Color3.fromHex("4fd1ff")
local MEDAL = { Color3.fromHex("ffc93c"), Color3.fromHex("d7e0ea"), Color3.fromHex("e39a5b") } -- gold, silver, bronze
local PAGE_KEEP = 30 -- seconds a board page is kept before it is asked for again
local boardNow = "points" -- the board the RANKS window shows (remembered for the session)
local pageCache: { [string]: { t: number, page: any } } = {}
local GOLD = Color3.fromHex("ffc93c")
local LAYER_NAMES = {
	m = "Milestone", mm = "Meta-Milestone", em = "Extra-Milestone", p = "Prestige", pe = "Prestige Energy", sp = "Super Prestige",
	pb = "Prestige Boost", pp = "Prestige Power", se = "Super Energy", hp = "Hyper Prestige", ep = "Exotic Prestige",
	hb = "Hyper Boost", ap = "Atomic Prestige", mp = "Multiverse", t = "Transcend",
} :: { [string]: string }

function Modals.new(root: GuiObject): Modals
	local self = {} :: Modals
	self.act = Signal.new() :: Signal.Signal<Action>
	self.closed = Signal.new() :: Signal.Signal<>
	self.notice = Signal.new() :: Signal.Signal<string>

	local dimmer = Kit.button(root, "ModalDimmer")
	dimmer.Size = UDim2.fromScale(1, 1)
	dimmer.BackgroundColor3 = Color3.new(0, 0, 0)
	dimmer.BackgroundTransparency = 0.4
	dimmer.ZIndex = 50
	dimmer.Visible = false
	if Theme.caps.InputSink then
		pcall(function() (dimmer :: any).InputSink = (Enum :: any).InputSink.All end)
	end

	local card = Kit.frame(root, "Modal", 51)
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.fromScale(0.5, 0.5)
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.BackgroundColor3 = Color3.new(1, 1, 1)
	card.BackgroundTransparency = 0
	card.Active = true
	card.Visible = false
	Kit.corner(card, UDim.new(0, 0)) -- Sleek: square
	Kit.grad(card, { Theme.C.panel2, Theme.C.panel }, 90, nil, "Back")
	local rim = Kit.stroke(card, 2, Theme.C.strokeHi, 1, "Rim")
	Kit.list(card, "y", 14, Enum.HorizontalAlignment.Left)
	self.frame = card

	local kind: string? = nil
	local holds: { Recipes.Hold } = {}
	local conns: { RBXScriptConnection } = {}

	local function clear()
		for _, h in holds do h:destroy() end
		table.clear(holds)
		for _, c in conns do c:Disconnect() end
		table.clear(conns)
		for _, c in card:GetChildren() do
			if c:IsA("GuiObject") then c:Destroy() end
		end
	end

	local function close()
		if kind == nil then return end
		kind = nil
		clear()
		card.Visible = false
		dimmer.Visible = false
		self.closed:Fire()
	end
	dimmer.Activated:Connect(function()
		for _, h in holds do
			if h.holding then return end
		end
		close()
	end)

	-- ------------------------------------------------------------------------------------------ parts
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end
	local function head(title: string, sub: string?, hue: Color3, glyph: string?)
		local h = Kit.frame(card, "Head")
		h.LayoutOrder = nextOrder()
		h.AutomaticSize = Enum.AutomaticSize.Y
		h.Size = UDim2.fromScale(1, 0)
		local x0 = 0
		if glyph then
			local disc = Kit.frame(h, "Icon", 2)
			disc.Size = UDim2.fromOffset(48, 48)
			Kit.gem(disc, hue, { hi = 0.5, lo = 0.4 })
			Kit.stroke(disc, 2, Theme.lift(hue, 0.5), 0.9, "Rim")
			local g = Kit.glyph(disc, "Glyph", glyph, Color3.new(1, 1, 1), Theme.shade(hue, 0.6))
			g.AnchorPoint = Vector2.new(0.5, 0.5)
			g.Position = UDim2.fromScale(0.5, 0.5)
			g.Size = UDim2.fromScale(0.52, 0.52)
			g.ZIndex = 3
			x0 = 62
		end
		local t = Kit.label(h, "Title", "section", "", Color3.new(1, 1, 1))
		t.Position = UDim2.fromOffset(x0, 0)
		t.Size = UDim2.new(1, -x0, 0, 28)
		t.TextXAlignment = Enum.TextXAlignment.Left
		Recipes.title(t, { text = string.upper(title), role = "section", from = Color3.new(1, 1, 1), to = Theme.lift(hue, 0.45),
			stroke = 4, shadow = 3 })
		if sub then
			local s = Kit.label(h, "Sub", "small", sub, Theme.textHue(nil))
			s.TextColor3 = Theme.lift(hue, 0.35)
			s.Position = UDim2.fromOffset(x0, 32)
			s.Size = UDim2.new(1, -x0, 0, 18)
			s.TextXAlignment = Enum.TextXAlignment.Left
		end
	end
	local function para(name: string, text: string, role: string?, color: Color3?): TextLabel
		local l = Kit.label(card, name, role or "body", text, color or Theme.C.text)
		l.LayoutOrder = nextOrder()
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.Size = UDim2.fromScale(1, 0)
		l.TextWrapped = true
		l.RichText = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		return l
	end
	local function buttonRow(): Frame
		local r = Kit.frame(card, "Buttons")
		r.LayoutOrder = 1000
		r.Size = UDim2.new(1, 0, 0, 52)
		Kit.list(r, "x", 12, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
		return r
	end
	local function holdButton(parent: Instance, name: string, text: string, style: string, hue: Color3?, seconds: number,
		onDone: () -> ()): TextButton
		local b, l = Kit.action(parent, name, text, { style = style, hue = hue, h = 52 })
		local content = l.Parent :: Instance
		local ringG = Kit.glyph(content, "RingGlyph", "ring", Color3.new(1, 1, 1))
		ringG.LayoutOrder = 1
		ringG.Size = UDim2.fromOffset(18, 18)
		local chip, cl = Kit.chip(content, "Time", "badge", "", { h = 24, pad = 7, fg = Color3.new(1, 1, 1), bg = Theme.C.deep, bgA = 0.6 })
		chip.LayoutOrder = 3
		cl.RichText = true
		cl.Text = Rich.num(string.format("%g s", seconds), { size = Theme.size("badge"), onFill = true })
		table.insert(holds, Recipes.hold(b, { dur = seconds, ring = false, color = Color3.new(0, 0, 0), onDone = onDone }))
		return b
	end

	-- ------------------------------------------------------------------------------------------ kinds
	local function buildGate(g: Types.Gate?)
		local hue = CRIMSON
		rim.Color = hue
		if g == nil or not g.show then
			head("The rift is sealed", "The Prestige Multiverse", hue, "swirl")
			local req = g and g.req
			para("Body", "Reach 185 milestones to reveal the Prestige Multiverse.")
			if req then
				local rows = Kit.frame(card, "Rows")
				rows.LayoutOrder = nextOrder()
				rows.AutomaticSize = Enum.AutomaticSize.Y
				rows.Size = UDim2.fromScale(1, 0)
				Kit.list(rows, "y", 4)
				for i, kv in { { "Need", req.need .. " milestones" }, { "Have", req.have .. " milestones" } } do
					local r = Kit.frame(rows, "Row" .. i)
					r.LayoutOrder = i
					r.Size = UDim2.new(1, 0, 0, 22)
					local k = Kit.label(r, "Key", "small", kv[1], Theme.C.soft)
					k.Size = UDim2.fromScale(0.4, 1)
					k.TextXAlignment = Enum.TextXAlignment.Left
					local v = Kit.label(r, "Value", "number", "", Theme.C.text)
					v.AnchorPoint = Vector2.new(1, 0)
					v.Position = UDim2.fromScale(1, 0)
					v.Size = UDim2.fromScale(0.6, 1)
					v.TextXAlignment = Enum.TextXAlignment.Right
					v.RichText = true
					v.Text = Rich.num(kv[2], { size = Theme.size("number"), unit = Theme.C.soft })
				end
				local bar = Kit.frame(card, "Bar")
				bar.LayoutOrder = nextOrder()
				bar.Size = UDim2.new(1, 0, 0, 18)
				local track = Kit.frame(bar, "Track")
				track.AnchorPoint = Vector2.new(0, 0.5)
				track.Position = UDim2.fromScale(0, 0.5)
				track.Size = UDim2.new(1, -60, 0, 8)
				track.BackgroundColor3 = Theme.C.deep
				track.BackgroundTransparency = 0
				Kit.corner(track)
				local fill = Kit.frame(track, "Fill")
				fill.Size = UDim2.fromScale(math.clamp(req.pr / 1000, 0, 1), 1)
				fill.BackgroundColor3 = hue
				fill.BackgroundTransparency = 0
				Kit.corner(fill)
				local pct = Kit.label(bar, "Pct", "number", Rich.pct(req.pr / 1000), Theme.C.text)
				pct.AnchorPoint = Vector2.new(1, 0.5)
				pct.Position = UDim2.fromScale(1, 0.5)
				pct.Size = UDim2.fromOffset(56, 18)
				pct.TextXAlignment = Enum.TextXAlignment.Right
			end
			local row = buttonRow()
			local ok = Kit.action(row, "Secondary", Rich.caps("Close"), { style = "quiet" })
			ok.Activated:Connect(close)
			return
		end
		local gate = g :: Types.Gate
		head("Prestige Multiverse", if gate.inside then "MP challenge 21 · you are inside" else "MP challenge 21", hue, "swirl")
		-- the goal box
		local box = Kit.frame(card, "Goal")
		box.LayoutOrder = nextOrder()
		box.AutomaticSize = Enum.AutomaticSize.Y
		box.Size = UDim2.fromScale(1, 0)
		box.BackgroundColor3 = Theme.C.deep
		box.BackgroundTransparency = 0
		Kit.corner(box, UDim.new(0, 0)) -- Sleek: square
		Kit.stroke(box, 1.5, Theme.C.stroke, 1, "Rim")
		Kit.pad(box, 12, 14, 12, 14)
		Kit.list(box, "y", 6)
		local top = Kit.frame(box, "Top")
		top.LayoutOrder = 1
		top.Size = UDim2.new(1, 0, 0, 24)
		local cap = Kit.label(top, "Cap", "caps", Rich.caps("Goal"), Theme.C.soft)
		cap.Size = UDim2.fromScale(0.5, 1)
		cap.TextXAlignment = Enum.TextXAlignment.Left
		if gate.inside then
			local met = gate.fin
			local chip = Kit.chip(top, "State", "label", if met then "Goal met" else "Goal not met", { h = 24, pad = 10,
				fg = if met then Theme.C.ownedTitle else Theme.C.soft, bg = if met then Theme.shade(Theme.C.bought, 0.3) else Theme.C.panel3,
				bgA = 1, line = if met then Theme.C.bought else Theme.C.strokeHi, lineA = 1 })
			chip.AnchorPoint = Vector2.new(1, 0)
			chip.Position = UDim2.fromScale(1, 0)
		end
		local goalText = string.gsub(gate.goal or "", "^Goal:%s*", "")
		local gl = Kit.label(box, "Text", "body", "", Theme.C.text)
		gl.LayoutOrder = 2
		gl.AutomaticSize = Enum.AutomaticSize.Y
		gl.Size = UDim2.fromScale(1, 0)
		gl.TextWrapped = true
		gl.RichText = true
		gl.TextXAlignment = Enum.TextXAlignment.Left
		gl.Text = Rich.html(goalText, Theme.size("body"), "mp")
		if gate.done then
			para("Done", "You have completed it before.", "small", Theme.C.soft)
		end
		-- what happens
		local what: string
		local verb: string
		if gate.inside then
			if gate.fin then
				what = "Leaving now completes the challenge (+1) and returns you to the Normal Universe."
				verb = "Finish"
			else
				what = "Leaving now returns you to the Normal Universe without completing the challenge."
				verb = "Exit"
			end
		else
			local names = {}
			for _, l in gate.rs do table.insert(names, LAYER_NAMES[l] or string.upper(l)) end
			what = "Entering resets " .. table.concat(names, ", ") .. "."
			verb = "Enter"
		end
		para("What", what)
		local row = buttonRow()
		local stay = Kit.action(row, "Secondary", Rich.caps("Stay"), { style = "quiet" })
		stay.LayoutOrder = 1
		stay.Activated:Connect(close)
		if not gate.can and not gate.inside then
			local bar, bl = Kit.action(row, "Primary", "Unlock Multiverse (MP) first", { style = "quiet", role = "label" })
			bar.LayoutOrder = 2
			bar.Active = false
			bl.TextColor3 = Theme.C.soft
			return
		end
		local action = gate.a
		local b = holdButton(row, "Primary", Rich.caps("Hold to " .. string.lower(verb)), "gold", nil, 1.2, function()
			close()
			if action then self.act:Fire(action) end
		end)
		b.LayoutOrder = 2
	end

	-- ------------------------------------------------------------------------------------------ shop
	-- the passes and the Time Warps (shared/Products); owned passes come from the player's MT_Perks attribute. A
	-- press opens Roblox's purchase prompt; the server grants it (Shop.luau) and the list redraws.
	local function owned(): { [string]: boolean }
		local out: { [string]: boolean } = {}
		local lp = Players.LocalPlayer
		local raw = if lp then lp:GetAttribute("MT_Perks") else nil
		if type(raw) == "string" then
			local ok, list = pcall(function() return HttpService:JSONDecode(raw) end)
			if ok and type(list) == "table" then
				for _, k in list do
					if type(k) == "string" then out[k] = true end
				end
			end
		end
		return out
	end
	local function section(title: string)
		local l = Kit.label(card, "Section_" .. title, "caps", Rich.caps(title), GOLD)
		l.LayoutOrder = nextOrder()
		l.Size = UDim2.new(1, 0, 0, 18)
		l.TextXAlignment = Enum.TextXAlignment.Left
	end
	local function item(key: string, name: string, blurb: string, price: number, id: number?, icon: number?, have: boolean,
		buy: (id: number) -> ())
		local r = Kit.frame(card, "Item_" .. key)
		r.LayoutOrder = nextOrder()
		-- tall enough for a two-line blurb in Roblox's text (which runs a little taller than the design's)
		r.Size = UDim2.new(1, 0, 0, 86)
		r.BackgroundColor3 = Theme.C.deep
		r.BackgroundTransparency = 0.2
		Kit.stroke(r, 1, Color3.new(1, 1, 1), 0.12, "Hair").LineJoinMode = Enum.LineJoinMode.Miter
		-- the item's icon (the one Roblox shows for the pass / product), text to its right
		local tx = 16
		if icon then
			local im = Instance.new("ImageLabel")
			im.Name = "Icon"
			im.BackgroundTransparency = 1
			im.Image = "rbxassetid://" .. tostring(icon)
			im.Position = UDim2.fromOffset(9, 15)
			im.Size = UDim2.fromOffset(56, 56)
			im.ZIndex = r.ZIndex
			im.Parent = r
			tx = 78
		end
		local nm = Kit.label(r, "Name", "card", name, Color3.new(1, 1, 1))
		nm.Position = UDim2.fromOffset(tx, 12)
		nm.Size = UDim2.new(1, -174 - tx, 0, 24)
		nm.TextXAlignment = Enum.TextXAlignment.Left
		local bl = Kit.label(r, "Blurb", "small", blurb, Theme.C.soft)
		bl.Position = UDim2.fromOffset(tx, 38)
		bl.Size = UDim2.new(1, -174 - tx, 0, 42)
		bl.TextWrapped = true
		bl.TextXAlignment = Enum.TextXAlignment.Left
		bl.TextYAlignment = Enum.TextYAlignment.Top
		if have then
			local c, _ = Kit.chip(r, "Owned", "caps", Rich.caps("Owned"), { h = 30, pad = 12, fg = Theme.C.bought, bgA = 0,
				line = Theme.C.bought, lineA = 0.6 })
			c.AnchorPoint = Vector2.new(1, 0.5)
			c.Position = UDim2.new(1, -16, 0.5, 0)
		elseif id == nil then
			local c, _ = Kit.chip(r, "Soon", "caps", Rich.caps("Soon"), { h = 30, pad = 12, fg = Theme.C.muted, bgA = 0,
				line = Theme.C.muted, lineA = 0.5 })
			c.AnchorPoint = Vector2.new(1, 0.5)
			c.Position = UDim2.new(1, -16, 0.5, 0)
		else
			local b = Kit.action(r, "Buy", "R$ " .. tostring(price), { style = "gold", h = 44, w = 150, role = "cta" })
			b.AnchorPoint = Vector2.new(1, 0.5)
			b.Position = UDim2.new(1, -16, 0.5, 0)
			local pid = id :: number
			b.Activated:Connect(function() buy(pid) end)
		end
	end
	local function buildShop()
		rim.Color = GOLD
		head("Shop", "Every purchase supports the game. Thank you!", GOLD, "bag")
		local have = owned()
		local lp = Players.LocalPlayer
		section("Game passes")
		for _, p in Products.passes do
			item(p.key, p.name, p.blurb, p.price, p.id, p.icon, have[p.key] == true, function(id: number)
				pcall(function() MarketplaceService:PromptGamePassPurchase(lp, id) end)
			end)
		end
		section("Time Warp")
		for _, p in Products.products do
			item(p.key, p.name, p.blurb, p.price, p.id, p.icon, false, function(id: number)
				pcall(function() MarketplaceService:PromptProductPurchase(lp, id) end)
			end)
		end
		local row = buttonRow()
		local ok = Kit.action(row, "Close", Rich.caps("Close"), { style = "quiet" })
		ok.Activated:Connect(close)
	end

	-- the leaderboards (shared/Boards, server/Leaderboards): the boards as a tab strip (arrows step through them),
	-- the board's title and the player's own best, the top 50 (rank, avatar, name, value). A page comes from the
	-- Board remote and is kept PAGE_KEEP seconds here; a page that arrives after the window moved on is dropped
	local function buildRanks()
		rim.Color = CYAN
		head("Leaderboards", "Every stat. Each player's best ever, updated every few minutes.", CYAN, "podium")
		local compact = Layout.mode == "COMPACT"
		local tabs = Kit.frame(card, "Tabs")
		tabs.LayoutOrder = nextOrder()
		tabs.Size = UDim2.new(1, 0, 0, 44)
		local prev = Kit.action(tabs, "Prev", "‹", { style = "quiet", h = 36, w = 38, role = "section" })
		prev.Position = UDim2.fromOffset(0, 4)
		local nxt = Kit.action(tabs, "Next", "›", { style = "quiet", h = 36, w = 38, role = "section" })
		nxt.AnchorPoint = Vector2.new(1, 0)
		nxt.Position = UDim2.new(1, 0, 0, 4)
		local strip = Instance.new("ScrollingFrame")
		strip.Name = "Strip"
		strip.BackgroundTransparency = 1
		strip.BorderSizePixel = 0
		strip.Position = UDim2.fromOffset(46, 0)
		strip.Size = UDim2.new(1, -92, 0, 44)
		strip.ScrollingDirection = Enum.ScrollingDirection.X
		strip.ScrollBarThickness = 0
		strip.CanvasSize = UDim2.new()
		strip.AutomaticCanvasSize = Enum.AutomaticSize.X
		strip.ZIndex = card.ZIndex + 1
		strip.Parent = tabs
		Kit.list(strip, "x", 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)
		Kit.pad(strip, 4, 0, 4, 0)
		local tabOf: { [string]: TextButton } = {}
		for i, b in Boards.list do
			local t = Kit.button(strip, "Tab_" .. b.key)
			t.LayoutOrder = i
			t.Size = UDim2.fromOffset(0, 36)
			t.AutomaticSize = Enum.AutomaticSize.X
			t.BackgroundColor3 = Theme.C.deep
			t.BackgroundTransparency = 0.2
			Kit.pad(t, 0, 12, 0, 12)
			Kit.stroke(t, 1, Color3.new(1, 1, 1), 0.85, "Rim").LineJoinMode = Enum.LineJoinMode.Miter
			local l = Kit.label(t, "Label", "caps", Rich.caps(b.title), Theme.C.soft)
			l.AutomaticSize = Enum.AutomaticSize.X
			l.Size = UDim2.fromScale(0, 1)
			l.TextYAlignment = Enum.TextYAlignment.Center
			tabOf[b.key] = t
		end
		-- the board's title and the player's own best
		local info = Kit.frame(card, "Info")
		info.LayoutOrder = nextOrder()
		info.Size = UDim2.new(1, 0, 0, 30)
		local title = Kit.label(info, "Title", "card", "", Color3.new(1, 1, 1))
		title.Size = UDim2.new(0.55, 0, 1, 0)
		title.TextXAlignment = Enum.TextXAlignment.Left
		local you = Kit.label(info, "You", "label", "", CYAN)
		you.AnchorPoint = Vector2.new(1, 0)
		you.Position = UDim2.fromScale(1, 0)
		you.Size = UDim2.new(0.45, 0, 1, 0)
		you.TextXAlignment = Enum.TextXAlignment.Right
		you.RichText = true
		-- the list
		local list = Instance.new("ScrollingFrame")
		list.Name = "Rows"
		list.LayoutOrder = nextOrder()
		list.BackgroundColor3 = Theme.C.deep
		list.BackgroundTransparency = 0.35
		list.BorderSizePixel = 0
		list.Size = UDim2.new(1, 0, 0, if compact then 220 else 400)
		list.CanvasSize = UDim2.new()
		list.AutomaticCanvasSize = Enum.AutomaticSize.Y
		list.ScrollingDirection = Enum.ScrollingDirection.Y
		list.ScrollBarThickness = 4
		list.ScrollBarImageColor3 = CYAN
		list.ZIndex = card.ZIndex + 1
		list.Parent = card
		Kit.stroke(list, 1, Color3.new(1, 1, 1), 0.88, "Rim").LineJoinMode = Enum.LineJoinMode.Miter
		Kit.pad(list, 6, 10, 6, 6)
		Kit.list(list, "y", 4, Enum.HorizontalAlignment.Left)
		local status = Kit.label(card, "Status", "body", "", Theme.C.soft)
		status.LayoutOrder = nextOrder()
		status.Size = UDim2.new(1, 0, 0, 0)
		status.AutomaticSize = Enum.AutomaticSize.Y
		status.TextWrapped = true
		status.Visible = false

		local me = if Players.LocalPlayer then Players.LocalPlayer.UserId else 0
		local token = 0
		local function row(e: any)
			local r = Kit.frame(list, "Row_" .. tostring(e.rank))
			r.LayoutOrder = e.rank
			r.Size = UDim2.new(1, 0, 0, 44)
			r.BackgroundColor3 = if e.id == me then Theme.mix(Theme.C.deep, CYAN, 0.18) else Theme.C.panel2
			r.BackgroundTransparency = if e.id == me then 0.1 else 0.45
			local medal = MEDAL[e.rank]
			local rank = Kit.label(r, "Rank", "numberHeavy", "#" .. tostring(e.rank), medal or Theme.C.soft)
			rank.Position = UDim2.fromOffset(8, 0)
			rank.Size = UDim2.fromOffset(52, 44)
			rank.TextXAlignment = Enum.TextXAlignment.Left
			local av = Instance.new("ImageLabel")
			av.Name = "Avatar"
			av.BackgroundColor3 = Theme.C.deep
			av.BackgroundTransparency = 0.2
			av.BorderSizePixel = 0
			av.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(e.id) .. "&w=48&h=48"
			av.Position = UDim2.fromOffset(62, 5)
			av.Size = UDim2.fromOffset(34, 34)
			av.ZIndex = r.ZIndex
			av.Parent = r
			if medal then Kit.stroke(av, 2, medal, 0, "Rim") end
			local name = Kit.label(r, "Name", "card", tostring(e.name), Color3.new(1, 1, 1))
			name.Position = UDim2.fromOffset(106, 0)
			name.Size = UDim2.new(0.55, -106, 1, 0)
			name.TextXAlignment = Enum.TextXAlignment.Left
			name.TextTruncate = Enum.TextTruncate.AtEnd
			local value = Kit.label(r, "Value", "numberHeavy", tostring(e.value), medal or Theme.C.text)
			value.AnchorPoint = Vector2.new(1, 0)
			value.Position = UDim2.new(1, -8, 0, 0)
			value.Size = UDim2.new(0.45, -8, 1, 0)
			value.TextXAlignment = Enum.TextXAlignment.Right
		end
		local function show(key: string, page: any)
			for _, c in list:GetChildren() do
				if c:IsA("GuiObject") then c:Destroy() end
			end
			local b = Boards.get(key)
			title.Text = if b then b.title else key
			local mine = if type(page) == "table" then page.you else nil
			you.Text = if mine then Rich.caps("Your best") .. "   <b>" .. tostring(mine) .. "</b>" else ""
			if type(page) ~= "table" then
				status.Text = "Loading…"
				status.Visible = true
				return
			end
			if not page.ok then
				status.Text = tostring(page.error or "Leaderboards are unavailable right now.")
				status.Visible = true
				return
			end
			if #page.entries == 0 then
				status.Text = "Nobody is on this board yet. Play a little and check back in a few minutes."
				status.Visible = true
				return
			end
			status.Visible = false
			for _, e in page.entries do row(e) end
		end
		local function select(key: string)
			boardNow = key
			for k, t in tabOf do
				local on = k == key
				t.BackgroundColor3 = if on then CYAN else Theme.C.deep
				t.BackgroundTransparency = if on then 0.1 else 0.2
				local l = t:FindFirstChild("Label") :: TextLabel?
				if l then l.TextColor3 = if on then Color3.fromHex("06101b") else Theme.C.soft end
			end
			-- the selected tab in view
			local t = tabOf[key]
			if t then
				local x = t.AbsolutePosition.X - strip.AbsolutePosition.X + strip.CanvasPosition.X
				local s = math.max(Layout.s, 0.01)
				strip.CanvasPosition = Vector2.new(math.max(0, x - strip.AbsoluteSize.X / 2 + t.AbsoluteSize.X / 2), 0)
				local _ = s
			end
			token += 1
			local mine = token
			local hit = pageCache[key]
			if hit and os.clock() - hit.t < PAGE_KEEP then
				show(key, hit.page)
				return
			end
			show(key, nil)
			local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("MilestoneTreeRemotes")
			local fn = remotes and remotes:FindFirstChild("Board")
			if fn == nil or not fn:IsA("RemoteFunction") then
				show(key, { ok = false, error = "Leaderboards are not available on this server." })
				return
			end
			task.spawn(function()
				local ok, page = pcall(function() return (fn :: RemoteFunction):InvokeServer(key) end)
				if kind ~= "ranks" or token ~= mine then return end -- the window closed or moved on
				if not ok or type(page) ~= "table" then page = { ok = false, error = "Leaderboards are unavailable right now." } end
				if page.ok then pageCache[key] = { t = os.clock(), page = page } end
				show(key, page)
			end)
		end
		for key, t in tabOf do
			t.Activated:Connect(function() select(key) end)
		end
		local function step(d: number)
			local i = 1
			for j, b in Boards.list do
				if b.key == boardNow then i = j end
			end
			i = (i - 1 + d) % #Boards.list + 1
			select(Boards.list[i].key)
		end
		prev.Activated:Connect(function() step(-1) end)
		nxt.Activated:Connect(function() step(1) end)
		local rowB = buttonRow()
		local ok = Kit.action(rowB, "Close", Rich.caps("Close"), { style = "quiet" })
		ok.Activated:Connect(close)
		select(if Boards.get(boardNow) then boardNow else "points")
	end

	-- ------------------------------------------------------------------------------------------ API
	function self.open(_: Modals, k: string?, data: any?)
		if k == nil then
			close()
			return
		end
		clear()
		order = 0
		kind = k
		local compact = Layout.mode == "COMPACT"
		card.Size = UDim2.fromOffset(if compact then 520 else 600, 0)
		Kit.pad(card, if compact then 16 else 22, if compact then 18 else 24, if compact then 16 else 22, if compact then 18 else 24)
		if k == "gate" then
			buildGate(data)
		elseif k == "shop" then
			card.Size = UDim2.fromOffset(if compact then 560 else 680, 0)
			buildShop()
		elseif k == "ranks" then
			card.Size = UDim2.fromOffset(if compact then 600 else 720, 0)
			buildRanks()
		else
			para("Body", tostring(data or ""))
			local row = buttonRow()
			local ok = Kit.action(row, "Primary", Rich.caps("OK"), { style = "quiet" })
			ok.Activated:Connect(close)
		end
		card:SetAttribute("Kind", k)
		dimmer.Visible = true
		card.Visible = true
		local sc = Motion.scaleOf(card)
		sc.Scale = 0.96
		Motion.tween(sc, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }, "modalOpen")
	end
	-- a pass bought while the Shop is open: redraw it (OWNED)
	local lp = Players.LocalPlayer
	if lp then
		lp:GetAttributeChangedSignal("MT_Perks"):Connect(function()
			if kind == "shop" then self:open("shop") end
		end)
	end
	function self.isOpen(_: Modals): string?
		return kind
	end
	function self.destroy(m: Modals)
		clear()
		m.act:DisconnectAll()
		m.closed:DisconnectAll()
		m.notice:DisconnectAll()
		card:Destroy()
		dimmer:Destroy()
	end
	return self
end

return Modals
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="126">
            <Properties>
              <string name="Name">Overlay</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Overlay: the facade over OverlayGui (DESIGN.md 7): toasts and the notification list, the hover tooltip, the node
	peek, the modals (the Multiverse gate) and the full-screen states.

	    local overlay = Overlay.new(gui)
	    overlay:toasts(pops?, notices?)
	    overlay:tooltip(owner, content?, at?)      content = Tooltip.Content; nil hides that owner's tooltip
	    overlay:peek(layer?, node?, ring?)         the node peek (nil closes)
	    overlay:detail(card?)                      the touch detail sheet (Detail.luau); overlay:detailRefresh() after a patch
	    overlay:modal(kind?, data?)                "gate" | nil (any other kind shows data as text)
	    overlay:screen(kind?, data?)               "loading" | "fatal" | "outOfSync" | "end" | "firstRun" | nil
	    overlay:flash(color)                       overlay:onCamera(cam)       overlay:busy() -> modal / peek open
	    overlay:escape() -> boolean                Esc (Input/Hotkeys): closes the modal, else the peek, else the
	                                               detail sheet; false when nothing was open (App then closes the panel)
	    overlay.act (action, hold?), overlay.flyTo (layer), overlay.resync (),
	    overlay.openLayer (layer), overlay.peekClosed ()
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Signal = require(Core:WaitForChild("Signal"))
local Toasts = require(script.Parent:WaitForChild("Toasts"))
local Tooltip = require(script.Parent:WaitForChild("Tooltip"))
local Peek = require(script.Parent:WaitForChild("Peek"))
local Modals = require(script.Parent:WaitForChild("Modals"))
local Screens = require(script.Parent:WaitForChild("Screens"))
local Detail = require(script.Parent:WaitForChild("Detail"))
local Guide = require(script.Parent:WaitForChild("Guide"))

type Action = Types.Action
type ARect = Types.Rect

export type Overlay = {
	act: Signal.Signal<Action, boolean?>,
	flyTo: Signal.Signal<string>,
	resync: Signal.Signal<>,
	openLayer: Signal.Signal<string>,
	peekClosed: Signal.Signal<>,
	toasts: (self: Overlay, pops: { Types.Popup }?, notices: { string }?) -> (),
	guide: (self: Overlay, ctx: any) -> (),
	tooltip: (self: Overlay, owner: any, content: Tooltip.Content?, at: Vector2?) -> (),
	peek: (self: Overlay, layer: string?, node: Types.MapNode?, ring: ARect?) -> (),
	detail: (self: Overlay, card: any?) -> (),
	detailRefresh: (self: Overlay) -> (),
	modal: (self: Overlay, kind: string?, data: any?) -> (),
	screen: (self: Overlay, kind: string?, data: any?) -> (),
	flash: (self: Overlay, color: Color3) -> (),
	onCamera: (self: Overlay, cam: Types.Camera) -> (),
	busy: (self: Overlay) -> boolean,
	escape: (self: Overlay) -> boolean,
	destroy: (self: Overlay) -> (),
}

local Overlay = {}

function Overlay.new(gui: ScreenGui): Overlay
	local self = {} :: Overlay
	self.act = Signal.new() :: Signal.Signal<Action, boolean?>
	self.flyTo = Signal.new() :: Signal.Signal<string>
	self.resync = Signal.new() :: Signal.Signal<>
	self.openLayer = Signal.new() :: Signal.Signal<string>
	self.peekClosed = Signal.new() :: Signal.Signal<>

	local root = (gui:FindFirstChild("Root") or gui) :: GuiObject
	local toasts = Toasts.new(root)
	local tip = Tooltip.new(root)
	local peek = Peek.new(root)
	local modals = Modals.new(root)
	local screens = Screens.new(root)
	local detail = Detail.new(root)
	local guide = Guide.new(root)

	toasts.flyTo:Connect(function(l: string) self.flyTo:Fire(l) end)
	peek.open:Connect(function(l: string) self.openLayer:Fire(l) end)
	peek.act:Connect(function(a: Action) self.act:Fire(a, false) end)
	peek.closed:Connect(function()
		toasts:setCollapsed(false)
		self.peekClosed:Fire()
	end)
	modals.act:Connect(function(a: Action)
		self.act:Fire(a, false)
	end)
	modals.notice:Connect(function(t: string) toasts:push(nil, { t }) end)
	screens.act:Connect(function(a: Action) self.act:Fire(a, false) end)
	screens.resync:Connect(function() self.resync:Fire() end)
	detail.act:Connect(function(a: Action, hold: boolean) self.act:Fire(a, hold) end)

	-- the first-run tutorial (Guide.luau): App passes the game's state; hidden under full screens
	function self.guide(_: Overlay, ctx: any)
		if screens:current() ~= nil or modals:isOpen() then
			guide:hide()
			return
		end
		guide:update(ctx)
	end
	function self.toasts(_: Overlay, pops: { Types.Popup }?, notices: { string }?)
		toasts:push(pops, notices)
	end
	function self.tooltip(_: Overlay, owner: any, content: Tooltip.Content?, at: Vector2?)
		if peek:isOpen() or modals:isOpen() then
			tip:hide()
			return
		end
		tip:show(owner, content, at)
	end
	function self.peek(_: Overlay, layer: string?, node: Types.MapNode?, ring: ARect?)
		tip:hide()
		peek:show(layer, node, ring)
		toasts:setCollapsed(layer ~= nil)
	end
	function self.detail(_: Overlay, card: any?)
		tip:hide()
		if card then peek:show(nil) end
		detail:show(card)
	end
	function self.detailRefresh(_: Overlay)
		detail:refresh()
	end
	function self.modal(_: Overlay, kind: string?, data: any?)
		tip:hide()
		if kind then
			peek:show(nil)
			detail:show(nil)
		end
		modals:open(kind, data)
	end
	function self.screen(_: Overlay, kind: string?, data: any?)
		screens:show(kind, data)
	end
	function self.flash(_: Overlay, color: Color3)
		screens:flash(color)
	end
	function self.onCamera(_: Overlay, _cam: Types.Camera) end
	function self.busy(_: Overlay): boolean
		return peek:isOpen() ~= nil or modals:isOpen() ~= nil or detail:isOpen() ~= nil
	end
	function self.escape(_: Overlay): boolean
		if modals:isOpen() then
			modals:open(nil)
		elseif peek:isOpen() then
			peek:show(nil)
		elseif detail:isOpen() then
			detail:show(nil)
		else
			return false
		end
		tip:hide()
		return true
	end

	function self.destroy(o: Overlay)
		guide:destroy()
		toasts:destroy()
		detail:destroy()
		tip:destroy()
		peek:destroy()
		modals:destroy()
		screens:destroy()
		o.act:DisconnectAll()
		o.flyTo:DisconnectAll()
		o.resync:DisconnectAll()
		o.openLayer:DisconnectAll()
		o.peekClosed:DisconnectAll()
	end
	return self
end

return Overlay
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="127">
            <Properties>
              <string name="Name">Peek</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Peek: the node peek (DESIGN.md 7.2, mock j). A long-press (touch) or right-click on a node shows a scrim with a
	soft round hole over the node, and a 360 du card beside it: the emblem, the name (`card`), the amount (`number` +
	unit), the node's line as body text (have / need and the progress bar when locked), OPEN (`tab`) and the
	PRESTIGE hold (0.6 s, a ring glyph before the verb, the gain in a `badge` chip) when val.ra exists.
	Dismiss: a tap on the scrim, Esc, or the camera moving.

	The scrim is 4 dark frames around a square frame with a Radial transparency hole. The ramp can run to the square's
	corners, so the hole is fully transparent inside and reaches the scrim's alpha by t = .7 (the inscribed circle),
	staying there: the square never shows.

	    local peek = Peek.new(root)
	    peek:show(layer?, node?, ring?)      ring: the node's ring rect (abs); nil layer closes
	    peek.open (layer), peek.act (action), peek.closed ()
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Signal = require(Core:WaitForChild("Signal"))
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Motion = require(Core:WaitForChild("Motion"))
local Rich = require(Core:WaitForChild("Rich"))
local Recipes = require(Core:WaitForChild("Recipes"))
local Kit = require(script.Parent.Parent:WaitForChild("Hud"):WaitForChild("Kit"))
local Ready = require(script.Parent.Parent:WaitForChild("Hud"):WaitForChild("Ready"))
local MapLogic = require(script.Parent.Parent:WaitForChild("Map"):WaitForChild("MapLogic"))

type ARect = Types.Rect
type MapNode = Types.MapNode

export type Peek = {
	frame: Frame,
	open: Signal.Signal<string>,
	act: Signal.Signal<Types.Action>,
	closed: Signal.Signal<>,
	show: (self: Peek, layer: string?, node: MapNode?, ring: ARect?) -> (),
	isOpen: (self: Peek) -> string?,
	destroy: (self: Peek) -> (),
}

local Peek = {}

local SCRIM_A = 0.62
local TITLES = {
	m = "Milestone", mm = "Meta-Milestone", em = "Extra-Milestone", p = "Prestige", pe = "Prestige Energy", sp = "Super Prestige",
	pb = "Prestige Boost", pp = "Prestige Power", se = "Super Energy", hp = "Hyper Prestige", ep = "Exotic Prestige",
	hb = "Hyper Boost", ap = "Atomic Prestige", mp = "Multiverse", t = "Transcend", pep = "Prestiged Exotic",
	cp = "Corrupted", cm = "Corrupted Milestone", ex = "Exploration", ach = "Achievements",
} :: { [string]: string }

function Peek.new(root: GuiObject): Peek
	local self = {} :: Peek
	self.open = Signal.new() :: Signal.Signal<string>
	self.act = Signal.new() :: Signal.Signal<Types.Action>
	self.closed = Signal.new() :: Signal.Signal<>

	local f = Kit.frame(root, "Peek", 30)
	f.Size = UDim2.fromScale(1, 1)
	f.Visible = false
	self.frame = f
	-- the scrim
	local parts: { [string]: TextButton } = {}
	for _, n in { "Top", "Bottom", "Left", "Right", "Hole" } do
		local p = Kit.button(f, "Scrim" .. n)
		p.BackgroundColor3 = Color3.new(0, 0, 0)
		p.BackgroundTransparency = SCRIM_A
		p.ZIndex = 1
		parts[n] = p
		p.Activated:Connect(function() self:show(nil) end)
	end
	local hg = Kit.child(parts.Hole, "Hole", "UIGradient") :: UIGradient
	if Theme.caps.Radial then
		hg.Type = Enum.GradientType.Radial
		hg.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.36, 1),
			NumberSequenceKeypoint.new(0.7, 0),
			NumberSequenceKeypoint.new(1, 0),
		})
	end

	local card = Kit.frame(f, "Card", 5)
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.BackgroundColor3 = Color3.new(1, 1, 1)
	card.BackgroundTransparency = 0.02
	card.Active = true
	Kit.corner(card, UDim.new(0, 0)) -- Sleek: square
	Kit.grad(card, { Theme.C.panel2, Theme.C.panel }, 90, nil, "Back")
	local rim = Kit.stroke(card, 2, Theme.C.strokeHi, 1, "Rim")
	Kit.pad(card, 16, 18, 16, 18)
	Kit.list(card, "y", 10, Enum.HorizontalAlignment.Left)

	local head = Kit.frame(card, "Head")
	head.LayoutOrder = 1
	head.Size = UDim2.new(1, 0, 0, 52)
	local titleL = Kit.label(head, "Title", "card", "", Color3.new(1, 1, 1))
	titleL.Position = UDim2.fromOffset(64, 4)
	titleL.Size = UDim2.new(1, -64, 0, 24)
	titleL.TextXAlignment = Enum.TextXAlignment.Left
	titleL.TextTruncate = Enum.TextTruncate.AtEnd
	local amountL = Kit.label(head, "Amount", "number", "", Theme.C.text)
	amountL.Position = UDim2.fromOffset(64, 30)
	amountL.Size = UDim2.new(1, -64, 0, 20)
	amountL.TextXAlignment = Enum.TextXAlignment.Left
	amountL.RichText = true
	amountL.TextTruncate = Enum.TextTruncate.AtEnd

	local body = Kit.label(card, "Body", "body", "", Theme.C.text)
	body.LayoutOrder = 2
	body.AutomaticSize = Enum.AutomaticSize.Y
	body.Size = UDim2.fromScale(1, 0)
	body.TextWrapped = true
	body.RichText = true
	body.TextXAlignment = Enum.TextXAlignment.Left
	body.TextTransparency = 0.08

	local bar = Kit.frame(card, "Bar")
	bar.LayoutOrder = 3
	bar.Size = UDim2.new(1, 0, 0, 18)
	local track = Kit.frame(bar, "Track")
	track.AnchorPoint = Vector2.new(0, 0.5)
	track.Position = UDim2.fromScale(0, 0.5)
	track.Size = UDim2.new(1, -56, 0, 6)
	track.BackgroundColor3 = Theme.C.deep
	track.BackgroundTransparency = 0
	Kit.corner(track)
	local fill = Kit.frame(track, "Fill")
	fill.BackgroundTransparency = 0
	Kit.corner(fill)
	local pct = Kit.label(bar, "Pct", "number", "", Theme.C.text)
	pct.AnchorPoint = Vector2.new(1, 0.5)
	pct.Position = UDim2.fromScale(1, 0.5)
	pct.Size = UDim2.fromOffset(52, 18)
	pct.TextXAlignment = Enum.TextXAlignment.Right

	local buttons = Kit.frame(card, "Buttons")
	buttons.LayoutOrder = 4
	buttons.Size = UDim2.new(1, 0, 0, 52)
	Kit.list(buttons, "x", 10, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)

	local layer: string? = nil
	local hold: Recipes.Hold? = nil
	local shownAt: ARect? = nil

	local function setHole(r: ARect?)
		local s = Layout.s
		local ra = root.AbsolutePosition
		local top, bottom, left, right, h = parts.Top, parts.Bottom, parts.Left, parts.Right, parts.Hole
		if r == nil or not Theme.caps.Radial then
			top.Position = UDim2.new()
			top.Size = UDim2.fromScale(1, 1)
			for _, p in { bottom, left, right, h } do p.Visible = false end
			return
		end
		local rr = r :: ARect
		local cx, cy = (rr.x + rr.w / 2 - ra.X) / s, (rr.y + rr.h / 2 - ra.Y) / s
		local side = math.max(rr.w, rr.h) * 1.7 / s
		local x0, y0 = cx - side / 2, cy - side / 2
		top.Position = UDim2.new()
		top.Size = UDim2.new(1, 0, 0, math.max(0, y0))
		bottom.Position = UDim2.fromOffset(0, y0 + side)
		bottom.Size = UDim2.new(1, 0, 1, -(y0 + side))
		left.Position = UDim2.fromOffset(0, y0)
		left.Size = UDim2.fromOffset(math.max(0, x0), side)
		right.Position = UDim2.fromOffset(x0 + side, y0)
		right.Size = UDim2.new(1, -(x0 + side), 0, side)
		h.Position = UDim2.fromOffset(x0, y0)
		h.Size = UDim2.fromOffset(side, side)
		h.BackgroundTransparency = 0
		for _, p in { top, bottom, left, right, h } do p.Visible = true end
		-- the hole frame is transparent inside: the scrim's alpha lives in the gradient
		h.BackgroundTransparency = 0
		hg.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.36, 1),
			NumberSequenceKeypoint.new(0.7, SCRIM_A),
			NumberSequenceKeypoint.new(1, SCRIM_A),
		})
	end

	local function placeCard(r: ARect?)
		local s = Layout.s
		local ra, rs = root.AbsolutePosition, root.AbsoluteSize
		local W, H = rs.X / s, rs.Y / s
		local w = if Layout.mode == "COMPACT" then 320 else 360
		card.Size = UDim2.fromOffset(w, 0)
		local h = math.max(160, card.AbsoluteSize.Y / s)
		local x, y = (W - w) / 2, (H - h) / 2
		if r then
			local cx, cy = (r.x + r.w / 2 - ra.X) / s, (r.y + r.h / 2 - ra.Y) / s
			local half = math.max(r.w, r.h) / s * 0.85
			x = if cx + half + 16 + w <= W - 8 then cx + half + 16 else cx - half - 16 - w
			y = cy - h / 2
		end
		card.Position = UDim2.fromOffset(math.floor(math.clamp(x, 8, math.max(8, W - w - 8))), math.floor(math.clamp(y, 8, math.max(8, H - h - 8))))
	end

	local function clearButtons()
		if hold then
			(hold :: Recipes.Hold):destroy()
			hold = nil
		end
		for _, c in buttons:GetChildren() do
			if c:IsA("GuiObject") then c:Destroy() end
		end
	end

	function self.show(p: Peek, l: string?, node: MapNode?, ring: ARect?)
		if l == nil then
			if layer ~= nil then
				layer = nil
				clearButtons()
				f.Visible = false
				p.closed:Fire()
			end
			return
		end
		local lay = l :: string
		layer = lay
		shownAt = ring
		local hue = Theme.hue(lay)
		local v = node and node.val
		rim.Color = Theme.lift(hue, 0.25)
		local old = head:FindFirstChild("Emblem")
		if old then old:Destroy() end
		local g = Ready.gem(head, "Emblem", lay, (node and node.sym) or string.upper(lay), 52)
		g.Position = UDim2.fromOffset(0, 0)
		titleL.Text = string.upper(TITLES[lay] or (node and node.name) or lay)
		Theme.text(titleL, "card")
		local lit = v ~= nil and v.lit
		if v and lit then
			local pts = v.pts or "0"
			if lay == "ach" and v.tot then pts = pts .. " / " .. v.tot end
			local res = MapLogic.plain(v.res)
			amountL.Text = Rich.num(pts .. (if res ~= "" then " " .. res else ""), { size = Theme.size("number"), unit = Theme.C.soft })
		else
			amountL.Text = if v and v.req then Rich.num("Need " .. v.req .. " " .. MapLogic.unit(v.rres), { size = Theme.size("number"), unit = Theme.C.soft }) else ""
		end
		local tip = v and v.tip
		body.Text = if tip then Rich.html(tip, Theme.size("body"), lay) else ""
		body.Visible = body.Text ~= ""
		Theme.text(body, "body")
		local prv = v and v.pr
		bar.Visible = prv ~= nil and not lit
		if prv then
			local pr = math.clamp(prv / 1000, 0, 1)
			fill.Size = UDim2.fromScale(pr, 1)
			fill.BackgroundColor3 = Theme.lift(hue, 0.1)
			pct.Text = Rich.pct(pr)
		end
		clearButtons()
		if node and node.show then
			local ob, ol = Kit.action(buttons, "Open", Rich.caps("Open"), { style = "quiet", h = 52 })
			ob.LayoutOrder = 1
			local chev = Kit.glyph(ol.Parent :: Instance, "Chev", "chev", Color3.new(1, 1, 1))
			chev.LayoutOrder = 3
			chev.Size = UDim2.fromOffset(12, 12)
			ob.Activated:Connect(function()
				p:show(nil)
				p.open:Fire(lay)
			end)
		end
		local ra = v and v.ra
		if ra and node then
			local pb, pl = Kit.action(buttons, "Prestige", Rich.caps("Prestige"), { style = "primary", hue = hue, h = 52 })
			pb.LayoutOrder = 2
			local content = pl.Parent :: Instance
			local ringG = Kit.glyph(content, "RingGlyph", "ring", Color3.new(1, 1, 1))
			ringG.LayoutOrder = 1
			ringG.Size = UDim2.fromOffset(16, 16)
			local gain = v and v.gain
			if gain then
				local chip, cl = Kit.chip(content, "Gain", "badge", "", { h = 26, pad = 8, fg = Color3.new(1, 1, 1), bg = Theme.C.deep,
					bgA = 0.55 })
				chip.LayoutOrder = 3
				cl.RichText = true
				cl.Text = Rich.num("+" .. Rich.short(gain), { size = Theme.size("badge"), onFill = true })
			end
			local action = ra
			hold = Recipes.hold(pb, { dur = 0.6, ring = false, color = Color3.new(0, 0, 0), onDone = function()
				p.act:Fire(action)
				p:show(nil)
			end })
		end
		buttons.Visible = #buttons:GetChildren() > 1
		setHole(ring)
		f.Visible = true
		placeCard(ring)
		task.defer(function()
			if layer == lay then placeCard(shownAt) end
		end)
		local sc = Motion.scaleOf(card)
		sc.Scale = 0.96
		Motion.tween(sc, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }, "peekOpen")
	end
	function self.isOpen(_: Peek): string?
		return layer
	end
	function self.destroy(p: Peek)
		clearButtons()
		p.open:DisconnectAll()
		p.act:DisconnectAll()
		p.closed:DisconnectAll()
		f:Destroy()
	end
	return self
end

return Peek
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="128">
            <Properties>
              <string name="Name">Screens</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Screens: the full-screen states of DESIGN.md 7.10-7.12 (mock j).

	    loading    the ReplicatedFirst BootScreen (src/first) when the place has it: status + progress go to it, and
	               leaving "loading" fades it out (App leaves it once the first view is drawn AND Core/Preload has
	               fetched the images, or timed out); else the fallback card: THE MILESTONE TREE, a progress bar, LOADING…
	    fatal      the error text with "Your save is safe on the server."
	    outOfSync  OUT OF SYNC · the screen stopped updating · RESYNC (fires `resync`)
	    end        the star emblem, YOU BEAT THE GAME!, the win text on a scrim band, IT TOOK YOU <took>,
	               PLAY AGAIN (2 s hold) and KEEP GOING (their actions come from the view's end screen)
	    firstRun   drawn on the map by Nodes (the START HERE cue); nothing here

	    local screens = Screens.new(root)
	    screens:show(kind?, data?)     nil hides; loading data = { done, total } or a status string
	    screens:flash(color)           a full-screen colour flash (universe change, hard reset)
	    screens.act (action), screens.resync ()
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Signal = require(Core:WaitForChild("Signal"))
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Motion = require(Core:WaitForChild("Motion"))
local Rich = require(Core:WaitForChild("Rich"))
local Recipes = require(Core:WaitForChild("Recipes"))
local Kit = require(script.Parent.Parent:WaitForChild("Hud"):WaitForChild("Kit"))

export type Screens = {
	frame: Frame,
	act: Signal.Signal<Types.Action>,
	resync: Signal.Signal<>,
	show: (self: Screens, kind: string?, data: any?) -> (),
	flash: (self: Screens, color: Color3) -> (),
	current: (self: Screens) -> string?,
	destroy: (self: Screens) -> (),
}

local Screens = {}

local GOLD = Color3.fromHex("ffc233")

function Screens.new(root: GuiObject): Screens
	local self = {} :: Screens
	self.act = Signal.new() :: Signal.Signal<Types.Action>
	self.resync = Signal.new() :: Signal.Signal<>

	local f = Kit.button(root, "Screen")
	f.Size = UDim2.fromScale(1, 1)
	f.ZIndex = 80
	f.BackgroundTransparency = 0
	f.BackgroundColor3 = Theme.C.void
	f.Visible = false
	if Theme.caps.InputSink then
		pcall(function() (f :: any).InputSink = (Enum :: any).InputSink.All end)
	end
	self.frame = f :: any

	local flashF = Kit.frame(root, "Flash", 90)
	flashF.Size = UDim2.fromScale(1, 1)
	flashF.BackgroundTransparency = 1
	flashF.Visible = false
	pcall(function() flashF.Interactable = false end)

	local kind: string? = nil
	local holds: { Recipes.Hold } = {}
	local bar: Frame? = nil
	local barPct: TextLabel? = nil
	local statusL: TextLabel? = nil

	local function clear()
		for _, h in holds do h:destroy() end
		table.clear(holds)
		for _, c in f:GetChildren() do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		bar, barPct, statusL = nil, nil, nil
	end

	local function card(name: string, w: number, hue: Color3): Frame
		local c = Kit.frame(f, name, 2)
		c.AnchorPoint = Vector2.new(0.5, 0.5)
		c.Position = UDim2.fromScale(0.5, 0.5)
		c.AutomaticSize = Enum.AutomaticSize.Y
		c.Size = UDim2.fromOffset(math.min(w, Layout.canvas.X - 32), 0)
		c.BackgroundColor3 = Color3.new(1, 1, 1)
		c.BackgroundTransparency = 0
		Kit.corner(c, UDim.new(0, 0)) -- Sleek: square
		Kit.grad(c, { Theme.C.panel2, Theme.C.panel }, 90, nil, "Back")
		Kit.stroke(c, 2, hue, 1, "Rim")
		Kit.pad(c, 24, 28, 24, 28)
		Kit.list(c, "y", 14, Enum.HorizontalAlignment.Left)
		return c
	end
	local function title(parent: Instance, order: number, text: string, hue: Color3, role: string, size: number?): TextLabel
		local t = Kit.label(parent, "Title", role, "", Color3.new(1, 1, 1))
		t.LayoutOrder = order
		t.Size = UDim2.new(1, 0, 0, (size or Theme.size(role)) + 8)
		t.TextXAlignment = Enum.TextXAlignment.Left
		Recipes.title(t, { text = string.upper(text), role = role, from = Color3.new(1, 1, 1), to = Theme.lift(hue, 0.45),
			stroke = if (size or Theme.size(role)) >= 40 then 6 else 4, shadow = if (size or Theme.size(role)) >= 40 then 4 else 3, size = size })
		return t
	end
	local function text(parent: Instance, order: number, s: string, role: string?, color: Color3?): TextLabel
		local l = Kit.label(parent, "Text" .. order, role or "body", s, color or Theme.C.text)
		l.LayoutOrder = order
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.Size = UDim2.fromScale(1, 0)
		l.TextWrapped = true
		l.RichText = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		return l
	end

	-- ReplicatedFirst.MilestoneTreeBoot.BootScreen (the first-frame loading screen), when the place has it
	local bootMod: any = nil
	local function bootScreen(): any
		if bootMod ~= nil then return if bootMod == false then nil else bootMod end
		local rf = game:GetService("ReplicatedFirst")
		local folder = rf:FindFirstChild("MilestoneTreeBoot")
		local m = folder and folder:FindFirstChild("BootScreen")
		if m and m:IsA("ModuleScript") then
			local ok, mod = pcall(require, m)
			bootMod = if ok then mod else false
		else
			bootMod = false
		end
		return if bootMod == false then nil else bootMod
	end
	local function buildLoading(data: any)
		f.BackgroundColor3 = Theme.C.void
		f.BackgroundTransparency = 0
		local c = card("Card", 620, Theme.hue("m"))
		title(c, 1, "The Milestone Tree", Theme.hue("m"), "title", if Layout.mode == "COMPACT" then 27 else 40)
		local b = Kit.frame(c, "Bar")
		b.LayoutOrder = 2
		b.Size = UDim2.new(1, 0, 0, 20)
		local track = Kit.frame(b, "Track")
		track.AnchorPoint = Vector2.new(0, 0.5)
		track.Position = UDim2.fromScale(0, 0.5)
		track.Size = UDim2.new(1, -64, 0, 10)
		track.BackgroundColor3 = Theme.C.deep
		track.BackgroundTransparency = 0
		Kit.corner(track)
		local fill = Kit.frame(track, "Fill")
		fill.Size = UDim2.fromScale(0, 1)
		fill.BackgroundColor3 = Color3.new(1, 1, 1)
		fill.BackgroundTransparency = 0
		Kit.grad(fill, { Theme.hue("m"), Theme.lift(Theme.hue("m"), 0.3) }, 0)
		Kit.corner(fill)
		local pct = Kit.label(b, "Pct", "number", "", Theme.C.text)
		pct.AnchorPoint = Vector2.new(1, 0.5)
		pct.Position = UDim2.fromScale(1, 0.5)
		pct.Size = UDim2.fromOffset(60, 20)
		pct.TextXAlignment = Enum.TextXAlignment.Right
		bar, barPct = fill, pct
		statusL = text(c, 3, Rich.caps("Loading the realm…"), "caps", Theme.C.soft)
		local _ = data
	end
	local function setLoading(data: any)
		local fill, pct = bar, barPct
		if type(data) == "table" and type(data.done) == "number" and type(data.total) == "number" and fill and pct then
			local p = if data.total > 0 then math.clamp(data.done / data.total, 0, 1) else 1
			fill.Size = UDim2.fromScale(p, 1)
			pct.Text = Rich.pct(p)
		elseif type(data) == "string" and statusL then
			(statusL :: TextLabel).Text = Rich.caps(data)
		end
	end

	local function buildFatal(data: any)
		f.BackgroundColor3 = Theme.C.void
		f.BackgroundTransparency = 0.05
		local c = card("Card", 620, Theme.C.danger)
		title(c, 1, "Something went wrong", Theme.C.danger, "section")
		text(c, 2, Rich.html(tostring(data or ""), Theme.size("body"), nil))
		text(c, 3, "Your save is safe on the server.", "small", Theme.C.soft)
	end

	local function buildOutOfSync()
		f.BackgroundColor3 = Color3.new(0, 0, 0)
		f.BackgroundTransparency = 0.35
		local c = card("Card", 560, Theme.C.info)
		title(c, 1, "Out of sync", Theme.C.info, "section")
		text(c, 2, "The screen stopped updating.\nYour save is safe on the server.")
		local row = Kit.frame(c, "Buttons")
		row.LayoutOrder = 3
		row.Size = UDim2.new(1, 0, 0, 52)
		local b = Kit.action(row, "Primary", Rich.caps("Resync"), { style = "primary", hue = Theme.C.info, role = "cta" })
		b.Size = UDim2.new(1, 0, 0, 52)
		b.AutomaticSize = Enum.AutomaticSize.None
		b.Activated:Connect(function() self.resync:Fire() end)
	end

	local function buildEnd(data: any)
		f.BackgroundColor3 = Color3.fromHex("0c0812")
		f.BackgroundTransparency = 0
		local g = Kit.grad(f, { Color3.fromHex("2a2008"), Color3.fromHex("0c0812") }, 90, nil, "Back")
		local _ = g
		local col = Kit.frame(f, "End", 2)
		col.AnchorPoint = Vector2.new(0.5, 0.5)
		col.Position = UDim2.fromScale(0.5, 0.5)
		col.AutomaticSize = Enum.AutomaticSize.Y
		col.Size = UDim2.fromOffset(math.min(820, Layout.canvas.X - 32), 0)
		Kit.list(col, "y", 16, Enum.HorizontalAlignment.Center)
		local star = Kit.frame(col, "Emblem", 2)
		star.LayoutOrder = 1
		star.Size = UDim2.fromOffset(96, 96)
		Kit.gem(star, GOLD, { hi = 0.6, lo = 0.5 })
		Kit.stroke(star, 3, Color3.fromHex("fff1b8"), 1, "Rim")
		local sg = Kit.glyph(star, "Star", "star", Color3.new(1, 1, 1))
		sg.AnchorPoint = Vector2.new(0.5, 0.5)
		sg.Position = UDim2.fromScale(0.5, 0.5)
		sg.Size = UDim2.fromScale(0.5, 0.5)
		sg.ZIndex = 4
		local compact = Layout.mode == "COMPACT"
		local t = title(col, 2, "You beat the game!", GOLD, "title", if compact then 36 else 64)
		t.TextXAlignment = Enum.TextXAlignment.Center
		for _, n in { "Shadow", "Fill" } do
			local x = t:FindFirstChild(n) :: TextLabel?
			if x then x.TextXAlignment = Enum.TextXAlignment.Center end
		end
		local d = if type(data) == "table" then data else {}
		local band = Kit.frame(col, "Band", 2)
		band.LayoutOrder = 3
		band.AutomaticSize = Enum.AutomaticSize.Y
		band.Size = UDim2.new(0.8, 0, 0, 0)
		band.BackgroundColor3 = Color3.new(0, 0, 0)
		band.BackgroundTransparency = 0.5
		Kit.corner(band, UDim.new(0, 0)) -- Sleek: square
		Kit.pad(band, 12, 18, 12, 18)
		local win = Kit.label(band, "Win", "body", "", Theme.C.text)
		win.AutomaticSize = Enum.AutomaticSize.Y
		win.Size = UDim2.fromScale(1, 0)
		win.TextWrapped = true
		win.RichText = true
		win.Text = Rich.html(if type(d.win) == "string" then d.win else "You have reached the end.", Theme.size("body"), nil)
		if type(d.took) == "string" then
			local chip = Kit.frame(col, "Took", 2)
			chip.LayoutOrder = 4
			chip.AutomaticSize = Enum.AutomaticSize.X
			chip.Size = UDim2.fromOffset(0, 30)
			chip.BackgroundColor3 = Theme.C.deep
			chip.BackgroundTransparency = 0.1
			Kit.corner(chip)
			Kit.stroke(chip, 1.5, GOLD, 1, "Rim")
			Kit.pad(chip, 0, 14, 0, 14)
			Kit.list(chip, "x", 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
			local k = Kit.label(chip, "Key", "caps", Rich.caps("It took you"), Color3.fromHex("ffe9a3"))
			k.LayoutOrder = 1
			k.AutomaticSize = Enum.AutomaticSize.X
			k.Size = UDim2.fromScale(0, 1)
			local v = Kit.label(chip, "Value", "number", "", Color3.new(1, 1, 1))
			v.LayoutOrder = 2
			v.AutomaticSize = Enum.AutomaticSize.X
			v.Size = UDim2.fromScale(0, 1)
			v.RichText = true
			v.Text = Rich.num(d.took, { size = Theme.size("number"), unit = Theme.C.soft })
		end
		local row = Kit.frame(col, "Buttons", 2)
		row.LayoutOrder = 5
		row.AutomaticSize = Enum.AutomaticSize.X
		row.Size = UDim2.fromOffset(0, 56)
		Kit.list(row, "x", 16, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		if type(d.again) == "table" then
			local again = d.again
			local b, l = Kit.action(row, "Again", Rich.caps("Play again"), { style = "quiet", h = 52 })
			b.LayoutOrder = 1
			local content = l.Parent :: Instance
			local rg = Kit.glyph(content, "RingGlyph", "ring", Color3.new(1, 1, 1))
			rg.LayoutOrder = 1
			rg.Size = UDim2.fromOffset(18, 18)
			local chip, cl = Kit.chip(content, "Time", "badge", "2 s", { h = 24, pad = 7, fg = Color3.new(1, 1, 1), bg = Theme.C.deep, bgA = 0.6 })
			chip.LayoutOrder = 3
			local _ = cl
			table.insert(holds, Recipes.hold(b, { dur = 2, ring = false, color = Color3.new(0, 0, 0), onDone = function()
				self.act:Fire(again)
			end }))
		end
		if type(d.keep) == "table" then
			local keep = d.keep
			local b = Kit.action(row, "Keep", Rich.caps("Keep going"), { style = "gold", h = 52, role = "cta" })
			b.LayoutOrder = 2
			b.Activated:Connect(function() self.act:Fire(keep) end)
		end
	end

	function self.show(_: Screens, k: string?, data: any?)
		-- the loading screen is the ReplicatedFirst one (up since the first frame); the card below is its fallback
		local boot = bootScreen()
		if boot then
			if k == "loading" then
				boot.claim()
				boot.set(data)
				kind = "loading"
				clear()
				f.BackgroundTransparency = 1
				f:SetAttribute("Kind", k)
				f.Visible = true
				return
			elseif boot.visible() then
				boot.hide()
			end
		end
		if k == "loading" and kind == "loading" then
			setLoading(data)
			return
		end
		if k == nil or k == "firstRun" then
			kind = nil
			clear()
			f.Visible = false
			return
		end
		clear()
		local old = f:FindFirstChild("Back")
		if old then old:Destroy() end
		kind = k
		if k == "loading" then
			buildLoading(data)
			setLoading(data)
		elseif k == "fatal" then
			buildFatal(data)
		elseif k == "outOfSync" then
			buildOutOfSync()
		elseif k == "end" then
			buildEnd(data)
		end
		f:SetAttribute("Kind", k)
		f.Visible = true
	end
	function self.flash(_: Screens, color: Color3)
		flashF.BackgroundColor3 = color
		flashF.BackgroundTransparency = 0.4
		flashF.Visible = true
		Motion.tween(flashF, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }, "screenFlash", true)
		task.delay(0.65, function() flashF.Visible = false end)
	end
	function self.current(_: Screens): string?
		return kind
	end
	function self.destroy(s: Screens)
		clear()
		s.act:DisconnectAll()
		s.resync:DisconnectAll()
		f:Destroy()
		flashF:Destroy()
	end
	return self
end

return Screens
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="129">
            <Properties>
              <string name="Name">ToastModel</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ToastModel: the pure bookkeeping behind the toasts (DESIGN.md 4.7): coalescing, the ×N count, the sub line of a
	merged toast (a count or a range, never joined names), expiry and the notification history (the last 20).
	No Roblox services: the unit tests run it under plain luau (port/tests/unit/overlay.luau).

	    local model = ToastModel.new()
	    local t, merged = model:push({ kind, title, sub, layer }, now)   -- kind: milestone | achievement | corruption |
	                                                                     -- other | notice
	    model:active(now)          the live toasts, newest first
	    model:history()            the last 20 (newest first); model:clear()
	    ToastModel.kindOf(pop)     the view's kind, else guessed from title / type
	    ToastModel.plain(html)     the popup message as plain text
]]

local ToastModel = {}

export type Item = { kind: string, title: string, sub: string, layer: string? }
export type Toast = {
	id: number,
	kind: string,
	title: string,
	sub: string,
	layer: string?,
	count: number,
	subs: { string },
	born: number, -- the last push (a merge restarts the life)
	life: number,
}
export type Model = {
	push: (self: Model, item: Item, now: number) -> (Toast, boolean),
	active: (self: Model, now: number) -> { Toast },
	history: (self: Model) -> { Toast },
	clear: (self: Model) -> (),
}

ToastModel.LIFE = 4
ToastModel.NOTICE_LIFE = 6
ToastModel.HISTORY = 20

function ToastModel.plain(s: string?): string
	if s == nil then return "" end
	local t = string.gsub(s, "<br%s*/?>", " ")
	t = string.gsub(t, "<[^>]*>", "")
	t = string.gsub(t, "&nbsp;", " ")
	t = string.gsub(t, "&lt;", "<")
	t = string.gsub(t, "&gt;", ">")
	t = string.gsub(t, "&amp;", "&")
	t = string.gsub(t, "%s+", " ")
	t = string.gsub(t, "^ ", "")
	t = string.gsub(t, " $", "")
	return t
end

function ToastModel.kindOf(p: { [string]: any }): string
	local k = p.kind
	if type(k) == "string" and k ~= "" and k ~= "other" then return k end
	local title = if type(p.title) == "string" then string.lower(p.title) else ""
	local ty = if type(p.type) == "string" then p.type else ""
	if ty == "milestone" or string.find(title, "milestone", 1, true) then return "milestone" end
	if ty == "achievement" or string.find(title, "achievement", 1, true) then return "achievement" end
	if string.find(title, "corruption", 1, true) then return "corruption" end
	if string.find(title, "challenge", 1, true) then return "challenge" end
	return if type(k) == "string" and k ~= "" then k else "other"
end

-- "18th Meta-Milestone" -> 18, "Meta-Milestone"; "Spark Milestone #2" -> 2, "Spark Milestone #"
local function ordinal(s: string): (number?, string?)
	local n, rest = string.match(s, "^(%d+)%a%a%s+(.+)$")
	if n and rest then return tonumber(n), "o|" .. rest end
	local head, m = string.match(s, "^(.-#)(%d+)$")
	if head and m then return tonumber(m), "h|" .. head end
	return nil, nil
end
local function suffix(n: number): string
	local t = n % 100
	if t >= 11 and t <= 13 then return "th" end
	local u = n % 10
	return if u == 1 then "st" elseif u == 2 then "nd" elseif u == 3 then "rd" else "th"
end

-- the sub line of a merged toast
function ToastModel.mergedSub(kind: string, subs: { string }): string
	local n = #subs
	if n <= 1 then return subs[1] or "" end
	local lo, hi, key = math.huge, -math.huge, nil :: string?
	local same = true
	for _, s in subs do
		local v, k = ordinal(s)
		if v == nil or k == nil then
			same = false
			break
		end
		if key == nil then
			key = k
		elseif key ~= k then
			same = false
			break
		end
		lo, hi = math.min(lo, v), math.max(hi, v)
	end
	if same and key then
		local kind2, rest = string.sub(key, 1, 1), string.sub(key, 3)
		if kind2 == "o" then
			return string.format("%d%s – %d%s %s", lo, suffix(lo), hi, suffix(hi), rest)
		end
		return string.format("%s%d – #%d", rest, lo, hi)
	end
	if kind == "achievement" then return string.format("%d achievements", n) end
	if kind == "milestone" then return string.format("%d milestones", n) end
	return string.format("%d updates", n)
end

function ToastModel.new(): Model
	local self = {} :: Model
	local live: { Toast } = {}
	local hist: { Toast } = {}
	local nextId = 0

	function self.push(_: Model, item: Item, now: number): (Toast, boolean)
		local life = if item.kind == "notice" then ToastModel.NOTICE_LIFE else ToastModel.LIFE
		for _, t in live do
			if t.kind == item.kind and t.title == item.title and now - t.born < t.life and item.kind ~= "notice" then
				t.count += 1
				table.insert(t.subs, item.sub)
				t.sub = ToastModel.mergedSub(t.kind, t.subs)
				t.born = now
				t.layer = item.layer or t.layer
				return t, true
			end
		end
		nextId += 1
		local t: Toast = {
			id = nextId, kind = item.kind, title = item.title, sub = item.sub, layer = item.layer, count = 1,
			subs = { item.sub }, born = now, life = life,
		}
		table.insert(live, 1, t)
		table.insert(hist, 1, t)
		while #hist > ToastModel.HISTORY do table.remove(hist) end
		return t, false
	end
	function self.active(_: Model, now: number): { Toast }
		local i = 1
		while i <= #live do
			local t = live[i]
			if now - t.born >= t.life then table.remove(live, i) else i += 1 end
		end
		return live
	end
	function self.history(_: Model): { Toast }
		return hist
	end
	function self.clear(_: Model)
		table.clear(hist)
	end
	return self
end

return ToastModel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="130">
            <Properties>
              <string name="Name">Toasts</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Toasts: the coalescing toasts at the top right of the free map rect, the "+N more" chip and the notification list
	(DESIGN.md 4.7, 7.3; mock h). The bookkeeping is ToastModel (pure).

	    Toast_<id>  400 x 72 (COMPACT 260 x 56): a horizontal hue gradient, hue rim, icon disc, title (`toast`, thin
	                outline) + ×N chip, sub (`small`), a 3 du life bar. Click-through. Enter: slide 60 du, Back Out.
	    More        "+N more" glass chip (bell); opens the list
	    Notify      the last 20: rows (title `cardSmall`, sub `small`), "EARLIER N", CLEAR; a row flies to its layer

	    local toasts = Toasts.new(root)
	    toasts:push(pops?, notices?)     toasts:setCollapsed(b)    toasts.flyTo (layer)
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Signal = require(Core:WaitForChild("Signal"))
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Motion = require(Core:WaitForChild("Motion"))
local Rich = require(Core:WaitForChild("Rich"))
local Sleek = require(Core:WaitForChild("Sleek"))
local Skin = require(Core:WaitForChild("Skin"))
local Kit = require(script.Parent.Parent:WaitForChild("Hud"):WaitForChild("Kit"))
local ToastModel = require(script.Parent:WaitForChild("ToastModel"))

export type Toasts = {
	frame: Frame,
	flyTo: Signal.Signal<string>,
	push: (self: Toasts, pops: { Types.Popup }?, notices: { string }?) -> (),
	setCollapsed: (self: Toasts, b: boolean) -> (),
	destroy: (self: Toasts) -> (),
}

local Toasts = {}
local instances = 0

local KIND: { [string]: { color: Color3, glyph: string } } = {
	milestone = { color = Color3.fromHex("ffc233"), glyph = "star" },
	achievement = { color = Theme.C.info, glyph = "star" },
	corruption = { color = Theme.hue("cp"), glyph = "check" },
	challenge = { color = Color3.fromHex("ffc233"), glyph = "star" },
	notice = { color = Theme.C.muted, glyph = "info" },
	other = { color = Theme.C.system, glyph = "bell" },
}

-- the HUD glass (R10) at alpha .88
local function glass(f: Frame)
	Sleek.plate(f, { alpha = 0.88, line = 0.86, strokeName = "GlassRim" })
end

local function iconDisc(parent: Instance, name: string, kind: string, d: number): Frame
	local spec = KIND[kind] or KIND.other
	-- Sleek: the kind's glyph in its colour, no disc
	local disc = Kit.frame(parent, name, 3)
	disc.Size = UDim2.fromOffset(d, d)
	local g = Kit.glyph(disc, "Icon", spec.glyph, spec.color, Sleek.C.top)
	g.AnchorPoint = Vector2.new(0.5, 0.5)
	g.Position = UDim2.fromScale(0.5, 0.5)
	g.Size = UDim2.fromScale(0.62, 0.62)
	g.ZIndex = 4
	return disc
end
Toasts.iconDisc = iconDisc

function Toasts.new(root: GuiObject): Toasts
	local self = {} :: Toasts
	self.flyTo = Signal.new() :: Signal.Signal<string>
	local model = ToastModel.new()
	instances += 1
	local rectKey = "overlay.toasts" .. (if instances > 1 then tostring(instances) else "")
	local holder = Kit.frame(root, "Toasts", 20)
	holder.AnchorPoint = Vector2.new(1, 0)
	pcall(function() holder.Interactable = false end)
	self.frame = holder
	local views: { [number]: Frame? } = {}
	local collapsed = false
	local listOpen = false

	-- the "+N more" chip and the notification list (these take input)
	local more = Kit.frame(root, "More", 21)
	more.AnchorPoint = Vector2.new(1, 0)
	more.AutomaticSize = Enum.AutomaticSize.X
	glass(more)

	local mc = Kit.frame(more, "Content")
	mc.AutomaticSize = Enum.AutomaticSize.X
	mc.Size = UDim2.fromScale(0, 1)
	Kit.list(mc, "x", 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local bell = Kit.glyph(mc, "Bell", "bell", Color3.new(1, 1, 1))
	bell.LayoutOrder = 1
	bell.Size = UDim2.fromOffset(14, 14)
	local moreLabel = Kit.label(mc, "Label", "label", "", Color3.new(1, 1, 1))
	moreLabel.LayoutOrder = 2
	moreLabel.AutomaticSize = Enum.AutomaticSize.X
	moreLabel.Size = UDim2.fromScale(0, 1)
	local moreHit = Kit.button(more, "Hit")
	moreHit.Size = UDim2.new(1, 0, 1, 12)
	moreHit.Position = UDim2.fromOffset(0, -6)
	more.Visible = false

	local list = Kit.frame(root, "NotifyList", 22)
	list.AnchorPoint = Vector2.new(1, 0)
	list.AutomaticSize = Enum.AutomaticSize.Y
	Sleek.plate(list, { alpha = 0.94, line = 0.86 })
	list.BackgroundTransparency = 0.04

	Kit.pad(list, 12, 12, 12, 12)
	Kit.list(list, "y", 6, Enum.HorizontalAlignment.Left)
	list.Visible = false

	local lastPush = 0
	local function width(): number
		return if Layout.mode == "COMPACT" then 260 else 400
	end
	local function maxShown(): number
		if Layout.mode == "COMPACT" then return 1 end
		if listOpen or collapsed then return if collapsed then 1 else 2 end
		return 3
	end

	local function place()
		local compact = Layout.mode == "COMPACT"
		local F = Layout.free()
		local s = Layout.s
		local ra = root.AbsolutePosition
		local x = (F.x + F.w - ra.X) / s - 16
		local y = if compact then 58 else 68
		-- the open player list (Hud/PlayerList) sits top right: stack below it
		local pl = Layout.rect("hud.players")
		if pl then y = math.max(y, (pl.y + pl.h - ra.Y) / s + 10) end
		holder.Position = UDim2.fromOffset(x, y)
		holder.Size = UDim2.fromOffset(width(), 0)
		local now = os.clock()
		local act = model:active(now)
		local shown = 0
		local pitch = if compact then 64 else 84
		for i, t in act do
			local v = views[t.id]
			if v == nil then continue end
			if i <= maxShown() then
				shown += 1
				v.Visible = true
				Motion.tween(v, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ Position = UDim2.fromOffset(0, (shown - 1) * pitch) }, "toastY" .. t.id)
			else
				v.Visible = false
			end
		end
		local hidden = #model:history() - shown
		more.Visible = hidden > 0 and now - lastPush < 10 or listOpen
		moreLabel.Text = if listOpen then "Close" else "+" .. math.max(0, hidden) .. " more"
		Theme.text(moreLabel, "label")
		more.Size = UDim2.fromOffset(0, if compact then 30 else 34)
		Kit.pad(more, 0, 12, 0, 10)
		more.Position = UDim2.fromOffset(x, y + shown * pitch)
		-- the visible toasts are a HUD rect for the plates and markers
		if shown > 0 then
			Layout.setRect(rectKey, { x = ra.X + (x - width()) * s, y = ra.Y + y * s, w = width() * s, h = (shown * pitch) * s })
		else
			Layout.setRect(rectKey, nil)
		end
		list.Position = UDim2.fromOffset(x, y + shown * pitch + 42)
		list.Size = UDim2.fromOffset(width(), 0)
	end

	local function makeToast(t: ToastModel.Toast): Frame
		local compact = Layout.mode == "COMPACT"
		local spec = KIND[t.kind] or KIND.other
		local k = spec.color
		local w, h = width(), if compact then 56 else 72
		local f = Kit.frame(holder, "Toast_" .. t.id, 1)
		-- the holder is anchored at its top right (x is the free rect's right edge); a toast fills the holder's width
		f.AnchorPoint = Vector2.new(0, 0)
		f.Size = UDim2.fromOffset(w, h)
		f.Position = UDim2.fromOffset(0, 0)
		-- Sleek: a dark slab, a 3 du kind-colour bar on the left, corner ticks, the life line along the bottom
		Sleek.plate(f, { alpha = 0.9, line = 0.86 })
		Sleek.ticks(f, { len = 10, th = 2, out = 1, color = Color3.new(1, 1, 1), alpha = 0.8, z = 6 })
		Skin.apply(f, "plate", { scale = 0.5 })
		local side = Kit.frame(f, "Side", 4)
		side.Size = UDim2.new(0, 3, 1, 0)
		side.BackgroundColor3 = k
		side.BackgroundTransparency = 0
		local disc = iconDisc(f, "Icon", t.kind, if compact then 26 else 30)
		disc.AnchorPoint = Vector2.new(0, 0.5)
		disc.Position = UDim2.new(0, 18, 0.5, 0)
		local x0 = 18 + (if compact then 26 else 30) + 14
		local top = Kit.frame(f, "Top", 3)
		top.Position = UDim2.fromOffset(x0, if compact then 8 else 12)
		top.Size = UDim2.new(1, -x0 - 12, 0, if compact then 20 else 24)
		Kit.list(top, "x", 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
		local title = Kit.label(top, "Title", "toast", t.title, Color3.new(1, 1, 1))
		title.LayoutOrder = 1
		title.AutomaticSize = Enum.AutomaticSize.X
		title.Size = UDim2.fromScale(0, 1)
		title.TextTruncate = Enum.TextTruncate.AtEnd
		title.FontFace = Font.fromName("Montserrat", Enum.FontWeight.ExtraBold, Enum.FontStyle.Italic)
		Kit.textStroke(title, 0)
		local over = Kit.child(title, "Overhang", "UIPadding") :: UIPadding
		over.PaddingRight = UDim.new(0, 2)
		local chip, cl = Kit.chip(top, "Count", "badge", "", { h = if compact then 18 else 20, pad = 6, fg = Theme.lift(k, 0.4),
			bgA = 0, line = k, lineA = 0.9 })
		chip.LayoutOrder = 2
		chip.Visible = false
		cl.RichText = true
		local sub = Kit.label(f, "Sub", "small", t.sub, Sleek.C.soft)
		sub.TextTransparency = 0
		sub.Position = UDim2.fromOffset(x0, if compact then 30 else 40)
		sub.Size = UDim2.new(1, -x0 - 12, 0, 18)
		sub.TextXAlignment = Enum.TextXAlignment.Left
		sub.TextTruncate = Enum.TextTruncate.AtEnd
		local bar = Kit.frame(f, "Life", 4)
		bar.AnchorPoint = Vector2.new(0, 1)
		bar.Position = UDim2.new(0, 3, 1, 0)
		bar.Size = UDim2.new(1, -3, 0, 2)
		bar.BackgroundColor3 = k
		bar.BackgroundTransparency = 0.2
		pcall(function() f.Interactable = false end)
		return f
	end

	local function refresh(t: ToastModel.Toast)
		local v = views[t.id]
		if v == nil then return end
		local top = v:FindFirstChild("Top")
		local chip = top and top:FindFirstChild("Count") :: Frame?
		if chip then
			chip.Visible = t.count > 1
			local cl = chip:FindFirstChild("Label") :: TextLabel?
			if cl then cl.Text = "×" .. t.count end
		end
		local sub = v:FindFirstChild("Sub") :: TextLabel?
		if sub then sub.Text = t.sub end
		local bar = v:FindFirstChild("Life") :: Frame?
		if bar then
			bar.Size = UDim2.new(1, -3, 0, 2)
			local life = if Motion.snapshot() then 0 else t.life
			Motion.tween(bar, TweenInfo.new(life, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) }, "toastLife" .. t.id, true)
		end
	end

	local function expire(id: number)
		local v = views[id]
		if v == nil then return end
		views[id] = nil
		Motion.tween(v, TweenInfo.new(0.2), { Position = v.Position + UDim2.fromOffset(60, 0) }, "toastY" .. id)
		task.delay(0.22, function() v:Destroy() end)
	end

	local function sweep()
		local now = os.clock()
		local alive: { [number]: boolean } = {}
		for _, t in model:active(now) do alive[t.id] = true end
		for id in views do
			if not alive[id] then expire(id) end
		end
		place()
	end

	local function add(item: ToastModel.Item)
		local now = os.clock()
		lastPush = now
		local t, merged = model:push(item, now)
		if merged then
			refresh(t)
			local v = views[t.id]
			if v then Motion.bump(v, 0.06) end
		else
			local v = makeToast(t)
			views[t.id] = v
			refresh(t)
			local target = UDim2.fromOffset(0, 0)
			v.Position = target + UDim2.fromOffset(60, 0)
			Motion.tween(v, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = target }, "toastY" .. t.id)
		end
		task.delay(t.life + 0.05, sweep)
		task.delay(10.1, place)
		place()
	end

	local function rebuildList()
		for _, c in list:GetChildren() do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		local hist = model:history()
		local head = Kit.frame(list, "Head")
		head.LayoutOrder = 0
		head.Size = UDim2.new(1, 0, 0, 24)
		local cap = Kit.label(head, "Earlier", "caps", Rich.caps("Earlier") .. "  " .. #hist, Theme.C.soft)
		cap.Size = UDim2.fromScale(0.6, 1)
		cap.TextXAlignment = Enum.TextXAlignment.Left
		local clear = Kit.button(head, "Clear")
		clear.AnchorPoint = Vector2.new(1, 0.5)
		clear.Position = UDim2.new(1, 0, 0.5, 0)
		clear.Size = UDim2.fromOffset(64, 44)
		local cl = Kit.label(clear, "Label", "label", "Clear", Theme.C.info)
		cl.Size = UDim2.fromScale(1, 1)
		cl.TextXAlignment = Enum.TextXAlignment.Right
		clear.Activated:Connect(function()
			model:clear()
			listOpen = false
			list.Visible = false
			place()
		end)
		for i, t in hist do
			local row = Kit.button(list, "Row" .. i)
			row.LayoutOrder = i
			row.Size = UDim2.new(1, 0, 0, 56)
			row.BackgroundTransparency = 0
			row.BackgroundColor3 = Theme.C.panel2
			Kit.corner(row, UDim.new(0, 0)) -- Sleek: square
			local disc = iconDisc(row, "Icon", t.kind, 32)
			disc.AnchorPoint = Vector2.new(0, 0.5)
			disc.Position = UDim2.new(0, 10, 0.5, 0)
			local title = Kit.label(row, "Title", "cardSmall", t.title .. (if t.count > 1 then "  ×" .. t.count else ""), Theme.C.text)
			title.Position = UDim2.fromOffset(54, 8)
			title.Size = UDim2.new(1, -64, 0, 20)
			title.TextXAlignment = Enum.TextXAlignment.Left
			title.TextTruncate = Enum.TextTruncate.AtEnd
			local sub = Kit.label(row, "Sub", "small", t.sub, Theme.C.soft)
			sub.Position = UDim2.fromOffset(54, 30)
			sub.Size = UDim2.new(1, -64, 0, 18)
			sub.TextXAlignment = Enum.TextXAlignment.Left
			sub.TextTruncate = Enum.TextTruncate.AtEnd
			local layer = t.layer
			row.Activated:Connect(function()
				if layer then self.flyTo:Fire(layer) end
			end)
		end
	end
	moreHit.Activated:Connect(function()
		listOpen = not listOpen
		list.Visible = listOpen
		if listOpen then rebuildList() end
		place()
	end)

	function self.push(_: Toasts, pops: { Types.Popup }?, notices: { string }?)
		for _, p in (pops or {}) :: { Types.Popup } do
			if type(p) ~= "table" then continue end
			local kind = ToastModel.kindOf(p :: any)
			local title = ToastModel.plain(p.title)
			if title == "" then title = if kind == "achievement" then "Achievement Gotten!" else "Notice" end
			add({ kind = kind, title = title, sub = ToastModel.plain(p.message), layer = p.layer })
		end
		for _, n in (notices or {}) :: { string } do
			if type(n) == "string" and n ~= "" then add({ kind = "notice", title = "Notice", sub = ToastModel.plain(n), layer = nil }) end
		end
	end
	function self.setCollapsed(_: Toasts, b: boolean)
		collapsed = b
		place()
	end
	function self.destroy(t: Toasts)
		t.flyTo:DisconnectAll()
		Layout.setRect(rectKey, nil)
		holder:Destroy()
		more:Destroy()
		list:Destroy()
	end
	-- HUD rects move the free rect's edge (a side sheet): follow on the next frame, never re-entrantly
	local queued = false
	local function soon()
		if queued then return end
		queued = true
		task.defer(function()
			queued = false
			if holder.Parent then place() end
		end)
	end
	Layout.changed:Connect(soon)
	Layout.rectsChanged:Connect(soon)
	place()
	return self
end

return Toasts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="131">
            <Properties>
              <string name="Name">Tooltip</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Tooltip: the one-owner hover tooltip (DESIGN.md 7.1, Figma 4:68). Mouse only, after 250 ms, at the cursor +
	(16, -h - 12), clamped to the screen (it flips below / left when there is no room). One owner at a time; the
	owner's Destroying hides it.

	    Tooltip   360 du (COMPACT 300), panel3 -> panel, rim lift(c, .2), hue glow
	      Title   `cardSmall`, lift(c, .55)
	      Body    `body` RichText (the game's HTML, colours remapped)
	      Rows    two aligned rows ("Need" / "Have": `small` soft labels, `number` values with Rich.num units)
	      Bar     the `pr` progress with its % (Rich.pct)
	      Foot    `small` soft, sentence case ("Click to open · right-click to peek")

	    local tip = Tooltip.new(root)
	    tip:show(owner, content?, at?)   content = { title, body?, rows?, pr?, foot?, hue?, layer? }; nil hides; an empty
	                                     title is left out (the game's own card tooltips)
	    tip:hide(owner?)
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Rich = require(Core:WaitForChild("Rich"))
local Kit = require(script.Parent.Parent:WaitForChild("Hud"):WaitForChild("Kit"))

export type Content = {
	title: string,
	body: string?, -- game HTML
	rows: { { string } }?, -- { label, value }
	pr: number?, -- 0..1
	foot: string?,
	hue: Color3?,
	layer: string?,
}
export type Tooltip = {
	frame: Frame,
	show: (self: Tooltip, owner: any, content: Content?, at: Vector2?) -> (),
	hide: (self: Tooltip, owner: any?) -> (),
	owner: (self: Tooltip) -> any?,
	destroy: (self: Tooltip) -> (),
}

local Tooltip = {}

function Tooltip.new(root: GuiObject): Tooltip
	local self = {} :: Tooltip
	local f = Kit.frame(root, "Tooltip", 40)
	f.AutomaticSize = Enum.AutomaticSize.Y
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	f.BackgroundTransparency = 0.02
	f.Visible = false
	Kit.corner(f, UDim.new(0, 0)) -- Sleek: square
	Kit.grad(f, { Theme.C.panel3, Theme.C.panel }, 90, nil, "Back")
	local rim = Kit.stroke(f, 1.5, Theme.C.strokeHi, 1, "Rim")
	Kit.pad(f, 14, 16, 14, 16)
	Kit.list(f, "y", 6, Enum.HorizontalAlignment.Left)
	pcall(function() f.Interactable = false end)
	self.frame = f

	local title = Kit.label(f, "Title", "cardSmall", "", Theme.C.text)
	title.LayoutOrder = 1
	title.AutomaticSize = Enum.AutomaticSize.Y
	title.Size = UDim2.fromScale(1, 0)
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextWrapped = true
	local body = Kit.label(f, "Body", "body", "", Theme.C.text)
	body.LayoutOrder = 2
	body.AutomaticSize = Enum.AutomaticSize.Y
	body.Size = UDim2.fromScale(1, 0)
	body.TextXAlignment = Enum.TextXAlignment.Left
	body.TextWrapped = true
	body.RichText = true
	local rows = Kit.frame(f, "Rows")
	rows.LayoutOrder = 3
	rows.AutomaticSize = Enum.AutomaticSize.Y
	rows.Size = UDim2.fromScale(1, 0)
	Kit.list(rows, "y", 4, Enum.HorizontalAlignment.Left)
	local bar = Kit.frame(f, "Bar")
	bar.LayoutOrder = 4
	bar.Size = UDim2.new(1, 0, 0, 18)
	local track = Kit.frame(bar, "Track")
	track.AnchorPoint = Vector2.new(0, 0.5)
	track.Position = UDim2.fromScale(0, 0.5)
	track.Size = UDim2.new(1, -56, 0, 6)
	track.BackgroundColor3 = Theme.C.deep
	track.BackgroundTransparency = 0
	Kit.corner(track)
	local fill = Kit.frame(track, "Fill")
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = Theme.C.danger
	fill.BackgroundTransparency = 0
	Kit.corner(fill)
	local pct = Kit.label(bar, "Pct", "number", "", Theme.C.text)
	pct.AnchorPoint = Vector2.new(1, 0.5)
	pct.Position = UDim2.fromScale(1, 0.5)
	pct.Size = UDim2.fromOffset(52, 18)
	pct.TextXAlignment = Enum.TextXAlignment.Right
	local foot = Kit.label(f, "Foot", "small", "", Theme.C.soft)
	foot.LayoutOrder = 5
	foot.AutomaticSize = Enum.AutomaticSize.Y
	foot.Size = UDim2.fromScale(1, 0)
	foot.TextXAlignment = Enum.TextXAlignment.Left
	foot.TextWrapped = true

	local current: any = nil
	local lastSig = ""
	local token = 0
	local destroyConn: RBXScriptConnection? = nil

	local function row(i: number, k: string, v: string)
		local r = Kit.frame(rows, "Row" .. i)
		r.LayoutOrder = i
		r.Size = UDim2.new(1, 0, 0, 20)
		local kl = Kit.label(r, "Key", "small", k, Theme.C.soft)
		kl.Size = UDim2.fromScale(0.4, 1)
		kl.TextXAlignment = Enum.TextXAlignment.Left
		local vl = Kit.label(r, "Value", "number", "", Theme.C.text)
		vl.AnchorPoint = Vector2.new(1, 0)
		vl.Position = UDim2.fromScale(1, 0)
		vl.Size = UDim2.fromScale(0.6, 1)
		vl.TextXAlignment = Enum.TextXAlignment.Right
		vl.RichText = true
		vl.Text = Rich.num(v, { size = Theme.size("number"), unit = Theme.C.soft })
	end

	local function fill_(c: Content)
		local hue = c.hue or Theme.hue(c.layer)
		local compact = Layout.mode == "COMPACT"
		f.Size = UDim2.fromOffset(if compact then 300 else 360, 0)
		rim.Color = Theme.lift(hue, 0.2)
		title.Text = c.title
		title.Visible = c.title ~= "" -- the game's own tooltips (panel cards) come without a title
		title.TextColor3 = Theme.lift(hue, 0.55)
		Theme.text(title, "cardSmall")
		local b = c.body
		body.Visible = b ~= nil and b ~= ""
		if b then body.Text = Rich.html(b, Theme.size("body"), c.layer) end
		Theme.text(body, "body")
		for _, x in rows:GetChildren() do
			if x:IsA("GuiObject") then x:Destroy() end
		end
		local list = (c.rows or {}) :: { { string } }
		rows.Visible = #list > 0
		for i, r in list do row(i, r[1], r[2]) end
		local p = c.pr
		bar.Visible = p ~= nil
		if p then
			fill.Size = UDim2.fromScale(math.clamp(p, 0, 1), 1)
			fill.BackgroundColor3 = if p >= 1 then Theme.C.bought else Theme.lift(hue, 0.1)
			pct.Text = Rich.pct(p)
		end
		foot.Visible = c.foot ~= nil
		foot.Text = c.foot or ""
		Theme.text(foot, "small")
	end

	local function place(at: Vector2)
		local s = Layout.s
		local ra, rs = root.AbsolutePosition, root.AbsoluteSize
		local lx, ly = (at.X - ra.X) / s, (at.Y - ra.Y) / s
		local w, h = f.Size.X.Offset, math.max(40, f.AbsoluteSize.Y / s)
		local W, H = rs.X / s, rs.Y / s
		local x, y = lx + 16, ly - h - 12
		if x + w > W - 8 then x = lx - 16 - w end
		if y < 8 then y = ly + 24 end
		x = math.clamp(x, 8, math.max(8, W - w - 8))
		y = math.clamp(y, 8, math.max(8, H - h - 8))
		f.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
	end

	function self.show(t: Tooltip, owner: any, content: Content?, at: Vector2?)
		if content == nil then
			t:hide(owner)
			return
		end
		local was = current
		current = owner
		token += 1
		local my = token
		if destroyConn then
			destroyConn:Disconnect()
			destroyConn = nil
		end
		if typeof(owner) == "Instance" then
			destroyConn = (owner :: Instance).Destroying:Connect(function()
				if current == owner then t:hide(owner) end
			end)
		end
		local sig = content.title .. "|" .. (content.body or "") .. "|" .. tostring(content.pr) .. "|" .. (content.foot or "")
		for _, r in (content.rows or {}) :: { { string } } do sig ..= "|" .. r[1] .. "=" .. r[2] end
		if sig ~= lastSig or was ~= owner then
			lastSig = sig
			fill_(content)
		end
		local pos = at
		if was == owner and f.Visible then
			if pos then place(pos) end
			return
		end
		-- the 250 ms hover delay (a new owner while one shows switches at once)
		local delay = if f.Visible then 0 else 0.25
		task.delay(delay, function()
			if token ~= my or current ~= owner then return end
			f.Visible = true
			if pos then place(pos) end
			task.defer(function()
				if token == my and pos then place(pos) end
			end)
		end)
	end
	function self.hide(_: Tooltip, owner: any?)
		if owner ~= nil and owner ~= current then return end
		current = nil
		token += 1
		f.Visible = false
	end
	function self.owner(_: Tooltip): any?
		return current
	end
	function self.destroy(_: Tooltip)
		if destroyConn then destroyConn:Disconnect() end
		f:Destroy()
	end
	return self
end

return Tooltip
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="132">
          <Properties>
            <string name="Name">Panel</string>
          </Properties>
          <Item class="ModuleScript" referent="133">
            <Properties>
              <string name="Name">Hero</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Hero: the pinned hero of a panel (DESIGN.md 5.3, 5.4, 5.10; plan 2.5). It claims the first main-display,
	prestige-button and resource-display of the current tab (depth <= 3) and draws them from their structured fields:

	    resource block   YOU HAVE, the amount (hero: Sarpanch Heavy with gradient, outline, shadow and a round glow blob;
	                     steps 56 -> 48 -> 40 to fit), the resource name (resource: heavy italic caps), the effect line
	    CTA              the signature's word (PRESTIGE / GET +1 MILESTONE / COLLECT ...), the gain in a value well; static
	                     layers with a pr show the bar and %; the locked variant is grey with the bar, % and
	                     "need X <resource>"; the hotkey keycap only with keyboard and mouse
	    stat chips       resource-display lines: <RESOURCE> have, PASSIVE +gen/s, BEST, TOTAL
	WIDE: the block at the left, the CTA at the right, chips under the CTA. COMPACT: one 226 du column with the chips
	stacked and the CTA pinned at the bottom.

	The CTA fires the prestige-button node's own action (read from the store at press time) and plays the prestige
	juice: press squash, burst ring, a "+gain" floater into the amount, the amount bump. Reduced motion keeps a short
	colour flash only. The press asks the one "first prestige?" question (Prefs.claimFirstPrestige) and hands the
	answer to the sound (Audio.prestige: big or small) and to juice(gain, unit, first), where the VFX pass keys its big
	and residual versions. A locked CTA answers with the soft error; hovering a ready CTA plays the hover tick.
]]

local UserInputService = game:GetService("UserInputService")

local Core = script.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Recipes = require(Core:WaitForChild("Recipes"))
local Motion = require(Core:WaitForChild("Motion"))
local Rich = require(Core:WaitForChild("Rich"))
local Sleek = require(Core:WaitForChild("Sleek"))
local Skin = require(Core:WaitForChild("Skin"))
local Layout = require(Core:WaitForChild("Layout"))
local Prefs = require(Core:WaitForChild("Prefs"))
local Audio = require(Core:WaitForChild("Audio"))
local Common = require(script.Parent:WaitForChild("Skins"):WaitForChild("Common"))
local Signatures = require(script.Parent.Parent:WaitForChild("Signatures"):WaitForChild("Signatures"))

local Hero = {}
Hero.__index = Hero

local C = Theme.C
local WHITE = Color3.new(1, 1, 1)

local CN = { ["main-display"] = true, ["prestige-button"] = true, ["resource-display"] = true }

export type Hero = typeof(setmetatable({} :: {
	frame: Frame,
	ids: { [string]: string },
	dirty: boolean,
	visible: boolean,
	store: any,
	ctx: any,
	act: (action: any, hold: boolean?) -> (),
	shine: any?,
	lastGain: string?,
}, Hero))

function Hero.new(frame: Frame, act: (action: any, hold: boolean?) -> ()): Hero
	local self = setmetatable({
		frame = frame,
		ids = {},
		dirty = false,
		visible = false,
		store = nil,
		ctx = nil,
		act = act,
		shine = nil,
		lastGain = nil,
	}, Hero)
	frame.Visible = false
	return self
end

-- forget the claimed ids (a new panel opened, or a full patch)
function Hero.reset(self: Hero)
	table.clear(self.ids)
	self.dirty = true
end

-- the claim hook's question: is this the hero's component?
function Hero.wants(self: Hero, id: string, n: any): boolean
	if type(n) ~= "table" or not CN[n.cn or ""] then return false end
	if Common.depth(id) > 3 then return false end
	local cn = n.cn :: string
	-- a resource-display with no structured value (the game's empty "<br><br>") stays in the body (hidden there)
	if cn == "resource-display" and n.have == nil and n.gen == nil and n.best == nil and n.total == nil then return false end
	local held = self.ids[cn]
	return held == nil or held == id
end

function Hero.claim(self: Hero, id: string, n: any): (ph: Frame) -> any
	local cn = n.cn :: string
	return function(ph: Frame): any
		ph.Visible = false
		ph.Size = UDim2.new()
		ph.AutomaticSize = Enum.AutomaticSize.None
		self.ids[cn] = id
		self.dirty = true
		local claim = {}
		function claim.update(_: any, store: any)
			self.store = store
			self.dirty = true
		end
		function claim.destroy(_: any)
			if self.ids[cn] == id then self.ids[cn] = nil end
			self.dirty = true
		end
		return claim
	end
end

-- ------------------------------------------------------------------------------------------------------ drawing
local function keyboard(): boolean
	local ok, kbm = pcall(function(): boolean
		return (UserInputService :: any).PreferredInput == (Enum :: any).PreferredInput.KeyboardAndMouse
	end)
	if ok then return kbm end
	return UserInputService.KeyboardEnabled and not UserInputService.TouchEnabled
end

local function gainZero(s: string?): boolean
	return s == nil or string.find(s, "^[%+]?0[%.0]*$") ~= nil
end

function Hero.draw(self: Hero, store: any, ctx: any)
	self.dirty = false
	self.store = store
	self.ctx = ctx
	local f = self.frame
	local md = if self.ids["main-display"] then store:get(self.ids["main-display"]) else nil
	local pb = if self.ids["prestige-button"] then store:get(self.ids["prestige-button"]) else nil
	local rd = if self.ids["resource-display"] then store:get(self.ids["resource-display"]) else nil
	if type(md) ~= "table" then md = nil end
	if type(pb) ~= "table" then pb = nil end
	if type(rd) ~= "table" then rd = nil end
	self.visible = md ~= nil or pb ~= nil or rd ~= nil
	f.Visible = self.visible
	if not self.visible then return end
	local compact = Layout.mode == "COMPACT"
	local hue = ctx.hue :: Color3
	f.ClipsDescendants = false

	-- the resource block
	local res = Common.get(f, "Res", "Frame") :: Frame
	res.Active = false
	Common.list(res, false, if compact then 2 else 6)
	if compact then
		res.Position = UDim2.fromOffset(0, 0)
		res.Size = UDim2.new(1, 0, 0, 0)
		Common.drop(f, "Spine")
	else
		res.Position = UDim2.fromOffset(20, 0)
		res.Size = UDim2.new(1, if pb then -460 else -20, 0, 0)
		local spine = Common.get(f, "Spine", "Frame") :: Frame
		spine.Position = UDim2.fromOffset(0, 4)
		spine.Size = UDim2.fromOffset(2, 112)
		spine.BackgroundColor3 = hue
		spine.BackgroundTransparency = 0
		spine.Visible = md ~= nil
		local sg = Common.get(spine, "Fade", "UIGradient") :: UIGradient
		sg.Rotation = 90
		sg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.9) })
	end
	res.AutomaticSize = Enum.AutomaticSize.Y
	res.Visible = md ~= nil or (compact and rd ~= nil)
	local you = Common.label(res, "YouHave", "caps", C.soft, { order = 1, wrap = false })
	you.Visible = md ~= nil
	Common.setText(you, Common.esc(Rich.caps("You have")))
	local amountText = if md then Common.str(md.pts) or "0" else "0"
	local amount = Common.get(res, "Amount", "TextLabel") :: TextLabel
	amount.LayoutOrder = 2
	amount.Visible = md ~= nil
	amount.TextXAlignment = Enum.TextXAlignment.Left
	amount.TextYAlignment = Enum.TextYAlignment.Center
	amount.TextWrapped = false
	amount.AutomaticSize = Enum.AutomaticSize.None
	local steps = if compact then { 38, 34, 30 } else { 56, 48, 40 }
	amount.Size = UDim2.new(1, 0, 0, steps[1] + 8)
	local sig = amountText .. "|" .. Theme.toHex(hue) .. "|" .. tostring(compact)
	if amount:GetAttribute("Sig") ~= sig then
		amount:SetAttribute("Sig", sig)
		Recipes.number(amount, { text = amountText, size = steps[1], from = WHITE, to = WHITE, stroke = 0, shadow = 0, role = "hero" })
		Rich.fit(amount, steps, if compact then 216 else 560)
	end
	-- the round glow blob behind the amount (never a square: Common.blob)
	local blob = if md and not compact then Common.blob(f, "AmountGlow", hue, 0.16) else nil
	if blob then
		blob.ZIndex = 0
		blob.AnchorPoint = Vector2.new(0.5, 0.5)
		blob.Position = UDim2.fromOffset(200, 58)
		blob.Size = UDim2.fromOffset(470, 150)
	elseif not (md and not compact) then
		Common.drop(f, "AmountGlow")
	end
	local resName = Common.get(res, "ResName", "TextLabel") :: TextLabel
	resName.LayoutOrder = 3
	resName.Visible = md ~= nil
	resName.TextXAlignment = Enum.TextXAlignment.Left
	resName.TextYAlignment = Enum.TextYAlignment.Center
	resName.TextWrapped = false
	resName.AutomaticSize = Enum.AutomaticSize.None
	local name = string.upper(Common.plain(if md then md.res else ""))
	name = string.gsub(string.gsub(name, "^%s+", ""), "%s+$", "")
	local long = utf8.len(name) ~= nil and (utf8.len(name) :: number) > 20
	local rsize = if compact then (if long then 16 else 18) else (if long then 18 else 22)
	resName.Size = UDim2.new(1, 0, 0, rsize + 6)
	local rsig = name .. "|" .. tostring(rsize) .. "|" .. Theme.toHex(hue)
	if resName:GetAttribute("Sig") ~= rsig then
		resName:SetAttribute("Sig", rsig)
		Recipes.title(resName, { text = name, role = "resource", size = if compact then rsize - 2 else rsize - 2, from = Theme.lift(hue, 0.55),
			to = Theme.lift(hue, 0.55), stroke = 0, shadow = 0 })
	end
	local eff = Common.label(res, "Eff", "body", C.soft, { order = 4 })
	local effText = if md and not compact then Common.html(md.eff, "body", ctx.layer) else ""
	eff.Visible = effText ~= ""
	eff.TextTruncate = Enum.TextTruncate.AtEnd
	local effLim = Common.get(eff, "Lines", "UISizeConstraint") :: UISizeConstraint
	effLim.MaxSize = Vector2.new(math.huge, math.floor(Theme.size("body") * Theme.lineHeight("body") * 2 + 2))
	Common.setText(eff, effText)

	-- the stat chips
	local stats = Common.get(f, "Stats", "Frame") :: Frame
	stats.Active = false
	local rows: { { string } } = {}
	if rd then
		local have, bres = Common.str(rd.have), Common.str(rd.bres)
		if have then table.insert(rows, { string.upper(Common.plain(bres or "")), have }) end
		local gen = Common.str(rd.gen)
		if gen and not gainZero(gen) then table.insert(rows, { "PASSIVE", "+" .. gen .. "/s" }) end
		local best = Common.str(rd.best)
		if best then table.insert(rows, { "BEST", best }) end
		local total = Common.str(rd.total)
		if total then table.insert(rows, { "TOTAL", total }) end
	end
	if compact then
		stats.Parent = res
		stats.LayoutOrder = 10
		stats.Position = UDim2.new()
		stats.AnchorPoint = Vector2.new()
		stats.Size = UDim2.new(1, 0, 0, 0)
		stats.AutomaticSize = Enum.AutomaticSize.Y
		Common.list(stats, false, 6)
	else
		stats.Parent = f
		stats.AnchorPoint = Vector2.new(1, 0)
		stats.Size = UDim2.fromOffset(0, 34)
		stats.AutomaticSize = Enum.AutomaticSize.X
		Common.list(stats, true, 8, { align = Enum.HorizontalAlignment.Right, valign = Enum.VerticalAlignment.Center })
	end
	stats.Visible = #rows > 0
	for i = 1, 4 do
		local row = rows[i]
		if row then
			local label = if row[1] ~= "" then row[1] else "HAVE"
			local tone = if label == "PASSIVE" then Sleek.C.goodHi else C.text
			local text = Common.caps(label, Sleek.C.soft) .. "      " .. Common.num(if compact then Rich.short(row[2]) else row[2], "number", tone)
			local chip = Common.chip(stats, "Stat" .. i, text, { rich = true, bg = WHITE, bgT = 0.97, h = if compact then 32 else 34,
				stroke = WHITE })
			Common.drop(chip, "Corner")
			local b = chip:FindFirstChild("Border") :: UIStroke?
			if b then
				b.Transparency = 0.89
				b.LineJoinMode = Enum.LineJoinMode.Miter
			end
			chip.LayoutOrder = i
			chip.TextXAlignment = if compact then Enum.TextXAlignment.Left else Enum.TextXAlignment.Center
			if compact then
				chip.AutomaticSize = Enum.AutomaticSize.None
				chip.Size = UDim2.new(1, 0, 0, 32)
			end
		else
			Common.drop(stats, "Stat" .. i)
		end
	end

	-- the CTA
	if pb then
		self:drawCta(pb, ctx, compact)
	else
		Common.drop(f, "Cta")
		if self.shine then
			self.shine:stop()
			self.shine = nil
		end
	end
	local cta = f:FindFirstChild("Cta") :: GuiObject?
	if not compact then
		local ctaH = if cta then cta.Size.Y.Offset else 0
		stats.Position = UDim2.new(1, 0, 0, if cta then ctaH + 14 else 0)
	end

	-- the signature's hero idea
	local sigT = ctx.signature
	if sigT and sigT.hero then
		local ok, err = pcall(sigT.hero, f, store, ctx)
		if not ok then warn("[MilestoneTree] signature hero failed: " .. tostring(err)) end
	else
		-- a signature's hero idea lives in the hero's "Accent" child: gone on a layer without one
		Common.drop(f, "Accent")
	end
end

function Hero.drawCta(self: Hero, pb: any, ctx: any, compact: boolean)
	local f = self.frame
	local hue = ctx.hue :: Color3
	local can = pb.cls == "can"
	local static = pb.static == true
	local pr = Common.pr(pb.pr)
	local tall = (not can) or (static and pr ~= nil)
	local w = if compact then 200 else 400
	local h = if compact then (if tall then 96 else 80) else (if tall then 110 else 96)
	local cta = Common.get(f, "Cta", "TextButton") :: TextButton
	cta.Text = ""
	cta.AutoButtonColor = false
	cta.ClipsDescendants = false
	if compact then
		cta.AnchorPoint = Vector2.new(0.5, 1)
		cta.Position = UDim2.new(0.5, 0, 1, 0)
	else
		cta.AnchorPoint = Vector2.new(1, 0)
		cta.Position = UDim2.new(1, 0, 0, 0)
	end
	cta.Size = UDim2.fromOffset(w, h)
	-- Sleek: the one solid light surface of the panel (ink type), corner ticks just outside; locked is a dark plate
	for _, n in { "Corner", "Rim", "Bevel" } do Common.drop(cta, n) end
	local ink = Sleek.C.ink
	if can then
		cta.BackgroundColor3 = WHITE
		cta.BackgroundTransparency = 0
		local g = Common.get(cta, "Fill", "UIGradient") :: UIGradient
		g.Rotation = 90
		g.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Theme.lift(hue, 0.3)), ColorSequenceKeypoint.new(0.6, hue),
			ColorSequenceKeypoint.new(1, Theme.shade(hue, 0.92)) })
		g.Transparency = NumberSequence.new(0)
		local edge = Common.get(cta, "Edge", "Frame") :: Frame
		edge.Size = UDim2.new(1, 0, 0, 1)
		edge.BackgroundColor3 = WHITE
		edge.BackgroundTransparency = 0.3
		edge.ZIndex = 9
		Sleek.ticks(cta, { len = 12, th = 2, out = 6, color = Theme.lift(hue, 0.55), alpha = 1, z = 9 })
		Common.glow(cta, hue, 0.3, 26)
		if Skin.apply(cta, "cta", { tint = Theme.lift(hue, 0.15), scale = if compact then 0.55 else 0.75 }) then
			Common.drop(cta, "Edge")
			Common.drop(cta, "Fill")
		end
		if self.shine == nil then self.shine = Recipes.shine(cta, { every = 2.8 }) end
	else
		Sleek.plate(cta, { alpha = 0.9, line = 0.8 })
		Common.drop(cta, "Edge")
		Sleek.ticks(cta, { len = 10, th = 2, out = 6, color = WHITE, alpha = 0.35, z = 9 })
		Common.glow(cta, nil)
		Skin.apply(cta, "button", { scale = if compact then 0.55 else 0.75 })
		if self.shine then
			self.shine:stop()
			self.shine = nil
		end
		Common.drop(cta, "Shine")
	end
	-- the word (display: white, outline, hard shadow), step-fit to keep 12 du side padding
	local word = Common.get(cta, "Word", "TextLabel") :: TextLabel
	word.ZIndex = 10
	word.AnchorPoint = Vector2.new(0, 0)
	word.Position = UDim2.new(0, if compact then 14 else 28, 0, if compact then 10 else 18)
	word.Size = UDim2.new(1, if compact then -28 else -120, 0, if compact then 24 else 32)
	word.TextXAlignment = Enum.TextXAlignment.Left
	word.TextYAlignment = Enum.TextYAlignment.Center
	word.TextWrapped = false
	local text = Signatures.cta(ctx.layer)
	local sizes = if compact then { 20, 18, 16 } else { 30, 26, 22 }
	local wsig = text .. "|" .. tostring(compact) .. "|" .. tostring(can) .. "|" .. Theme.toHex(hue)
	if word:GetAttribute("Sig") ~= wsig then
		word:SetAttribute("Sig", wsig)
		Recipes.title(word, { text = text, role = "cta", size = sizes[1], stroke = 0, shadow = 0 })
		Rich.fit(word, sizes, w - (if compact then 28 else 120))
	end
	local fillText = word:FindFirstChild("Fill") :: TextLabel?
	if fillText then fillText.TextColor3 = if can then ink else Sleek.C.soft end
	-- the value line: +gain in ink under the word, or "need X res" when locked
	local well = Common.get(cta, "Well", "TextLabel") :: TextLabel
	well.ZIndex = 10
	well.AnchorPoint = Vector2.new(0, 1)
	well.AutomaticSize = Enum.AutomaticSize.X
	well.TextWrapped = false
	well.TextXAlignment = Enum.TextXAlignment.Left
	well.TextYAlignment = Enum.TextYAlignment.Center
	well.BackgroundTransparency = 1
	Common.drop(well, "Corner")
	Common.pad(well, 0, 0, 0, 0)
	local unit = Signatures.unit(pb.res)
	local barShown = pr ~= nil and (static or not can)
	if can then
		Common.text(well, "ctaSub", ink)
		well.Size = UDim2.fromOffset(0, 22)
		well.Position = UDim2.new(0, if compact then 14 else 28, 1, if barShown then -34 else -16)
		Common.setText(well, Common.num("+" .. (Common.str(pb.gain) or "0"), "ctaSub", ink, unit, true))
	else
		Common.text(well, "small", Sleek.C.soft)
		well.Size = UDim2.fromOffset(0, 22)
		well.Position = UDim2.new(0, if compact then 14 else 28, 1, -12)
		local need = Common.str(pb.next)
		local bres = Common.plain(Common.str(pb.bres) or "")
		if need then
			Common.setText(well, Common.esc("need ") .. Common.num(if compact then Rich.short(need) else need, "number", C.text, bres, true))
		else
			Common.setText(well, Common.esc("Not ready"))
		end
	end
	-- the pr bar + %
	if barShown then
		local p = pr :: number
		local bar = Common.bar(cta, "Bar", p, if can then ink else hue, 2)
		bar.ZIndex = 10
		bar.AnchorPoint = Vector2.new(0, 0)
		bar.Position = UDim2.new(0, if compact then 14 else 28, 0, if compact then 42 else 58)
		bar.Size = UDim2.new(1, if compact then -84 else -112, 0, 2)
		local pct = Common.get(cta, "Pct", "TextLabel") :: TextLabel
		pct.ZIndex = 10
		Common.text(pct, "number", if can then ink else C.text)
		pct.AnchorPoint = Vector2.new(1, 0)
		pct.Position = UDim2.new(1, if compact then -14 else -28, 0, if compact then 33 else 49)
		pct.Size = UDim2.fromOffset(60, 20)
		pct.TextXAlignment = Enum.TextXAlignment.Right
		pct.TextYAlignment = Enum.TextYAlignment.Center
		Common.setText(pct, Common.esc(Rich.pct(p)))
	else
		Common.drop(cta, "Bar")
		Common.drop(cta, "Pct")
	end
	-- the hotkey keycap (keyboard and mouse only)
	local hk = Common.str(pb.hk)
	if hk and keyboard() then
		local key = Common.get(cta, "Key", "TextLabel") :: TextLabel
		key.ZIndex = 11
		Common.text(key, "label", if can then ink else C.text)
		key.AnchorPoint = Vector2.new(1, 0.5)
		key.Position = UDim2.new(1, -52, 0.5, if barShown then -14 else 0)
		key.AutomaticSize = Enum.AutomaticSize.X
		key.Size = UDim2.fromOffset(30, 30)
		key.BackgroundTransparency = 1
		key.TextXAlignment = Enum.TextXAlignment.Center
		key.TextYAlignment = Enum.TextYAlignment.Center
		Common.drop(key, "Corner")
		Common.stroke(key, 1.5, if can then ink else WHITE, if can then 0 else 0.6).LineJoinMode = Enum.LineJoinMode.Miter
		Common.pad(key, 0, 8, 0, 8)
		local chev = Common.get(cta, "Chev", "Frame") :: Frame
		chev.AnchorPoint = Vector2.new(0.5, 0.5)
		chev.Position = UDim2.new(1, -30, 0.5, if barShown then -14 else 0)
		chev.Size = UDim2.fromOffset(9, 9)
		chev.Rotation = 45
		chev.ZIndex = 11
		for i, spec in { { UDim2.fromScale(0, 0), UDim2.new(1, 0, 0, 2) }, { UDim2.new(1, -2, 0, 0), UDim2.new(0, 2, 1, 0) } } do
			local seg = Common.get(chev, "S" .. i, "Frame") :: Frame
			seg.Position = spec[1]
			seg.Size = spec[2]
			seg.BackgroundColor3 = if can then ink else WHITE
			seg.BackgroundTransparency = if can then 0 else 0.4
			seg.ZIndex = 11
		end
		Common.setText(key, Common.esc(hk))
	else
		Common.drop(cta, "Key")
		Common.drop(cta, "Chev")
	end
	cta:SetAttribute("State", if can then "can" else "locked")
	if cta:GetAttribute("Wired") ~= true then
		cta:SetAttribute("Wired", true)
		cta.Activated:Connect(function()
			self:press()
		end)
		cta.MouseEnter:Connect(function()
			if cta:GetAttribute("State") == "can" then Audio.play("hover") end
		end)
	end
end

-- ------------------------------------------------------------------------------------------------------ press + juice
function Hero.press(self: Hero)
	local store = self.store
	local id = self.ids["prestige-button"]
	if store == nil or id == nil then return end
	local pb = store:get(id)
	if type(pb) ~= "table" or type(pb.a) ~= "table" then return end
	self.act(pb.a, false)
	if pb.cls == "can" then
		local layer = if self.ctx then self.ctx.layer else nil
		local first = type(layer) == "string" and Prefs.claimFirstPrestige(layer)
		Audio.prestige(layer, first)
		local ok, err = pcall(function()
			self:juice(Common.str(pb.gain), Signatures.unit(pb.res), first)
		end)
		if not ok then warn("[MilestoneTree] prestige juice failed: " .. tostring(err)) end
	else
		Audio.play("error", { volume = 0.8 })
	end
end

-- first: this is the layer's first prestige (the big moment; the VFX pass plays its big version on it)
function Hero.juice(self: Hero, gain: string?, unit: string, first: boolean?)
	local f = self.frame
	local cta = f:FindFirstChild("Cta") :: GuiObject?
	if cta == nil then return end
	local ctaObj = cta :: GuiObject
	if Motion.reduced() then
		Motion.flash(ctaObj)
		return
	end
	-- 1. press squash, then Back Out
	local sc = Motion.scaleOf(ctaObj)
	sc.Scale = 0.94
	Motion.tween(sc, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }, "hero:cta")
	local s = math.max(Layout.s, 0.01)
	local origin = f.AbsolutePosition
	local cc = (ctaObj.AbsolutePosition - origin + ctaObj.AbsoluteSize / 2) / s
	-- 2. a burst ring
	local ring = Instance.new("Frame")
	ring.Name = "Burst"
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = UDim2.fromOffset(cc.X, cc.Y)
	ring.Size = UDim2.fromOffset(120, 120)
	ring.BackgroundTransparency = 1
	ring.ZIndex = 20
	ring.Active = false
	Common.corner(ring, 0.5)
	local rs = Common.stroke(ring, 4, C.gold, 0.4)
	ring.Parent = f
	Motion.tween(ring, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(360, 360) })
	Motion.tween(rs, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 1 })
	task.delay(0.5, function()
		if ring.Parent then ring:Destroy() end
	end)
	-- 3. the "+gain" floater into the amount
	local resF = f:FindFirstChild("Res")
	local amount: GuiObject? = if resF then resF:FindFirstChild("Amount") :: GuiObject? else nil
	if gain and amount and (amount :: GuiObject).Visible then
		local a = amount :: GuiObject
		local target = (a.AbsolutePosition - origin) / s + Vector2.new(60, a.AbsoluteSize.Y / (2 * s))
		local fl = Instance.new("TextLabel")
		fl.Name = "Floater"
		fl.BackgroundTransparency = 1
		fl.AnchorPoint = Vector2.new(0.5, 0.5)
		fl.Position = UDim2.fromOffset(cc.X, cc.Y)
		fl.Size = UDim2.fromOffset(320, 36)
		fl.ZIndex = 21
		fl.RichText = true
		fl.FontFace = Theme.font("hero")
		fl.TextSize = 28
		fl.TextColor3 = C.gold
		fl.TextStrokeTransparency = 1
		local st = Common.stroke(fl, 3, C.black, 0, "Stroke")
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		fl.Text = Rich.num("+" .. gain .. (if unit ~= "" then " " .. unit else ""), { size = 28, onFill = true })
		fl.Parent = f
		Motion.tween(fl, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.fromOffset(target.X, target.Y) })
		task.delay(0.45, function()
			if fl.Parent then
				Motion.tween(fl, TweenInfo.new(0.2), { TextTransparency = 1 })
				Motion.tween(st, TweenInfo.new(0.2), { Transparency = 1 })
			end
		end)
		task.delay(0.7, function()
			if fl.Parent then fl:Destroy() end
		end)
		-- 4. the amount bumps and its glow flares
		task.delay(0.5, function()
			if a.Parent then Motion.bump(a, 0.12) end
			local blob = f:FindFirstChild("AmountGlow") :: Frame?
			if blob then
				local g = blob:FindFirstChild("Radial")
				blob.BackgroundTransparency = 0
				if g and g:IsA("UIGradient") then
					local sc2 = Motion.scaleOf(blob)
					sc2.Scale = 1.15
					Motion.tween(sc2, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 })
				end
			end
		end)
	end
end

function Hero.destroy(self: Hero)
	if self.shine then
		self.shine:stop()
		self.shine = nil
	end
	table.clear(self.ids)
end

return Hero
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="134">
            <Properties>
              <string name="Name">Panel</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Panel: the layer panel (DESIGN.md 5, plan 2.4 / 2.5 / 1.12): sheet geometry and lifecycle, the shell (rim, header
	band, emblem, title, sub row, tabs, close), the pinned hero, the body with the Render tab tree, the skeleton and
	the scroll memory.

	    local panel = Panel.new(gui, { store = store, tip = fn? })   -- gui: the PanelGui (Layout.screen, order 20)
	    panel:open(key, node)          key = layer | "options-tab"; the shell draws at once from the map node
	    panel:update(store, changes)   applies changes.tabPatch to the panel's own Render, then header, hero, sections
	    panel:close(); panel:isOpen() -> key?
	    panel:geometry() -> { mode = "side" | "full", sx = abs px of the strip edge?, card = Rect }
	    panel:setBand(on)              COMPACT: the Hud band carries the title and close (the panel then hides its own)
	    panel.content                  the Render tab root (Body.Scroll.TabRoot)
	    panel.render                   the panel's Renderer (skins / claims / hero hooks installed)
	    panel.closeRequested, panel.act (action, hold), panel.detail (card), panel.flyTo (layer), panel.geometryChanged

	Protocol (plan 1.12): the panel never sends ["tab", id] itself: App fires the node's action once and calls open.
	The body shows a skeleton until a patch arrives with patch.tab == key. Every button fires its node's `a` as sent
	(panel.act); the hero CTA fires the prestige-button node's own action. Sounds: a subtab switch plays "tab", the
	close button's hover the hover tick (opening and closing sound in App, which knows why the panel moved).
	When the shown layer or subtab changes, the tab tree is rebuilt from the store, so no skin or claim keeps the
	previous layer's state.
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Recipes = require(Core:WaitForChild("Recipes"))
local Motion = require(Core:WaitForChild("Motion"))
local Rich = require(Core:WaitForChild("Rich"))
local Sleek = require(Core:WaitForChild("Sleek"))
local Skin = require(Core:WaitForChild("Skin"))
local Layout = require(Core:WaitForChild("Layout"))
local Signal = require(Core:WaitForChild("Signal"))
local Audio = require(Core:WaitForChild("Audio"))
local Types = require(script.Parent.Parent:WaitForChild("Types"))
local Render = require(script.Parent.Parent:WaitForChild("Render"))
local Signatures = require(script.Parent.Parent:WaitForChild("Signatures"):WaitForChild("Signatures"))
local Common = require(script.Parent:WaitForChild("Skins"):WaitForChild("Common"))
local Skins = require(script.Parent:WaitForChild("Skins"):WaitForChild("Skins"))
local Sections = require(script.Parent:WaitForChild("Sections"))
local Hero = require(script.Parent:WaitForChild("Hero"))
local Virtual = require(script.Parent:WaitForChild("Virtual"))

type ARect = Types.Rect

local Panel = {}
Panel.__index = Panel

local C = Theme.C
local WHITE = Color3.new(1, 1, 1)

export type Geometry = { mode: string, sx: number?, card: ARect }

export type Panel = typeof(setmetatable({} :: {
	gui: ScreenGui,
	root: Frame,
	store: any,
	render: any,
	content: Frame,
	key: string?,
	node: any,
	layer: string, -- the layer the tab tree currently shows (store.tab)
	sub: string?,
	ready: boolean,
	band: boolean,
	hug: boolean,
	seen: { [string]: boolean },
	scrollMem: { [string]: number },
	restoring: boolean,
	parts: { [string]: any },
	hero: any,
	ctxCache: any,
	geo: Geometry,
	closeRequested: Signal.Signal<>,
	act: Signal.Signal<any, boolean?>,
	detail: Signal.Signal<any>,
	flyTo: Signal.Signal<string>,
	geometryChanged: Signal.Signal<Geometry>,
}, Panel))

-- ------------------------------------------------------------------------------------------------------ helpers
local function frame(parent: Instance, name: string): Frame
	local f = Common.get(parent, name, "Frame") :: Frame
	f.Active = false
	return f
end

-- the current subtab: the text of the "cur" button of the top-level tabs node
local function subOf(store: any): string?
	local root = store:get("tab")
	if type(root) ~= "table" or type(root.c) ~= "table" then return nil end
	for _, cid in root.c do
		local n = store:get(cid)
		if type(n) == "table" and n.t == "tabs" and type(n.c) == "table" then
			for _, tid in n.c do
				local b = store:get(tid)
				if type(b) == "table" and b.cls == "cur" then return Common.plain(b.h) end
			end
		end
	end
	return nil
end

-- every tab.* node of the store, as a full patch (a rebuild for a new layer / subtab)
local function fullTabPatch(store: any): any
	local set = {}
	for id, n in store.nodes do
		if id == "tab" or string.sub(id, 1, 4) == "tab." then set[id] = n end
	end
	return { full = true, set = set, del = {} }
end

-- ------------------------------------------------------------------------------------------------------ build
function Panel.new(gui: ScreenGui, deps: { store: any?, tip: ((html: string?, over: GuiObject?) -> ())?, root: Frame? }): Panel
	local root = deps.root or (gui:FindFirstChild("Root") :: Frame?) or (gui :: any)
	local self = setmetatable({
		gui = gui,
		root = root,
		store = deps.store,
		render = nil :: any,
		content = nil :: any,
		key = nil,
		node = nil,
		layer = "none",
		sub = nil,
		ready = false,
		band = false,
		hug = false,
		seen = {},
		scrollMem = {},
		restoring = false,
		parts = {},
		hero = nil :: any,
		ctxCache = nil,
		geo = { mode = "side", sx = nil, card = { x = 0, y = 0, w = 0, h = 0 } },
		closeRequested = Signal.new() :: Signal.Signal<>,
		act = Signal.new() :: Signal.Signal<any, boolean?>,
		detail = Signal.new() :: Signal.Signal<any>,
		flyTo = Signal.new() :: Signal.Signal<string>,
		geometryChanged = Signal.new() :: Signal.Signal<Geometry>,
	}, Panel)
	self:build()
	local tip = deps.tip or function(_: string?, _o: GuiObject?) end
	self.hero = Hero.new(self.parts.hero, function(a: any, hold: boolean?)
		self.act:Fire(a, hold)
	end)
	self.render = Render.new({ tab = self.content }, {
		press = function(a: any, hold: boolean)
			self.act:Fire(a, hold)
		end,
		tip = tip,
		ctx = function(): any
			return self:ctx()
		end,
		skin = function(rec: any, n: any, ctx: any): boolean
			return Skins.apply(rec, n, ctx)
		end,
		claim = function(id: string, n: any, ctx: any): any
			return self:claimFor(id, n, ctx)
		end,
		store = deps.store,
		detail = function(rec: any)
			if rec.kind == "btn:upg" or rec.kind == "btn:buy" then
				self.detail:Fire({ id = rec.id, kind = rec.kind, node = rec.node, layer = self.layer })
			end
		end,
	})
	Layout.changed:Connect(function()
		self:layout()
		if self.key then self.render:refresh() end
		self:drawHero()
	end)
	local hugQueued = false
	self.content:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if not self.hug or self.key == nil or hugQueued then return end
		hugQueued = true
		task.defer(function()
			hugQueued = false
			if self.hug and self.key then self:layout() end
		end)
	end)
	self:layout()
	self:showOpen(false, false)
	return self
end

function Panel.build(self: Panel)
	local root = self.root
	local p = self.parts
	-- the backdrop over the map right of the strip
	local back = frame(root, "Backdrop")
	back.BackgroundColor3 = C.void
	back.BackgroundTransparency = 0.04
	back.ZIndex = 1
	back.Active = true
	local ramp = Common.get(back, "Ramp", "UIGradient") :: UIGradient
	ramp.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.02, 0.04),
		NumberSequenceKeypoint.new(1, 0.04),
	})
	p.back = back
	-- the sheet
	local sheet = frame(root, "Sheet")
	sheet.ZIndex = 2
	sheet.Active = true
	sheet.ClipsDescendants = false
	p.sheet = sheet
	local band = frame(sheet, "HeaderBand")
	band.ZIndex = 2
	p.band = band
	local rule = frame(sheet, "HeaderRule")
	rule.ZIndex = 3
	p.rule = rule
	local emblem = frame(sheet, "Emblem")
	emblem.ZIndex = 6
	p.emblem = emblem
	local sym = Common.get(emblem, "Symbol", "TextLabel") :: TextLabel
	sym.ZIndex = 7
	p.sym = sym
	local title = Common.get(sheet, "Title", "TextLabel") :: TextLabel
	title.ZIndex = 6
	p.title = title
	local subRow = frame(sheet, "SubRow")
	subRow.ZIndex = 6
	p.subRow = subRow
	local tabs = frame(sheet, "Tabs")
	tabs.ZIndex = 6
	p.tabs = tabs
	local readout = frame(sheet, "Readout")
	readout.ZIndex = 6
	p.readout = readout
	local close = Common.get(sheet, "Close", "TextButton") :: TextButton
	close.ZIndex = 20
	close.AutoButtonColor = false
	close.Text = ""
	p.close = close
	close.Activated:Connect(function()
		self.closeRequested:Fire()
	end)
	close.MouseEnter:Connect(function()
		Audio.play("hover")
		Motion.tween(close, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0.88 }, "panel:close")
	end)
	close.MouseLeave:Connect(function()
		Motion.tween(close, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0.97 }, "panel:close")
	end)
	local hero = frame(sheet, "Hero")
	hero.ZIndex = 5
	p.hero = hero
	local divider = frame(sheet, "Divider")
	divider.ZIndex = 3
	p.divider = divider
	local body = frame(sheet, "Body")
	body.ZIndex = 3
	body.ClipsDescendants = true
	p.body = body
	local scroll = Common.get(body, "Scroll", "ScrollingFrame") :: ScrollingFrame
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Size = UDim2.fromScale(1, 1)
	scroll.CanvasSize = UDim2.new()
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.ScrollBarThickness = 6
	scroll.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable
	scroll.ZIndex = 3
	scroll.Active = true
	p.scroll = scroll
	local tabRoot = frame(scroll, "TabRoot")
	tabRoot.Size = UDim2.new(1, 0, 0, 0)
	tabRoot.AutomaticSize = Enum.AutomaticSize.Y
	tabRoot.ZIndex = 3
	self.content = tabRoot
	local fade = frame(body, "BottomFade")
	fade.AnchorPoint = Vector2.new(0, 1)
	fade.Position = UDim2.fromScale(0, 1)
	fade.Size = UDim2.new(1, 0, 0, 80)
	fade.ZIndex = 9
	fade.BackgroundTransparency = 0
	fade.Active = false
	p.fade = fade
	local fg = Common.get(fade, "Fade", "UIGradient") :: UIGradient
	fg.Rotation = 90
	fg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })
	scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		if self.key and self.ready and not self.restoring then
			self.scrollMem[self:memKey()] = scroll.CanvasPosition.Y
		end
	end)
end

-- ------------------------------------------------------------------------------------------------------ context
function Panel.memKey(self: Panel): string
	return tostring(self.layer) .. "|" .. tostring(self.sub or "")
end

-- the body's content width in du and the upgrade card width
function Panel.widths(self: Panel): (number, number)
	local compact = Layout.mode == "COMPACT"
	local bodyW = self.parts.body.Size.X.Offset
	if bodyW <= 0 then bodyW = if compact then 580 else 1080 end
	local pad = if compact then 6 + 14 else 16 + 24
	local contentW = math.max(200, bodyW - pad)
	local cardW = if compact then math.max(200, math.floor((contentW - 10) / 2)) else 237
	return contentW, cardW
end

function Panel.ctx(self: Panel): any
	local store = self.store
	local layer = self.layer
	local contentW, cardW = self:widths()
	local ctx: Signatures.Ctx = {
		layer = layer,
		sub = self.sub,
		hue = Theme.hue(layer),
		mode = Layout.mode,
		signature = Signatures.get(layer),
		act = function(a: any, hold: boolean?)
			self.act:Fire(a, hold)
		end,
		store = store,
		render = self.render,
		s = Layout.s,
		contentW = contentW,
		cardW = cardW,
		corrupted = Signatures.corrupted(layer),
		detail = function(card: any)
			self.detail:Fire(card)
		end,
		firstSeen = function(key: string): boolean
			if self.seen[key] then return false end
			self.seen[key] = true
			return true
		end,
		cache = {},
		scroll = self.parts.scroll,
	}
	self.ctxCache = ctx
	return ctx
end

-- the claim hook: header tabs, the signature's claims, the hero, long milestone ladders
local function matches(m: any, id: string, n: any, ctx: any): boolean
	if type(m) ~= "table" or n.cn ~= m.cn then return false end
	if m.ci ~= nil and n.ci ~= m.ci then return false end
	if m.sub ~= nil and ctx.sub ~= m.sub then return false end
	if m.depth ~= nil and Common.depth(id) > m.depth then return false end
	return true
end

function Panel.claimFor(self: Panel, id: string, n: any, ctx: any): any
	if type(n) ~= "table" or ctx == nil then return nil end
	local store = self.store
	if n.t == "tabs" and Common.depth(id) == 1 then
		return function(ph: Frame): any
			return self:tabsClaim(ph, id)
		end
	end
	local sig = ctx.signature
	if sig and type(sig.claims) == "table" then
		for _, rule in sig.claims do
			if matches(rule.match, id, n, ctx) then
				return function(ph: Frame): any
					return rule.make(ph, id, store, ctx)
				end
			end
		end
	end
	if self.hero:wants(id, n) then return self.hero:claim(id, n) end
	if n.cn == "milestones" and #store:kids(id) > Virtual.MS_ROWS then
		return function(ph: Frame): any
			return Virtual.milestones(ph, id, store, ctx)
		end
	end
	return nil
end

-- ------------------------------------------------------------------------------------------------------ header tabs
function Panel.tabsClaim(self: Panel, ph: Frame, id: string): any
	ph.Visible = false
	ph.Size = UDim2.new()
	ph.AutomaticSize = Enum.AutomaticSize.None
	local tabs = self.parts.tabs :: Frame
	local claim = {}
	function claim.update(_: any, store: any)
		self:drawTabs(store, id)
	end
	function claim.destroy(_: any)
		for _, c in tabs:GetChildren() do
			if c:IsA("GuiButton") then c:Destroy() end
		end
		local was = tabs:GetAttribute("Count")
		tabs:SetAttribute("Count", 0)
		if type(was) == "number" and was >= 2 then self:layout() end
	end
	return claim
end

function Panel.drawTabs(self: Panel, store: any, id: string)
	local tabs = self.parts.tabs :: Frame
	local kids = store:kids(id)
	local compact = Layout.mode == "COMPACT"
	local hue = Theme.hue(self.layer)
	local count = 0
	for i, tid in kids do
		local n = store:get(tid)
		if type(n) ~= "table" or n.t ~= "btn" then continue end
		count += 1
		local b = Common.get(tabs, "Tab" .. i, "TextButton") :: TextButton
		b.LayoutOrder = i
		b.AutoButtonColor = false
		b.Text = ""
		b.ZIndex = 7
		b.Size = UDim2.fromOffset(0, if compact then 36 else 46)
		b.AutomaticSize = Enum.AutomaticSize.X
		local active = n.cls == "cur"
		-- Sleek tabs: an index number, the caps word, a count; the active one gets a hue floor and a 2 du hue line
		Common.drop(b, "Corner")
		Common.drop(b, "Border")
		Common.glow(b, nil)
		if active then
			b.BackgroundColor3 = hue
			b.BackgroundTransparency = 0
			local g = Common.get(b, "Fill", "UIGradient") :: UIGradient
			g.Rotation = 90
			g.Color = ColorSequence.new(WHITE)
			g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.84) })
			local line = Common.get(b, "Line", "Frame") :: Frame
			line.AnchorPoint = Vector2.new(0, 1)
			line.Position = UDim2.fromScale(0, 1)
			line.Size = UDim2.new(1, 0, 0, 2)
			line.BackgroundColor3 = hue
			line.BackgroundTransparency = 0
			line.ZIndex = 9
		else
			Common.drop(b, "Fill")
			Common.drop(b, "Line")
			b.BackgroundTransparency = 1
		end
		-- the index, word and mark sit in a Row (the button also holds the floor line, which a list would lay out)
		Common.drop(b, "Pad")
		Common.drop(b, "List")
		local rowF = Common.get(b, "Row", "Frame") :: Frame
		rowF.AutomaticSize = Enum.AutomaticSize.X
		rowF.Size = UDim2.fromScale(0, 1)
		rowF.ZIndex = 8
		Common.pad(rowF, 0, if compact then 12 else 22, 0, if compact then 12 else 22)
		Common.list(rowF, true, 9, { valign = Enum.VerticalAlignment.Center })
		local idx = Sleek.micro(rowF, "Index", string.format("%02d", count), if active then hue else Sleek.C.micro)
		idx.LayoutOrder = 1
		idx.ZIndex = 8
		idx.Visible = not compact
		Common.drop(b, "Index")
		Common.drop(b, "Label")
		Common.drop(b, "Dot")
		local l = Common.get(rowF, "Label", "TextLabel") :: TextLabel
		l.ZIndex = 8
		l.LayoutOrder = 2
		Common.text(l, "tab", if active then C.text else C.soft)
		l.TextSize = if compact then 14 else 15
		l.FontFace = Font.fromName("Montserrat", Enum.FontWeight.ExtraBold, if active then Enum.FontStyle.Italic else Enum.FontStyle.Normal)
		l.Size = UDim2.new(0, 0, 1, 0)
		l.AutomaticSize = Enum.AutomaticSize.X
		l.TextXAlignment = Enum.TextXAlignment.Center
		l.TextYAlignment = Enum.TextYAlignment.Center
		l.TextWrapped = false
		Common.drop(l, "Stroke")
		Common.setText(l, Common.esc(Rich.caps(Common.plain(n.h))))
		-- a notify mark: a small gold diamond after the word
		if n.glow or n.pulse then
			local dot = Common.get(rowF, "Dot", "Frame") :: Frame
			dot.Position = UDim2.new()
			dot.Size = UDim2.fromOffset(7, 7)
			dot.Rotation = 45
			dot.LayoutOrder = 3
			dot.BackgroundColor3 = Sleek.C.gold
			dot.BackgroundTransparency = 0
			dot.ZIndex = 9
			Common.drop(dot, "Corner")
		else
			Common.drop(rowF, "Dot")
		end
		b:SetAttribute("TabId", tid)
		b:SetAttribute("State", if active then "owned" else "can")
		if b:GetAttribute("Wired") ~= true then
			b:SetAttribute("Wired", true)
			b.Activated:Connect(function()
				local t = b:GetAttribute("TabId")
				local node = if type(t) == "string" then self.store:get(t) else nil
				if type(node) == "table" and type(node.a) == "table" and node.cls ~= "cur" then
					Audio.play("tab")
					self.act:Fire(node.a, false)
				end
			end)
		end
	end
	-- drop buttons past the list
	for _, c in tabs:GetChildren() do
		if c:IsA("GuiButton") then
			local i = tonumber(string.match(c.Name, "^Tab(%d+)$"))
			if i == nil or i > #kids then c:Destroy() end
		end
	end
	local was = tabs:GetAttribute("Count")
	tabs:SetAttribute("Count", count)
	-- a single-tab bar (Main only) is hidden; the tab row moves the hero and body, so the sheet re-lays out
	tabs.Visible = count >= 2
	if (type(was) == "number" and was >= 2) ~= (count >= 2) then self:layout() end
end

-- ------------------------------------------------------------------------------------------------------ geometry
function Panel.geometry(self: Panel): Geometry
	return self.geo
end

function Panel.setBand(self: Panel, on: boolean)
	self.band = on
	self:layout()
end

function Panel.layout(self: Panel)
	local p = self.parts
	local root = self.root
	local s = math.max(Layout.s, 0.01)
	local W = root.Size.X.Offset
	local H = root.Size.Y.Offset
	if W <= 0 or H <= 0 then
		W, H = Layout.canvas.X, Layout.canvas.Y
	end
	local mode = Layout.mode
	local key = self.key or self.layer
	local hue = Theme.hue(key)
	local corrupted = Signatures.corrupted(key)
	-- where the device top is in the root's space (D coordinates are screen du from the device top-left)
	local origin = Layout.deviceOrigin()
	local topInset = math.max(0, (root.AbsolutePosition.Y - origin.Y) / s)
	local full = mode == "COMPACT"
	local x, y, w, h = 0, 0, W, H
	if not full then
		if mode == "WIDE" then
			w = math.min(1112, W - 48)
			x = W - 24 - w
			if x - 24 < Layout.STRIP_MIN then full = true end
		else
			w = math.clamp(0.62 * W, 900, 1112)
			w = math.min(w, W - 32)
			x = W - 16 - w
			if W - w - 24 < Layout.STRIP_MIN then full = true end
		end
		y = math.max(8, 70 - topInset)
		h = math.min(994, H - y - 16)
		-- small panels hug their content (DESIGN.md 5.1, the signature's `hug`), never under 560 du
		if self.hug and self.key and self.ready then
			local contentH = self.content.AbsoluteSize.Y / s
			if contentH > 1 then
				local heroOn = self.hero ~= nil and self.hero.visible
				h = math.min(h, math.max(560, 144 + 22 + (if heroOn then 168 else 0) + contentH + 16))
			end
		end
	end
	if full then
		x, y, w, h = 0, 0, W, H
	end
	w, h = math.floor(w), math.floor(h)
	local compact = mode == "COMPACT"
	local sheet = p.sheet :: Frame
	sheet.Position = UDim2.fromOffset(x, y)
	sheet.Size = UDim2.fromOffset(w, h)
	-- the backdrop covers everything right of the strip (the whole screen when full)
	local back = p.back :: Frame
	local bx = if full then 0 else x - 24
	back.Position = UDim2.fromOffset(bx, 0)
	back.Size = UDim2.fromOffset(W - bx, H)
	-- the sheet: a translucent dark slab with a hairline, corner ticks and one lit accent on the top edge (Sleek)
	Common.drop(sheet, "Corner")
	Common.drop(sheet, "Rim")
	Common.glow(sheet, nil)
	Sleek.plate(sheet, { alpha = if corrupted then 0.96 else 0.93, line = if full then 1 else 0.9,
		top = if corrupted then Color3.fromHex("020a03") else nil, bottom = if corrupted then Color3.fromHex("010401") else nil })
	if full then
		Common.drop(sheet, "Ticks")
		Common.drop(sheet, "TopAccent")
	else
		Sleek.ticks(sheet, { len = 22, th = 2, out = 1, color = if corrupted then C.termLime else WHITE, alpha = 0.85, z = 8 })
		Sleek.accent(sheet, hue, 40, 88, { name = "TopAccent" })
	end
	-- the Substance kit's frame under everything (the corrupted layers keep their terminal slab)
	if not corrupted and not full then
		local sk = Skin.apply(sheet, "panel", { scale = 0.6, z = 1 })
		if sk then sk.ImageTransparency = 0.04 end
	else
		Skin.clear(sheet)
	end
	if corrupted then
		local rim = Common.stroke(sheet, 1, C.termLime, 0.35, "Hair")
		Recipes.dashed(rim, { color = C.termLime })
	else
		Common.drop(sheet:FindFirstChild("Hair") or sheet, "Dash")
	end
	-- header: a faint hue haze from the top-left (no band fill)
	local tabsOn = (p.tabs :: Frame):GetAttribute("Count") ~= nil and ((p.tabs :: Frame):GetAttribute("Count") :: number) >= 2
	local titleH = if compact then (if self.band then 0 else 56) else 96
	local headerH = if compact then titleH else titleH + (if tabsOn then 48 else 0)
	local band = p.band :: Frame
	band.Visible = headerH > 0
	band.Position = UDim2.new()
	band.Size = UDim2.new(1, 0, 0, headerH + 60)
	Common.drop(band, "Corner")
	band.BackgroundColor3 = hue
	band.BackgroundTransparency = 0
	local haze = Common.get(band, "Fill", "UIGradient") :: UIGradient
	if Theme.caps.Radial then
		haze.Type = Enum.GradientType.Radial
		haze.Offset = Vector2.new(-0.32, -0.5)
		haze.Rotation = 0
		haze.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.85), NumberSequenceKeypoint.new(0.45, 0.95),
			NumberSequenceKeypoint.new(0.7, 1), NumberSequenceKeypoint.new(1, 1) })
	else
		haze.Rotation = 90
		haze.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 1) })
	end
	haze.Color = ColorSequence.new(WHITE)
	-- the tabs row sits on a hairline; registration marks where it meets the sheet's edges
	local rule = p.rule :: Frame
	rule.Visible = headerH > 0 and not compact
	rule.Position = UDim2.fromOffset(40, headerH - 1)
	rule.Size = UDim2.new(1, -80, 0, 1)
	rule.BackgroundColor3 = WHITE
	rule.BackgroundTransparency = Sleek.LINE
	Common.drop(rule, "Fade")
	if not compact and not full and headerH > 0 then
		Sleek.reg(sheet, "RegL", 20, headerH)
		Sleek.reg(sheet, "RegR", w - 20, headerH)
	else
		Common.drop(sheet, "RegL")
		Common.drop(sheet, "RegR")
	end
	-- emblem (a diamond), title, sub row, layer readout, tabs, close
	local emblem = p.emblem :: Frame
	local ed = if compact then 40 else 58
	emblem.Visible = headerH > 0
	emblem.Size = UDim2.fromOffset(ed, ed)
	emblem.Position = if compact then UDim2.fromOffset(10, 8) else UDim2.fromOffset(40, 22)
	Common.drop(emblem, "Corner")
	Common.drop(emblem, "Radial")
	Common.drop(emblem, "Border")
	Common.glow(emblem, nil)
	emblem.BackgroundTransparency = 1
	local dia = Sleek.diamond(emblem, "Diamond", if corrupted then C.termLime else hue, ed)
	dia.Position = UDim2.new()
	dia.ZIndex = 6
	local titleX = if compact then 60 else 120
	local title = p.title :: TextLabel
	title.Visible = headerH > 0
	title.Position = UDim2.fromOffset(titleX, if compact then 8 else 20)
	title.Size = UDim2.new(0, 0, 0, if compact then 32 else 48)
	title.AutomaticSize = Enum.AutomaticSize.X
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextYAlignment = Enum.TextYAlignment.Center
	title.TextWrapped = false
	local subRow = p.subRow :: Frame
	subRow.Visible = headerH > 0 and not compact
	subRow.Position = UDim2.fromOffset(titleX + 2, 70)
	subRow.Size = UDim2.new(1, -titleX - 260, 0, 24)
	local readout = p.readout :: Frame
	readout.Visible = headerH > 0 and not compact
	readout.AnchorPoint = Vector2.new(1, 0)
	readout.Position = UDim2.new(1, -100, 0, 28)
	readout.Size = UDim2.fromOffset(140, 40)
	local tabs = p.tabs :: Frame
	if compact then
		tabs.AnchorPoint = Vector2.new(1, 0)
		tabs.Position = UDim2.new(1, -64, 0, 10)
		tabs.Size = UDim2.fromOffset(0, 36)
		tabs.AutomaticSize = Enum.AutomaticSize.X
		Common.list(tabs, true, 4, { align = Enum.HorizontalAlignment.Right, valign = Enum.VerticalAlignment.Center })
	else
		tabs.AnchorPoint = Vector2.new(0, 0)
		tabs.Position = UDim2.fromOffset(40, titleH)
		tabs.Size = UDim2.fromOffset(0, 47)
		tabs.AutomaticSize = Enum.AutomaticSize.X
		Common.list(tabs, true, 0, { align = Enum.HorizontalAlignment.Left, valign = Enum.VerticalAlignment.Bottom })
	end
	local close = p.close :: TextButton
	close.Visible = not (compact and self.band)
	local cs = if compact then 40 else 40
	close.AnchorPoint = Vector2.new(0.5, 0.5)
	close.Size = UDim2.fromOffset(cs, cs)
	close.Position = if compact then UDim2.new(1, -32, 0, 28) else UDim2.new(1, -60, 0, 48)
	Common.drop(close, "Corner")
	Common.drop(close, "Bevel")
	for _, c in close:GetChildren() do
		if c:IsA("UIGradient") or c:IsA("ImageLabel") then c:Destroy() end
	end
	close.BackgroundColor3 = WHITE
	close.BackgroundTransparency = 0.97
	Common.stroke(close, 1, WHITE, 0.78, "Border").LineJoinMode = Enum.LineJoinMode.Miter
	Skin.apply(close, "button", { scale = 0.35 })
	Common.drop(close, "X")
	local cross = Common.get(close, "Cross", "Frame") :: Frame
	cross.AnchorPoint = Vector2.new(0.5, 0.5)
	cross.Position = UDim2.fromScale(0.5, 0.5)
	cross.Size = UDim2.fromOffset(16, 16)
	cross.ZIndex = 21
	for i, r in { 45, -45 } do
		local bar = Common.get(cross, "Bar" .. i, "Frame") :: Frame
		bar.AnchorPoint = Vector2.new(0.5, 0.5)
		bar.Position = UDim2.fromScale(0.5, 0.5)
		bar.Size = UDim2.new(1.2, 0, 0, 2)
		bar.Rotation = r
		bar.BackgroundColor3 = WHITE
		bar.BackgroundTransparency = 0
		bar.ZIndex = 21
	end
	-- hero and body
	local hero = p.hero :: Frame
	local heroOn = self.hero ~= nil and self.hero.visible
	local divider = p.divider :: Frame
	local body = p.body :: Frame
	local top = headerH + (if compact then 8 else 22)
	if compact then
		hero.Position = UDim2.fromOffset(10, top)
		hero.Size = UDim2.fromOffset(226, h - top - 10)
		divider.Visible = false
		local bx0 = if heroOn then 248 else 10
		body.Position = UDim2.fromOffset(bx0, top)
		body.Size = UDim2.fromOffset(w - bx0 - 8, h - top - 8)
	else
		hero.Position = UDim2.fromOffset(40, top)
		hero.Size = UDim2.fromOffset(w - 80, 152)
		divider.Visible = heroOn
		divider.Position = UDim2.fromOffset(40, top + 160)
		divider.Size = UDim2.new(1, -80, 0, 1)
		divider.BackgroundColor3 = WHITE
		divider.BackgroundTransparency = Sleek.LINE
		local by = if heroOn then top + 168 else top
		body.Position = UDim2.fromOffset(16, by)
		body.Size = UDim2.fromOffset(w - 32, h - by - 16)
	end
	-- the body: a styled frame holding the transparent scroll
	-- the body is the sheet itself (no inner card); the corrupted layers keep their terminal green
	Common.drop(body, "Corner")
	if corrupted then
		Common.fill(body, Color3.new(0, 0, 0), Color3.fromHex("062b0a"), Color3.fromHex("041a06"))
		local fill = body:FindFirstChild("Fill") :: UIGradient?
		if fill then fill.Transparency = NumberSequence.new(0.25) end
	else
		Common.drop(body, "Fill")
		body.BackgroundTransparency = 1
	end
	local scroll = p.scroll :: ScrollingFrame
	scroll.ScrollBarImageColor3 = Theme.lift(hue, 0.3)
	Common.pad(self.content, if compact then 10 else 20, if compact then 14 else 24, 90, if compact then 6 else 16, "Pad")
	local fade = p.fade :: Frame
	fade.BackgroundColor3 = if corrupted then Color3.fromHex("031305") else Sleek.C.bottom
	-- abs geometry for App (strip edge, card rect)
	local o = root.AbsolutePosition
	self.geo = {
		mode = if full then "full" else "side",
		sx = if full then nil else o.X + bx * s,
		card = { x = o.X + x * s, y = o.Y + y * s, w = w * s, h = h * s },
	}
	self.geometryChanged:Fire(self.geo)
end

-- ------------------------------------------------------------------------------------------------------ the shell
function Panel.drawShell(self: Panel, accent: boolean?)
	local p = self.parts
	local key = self.key or self.layer
	local node = self.node
	local compact = Layout.mode == "COMPACT"
	local hue = Theme.hue(key)
	-- emblem symbol
	local sym = p.sym :: TextLabel
	sym.Size = UDim2.fromScale(1, 1)
	sym.TextXAlignment = Enum.TextXAlignment.Center
	sym.TextYAlignment = Enum.TextYAlignment.Center
	sym.TextWrapped = false
	local symText = if node and type(node.sym) == "string" then node.sym elseif key == "options-tab" then "OPT" else string.upper(key)
	local symSize = if compact then (if #symText > 2 then 11 else 16) else (if #symText > 2 then 16 else 24)
	local ssig = symText .. "|" .. symSize
	if sym:GetAttribute("Sig") ~= ssig then
		sym:SetAttribute("Sig", ssig)
		Recipes.title(sym, { text = symText, role = "index", size = symSize, stroke = 0, shadow = 0 })
	end
	-- title (step-fit to leave the tabs room)
	local title = p.title :: TextLabel
	local text = string.upper(Signatures.title(key, node))
	local sizes = if compact then { 27, 24, 22 } else { 44, 38, 32 }
	local tsig = text .. "|" .. Theme.toHex(hue) .. "|" .. tostring(compact)
	if title:GetAttribute("Sig") ~= tsig then
		title:SetAttribute("Sig", tsig)
		Recipes.title(title, { text = text, role = "title", size = sizes[1], stroke = 0, shadow = 0 })
	end
	local sheetW = (p.sheet :: Frame).Size.X.Offset
	local tabsW = if compact and (p.tabs :: Frame).Visible then (p.tabs :: Frame).AbsoluteSize.X / math.max(Layout.s, 0.01) else 0
	Rich.fit(title, sizes, math.max(160, sheetW - title.Position.X.Offset - tabsW - (if compact then 90 else 280)))
	-- the sub row: ROW chip + the sentence-case line (the corrupted breadcrumb for cp / cm)
	local subRow = p.subRow :: Frame
	Common.list(subRow, true, 10, { valign = Enum.VerticalAlignment.Center })
	local row = Signatures.row(key)
	if row then
		local chip = Common.chip(subRow, "RowChip", Rich.caps("Row " .. row), { color = Theme.lift(hue, 0.55), bgT = 1, h = 24,
			stroke = hue, role = "caps" })
		chip.LayoutOrder = 1
		local b = chip:FindFirstChild("Border") :: UIStroke?
		if b then
			b.Transparency = 0.4
			b.LineJoinMode = Enum.LineJoinMode.Miter
		end
		Common.drop(chip, "Corner")
	else
		Common.drop(subRow, "RowChip")
	end
	local line = Common.label(subRow, "Line", "small", C.soft, { autoX = true, wrap = false, order = 2 })
	local lineText = if Signatures.corrupted(key) then "C:\\MULTIVERSE\\CORRUPTED>_" else (Signatures.subRow(key) or "")
	if Signatures.corrupted(key) then
		line.FontFace = Theme.font("terminal")
		line.TextColor3 = C.termDim
	end
	Common.setText(line, Common.esc(lineText))
	-- the layer readout: LAYER 02 / 21
	local readout = p.readout :: Frame
	Common.list(readout, false, 7, { align = Enum.HorizontalAlignment.Right, valign = Enum.VerticalAlignment.Center })
	local idx = Sleek.layerIndex(key)
	if idx then
		readout.Visible = not compact
		local cap = Sleek.caps(readout, "Cap", "Layer")
		cap.LayoutOrder = 1
		local num = Common.label(readout, "Num", "number", WHITE, { autoX = true, wrap = false, order = 2 })
		num.RichText = true
		Common.setText(num, string.format('%02d <font color="#6d7686">/ %02d</font>', idx, #Sleek.ORDER))
	else
		readout.Visible = false
	end
	-- the signature's accent
	local sig = Signatures.get(key)
	local hug = sig.hug == true
	if hug ~= self.hug then
		self.hug = hug
		task.defer(function()
			if self.key then self:layout() end
		end)
	end
	if accent then
		-- a signature draws its accent into children named "Accent" (the sheet's, the header band's): the previous
		-- layer's accent goes when another panel opens
		Common.drop(p.sheet, "Accent")
		Common.drop(p.band, "Accent")
		if sig.accent then
			local ok, err = Common.try(sig.accent, p.sheet, self.ctxCache or self:ctx())
			if not ok then warn("[MilestoneTree] signature accent failed: " .. tostring(err)) end
		end
	end
end

function Panel.drawHero(self: Panel)
	if self.store == nil then return end
	local was = self.hero.visible
	local ok, err = pcall(function()
		self.hero:draw(self.store, self.ctxCache or self:ctx())
	end)
	if not ok then warn("[MilestoneTree] hero failed: " .. tostring(err)) end
	if was ~= self.hero.visible then self:layout() end
end

-- ------------------------------------------------------------------------------------------------------ lifecycle
-- the skeleton: 3 shimmer bars until the first patch of the opened layer (built only while it shows)
local function shimmer(self: Panel, on: boolean)
	local body = self.parts.body :: Frame
	if not on then
		Common.drop(body, "Skeleton")
		return
	end
	local sk = frame(body, "Skeleton")
	sk.ZIndex = 8
	sk.Size = UDim2.fromScale(1, 1)
	sk.Visible = true
	Common.pad(sk, 24, 24, 24, 24)
	Common.list(sk, false, 16)
	for i = 1, 3 do
		local bar = frame(sk, "Bar" .. i)
		bar.LayoutOrder = i
		bar.ZIndex = 8
		bar.Size = UDim2.new(if i == 3 then 0.6 else 1, 0, 0, if i == 1 then 36 else 120)
		bar.BackgroundColor3 = C.panel3
		bar.BackgroundTransparency = 0
		Common.corner(bar, 14)
		local g = Common.get(bar, "Shimmer", "UIGradient") :: UIGradient
		g.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(1, 0.35),
		})
		g.Offset = Vector2.new(-1, 0)
		Motion.tween(g, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1), { Offset = Vector2.new(1, 0) },
			"panel:shimmer" .. i)
	end
end

function Panel.showOpen(self: Panel, on: boolean, animate: boolean)
	local p = self.parts
	local sheet = p.sheet :: Frame
	local back = p.back :: Frame
	sheet.Visible = on
	back.Visible = on
	if on and animate and not Motion.reduced() then
		local target = sheet.Position
		sheet.Position = target + UDim2.fromOffset(if Layout.mode == "COMPACT" then 0 else 60, if Layout.mode == "COMPACT" then 30 else 0)
		Motion.tween(sheet, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = target }, "panel:slide")
	end
end

function Panel.open(self: Panel, key: string, node: any?)
	local reopen = self.key == key
	self.key = key
	self.node = node
	if not reopen then self.seen = {} end
	local store = self.store
	self.ready = store ~= nil and store.tab == key
	self:layout()
	self:drawShell(true)
	shimmer(self, not self.ready)
	local scroll = self.parts.scroll :: ScrollingFrame
	scroll.Visible = self.ready
	self:showOpen(true, not reopen)
	if self.ready and store then self:sync(store, true) end
end

function Panel.close(self: Panel)
	if self.key == nil then return end
	if self.ready then self.scrollMem[self:memKey()] = (self.parts.scroll :: ScrollingFrame).CanvasPosition.Y end
	self.key = nil
	self.node = nil
	self.ready = false
	shimmer(self, false)
	self:showOpen(false, false)
end

function Panel.isOpen(self: Panel): string?
	return self.key
end

-- the tree shows another layer / subtab: rebuild it from the store (fresh skins and claims), restore the scroll
function Panel.sync(self: Panel, store: any, force: boolean)
	local layer = store.tab
	local sub = subOf(store)
	if not force and layer == self.layer and sub == self.sub then return end
	if self.ready and self.key then self.scrollMem[self:memKey()] = (self.parts.scroll :: ScrollingFrame).CanvasPosition.Y end
	self.layer = layer
	self.sub = sub
	self.hero:reset()
	local ok, err = pcall(function()
		self.render:apply(fullTabPatch(store))
	end)
	if not ok then warn("[MilestoneTree] panel rebuild failed: " .. tostring(err)) end
	self:after(store)
	-- the scroll position of this layer / subtab, once the layout settled
	local scroll = self.parts.scroll :: ScrollingFrame
	local y = self.scrollMem[self:memKey()] or 0
	self.restoring = true
	scroll.CanvasPosition = Vector2.new(0, y)
	task.defer(function()
		scroll.CanvasPosition = Vector2.new(0, y)
		self.restoring = false
	end)
end

-- after a render apply: hero, sections, header
function Panel.after(self: Panel, store: any)
	if self.hero.dirty then self:drawHero() end
	local ctx = self.ctxCache
	if ctx then
		local ok, err = Common.try(Sections.refresh, ctx)
		if not ok then warn("[MilestoneTree] sections failed: " .. tostring(err)) end
	end
	if self.key then self:drawShell() end
end

function Panel.update(self: Panel, store: any, changes: any)
	self.store = store
	self.render.hooks.store = store
	local layerMoved = store.tab ~= self.layer or subOf(store) ~= self.sub
	if layerMoved or (changes and changes.full) then
		self:sync(store, true)
	elseif changes and changes.tab then
		local ok, err = pcall(function()
			self.render:apply(changes.tabPatch)
		end)
		if not ok then
			warn("[MilestoneTree] panel render failed: " .. tostring(err) .. "; rebuilding")
			self:sync(store, true)
		else
			self:after(store)
		end
	end
	-- the body fills when the opened layer's content has arrived (plan 1.12)
	if self.key then
		local ready = store.tab == self.key
		if ready ~= self.ready then
			self.ready = ready
			shimmer(self, not ready)
			local scroll = self.parts.scroll :: ScrollingFrame
			scroll.Visible = ready
		end
	end
end

function Panel.destroy(self: Panel)
	self.hero:destroy()
	self.render:clear()
	for _, name in { "Backdrop", "Sheet" } do Common.drop(self.root, name) end
end

return Panel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="135">
            <Properties>
              <string name="Name">Sections</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Sections: the client's section titles over the tab's components (DESIGN.md 5.6, plan 2.5).

	    Sections.decorate(rec, n, ctx)   a component frame whose cn is in the table gets a SectionTitle child at
	                                     LayoutOrder -1; it hides when the previous visible sibling has the same cn
	    Sections.refresh(ctx)            recount the chips of every decorated section (after each apply: the counts
	                                     come from cards whose patches never touch the component node itself)
	    Sections.header(parent, o)       the title row itself (hue bar, heavy italic title, chips, hairline), for
	                                     claims that draw their own section (the virtual milestone list)

	Titles and chips are derived from cn and counts only (plan 1.13). No hint text is invented.
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Recipes = require(Core:WaitForChild("Recipes"))
local Layout = require(Core:WaitForChild("Layout"))
local Rich = require(Core:WaitForChild("Rich"))
local Sleek = require(Core:WaitForChild("Sleek"))
local Common = require(script.Parent:WaitForChild("Skins"):WaitForChild("Common"))

local Sections = {}

-- the milestone ladder's name per layer (DESIGN.md 5.6)
local LADDER: { [string]: string } = {
	m = "MILESTONE LADDER", mm = "META LADDER", em = "EXTRA LADDER", pm = "MILESTONE LADDER", cm = "CORRUPTED LADDER",
}
local TITLE: { [string]: string } = {
	buyables = "BUYABLES", upgrades = "UPGRADES", milestones = "MILESTONES", challenges = "CHALLENGES",
	achievements = "TROPHY SHELF", clickables = "CONTROLS", grid = "DISKS",
}
Sections.TITLE = TITLE

function Sections.titleOf(cn: string, layer: string): string?
	if cn == "milestones" then return LADDER[layer] or TITLE.milestones end
	return TITLE[cn]
end

-- ------------------------------------------------------------------------------------------------------ counting
type Counts = { total: number, ready: number, owned: number }
local function count(store: any, id: string, depthLeft: number, want: (n: any) -> string?, out: Counts)
	if depthLeft < 0 then return end
	local n = store:get(id)
	if type(n) ~= "table" then return end
	local k = want(n)
	if k then
		out.total += 1
		if k == "ready" then out.ready += 1 elseif k == "owned" then out.owned += 1 end
		return
	end
	if type(n.c) == "table" then
		for _, cid in n.c do
			if type(cid) == "string" then count(store, cid, depthLeft - 1, want, out) end
		end
	end
end
local WANT: { [string]: (n: any) -> string? } = {
	upgrades = function(n: any): string?
		if n.t ~= "btn" or n.k ~= "upg" then return nil end
		return if n.cls == "bought" then "owned" elseif n.cls == "can" then "ready" else "other"
	end,
	buyables = function(n: any): string?
		if n.t ~= "btn" or n.k ~= "buy" then return nil end
		return if n.cls == "can" then "ready" else "other"
	end,
	milestones = function(n: any): string?
		if n.t ~= "ms" then return nil end
		return if n.done then "owned" else "other"
	end,
	challenges = function(n: any): string?
		if n.t ~= "chal" then return nil end
		return if n.st8 == "done" or n.cls == "done" then "owned" else "other"
	end,
	achievements = function(n: any): string?
		if n.t ~= "ach" then return nil end
		return if n.done then "owned" else "other"
	end,
	grid = function(n: any): string?
		if n.t ~= "btn" or n.k ~= "grid" then return nil end
		return if n.gs == "empty" then "other" else "ready"
	end,
}
local function counts(store: any, id: string, cn: string): Counts?
	local want = WANT[cn]
	if want == nil then return nil end
	local out: Counts = { total = 0, ready = 0, owned = 0 }
	count(store, id, 5, want, out)
	return out
end

-- ------------------------------------------------------------------------------------------------------ the row
export type Chip = { text: string, color: Color3?, bg: Color3?, bgT: number?, seg: { number }? }
export type HeaderOpts = { name: string?, text: string, hue: Color3, chips: { Chip }?, order: number? }
-- the section title row (Sleek): a hue marker, the tracked caps title, a segment meter and caps counts, a hairline
function Sections.header(parent: Instance, o: HeaderOpts): Frame
	local compact = Layout.mode == "COMPACT"
	local f = Common.get(parent, o.name or "SectionTitle", "Frame") :: Frame
	f.LayoutOrder = o.order or -1
	f.Size = UDim2.new(1, 0, 0, if compact then 28 else 32)
	f.ClipsDescendants = true
	f.Active = false
	Common.list(f, true, 12, { valign = Enum.VerticalAlignment.Center })
	local bar = Common.get(f, "HueBar", "Frame") :: Frame
	bar.LayoutOrder = 1
	bar.Size = UDim2.fromOffset(6, 6)
	bar.Rotation = 45
	bar.BackgroundColor3 = o.hue
	bar.BackgroundTransparency = 0
	Common.drop(bar, "Corner")
	local t = Common.get(f, "Title", "TextLabel") :: TextLabel
	t.LayoutOrder = 2
	t.AutomaticSize = Enum.AutomaticSize.X
	t.Size = UDim2.fromOffset(0, if compact then 24 else 28)
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextYAlignment = Enum.TextYAlignment.Center
	local size = if compact then 14 else 15
	local sig = o.text .. "|" .. tostring(size) .. "|sleek"
	if t:GetAttribute("Sig") ~= sig then
		t:SetAttribute("Sig", sig)
		Recipes.title(t, { text = Rich.caps(o.text), role = "label", size = size, stroke = 0, shadow = 0 })
	end
	local chips = o.chips or {}
	for i = 1, 2 do
		local c = chips[i]
		if c then
			local l = Common.chip(f, "Chip" .. i, c.text, { color = c.color, bgT = 1, h = if compact then 22 else 24, role = "caps" })
			l.FontFace = Font.fromName("Montserrat", Enum.FontWeight.ExtraBold)
			l.LayoutOrder = 3 + i * 2
			if c.seg then
				local many = c.seg[1] > 8
				local sg = Sleek.seg(f, "Seg" .. i, c.seg[1], c.seg[2], { w = if many then 3 else 10, h = if many then 12 else 3, gap = if many then 2 else 3 })
				sg.LayoutOrder = 2 + i * 2
			else
				Common.drop(f, "Seg" .. i)
			end
		else
			Common.drop(f, "Chip" .. i)
			Common.drop(f, "Seg" .. i)
		end
	end
	local rule = Common.get(f, "Rule", "Frame") :: Frame
	rule.LayoutOrder = 10
	rule.Size = UDim2.fromOffset(1400, 1)
	rule.BackgroundColor3 = Color3.new(1, 1, 1)
	rule.BackgroundTransparency = 0
	local g = Common.get(rule, "Fade", "UIGradient") :: UIGradient
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.74),
		NumberSequenceKeypoint.new(0.5, 0.9),
		NumberSequenceKeypoint.new(1, 0.95),
	})
	return f
end

-- the chips of a component (DESIGN.md 5.6 table): caps counts, OWNED with a segment meter when it fits
local function chipsOf(cn: string, c: Counts?, hue: Color3): { Chip }
	if c == nil or c.total == 0 then return {} end
	local C = Theme.C
	local seg = if c.total <= 24 then { c.total, c.owned } else nil
	if cn == "upgrades" then
		local out: { Chip } = {}
		if c.ready > 0 then
			table.insert(out, { text = Rich.caps(c.ready .. " ready"), color = Theme.lift(hue, 0.55) })
		end
		table.insert(out, { text = Rich.caps(c.owned .. " / " .. c.total .. " owned"), color = C.soft, seg = seg })
		return out
	elseif cn == "milestones" or cn == "challenges" or cn == "achievements" then
		return { { text = Rich.caps(c.owned .. " / " .. c.total .. (if cn == "achievements" then "" else " done")), color = C.soft,
			seg = seg } }
	elseif cn == "grid" then
		return { { text = Rich.caps(c.ready .. " corrupted"), color = Theme.lift(hue, 0.4) } }
	end
	return { { text = tostring(c.total), color = C.soft } }
end

-- ------------------------------------------------------------------------------------------------------ decorate
local decorated: { [GuiObject]: { id: string, cn: string } } = setmetatable({}, { __mode = "k" }) :: any

-- the previous visible sibling of id (by the store's child order) has the same cn
local function sameAsPrevious(store: any, id: string, cn: string): boolean
	local pid = Common.parentId(id)
	if pid == nil then return false end
	local kids = store:kids(pid)
	local idx = table.find(kids, id)
	if idx == nil then return false end
	for i = idx - 1, 1, -1 do
		local prev = store:get(kids[i])
		if type(prev) == "table" then
			if prev.cn == "blank" or prev.t == "blank" then continue end
			return prev.cn == cn
		end
	end
	return false
end

function Sections.decorate(rec: any, n: any, ctx: any)
	local cn = n.cn
	local title = if type(cn) == "string" then Sections.titleOf(cn, ctx.layer) else nil
	local root = rec.root :: GuiObject
	if title == nil or sameAsPrevious(ctx.store, rec.id, cn) then
		Common.drop(root, "SectionTitle")
		decorated[root] = nil
		return
	end
	-- a section with nothing in it yet (a layer's buyables before the first unlocks) has no title
	local c = counts(ctx.store, rec.id, cn)
	if c ~= nil and c.total == 0 then
		Common.drop(root, "SectionTitle")
		decorated[root] = { id = rec.id, cn = cn }
		return
	end
	decorated[root] = { id = rec.id, cn = cn }
	Sections.header(root, { text = title, hue = ctx.hue, chips = chipsOf(cn, c, ctx.hue) })
end

function Sections.refresh(ctx: any)
	for root, d in decorated do
		if root.Parent == nil then
			decorated[root] = nil
			continue
		end
		local title = Sections.titleOf(d.cn, ctx.layer)
		if title then
			local c = counts(ctx.store, d.id, d.cn)
			if c ~= nil and c.total == 0 then
				Common.drop(root, "SectionTitle")
			else
				Sections.header(root, { text = title, hue = ctx.hue, chips = chipsOf(d.cn, c, ctx.hue) })
			end
		end
	end
end

return Sections
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="136">
            <Properties>
              <string name="Name">Skins</string>
            </Properties>
            <Item class="ModuleScript" referent="137">
              <Properties>
                <string name="Name">Achievement</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Achievement: a trophy tile (Figma 5:180, DESIGN.md 5.7): a done achievement is a gold medallion with its number, a
	missing one a quiet slate with the number dim. The name and goal stay in the game's tooltip (hover), as sent.
]]

local Core = script.Parent.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Common = require(script.Parent:WaitForChild("Common"))

local Achievement = {}

local C = Theme.C

function Achievement.skin(rec: any, n: any, ctx: any): boolean
	local root = rec.root :: Frame
	local l = root:FindFirstChild("Label") :: TextLabel?
	if l == nil then return false end
	local label = l :: TextLabel
	local size = if ctx.mode == "COMPACT" then 72 else 92
	root.Visible = true
	root.Size = UDim2.fromOffset(size, size)
	root.AutomaticSize = Enum.AutomaticSize.None
	for _, name in { "Gradient", "List", "Pad", "Limit", "Shadow" } do Common.drop(root, name) end
	Common.drop(label, "Shadow")
	Common.drop(root, "Num")
	local kids = root:FindFirstChild("Kids")
	if kids and kids:IsA("GuiObject") then kids.Visible = false end
	if n.done then
		Common.fill(root, Theme.lift(C.gold, 0.25), Theme.shade(C.complete, 0.62))
		Common.corner(root, 0.5)
		Common.stroke(root, 3, Theme.lift(C.gold, 0.4), 0)
		Common.glow(root, C.gold, 0.35, 12)
	else
		Common.fill(root, C.panel3, C.panel2)
		Common.corner(root, 0.5)
		Common.stroke(root, 2, C.stroke, 0)
		Common.glow(root, nil)
	end
	Common.text(label, "index", if n.done then C.ink else C.muted)
	label.Size = UDim2.fromScale(1, 1)
	label.Position = UDim2.new()
	label.AutomaticSize = Enum.AutomaticSize.None
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextWrapped = false
	label.Visible = true
	Common.setText(label, Common.esc(Common.str(n.num) or Common.str(n.id) or "?"))
	Common.state(root, if n.done then "owned" else "locked")
	return true
end

return Achievement
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="138">
              <Properties>
                <string name="Name">Buyable</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Buyable: the buyable card (DESIGN.md 5.7): wide (700 du) when a section has at most 2, else a 280 du grid; full
	width on phones.

	    title (card) + LV and the level (big) at the top right
	    the effect lines of the game's text (its <br> lines without the title, level and cost lines: a structural
	    split, no parsing of the numbers)
	    NEXT LEVEL + the cost (numberHeavy + short unit)
	    the hold strip: "HOLD TO BUY" lit when affordable; otherwise "Not enough <unit>" with the pr bar and % inside
	    MAX (green) when the level reached the limit
	The button keeps Render's hold-to-repeat (20 a second after 0.25 s, gated by the 10 px / scroll rule).
]]

local Core = script.Parent.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Rich = require(Core:WaitForChild("Rich"))
local Common = require(script.Parent:WaitForChild("Common"))
local Signatures = require(script.Parent.Parent.Parent:WaitForChild("Signatures"):WaitForChild("Signatures"))

local Buyable = {}

local C = Theme.C

local function stateOf(n: any): string
	local lv, max = Common.str(n.lv), Common.str(n.max)
	if n.cls == "bought" or (lv ~= nil and max ~= nil and lv == max) then return "owned" end
	if n.cls == "can" then return "can" end
	return "notyet"
end

-- the game's text lines that describe the effect (drop the title, the level / tier and the cost lines)
local DROP = { "^Level", "^Tier", "^Amount" }
local function effectLines(n: any): string
	local h = Common.str(n.h)
	if h == nil then return "" end
	local parts = string.split((string.gsub(h, "<br%s*/?>", "\0")), "\0")
	local keep: { string } = {}
	for i, part in parts do
		local plain = Common.plain(part)
		plain = string.gsub(plain, "^%s+", "")
		if plain == "" then continue end
		if i == 1 and string.find(part, "<h", 1, true) then continue end
		local drop = false
		for _, pat in DROP do
			if string.find(plain, pat) then drop = true end
		end
		if string.find(plain, "^Cost") and Common.str(n.co) and Common.str(n.cur) then drop = true end
		if not drop then table.insert(keep, part) end
	end
	return table.concat(keep, "<br>")
end

-- how many buyables share this card's component (cached per apply)
local function siblings(ctx: any, id: string): number
	local pid = Common.parentId(id)
	if pid == nil then return 1 end
	local gid = Common.parentId(pid)
	local key = "buyN:" .. (gid or pid)
	local hit = ctx.cache[key]
	if hit then return hit end
	local nBuy = 0
	local function walk(x: string, d: number)
		if d > 2 then return end
		local node = ctx.store:get(x)
		if type(node) ~= "table" then return end
		if node.t == "btn" and node.k == "buy" then nBuy += 1 end
		if type(node.c) == "table" then
			for _, c in node.c do
				if type(c) == "string" then walk(c, d + 1) end
			end
		end
	end
	walk(gid or pid, 0)
	ctx.cache[key] = math.max(1, nBuy)
	return math.max(1, nBuy)
end

function Buyable.skin(rec: any, n: any, ctx: any): boolean
	local b = rec.root :: TextButton
	local l = b:FindFirstChild("Label") :: TextLabel?
	if l == nil then return false end
	local label = l :: TextLabel
	local state = stateOf(n)
	local compact = ctx.mode == "COMPACT"
	b.Visible = true
	b.AutoButtonColor = false
	Common.drop(b, "Num")
	Common.drop(b, "Gradient")
	local p = Common.surface(b, state, ctx.hue, 16)
	Common.glow(b, if state == "can" then ctx.hue else nil, 0.2, 14)
	local w: number
	if compact then
		w = ctx.contentW
	elseif siblings(ctx, rec.id) <= 2 then
		w = math.min(700, ctx.contentW)
	else
		w = 280
	end
	b.Size = UDim2.fromOffset(w, 0)
	b.AutomaticSize = Enum.AutomaticSize.Y
	local lim = Common.get(b, "Limit", "UISizeConstraint") :: UISizeConstraint
	lim.MinSize = Vector2.new(0, if compact then 96 else 132)
	lim.MaxSize = Vector2.new(math.huge, math.huge)
	Common.pad(b, if compact then 12 else 16, if compact then 12 else 18, if compact then 12 else 16, if compact then 12 else 18)
	Common.list(b, false, 8, { name = "CardList" })

	-- title and effect
	Common.text(label, "body", p.text, 0)
	label.LayoutOrder = 1
	label.ZIndex = 3
	label.Size = UDim2.new(1, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.Visible = true
	local title = Common.plain(Common.str(n.ti) or "")
	local parts = { Common.title(title, "card", p.title) }
	local eff = Common.html(effectLines(n), "body", ctx.layer)
	if eff ~= "" then table.insert(parts, string.format('<font transparency="%.2f">%s</font>', p.textT, eff)) end
	Common.setText(label, table.concat(parts, "\n"))
	-- the level at the top right
	local lvText = Common.str(n.lv)
	if lvText then
		local lv = Common.get(label, "Lv", "TextLabel") :: TextLabel
		Common.text(lv, "big", C.text)
		-- room for "LV " and the digits; a wide card gives a long level (e.g. 21,543,217) the room it needs
		local clear = math.min(math.max(160, math.floor(w * 0.4)), 28 + 23 * #lvText)
		lv.AnchorPoint = Vector2.new(1, 0)
		lv.Position = UDim2.new(1, clear, 0, -4) -- children sit in the padded box: step back out of the padding
		lv.AutomaticSize = Enum.AutomaticSize.XY
		lv.Size = UDim2.new()
		lv.TextXAlignment = Enum.TextXAlignment.Right
		lv.TextWrapped = false
		lv.ZIndex = 4
		local maxText = Common.str(n.max)
		local big = Common.num(lvText, "big", C.text)
		local text = Common.caps("Lv", p.soft) .. " " .. big
		if maxText then text ..= Common.run(Common.esc(" / ") , "number", p.soft) .. Common.num(maxText, "number", p.soft) end
		Common.setText(lv, text)
		-- keep the title clear of the level
		local pad = Common.get(label, "Clear", "UIPadding") :: UIPadding
		pad.PaddingRight = UDim.new(0, clear)
	else
		Common.drop(label, "Lv")
		Common.drop(label, "Clear")
	end

	-- NEXT LEVEL cost
	local co = Common.str(n.co)
	if co and state ~= "owned" then
		local foot = Common.get(b, "Foot", "TextLabel") :: TextLabel
		foot.LayoutOrder = 2
		Common.text(foot, "caps", p.soft)
		foot.Size = UDim2.new(1, 0, 0, 24)
		foot.AutomaticSize = Enum.AutomaticSize.None
		foot.TextXAlignment = Enum.TextXAlignment.Left
		foot.TextYAlignment = Enum.TextYAlignment.Center
		foot.TextWrapped = false
		foot.TextTruncate = Enum.TextTruncate.AtEnd
		local unit = Signatures.unit(n.cur)
		Common.setText(foot, Common.caps("Next level", p.soft) .. "   " ..
			Common.num(co, "numberHeavy", if state == "can" then C.text else C.notYet, unit))
	else
		Common.drop(b, "Foot")
	end

	-- the hold strip
	local strip = Common.get(b, "Hold", "TextLabel") :: TextLabel
	strip.LayoutOrder = 3
	strip.ZIndex = 3
	Common.text(strip, "label", C.text)
	strip.Size = UDim2.new(1, 0, 0, if compact then 30 else 32)
	strip.AutomaticSize = Enum.AutomaticSize.None
	strip.TextXAlignment = Enum.TextXAlignment.Center
	strip.TextYAlignment = Enum.TextYAlignment.Center
	strip.TextWrapped = false
	strip.BackgroundTransparency = 0
	strip.BackgroundColor3 = Color3.new(1, 1, 1)
	Common.drop(strip, "Corner")
	local g = Common.get(strip, "Fill", "UIGradient") :: UIGradient
	g.Rotation = 0
	local pr = Common.pr(n.pr)
	if state == "owned" then
		g.Color = ColorSequence.new(Theme.mix(C.deep, C.bought, 0.3))
		strip.TextColor3 = C.ownedValue
		Common.setText(strip, "MAX")
	elseif state == "can" then
		-- Sleek: the actionable strip is the light hue surface with ink type, like the BUY bars
		g.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Theme.lift(ctx.hue, 0.25)), ColorSequenceKeypoint.new(1, ctx.hue) })
		strip.TextColor3 = C.ink
		Common.setText(strip, Rich.caps("Hold to buy"))
	else
		local lit = Theme.mix(C.deep, ctx.hue, 0.32)
		local track = Theme.mix(C.deep, C.white, 0.05)
		local q = pr or 0
		if q <= 0.001 then
			g.Color = ColorSequence.new(track)
		else
			g.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, lit),
				ColorSequenceKeypoint.new(math.min(0.998, q), lit),
				ColorSequenceKeypoint.new(math.min(0.999, q + 0.001), track),
				ColorSequenceKeypoint.new(1, track),
			})
		end
		strip.TextColor3 = C.text
		local unit = Signatures.unit(n.cur)
		local reason = if unit ~= "" then "Not enough " .. unit else "Not affordable"
		local text = Common.esc(reason)
		if pr then text ..= "   " .. Common.num(Rich.pct(pr), "number", C.text) end
		Common.setText(strip, text)
	end
	Common.state(b, state)
	Common.transition(ctx, n.a, state, b)
	return true
end

return Buyable
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="139">
              <Properties>
                <string name="Name">Challenge</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Challenge: the challenge card (Figma 5:173, DESIGN.md 5.7) and its action button.

	    idle         hue surface, the game's button word (START) in a hue pill
	    active       gold surface; EXIT EARLY
	    completable  gold surface + glow; FINISH
	    done         quiet green, the completions chip
	    locked       mauve, the requirement
	The card's text comes from the structured fields (ti, ds, goal, rw, cur, cmp, lim); the game's own title / body
	html children are hidden (Skins/Generic). The button is the chal's `chalbtn` child, fired as sent.
]]

local Core = script.Parent.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Skin = require(Core:WaitForChild("Skin"))
local Common = require(script.Parent:WaitForChild("Common"))

local Challenge = {}

local C = Theme.C

local function stateOf(n: any): (string, string)
	local st8 = n.st8
	if st8 == "done" or (st8 == nil and n.cls == "done") then return "owned", "done" end
	if st8 == "completable" then return "gold", "completable" end
	if st8 == "active" or n.active then return "gold", "active" end
	if st8 == "locked" then return "locked", "locked" end
	-- idle: a completed-before challenge (cls done) still reads as done; the rest can start
	if n.cls == "done" then return "owned", "done" end
	return "can", "idle"
end
Challenge.stateOf = stateOf

function Challenge.skin(rec: any, n: any, ctx: any): boolean
	local root = rec.root :: Frame
	local l = root:FindFirstChild("Label") :: TextLabel?
	local kids = root:FindFirstChild("Kids") :: Frame?
	if l == nil or kids == nil then return false end
	local label = l :: TextLabel
	local compact = ctx.mode == "COMPACT"
	local surface, st8 = stateOf(n)
	local p = Common.surface(root, surface, ctx.hue, 16)
	Common.glow(root, if st8 == "completable" then C.complete elseif surface == "can" then ctx.hue else nil, 0.45, 16)
	Common.drop(root, "Gradient")
	-- every challenge card of a section has the same width: the widest row (in challenges) shares the content width
	-- evenly, and shorter rows are centred (Generic), so no row ends with a ragged gap or one oversized card
	local gap = if compact then 10 else 12
	local most = 1
	local pid = Common.parentId(rec.id)
	local comp = if pid then Common.parentId(pid) else nil
	local function chals(id: string): number
		local k = 0
		for _, cid in ctx.store:kids(id) do
			local c = ctx.store:get(cid)
			if type(c) == "table" and c.t == "chal" then k += 1 end
		end
		return k
	end
	if pid then most = math.max(most, chals(pid)) end
	if comp then
		for _, rid in ctx.store:kids(comp) do most = math.max(most, chals(rid)) end
	end
	local fit = math.max(1, math.floor((ctx.contentW + gap) / ((if compact then 200 else 300) + gap)))
	local per = math.min(most, fit)
	local w = math.floor((ctx.contentW - gap * (per - 1)) / per)
	root.Size = UDim2.fromOffset(w, 0)
	root.AutomaticSize = Enum.AutomaticSize.Y
	root.Visible = true
	Common.drop(root, "Limit")
	Common.pad(root, 14, 16, 14, 16)
	local cl = Common.list(root, false, 10)
	-- the text on top, the button pinned to the bottom (a row stretches its cards to the tallest one)
	pcall(function() cl.VerticalFlex = Enum.UIFlexAlignment.SpaceBetween end)
	Common.text(label, "small", p.text)
	label.LayoutOrder = 0
	label.Size = UDim2.new(1, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.Visible = true
	local parts: { string } = {}
	table.insert(parts, Common.title(Common.plain(Common.str(n.ti) or ""), "card", p.title))
	local ds = Common.html(n.ds, "body", ctx.layer)
	if ds ~= "" then table.insert(parts, string.format('<font transparency="%.2f">%s</font>', p.textT, ds)) end
	local goal = Common.str(n.goal)
	if goal then
		table.insert(parts, Common.caps("Goal", p.soft) .. "  " .. Common.html(goal, "small", ctx.layer))
	end
	local rw = Common.str(n.rw)
	if rw then
		table.insert(parts, Common.caps("Reward", p.soft) .. "  " .. Common.html(rw, "small", ctx.layer))
	end
	local cur = Common.str(n.cur)
	if cur then
		table.insert(parts, Common.caps("Currently", p.soft) .. "  " .. Common.num(cur, "number", p.value))
	end
	-- a challenge that counts completions says so (players took a finished one for done for good)
	local cmp, lim = Common.str(n.cmp), Common.str(n.lim)
	if lim then
		local how = if lim == "Infinity" then "as many times as you like" else "up to " .. lim .. " times"
		table.insert(parts, Common.caps("Repeatable", p.soft) .. "  "
			.. Common.html("Complete it again " .. how .. ": every completion adds to its reward", "small", ctx.layer))
	end
	Common.setText(label, table.concat(parts, "\n"))
	-- completions chip (cmp / lim; one-shot challenges show none)
	if cmp and cmp ~= "0" then
		local text = if lim and lim ~= "Infinity" then cmp .. " / " .. lim else cmp .. " done"
		local chip = Common.chip(label, "Chip", text, { color = C.ownedValue, bg = Theme.mix(C.deep, C.bought, 0.25), bgT = 0,
			h = if compact then 26 else 28 })
		chip.AnchorPoint = Vector2.new(1, 0)
		chip.Position = UDim2.new(1, 0, 0, 0)
		chip.ZIndex = 4
	else
		Common.drop(label, "Chip")
	end
	kids.LayoutOrder = 1
	Common.list(kids, true, 8, { wraps = true })
	rec.text, rec.textT, rec.base = p.text, 0, Theme.size("small")
	Common.state(root, if surface == "gold" then "can" else surface)
	return true
end

-- the chal's action button: coloured by the card's state, the game's word in caps
function Challenge.button(rec: any, n: any, ctx: any): boolean
	local b = rec.root :: TextButton
	local l = b:FindFirstChild("Label") :: TextLabel?
	if l == nil then return false end
	local label = l :: TextLabel
	local pid = Common.parentId(rec.id)
	local owner = if pid then Common.parentId(pid) else nil
	local chal = if pid then ctx.store:get(pid) else nil
	if type(chal) ~= "table" or chal.t ~= "chal" then
		chal = if owner then ctx.store:get(owner) else nil
	end
	local _, st8 = stateOf(if type(chal) == "table" then chal else {})
	local fill: Color3
	local ink: Color3 = C.text
	if st8 == "done" then
		fill, ink = Theme.mix(C.panel, C.bought, 0.28), C.ownedTitle
	elseif st8 == "completable" or st8 == "active" then
		fill, ink = C.complete, C.ink
	elseif st8 == "locked" then
		fill, ink = Theme.mix(C.panel, C.locked, 0.3), C.lockedTitle
	else
		fill = ctx.hue
		ink = if Theme.darkOnFill(ctx.layer) then C.ink else C.text
	end
	b.AutoButtonColor = false
	b.Visible = true
	b.BackgroundColor3 = fill
	b.BackgroundTransparency = 0
	for _, name in { "Gradient", "Glow", "Num", "Limit" } do Common.drop(b, name) end
	Common.corner(b, 10)
	Common.stroke(b, 1.5, Theme.lift(fill, 0.3), 0.1)
	Common.pad(b, 0, 16, 0, 16)
	b.Size = UDim2.fromOffset(0, if ctx.mode == "COMPACT" then 38 else 42)
	b.AutomaticSize = Enum.AutomaticSize.X
	Common.glow(b, if st8 == "completable" then C.complete else nil, 0.6, 14)
	-- the Substance kit: the hue plate for the live states, the dark plate for done / locked
	local lit = not (st8 == "done" or st8 == "locked")
	if Skin.apply(b, if lit then "cta" else "button", { tint = if lit then Theme.lift(fill, 0.1) else nil, scale = 0.4 }) and lit then
		ink = C.ink
	end
	Common.text(label, "label", ink)
	label.TextWrapped = false
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Size = UDim2.new(0, 0, 1, 0)
	label.AutomaticSize = Enum.AutomaticSize.X
	label.Visible = true
	local word = Common.plain(n.h)
	word = string.upper((string.gsub(string.gsub(word, "^%s+", ""), "%s+$", "")))
	Common.setText(label, Common.esc(word))
	Common.state(b, if st8 == "locked" then "locked" elseif st8 == "done" then "owned" else "can")
	return true
end

return Challenge
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="140">
              <Properties>
                <string name="Name">Clickable</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Clickable: the game's clickables (sp's ignite / reignite / show / pager, t's relics, cp's mode switch).

	    a short label ("<<", "<", ">")   a 52 x 44 pager key
	    anything else                    a card (237 du, auto height) with the game's text verbatim (colours remapped);
	                                     hue when it can be pressed, mauve when not
	Hold clickables keep Render's hold-to-repeat. Signatures give the special ones their own widgets.
]]

local Common = require(script.Parent:WaitForChild("Common"))

local Clickable = {}

function Clickable.skin(rec: any, n: any, ctx: any): boolean
	local b = rec.root :: TextButton
	local l = b:FindFirstChild("Label") :: TextLabel?
	if l == nil then return false end
	local label = l :: TextLabel
	local state = if n.cls == "can" then "can" elseif n.cls == "bought" then "owned" else "notyet"
	local plain = Common.plain(n.h)
	plain = string.gsub(string.gsub(plain, "^%s+", ""), "%s+$", "")
	b.Visible = true
	b.AutoButtonColor = false
	for _, name in { "Gradient", "Glow", "Num", "Limit" } do Common.drop(b, name) end
	local p = Common.surface(b, state, ctx.hue, 12)
	label.Visible = true
	label.ZIndex = 3
	if utf8.len(plain) ~= nil and (utf8.len(plain) :: number) <= 3 then
		-- a pager key
		b.Size = UDim2.fromOffset(52, 44)
		b.AutomaticSize = Enum.AutomaticSize.None
		Common.drop(b, "Pad")
		Common.text(label, "label", p.title)
		label.Size = UDim2.fromScale(1, 1)
		label.AutomaticSize = Enum.AutomaticSize.None
		label.TextXAlignment = Enum.TextXAlignment.Center
		label.TextYAlignment = Enum.TextYAlignment.Center
		label.TextWrapped = false
		Common.setText(label, Common.esc(plain))
	else
		b.Size = UDim2.fromOffset(if ctx.mode == "COMPACT" then math.floor((ctx.contentW - 10) / 2) else 237, 0)
		b.AutomaticSize = Enum.AutomaticSize.Y
		Common.pad(b, 12, 14, 12, 14)
		Common.text(label, "small", p.text)
		label.Size = UDim2.new(1, 0, 0, 0)
		label.AutomaticSize = Enum.AutomaticSize.Y
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextYAlignment = Enum.TextYAlignment.Top
		label.TextWrapped = true
		Common.setText(label, Common.html(n.h, "small", ctx.layer))
	end
	Common.glow(b, if state == "can" then ctx.hue else nil, 0.4, 12)
	Common.state(b, state)
	return true
end

return Clickable
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="141">
              <Properties>
                <string name="Name">Common</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Common: the small builders every panel skin shares. Everything is get-or-create by name and writes every property
	it owns on each call, so a skin can run on every update without leaving stale styling (plan 2.5).

	    Common.get(parent, "Chip", "TextLabel")     get-or-create a child of a class
	    Common.drop(parent, "Chip")                 remove it when the state no longer needs it
	    Common.text(l, "body", color)               a role's font, size and LineHeight (Theme.text) plus colour
	    Common.run("Prestige Boost I", "card", c)   one RichText run in a role's family / weight / size / colour
	    Common.surface(f, state, hue)               the card surface of a state (DESIGN.md 5.7): fill, rim, corner
	    Common.chip(parent, "Chip", "BUY", o)       a 28 du chip; Common.bar(parent, "Bar", p, color) a thin pr bar
	    Common.state(root, "can")                   the State attribute the tests read (can / owned / notyet / locked)

	Text rules (DESIGN.md 9): Sarpanch only for numeral runs, italic only on display and short title roles, no
	outline on text under 20 du, reading text never below the floors (Theme.size holds them).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Core = script.Parent.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Rich = require(Core:WaitForChild("Rich"))
local Html = require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("Html"))

local Common = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

-- ------------------------------------------------------------------------------------------------------ instances
function Common.get(parent: Instance, name: string, class: string): any
	local c = parent:FindFirstChild(name)
	if c and c.ClassName == class then return c end
	if c then c:Destroy() end
	local n = Instance.new(class :: any)
	n.Name = name
	if n:IsA("GuiObject") then
		local g = n :: GuiObject
		g.BorderSizePixel = 0
		g.BackgroundTransparency = 1
	end
	n.Parent = parent
	return n
end
function Common.drop(parent: Instance, name: string)
	local c = parent:FindFirstChild(name)
	if c then c:Destroy() end
end

-- Sleek: panels are square. Scale radii (circles, pills: r < 1) stay; pixel radii become sharp corners
function Common.corner(f: GuiObject, r: number, name: string?)
	if r >= 1 or r <= 0 then
		Common.drop(f, name or "Corner")
		return
	end
	local c = Common.get(f, name or "Corner", "UICorner") :: UICorner
	c.CornerRadius = UDim.new(r, 0)
end
function Common.stroke(f: GuiObject, thickness: number, color: Color3, transparency: number?, name: string?): UIStroke
	local s = Common.get(f, name or "Border", "UIStroke") :: UIStroke
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Thickness = thickness
	s.Color = color
	s.Transparency = transparency or 0
	s.LineJoinMode = Enum.LineJoinMode.Round
	return s
end
function Common.pad(f: GuiObject, top: number, right: number, bottom: number, left: number, name: string?)
	local p = Common.get(f, name or "Pad", "UIPadding") :: UIPadding
	p.PaddingTop, p.PaddingRight = UDim.new(0, top), UDim.new(0, right)
	p.PaddingBottom, p.PaddingLeft = UDim.new(0, bottom), UDim.new(0, left)
end
-- a vertical (or horizontal) list layout named List
export type ListOpts = { align: Enum.HorizontalAlignment?, valign: Enum.VerticalAlignment?, wraps: boolean?, name: string? }
function Common.list(f: GuiObject, horizontal: boolean, gap: number, o: ListOpts?): UIListLayout
	local opts: ListOpts = o or ({} :: ListOpts)
	local l = Common.get(f, opts.name or "List", "UIListLayout") :: UIListLayout
	l.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, gap)
	l.HorizontalAlignment = opts.align or Enum.HorizontalAlignment.Left
	l.VerticalAlignment = opts.valign or Enum.VerticalAlignment.Top
	l.Wraps = opts.wraps == true
	return l
end
-- a vertical top-to-bottom two/three-stop fill on a white background (the surface gradients)
function Common.fill(f: GuiObject, top: Color3, bottom: Color3, mid: Color3?, name: string?)
	f.BackgroundColor3 = WHITE
	f.BackgroundTransparency = 0
	local g = Common.get(f, name or "Fill", "UIGradient") :: UIGradient
	g.Rotation = 90
	g.Color = if mid
		then ColorSequence.new({ ColorSequenceKeypoint.new(0, top), ColorSequenceKeypoint.new(0.5, mid), ColorSequenceKeypoint.new(1, bottom) })
		else ColorSequence.new({ ColorSequenceKeypoint.new(0, top), ColorSequenceKeypoint.new(1, bottom) })
	g.Transparency = NumberSequence.new(0)
end
-- a soft glow around a surface: UIShadow where the engine has it, nothing otherwise (the rim already carries the hue)
function Common.glow(f: GuiObject, color: Color3?, alpha: number?, blur: number?)
	if color == nil or not Theme.caps.UIShadow then
		Common.drop(f, "Glow")
		return
	end
	local s = Common.get(f, "Glow", "UIShadow") :: any
	pcall(function()
		s.Color = color
		s.Transparency = 1 - (alpha or 0.5)
		s.BlurRadius = UDim.new(0, blur or 18)
		s.Offset = UDim2.new()
	end)
end
-- a round radial blob (never a square: the fade reaches 1 by t = .7 and a UICorner keeps it round); nil without Radial
function Common.blob(parent: Instance, name: string, color: Color3, alpha: number): Frame?
	if not Theme.caps.Radial then
		Common.drop(parent, name)
		return nil
	end
	local f = Common.get(parent, name, "Frame") :: Frame
	f.BackgroundColor3 = color
	f.BackgroundTransparency = 0
	f.Active = false
	Common.corner(f, 0.5, "Round")
	local g = Common.get(f, "Radial", "UIGradient") :: UIGradient
	g.Type = Enum.GradientType.Radial
	g.Color = ColorSequence.new(color)
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1 - alpha),
		NumberSequenceKeypoint.new(0.3, 1 - alpha * 0.55),
		NumberSequenceKeypoint.new(0.7, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	return f
end

-- ------------------------------------------------------------------------------------------------------ text
local FAMILY: { [string]: string } = {
	Montserrat = "rbxasset://fonts/families/Montserrat.json",
	Sarpanch = "rbxasset://fonts/families/Sarpanch.json",
	RobotoMono = "rbxasset://fonts/families/RobotoMono.json",
}
Common.FAMILY = FAMILY

function Common.esc(s: string): string
	return Html.escape(s)
end
function Common.plain(html: any): string
	if type(html) ~= "string" then return "" end
	return Html.plain(html)
end
function Common.hex(c: Color3): string
	return "#" .. Theme.toHex(c)
end
function Common.words(s: string): number
	local n = 0
	for _ in string.gmatch(s, "%S+") do n += 1 end
	return n
end

-- a label's type (Theme.text) and colour; RichText on, no stroke
function Common.text(label: GuiObject, role: string, color: Color3?, transparency: number?)
	local l = label :: any
	Theme.text(label, role)
	l.TextColor3 = color or Theme.C.text
	l.TextTransparency = transparency or 0
	l.RichText = true
	l.TextStrokeTransparency = 1
end

-- a plain text label (transparent, RichText, AutomaticSize Y by default)
export type LabelOpts = { wrap: boolean?, autoX: boolean?, align: Enum.TextXAlignment?, order: number? }
function Common.label(parent: Instance, name: string, role: string, color: Color3?, o: LabelOpts?): TextLabel
	local opts: LabelOpts = o or ({} :: LabelOpts)
	local l = Common.get(parent, name, "TextLabel") :: TextLabel
	Common.text(l, role, color)
	l.TextWrapped = opts.wrap ~= false
	l.TextXAlignment = opts.align or Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Top
	l.Active = false
	if opts.autoX then
		l.AutomaticSize = Enum.AutomaticSize.XY
		l.Size = UDim2.new()
	else
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.Size = UDim2.new(1, 0, 0, 0)
	end
	if opts.order then l.LayoutOrder = opts.order end
	return l
end

-- one RichText run in a role (text must already be RichText-safe: escaped or from Rich)
function Common.run(text: string, role: string, color: Color3?, transparency: number?): string
	local r = Theme.ROLES[role] or Theme.ROLES.body
	local attrs = string.format('family="%s" weight="%d" size="%d"', FAMILY[r.family] or FAMILY.Montserrat, r.weight.Value,
		Theme.size(role))
	if color then attrs ..= string.format(' color="%s"', Common.hex(color)) end
	if transparency and transparency > 0 then attrs ..= string.format(' transparency="%.2f"', transparency) end
	local body = if r.italic then "<i>" .. text .. "</i>" else text
	return "<font " .. attrs .. ">" .. body .. "</font>"
end
-- a caps label run (upper case with hair spaces, DESIGN.md 9.1)
function Common.caps(text: string, color: Color3?, role: string?): string
	return Common.run(Common.esc(Rich.caps(text)), role or "caps", color or Theme.C.soft)
end
-- a card / section title run: italic only when it is at most 4 words (DESIGN.md 9.1)
function Common.title(text: string, role: string, color: Color3?): string
	local r = Theme.ROLES[role] or Theme.ROLES.card
	local size = Theme.size(role)
	local attrs = string.format('family="%s" weight="%d" size="%d"', FAMILY[r.family] or FAMILY.Montserrat, r.weight.Value, size)
	if color then attrs ..= string.format(' color="%s"', Common.hex(color)) end
	local body = Common.esc(text)
	if r.italic and Common.words(text) <= 4 then body = "<i>" .. body .. "</i>" end
	return "<font " .. attrs .. ">" .. body .. "</font>"
end
-- a game number string in a Sarpanch role, words / units as a Montserrat run (Rich.num)
function Common.num(s: string, role: string, color: Color3?, unit: string?, onFill: boolean?): string
	local r = Theme.ROLES[role] or Theme.ROLES.number
	local size = Theme.size(role)
	local text = if unit and unit ~= "" then s .. " " .. unit else s
	local body = Rich.num(text, { size = size, onFill = onFill, unit = color })
	local attrs = string.format('family="%s" weight="%d" size="%d"', FAMILY[r.family] or FAMILY.Sarpanch, r.weight.Value, size)
	if color then attrs ..= string.format(' color="%s"', Common.hex(color)) end
	return "<font " .. attrs .. ">" .. body .. "</font>"
end
-- the game's HTML as body RichText with the layer's colour remap (DESIGN.md 11.2)
function Common.html(html: any, role: string, layer: string?): string
	if type(html) ~= "string" or html == "" then return "" end
	return Rich.html(html, Theme.size(role), layer)
end
function Common.setText(label: GuiObject, s: string)
	local l = label :: any
	if l.Text ~= s then l.Text = s end
end
-- pcall for functions that return nothing (the result is ok, err)
function Common.try(f: (...any) -> ...any, ...: any): (boolean, any)
	return pcall(function(...: any): any
		f(...)
		return nil
	end, ...)
end

-- ------------------------------------------------------------------------------------------------------ surfaces
export type Palette = { top: Color3, bottom: Color3, rim: Color3, rimT: number, title: Color3, text: Color3, textT: number,
	soft: Color3, value: Color3 }
-- the card surface of each state (DESIGN.md 5.7, 11.2): the layer hue paints only the actionable state
function Common.palette(state: string, hue: Color3): Palette
	local C = Theme.C
	-- Sleek (art/ui/clean STYLES[1]): translucent near-black slabs with a 1 du hairline; the hue tints only the
	-- actionable card, owned is a faint green, locked and not-yet stay neutral
	local top, bottom = Color3.fromHex("0c1119"), Color3.fromHex("080b12")
	if state == "can" then
		return { top = Theme.mix(top, hue, 0.2), bottom = Theme.mix(bottom, hue, 0.05), rim = hue, rimT = 0.5,
			title = C.text, text = C.text, textT = 0.1, soft = C.soft, value = C.text }
	elseif state == "owned" then
		return { top = Theme.mix(top, C.bought, 0.085), bottom = Theme.mix(bottom, C.bought, 0.025), rim = C.bought, rimT = 0.72,
			title = C.ownedTitle, text = C.text, textT = 0.22, soft = C.soft, value = C.ownedValue }
	elseif state == "gold" then
		return { top = Theme.mix(top, C.complete, 0.2), bottom = Theme.mix(bottom, C.complete, 0.05), rim = C.complete, rimT = 0.35,
			title = C.text, text = C.text, textT = 0.1, soft = C.soft, value = C.text }
	elseif state == "locked" then
		return { top = Color3.fromHex("07090e"), bottom = Color3.fromHex("05070b"), rim = C.white, rimT = 0.92,
			title = C.lockedTitle, text = C.text, textT = 0.3, soft = C.soft, value = C.notYet }
	end
	-- notyet: unlocked, not affordable (a trace of mauve)
	return { top = Theme.mix(top, C.locked, 0.1), bottom = Theme.mix(bottom, C.locked, 0.03), rim = C.locked, rimT = 0.55,
		title = C.text, text = C.text, textT = 0.14, soft = C.soft, value = C.notYet }
end
-- fill + hairline of a card in a state (square corners; the radius argument is kept for signatures that ask for one)
function Common.surface(f: GuiObject, state: string, hue: Color3, radius: number?): Palette
	local p = Common.palette(state, hue)
	Common.fill(f, p.top, p.bottom)
	if radius and radius > 0 and radius <= 6 then
		Common.corner(f, radius)
	else
		Common.drop(f, "Corner")
	end
	local st = Common.stroke(f, 1, p.rim, p.rimT)
	st.LineJoinMode = Enum.LineJoinMode.Miter
	Common.drop(f, "Gradient") -- Style.apply's game gradient, if an old look was ever applied
	return p
end
function Common.state(root: Instance, state: string)
	if root:GetAttribute("State") ~= state then root:SetAttribute("State", state) end
end

-- ------------------------------------------------------------------------------------------------------ chips, bars
export type ChipOpts = { bg: Color3?, bgT: number?, color: Color3?, role: string?, h: number?, rich: boolean?, stroke: Color3? }
-- a chip: a TextLabel with a background and corner, sized from its text (two spaces of side padding)
function Common.chip(parent: Instance, name: string, text: string, o: ChipOpts?): TextLabel
	local opts: ChipOpts = o or ({} :: ChipOpts)
	local l = Common.get(parent, name, "TextLabel") :: TextLabel
	local role = opts.role or "label"
	Common.text(l, role, opts.color or Theme.C.text)
	l.TextWrapped = false
	l.TextXAlignment = Enum.TextXAlignment.Center
	l.TextYAlignment = Enum.TextYAlignment.Center
	l.AutomaticSize = Enum.AutomaticSize.X
	l.Size = UDim2.fromOffset(0, opts.h or 28)
	l.BackgroundColor3 = opts.bg or BLACK
	l.BackgroundTransparency = if opts.bg == nil and opts.bgT == nil then 0.55 else (opts.bgT or 0)
	l.Active = false
	-- side padding as spaces (a UIPadding per chip costs an instance on every card)
	Common.setText(l, "  " .. (if opts.rich then text else Common.esc(text)) .. "  ")
	Common.drop(l, "Corner")
	Common.drop(l, "Pad")
	if opts.stroke then
		Common.stroke(l, 1, opts.stroke, 0.35).LineJoinMode = Enum.LineJoinMode.Miter
	else
		Common.drop(l, "Border")
	end
	return l
end
-- a thin progress bar (p in 0..1): one Frame whose gradient shows the filled part (no fill child)
function Common.bar(parent: Instance, name: string, p: number, color: Color3, h: number?): Frame
	local f = Common.get(parent, name, "Frame") :: Frame
	f.Size = UDim2.new(1, 0, 0, h or 5)
	f.BackgroundColor3 = WHITE
	f.BackgroundTransparency = 0
	f.Active = false
	Common.drop(f, "Corner")
	local g = Common.get(f, "Fill", "UIGradient") :: UIGradient
	local q = math.clamp(p, 0, 1)
	local track = Color3.fromRGB(38, 44, 56)
	if q <= 0.001 then
		g.Color = ColorSequence.new(track)
	elseif q >= 0.999 then
		g.Color = ColorSequence.new(color)
	else
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, color),
			ColorSequenceKeypoint.new(q, color),
			ColorSequenceKeypoint.new(math.min(1, q + 0.001), track),
			ColorSequenceKeypoint.new(1, track),
		})
	end
	g.Rotation = 0
	return f
end

-- ------------------------------------------------------------------------------------------------------ motion
-- the buy feedback (DESIGN.md 5.4): a card that turns owned bumps and its rim flashes; keyed by (layer, the action's
-- id), never by the path id; nothing plays the first time a key is seen after the panel opened
local lastState: { [string]: string } = {}
function Common.transition(ctx: any, a: any, state: string, root: GuiObject)
	if type(a) ~= "table" then return end
	local key = tostring(ctx.layer) .. ":" .. tostring(a[1]) .. ":" .. tostring(a[3])
	local prev = lastState[key]
	lastState[key] = state
	if ctx.firstSeen(key) or prev == nil or prev == state then return end
	if prev == "can" and state == "owned" then
		local Motion = require(Core:WaitForChild("Motion")) :: any
		-- a card that lays out its own children: Motion.flash animates its outline and restores the resting rim, so a
		-- second tween here would fight it on the same UIStroke (the later tween wins and ends opaque)
		local outlined = root:FindFirstChildWhichIsA("UIGridStyleLayout") ~= nil
		Motion.bump(root, 0.06)
		local rim = root:FindFirstChild("Border")
		if rim and rim:IsA("UIStroke") and not outlined then
			local final = rim.Transparency
			rim.Transparency = 0
			rim.Color = Color3.new(1, 1, 1)
			Motion.tween(rim, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Transparency = final, Color = Theme.C.bought }, "flash:" .. key)
		end
	end
end

-- a per mille progress value (view: 0..1000) -> 0..1, nil when absent
function Common.pr(v: any): number?
	if type(v) ~= "number" then return nil end
	return math.clamp(v / 1000, 0, 1)
end
-- nil, false and JS null are "none" (plan 1.8)
function Common.str(v: any): string?
	if type(v) == "string" and v ~= "" then return v end
	if type(v) == "number" then return tostring(v) end
	return nil
end

-- the row id's parent ("tab.2.5.1" -> "tab.2.5")
function Common.parentId(id: string): string?
	return string.match(id, "^(.*)%.%d+$")
end
function Common.depth(id: string): number
	local _, n = string.gsub(id, "%.", "")
	return n
end

return Common
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="142">
              <Properties>
                <string name="Name">CompactOwned</string>
                <string name="Source"><![CDATA[--!strict
--[[
	CompactOwned: the quiet card of an owned upgrade inside a fully owned tier (WIDE / MEDIUM) and every expanded owned
	upgrade on phones (DESIGN.md 5.7): index + title (2 lines allowed) on the left, the effect value in the owned green
	at the bottom right ("Active" when the upgrade shows no value). No glow, no cost, no chip.
]]

local Core = script.Parent.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Common = require(script.Parent:WaitForChild("Common"))

local CompactOwned = {}

local C = Theme.C

function CompactOwned.skin(rec: any, n: any, ctx: any): boolean
	local b = rec.root :: TextButton
	local l = b:FindFirstChild("Label") :: TextLabel?
	if l == nil then return false end
	local label = l :: TextLabel
	local compact = ctx.mode == "COMPACT"
	b.Visible = true
	b.AutoButtonColor = false
	-- the full card's parts (a card that was BUY a moment ago): its bar, cost footer and the lit top edge
	for _, name in { "Num", "Gradient", "Glow", "Bar", "Foot", "MotionFlash" } do Common.drop(b, name) end
	for _, name in { "Chip", "TopLine", "TickV1", "TickV2" } do Common.drop(label, name) end
	Common.surface(b, "owned", ctx.hue, 12)
	b.Size = UDim2.fromOffset(ctx.cardW, 0)
	b.AutomaticSize = Enum.AutomaticSize.Y
	local lim = Common.get(b, "Limit", "UISizeConstraint") :: UISizeConstraint
	lim.MinSize = Vector2.new(0, if compact then 56 else 72)
	lim.MaxSize = Vector2.new(math.huge, math.huge)
	Common.pad(b, 10, 12, 10, 12)
	Common.list(b, false, 4, { name = "CardList" })

	Common.text(label, "cardSmall", C.ownedTitle, 0)
	label.LayoutOrder = 1
	label.ZIndex = 3
	label.Size = UDim2.new(1, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.Visible = true
	local idx = Common.str(n.n) or Common.str(n.id) or ""
	local title = Common.plain(Common.str(n.ti) or "")
	local text = Common.run(Common.esc(idx), "badge", Color3.fromHex("7fe6a0"), 0.2) .. "  " .. Common.title(title, "cardSmall", C.ownedTitle)
	if compact then
		-- phones list each owned upgrade with its effect as body text (DESIGN.md 5.7 COMPACT)
		local ds = Common.html(n.ds, "body", ctx.layer)
		if ds ~= "" then text ..= "\n" .. string.format('<font transparency="0.18">%s</font>', ds) end
	end
	Common.setText(label, text)

	local eff = Common.get(b, "Eff", "TextLabel") :: TextLabel
	eff.LayoutOrder = 2
	eff.ZIndex = 3
	eff.BackgroundTransparency = 1
	eff.Size = UDim2.new(1, 0, 0, 22)
	eff.AutomaticSize = Enum.AutomaticSize.None
	eff.TextXAlignment = Enum.TextXAlignment.Right
	eff.TextYAlignment = Enum.TextYAlignment.Center
	eff.TextWrapped = false
	eff.TextTruncate = Enum.TextTruncate.AtEnd
	Common.drop(eff, "Corner")
	Common.drop(eff, "Border") -- the BUY card's value well
	local ef = Common.str(n.ef)
	if ef then
		Common.text(eff, "numberHeavy", C.ownedValue)
		Common.setText(eff, Common.num(ef, "numberHeavy", C.ownedValue))
	else
		Common.text(eff, "label", C.ownedValue)
		Common.setText(eff, "Active")
	end
	Common.state(b, "owned")
	Common.transition(ctx, n.a, "owned", b)
	return true
end

return CompactOwned
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="143">
              <Properties>
                <string name="Name">Generic</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Generic: the quiet panel look for every node no card skin handles (DESIGN.md 5.6, plan 2.5).

	    containers (col / row / tabs)   panel rhythm: section gap between components, card gap inside them, rows wrap
	                                    left-aligned; an upgrades row becomes a tier-board row (Skins/Upgrade.tier)
	    display-text / raw html         NOTES rows: a quiet panel2 strip with the game's line verbatim (colours remapped)
	    other html                      body text in soft, remapped colours; empty text is hidden
	    blank / hr / h-line / v-line    dropped (the section rhythm replaces them)
	    small buttons                   respec / master / sell / toggle / chalbtn / malware / nested tabs / reset:
	                                    40 du pills, hue when actionable, mauve when not
	    about                           the Options HOTKEYS card (the unlocked hotkeys; no credits in game)
	    bar (rbx-burn)                  a themed bar with the game's text; st8 picks ember / grey / gold
	The game's own per-thing CSS (st) is ignored in the panel: the template sets the look.
]]

local Core = script.Parent.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Common = require(script.Parent:WaitForChild("Common"))
local Sections = require(script.Parent.Parent:WaitForChild("Sections"))

local Generic = {}

local C = Theme.C

local HIDDEN_CN: { [string]: boolean } = { blank = true, ["h-line"] = true, ["v-line"] = true }
local NOTE_CN: { [string]: boolean } = { ["display-text"] = true, ["raw-html"] = true }

local function parentRec(ctx: any, id: string): any?
	local pid = Common.parentId(id)
	if pid == nil then return nil end
	return ctx.render.recs[pid]
end

-- ------------------------------------------------------------------------------------------------------ containers
local function container(rec: any, n: any, ctx: any)
	local root = rec.root :: Frame
	local compact = ctx.mode == "COMPACT"
	root.BackgroundTransparency = 1
	Common.drop(root, "Gradient")
	Common.drop(root, "Border")
	Common.drop(root, "Corner")
	Common.drop(root, "Pad")
	local depth = Common.depth(rec.id)
	local parent = parentRec(ctx, rec.id)
	local inUpgrades = parent ~= nil and parent.node and parent.node.cn == "upgrades"
	if n.t == "col" then
		-- the tab root and its direct content column hold components: the section gap; inside a component: the card gap
		local gap = if depth <= 1 then (if compact then 16 else 28) else (if compact then 10 else 12)
		Common.list(root, false, gap, { align = Enum.HorizontalAlignment.Left })
		if rec.autoW then
			root.Size = UDim2.new()
			root.AutomaticSize = Enum.AutomaticSize.XY
		else
			root.Size = UDim2.new(1, 0, 0, 0)
			root.AutomaticSize = Enum.AutomaticSize.Y
		end
	else
		-- row / nested tabs: horizontal, wrapping, left-aligned
		local gap = if compact then 10 else 12
		local l = Common.list(root, true, gap, { align = Enum.HorizontalAlignment.Left, valign = Enum.VerticalAlignment.Top,
			wraps = not rec.autoW })
		-- a row of challenges: centred, and its cards stretched to one height (their buttons then line up)
		local chalRow = false
		for _, cid in ctx.store:kids(rec.id) do
			local c = ctx.store:get(cid)
			if type(c) == "table" and c.t == "chal" then
				chalRow = true
				break
			end
		end
		if chalRow then l.HorizontalAlignment = Enum.HorizontalAlignment.Center end
		pcall(function()
			l.ItemLineAlignment = if inUpgrades or chalRow then Enum.ItemLineAlignment.Stretch else Enum.ItemLineAlignment.Start
		end)
		if rec.autoW then
			root.Size = UDim2.new()
			root.AutomaticSize = Enum.AutomaticSize.XY
		else
			root.Size = UDim2.new(1, 0, 0, 0)
			root.AutomaticSize = Enum.AutomaticSize.Y
		end
	end
	-- the text children inherit (html inside rows / columns)
	rec.text, rec.textT, rec.base = C.soft, 0, Theme.size("body")
	if n.cn and Sections.titleOf(n.cn, ctx.layer) then
		Sections.decorate(rec, n, ctx)
	else
		Common.drop(root, "SectionTitle")
	end
	local Upgrade = require(script.Parent:WaitForChild("Upgrade")) :: any
	if inUpgrades and n.t == "row" then
		Upgrade.tier(rec, n, ctx)
	else
		Common.drop(root, "Rail")
	end
	Upgrade.summary(rec, n, ctx)
	Upgrade.buyAll(rec, n, ctx)
	root.Visible = true
end

-- ------------------------------------------------------------------------------------------------------ html
local function textLabel(rec: any): TextLabel
	local root = rec.root :: Frame
	local l = root:FindFirstChild("Text")
	if l and l:IsA("TextLabel") then return l end
	if l then l:Destroy() end
	return Common.label(root, "Text", "body", C.soft)
end

local function html(rec: any, n: any, ctx: any): boolean
	if rec.kind == "svg" then return false end -- the exploration map keeps the old drawing (cached by its html)
	local root = rec.root :: Frame
	local cn = n.cn
	local parent = parentRec(ctx, rec.id)
	local pk = if parent then parent.kind else nil
	-- a challenge draws its own title / text from the structured fields
	if pk == "chal" or cn == "blank" then
		root.Visible = false
		return true
	end
	-- the hero's components when they are not claimed (deeper than the hero looks): a resource-display without text
	if cn == "resource-display" and Common.plain(n.h) == "" then
		root.Visible = false
		return true
	end
	local text = Common.html(n.h, "body", ctx.layer)
	local plain = Common.plain(n.h)
	if not string.find(plain, "%S") then
		root.Visible = false
		return true
	end
	root.Visible = true
	local l = textLabel(rec)
	local note = NOTE_CN[cn] == true or (cn == nil and Common.depth(rec.id) <= 2)
	if note then
		-- NOTES row: panel2 strip, a hue tick at the left, the game's line verbatim
		root.BackgroundColor3 = C.panel2
		root.BackgroundTransparency = 0
		Common.corner(root, 10)
		Common.pad(root, 10, 14, 10, 16)
		local tick = Common.get(root, "Tick", "Frame") :: Frame
		tick.BackgroundColor3 = ctx.hue
		tick.BackgroundTransparency = 0.2
		tick.Size = UDim2.new(0, 3, 1, -6)
		tick.Position = UDim2.fromOffset(-10, 3)
		Common.corner(tick, 2, "TickCorner")
		Common.text(l, "body", C.text)
		l.TextTransparency = 0.08
	else
		root.BackgroundTransparency = 1
		Common.drop(root, "Corner")
		Common.drop(root, "Pad")
		Common.drop(root, "Tick")
		Common.text(l, "body", C.soft)
	end
	l.TextXAlignment = Enum.TextXAlignment.Left
	if rec.autoW then
		root.Size = UDim2.new()
		root.AutomaticSize = Enum.AutomaticSize.XY
		l.Size = UDim2.new()
		l.AutomaticSize = Enum.AutomaticSize.XY
		local lim = Common.get(l, "Limit", "UISizeConstraint") :: UISizeConstraint
		lim.MaxSize = Vector2.new(if ctx.mode == "COMPACT" then 420 else 640, math.huge)
	else
		root.Size = UDim2.new(1, 0, 0, 0)
		root.AutomaticSize = Enum.AutomaticSize.Y
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		Common.drop(l, "Limit")
	end
	l.TextWrapped = true
	Common.setText(l, text)
	return true
end

-- ------------------------------------------------------------------------------------------------------ buttons
local SMALL: { [string]: boolean } = {
	respec = true, master = true, sell = true, toggle = true, chalbtn = true, malware = true, tab = true, reset = true,
	click = true, menu = true,
}
function Generic.button(rec: any, n: any, ctx: any): boolean
	local b = rec.root :: TextButton
	local l = b:FindFirstChild("Label") :: TextLabel?
	if l == nil then return false end
	local k = n.k
	local compact = ctx.mode == "COMPACT"
	local can = n.cls == "can" or n.cls == "cur" or n.cls == "perk" or n.cls == "pseudo"
	local danger = k == "respec" or k == "sell"
	local state = if n.cls == "bought" or n.cls == "pseudo" or n.cls == "done" then "owned" elseif can then "can" else "notyet"
	local fill: Color3
	local ink: Color3
	if state == "owned" then
		fill, ink = Theme.mix(C.panel, C.bought, 0.22), C.ownedTitle
	elseif not can then
		fill, ink = Theme.mix(C.panel, C.locked, 0.22), C.lockedTitle
	elseif danger then
		fill, ink = Theme.mix(C.panel, C.danger, 0.45), C.text
	elseif k == "tab" and n.cls ~= "cur" then
		fill, ink = C.panel2, C.soft
	else
		fill = ctx.hue
		ink = if Theme.darkOnFill(ctx.layer) then C.ink else C.text
	end
	b.AutoButtonColor = false
	b.BackgroundColor3 = fill
	b.BackgroundTransparency = 0
	Common.drop(b, "Gradient")
	Common.drop(b, "Glow")
	Common.drop(b, "Num")
	Common.drop(b, "Limit")
	Common.corner(b, 10)
	Common.stroke(b, 1.5, if can and not danger then Theme.lift(fill, 0.35) else C.stroke, if can then 0.1 else 0.3)
	Common.pad(b, 6, 14, 6, 14)
	local h = if compact then 38 else 40
	b.Size = UDim2.fromOffset(0, h)
	b.AutomaticSize = Enum.AutomaticSize.XY
	local role = "label"
	Common.text(l, role, ink)
	l.TextWrapped = false
	l.TextXAlignment = Enum.TextXAlignment.Center
	l.TextYAlignment = Enum.TextYAlignment.Center
	l.Size = UDim2.new(0, 0, 1, 0)
	l.AutomaticSize = Enum.AutomaticSize.X
	l.Visible = true
	-- a single line: the game's first line (plain); the cost line of a malware button becomes a number run
	local text: string
	if k == "malware" then
		local co = Common.str(n.co)
		text = Common.esc(if n.cls == "pseudo" then "INFECTED" else "INFECT")
		if co and n.cls ~= "pseudo" then text ..= "  " .. Common.num(co, "number", ink) end
	else
		local first = Common.plain(n.h)
		first = string.gsub(first, "\n.*$", "")
		first = string.gsub(first, "^%s+", "")
		first = string.gsub(first, "%s+$", "")
		if #first > 40 then
			-- a long clickable text: keep it readable on two lines inside a fixed width
			l.TextWrapped = true
			l.TextXAlignment = Enum.TextXAlignment.Left
			b.AutomaticSize = Enum.AutomaticSize.Y
			b.Size = UDim2.fromOffset(if compact then 260 else 300, h)
			l.Size = UDim2.new(1, 0, 0, 0)
			l.AutomaticSize = Enum.AutomaticSize.Y
			Common.text(l, "small", ink)
			text = Common.esc(first)
		else
			text = Common.esc(if k == "tab" then string.upper(first) else first)
		end
	end
	Common.setText(l, text)
	Common.state(b, state)
	b.Visible = true
	return true
end

-- ------------------------------------------------------------------------------------------------------ about
local function about(rec: any, n: any, ctx: any): boolean
	local root = rec.root :: Frame
	root.BackgroundColor3 = C.panel2
	root.BackgroundTransparency = 0
	root.Size = UDim2.new(1, 0, 0, 0)
	root.AutomaticSize = Enum.AutomaticSize.Y
	Common.corner(root, 14)
	Common.stroke(root, 1, C.stroke, 0.2)
	Common.pad(root, 16, 20, 16, 20)
	Common.list(root, false, 8)
	-- the credits are not shown in game (the README keeps them); the card lists the unlocked hotkeys
	Sections.header(root, { text = "HOTKEYS", hue = ctx.hue, order = 0, name = "Head" })
	Common.drop(root, "Body")
	-- the unlocked hotkeys: keycap run + description, one per line
	local keys: { string } = {}
	if type(n.keys) == "table" then
		for _, kk in n.keys do
			if type(kk) == "table" and type(kk.k) == "string" then
				table.insert(keys, Common.run(Common.esc(kk.k), "label", C.gold) .. "   " .. Common.run(Common.esc(tostring(kk.d or "")), "body", C.soft))
			end
		end
	end
	local kl = Common.label(root, "Keys", "body", C.text, { order = 2 })
	kl.Visible = #keys > 0
	Common.setText(kl, table.concat(keys, "\n"))
	root.Visible = #keys > 0
	return true
end

-- ------------------------------------------------------------------------------------------------------ bar
local function bar(rec: any, n: any, ctx: any): boolean
	local root = rec.root :: Frame
	local l = root:FindFirstChild("Label") :: TextLabel?
	local fill = root:FindFirstChild("Fill") :: Frame?
	if l == nil or fill == nil then return false end
	local st8 = n.st8
	local col = if st8 == "permanent" then C.gold elseif st8 == "ashed" then C.muted else C.ember
	local w = if ctx.mode == "COMPACT" then 260 else 320
	root.Size = UDim2.fromOffset(w, 48)
	root.AutomaticSize = Enum.AutomaticSize.None
	root.BackgroundColor3 = C.deep
	root.BackgroundTransparency = 0
	Common.drop(root, "Gradient")
	Common.drop(root, "List")
	Common.corner(root, 10)
	Common.stroke(root, 1.5, col, 0.35)
	root.ClipsDescendants = true
	local p = math.clamp(tonumber(n.p) or 0, 0, 1)
	fill.BackgroundColor3 = col
	fill.BackgroundTransparency = 0.55
	fill.Position = UDim2.new()
	fill.Size = UDim2.fromScale(p, 1)
	fill.ZIndex = 0
	Common.drop(fill, "Gradient")
	Common.text(l, "small", C.text)
	l.Size = UDim2.fromScale(1, 1)
	l.AutomaticSize = Enum.AutomaticSize.None
	l.TextXAlignment = Enum.TextXAlignment.Center
	l.TextYAlignment = Enum.TextYAlignment.Center
	l.ZIndex = 2
	l.Visible = true
	local word = if st8 == "permanent" then "PERMANENT" elseif st8 == "ashed" then "ASHED" else "BURNING"
	local bp = Common.pr(n.bp)
	local text = Common.caps(word, col)
	if bp and st8 == "burning" then
		text ..= "   " .. Common.num(require(Core:WaitForChild("Rich")).pct(bp), "number", C.text)
	end
	Common.setText(l, text)
	local kids = root:FindFirstChild("Kids")
	if kids and kids:IsA("GuiObject") then kids.Visible = false end
	root.Visible = true
	return true
end

-- ------------------------------------------------------------------------------------------------------ dispatch
function Generic.skin(rec: any, n: any, ctx: any): boolean
	local t = n.t
	if t == "col" or t == "row" then
		container(rec, n, ctx)
		return true
	elseif t == "tabs" then
		container(rec, n, ctx)
		return true
	elseif t == "html" then
		return html(rec, n, ctx)
	elseif t == "blank" or t == "hr" or HIDDEN_CN[n.cn or ""] then
		(rec.root :: GuiObject).Visible = false
		return true
	elseif t == "btn" and SMALL[n.k or ""] then
		return Generic.button(rec, n, ctx)
	elseif t == "about" then
		return about(rec, n, ctx)
	elseif t == "bar" then
		return bar(rec, n, ctx)
	end
	return false
end

return Generic
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="144">
              <Properties>
                <string name="Name">GridTile</string>
                <string name="Source"><![CDATA[--!strict
--[[
	GridTile: a corruption disk (cp grid cells, DESIGN.md 5.7 "Corruption tile" and 6 cp).

	    empty      quiet slot: the slot number only (#5f8a58)
	    corrupted  Trojan: lime dashed rim; Backdoor: crimson dashed rim; kind (caps) + LV (big)
	    active / chosen  gold rim and the fix bar from gp (per mille)
	From gs / lv / kind / gp only (plan P9: there is no "fixed" tile state).
]]

local Core = script.Parent.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Recipes = require(Core:WaitForChild("Recipes"))
local Common = require(script.Parent:WaitForChild("Common"))

local GridTile = {}

local C = Theme.C

function GridTile.skin(rec: any, n: any, ctx: any): boolean
	local b = rec.root :: TextButton
	local l = b:FindFirstChild("Label") :: TextLabel?
	if l == nil then return false end
	local label = l :: TextLabel
	local size = if ctx.mode == "COMPACT" then 84 else 104
	local gs = n.gs
	local backdoor = n.kind == "backdoor"
	local rimColor = if gs == "active" or gs == "chosen" then C.complete elseif backdoor then C.danger else C.termLime
	b.Visible = true
	b.AutoButtonColor = false
	b.Size = UDim2.fromOffset(size, size)
	b.AutomaticSize = Enum.AutomaticSize.None
	for _, name in { "Gradient", "Glow", "Num", "Limit", "Pad" } do Common.drop(b, name) end
	Common.corner(b, 12)
	if gs == "empty" then
		Common.fill(b, Color3.fromRGB(8, 20, 10), Color3.fromRGB(4, 12, 6))
		Common.stroke(b, 1, C.stableId, 0.5)
	else
		Common.fill(b, Color3.fromRGB(10, 34, 14), Color3.fromRGB(4, 16, 7))
		local s = Common.stroke(b, 2, rimColor, 0)
		if gs == "corrupted" then Recipes.dashed(s, { color = rimColor }) else Common.drop(s, "Dash") end
	end
	Common.text(label, "small", C.termLime)
	label.Size = UDim2.fromScale(1, 1)
	label.AutomaticSize = Enum.AutomaticSize.None
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextWrapped = true
	label.Visible = true
	local slot = Common.str(n.id) or ""
	local text: string
	if gs == "empty" then
		text = Common.run(Common.esc(slot), "label", C.stableId)
	else
		local kind = if backdoor then "Backdoor" else "Trojan"
		text = Common.caps(kind, rimColor) .. "\n" .. Common.caps("Lv", C.termDim) .. " " .. Common.num(Common.str(n.lv) or "0", "number", C.text)
			.. "\n" .. Common.run(Common.esc(slot), "label", C.termDim)
	end
	Common.setText(label, text)
	local gp = Common.pr(n.gp)
	if gp and (gs == "active" or gs == "chosen") then
		local bar = Common.bar(b, "Bar", gp, C.complete, 5)
		bar.AnchorPoint = Vector2.new(0.5, 1)
		bar.Position = UDim2.new(0.5, 0, 1, -8)
		bar.Size = UDim2.new(1, -20, 0, 5)
		bar.ZIndex = 4
	else
		Common.drop(b, "Bar")
	end
	Common.state(b, if gs == "empty" then "notyet" else "can")
	return true
end

return GridTile
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="145">
              <Properties>
                <string name="Name">Milestone</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Milestone: a milestone row (DESIGN.md 5.7 "Milestone row").

	    NEXT (the first not-done row in ladder order, plan 1.13)  spotlight card: hue surface, NEXT MILESTONE caps,
	                                                              title (card), the effect (body)
	    done                                                      quiet green row: title (cardSmall) + effect (small)
	    future                                                    faint row: title + effect in soft
	    infected (mal)                                            danger rim; the effect splits at the game's <hr> into
	                                                              the base effect and the malware effect (plan 1.4)
	A row's children (the INFECT button of the malware ladder) sit under the text, skinned as small buttons.
	Long ladders are virtualised by the panel (Panel/Virtual); this skin draws the short ones.
]]

local Core = script.Parent.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Common = require(script.Parent:WaitForChild("Common"))

local Milestone = {}

local C = Theme.C

-- the id of the NEXT milestone among the row's siblings (cached per apply)
function Milestone.nextOf(ctx: any, pid: string?): string?
	if pid == nil then return nil end
	local key = "next:" .. pid
	local hit = ctx.cache[key]
	if hit ~= nil then return if hit == false then nil else hit end
	local found: string? = nil
	for _, cid in ctx.store:kids(pid) do
		local k = ctx.store:get(cid)
		if type(k) == "table" and k.t == "ms" and not k.done then
			found = cid
			break
		end
	end
	ctx.cache[key] = found or false
	return found
end

-- the row text: NEXT / done / future, with the infected split
function Milestone.text(n: any, kind: string, ctx: any): string
	local title = Common.plain(Common.str(n.ti) or "")
	local ds = Common.str(n.ds) or ""
	local parts: { string } = {}
	if kind == "next" then
		table.insert(parts, Common.caps("Next milestone", C.text))
		table.insert(parts, Common.title(title, "card", C.text))
	else
		table.insert(parts, Common.title(title, "cardSmall", if kind == "done" then C.ownedTitle else C.text))
	end
	local role = if kind == "next" then "body" else "small"
	if n.mal and string.find(ds, "<hr", 1, true) then
		local a, b = string.match(ds, "^(.-)<hr[^>]*>(.*)$")
		if a and b then
			local base = Common.html(a, role, ctx.layer)
			local mal = Common.html(b, role, ctx.layer)
			if base ~= "" then table.insert(parts, string.format('<font transparency="0.1">%s</font>', base)) end
			if mal ~= "" then table.insert(parts, string.format('<font color="%s">%s</font>', Common.hex(Theme.lift(C.danger, 0.3)), mal)) end
			return table.concat(parts, "\n")
		end
	end
	local body = Common.html(ds, role, ctx.layer)
	if body ~= "" then
		local t = if kind == "next" then 0.08 elseif kind == "done" then 0.15 else 0.1
		local color = if kind == "future" then C.soft else C.text
		table.insert(parts, string.format('<font color="%s" transparency="%.2f">%s</font>', Common.hex(color), t, body))
	end
	return table.concat(parts, "\n")
end

function Milestone.skin(rec: any, n: any, ctx: any): boolean
	local root = rec.root :: Frame
	local l = root:FindFirstChild("Label") :: TextLabel?
	local kids = root:FindFirstChild("Kids") :: Frame?
	if l == nil or kids == nil then return false end
	local label = l :: TextLabel
	local isNext = not n.done and Milestone.nextOf(ctx, Common.parentId(rec.id)) == rec.id
	local kind = if n.done then "done" elseif isNext then "next" else "future"
	local state = if n.done then "owned" else "notyet"
	root.Visible = true
	Common.drop(root, "Gradient")
	Common.drop(root, "Glow")
	root.Size = UDim2.new(1, 0, 0, 0)
	root.AutomaticSize = Enum.AutomaticSize.Y
	Common.drop(root, "Limit")
	if kind == "next" then
		Common.surface(root, "can", ctx.hue, 16)
		Common.glow(root, ctx.hue, 0.45, 18)
		Common.pad(root, 14, 18, 14, 18)
	else
		Common.drop(root, "Fill")
		root.BackgroundTransparency = 0
		root.BackgroundColor3 = if kind == "done" then Theme.mix(C.panel, C.bought, 0.14) else C.panel2
		Common.corner(root, 12)
		Common.pad(root, 10, 16, 10, 16)
		if n.mal then
			Common.stroke(root, 2, C.danger, 0.1)
		elseif kind == "done" then
			Common.stroke(root, 1, C.bought, 0.6)
		else
			Common.stroke(root, 1, C.stroke, 0.35)
		end
	end
	if kind == "next" and n.mal then Common.stroke(root, 2, C.danger, 0.1) end
	Common.list(root, false, 8)
	Common.text(label, if kind == "next" then "body" else "small", C.text)
	label.LayoutOrder = 0
	label.Size = UDim2.new(1, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.Visible = true
	Common.setText(label, Milestone.text(n, kind, ctx))
	-- children (the malware INFECT button): a row under the text, hidden when empty
	kids.LayoutOrder = 1
	local hasKids = #ctx.store:kids(rec.id) > 0
	kids.Visible = hasKids
	if hasKids then Common.list(kids, true, 8, { wraps = true }) end
	rec.text, rec.textT, rec.base = C.text, 0, Theme.size("small")
	Common.state(root, state)
	return true
end

return Milestone
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="146">
              <Properties>
                <string name="Name">Opt</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Opt: an Options row (DESIGN.md 6 Options, 6.1): the title (cardSmall) and the game's one-line subtitle (small, soft),
	the value as a chip at the right: ON / OFF for the two-state toggles (on), the cycler position for cyclers
	(idx / n), the shown value otherwise. One press per tap, the action as sent.
]]

local Core = script.Parent.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Common = require(script.Parent:WaitForChild("Common"))

local Opt = {}

local C = Theme.C

function Opt.skin(rec: any, n: any, ctx: any): boolean
	local b = rec.root :: TextButton
	local l = b:FindFirstChild("Label") :: TextLabel?
	if l == nil then return false end
	local label = l :: TextLabel
	local compact = ctx.mode == "COMPACT"
	b.Visible = true
	b.AutoButtonColor = false
	for _, name in { "Gradient", "Glow", "Num", "Limit" } do Common.drop(b, name) end
	Common.fill(b, C.panel3, C.panel2)
	Common.corner(b, 14)
	Common.stroke(b, 1.5, Theme.lift(ctx.hue, 0.2), 0.55)
	b.Size = UDim2.fromOffset(if compact then math.floor((ctx.contentW - 10) / 2) else 320, 0)
	b.AutomaticSize = Enum.AutomaticSize.Y
	local lim = Common.get(b, "Limit", "UISizeConstraint") :: UISizeConstraint
	lim.MinSize = Vector2.new(0, 64)
	lim.MaxSize = Vector2.new(math.huge, math.huge)
	Common.pad(b, 12, 16, 12, 16)
	Common.text(label, "small", C.soft)
	label.Visible = true
	label.ZIndex = 3
	label.Size = UDim2.new(1, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.TextWrapped = true
	-- the subtitle: the game's second line (after its first <br>), plain
	local h = Common.str(n.h) or ""
	local sub = string.match(h, "<br%s*/?>(.*)$")
	local subText = Common.plain(sub or "")
	subText = string.gsub(string.gsub(subText, "^%s+", ""), "%s+$", "")
	local title = Common.str(n.ti) or Common.plain(h)
	local chipText: string? = nil
	if n.on ~= nil then
		chipText = if n.on == true then "ON" else "OFF"
	elseif type(n.idx) == "number" and type(n.n) == "number" then
		chipText = tostring(n.val or "") .. "  " .. tostring(n.idx + 1) .. " / " .. tostring(n.n)
	elseif Common.str(n.val) then
		chipText = Common.str(n.val)
	end
	-- a subtitle that only repeats the value ("[ ALL ]") is dropped
	if chipText and string.find(subText, "^%[.*%]$") then subText = "" end
	local parts = { Common.title(title, "cardSmall", C.text) }
	if subText ~= "" then table.insert(parts, Common.esc(subText)) end
	Common.setText(label, table.concat(parts, "\n"))
	if chipText then
		local on = n.on == true
		local chip = Common.chip(label, "Chip", string.upper(chipText), {
			color = if n.on == nil then C.text elseif on then C.ownedValue else C.soft,
			bg = if on then Theme.mix(C.deep, C.bought, 0.3) else C.deep, bgT = 0, h = 26 })
		-- the text keeps clear of the chip (children sit in the padded box, so the chip steps back out of it)
		local clear = 110
		local pad = Common.get(label, "Clear", "UIPadding") :: UIPadding
		pad.PaddingRight = UDim.new(0, clear)
		chip.AnchorPoint = Vector2.new(1, 0)
		chip.Position = UDim2.new(1, clear, 0, 0)
		chip.ZIndex = 4
	else
		Common.drop(label, "Chip")
		Common.drop(label, "Clear")
	end
	Common.state(b, "can")
	return true
end

return Opt
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="147">
              <Properties>
                <string name="Name">Perk</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Perk: a perk slot (Figma 5:58, DESIGN.md 5.7): gold dashed "Explore a new perk" when it can be taken, mauve
	dashed when locked, the owned look once taken. The requirement (req) is shown as sent.
]]

local Core = script.Parent.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Recipes = require(Core:WaitForChild("Recipes"))
local Common = require(script.Parent:WaitForChild("Common"))

local Perk = {}

local C = Theme.C

function Perk.skin(rec: any, n: any, ctx: any): boolean
	local b = rec.root :: TextButton
	local l = b:FindFirstChild("Label") :: TextLabel?
	if l == nil then return false end
	local label = l :: TextLabel
	local state = if n.cls == "perked" or n.cls == "bought" then "owned" elseif n.cls == "perk" or n.cls == "can" then "can" else "locked"
	b.Visible = true
	b.AutoButtonColor = false
	for _, name in { "Gradient", "Glow", "Num", "Limit" } do Common.drop(b, name) end
	local p = Common.surface(b, if state == "can" then "gold" else state, ctx.hue, 14)
	local rim = b:FindFirstChild("Border")
	if rim and rim:IsA("UIStroke") and state ~= "owned" then
		Recipes.dashed(rim, { color = if state == "can" then C.gold else C.locked })
	elseif rim then
		Common.drop(rim, "Dash")
	end
	b.Size = UDim2.fromOffset(ctx.cardW, 0)
	b.AutomaticSize = Enum.AutomaticSize.Y
	Common.pad(b, 14, 16, 14, 16)
	Common.text(label, "small", p.text)
	label.Visible = true
	label.ZIndex = 3
	label.Size = UDim2.new(1, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.TextWrapped = true
	local parts: { string } = {}
	if state == "can" then table.insert(parts, Common.title("Explore a new perk", "card", C.text)) end
	local body = Common.html(n.h, "small", ctx.layer)
	if body ~= "" then table.insert(parts, body) end
	local req = Common.str(n.req)
	if req and state == "locked" then table.insert(parts, Common.caps("Requires", p.soft) .. "  " .. Common.html(req, "small", ctx.layer)) end
	Common.setText(label, table.concat(parts, "\n"))
	Common.state(b, state)
	return true
end

return Perk
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="148">
              <Properties>
                <string name="Name">Skins</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Skins: the dispatcher Render's skin hook calls for every node of the panel's tab tree (plan 2.5).

	    Skins.apply(rec, n, ctx) -> boolean   true when a skin drew the node (Render then skips the old page look)

	Order: the layer's signature skin first (true = handled), then the card skins by kind, then Generic. Every skin is
	idempotent and writes the State attribute on cards (can / owned / notyet / locked).
]]

local Generic = require(script.Parent:WaitForChild("Generic"))
local Upgrade = require(script.Parent:WaitForChild("Upgrade"))
local Buyable = require(script.Parent:WaitForChild("Buyable"))
local Milestone = require(script.Parent:WaitForChild("Milestone"))
local Challenge = require(script.Parent:WaitForChild("Challenge"))
local Achievement = require(script.Parent:WaitForChild("Achievement"))
local GridTile = require(script.Parent:WaitForChild("GridTile"))
local Clickable = require(script.Parent:WaitForChild("Clickable"))
local Perk = require(script.Parent:WaitForChild("Perk"))
local Opt = require(script.Parent:WaitForChild("Opt"))

local Skins = {}

local BY_KIND: { [string]: (rec: any, n: any, ctx: any) -> boolean } = {
	["btn:upg"] = Upgrade.skin,
	["btn:buy"] = Buyable.skin,
	["btn:grid"] = GridTile.skin,
	["btn:click"] = Clickable.skin,
	["btn:perk"] = Perk.skin,
	["btn:opt"] = Opt.skin,
	["btn:chalbtn"] = Challenge.button,
	ms = Milestone.skin,
	chal = Challenge.skin,
	ach = Achievement.skin,
}

function Skins.apply(rec: any, n: any, ctx: any): boolean
	if ctx == nil then return false end
	local sig = ctx.signature
	if sig and sig.skin then
		local ok, handled = pcall(sig.skin, rec, n, ctx)
		if ok and handled then return true end
		if not ok then warn("[MilestoneTree] signature skin failed on " .. tostring(rec.id) .. ": " .. tostring(handled)) end
	end
	local f = BY_KIND[rec.kind]
	if f and f(rec, n, ctx) then return true end
	return Generic.skin(rec, n, ctx)
end

return Skins
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="149">
              <Properties>
                <string name="Name">Upgrade</string>
                <string name="Source"><![CDATA[--!strict
--[[
	Upgrade: the upgrade card (Figma 5:47, DESIGN.md 5.7) and the default tier board (5.7 "Tier board").

	    can     hue surface, glow, BUY chip, "Currently" value in a well, COST in white
	    owned   quiet green surface, OWNED chip, the effect value (or "Active") in the owned green; no glow
	    notyet  mauve surface, the pr % chip and a 5 du bar, COST in the not-yet rose
	    locked  dim mauve, LOCKED chip (never sent for upgrades today; kept for signatures)
	BUY ALL (Upgrade.buyAll): a button in the UPGRADES title row, from when the layer after this one is reached.
	A fully owned tier (every card of a game row bought) uses the compact owned cards (Skins/CompactOwned) and its
	rail turns green. The tier rail (WIDE / MEDIUM) is a badge with the row number on a glowing spine.
	COMPACT folds every owned upgrade into one summary row ("N OWNED · Show") at the top of the section.

	One TextLabel carries the index, title, description and the "Currently" caps (RichText runs, DESIGN.md 9.2), so a
	card stays near 12 instances. Card titles are Title Case as the game sends them; italic only up to 4 words.
]]

local Core = script.Parent.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Rich = require(Core:WaitForChild("Rich"))
local Sleek = require(Core:WaitForChild("Sleek"))
local Skin = require(Core:WaitForChild("Skin"))
local Common = require(script.Parent:WaitForChild("Common"))
local CompactOwned = require(script.Parent:WaitForChild("CompactOwned"))
local Signatures = require(script.Parent.Parent.Parent:WaitForChild("Signatures"):WaitForChild("Signatures"))
local Kit = require(script.Parent.Parent.Parent:WaitForChild("Signatures"):WaitForChild("Kit"))

local Upgrade = {}

local C = Theme.C

-- the COMPACT owned fold, per layer / component, for the session (DESIGN.md 5.7)
local showOwned: { [string]: boolean } = {}

function Upgrade.stateOf(n: any): string
	if n.cls == "bought" then return "owned" end
	if n.cls == "can" then return "can" end
	if n.cls == "plocked" then return "locked" end
	return "notyet"
end

-- every upgrade of the card's game row is bought (a row id's children in the store)
local function tierOwned(store: any, rowId: string?, cache: { [string]: any }): boolean
	if rowId == nil then return false end
	local key = "own:" .. rowId
	local hit = cache[key]
	if hit ~= nil then return hit end
	local kids = store:kids(rowId)
	local any, all = false, true
	for _, cid in kids do
		local k = store:get(cid)
		if type(k) == "table" and k.t == "btn" and k.k == "upg" then
			any = true
			if k.cls ~= "bought" then all = false end
		end
	end
	local r = any and all
	cache[key] = r
	return r
end
Upgrade.tierOwned = tierOwned

local function inUpgradesRow(ctx: any, id: string): string?
	local pid = Common.parentId(id)
	if pid == nil then return nil end
	local gid = Common.parentId(pid)
	local g = if gid then ctx.store:get(gid) else nil
	if type(g) == "table" and g.cn == "upgrades" then return pid end
	return nil
end
-- the upgrades component id above a card (row -> component), nil when the card is not in one
local function componentOf(ctx: any, id: string): string?
	local pid = Common.parentId(id)
	if pid == nil then return nil end
	local p = ctx.store:get(pid)
	if type(p) == "table" and p.cn == "upgrades" then return pid end
	local gid = Common.parentId(pid)
	local g = if gid then ctx.store:get(gid) else nil
	if type(g) == "table" and g.cn == "upgrades" then return gid end
	return nil
end

function Upgrade.skin(rec: any, n: any, ctx: any): boolean
	local b = rec.root :: TextButton
	local l = b:FindFirstChild("Label") :: TextLabel?
	if l == nil then return false end
	local label = l :: TextLabel
	local state = Upgrade.stateOf(n)
	local compact = ctx.mode == "COMPACT"
	local rowId = inUpgradesRow(ctx, rec.id)
	-- COMPACT: owned upgrades fold into the section's summary row unless it is open
	if compact and state == "owned" then
		local comp = componentOf(ctx, rec.id)
		if comp and not showOwned[ctx.layer .. ":" .. comp] then
			b.Visible = false
			Common.state(b, state)
			return true
		end
	end
	if state == "owned" and (compact or (rowId ~= nil and tierOwned(ctx.store, rowId, ctx.cache))) then
		return CompactOwned.skin(rec, n, ctx)
	end
	b.Visible = true
	b.AutoButtonColor = false
	Common.drop(b, "Num")
	Common.drop(b, "Gradient")
	Common.drop(b, "Glow")
	Common.drop(b, "MotionFlash") -- never a list item in the card (Motion.flash)
	local p = Common.surface(b, state, ctx.hue)
	Common.glow(b, if state == "can" then ctx.hue else nil, 0.2, 14)

	b.Size = UDim2.fromOffset(ctx.cardW, 0)
	b.AutomaticSize = Enum.AutomaticSize.Y
	Common.drop(b, "Limit") -- a tier row stretches its cards to the tallest one
	Common.pad(b, if compact then 12 else 14, if compact then 12 else 16, if compact then 12 else 14, if compact then 12 else 16)
	Common.list(b, false, if compact then 6 else 8, { name = "CardList" })

	-- the text block: index, title, description, "Currently"
	Common.text(label, "body", p.text, 0)
	label.LayoutOrder = 1
	label.ZIndex = 3
	label.Size = UDim2.new(1, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.Visible = true
	local idx = Common.str(n.n) or Common.str(n.id) or ""
	local idxColor = if state == "owned" then Sleek.C.good elseif state == "can" then ctx.hue else Sleek.C.micro
	local parts: { string } = {}
	table.insert(parts, Common.run(Common.esc(idx), "index", idxColor, if state == "owned" then 0.2 else 0))
	local title = Common.str(n.ti)
	if title then table.insert(parts, Common.title(Common.plain(title), "card", p.title)) end
	local ds = Common.html(n.ds, "body", ctx.layer)
	if ds ~= "" then
		table.insert(parts, string.format('<font transparency="%.2f">%s</font>', p.textT, ds))
	end
	local ef = Common.str(n.ef)
	if ef and state ~= "owned" then table.insert(parts, Common.caps("Currently", p.soft)) end
	Common.setText(label, table.concat(parts, "\n"))
	-- Sleek: the BUY card gets a lit top edge and its two top corner ticks. The card lays its children out in a list,
	-- so the marks hang off the first item (the label) with the card's padding as offsets; the bottom pair hangs off
	-- the BUY bar below. The other states stay quiet (instance budget).
	local padT, padX = if compact then 12 else 14, if compact then 12 else 16
	if state == "can" then
		local top = Common.get(label, "TopLine", "Frame") :: Frame
		top.Position = UDim2.fromOffset(-padX, -padT)
		top.Size = UDim2.new(1, 2 * padX, 0, 2)
		top.BackgroundColor3 = ctx.hue
		top.BackgroundTransparency = 0
		top.ZIndex = 5
		local tick = Theme.lift(ctx.hue, 0.55)
		for i, spec in { { 0, -padX }, { 1, padX } } do
			local ax, dx = spec[1], spec[2]
			local v = Common.get(label, "TickV" .. i, "Frame") :: Frame
			v.AnchorPoint = Vector2.new(ax, 0)
			v.Position = UDim2.new(ax, dx, 0, -padT)
			v.Size = UDim2.fromOffset(2, 9)
			v.BackgroundColor3 = tick
			v.BackgroundTransparency = 0
			v.ZIndex = 5
		end
	else
		for _, n in { "TopLine", "TickV1", "TickV2" } do Common.drop(label, n) end
	end

	-- the chip at the top right: BUY / OWNED / pr % / LOCKED
	local pr = Common.pr(n.pr)
	-- the tag: an outlined caps word (BUY in the hue, pr % in rose), or a bare ✓ OWNED / LOCKED
	local chipText, chipColor, chipLine = Rich.caps("Buy"), Theme.lift(ctx.hue, 0.55), ctx.hue :: Color3?
	if state == "owned" then
		chipText, chipColor, chipLine = "✓ " .. Rich.caps("Owned"), Sleek.C.good, nil
	elseif state == "notyet" then
		chipText, chipColor, chipLine = if pr then Rich.pct(pr) else Rich.caps("Not yet"), C.notYet, C.locked
	elseif state == "locked" then
		chipText, chipColor, chipLine = Rich.caps("Locked"), Sleek.C.lockText, nil
	end
	local chip = Common.chip(label, "Chip", chipText, { color = chipColor, bgT = 1, h = if compact then 22 else 24, stroke = chipLine,
		role = if state == "notyet" and pr then "badge" else "caps" })
	chip.FontFace = Font.fromName("Montserrat", Enum.FontWeight.ExtraBold)
	local cb = chip:FindFirstChild("Border") :: UIStroke?
	if cb then cb.Transparency = 0.3 end
	chip.AnchorPoint = Vector2.new(1, 0)
	chip.Position = UDim2.new(1, 0, 0, 0)
	chip.ZIndex = 4

	-- "Currently": the value in a well (can / not yet), or the owned effect line
	if ef then
		local eff = Common.get(b, "Eff", "TextLabel") :: TextLabel
		eff.LayoutOrder = 2
		eff.ZIndex = 3
		eff.TextWrapped = false
		eff.TextXAlignment = Enum.TextXAlignment.Center
		eff.TextYAlignment = Enum.TextYAlignment.Center
		eff.AutomaticSize = Enum.AutomaticSize.X
		eff.Active = false
		if state == "owned" then
			Common.text(eff, "numberHeavy", C.ownedValue)
			eff.BackgroundTransparency = 1
			eff.Size = UDim2.fromOffset(0, 24)
			Common.drop(eff, "Corner")
			Common.drop(eff, "Border") -- the BUY card's value well, when it was bought on screen
			Common.setText(eff, Common.num(ef, "numberHeavy", C.ownedValue))
		else
			Common.text(eff, "number", C.text)
			eff.BackgroundColor3 = C.black
			eff.BackgroundTransparency = 0.62
			eff.Size = UDim2.fromOffset(0, 30)
			Common.drop(eff, "Corner")
			Common.stroke(eff, 1, C.white, 0.92).LineJoinMode = Enum.LineJoinMode.Miter
			Common.setText(eff, "  " .. Common.num(ef, "number", C.text) .. "  ")
		end
	elseif state == "owned" then
		local eff = Common.get(b, "Eff", "TextLabel") :: TextLabel
		eff.LayoutOrder = 2
		Common.text(eff, "label", C.ownedValue)
		eff.BackgroundTransparency = 1
		eff.AutomaticSize = Enum.AutomaticSize.X
		eff.Size = UDim2.fromOffset(0, 22)
		eff.TextXAlignment = Enum.TextXAlignment.Left
		Common.drop(eff, "Corner")
		Common.drop(eff, "Border")
		Common.setText(eff, "✓  Active")
	else
		Common.drop(b, "Eff")
	end

	-- the pr bar (not yet) and the cost line
	if state == "notyet" and pr then
		local bar = Common.bar(b, "Bar", pr, C.notYet, 2)
		bar.LayoutOrder = 3
	else
		Common.drop(b, "Bar")
	end
	local co = Common.str(n.co)
	if co and state ~= "owned" and state ~= "locked" then
		local foot = Common.get(b, "Foot", "TextLabel") :: TextLabel
		foot.LayoutOrder = 4
		Common.text(foot, "caps", p.soft)
		foot.AutomaticSize = Enum.AutomaticSize.None
		foot.TextYAlignment = Enum.TextYAlignment.Center
		foot.TextWrapped = false
		foot.TextTruncate = Enum.TextTruncate.AtEnd
		if state == "can" then
			local ink = Sleek.C.ink
			foot.Size = UDim2.new(1, 0, 0, if compact then 36 else 42)
			foot.TextXAlignment = Enum.TextXAlignment.Right
			foot.BackgroundColor3 = C.white
			foot.BackgroundTransparency = 0
			local g = Common.get(foot, "Fill", "UIGradient") :: UIGradient
			g.Rotation = 90
			g.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Theme.lift(ctx.hue, 0.25)), ColorSequenceKeypoint.new(1, ctx.hue) })
			Common.drop(foot, "Pad")
			local verb = Common.get(foot, "Verb", "TextLabel") :: TextLabel
			Common.text(verb, "cta", ink)
			verb.TextSize = 16
			verb.Position = UDim2.fromOffset(12, 0)
			verb.Size = UDim2.new(1, -12, 1, 0)
			verb.TextXAlignment = Enum.TextXAlignment.Left
			verb.TextYAlignment = Enum.TextYAlignment.Center
			Common.setText(verb, "BUY")
			verb.ZIndex = foot.ZIndex + 1
			local cost = Common.get(foot, "Cost", "TextLabel") :: TextLabel
			Common.text(cost, "numberHeavy", ink)
			cost.RichText = true
			cost.Position = UDim2.new()
			cost.Size = UDim2.new(1, -12, 1, 0)
			cost.TextXAlignment = Enum.TextXAlignment.Right
			cost.TextYAlignment = Enum.TextYAlignment.Center
			cost.ZIndex = foot.ZIndex + 1
			Common.setText(cost, Common.num(co, "numberHeavy", ink, Signatures.unit(n.cur), true))
			Common.setText(foot, "")
			if Skin.apply(foot, "cta", { tint = Theme.lift(ctx.hue, 0.15), scale = if compact then 0.4 else 0.45 }) then
				Common.drop(foot, "Fill") -- the skin is the surface (instance budget)
			end
		else
			foot.Size = UDim2.new(1, 0, 0, 24)
			foot.TextXAlignment = Enum.TextXAlignment.Left
			foot.BackgroundTransparency = 1
			Common.drop(foot, "Fill")
			Common.drop(foot, "Pad")
			Common.drop(foot, "Verb")
			Common.drop(foot, "Cost")
			Skin.clear(foot)

			Common.setText(foot, Common.caps("Cost", p.soft) .. "   " .. Common.num(co, "numberHeavy", C.notYet, Signatures.unit(n.cur)))
		end
	else
		Common.drop(b, "Foot")
	end
	Common.state(b, state)
	Common.transition(ctx, n.a, state, b)
	return true
end

-- ------------------------------------------------------------------------------------------------------ tier board
-- a game row inside the upgrades component: the rail at the left (WIDE / MEDIUM), green when the tier is owned
function Upgrade.tier(rec: any, n: any, ctx: any)
	local root = rec.root :: Frame
	if ctx.mode == "COMPACT" then
		Common.drop(root, "Rail")
		return
	end
	local owned = tierOwned(ctx.store, rec.id, ctx.cache)
	local tierNo = string.match(rec.id, "%.(%d+)$") or "?"
	local col = if owned then C.bought else ctx.hue
	local rail = Common.get(root, "Rail", "Frame") :: Frame
	rail.LayoutOrder = 0
	rail.Size = UDim2.fromOffset(44, 0)
	rail.Active = false
	local spine = Common.get(rail, "Spine", "Frame") :: Frame
	spine.AnchorPoint = Vector2.new(0.5, 0)
	spine.Position = UDim2.fromScale(0.5, 0)
	spine.Size = UDim2.new(0, 1, 1, 12)
	spine.BackgroundColor3 = col
	spine.BackgroundTransparency = 0.6
	local badge = Common.get(rail, "Badge", "TextLabel") :: TextLabel
	badge.AnchorPoint = Vector2.new(0.5, 0)
	badge.Position = UDim2.new(0.5, 0, 0, 14)
	badge.Size = UDim2.fromOffset(30, 30)
	badge.BackgroundColor3 = col
	badge.BackgroundTransparency = 0.86
	Common.text(badge, "badge", C.text)
	badge.TextSize = math.max(badge.TextSize, 16)
	badge.TextXAlignment = Enum.TextXAlignment.Center
	badge.TextYAlignment = Enum.TextYAlignment.Center
	badge.ZIndex = 2
	Common.drop(badge, "Corner")
	Common.stroke(badge, 1, col, 0.25).LineJoinMode = Enum.LineJoinMode.Miter
	Common.setText(badge, tierNo)
	if owned then
		local check = Common.get(rail, "Check", "Frame") :: Frame
		check.AnchorPoint = Vector2.new(0.5, 0)
		check.Position = UDim2.new(0.5, 0, 0, 54)
		check.Size = UDim2.fromOffset(7, 7)
		check.Rotation = 45
		check.BackgroundColor3 = C.bought
		check.BackgroundTransparency = 0
		check.ZIndex = 2
		Common.drop(check, "Corner")
	else
		Common.drop(rail, "Check")
	end
end

-- ------------------------------------------------------------------------------------------------------ Buy All
-- the BUY ALL button at the right of the UPGRADES title row, once the layer after this one is reached (the view sends
-- the action as n.ba and how many upgrades are affordable one by one as n.bn). Every mode; dim while none is.
function Upgrade.buyAll(rec: any, n: any, ctx: any)
	local header = rec.root:FindFirstChild("SectionTitle")
	if n.cn ~= "upgrades" or type(n.ba) ~= "table" or header == nil or not header:IsA("Frame") then
		if header then Common.drop(header, "BuyAll") end
		return
	end
	local compact = ctx.mode == "COMPACT"
	local count = if type(n.bn) == "number" then n.bn else 0
	local on = count > 0
	-- the rule flexes to leave the buttons room at the right (Signatures/P does the same for Hide owned)
	local flex = false
	local rule = header:FindFirstChild("Rule")
	if rule then
		flex = pcall(function()
			local f = Common.get(rule, "Flex", "UIFlexItem") :: any
			f.FlexMode = Enum.UIFlexMode.Fill
		end)
	end
	local b = Common.get(header, "BuyAll", "TextButton") :: TextButton
	b.LayoutOrder = if flex then 21 else 6
	b.AutoButtonColor = false
	b.Text = ""
	b.Size = UDim2.fromOffset(0, if compact then 22 else 24)
	b.AutomaticSize = Enum.AutomaticSize.X
	b.BackgroundColor3 = ctx.hue
	b.BackgroundTransparency = if on then 0.25 else 0.88
	Common.drop(b, "Corner")
	Common.stroke(b, 1, if on then Theme.lift(ctx.hue, 0.5) else C.muted, if on then 0.2 else 0.6).LineJoinMode =
		Enum.LineJoinMode.Miter
	Common.pad(b, 0, 10, 0, 10)
	local l = Common.get(b, "Caption", "TextLabel") :: TextLabel
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(0, 1)
	l.AutomaticSize = Enum.AutomaticSize.X
	l.Active = false
	Common.text(l, "caps", if on then Sleek.C.ink else C.muted, 0)
	l.RichText = true
	l.TextXAlignment = Enum.TextXAlignment.Center
	l.TextYAlignment = Enum.TextYAlignment.Center
	l.TextWrapped = false
	l.FontFace = Font.fromName("Montserrat", Enum.FontWeight.ExtraBold)
	Common.setText(l, Rich.caps("Buy all")) -- lit or dim; no count (a press may buy fewer: costs share a balance)
	b:SetAttribute("State", if on then "can" else "notyet")
	b:SetAttribute("Count", count)
	local a = n.ba
	Kit.onPress(b, function()
		if (b:GetAttribute("Count") or 0) > 0 then ctx.act(a, false) end
	end)
end

-- ------------------------------------------------------------------------------------------------------ COMPACT fold
-- the summary row at the top of an upgrades section on phones: "N OWNED" + Show / Hide (one press)
function Upgrade.summary(rec: any, n: any, ctx: any)
	local root = rec.root :: Frame
	if ctx.mode ~= "COMPACT" or n.cn ~= "upgrades" then
		Common.drop(root, "OwnedRow")
		return
	end
	local owned = 0
	local function walk(id: string, d: number)
		if d > 3 then return end
		local x = ctx.store:get(id)
		if type(x) ~= "table" then return end
		if x.t == "btn" and x.k == "upg" and x.cls == "bought" then owned += 1 end
		if type(x.c) == "table" then
			for _, cid in x.c do
				if type(cid) == "string" then walk(cid, d + 1) end
			end
		end
	end
	walk(rec.id, 0)
	if owned == 0 then
		Common.drop(root, "OwnedRow")
		return
	end
	local key = ctx.layer .. ":" .. rec.id
	local open = showOwned[key] == true
	local row = Common.get(root, "OwnedRow", "TextButton") :: TextButton
	row.LayoutOrder = 0
	row.AutoButtonColor = false
	row.Text = ""
	row.Size = UDim2.new(1, 0, 0, 48)
	Common.surface(row, "owned", C.bought)
	Common.pad(row, 0, 14, 0, 14)
	local t = Common.label(row, "Text", "cardSmall", C.ownedTitle, { wrap = false })
	t.Size = UDim2.fromScale(1, 1)
	t.AutomaticSize = Enum.AutomaticSize.None
	t.TextYAlignment = Enum.TextYAlignment.Center
	Common.setText(t, Common.title(owned .. " owned", "cardSmall", C.ownedTitle))
	local s = Common.label(row, "Show", "label", C.ownedValue, { wrap = false, align = Enum.TextXAlignment.Right })
	s.Size = UDim2.fromScale(1, 1)
	s.AutomaticSize = Enum.AutomaticSize.None
	s.TextYAlignment = Enum.TextYAlignment.Center
	Common.setText(s, if open then "Hide" else "Show")
	row:SetAttribute("Key", key)
	if row:GetAttribute("Wired") ~= true then
		row:SetAttribute("Wired", true)
		local render = ctx.render
		row.Activated:Connect(function()
			local k = row:GetAttribute("Key")
			if type(k) ~= "string" then return end
			showOwned[k] = not showOwned[k]
			if render then render:refresh() end
		end)
	end
end

return Upgrade
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="150">
            <Properties>
              <string name="Name">Virtual</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Virtual: a fixed-row pool for long lists (DESIGN.md 5.8, plan 2.5). The host Frame (a claim's placeholder inside
	the panel's scrolling body) is sized to the whole list; only ceil(viewport / pitch) + 2 row frames exist, moved and
	redrawn as the body scrolls.

	    local v = Virtual.new({ scroll = sf, host = ph, top = 48, rowH = 64, gap = 8, count = n, draw = fn(row, i) })
	    v:setCount(n); v:redraw(); v:destroy()

	Virtual.milestones(ph, id, store, ctx) is the default claim for a milestone ladder longer than Virtual.MS_ROWS:
	a section header, then one row per milestone (NEXT in the hue, done in quiet green, future faint), with the row's
	INFECT button when the game sends one (the button fires the malware node's own action).
]]

local Core = script.Parent.Parent:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Rich = require(Core:WaitForChild("Rich"))
local Common = require(script.Parent:WaitForChild("Skins"):WaitForChild("Common"))
local Milestone = require(script.Parent:WaitForChild("Skins"):WaitForChild("Milestone"))
local Sections = require(script.Parent:WaitForChild("Sections"))

local Virtual = {}
Virtual.__index = Virtual

-- ladders longer than this are virtualised by default (keeps a panel within its instance budget)
Virtual.MS_ROWS = 24

local C = Theme.C

export type Options = {
	scroll: ScrollingFrame,
	host: Frame,
	top: number, -- du above the first row (a header)
	rowH: number,
	gap: number,
	count: number,
	draw: (row: Frame, i: number) -> (),
}

export type Virtual = typeof(setmetatable({} :: {
	o: Options,
	rows: { Frame },
	first: number,
	conns: { RBXScriptConnection },
	alive: boolean,
}, Virtual))

function Virtual.new(o: Options): Virtual
	local self = setmetatable({ o = o, rows = {}, first = -1, conns = {}, alive = true }, Virtual)
	o.host.AutomaticSize = Enum.AutomaticSize.None
	o.host.ClipsDescendants = false
	table.insert(self.conns, o.scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function() self:place(false) end))
	table.insert(self.conns, o.scroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() self:place(true) end))
	self:setCount(o.count)
	return self
end

function Virtual.pitch(self: Virtual): number
	return self.o.rowH + self.o.gap
end

function Virtual.setCount(self: Virtual, n: number)
	self.o.count = n
	local o = self.o
	o.host.Size = UDim2.new(1, 0, 0, o.top + math.max(0, n * self:pitch() - o.gap))
	self:place(true)
end

-- how many rows fit the viewport, plus two
function Virtual.poolSize(self: Virtual): number
	local s = math.max(Layout.s, 0.01)
	local vh = self.o.scroll.AbsoluteSize.Y / s
	if vh < 1 then vh = 900 end
	return math.ceil(vh / self:pitch()) + 2
end

function Virtual.place(self: Virtual, force: boolean)
	if not self.alive then return end
	local o = self.o
	local s = math.max(Layout.s, 0.01)
	-- where the host's first row is, relative to the visible top of the scroll (du)
	local dy = (o.host.AbsolutePosition.Y - o.scroll.AbsolutePosition.Y) / s + o.top
	local first = math.max(0, math.floor(-dy / self:pitch()))
	local pool = math.min(self:poolSize(), math.max(0, o.count))
	-- grow / shrink the pool
	while #self.rows < pool do
		local row = Instance.new("Frame")
		row.Name = "Row" .. (#self.rows + 1)
		row.BackgroundTransparency = 1
		row.BorderSizePixel = 0
		row.Size = UDim2.new(1, 0, 0, o.rowH)
		row.Parent = o.host
		table.insert(self.rows, row)
		force = true
	end
	while #self.rows > pool do
		local row = table.remove(self.rows) :: Frame
		row:Destroy()
		force = true
	end
	if first == self.first and not force then return end
	self.first = first
	for k, row in self.rows do
		local i = first + k
		if i <= o.count then
			row.Visible = true
			row.Size = UDim2.new(1, 0, 0, o.rowH)
			row.Position = UDim2.fromOffset(0, o.top + (i - 1) * self:pitch())
			local ok, err = Common.try(o.draw, row, i)
			if not ok then warn("[MilestoneTree] virtual row failed: " .. tostring(err)) end
		else
			row.Visible = false
		end
	end
end

function Virtual.redraw(self: Virtual)
	self:place(true)
end

function Virtual.destroy(self: Virtual)
	self.alive = false
	for _, c in self.conns do c:Disconnect() end
	for _, r in self.rows do r:Destroy() end
	table.clear(self.rows)
end

-- ------------------------------------------------------------------------------------------------------ milestones
local function drawRow(row: Frame, n: any, kind: string, ctx: any, mal: any?)
	local bg = if kind == "next" then Theme.mix(C.panel, ctx.hue, 0.38) elseif kind == "done" then Theme.mix(C.panel, C.bought, 0.14) else C.panel2
	row.BackgroundColor3 = bg
	row.BackgroundTransparency = 0
	Common.corner(row, 12)
	Common.stroke(row, if kind == "next" or n.mal then 2 else 1, if n.mal then C.danger elseif kind == "next" then Theme.lift(ctx.hue, 0.35)
		elseif kind == "done" then C.bought else C.stroke, if kind == "done" then 0.6 elseif kind == "future" then 0.35 else 0)
	local t = Common.get(row, "Text", "TextLabel") :: TextLabel
	Common.text(t, "small", C.text)
	t.Position = UDim2.fromOffset(16, 8)
	t.Size = UDim2.new(1, if mal then -200 else -32, 1, -16)
	t.AutomaticSize = Enum.AutomaticSize.None
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextYAlignment = Enum.TextYAlignment.Center
	t.TextWrapped = true
	t.TextTruncate = Enum.TextTruncate.AtEnd
	local title = Common.plain(Common.str(n.ti) or "")
	local titleRun = Common.title(title, "cardSmall", if kind == "done" then C.ownedTitle else C.text)
	if kind == "next" then titleRun = Common.caps("Next", C.text) .. "  " .. titleRun end
	local ds = Common.html(n.ds, "small", ctx.layer)
	local text = titleRun
	if ds ~= "" then
		text ..= "\n" .. string.format('<font color="%s" transparency="0.1">%s</font>', Common.hex(if kind == "future" then C.soft else C.text), ds)
	end
	Common.setText(t, text)
	-- the INFECT button of the malware ladder (the malware node's own action, read at press time)
	if mal then
		local b = Common.get(row, "Infect", "TextButton") :: TextButton
		b.AutoButtonColor = false
		b.Text = ""
		b.AnchorPoint = Vector2.new(1, 0.5)
		b.Position = UDim2.new(1, -12, 0.5, 0)
		b.Size = UDim2.fromOffset(170, 44)
		local infected = mal.cls == "pseudo"
		local can = mal.cls == "can" or mal.cls == "perk"
		b.BackgroundColor3 = if infected then Theme.mix(C.panel, C.danger, 0.35) elseif can then C.danger else Theme.mix(C.panel, C.locked, 0.3)
		b.BackgroundTransparency = 0
		Common.corner(b, 10)
		local bl = Common.get(b, "Label", "TextLabel") :: TextLabel
		Common.text(bl, "label", C.text)
		bl.Size = UDim2.fromScale(1, 1)
		bl.TextXAlignment = Enum.TextXAlignment.Center
		bl.TextYAlignment = Enum.TextYAlignment.Center
		bl.TextWrapped = false
		local co = Common.str(mal.co)
		local label = if infected then "INFECTED" else "INFECT"
		Common.setText(bl, Common.esc(label) .. (if co and not infected then "  " .. Common.num(Rich.short(co), "number", C.text) else ""))
		b:SetAttribute("State", if infected then "owned" elseif can then "can" else "notyet")
		b:SetAttribute("Ms", n.id)
	else
		Common.drop(row, "Infect")
	end
end

function Virtual.milestones(ph: Frame, id: string, store: any, ctx: any): any
	local compact = Layout.mode == "COMPACT"
	local header = 52
	local ids: { string } = {}
	local rowsById: { [Frame]: string } = {}
	local function collect(st: any)
		table.clear(ids)
		for _, cid in st:kids(id) do
			local k = st:get(cid)
			if type(k) == "table" and k.t == "ms" then table.insert(ids, cid) end
		end
	end
	collect(store)
	local current = store
	local v: Virtual
	v = Virtual.new({
		scroll = ctx.scroll,
		host = ph,
		top = header,
		rowH = if compact then 60 else 64,
		gap = 8,
		count = #ids,
		draw = function(row: Frame, i: number)
			local cid = ids[i]
			local n = if cid then current:get(cid) else nil
			if type(n) ~= "table" then
				row.Visible = false
				return
			end
			local nextId = Milestone.nextOf({ cache = {}, store = current }, id)
			local kind = if n.done then "done" elseif cid == nextId then "next" else "future"
			local malId = current:kids(cid)[1]
			local mal = if malId then current:get(malId) else nil
			if type(mal) ~= "table" or mal.k ~= "malware" then mal = nil end
			drawRow(row, n, kind, ctx, mal)
			rowsById[row] = cid
			local b = row:FindFirstChild("Infect")
			if b and b:IsA("TextButton") and b:GetAttribute("Wired") ~= true then
				b:SetAttribute("Wired", true)
				b.Activated:Connect(function()
					local msId = rowsById[row]
					local mid = if msId then current:kids(msId)[1] else nil
					local m = if mid then current:get(mid) else nil
					if type(m) == "table" and type(m.a) == "table" then ctx.act(m.a, false) end
				end)
			end
		end,
	})
	local function head(st: any)
		local done = 0
		for _, cid in ids do
			local k = st:get(cid)
			if type(k) == "table" and k.done then done += 1 end
		end
		Sections.header(ph, { name = "Head", text = Sections.titleOf("milestones", ctx.layer) or "MILESTONES", hue = ctx.hue,
			chips = { { text = done .. " / " .. #ids .. " DONE", color = C.ownedValue, bg = Theme.mix(C.deep, C.bought, 0.16), bgT = 0 } } })
		local h = ph:FindFirstChild("Head") :: Frame?
		if h then h.Position = UDim2.new() end
	end
	head(store)
	local claim = {}
	function claim.update(_: any, st: any)
		current = st or current
		collect(current)
		head(current)
		v:setCount(#ids)
	end
	function claim.destroy(_: any)
		v:destroy()
		Common.drop(ph, "Head")
	end
	return claim
end

return Virtual
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="151">
          <Properties>
            <string name="Name">Render</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Render: view nodes (see the server's Session and rbx/view.js) -> GUI objects, kept in step with patches.

	Every node has an id that is its path ("tab.3.1"), so its parent and its place among its siblings come from the
	id: a patch only has to carry the nodes that changed. A node whose kind is unchanged is updated in place;
	otherwise it is rebuilt and its children move over to the new object (and are re-inherited and re-drawn).

	The panel (plan 2.5) adds optional hooks; the old page passes none and looks as it always did:
	    hooks.ctx()                  -> the skin context, asked once per apply
	    hooks.skin(rec, n, ctx)      -> true when the skin drew the node (the old look is then skipped); runs on every
	                                    update, so skins are idempotent
	    hooks.claim(id, n, ctx)      -> a maker (ph) -> Claim, asked when a record is built. A claimed id gets a plain
	                                    placeholder Frame and no subtree; every later set / del at or under it only marks
	                                    the claim dirty, and after the apply each dirty claim gets update(store)
	    hooks.store                  the ViewStore handed to claims
	    hooks.detail(rec)            a touch long-press on a button (the detail sheet); its Activated is then skipped
	Buttons keep their wiring: the current node's `a` is read at press time, and hold buttons repeat 20 times a second
	after 0.25 s, but only while the pointer stays within 10 px and the list does not scroll (DESIGN.md 3.4). A touch
	that moved or scrolled never presses. A press clicks (Core/Audio; a locked button answers with the soft error, hold
	repeats are silent) and the pointer entering an actionable card plays the hover tick.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local shared = ReplicatedStorage:WaitForChild("MilestoneTree")
local Html = require(shared:WaitForChild("Html"))
local ZoneMaps = require(shared:WaitForChild("ZoneMaps"))
local Style = require(script.Parent:WaitForChild("Style"))
local Audio = require(script.Parent:WaitForChild("Core"):WaitForChild("Audio"))

export type Claim = {
	update: (self: Claim, store: any) -> (),
	destroy: (self: Claim) -> (),
}
export type Hooks = {
	press: (action: any, hold: boolean) -> (),
	tip: (html: string?, over: GuiObject?) -> (),
	ctx: (() -> any)?,
	skin: ((rec: any, n: any, ctx: any) -> boolean)?,
	claim: ((id: string, n: any, ctx: any) -> ((ph: Frame) -> Claim)?)?,
	store: any?,
	detail: ((rec: any) -> ())?,
}

export type Rec = {
	id: string,
	kind: string,
	node: any,
	root: GuiObject,
	content: GuiObject,     -- where children go
	autoW: boolean,         -- sized by its content (inside a row) rather than by its parent's width
	text: Color3,           -- text colour children inherit
	textT: number,
	base: number,           -- text size children inherit
	conns: { RBXScriptConnection },
	sig: string?,           -- what the object currently shows (skip redundant updates)
	claim: Claim?,          -- a claimed id: the placeholder's owner (no subtree is built)
}

local Render = {}
Render.__index = Render

export type Renderer = typeof(setmetatable({} :: {
	roots: { [string]: GuiObject },
	recs: { [string]: Rec },
	kids: { [string]: { [string]: boolean } },
	hooks: Hooks,
	dirty: { [string]: boolean },
	ctxNow: any,
	skinErrors: number,
}, Render))

function Render.new(roots: { [string]: GuiObject }, hooks: Hooks): Renderer
	local self = setmetatable({ roots = roots, recs = {}, kids = {}, hooks = hooks, dirty = {}, ctxNow = nil, skinErrors = 0 }, Render)
	return self
end

-- pcall for functions that return nothing (the result is ok, err)
local function try(f: (...any) -> ...any, ...: any): (boolean, any)
	return pcall(function(...: any): any
		f(...)
		return nil
	end, ...)
end

-- the hold / tap thresholds (DESIGN.md 3.4)
Render.SLOP = 10
Render.LONG_PRESS = 0.45

local function parentOf(id: string): (string?, number)
	local p, i = string.match(id, "^(.*)%.(%d+)$")
	if p == nil then return nil, 0 end
	return p, tonumber(i) :: number
end

local function depth(id: string): number
	local _, n = string.gsub(id, "%.", "")
	return n
end

local function kindOf(n: any): string
	if n.t == "html" and type(n.h) == "string" and string.find(n.h, "<svg", 1, true) then return "svg" end
	if n.t == "btn" then return "btn:" .. tostring(n.k) end
	return tostring(n.t)
end

-- --------------------------------------------------------------------------------------------------------- helpers
local function label(parent: Instance?, name: string): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.RichText = true
	l.TextWrapped = true
	l.FontFace = Style.FONT
	l.TextColor3 = Style.TEXT
	l.TextSize = 16
	l.Size = UDim2.new(1, 0, 0, 0)
	l.AutomaticSize = Enum.AutomaticSize.Y
	l.Text = ""
	l.Parent = parent
	return l
end

local function frame(name: string): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Size = UDim2.new(1, 0, 0, 0)
	f.AutomaticSize = Enum.AutomaticSize.Y
	return f
end

local function list(obj: GuiObject, horizontal: boolean, pad: number, wraps: boolean?): UIListLayout
	local l = Style.child(obj, "UIListLayout", "List") :: UIListLayout
	l.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center
	l.VerticalAlignment = if horizontal then Enum.VerticalAlignment.Center else Enum.VerticalAlignment.Top
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, pad)
	l.Wraps = wraps == true
	return l
end

local function sizeConstraint(obj: GuiObject, minX: number?, minY: number?, maxX: number?)
	if minX == nil and minY == nil and maxX == nil then Style.drop(obj, "Limit"); return end
	local c = Style.child(obj, "UISizeConstraint", "Limit") :: UISizeConstraint
	c.MinSize = Vector2.new(minX or 0, minY or 0)
	c.MaxSize = Vector2.new(maxX or math.huge, math.huge)
end

local function px(v: any, base: number?): number?
	if type(v) == "number" then return v end
	if type(v) == "string" then return Html.px(v, base) end
	return nil
end

-- ------------------------------------------------------------------------------------------------------- the nodes
function Render._inherit(self: Renderer, parentId: string?): (boolean, Color3, number, number)
	if parentId and self.recs[parentId] then
		local p = self.recs[parentId]
		return p.autoW or p.kind == "row" or p.kind == "tabs", p.text, p.textT, p.base
	end
	return false, Style.TEXT, 0, 16
end

function Render._build(self: Renderer, id: string, n: any): Rec
	local parentId = parentOf(id)
	local autoW, text, textT, base = self:_inherit(parentId)
	local kind = kindOf(n)
	local rec: Rec = { id = id, kind = kind, node = n, root = nil :: any, content = nil :: any, autoW = autoW, text = text, textT = textT, base = base, conns = {} }
	local t = n.t
	if t == "col" or t == "row" or t == "tabs" then
		local f = frame(id)
		if autoW then
			f.Size = UDim2.new(0, 0, 0, 0)
			f.AutomaticSize = Enum.AutomaticSize.XY
		end
		rec.root, rec.content = f, f
	elseif t == "html" or t == "svg" or kind == "svg" then
		local f = frame(id)
		if autoW then f.Size = UDim2.new(0, 0, 0, 0); f.AutomaticSize = Enum.AutomaticSize.XY end
		rec.root, rec.content = f, f
	elseif t == "blank" or t == "hr" then
		local f = Instance.new("Frame")
		f.Name = id
		f.BorderSizePixel = 0
		f.BackgroundTransparency = 1
		rec.root, rec.content = f, f
	elseif t == "btn" then
		local b = Instance.new("TextButton")
		b.Name = id
		b.AutoButtonColor = false
		b.Text = ""
		b.BorderSizePixel = 0
		b.ClipsDescendants = false
		local l = label(b, "Label")
		l.ZIndex = 3
		rec.root, rec.content = b, b
		self:_wireButton(rec, b)
	elseif t == "ms" or t == "chal" or t == "ach" or t == "info" or t == "bar" then
		local f = frame(id)
		f.BackgroundTransparency = 0
		f.Size = UDim2.new(0, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		local l = label(f, "Label")
		l.LayoutOrder = 0
		local kids = frame("Kids")
		kids.LayoutOrder = 1
		kids.Parent = f
		list(kids, t ~= "chal", 6, true)
		rec.root, rec.content = f, kids
		if t == "info" then
			local b = Instance.new("TextButton")
			b.Name = "Title"
			b.AutoButtonColor = false
			b.LayoutOrder = -1
			b.Size = UDim2.new(1, 0, 0, 0)
			b.AutomaticSize = Enum.AutomaticSize.Y
			b.Text = ""
			b.Parent = f
			label(b, "Label")
			self:_wireButton(rec, b)
		elseif t == "bar" then
			local fill = Instance.new("Frame")
			fill.Name = "Fill"
			fill.BorderSizePixel = 0
			fill.ZIndex = 0
			fill.Parent = f
		end
		self:_wireTip(rec, f)
	else
		local f = frame(id)
		rec.root, rec.content = f, f
	end
	return rec
end

function Render._wireTip(self: Renderer, rec: Rec, obj: GuiObject)
	table.insert(rec.conns, obj.MouseEnter:Connect(function()
		local tip = rec.node.tip
		if type(tip) == "string" and tip ~= "" then self.hooks.tip(tip, obj) end
	end))
	table.insert(rec.conns, obj.MouseLeave:Connect(function() self.hooks.tip(nil, obj) end))
end

type Press = {
	io: InputObject,
	touch: boolean,
	x: number,
	y: number,
	scroll: ScrollingFrame?,
	cy: number,
	moved: boolean,
}

local function pointerOf(p: Press): (number, number)
	if p.touch then
		local v = p.io.Position
		return v.X, v.Y
	end
	local m = UserInputService:GetMouseLocation()
	return m.X, m.Y
end
-- the press moved more than SLOP px, or its list scrolled: it is a drag / scroll, not a press (DESIGN.md 3.4)
local function movedOf(p: Press): boolean
	if p.moved then return true end
	local x, y = pointerOf(p)
	local dx, dy = x - p.x, y - p.y
	local sf = p.scroll
	local scrolled = sf ~= nil and math.abs(sf.CanvasPosition.Y - p.cy) > 2
	if dx * dx + dy * dy > Render.SLOP * Render.SLOP or scrolled then p.moved = true end
	return p.moved
end

function Render._wireButton(self: Renderer, rec: Rec, b: GuiButton)
	local cur: Press? = nil
	local seq = 0
	local skipNext = false
	local function isPointer(t: Enum.UserInputType): boolean
		return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
	end
	table.insert(rec.conns, b.Activated:Connect(function()
		if skipNext then
			skipNext = false
			return
		end
		local p = cur
		if p and p.touch and movedOf(p) then return end
		local a = rec.node.a
		if a then
			Audio.pressFor(rec.node)
			self.hooks.press(a, false)
		end
	end))
	-- hold to repeat (buyables, and clickables / grid tiles that have onHold): after 0.25 s, 20 presses a second,
	-- only while the pointer stays put and the list does not scroll
	table.insert(rec.conns, b.InputBegan:Connect(function(input: InputObject)
		if not isPointer(input.UserInputType) then return end
		seq += 1
		local mine = seq
		skipNext = false
		local touch = input.UserInputType == Enum.UserInputType.Touch
		local sf = b:FindFirstAncestorWhichIsA("ScrollingFrame")
		local p: Press = { io = input, touch = touch, x = 0, y = 0, scroll = sf, cy = if sf then sf.CanvasPosition.Y else 0, moved = false }
		p.x, p.y = pointerOf(p)
		cur = p
		if rec.node.hold then
			task.delay(0.25, function()
				while seq == mine and cur == p and rec.root.Parent do
					if movedOf(p) then break end
					local a = rec.node.a
					if a then self.hooks.press(a, true) end
					task.wait(0.05)
				end
			end)
		elseif touch and self.hooks.detail then
			local detail = self.hooks.detail
			task.delay(Render.LONG_PRESS, function()
				if seq == mine and cur == p and not movedOf(p) and rec.root.Parent then
					skipNext = true
					seq += 1
					if detail then detail(rec) end
				end
			end)
		end
	end))
	-- the release ends the hold and the long-press wait; `cur` stays until the next press, so Activated (which may
	-- arrive before or after InputEnded) can still tell a moved touch from a tap
	table.insert(rec.conns, b.InputEnded:Connect(function(input: InputObject)
		if not isPointer(input.UserInputType) then return end
		seq += 1
	end))
	table.insert(rec.conns, b.MouseEnter:Connect(function()
		if rec.node.cls == "can" or rec.node.cls == "perk" or rec.node.cls == "pseudo" then
			-- a UIScale grows the item's footprint in its parent's list / grid too (a row of 4 cards wraps its last
			-- card), so an item in a layout lights its hairline instead; a free-standing button still grows
			local parent = b.Parent
			if parent and parent:FindFirstChildWhichIsA("UIGridStyleLayout") then
				local hair = b:FindFirstChild("Hair") or b:FindFirstChildWhichIsA("UIStroke")
				if hair and hair:IsA("UIStroke") then
					if b:GetAttribute("HairT") == nil then b:SetAttribute("HairT", hair.Transparency) end
					hair.Transparency = 0.1
				end
			else
				local scale = Style.child(b, "UIScale", "Hover") :: UIScale
				scale.Scale = if rec.claim == nil and self.hooks.skin then 1.03 else 1.06
			end
			Audio.play("hover")
		end
		local tip = rec.node.tip
		if type(tip) == "string" and tip ~= "" then self.hooks.tip(tip, b) end
	end))
	table.insert(rec.conns, b.MouseLeave:Connect(function()
		seq += 1
		local scale = b:FindFirstChild("Hover")
		if scale and scale:IsA("UIScale") then scale.Scale = 1 end
		local was = b:GetAttribute("HairT")
		if type(was) == "number" then
			local hair = b:FindFirstChild("Hair") or b:FindFirstChildWhichIsA("UIStroke")
			if hair and hair:IsA("UIStroke") then hair.Transparency = was end
			b:SetAttribute("HairT", nil)
		end
		self.hooks.tip(nil, b)
	end))
end

-- the text of a node, drawn into a label (svg blocks become little canvases next to it)
local function setRich(l: TextLabel, html: string?, base: number, preLine: boolean?)
	local r = Html.rich(html or "", base, preLine)
	if l.Text ~= r then l.Text = r end
	l.TextSize = base
	l.Visible = r ~= ""
end

local function drawSvg(parent: GuiObject, svg: any, order: number): Frame
	local canvas = Instance.new("Frame")
	canvas.Name = "Svg" .. order
	canvas.LayoutOrder = order
	canvas.BackgroundTransparency = 1
	canvas.Size = UDim2.fromOffset(svg.w, svg.h)
	canvas.ClipsDescendants = true
	local lines = svg.bg and ZoneMaps[svg.bg]
	if lines then
		for _, ln in lines do
			local x1, y1, x2, y2, col, w = ln[1], ln[2], ln[3], ln[4], ln[5], ln[6]
			local dx, dy = x2 - x1, y2 - y1
			local len = math.sqrt(dx * dx + dy * dy)
			local seg = Instance.new("Frame")
			seg.BorderSizePixel = 0
			seg.BackgroundColor3 = Color3.fromHex(col)
			seg.AnchorPoint = Vector2.new(0.5, 0.5)
			seg.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
			seg.Size = UDim2.fromOffset(math.max(len, w), w)
			seg.Rotation = math.deg(math.atan2(dy, dx))
			seg.Parent = canvas
		end
	end
	-- the game draws the same label at the same spot many times (435 texts, 26 distinct): draw each once
	local drawn: { [string]: boolean } = {}
	for _, t in svg.texts do
		local key = t.x .. "," .. t.y .. "," .. t.text
		if drawn[key] then continue end
		drawn[key] = true
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.AnchorPoint = Vector2.new(0, 1)
		l.Position = UDim2.fromOffset(t.x, t.y + t.size * 0.2)
		l.AutomaticSize = Enum.AutomaticSize.XY
		l.Size = UDim2.fromOffset(0, 0)
		l.FontFace = Style.FONT
		l.TextSize = t.size
		l.TextColor3 = if t.color then Color3.fromHex(t.color) else Style.TEXT
		l.Text = t.text
		l.Parent = canvas
	end
	canvas.Parent = parent
	return canvas
end

local function btnKind(k: string?): Style.Kind
	return Style.KIND[k or ""] or Style.KIND.upg
end

function Render._update(self: Renderer, rec: Rec, n: any)
	rec.node = n
	if rec.claim then return end
	local skin = self.hooks.skin
	if skin then
		local ok, handled = pcall(skin, rec, n, self.ctxNow)
		if ok and handled then return end
		if not ok then
			self.skinErrors += 1
			if self.skinErrors <= 5 then warn("[MilestoneTree] panel skin failed on " .. rec.id .. ": " .. tostring(handled)) end
		end
	end
	local t, root = n.t, rec.root
	local extraStyle = n.cst
	if t == "col" or t == "row" or t == "tabs" then
		list(root, t ~= "col", if t == "col" then 6 else 8, t ~= "col" and not rec.autoW)
		local a = Style.apply(root, n.st)
		if n.st and (n.st["border-style"] or n.st.border) and not n.st.border then Style.stroke(root, 2, Style.TEXT, 0.4) end
		if a.w then root.Size = UDim2.new(0, a.w, root.Size.Y.Scale, root.Size.Y.Offset); root.AutomaticSize = Enum.AutomaticSize.Y end
		if extraStyle then Style.apply(root, extraStyle) end
	elseif rec.kind == "svg" then
		-- the exploration map: redrawn only when its html changes (hundreds of line frames)
		local key = tostring(n.h) .. "|" .. tostring(rec.base)
		if rec.sig == key then return end
		rec.sig = key
		for _, c in root:GetChildren() do if c:IsA("GuiObject") then c:Destroy() end end
		list(root, false, 4)
		local order = 0
		for _, part in Html.split(n.h) do
			order += 1
			if type(part) == "string" then
				if string.find(part, "%S") then
					local l = label(root, "Text" .. order)
					l.LayoutOrder = order
					l.TextColor3, l.TextTransparency = rec.text, rec.textT
					setRich(l, part, rec.base)
				end
			else
				drawSvg(root, part, order)
			end
		end
	elseif t == "html" then
		local l = root:FindFirstChild("Text") :: TextLabel?
		if not l then l = label(root, "Text") end
		local lbl = l :: TextLabel
		local a = Style.apply(root, extraStyle)
		lbl.TextColor3 = a.text or rec.text
		lbl.TextTransparency = a.textT or rec.textT
		if rec.autoW then
			lbl.Size = UDim2.new(0, 0, 0, 0)
			lbl.AutomaticSize = Enum.AutomaticSize.XY
			lbl.TextWrapped = true
			sizeConstraint(lbl, nil, nil, 640)
		end
		setRich(lbl, n.h, a.font or rec.base)
		lbl.Visible = lbl.Text ~= ""
		root.Visible = lbl.Visible
	elseif t == "blank" then
		root.Size = UDim2.fromOffset(px(n.w, rec.base) or 8, px(n.hh, rec.base) or 17)
	elseif t == "hr" then
		root.BackgroundTransparency = 0.5
		root.BackgroundColor3 = Style.TEXT
		local w = px(n.w, rec.base)
		root.Size = if w then UDim2.fromOffset(w, 2) else UDim2.new(if rec.autoW then 0 else 0.95, if rec.autoW then 300 else 0, 0, 2)
	elseif t == "btn" then
		self:_updateButton(rec, n)
	elseif t == "ms" then
		root.Size = UDim2.new(0, 600, 0, 0)
		root.BackgroundColor3 = if n.done then Style.BOUGHT else Style.LOCKED
		root.BackgroundTransparency = 0
		Style.corner(root, 4)
		Style.stroke(root, 4)
		Style.pad(root, 6)
		list(root, false, 4)
		local a = Style.apply(root, n.st)
		if a.w then root.Size = UDim2.fromOffset(math.max(a.w, 120), 0) end
		rec.text, rec.textT, rec.base = a.text or Style.DARK, a.textT or 0.5, a.font or 14
		local l = root:FindFirstChild("Label") :: TextLabel
		l.TextColor3, l.TextTransparency = rec.text, rec.textT
		setRich(l, n.h, rec.base)
		sizeConstraint(root, nil, 35, nil)
	elseif t == "chal" then
		root.Size = UDim2.fromOffset(310, 0)
		root.BackgroundColor3 = if n.cls == "canComplete" then Style.COMPLETE elseif n.cls == "done" then Style.BOUGHT else Style.LOCKED
		root.BackgroundTransparency = 0
		Style.corner(root, 0.2)
		Style.stroke(root, 4)
		Style.glow(root, if n.active then Color3.new(1, 1, 1) else nil)
		Style.pad(root, 14)
		list(root, false, 8)
		local a = Style.apply(root, n.st)
		rec.text, rec.textT, rec.base = a.text or Style.DARK, a.textT or 0.5, a.font or 14
		local l = root:FindFirstChild("Label") :: TextLabel
		l.Visible = false
		sizeConstraint(root, nil, 310, nil)
		for _, kid in self:_children(rec.id) do
			local kr = self.recs[kid]
			if kr then kr.text, kr.textT, kr.base = rec.text, rec.textT, rec.base; kr.sig = nil; self:_update(kr, kr.node) end
		end
	elseif t == "ach" then
		root.Size = UDim2.fromOffset(90, 90)
		root.AutomaticSize = Enum.AutomaticSize.None
		root.BackgroundColor3 = if n.done then Style.BOUGHT else Style.LOCKED
		root.BackgroundTransparency = 0
		Style.corner(root, 0.1)
		Style.stroke(root, 2)
		Style.pad(root, 4)
		Style.apply(root, n.st)
		local l = root:FindFirstChild("Label") :: TextLabel
		l.TextColor3 = Color3.new(1, 1, 1)
		local stroke = Style.child(l, "UIStroke", "Shadow") :: UIStroke
		stroke.Thickness = 1
		stroke.Transparency = 0.3
		setRich(l, n.h, 10)
		local num = Style.child(root, "TextLabel", "Num") :: TextLabel
		num.BackgroundTransparency = 1
		num.Size = UDim2.fromOffset(30, 14)
		num.Position = UDim2.new(1, -30, 1, -14)
		num.FontFace = Style.FONT
		num.TextSize = 10
		num.TextColor3 = Color3.new(1, 1, 1)
		num.Text = tostring(n.num or "")
	elseif t == "info" then
		local color = Html.color(n.color) or Style.TEXT
		root.Size = UDim2.fromOffset(600, 0)
		root.BackgroundColor3 = Style.BG
		root.BackgroundTransparency = 0
		Style.stroke(root, 4, color, 0)
		Style.corner(root, if n.shut then 0 else 8)
		list(root, false, 4)
		local title = root:FindFirstChild("Title") :: TextButton
		title.BackgroundColor3 = color
		local tl = title:FindFirstChild("Label") :: TextLabel
		tl.TextColor3 = Style.DARK
		tl.TextXAlignment = Enum.TextXAlignment.Left
		setRich(tl, (if n.shut then "+ " else "- ") .. (n.title or ""), 24)
		local l = root:FindFirstChild("Label") :: TextLabel
		l.TextXAlignment = Enum.TextXAlignment.Left
		setRich(l, if n.shut then "" else n.body, 16)
	elseif t == "bar" then
		local w, h = px(n.w) or 200, px(n.hh) or 50
		root.Size = UDim2.fromOffset(w, h)
		root.AutomaticSize = Enum.AutomaticSize.None
		root.BackgroundColor3 = Style.BG
		Style.stroke(root, 2, Style.TEXT, 0)
		Style.apply(root, n.base)
		local fill = root:FindFirstChild("Fill") :: Frame
		local p = math.clamp(tonumber(n.p) or 0, 0, 1)
		local dir = n.dir
		fill.BackgroundColor3 = Style.TEXT
		Style.apply(fill, n.fill)
		if dir == 0 then fill.Size = UDim2.fromScale(1, p); fill.Position = UDim2.fromScale(0, 1 - p)
		elseif dir == 1 then fill.Size = UDim2.fromScale(1, p); fill.Position = UDim2.fromScale(0, 0)
		elseif dir == 2 then fill.Size = UDim2.fromScale(p, 1); fill.Position = UDim2.fromScale(1 - p, 0)
		else fill.Size = UDim2.fromScale(p, 1); fill.Position = UDim2.fromScale(0, 0) end
		local l = root:FindFirstChild("Label") :: TextLabel
		l.Size = UDim2.fromScale(1, 1)
		l.AutomaticSize = Enum.AutomaticSize.None
		l.ZIndex = 2
		setRich(l, n.h, 14)
	end
end

function Render._updateButton(self: Renderer, rec: Rec, n: any)
	local b = rec.root :: TextButton
	local k = btnKind(n.k)
	local w = k.w
	-- class colours, then the game's style on top
	local base = Style.classColor(n.k, n.cls)
	if base then b.BackgroundColor3 = base; b.BackgroundTransparency = 0 else b.BackgroundTransparency = 1 end
	Style.corner(b, k.radius)
	Style.stroke(b, k.stroke)
	Style.pad(b, if n.k == "tab" then 6 else 5)
	local a = Style.apply(b, n.st)
	if n.cst then
		local a2 = Style.apply(b, n.cst)
		a.w, a.h, a.minH, a.font, a.text = a2.w or a.w, a2.h or a.h, a2.minH or a.minH, a2.font or a.font, a2.text or a.text
	end
	if n.k == "tab" then
		local c = n.st and Html.color(n.st["border-color"])
		Style.stroke(b, 2, c or Style.TEXT, 0)
		b.BackgroundTransparency = if n.cls == "cur" then 0.75 else 1
		b.BackgroundColor3 = c or Style.TEXT
	elseif n.k == "menu" and n.cls == "cur" then
		Style.stroke(b, 3, Color3.new(1, 1, 1), 0)
	end
	Style.glow(b, if n.glow then (Html.color(n.glow) or Color3.new(1, 0, 0)) elseif n.pulse then Color3.new(1, 1, 1) else nil)
	local width = a.w or w
	local minH = a.minH or a.h or k.h
	if width then
		b.Size = UDim2.fromOffset(width, if k.grow then 0 else (a.h or k.h))
		b.AutomaticSize = if k.grow then Enum.AutomaticSize.Y else Enum.AutomaticSize.None
	else
		b.Size = UDim2.fromOffset(0, a.h or k.h)
		b.AutomaticSize = Enum.AutomaticSize.X
	end
	sizeConstraint(b, nil, if k.grow then minH else nil, nil)
	local l = b:FindFirstChild("Label") :: TextLabel
	l.TextColor3 = a.text or k.text
	l.TextTransparency = a.textT or 0
	l.TextXAlignment = k.align or Enum.TextXAlignment.Center
	if width then
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.TextWrapped = true
	else
		l.Size = UDim2.new(0, 0, 1, 0)
		l.AutomaticSize = Enum.AutomaticSize.X
		l.TextWrapped = false
	end
	if not k.grow then
		l.Size = UDim2.new(if width then 1 else 0, 0, 1, 0)
		l.AutomaticSize = if width then Enum.AutomaticSize.None else Enum.AutomaticSize.X
		l.TextScaled = false
	end
	setRich(l, n.h, a.font or k.font, n.k == "buy" or n.k == "click" or n.k == "grid")
	-- the upgrade's number, big and faint behind the text (upgNum)
	if n.n ~= nil and n.k == "upg" then
		local num = Style.child(b, "TextLabel", "Num") :: TextLabel
		num.BackgroundTransparency = 1
		num.Position = UDim2.fromOffset(1, 50)
		num.Size = UDim2.fromOffset(80, 60)
		num.TextXAlignment = Enum.TextXAlignment.Left
		num.FontFace = Style.FONT
		num.TextSize = 60
		num.TextColor3 = Style.DARK
		num.TextTransparency = 0.65
		num.ZIndex = 2
		num.Text = tostring(n.n)
	else
		Style.drop(b, "Num")
	end
	b.Active = n.a ~= nil
	b.Visible = not a.hidden
end

-- ---------------------------------------------------------------------------------------------------------- patches
function Render._children(self: Renderer, id: string): { string }
	local out = {}
	local set = self.kids[id]
	if set then for k in set do table.insert(out, k) end end
	return out
end

function Render._destroy(self: Renderer, id: string, keepKids: boolean?)
	local rec = self.recs[id]
	if not rec then return end
	if not keepKids then
		for _, k in self:_children(id) do self:_destroy(k) end
		self.kids[id] = nil
	end
	for _, c in rec.conns do c:Disconnect() end
	local claim = rec.claim
	if claim then
		rec.claim = nil
		self.dirty[id] = nil
		local ok, err = try(claim.destroy, claim)
		if not ok then warn("[MilestoneTree] claim destroy failed on " .. id .. ": " .. tostring(err)) end
	end
	rec.root:Destroy()
	self.recs[id] = nil
	local p = parentOf(id)
	if p and self.kids[p] then self.kids[p][id] = nil end
end

function Render._place(self: Renderer, rec: Rec)
	local p, index = parentOf(rec.id)
	local parentObj: GuiObject? = nil
	if p == nil then
		parentObj = self.roots[rec.id]
	elseif self.recs[p] then
		parentObj = self.recs[p].content
	end
	rec.root.LayoutOrder = index
	rec.root.Parent = parentObj
	if p then
		self.kids[p] = self.kids[p] or {}
		self.kids[p][rec.id] = true
	end
end

-- the nearest claimed record at or above id (nil when none)
function Render._claimOwner(self: Renderer, id: string): string?
	local p: string? = id
	while p do
		local r = self.recs[p]
		if r and r.claim then return p end
		p = (parentOf(p))
	end
	return nil
end

-- a placeholder for a claimed id: a plain Frame in the node's slot, no subtree
function Render._makeClaim(self: Renderer, id: string, n: any, maker: (ph: Frame) -> Claim): Rec
	local ph = Instance.new("Frame")
	ph.Name = id
	ph.BackgroundTransparency = 1
	ph.BorderSizePixel = 0
	ph.Size = UDim2.new(1, 0, 0, 0)
	ph.AutomaticSize = Enum.AutomaticSize.Y
	local autoW, text, textT, base = self:_inherit((parentOf(id)))
	local rec: Rec = { id = id, kind = kindOf(n), node = n, root = ph, content = ph, autoW = autoW, text = text, textT = textT,
		base = base, conns = {} }
	self.recs[id] = rec
	self:_place(rec)
	local ok, claim = pcall(maker, ph)
	if ok and claim then
		rec.claim = claim
		self.dirty[id] = true
	elseif not ok then
		warn("[MilestoneTree] claim failed on " .. id .. ": " .. tostring(claim))
	end
	return rec
end

function Render._askClaim(self: Renderer, id: string, n: any): ((ph: Frame) -> Claim)?
	local hook = self.hooks.claim
	if hook == nil then return nil end
	local ok, maker = pcall(hook, id, n, self.ctxNow)
	if ok then return maker end
	warn("[MilestoneTree] claim check failed on " .. id .. ": " .. tostring(maker))
	return nil
end

-- after a rebuild: the children take the new parent's inherited text colour / size and redraw
function Render._reinherit(self: Renderer, id: string, depthLeft: number)
	if depthLeft <= 0 then return end
	for _, k in self:_children(id) do
		local kr = self.recs[k]
		if kr and not kr.claim then
			local autoW, text, textT, base = self:_inherit(id)
			kr.autoW, kr.text, kr.textT, kr.base = autoW, text, textT, base
			kr.sig = nil
			self:_update(kr, kr.node)
			self:_reinherit(k, depthLeft - 1)
		end
	end
end

function Render.apply(self: Renderer, patch: any)
	local ctxHook = self.hooks.ctx
	self.ctxNow = if ctxHook then ctxHook() else nil
	if patch.full then
		for id in self.recs do
			if parentOf(id) == nil then self:_destroy(id) end
		end
	end
	local rows: { [string]: boolean } = {}
	for _, id in patch.del or {} do
		local owner = self:_claimOwner(id)
		if owner and owner ~= id then
			self.dirty[owner] = true
		else
			local gone = self.recs[id]
			if gone and gone.node and gone.node.t == "btn" and gone.node.k == "upg" and self.hooks.skin then
				local p = parentOf(id)
				if p then rows[p] = true end
			end
			self:_destroy(id)
		end
	end
	local ids = {}
	for id in patch.set or {} do table.insert(ids, id) end
	table.sort(ids, function(a, b)
		local da, db = depth(a), depth(b)
		if da ~= db then return da < db end
		return a < b
	end)
	for _, id in ids do
		local n = patch.set[id]
		local owner = self:_claimOwner(id)
		if owner and owner ~= id then
			self.dirty[owner] = true
			continue
		end
		local rec: Rec? = self.recs[id]
		-- a new upgrade card, or one whose state (can / not yet / bought) changed, redraws its row (below); a patch
		-- that only moves a value (an owned upgrade's effect, 10 times a second) does not
		if n.t == "btn" and n.k == "upg" and self.hooks.skin and (rec == nil or rec.node == nil or rec.node.cls ~= n.cls) then
			local p = parentOf(id)
			if p then rows[p] = true end
		end
		if rec and rec.claim then
			-- the claimed node itself changed: keep the claim while it is the same component, else give it back
			if rec.kind == kindOf(n) and rec.node.cn == n.cn then
				rec.node = n
				self.dirty[id] = true
				continue
			end
			self:_destroy(id)
			rec = nil
		end
		if rec and rec.kind ~= kindOf(n) then
			-- rebuilt: keep the children and move them to the new object
			local kids = self:_children(id)
			-- take the children out first: destroying the old object would destroy them too, and Roblox never
			-- lets a destroyed object be parented again
			for _, k in kids do
				local kr = self.recs[k]
				if kr then kr.root.Parent = nil end
			end
			self:_destroy(id, true)
			local maker = self:_askClaim(id, n)
			if maker then
				for _, k in kids do self:_destroy(k) end
				self.kids[id] = nil
				self:_makeClaim(id, n, maker)
				continue
			end
			local built = self:_build(id, n)
			rec = built
			self.recs[id] = built
			self:_place(built)
			self.kids[id] = {}
			for _, k in kids do
				local kr = self.recs[k]
				if kr then self:_place(kr) end
			end
			self:_update(built, n)
			self:_reinherit(id, 12)
			continue
		elseif not rec then
			local maker = self:_askClaim(id, n)
			if maker then
				self:_makeClaim(id, n, maker)
				continue
			end
			local built = self:_build(id, n)
			rec = built
			self.recs[id] = built
			self:_place(built)
		end
		self:_update(rec :: Rec, n)
	end
	-- an upgrade's look depends on its row (a fully owned tier turns every card compact and the rail green), so an
	-- upgrade that appeared, went or changed state redraws its row and the siblings the patch did not carry
	for p in rows do
		local pr = self.recs[p]
		if pr and not pr.claim then self:_update(pr, pr.node) end
		for _, k in self:_children(p) do
			local kr = self.recs[k]
			if kr and not kr.claim and patch.set[k] == nil then self:_update(kr, kr.node) end
		end
	end
	-- claims read their subtree from the store once the patch is in
	local store = self.hooks.store
	for id in self.dirty do
		self.dirty[id] = nil
		local r = self.recs[id]
		local claim = r and r.claim
		if claim then
			local ok, err = try(claim.update, claim, store)
			if not ok then warn("[MilestoneTree] claim update failed on " .. id .. ": " .. tostring(err)) end
		end
	end
	self.ctxNow = nil
end

-- redraw every record (after a layout / mode change: skins re-read sizes), and every claim
function Render.refresh(self: Renderer)
	local ctxHook = self.hooks.ctx
	self.ctxNow = if ctxHook then ctxHook() else nil
	local ids = {}
	for id in self.recs do table.insert(ids, id) end
	table.sort(ids, function(a, b)
		local da, db = depth(a), depth(b)
		if da ~= db then return da < db end
		return a < b
	end)
	local store = self.hooks.store
	for _, id in ids do
		local r = self.recs[id]
		if r then
			local claim = r.claim
			if claim then
				local ok, err = try(claim.update, claim, store)
				if not ok then warn("[MilestoneTree] claim update failed on " .. id .. ": " .. tostring(err)) end
			else
				r.sig = nil
				self:_update(r, r.node)
			end
		end
	end
	self.ctxNow = nil
end

function Render.recOf(self: Renderer, id: string): Rec?
	return self.recs[id]
end

function Render.clear(self: Renderer)
	for id in self.recs do
		if parentOf(id) == nil then self:_destroy(id) end
	end
end

return Render
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="152">
          <Properties>
            <string name="Name">Signatures</string>
          </Properties>
          <Item class="ModuleScript" referent="153">
            <Properties>
              <string name="Name">Ach</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Ach: Achievements (DESIGN.md 6 row ach). No CTA.

	    TROPHY SHELF   the count "13 / 18" (Sarpanch 64 gold, the game's own highlighted count) and its effect line,
	                   then 2 shelves of medallions on plank frames: done = gold medallion with its number and a glint
	                   that crosses one of them every 3 s; not yet = slate "?"
	    inspector      a tap (or hover) shows the medallion's name and its goal / reward (the game's tooltip) with a
	                   DONE / NOT YET chip
	The count line leaves the body (the shelf shows it).
]]

local Client = script.Parent.Parent
local Core = Client:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Recipes = require(Core:WaitForChild("Recipes"))
local Layout = require(Core:WaitForChild("Layout"))
local PanelF = Client:WaitForChild("Panel")
local Common = require(PanelF:WaitForChild("Skins"):WaitForChild("Common"))
local Sections = require(PanelF:WaitForChild("Sections"))
local Kit = require(script.Parent:WaitForChild("Kit"))

local C = Theme.C
local GOLD = Theme.hue("ach")

local function countLine(h: any): boolean
	return type(h) == "string" and string.find(h, "<h2", 1, true) ~= nil and string.find(h, "completed", 1, true) ~= nil
end

local selected: string? = nil -- the inspected achievement id, for the session

local function shelf(ph: Frame, id: string, store: any, ctx: any): any
	local claim = {}
	local glint: any = nil
	ph.Size = UDim2.new(1, 0, 0, 0)
	ph.AutomaticSize = Enum.AutomaticSize.Y
	Common.list(ph, false, 14)
	local draw: (st: any) -> () = nil :: any
	draw = function(st: any)
		store = st or store
		local compact = Layout.mode == "COMPACT"
		local ids = Kit.findAll(st, id, function(n: any): boolean
			return n.t == "ach"
		end, 3)
		local done = 0
		for _, aid in ids do
			if st:get(aid).done then done += 1 end
		end
		-- the game's count and effect line
		local lid = Kit.find(st, "tab", function(n: any): boolean
			return n.cn == "display-text" and countLine(n.h)
		end, 4)
		local line = if lid then st:get(lid).h else nil
		local count = if line then Kit.h2(line)[1] else nil
		count = count or (done .. " / " .. #ids)
		count = string.gsub(count :: string, "%s*/%s*", " / ")
		Sections.header(ph, { name = "Head", order = 0, text = "TROPHY SHELF", hue = GOLD,
			chips = { { text = done .. " / " .. #ids, color = C.ink, bg = GOLD, bgT = 0 } } })
		local top = Common.get(ph, "Count", "Frame") :: Frame
		top.LayoutOrder = 1
		top.Active = false
		top.Size = UDim2.new(1, 0, 0, 0)
		top.AutomaticSize = Enum.AutomaticSize.Y
		Common.list(top, true, 18, { valign = Enum.VerticalAlignment.Center })
		local big = Common.get(top, "Big", "TextLabel") :: TextLabel
		big.LayoutOrder = 1
		big.AutomaticSize = Enum.AutomaticSize.X
		big.Size = UDim2.fromOffset(0, if compact then 44 else 72)
		local sig = tostring(count) .. "|" .. tostring(compact)
		if big:GetAttribute("Sig") ~= sig then
			big:SetAttribute("Sig", sig)
			-- Sleek: a clean gold count, no outline or drop shadow
			Recipes.number(big, { text = count :: string, size = if compact then 38 else 56, from = Theme.lift(GOLD, 0.45), to = GOLD,
				stroke = 0, shadow = 0, role = "hero" })
		end
		local eff = Common.label(top, "Effect", "body", C.text, { order = 2 })
		eff.Size = UDim2.new(1, if compact then -130 else -220, 0, 0)
		local effText = ""
		if line then
			local rest = string.match(line, "</h2>(.*)$") or ""
			effText = Common.html(rest, "body", ctx.layer)
		end
		Common.setText(eff, effText)
		-- the shelves: 2 planks of up to 9 medallions (wrapping on phones)
		local per = math.max(1, math.ceil(#ids / 2))
		local size = if compact then 48 else 64
		local used: { [string]: boolean } = { Head = true, Count = true, List = true }
		local firstDone: TextButton? = nil
		for s = 1, 2 do
			local name = "Shelf" .. s
			local lo, hi = (s - 1) * per + 1, math.min(#ids, s * per)
			if lo > hi then
				Common.drop(ph, name)
				continue
			end
			used[name] = true
			local plank = Common.get(ph, name, "Frame") :: Frame
			plank.LayoutOrder = 1 + s
			plank.Active = false
			plank.Size = UDim2.new(1, 0, 0, 0)
			plank.AutomaticSize = Enum.AutomaticSize.Y
			-- Sleek: a dark slab with a gold hairline and a lit gold floor line (the shelf edge)
			plank.BackgroundColor3 = Color3.fromHex("0a0e16")
			plank.BackgroundTransparency = 0.25
			Common.drop(plank, "Corner")
			Common.stroke(plank, 1, GOLD, 0.8, "Line").LineJoinMode = Enum.LineJoinMode.Miter
			Common.pad(plank, 12, 12, 16, 12)
			Common.list(plank, true, if compact then 8 else 14, { wraps = true, align = Enum.HorizontalAlignment.Center })
			local mine: { [string]: boolean } = { List = true, Pad = true, Corner = true, Line = true }
			for i = lo, hi do
				local aid = ids[i]
				local n = st:get(aid)
				local key = "A" .. tostring(n.id)
				mine[key] = true
				local b = Common.get(plank, key, "TextButton") :: TextButton
				b.LayoutOrder = i
				b.AutoButtonColor = false
				b.Size = UDim2.fromOffset(size, size)
				Common.corner(b, 0.5)
				local isDone = n.done == true
				local sel = selected == tostring(n.id)
				if isDone then
					b.BackgroundColor3 = GOLD
					Common.stroke(b, if sel then 3 else 2, if sel then C.white else Theme.lift(GOLD, 0.5), 0)
					Common.text(b, "badge", C.ink)
					Common.setText(b, tostring(n.num or i))
					if firstDone == nil then firstDone = b end
				else
					b.BackgroundColor3 = C.panel3
					Common.stroke(b, if sel then 3 else 1.5, if sel then GOLD else C.strokeHi, if sel then 0 else 0.3)
					Common.text(b, "label", C.soft)
					Common.setText(b, "?")
				end
				b.BackgroundTransparency = 0
				b.TextXAlignment = Enum.TextXAlignment.Center
				b.TextYAlignment = Enum.TextYAlignment.Center
				Common.state(b, if isDone then "owned" else "locked")
				local aKey = tostring(n.id)
				local function pick()
					if selected ~= aKey then
						selected = aKey
						draw(store)
					end
				end
				Kit.onPress(b, pick)
				if b:GetAttribute("Hover") ~= true then
					b:SetAttribute("Hover", true)
					b.MouseEnter:Connect(pick)
				end
			end
			for _, c in plank:GetChildren() do
				if c:IsA("GuiObject") and not mine[c.Name] then c:Destroy() end
			end
		end
		-- the glint: one done medallion catches the light every 3 s
		if firstDone and glint == nil then
			glint = Recipes.shine(firstDone, { every = 3, dur = 0.8 })
		elseif firstDone == nil and glint then
			glint:stop()
			glint = nil
		end
		-- the inspector strip
		used.Inspect = true
		local strip = Kit.card(ph, "Inspect", { order = 4, gap = 6, pad = 14, fill = Theme.mix(C.panel, GOLD, 0.08), stroke = GOLD, strokeT = 0.5 })
		local pickN: any = nil
		for _, aid in ids do
			local n = st:get(aid)
			if tostring(n.id) == selected then pickN = n end
		end
		local text = Common.label(strip, "Text", "body", C.text, { order = 1 })
		if pickN then
			local state = if pickN.done then Common.caps("Done", C.ownedValue) else Common.caps("Not yet", C.soft)
			Common.setText(text, Common.title(Common.plain(Common.str(pickN.ti) or ""), "card", C.text) .. "   " .. state .. "\n"
				.. Common.html(pickN.tip, "body", ctx.layer))
		else
			Common.setText(text, Common.run(Common.esc("Tap a medallion to see its goal."), "small", C.soft))
		end
		for _, c in ph:GetChildren() do
			if c:IsA("GuiObject") and not used[c.Name] then c:Destroy() end
		end
	end
	function claim.update(_: any, st: any)
		draw(st)
	end
	function claim.destroy(_: any)
		if glint then
			glint:stop()
			glint = nil
		end
		for _, c in ph:GetChildren() do c:Destroy() end
	end
	return claim
end

-- the count line leaves the body; other lines stay notes
local function note(ph: Frame, id: string, store: any, ctx: any): any
	local claim = {}
	function claim.update(_: any, st: any)
		local n = st:get(id)
		local h = if type(n) == "table" then n.h else nil
		if countLine(h) or not string.find(Common.plain(h), "%S") then
			ph.Visible = false
			ph.Size = UDim2.new()
			ph.AutomaticSize = Enum.AutomaticSize.None
			Common.drop(ph, "Text")
			return
		end
		ph.Visible = true
		ph.Size = UDim2.new(1, 0, 0, 0)
		ph.AutomaticSize = Enum.AutomaticSize.Y
		ph.BackgroundColor3 = C.panel2
		ph.BackgroundTransparency = 0
		Common.corner(ph, 10)
		Common.pad(ph, 10, 14, 10, 16)
		local l = Common.label(ph, "Text", "body", C.text)
		Common.setText(l, Common.html(h, "body", ctx.layer))
	end
	function claim.destroy(_: any)
		Common.drop(ph, "Text")
	end
	return claim
end

-- a gold shrine: a warm glow behind the header
local function accent(sheet: Frame, ctx: any)
	local band = Kit.band(sheet)
	if band == nil then return end
	local a = Kit.accent(band, "Ach")
	a.ClipsDescendants = true
	local blob = Common.blob(a, "Shrine", GOLD, 0.3)
	if blob then
		blob.AnchorPoint = Vector2.new(0.5, 0.5)
		blob.Position = UDim2.new(0.5, 0, 0, 10)
		blob.Size = UDim2.fromOffset(700, 200)
	end
end

return {
	layers = { "ach" },
	accent = accent,
	claims = ({
		{ match = { cn = "achievements" }, make = shelf },
		{ match = { cn = "display-text" }, make = note },
	} :: { any }),
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="154">
            <Properties>
              <string name="Name">Ap</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Ap: Atomic Prestige (DESIGN.md 6 row ap).

	    accent   the atom orbit: two elliptical rings around the emblem, turning (still with reduced motion)
	    active   the challenge being run is pinned with a gold ribbon ("ACTIVE") over its card
	The challenges, the Challenge Slayer buyable and the upgrades keep the template (P.skin: Hide owned).
]]

local Client = script.Parent.Parent
local Core = Client:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Motion = require(Core:WaitForChild("Motion"))
local PanelF = Client:WaitForChild("Panel")
local Skins = PanelF:WaitForChild("Skins")
local Common = require(Skins:WaitForChild("Common"))
local Challenge = require(Skins:WaitForChild("Challenge"))
local Kit = require(script.Parent:WaitForChild("Kit"))
local P = (require(script.Parent:WaitForChild("P")) :: any).P

local C = Theme.C

local function orbit(sheet: Frame, ctx: any)
	local emblem = sheet:FindFirstChild("Emblem") :: GuiObject?
	if emblem == nil or Layout.mode == "COMPACT" then return end
	local a = Kit.accent(sheet, "Ap")
	local cx = emblem.Position.X.Offset + emblem.Size.X.Offset / 2
	local cy = emblem.Position.Y.Offset + emblem.Size.Y.Offset / 2
	local holder = Common.get(a, "Orbit", "Frame") :: Frame
	holder.Active = false
	holder.BackgroundTransparency = 1
	holder.ZIndex = 7
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromOffset(cx, cy)
	holder.Size = UDim2.fromOffset(150, 150)
	for i, rot in { 30, -30 } do
		local r = Common.get(holder, "Ring" .. i, "Frame") :: Frame
		r.Active = false
		r.BackgroundTransparency = 1
		r.AnchorPoint = Vector2.new(0.5, 0.5)
		r.Position = UDim2.fromScale(0.5, 0.5)
		r.Size = UDim2.fromOffset(146, 52)
		r.Rotation = rot
		Common.corner(r, 0.5)
		Common.stroke(r, 2, Theme.lift(ctx.hue, 0.35), 0.25)
	end
	Motion.loop(holder, function(dt: number)
		if not Motion.reduced() then holder.Rotation = (holder.Rotation + dt * 18) % 360 end
	end)
end

-- the running challenge gets a gold ribbon over the default card
local function skin(rec: any, n: any, ctx: any): boolean
	if rec.kind == "chal" then
		local ok = Challenge.skin(rec, n, ctx)
		local active = n.st8 == "active" or n.st8 == "completable" or n.active == true
		if active then
			local rib = Common.chip(rec.root, "Ribbon", "ACTIVE", { color = C.ink, bg = C.gold, bgT = 0, h = 24 })
			rib.AnchorPoint = Vector2.new(1, 0)
			rib.Position = UDim2.new(1, 6, 0, -12)
			rib.ZIndex = 6
		else
			Common.drop(rec.root, "Ribbon")
		end
		return ok
	end
	return P.skin(rec, n, ctx)
end

return {
	layers = { "ap" },
	skin = skin,
	accent = orbit,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="155">
            <Properties>
              <string name="Name">Badges</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Badges: Prestige Boost and Hyper Boost (DESIGN.md 6 rows pb and hb).

	    hero     the power badge: a hue diamond with "^x" (the exponent the main display's effect line ends with, as
	             sent) in the free slot between the resource block and the CTA; it pulses once when the value changes
	    accent   pb mint / hb pale mint: a soft glow in the header corner
	The upgrades keep the tier board (P.skin: Hide owned).
]]

local Client = script.Parent.Parent
local Core = Client:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Motion = require(Core:WaitForChild("Motion"))
local PanelF = Client:WaitForChild("Panel")
local Common = require(PanelF:WaitForChild("Skins"):WaitForChild("Common"))
local Kit = require(script.Parent:WaitForChild("Kit"))
local P = (require(script.Parent:WaitForChild("P")) :: any).P

local C = Theme.C

local function hero(f: Frame, store: any, ctx: any)
	local a = Kit.accent(f, "Badge")
	local md = Kit.find(store, "tab", function(n: any): boolean
		return n.cn == "main-display"
	end, 3)
	local eff = if md then Common.plain(Common.str(store:get(md).eff) or "") else ""
	local power = string.match(eff, "powered by%s+([%d%.,e%+]+)")
	local slot = if power then Kit.heroSlot(a, "Power", 170, 140) else nil
	if slot == nil then
		Common.drop(a, "Power")
		return
	end
	local s = slot :: Frame
	local hue = ctx.hue :: Color3
	local gem = Common.get(s, "Gem", "Frame") :: Frame
	gem.Active = false
	gem.AnchorPoint = Vector2.new(0.5, 0.5)
	gem.Position = UDim2.new(0.5, 0, 0, 46)
	gem.Size = UDim2.fromOffset(62, 62)
	gem.Rotation = 45
	gem.BackgroundColor3 = Theme.mix(C.deep, hue, 0.55)
	gem.BackgroundTransparency = 0
	Common.corner(gem, 14)
	Common.stroke(gem, 3, Theme.lift(hue, 0.45), 0)
	Common.glow(gem, hue, 0.55, 16)
	local value = Common.get(s, "Value", "TextLabel") :: TextLabel
	value.Active = false
	value.AnchorPoint = Vector2.new(0.5, 0.5)
	value.Position = UDim2.new(0.5, 0, 0, 46)
	value.Size = UDim2.new(1, 0, 0, 44)
	value.ZIndex = 3
	value.TextXAlignment = Enum.TextXAlignment.Center
	value.TextYAlignment = Enum.TextYAlignment.Center
	value.TextWrapped = false
	local text = "^" .. (power :: string)
	if value:GetAttribute("Sig") ~= text then
		local had = value:GetAttribute("Sig") ~= nil
		value:SetAttribute("Sig", text)
		Common.text(value, "index", C.text)
		value.Text = text
		local st = Common.stroke(value, 3, C.black, 0, "Stroke")
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		if had then Motion.bump(gem, 0.12) end
	end
	local cap = Common.get(s, "Cap", "TextLabel") :: TextLabel
	cap.Active = false
	Common.text(cap, "caps", C.soft)
	cap.AnchorPoint = Vector2.new(0.5, 0)
	cap.Position = UDim2.new(0.5, 0, 0, 94)
	cap.Size = UDim2.new(1, 0, 0, 18)
	cap.TextXAlignment = Enum.TextXAlignment.Center
	Common.setText(cap, Common.caps("Power"))
end

local function accent(sheet: Frame, ctx: any)
	local band = Kit.band(sheet)
	if band == nil then return end
	local a = Kit.accent(band, "Badges")
	a.ClipsDescendants = true
	local blob = Common.blob(a, "Glow", Theme.lift(ctx.hue, 0.3), 0.3)
	if blob then
		blob.AnchorPoint = Vector2.new(0.5, 0.5)
		blob.Position = UDim2.new(1, -160, 0, 0)
		blob.Size = UDim2.fromOffset(420, 200)
	end
end

return {
	{ layers = { "pb" }, skin = P.skin, hero = hero, accent = accent },
	{ layers = { "hb" }, skin = P.skin, hero = hero, accent = accent },
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="156">
            <Properties>
              <string name="Name">Cp</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Cp: Corrupted Prestige, symbol CR (DESIGN.md 6 row cp, 6.1 "cp terminal"). The Panel draws the corrupted shell
	(dashed lime rim, terminal body, breadcrumb); this adds:

	    hero      CAUSED / FIXED counters (the game's two highlighted numbers, Sarpanch 52), the essences as two stat
	              rows, and a black glossy CORRUPT with lime scanlines whose well reads "n charges" and a "next at"
	              chip (the prestige button's own gain / next, as sent). The source lines leave the body.
	    MODE      ESSENCE & RECHARGE MODE: the two mode clickables as a radio (one press, the clickable's own action)
	    DISKS     the grid as a terminal window (C:\CORRUPTION\DISKS, cols x rows, corrupted / fixing counts): 104 du
	              tiles from gs / lv / kind (empty = quiet slot id, Trojan lime dashed, Backdoor crimson dashed, active
	              or chosen gold with the fix bar), a legend, and the INSPECTOR: the selected disk's fix / debuff /
	              reward (gx), the fix progress once as the game's ASCII bar, ACTIVATE / DEACTIVATE (the tile's own
	              action). Mouse: a click fires the tile, hovering selects it; touch: a tap selects, the inspector acts.
	At most 36 tiles, each at most 8 instances.
]]

local UserInputService = game:GetService("UserInputService")

local Client = script.Parent.Parent
local Core = Client:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Rich = require(Core:WaitForChild("Rich"))
local Layout = require(Core:WaitForChild("Layout"))
local Recipes = require(Core:WaitForChild("Recipes"))
local PanelF = Client:WaitForChild("Panel")
local Common = require(PanelF:WaitForChild("Skins"):WaitForChild("Common"))
local Sections = require(PanelF:WaitForChild("Sections"))
local Kit = require(script.Parent:WaitForChild("Kit"))
local P = (require(script.Parent:WaitForChild("P")) :: any).P

local C = Theme.C
local LIME = Theme.hue("cp")

local function trim(s: string): string
	return (string.gsub(string.gsub(s, "^%s+", ""), "%s+$", ""))
end

-- the display-text lines the hero takes over (they carry the game's highlighted numbers)
local function heroLine(h: any): string?
	if type(h) ~= "string" or not string.find(h, "<h2", 1, true) then return nil end
	if string.find(h, "caused", 1, true) then return "counts" end
	if string.find(h, "corruption essences", 1, true) then return "essences" end
	return nil
end

-- ------------------------------------------------------------------------------------------------------ hero
local function hero(f: Frame, store: any, ctx: any)
	local a = Kit.accent(f, "Cp")
	local compact = Layout.mode == "COMPACT"
	local counts: { string } = {}
	local ess, boost = nil :: string?, nil :: string?
	for _, id in Kit.findAll(store, "tab", function(n: any): boolean
		return n.cn == "display-text" and heroLine(n.h) ~= nil
	end, 4) do
		local n = store:get(id)
		local kind = heroLine(n.h)
		if kind == "counts" then
			counts = Kit.h2(n.h)
		elseif kind == "essences" then
			ess = Kit.h2(n.h)[1]
			local plain = Common.plain(n.h)
			boost = string.match(plain, "gain by%s+([^%s%(]+)")
		end
	end
	-- the counters and the essences rows (WIDE: left block; COMPACT: the column's top)
	local block = Common.get(a, "Block", "Frame") :: Frame
	block.Active = false
	block.Position = UDim2.new()
	block.Size = UDim2.new(if compact then 1 else 0, if compact then 0 else 560, 0, 0)
	block.AutomaticSize = Enum.AutomaticSize.Y
	Common.list(block, false, if compact then 4 else 6)
	local row = Common.get(block, "Counts", "Frame") :: Frame
	row.Active = false
	row.LayoutOrder = 1
	row.Size = UDim2.new(1, 0, 0, if compact then 40 else 64)
	Common.list(row, true, if compact then 14 else 28, { valign = Enum.VerticalAlignment.Bottom })
	local labels = { "Caused", "Fixed" }
	for i = 1, 2 do
		local v = counts[i]
		local name = labels[i]
		if v then
			local cap = Common.get(row, name .. "Cap", "TextLabel") :: TextLabel
			cap.Active = false
			cap.LayoutOrder = i * 2 - 1
			Common.text(cap, "caps", C.termDim)
			cap.AutomaticSize = Enum.AutomaticSize.X
			cap.Size = UDim2.fromOffset(0, 20)
			cap.TextYAlignment = Enum.TextYAlignment.Bottom
			Common.setText(cap, Common.esc(Rich.caps(name)))
			local num = Common.get(row, name, "TextLabel") :: TextLabel
			num.LayoutOrder = i * 2
			num.AutomaticSize = Enum.AutomaticSize.X
			num.Size = UDim2.fromOffset(0, if compact then 36 else 60)
			num.TextXAlignment = Enum.TextXAlignment.Left
			local sig = v .. "|" .. tostring(compact)
			if num:GetAttribute("Sig") ~= sig then
				num:SetAttribute("Sig", sig)
				Recipes.number(num, { text = v, size = if compact then 30 else 52, from = C.white, mid = Theme.lift(LIME, 0.4),
					to = if i == 1 then LIME else C.bought, stroke = if compact then 4 else 6, shadow = if compact then 2 else 4, role = "big" })
			end
		else
			Common.drop(row, name .. "Cap")
			Common.drop(row, name)
		end
	end
	local rows: { { string } } = {}
	if ess then table.insert(rows, { "Corruption essences", ess }) end
	if boost then table.insert(rows, { "Points & PE gain", "×" .. boost }) end
	for i = 1, 2 do
		local r = rows[i]
		local name = "Stat" .. i
		if r then
			local l = Common.label(block, name, "small", C.termDim, { order = 1 + i, wrap = false })
			Common.setText(l, Common.esc(r[1]) .. "   " .. Common.num(if compact then Rich.short(r[2]) else r[2], "numberHeavy", C.termLime))
		else
			Common.drop(block, name)
		end
	end
	-- CORRUPT: black gloss, lime rim and scanlines; the well reads the charges, a chip the next charge
	local cta = f:FindFirstChild("Cta") :: GuiObject?
	local pb = Kit.resetNode(store)
	if cta and pb then
		local fill = cta:FindFirstChild("Fill")
		if fill and fill:IsA("UIGradient") then
			fill.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(34, 44, 36)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(8, 14, 9)),
				ColorSequenceKeypoint.new(1, Color3.new(0, 0, 0)),
			})
		end
		local rim = cta:FindFirstChild("Rim")
		if rim and rim:IsA("UIStroke") then
			local rg = rim:FindFirstChild("RimGradient")
			if rg and rg:IsA("UIGradient") then rg.Color = ColorSequence.new(Theme.lift(LIME, 0.3), Theme.shade(LIME, 0.6)) end
		end
		Common.glow(cta, if pb.cls == "can" then LIME else nil, 0.5, 18)
		local scan = Kit.stripes(cta, LIME, 0.06, 16, 90, "Scan")
		if scan then
			scan.ZIndex = 9
			Kit.tether(a, "ScanGuard", scan)
		end
		local well = cta:FindFirstChild("Well") :: TextLabel?
		local gain = Common.str(pb.gain)
		if well and gain and pb.cls == "can" then
			Common.setText(well, Common.num(gain, "ctaSub", C.text, "charges", true))
		end
		local nextAt = Common.str(pb.next)
		if nextAt and not compact then
			local stats = f:FindFirstChild("Stats") :: GuiObject?
			local y = cta.Size.Y.Offset + 10 + (if stats and stats.Visible then 42 else 0)
			local chip = Common.chip(a, "Next", Common.caps("Next charge at", C.termDim) .. "   "
				.. Common.num(nextAt, "number", C.termLime, Common.plain(Common.str(pb.bres) or "")), { rich = true, bg = Color3.new(0, 0, 0), bgT = 0.2, h = 34 })
			chip.AnchorPoint = Vector2.new(1, 0)
			chip.Position = UDim2.new(1, 0, 0, y)
		else
			Common.drop(a, "Next")
		end
	else
		Common.drop(a, "Next")
	end
end

-- the hero's source lines leave the body; the explainer stays a note (terminal text)
local function noteClaim(ph: Frame, id: string, store: any, ctx: any): any
	local claim = {}
	function claim.update(_: any, st: any)
		local n = st:get(id)
		local h = if type(n) == "table" then n.h else nil
		local text = Common.plain(h)
		if heroLine(h) or not string.find(text, "%S") then
			ph.Visible = false
			ph.Size = UDim2.new()
			ph.AutomaticSize = Enum.AutomaticSize.None
			Common.drop(ph, "Text")
			return
		end
		ph.Visible = true
		ph.Size = UDim2.new(1, 0, 0, 0)
		ph.AutomaticSize = Enum.AutomaticSize.Y
		ph.BackgroundColor3 = Color3.fromRGB(4, 16, 6)
		ph.BackgroundTransparency = 0.2
		Common.corner(ph, 10)
		Common.stroke(ph, 1, C.stableId, 0.4)
		Common.pad(ph, 10, 14, 10, 14)
		local l = Common.label(ph, "Text", "terminal", C.termLime)
		Common.setText(l, Common.esc("> ") .. Common.html(h, "terminal", ctx.layer))
	end
	function claim.destroy(_: any)
		Common.drop(ph, "Text")
	end
	return claim
end

-- ------------------------------------------------------------------------------------------------------ mode radio
local function modeClaim(ph: Frame, id: string, store: any, ctx: any): any
	local claim = {}
	ph.Size = UDim2.new(1, 0, 0, 0)
	ph.AutomaticSize = Enum.AutomaticSize.Y
	Common.list(ph, false, 12)
	function claim.update(_: any, st: any)
		store = st or store
		local compact = Layout.mode == "COMPACT"
		local ids = Kit.findAll(st, id, function(n: any): boolean
			return n.t == "btn" and n.k == "click"
		end, 3)
		Sections.header(ph, { name = "Head", order = 0, text = "ESSENCE & RECHARGE MODE", hue = LIME })
		local row = Kit.stack(ph, "Options", true, 12, 1)
		local used: { [string]: boolean } = { List = true }
		for i, cid in ids do
			local n = st:get(cid)
			local plain = trim(Common.plain(n.h or ""))
			local mode = string.match(plain, "mode to (.-),") or string.match(plain, "mode to (.-)%.") or plain
			local rest = string.match(plain, ",%s*(.*)$")
			local current = n.cls ~= "can" -- the game locks the mode you are already in
			local name = "O" .. i
			used[name] = true
			local b = Common.get(row, name, "TextButton") :: TextButton
			b.LayoutOrder = i
			b.AutoButtonColor = false
			b.Size = UDim2.fromOffset(if compact then math.floor((Kit.live(ctx).contentW - 12) / 2) else 420, 0)
			b.AutomaticSize = Enum.AutomaticSize.Y
			b.BackgroundColor3 = if current then Color3.fromRGB(12, 40, 14) else Color3.fromRGB(6, 18, 8)
			b.BackgroundTransparency = 0
			Common.corner(b, 12)
			Common.stroke(b, if current then 2 else 1, if current then LIME else C.stableId, if current then 0 else 0.3)
			Common.pad(b, 12, 14, 12, 44)
			Common.text(b, "small", C.termLime)
			b.TextWrapped = true
			b.TextXAlignment = Enum.TextXAlignment.Left
			b.TextYAlignment = Enum.TextYAlignment.Top
			local text = Common.run(Common.esc(mode), "label", if current then C.text else C.termLime)
			if rest and rest ~= "" then text ..= "\n" .. Common.run(Common.esc(rest), "small", C.termDim) end
			Common.setText(b, text)
			-- the radio dot
			local dot = Common.get(b, "Dot", "Frame") :: Frame
			dot.Active = false
			dot.Position = UDim2.fromOffset(-30, 1)
			dot.Size = UDim2.fromOffset(18, 18)
			dot.BackgroundColor3 = if current then LIME else Color3.new(0, 0, 0)
			dot.BackgroundTransparency = 0
			Common.corner(dot, 0.5)
			Common.stroke(dot, 2, LIME, if current then 0 else 0.4)
			Common.state(b, if current then "owned" else "can")
			Kit.onPress(b, function()
				local x = store:get(cid)
				if type(x) == "table" and type(x.a) == "table" and x.cls == "can" then ctx.act(x.a, false) end
			end)
		end
		for _, c in row:GetChildren() do
			if c:IsA("GuiObject") and not used[c.Name] then c:Destroy() end
		end
	end
	function claim.destroy(_: any)
		for _, c in ph:GetChildren() do c:Destroy() end
	end
	return claim
end

-- ------------------------------------------------------------------------------------------------------ disks
local selected: { [string]: string } = {} -- the inspected disk per layer (its action id), for the session

local function tileLook(b: TextButton, n: any, size: number)
	local gs = n.gs
	local backdoor = n.kind == "backdoor"
	local rim = if gs == "active" or gs == "chosen" then C.complete elseif backdoor then C.danger else C.termLime
	b.AutoButtonColor = false
	b.Size = UDim2.fromOffset(size, size)
	b.BackgroundTransparency = 0
	Common.corner(b, 12)
	Common.text(b, "small", C.termLime)
	b.TextWrapped = true
	b.TextXAlignment = Enum.TextXAlignment.Center
	b.TextYAlignment = Enum.TextYAlignment.Center
	local slot = Common.str(n.id) or ""
	if gs == "empty" then
		b.BackgroundColor3 = Color3.fromRGB(6, 16, 8)
		local s = Common.stroke(b, 1, C.stableId, 0.5)
		Common.drop(s, "Dash")
		Common.setText(b, Common.run(Common.esc(slot), "label", C.stableId))
		Common.drop(b, "Bar")
		return
	end
	b.BackgroundColor3 = if gs == "active" or gs == "chosen" then Color3.fromRGB(34, 30, 8) else Color3.fromRGB(8, 28, 12)
	local s = Common.stroke(b, 2, rim, 0)
	if gs == "corrupted" then Recipes.dashed(s, { color = rim }) else Common.drop(s, "Dash") end
	local lv = math.floor(tonumber(n.lv) or 0)
	local kind = if backdoor then "Backdoor" else "Trojan"
	Common.setText(b, Common.caps(kind, rim) .. "\n" .. Common.caps("Lv", C.termDim) .. " "
		.. Common.num(tostring(lv), if size >= 100 then "numberHeavy" else "number", C.text) .. "\n" .. Common.run(Common.esc(slot), "label", C.termDim))
	local gp = Common.pr(n.gp)
	if gp and (gs == "active" or gs == "chosen") then
		local bar = Common.bar(b, "Bar", gp, C.complete, 5)
		bar.AnchorPoint = Vector2.new(0.5, 1)
		bar.Position = UDim2.new(0.5, 0, 1, -8)
		bar.Size = UDim2.new(1, -20, 0, 5)
	else
		Common.drop(b, "Bar")
	end
end

-- the game's ASCII progress bar (the fix progress, shown once)
local function ascii(p: number): string
	local k = math.clamp(math.floor(p * 10 + 0.5), 0, 10)
	return "[" .. string.rep("#", k) .. string.rep("=", 10 - k) .. "]  -< " .. Rich.pct(p) .. " >-"
end

local function gridClaim(ph: Frame, id: string, store: any, ctx: any): any
	local claim = {}
	ph.Size = UDim2.new(1, 0, 0, 0)
	ph.AutomaticSize = Enum.AutomaticSize.Y
	local layer = ctx.layer
	local draw: (st: any) -> () = nil :: any
	local function inspect(key: string)
		selected[layer] = key
		draw(store)
	end
	draw = function(st: any)
		store = st or store
		local compact = Layout.mode == "COMPACT"
		local tiles: { string } = {}
		local cols = 0
		for _, rid in st:kids(id) do
			local r = st:get(rid)
			if type(r) ~= "table" then continue end
			local c = 0
			for _, tid in st:kids(rid) do
				local t = st:get(tid)
				if type(t) == "table" and t.t == "btn" and t.k == "grid" and #tiles < 36 then
					table.insert(tiles, tid)
					c += 1
				end
			end
			cols = math.max(cols, c)
		end
		local rowsN = if cols > 0 then math.ceil(#tiles / cols) else 0
		local corrupted, fixing = 0, 0
		for _, tid in tiles do
			local t = st:get(tid)
			if t.gs == "active" or t.gs == "chosen" then fixing += 1 elseif t.gs ~= "empty" then corrupted += 1 end
		end
		-- the terminal window
		local win = Kit.card(ph, "Window", { gap = 12, pad = if compact then 10 else 16, fill = Color3.fromRGB(2, 10, 3), stroke = LIME,
			strokeT = 0.45, radius = 14 })
		local head = Common.label(win, "Head", "terminalBold", C.termLime, { order = 1, wrap = false })
		Common.setText(head, Common.esc("C:\\CORRUPTION\\DISKS")
			.. "   " .. Common.run(Common.esc(cols .. " × " .. rowsN .. " · " .. corrupted .. " corrupted · " .. fixing .. " fixing"), "small", C.termDim))
		local body = Common.get(win, "Body", "Frame") :: Frame
		body.LayoutOrder = 2
		body.Active = false
		body.Size = UDim2.new(1, 0, 0, 0)
		body.AutomaticSize = Enum.AutomaticSize.Y
		Common.list(body, not compact, 16, { valign = Enum.VerticalAlignment.Top })
		local size = if compact then 84 else 104
		local gap = 10
		local grid = Common.get(body, "Grid", "Frame") :: Frame
		grid.LayoutOrder = 1
		grid.Active = false
		grid.Size = UDim2.fromOffset(math.max(1, cols) * (size + gap) - gap, 0)
		grid.AutomaticSize = Enum.AutomaticSize.Y
		local gl = Common.get(grid, "Layout", "UIGridLayout") :: UIGridLayout
		gl.CellSize = UDim2.fromOffset(size, size)
		gl.CellPadding = UDim2.fromOffset(gap, gap)
		gl.FillDirection = Enum.FillDirection.Horizontal
		gl.SortOrder = Enum.SortOrder.LayoutOrder
		pcall(function()
			gl.FillDirectionMaxCells = math.max(1, cols)
		end)
		-- the selection: the kept one if it is still a disk, else the first fixing / corrupted disk
		local sel = selected[layer]
		local selId: string? = nil
		for _, tid in tiles do
			local t = st:get(tid)
			if tostring(t.id) == sel then selId = tid end
		end
		if selId == nil then
			for _, tid in tiles do
				local t = st:get(tid)
				if t.gs == "active" or t.gs == "chosen" then
					selId = tid
					break
				end
			end
		end
		if selId == nil then
			for _, tid in tiles do
				if st:get(tid).gs ~= "empty" then
					selId = tid
					break
				end
			end
		end
		local used: { [string]: boolean } = { Layout = true }
		for i, tid in tiles do
			local t = st:get(tid)
			local name = "D" .. tostring(t.id)
			used[name] = true
			local b = Common.get(grid, name, "TextButton") :: TextButton
			b.LayoutOrder = i
			tileLook(b, t, size)
			if tid == selId then
				local s = b:FindFirstChild("Border")
				if s and s:IsA("UIStroke") then s.Thickness = 3 end
			end
			Common.state(b, if t.gs == "empty" then "notyet" else "can")
			local key = tostring(t.id)
			Kit.onPress(b, function()
				local touch = false
				pcall(function()
					touch = UserInputService:GetLastInputType() == Enum.UserInputType.Touch
				end)
				if touch then
					inspect(key)
					return
				end
				local x = store:get(tid)
				if type(x) == "table" and type(x.a) == "table" then ctx.act(x.a, false) end
			end)
			if b:GetAttribute("Hover") ~= true then
				b:SetAttribute("Hover", true)
				b.MouseEnter:Connect(function()
					if selected[layer] ~= key then inspect(key) end
				end)
			end
		end
		for _, c in grid:GetChildren() do
			if c:IsA("GuiObject") and not used[c.Name] then c:Destroy() end
		end
		-- the inspector
		local ins = Kit.card(body, "Inspector", { order = 2, gap = 8, pad = 14, fill = Color3.fromRGB(4, 18, 6), stroke = LIME, strokeT = 0.5,
			w = if compact then nil else 300, radius = 12 })
		local s = if selId then st:get(selId) else nil
		local lines: { string } = {}
		if s then
			local kind = if s.kind == "backdoor" then "Backdoor" else "Trojan"
			table.insert(lines, Common.run(Common.esc("> DISK " .. tostring(s.id)), "terminalBold", C.termLime))
			if s.gs == "empty" then
				table.insert(lines, Common.run(Common.esc("Stable. No corruptions detected."), "small", C.termDim))
			else
				table.insert(lines, Common.caps(kind, if s.kind == "backdoor" then Theme.lift(C.danger, 0.3) else C.termLime) .. "  "
					.. Common.caps("Lv", C.termDim) .. " " .. Common.num(tostring(math.floor(tonumber(s.lv) or 0)), "number", C.text))
				local gx = if type(s.gx) == "table" then s.gx else nil
				if gx then
					local fres = Common.plain(Common.str(gx.fres) or "")
					if gx.fix then table.insert(lines, Common.run("To fix, get", "small", C.termDim) .. "  " .. Common.num(tostring(gx.fix), "number", C.termLime, fres)) end
					if gx.deb then table.insert(lines, Common.run("While active,", "small", C.termDim) .. "  " .. Common.num("/" .. tostring(gx.deb), "number", C.termLime, fres .. " gain")) end
					if gx.rew then table.insert(lines, Common.run("Reward", "small", C.termDim) .. "  " .. Common.num(tostring(gx.rew), "number", C.termLime, "essences")) end
				end
				local gp = Common.pr(s.gp)
				if gp then table.insert(lines, Common.run(Common.esc(ascii(gp)), "terminal", C.complete)) end
			end
		else
			table.insert(lines, Common.run(Common.esc("> no disk selected"), "terminal", C.termDim))
		end
		local info = Common.label(ins, "Info", "small", C.termLime, { order = 1 })
		info.LineHeight = Theme.lineHeight("terminal")
		Common.setText(info, table.concat(lines, "\n"))
		if s and s.gs ~= "empty" and type(s.a) == "table" then
			local active = s.gs == "active" or s.gs == "chosen"
			local b = Kit.button(ins, "Act", Common.esc(if active then "DEACTIVATE" else "ACTIVATE"), { fill = if active then Color3.fromRGB(40, 34, 8) else Color3.fromRGB(10, 44, 14),
				ink = if active then C.complete else C.termLime, stroke = if active then C.complete else LIME, h = 40, w = 1, order = 2 })
			Common.state(b, "can")
			local sid = selId :: string
			Kit.onPress(b, function()
				local x = store:get(sid)
				if type(x) == "table" and type(x.a) == "table" then ctx.act(x.a, false) end
			end)
		else
			Common.drop(ins, "Act")
		end
		-- the legend
		local legend = Common.label(win, "Legend", "small", C.termDim, { order = 3, wrap = true })
		local function dot(c: Color3): string
			return Common.run("•", "label", c)
		end
		Common.setText(legend, dot(C.termLime) .. " Trojan     " .. dot(C.danger) .. " Backdoor     " .. dot(C.complete) .. " Fixing     "
			.. dot(C.stableId) .. " Stable")
	end
	function claim.update(_: any, st: any)
		draw(st)
	end
	function claim.destroy(_: any)
		Common.drop(ph, "Window")
	end
	return claim
end

-- scanlines over the header band
local function accent(sheet: Frame, ctx: any)
	local band = Kit.band(sheet)
	if band == nil then return end
	local a = Kit.accent(band, "Cp")
	Kit.stripes(a, LIME, 0.05, 22, 90)
end

return {
	layers = { "cp" },
	corrupted = true,
	skin = P.skin,
	hero = hero,
	accent = accent,
	claims = ({
		{ match = { cn = "display-text" }, make = noteClaim },
		{ match = { cn = "clickables" }, make = modeClaim },
		{ match = { cn = "grid" }, make = gridClaim },
	} :: { any }),
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="157">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Effects: Exotic Prestige and Prestiged-Exotic (DESIGN.md 6 rows ep and pep).

	    EFFECT LADDER   the game's "1st effect: …" lines (its <br> lines, as sent) as rungs in milestone-row style: the
	                    ordinal in a pill, the effect text; a line in class 'ef' / 'pef' gets a gold EMPOWERED chip. No
	                    rung is invented: the ladder has exactly the lines the game sends.
	    accent          ep: acid-green header stripes; pep: an amber fusion-core ring around the emblem
	The rest (the Fusioner buyable, the upgrades board) keeps the template (P.skin: Hide owned).
]]

local Client = script.Parent.Parent
local Core = Client:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Recipes = require(Core:WaitForChild("Recipes"))
local Motion = require(Core:WaitForChild("Motion"))
local PanelF = Client:WaitForChild("Panel")
local Common = require(PanelF:WaitForChild("Skins"):WaitForChild("Common"))
local Sections = require(PanelF:WaitForChild("Sections"))
local Kit = require(script.Parent:WaitForChild("Kit"))
local P = (require(script.Parent:WaitForChild("P")) :: any).P

local C = Theme.C

local function isLadder(h: string): boolean
	return string.find(h, "1st effect", 1, true) ~= nil
end

local function trim(s: string): string
	return (string.gsub(string.gsub(s, "^%s+", ""), "%s+$", ""))
end

local function ladder(ph: Frame, id: string, store: any, ctx: any): any
	local claim = {}
	local lastCount = 0
	function claim.update(_: any, st: any)
		local n = st:get(id)
		local h = if type(n) == "table" and type(n.h) == "string" then n.h else ""
		if not isLadder(h) then
			-- another line: a NOTES row
			for _, c in ph:GetChildren() do
				if c.Name ~= "Text" then c:Destroy() end
			end
			ph.Visible = string.find(Common.plain(h), "%S") ~= nil
			ph.Size = UDim2.new(1, 0, 0, 0)
			ph.AutomaticSize = Enum.AutomaticSize.Y
			ph.BackgroundColor3 = C.panel2
			ph.BackgroundTransparency = 0
			Common.corner(ph, 10)
			Common.pad(ph, 10, 14, 10, 16)
			local l = Common.label(ph, "Text", "body", C.text)
			Common.setText(l, Common.html(h, "body", ctx.layer))
			return
		end
		Common.drop(ph, "Text")
		Common.drop(ph, "Pad")
		Common.drop(ph, "Corner")
		ph.Visible = true
		ph.BackgroundTransparency = 1
		ph.Size = UDim2.new(1, 0, 0, 0)
		ph.AutomaticSize = Enum.AutomaticSize.Y
		Common.list(ph, false, 10)
		local compact = Layout.mode == "COMPACT"
		local hue = ctx.hue :: Color3
		local lines = string.split((string.gsub(h, "<br%s*/?>", "\0")), "\0")
		local rungs: { { ord: string, text: string, ef: boolean } } = {}
		for _, part in lines do
			local plain = trim(Common.plain(part))
			if plain == "" then continue end
			local ord, rest = string.match(plain, "^(%d+%a%a)%s+effect:%s*(.*)$")
			table.insert(rungs, { ord = ord or tostring(#rungs + 1), text = rest or plain,
				ef = string.find(part, "class=[\"']p?ef[\"']") ~= nil })
		end
		local empowered = 0
		for _, r in rungs do
			if r.ef then empowered += 1 end
		end
		local chips: { any } = { { text = #rungs .. " effects", color = C.text, bg = C.panel3, bgT = 0 } }
		if empowered > 0 then table.insert(chips, { text = empowered .. " empowered", color = C.ink, bg = C.gold, bgT = 0 }) end
		Sections.header(ph, { name = "Head", order = 0, text = "EFFECT LADDER", hue = hue, chips = chips })
		local used: { [string]: boolean } = { Head = true }
		for i, r in rungs do
			local name = "R" .. i
			used[name] = true
			local c = Common.get(ph, name, "TextLabel") :: TextLabel
			c.LayoutOrder = i
			c.Active = false
			Common.text(c, "body", C.text)
			c.TextWrapped = true
			c.TextXAlignment = Enum.TextXAlignment.Left
			c.TextYAlignment = Enum.TextYAlignment.Center
			c.Size = UDim2.new(1, 0, 0, 0)
			c.AutomaticSize = Enum.AutomaticSize.Y
			c.BackgroundColor3 = if r.ef then Theme.mix(C.panel, C.gold, 0.12) else Theme.mix(C.panel, hue, 0.1)
			c.BackgroundTransparency = 0
			Common.corner(c, 12)
			Common.stroke(c, if r.ef then 1.5 else 1, if r.ef then C.gold else Theme.lift(hue, 0.2), if r.ef then 0.2 else 0.55)
			local padL = if compact then 64 else 76
			Common.pad(c, 11, if r.ef and not compact then 150 else 14, 11, padL)
			Common.setText(c, Common.esc(r.text))
			local pill = Common.get(c, "Pill", "TextLabel") :: TextLabel
			pill.Active = false
			Common.text(pill, "label", C.ink)
			pill.AnchorPoint = Vector2.new(0, 0.5)
			pill.Position = UDim2.new(0, -padL + 12, 0.5, 0)
			pill.Size = UDim2.fromOffset(if compact then 42 else 50, 28)
			pill.TextXAlignment = Enum.TextXAlignment.Center
			pill.TextYAlignment = Enum.TextYAlignment.Center
			pill.BackgroundColor3 = if r.ef then C.gold else Theme.lift(hue, 0.25)
			pill.BackgroundTransparency = 0
			Common.corner(pill, 14)
			Common.setText(pill, r.ord)
			if r.ef and not compact then
				local chip = Common.chip(c, "Empowered", "EMPOWERED", { color = C.ink, bg = C.gold, bgT = 0, h = 26 })
				chip.AnchorPoint = Vector2.new(1, 0.5)
				chip.Position = UDim2.new(1, 140, 0.5, 0)
			else
				Common.drop(c, "Empowered")
			end
			Common.state(c, if r.ef then "owned" else "can")
		end
		for _, c in ph:GetChildren() do
			if c:IsA("GuiObject") and not used[c.Name] then c:Destroy() end
		end
		-- a new rung lights up (never on first sight)
		if #rungs > lastCount and lastCount > 0 then
			local c = ph:FindFirstChild("R" .. #rungs) :: GuiObject?
			if c then Motion.flash(c) end
		end
		lastCount = #rungs
	end
	function claim.destroy(_: any)
		for _, c in ph:GetChildren() do c:Destroy() end
	end
	return claim
end

-- ep: acid-green stripes
local function stripes(sheet: Frame, ctx: any)
	local band = Kit.band(sheet)
	if band == nil then return end
	Kit.stripes(Kit.accent(band, "Ep"), Theme.lift(ctx.hue, 0.25), 0.06, 22)
end

-- pep: the fusion core, an amber ring around the emblem that turns slowly
local function core(sheet: Frame, ctx: any)
	local emblem = sheet:FindFirstChild("Emblem") :: GuiObject?
	if emblem == nil or Layout.mode == "COMPACT" then return end
	local a = Kit.accent(sheet, "Pep")
	local holder = Common.get(a, "Core", "Frame") :: Frame
	holder.Active = false
	holder.BackgroundTransparency = 1
	holder.ZIndex = 5
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromOffset(emblem.Position.X.Offset + emblem.Size.X.Offset / 2, emblem.Position.Y.Offset + emblem.Size.Y.Offset / 2)
	holder.Size = UDim2.fromOffset(emblem.Size.X.Offset + 22, emblem.Size.Y.Offset + 22)
	local ring = Recipes.ring(holder, { size = emblem.Size.X.Offset + 22, thick = 4, color = Theme.lift(ctx.hue, 0.2), track = 0.8 })
	ring:set(0.7)
	Motion.loop(holder, function(dt: number)
		if not Motion.reduced() then holder.Rotation = (holder.Rotation + dt * 24) % 360 end
	end)
end

local function sig(layer: string, accent: (Frame, any) -> ()): any
	return {
		layers = { layer },
		skin = P.skin,
		accent = accent,
		claims = ({ { match = { cn = "display-text" }, make = ladder } } :: { any }),
	}
end

return {
	sig("ep", stripes),
	sig("pep", core),
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="158">
            <Properties>
              <string name="Name">Energy</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Energy: Prestige Energy and Super Energy (DESIGN.md 6 rows pe and se). Small panels: the sheet hugs its content.

	    hero     the RATE chip under the CTA: "×16.00 per OoM of PP, ^1.00" (the game's two numbers, as sent, with the
	             short unit); the source line leaves the body
	    accent   a lightning bolt watermark in the header (three hue strokes)
	The upgrades keep the tier board (P.skin: Hide owned).
]]

local Client = script.Parent.Parent
local Core = Client:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local PanelF = Client:WaitForChild("Panel")
local Common = require(PanelF:WaitForChild("Skins"):WaitForChild("Common"))
local Signatures = require(script.Parent:WaitForChild("Signatures"))
local Kit = require(script.Parent:WaitForChild("Kit"))
local P = (require(script.Parent:WaitForChild("P")) :: any).P

local C = Theme.C

local function rateLine(h: string): boolean
	return string.find(h, "per OoM", 1, true) ~= nil
end

local function hero(f: Frame, store: any, ctx: any)
	local a = Kit.accent(f, "Energy")
	local line = Kit.line(store, rateLine)
	local plain = if line then Common.plain(line) else ""
	local per, res, pow = string.match(plain, "([%d%.,e%+]+) per OoM of (.-), then raised to a power of ([%d%.,e%+]+)")
	if per == nil or res == nil or pow == nil then
		Common.drop(a, "Rate")
		return
	end
	local unit = Signatures.unit(res)
	Kit.heroChip(a, f, "Rate", Common.caps("Rate", C.soft) .. "   " .. Common.num("×" .. per, "number", C.text)
		.. Common.run(Common.esc(" per OoM of " .. unit .. ", "), "small", C.soft) .. Common.num("^" .. pow, "number", C.text))
end

local function accent(sheet: Frame, ctx: any)
	local band = Kit.band(sheet)
	if band == nil then return end
	local a = Kit.accent(band, "Energy")
	local bolt = Common.get(a, "Bolt", "Frame") :: Frame
	bolt.Active = false
	bolt.BackgroundTransparency = 1
	bolt.AnchorPoint = Vector2.new(1, 0.5)
	bolt.Position = UDim2.new(1, -150, 0.5, 0)
	bolt.Size = UDim2.fromOffset(60, 80)
	local strokes = { { 34, 4, 24 }, { 30, 36, -62 }, { 26, 50, 24 } }
	for i, s in strokes do
		local b = Common.get(bolt, "S" .. i, "Frame") :: Frame
		b.Active = false
		b.AnchorPoint = Vector2.new(0.5, 0)
		b.Position = UDim2.fromOffset(s[1], s[2])
		b.Size = UDim2.fromOffset(9, 34)
		b.Rotation = s[3]
		b.BackgroundColor3 = Theme.lift(ctx.hue, 0.2)
		b.BackgroundTransparency = 0.82
		Common.corner(b, 4)
	end
end

local function sig(layer: string): any
	return {
		layers = { layer },
		hug = true,
		skin = P.skin,
		hero = hero,
		accent = accent,
		claims = ({ { match = { cn = "display-text" }, make = Kit.noteClaim(rateLine) } } :: { any }),
	}
end

return { sig("pe"), sig("se") }
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="159">
            <Properties>
              <string name="Name">Ex</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Ex: Exploration (DESIGN.md 6 row ex, 6.1 "ex").

	    hero       ZONE, AREA LIMITS and the next feature's spot as chips under the CTA (the game's line, as sent;
	               coordinates "(9;5)" read "9, 5")
	    accent     green cartography: a faint grid over the header band
	    Main       the EXPLORER: the zone map and the D-pad side by side (stacked on phones)
	               map    the ZoneMaps drawing as Frames (cell lines, border, axis numbers), CACHED by the svg's static
	                      content: when only the position or the goal moves, nothing is rebuilt; the green position gem
	                      hops (0.15 s Back Out), the goal is a gold diamond
	               D-pad  the 4 movement buyables as arrow keys around RESPEC POSITION: arrow + direction, the level badge
	                      ("→ 6"), the cost in a well (short unit; "Free" when the game says so); hold to repeat like every
	                      buyable, and the centre key fires the respec node's own action
	The map's display-text line leaves the body (the explorer draws it); the explainer stays a note.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Client = script.Parent.Parent
local Core = Client:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Motion = require(Core:WaitForChild("Motion"))
local PanelF = Client:WaitForChild("Panel")
local Common = require(PanelF:WaitForChild("Skins"):WaitForChild("Common"))
local Sections = require(PanelF:WaitForChild("Sections"))
local Signatures = require(script.Parent:WaitForChild("Signatures"))
local Kit = require(script.Parent:WaitForChild("Kit"))
local P = (require(script.Parent:WaitForChild("P")) :: any).P
local Shared = ReplicatedStorage:WaitForChild("MilestoneTree")
local Html = require(Shared:WaitForChild("Html"))
local ZoneMaps = require(Shared:WaitForChild("ZoneMaps")) :: any

local C = Theme.C
local HUE = Theme.hue("ex")

local function trim(s: string): string
	return (string.gsub(string.gsub(s, "^%s+", ""), "%s+$", ""))
end
local function isSvg(n: any): boolean
	return type(n) == "table" and type(n.h) == "string" and string.find(n.h, "<svg", 1, true) ~= nil
end

-- ------------------------------------------------------------------------------------------------------ the map
type Explorer = {
	ph: Frame,
	id: string,
	ctx: any,
	store: any,
	lastH: string?,
	lastKey: string?,
	builds: number,
	gemAt: Vector2?,
}

local current: any = nil -- the explorer on screen (the map line's claim wakes it)

local function scaleOf(): number
	return if Layout.mode == "COMPACT" then 0.9 else 1.25
end

-- the static part of a parsed svg (what the cache is keyed by) and its moving marks
local function split(svg: any): (string, { any }, { any })
	local axis: { any } = {}
	local marks: { any } = {}
	local seen: { [string]: boolean } = {}
	for _, t in svg.texts do
		local text = trim(tostring(t.text))
		local key = t.x .. "," .. t.y .. "," .. text
		if seen[key] then continue end
		seen[key] = true
		if string.find(text, "^%d+$") or text == "X" or text == "Y" then
			table.insert(axis, t)
		else
			table.insert(marks, t)
		end
	end
	local parts = { tostring(svg.bg), tostring(svg.w), tostring(svg.h) }
	for _, t in axis do table.insert(parts, t.x .. "," .. t.y .. "," .. t.text) end
	return table.concat(parts, "|"), axis, marks
end

local function lineColor(hex: string): Color3
	local h = string.lower(hex)
	if h == "ff0000" then return C.danger end
	if h == "26ff00" then return HUE end
	return Theme.mix(C.deep, HUE, 0.3)
end

local function buildStatic(canvas: Frame, svg: any, axis: { any }, k: number)
	local st = Common.get(canvas, "Static", "Frame") :: Frame
	for _, c in st:GetChildren() do c:Destroy() end
	st.Active = false
	st.BackgroundTransparency = 1
	st.Size = UDim2.fromScale(1, 1)
	local lines = if svg.bg then ZoneMaps[svg.bg] else nil
	if type(lines) == "table" then
		for i, ln in lines do
			local x1, y1, x2, y2, col, w = ln[1], ln[2], ln[3], ln[4], ln[5], ln[6]
			local f = Instance.new("Frame")
			f.Name = "L" .. i
			f.BorderSizePixel = 0
			f.Active = false
			f.BackgroundColor3 = lineColor(tostring(col))
			f.BackgroundTransparency = if string.lower(tostring(col)) == "262626" then 0.2 else 0
			local ww = math.max(2, w * k)
			f.Position = UDim2.fromOffset(math.min(x1, x2) * k - ww / 2, math.min(y1, y2) * k - ww / 2)
			f.Size = UDim2.fromOffset(math.abs(x2 - x1) * k + ww, math.abs(y2 - y1) * k + ww)
			f.Parent = st
		end
	end
	for i, t in axis do
		local l = Instance.new("TextLabel")
		l.Name = "A" .. i
		l.Active = false
		l.BackgroundTransparency = 1
		Common.text(l, "number", C.termDim)
		if t.text == "X" or t.text == "Y" then Common.text(l, "label", C.termLime) end
		l.AnchorPoint = Vector2.new(0, 1)
		l.Position = UDim2.fromOffset(t.x * k, (t.y + 3) * k)
		l.AutomaticSize = Enum.AutomaticSize.XY
		l.Size = UDim2.new()
		l.Text = t.text
		l.Parent = st
	end
end

-- a mark's centre in the svg (text baseline -> glyph centre)
local function centre(t: any): Vector2
	local size = tonumber(t.size) or 12
	return Vector2.new(t.x + 0.6 * size, t.y - 0.35 * size)
end

local function drawMap(self: any, parent: Instance, n: any)
	local compact = Layout.mode == "COMPACT"
	local k = scaleOf()
	local card = Common.get(parent, "Map", "Frame") :: Frame
	card.LayoutOrder = 1
	card.Active = false
	if n == nil then
		card.Visible = false
		return
	end
	card.Visible = true
	local h = n.h :: string
	if h == self.lastH and card:FindFirstChild("Canvas") then return end
	self.lastH = h
	local svg: any = nil
	for _, part in Html.split(h) do
		if type(part) == "table" then
			svg = part
			break
		end
	end
	if svg == nil then return end
	local key, axis, marks = split(svg)
	key ..= "|" .. tostring(k)
	card.BackgroundColor3 = Color3.fromRGB(5, 16, 9)
	card.BackgroundTransparency = 0
	card.Size = UDim2.fromOffset(math.floor(svg.w * k) + 24, math.floor(svg.h * k) + 48)
	Common.corner(card, 14)
	Common.stroke(card, 1.5, HUE, 0.45)
	local canvas = Common.get(card, "Canvas", "Frame") :: Frame
	canvas.Active = false
	canvas.BackgroundTransparency = 1
	canvas.Position = UDim2.fromOffset(12, 8)
	canvas.Size = UDim2.fromOffset(math.floor(svg.w * k), math.floor(svg.h * k))
	canvas.ClipsDescendants = true
	if key ~= self.lastKey then
		self.lastKey = key
		self.builds += 1
		card:SetAttribute("Builds", self.builds)
		buildStatic(canvas, svg, axis, k)
	end
	-- the moving marks: the position gem, the goal diamond, anything else (portals) as small discs
	local usedMarks: { [string]: boolean } = {}
	local others = 0
	for _, t in marks do
		local text = trim(tostring(t.text))
		local c = centre(t) * k
		local color = if t.color then Color3.fromHex(t.color) else C.text
		local isGoal = text == "★" or string.find(string.lower(tostring(t.color)), "ffff00", 1, true) ~= nil
		local isGem = not isGoal and (text == "🟢" or color.G > color.R + 0.2)
		if isGem then
			usedMarks.Gem = true
			local gem = Common.get(canvas, "Gem", "Frame") :: Frame
			gem.Active = false
			gem.ZIndex = 4
			gem.AnchorPoint = Vector2.new(0.5, 0.5)
			gem.Size = UDim2.fromOffset(18, 18)
			gem.BackgroundColor3 = Theme.lift(HUE, 0.2)
			gem.BackgroundTransparency = 0
			Common.corner(gem, 0.5)
			Common.stroke(gem, 2, C.white, 0)
			Common.glow(gem, HUE, 0.7, 12)
			local target = UDim2.fromOffset(c.X, c.Y)
			local prev = self.gemAt
			self.gemAt = c
			if prev and prev ~= c then
				Motion.tween(gem, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = target }, "ex:gem")
			else
				gem.Position = target
			end
		elseif isGoal then
			usedMarks.Goal = true
			local star = Common.get(canvas, "Goal", "Frame") :: Frame
			star.Active = false
			star.ZIndex = 3
			star.AnchorPoint = Vector2.new(0.5, 0.5)
			star.Rotation = 45
			star.Size = UDim2.fromOffset(15, 15)
			star.Position = UDim2.fromOffset(c.X, c.Y)
			star.BackgroundColor3 = C.gold
			star.BackgroundTransparency = 0
			Common.corner(star, 3)
			Common.glow(star, C.gold, 0.6, 12)
		elseif others < 6 then
			others += 1
			local name = "Mark" .. others
			usedMarks[name] = true
			local m = Common.get(canvas, name, "Frame") :: Frame
			m.Active = false
			m.ZIndex = 3
			m.AnchorPoint = Vector2.new(0.5, 0.5)
			m.Size = UDim2.fromOffset(14, 14)
			m.Position = UDim2.fromOffset(c.X, c.Y)
			m.BackgroundColor3 = Theme.lift(Theme.hue("mp"), 0.2)
			m.BackgroundTransparency = 0
			Common.corner(m, 0.5)
		end
	end
	for _, name in { "Gem", "Goal", "Mark1", "Mark2", "Mark3", "Mark4", "Mark5", "Mark6" } do
		if not usedMarks[name] then Common.drop(canvas, name) end
	end
	-- the legend under the drawing
	local legend = Common.get(card, "Legend", "TextLabel") :: TextLabel
	legend.Active = false
	Common.text(legend, "small", C.soft)
	legend.AnchorPoint = Vector2.new(0, 1)
	legend.Position = UDim2.new(0, 14, 1, -8)
	legend.Size = UDim2.new(1, -28, 0, 22)
	legend.TextXAlignment = Enum.TextXAlignment.Left
	legend.TextYAlignment = Enum.TextYAlignment.Center
	legend.TextWrapped = false
	Common.setText(legend, Common.run("•", "label", Theme.lift(HUE, 0.2)) .. Common.esc(" You are here     ")
		.. Common.run("•", "label", C.gold) .. Common.esc(if compact then " Feature" else " Next feature"))
end

-- ------------------------------------------------------------------------------------------------------ the D-pad
local DIRS: { [string]: { arrow: string, word: string, col: number, row: number } } = {
	["Increase X"] = { arrow = "→", word = "Right", col = 3, row = 2 },
	["Decrease X"] = { arrow = "←", word = "Left", col = 1, row = 2 },
	["Increase Y"] = { arrow = "↓", word = "Down", col = 2, row = 3 },
	["Decrease Y"] = { arrow = "↑", word = "Up", col = 2, row = 1 },
}

local function drawPad(self: any, parent: Instance)
	local st = self.store
	local ctx = self.ctx
	local compact = Layout.mode == "COMPACT"
	local kw, kh, gap = (if compact then 100 else 132), (if compact then 88 else 112), 10
	local pad = Common.get(parent, "Pad", "Frame") :: Frame
	pad.LayoutOrder = 2
	pad.Active = false
	pad.BackgroundTransparency = 1
	pad.Size = UDim2.fromOffset(3 * kw + 2 * gap, 3 * kh + 2 * gap)
	local buys = Kit.findAll(st, self.id, function(n: any): boolean
		return n.t == "btn" and n.k == "buy"
	end, 3)
	local respec = Kit.find(st, self.id, function(n: any): boolean
		return n.t == "btn" and n.k == "respec"
	end, 2)
	local used: { [string]: boolean } = {}
	local function place(g: GuiObject, col: number, row: number)
		g.Position = UDim2.fromOffset((col - 1) * (kw + gap), (row - 1) * (kh + gap))
		g.Size = UDim2.fromOffset(kw, kh)
	end
	for _, bid in buys do
		local n = st:get(bid)
		local ti = trim(Common.plain(Common.str(n.ti) or ""))
		local dir = DIRS[ti]
		if dir == nil then continue end
		local name = "Key" .. dir.word
		used[name] = true
		local can = n.cls == "can"
		local b = Common.get(pad, name, "TextButton") :: TextButton
		b.AutoButtonColor = false
		place(b, dir.col, dir.row)
		b.BackgroundColor3 = if can then Theme.mix(C.panel, HUE, 0.42) else Theme.mix(C.panel, C.locked, 0.22)
		b.BackgroundTransparency = 0
		Common.corner(b, 14)
		Common.stroke(b, if can then 2 else 1.5, if can then Theme.lift(HUE, 0.35) else C.locked, if can then 0 else 0.35)
		Common.glow(b, if can then HUE else nil, 0.45, 12)
		Common.pad(b, if compact then 12 else 16, 6, 0, 6)
		Common.text(b, "label", C.text)
		b.TextWrapped = false
		b.TextXAlignment = Enum.TextXAlignment.Center
		b.TextYAlignment = Enum.TextYAlignment.Top
		b.LineHeight = 1.15
		Common.setText(b, Common.run(dir.arrow, "cta", C.text) .. "\n" .. Common.run(Common.esc(dir.word), "label", C.text))
		-- the level badge and the cost well
		local lv = Common.str(n.lv) or "0"
		local badge = Common.chip(b, "Level", Common.run(dir.arrow, "label", C.soft) .. " " .. Common.num(lv, "badge", C.text),
			{ rich = true, bg = C.deep, bgT = 0.1, h = 24 })
		badge.AnchorPoint = Vector2.new(0, 0)
		badge.Position = UDim2.fromOffset(-2, if compact then -8 else -10)
		local plain = Common.plain(n.h or "")
		local cost: string
		if string.find(plain, "without a cost", 1, true) then
			cost = Common.run(Common.esc("Free"), "label", C.ownedValue)
		else
			local co = Common.str(n.co)
			local unitName = string.match(plain, "Cost:%s*%S+%s+(.-)%s*$")
			cost = if co then Common.num(co, "number", C.text, Signatures.unit(unitName)) else ""
		end
		if cost ~= "" then
			local well = Common.chip(b, "Cost", cost, { rich = true, bg = C.black, bgT = 0.45, h = 26 })
			well.AnchorPoint = Vector2.new(0.5, 1)
			well.Position = UDim2.new(0.5, 0, 1, -8)
		else
			Common.drop(b, "Cost")
		end
		Common.state(b, if can then "can" else "notyet")
		Kit.repeatPress(b, function(): any
			local x = self.store:get(bid)
			return if type(x) == "table" then x.a else nil
		end, ctx.act)
	end
	if respec then
		used.Respec = true
		local n = st:get(respec)
		local b = Common.get(pad, "Respec", "TextButton") :: TextButton
		b.AutoButtonColor = false
		place(b, 2, 2)
		b.BackgroundColor3 = Theme.mix(C.panel, C.danger, 0.3)
		b.BackgroundTransparency = 0
		Common.corner(b, 14)
		Common.stroke(b, 1.5, C.danger, 0.3)
		Common.drop(b, "Pad")
		Common.text(b, "label", C.text)
		b.TextWrapped = true
		b.TextXAlignment = Enum.TextXAlignment.Center
		b.TextYAlignment = Enum.TextYAlignment.Center
		local word = trim(Common.plain(n.h or "Respec position"))
		Common.setText(b, Common.run("R", "cta", C.text) .. "\n" .. Common.run(Common.esc(word), "small", C.dangerText))
		Common.state(b, if n.cls == "can" then "can" else "notyet")
		Kit.onPress(b, function()
			local x = self.store:get(respec)
			if type(x) == "table" and type(x.a) == "table" then ctx.act(x.a, false) end
		end)
	end
	for _, c in pad:GetChildren() do
		if c:IsA("GuiObject") and not used[c.Name] then c:Destroy() end
	end
end

-- the map's own node: the display-text sibling (or any node) of the tab holding an <svg>
local function svgNode(st: any): any?
	local sid = Kit.find(st, "tab", function(n: any): boolean
		return n.cn == "display-text" and isSvg(n)
	end, 4)
	return if sid then st:get(sid) else nil
end

local function explorer(ph: Frame, id: string, store: any, ctx: any): any
	local self: any = { ph = ph, id = id, ctx = ctx, store = store, lastH = nil, lastKey = nil, builds = 0, gemAt = nil }
	ph.Size = UDim2.new(1, 0, 0, 0)
	ph.AutomaticSize = Enum.AutomaticSize.Y
	Common.list(ph, false, 14)
	function self.update(_: any, st: any)
		self.store = st or self.store
		local compact = Layout.mode == "COMPACT"
		Sections.header(ph, { name = "Head", order = 0, text = "ZONE MAP", hue = HUE })
		local box = Common.get(ph, "Explorer", "Frame") :: Frame
		box.LayoutOrder = 1
		box.Active = false
		box.BackgroundTransparency = 1
		box.Size = UDim2.new(1, 0, 0, 0)
		box.AutomaticSize = Enum.AutomaticSize.Y
		Common.list(box, not compact, 24, { valign = Enum.VerticalAlignment.Top, align = if compact then Enum.HorizontalAlignment.Center else nil })
		local ok, err = Common.try(drawMap, self, box, svgNode(self.store))
		if not ok then warn("[MilestoneTree] ex map failed: " .. tostring(err)) end
		drawPad(self, box)
		current = self
	end
	function self.destroy(_: any)
		if current == self then current = nil end
		Common.drop(ph, "Explorer")
		Common.drop(ph, "Head")
	end
	return self
end

-- the display-text lines: the map's line is drawn by the explorer (it only wakes it); the others stay notes
local function note(ph: Frame, id: string, store: any, ctx: any): any
	local claim = {}
	function claim.update(_: any, st: any)
		local n = st:get(id)
		if isSvg(n) then
			ph.Visible = false
			ph.Size = UDim2.new()
			ph.AutomaticSize = Enum.AutomaticSize.None
			Common.drop(ph, "Text")
			local e = current
			if e and e.ph.Parent then e:update(st) end
			return
		end
		local text = if type(n) == "table" then Common.plain(n.h) else ""
		if not string.find(text, "%S") then
			ph.Visible = false
			ph.Size = UDim2.new()
			ph.AutomaticSize = Enum.AutomaticSize.None
			Common.drop(ph, "Text")
			return
		end
		ph.Visible = true
		ph.Size = UDim2.new(1, 0, 0, 0)
		ph.AutomaticSize = Enum.AutomaticSize.Y
		ph.BackgroundColor3 = C.panel2
		ph.BackgroundTransparency = 0
		Common.corner(ph, 10)
		Common.pad(ph, 10, 14, 10, 16)
		local l = Common.label(ph, "Text", "body", C.text)
		l.TextTransparency = 0.08
		Common.setText(l, Common.html(n.h, "body", ctx.layer))
	end
	function claim.destroy(_: any)
		Common.drop(ph, "Text")
	end
	return claim
end

-- ------------------------------------------------------------------------------------------------------ hero
local function hero(f: Frame, store: any, ctx: any)
	local a = Kit.accent(f, "Ex")
	if Layout.mode == "COMPACT" then
		for _, name in { "Zone", "Area", "Feature" } do Common.drop(a, name) end
		return
	end
	local text = ""
	local tid = Kit.find(store, "tab", function(n: any): boolean
		return n.cn == "display-text" and type(n.h) == "string" and string.find(n.h, "area limits", 1, true) ~= nil
	end, 4)
	if tid then text = Common.plain(store:get(tid).h) end
	local zone = string.match(text, "Current zone:%s*([%w%-]+)")
	local ax, ay = string.match(text, "X axis %-%s*([%d%.,]+),%s*Y axis %-%s*([%d%.,]+)")
	local fx, fy = string.match(text, "feature is at %((%d+);(%d+)%)")
	local chips: { { string } } = {}
	if zone then table.insert(chips, { "Zone", Common.caps("Zone", C.soft) .. "   " .. Common.run(Common.esc(zone), "label", C.text) }) end
	if ax and ay then
		table.insert(chips, { "Area", Common.caps("Area limits", C.soft) .. "   " .. Common.num(ax .. " × " .. ay, "number", C.text) })
	end
	if fx and fy then
		table.insert(chips, { "Feature", Common.caps("Next feature", C.soft) .. "   " .. Common.num(fx .. ", " .. fy, "number", C.gold) })
	end
	local cta = f:FindFirstChild("Cta") :: GuiObject?
	local stats = f:FindFirstChild("Stats") :: GuiObject?
	local y = (if cta then cta.Size.Y.Offset + 10 else 0) + (if stats and stats.Visible then 42 else 0)
	local row = Common.get(a, "Chips", "Frame") :: Frame
	row.Active = false
	row.AnchorPoint = Vector2.new(1, 0)
	row.Position = UDim2.new(1, 0, 0, y)
	row.Size = UDim2.fromOffset(0, 34)
	row.AutomaticSize = Enum.AutomaticSize.X
	Common.list(row, true, 8, { align = Enum.HorizontalAlignment.Right, valign = Enum.VerticalAlignment.Center })
	local used: { [string]: boolean } = {}
	for i, c in chips do
		used[c[1]] = true
		local chip = Common.chip(row, c[1], c[2], { rich = true, bg = C.panel2, bgT = 0, h = 34 })
		chip.LayoutOrder = i
	end
	for _, name in { "Zone", "Area", "Feature" } do
		if not used[name] then Common.drop(row, name) end
	end
end

-- green cartography: a faint grid over the header band
local function accent(sheet: Frame, ctx: any)
	local band = Kit.band(sheet)
	if band == nil then return end
	local a = Kit.accent(band, "Ex")
	Kit.stripes(a, Theme.lift(HUE, 0.2), 0.05, 22, 0, "GridV")
	Kit.stripes(a, Theme.lift(HUE, 0.2), 0.05, 22, 90, "GridH")
end

return {
	layers = { "ex" },
	skin = P.skin,
	hero = hero,
	accent = accent,
	claims = ({
		{ match = { cn = "buyables", sub = "Main" }, make = explorer },
		{ match = { cn = "display-text" }, make = note },
	} :: { any }),
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="160">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Kit: the small builders the per-layer signatures share (packages J1 / J2, plan 2.6). Not a signature itself: it
	returns no `layers`, so Signatures' auto-registration skips it.

	    Kit.live(ctx)                    the context of the running apply / refresh (claims keep the one they were made
	                                     with; the mode or widths may have changed since)
	    Kit.find(store, id, pred, d)     the first node id under id (depth <= d, tree order) whose node passes pred
	    Kit.onPress(button, fn, quiet?)  wires Activated once; fn is replaced on every call (read the node at press time);
	                                     plays the press sound unless quiet (a control that sounds its own feedback)
	    Kit.repeatPress(button, get, act) press + hold-to-repeat (0.25 s, then 20 a second while the pointer stays within
	                                     10 px and the list does not scroll), like Render's hold buttons
	    Kit.button(parent, name, text, o) a pill button whose own Text carries the RichText (2-3 instances)
	    Kit.card(parent, name, o)        a quiet panel2 card with a vertical list (corner, stroke, padding)
	    Kit.accent(parent, key)          the "Accent" holder a signature draws its accent / hero idea into; Panel and
	                                     Hero drop it when another layer opens, a different key clears it
	    Kit.stripes(parent, c, a)        diagonal stripes from a repeating gradient (needs TileMode; nothing otherwise)
	    Kit.watermark(parent, text, c)   a big faint display glyph ("M²") at the right of the header band
	    Kit.scrollTo(ctx, obj, margin)   scroll the body so obj sits near the top
	    Kit.h2(html)                     the texts of the game's <h2> runs (the numbers the game highlights, verbatim)

	Every action a signature fires is a node's own `a`, read from the store at press time, through ctx.act.
]]

local UserInputService = game:GetService("UserInputService")

local Client = script.Parent.Parent
local Core = Client:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Audio = require(Core:WaitForChild("Audio"))
local PanelF = Client:WaitForChild("Panel")
local Common = require(PanelF:WaitForChild("Skins"):WaitForChild("Common"))

local Kit = {}

local C = Theme.C

-- ------------------------------------------------------------------------------------------------------ context
function Kit.live(ctx: any): any
	local r = ctx.render
	local now = if r then r.ctxNow else nil
	return now or ctx
end
function Kit.compact(): boolean
	return Layout.mode == "COMPACT"
end

-- ------------------------------------------------------------------------------------------------------ the store
function Kit.find(store: any, id: string, pred: (n: any, id: string) -> boolean, maxDepth: number): string?
	local function walk(x: string, d: number): string?
		local n = store:get(x)
		if type(n) ~= "table" then return nil end
		if x ~= id and pred(n, x) then return x end
		if d >= maxDepth or type(n.c) ~= "table" then return nil end
		for _, cid in n.c do
			if type(cid) == "string" then
				local hit = walk(cid, d + 1)
				if hit then return hit end
			end
		end
		return nil
	end
	return walk(id, 0)
end
function Kit.findAll(store: any, id: string, pred: (n: any, id: string) -> boolean, maxDepth: number): { string }
	local out: { string } = {}
	local function walk(x: string, d: number)
		local n = store:get(x)
		if type(n) ~= "table" then return end
		if x ~= id and pred(n, x) then
			table.insert(out, x)
			return
		end
		if d >= maxDepth or type(n.c) ~= "table" then return end
		for _, cid in n.c do
			if type(cid) == "string" then walk(cid, d + 1) end
		end
	end
	walk(id, 0)
	return out
end
-- the tab's prestige-button node (the hero's CTA), nil when the tab has none
function Kit.resetNode(store: any): any?
	local pid = Kit.find(store, "tab", function(n: any): boolean
		return n.cn == "prestige-button"
	end, 4)
	return if pid then store:get(pid) else nil
end
-- the texts of the game's <h2> runs, in order ("You caused <h2>23</h2> corruptions" -> { "23" })
function Kit.h2(html: any): { string }
	local out: { string } = {}
	if type(html) ~= "string" then return out end
	for inner in string.gmatch(html, "<h2[^>]*>(.-)</h2>") do
		local t = Common.plain(inner)
		t = string.gsub(string.gsub(t, "^%s+", ""), "%s+$", "")
		table.insert(out, t)
	end
	-- an unterminated last run ("... fixed <h2 ...>18" at the end of the string)
	local tail = string.match(html, "<h2[^>]*>([^<]*)$")
	if tail then
		local t = string.gsub(string.gsub(tail, "^%s+", ""), "%s+$", "")
		if t ~= "" then table.insert(out, t) end
	end
	return out
end

-- ------------------------------------------------------------------------------------------------------ presses
local handlers: { [Instance]: () -> () } = setmetatable({}, { __mode = "k" }) :: any
local quietOnes: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any
function Kit.onPress(b: GuiButton, fn: () -> (), quiet: boolean?)
	handlers[b] = fn
	quietOnes[b] = quiet == true
	if b:GetAttribute("KitWired") == true then return end
	b:SetAttribute("KitWired", true)
	b.Activated:Connect(function()
		local f = handlers[b]
		if f and not quietOnes[b] then Audio.play("press") end
		if f then f() end
	end)
end

-- press, and hold to repeat (the buyable rule of DESIGN.md 3.4); get() returns the node's current action
local repeaters: { [Instance]: { get: () -> any?, act: (a: any, hold: boolean?) -> () } } = setmetatable({}, { __mode = "k" }) :: any
function Kit.repeatPress(b: GuiButton, get: () -> any?, act: (a: any, hold: boolean?) -> ())
	repeaters[b] = { get = get, act = act }
	if b:GetAttribute("KitRepeat") == true then return end
	b:SetAttribute("KitRepeat", true)
	local seq = 0
	local repeated = false
	local startX, startY, startCy = 0, 0, 0
	local touchIo: InputObject? = nil
	local function pointer(): (number, number)
		local io = touchIo
		if io then return io.Position.X, io.Position.Y end
		local m = UserInputService:GetMouseLocation()
		return m.X, m.Y
	end
	local function moved(): boolean
		local x, y = pointer()
		local sf = b:FindFirstAncestorWhichIsA("ScrollingFrame")
		local cy = if sf then sf.CanvasPosition.Y else 0
		return (x - startX) ^ 2 + (y - startY) ^ 2 > 100 or math.abs(cy - startCy) > 2
	end
	b.Activated:Connect(function()
		if repeated then
			repeated = false
			return
		end
		if touchIo and moved() then return end
		local r = repeaters[b]
		local a = if r then r.get() else nil
		if r and type(a) == "table" then
			Audio.play("press")
			r.act(a, false)
		end
	end)
	b.InputBegan:Connect(function(io: InputObject)
		local t = io.UserInputType
		if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
		seq += 1
		local mine = seq
		repeated = false
		touchIo = if t == Enum.UserInputType.Touch then io else nil
		startX, startY = pointer()
		local sf = b:FindFirstAncestorWhichIsA("ScrollingFrame")
		startCy = if sf then sf.CanvasPosition.Y else 0
		task.delay(0.25, function()
			while seq == mine and b.Parent ~= nil do
				if moved() then break end
				local r = repeaters[b]
				local a = if r then r.get() else nil
				if r == nil or type(a) ~= "table" then break end
				repeated = true
				r.act(a, true)
				task.wait(0.05)
			end
		end)
	end)
	b.InputEnded:Connect(function(io: InputObject)
		local t = io.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then seq += 1 end
	end)
	b.MouseLeave:Connect(function()
		seq += 1
	end)
end

-- ------------------------------------------------------------------------------------------------------ builders
export type ButtonOpts = { fill: Color3?, ink: Color3?, stroke: Color3?, strokeT: number?, h: number?, w: number?,
	order: number?, role: string?, radius: number?, align: Enum.TextXAlignment? }
-- a pill button: its own Text carries the (RichText-safe) text; sized from the text unless o.w is given
function Kit.button(parent: Instance, name: string, text: string, o: ButtonOpts?): TextButton
	local opts: ButtonOpts = o or ({} :: ButtonOpts)
	local b = Common.get(parent, name, "TextButton") :: TextButton
	b.AutoButtonColor = false
	Common.text(b, opts.role or "label", opts.ink or C.text)
	b.TextWrapped = false
	b.TextXAlignment = opts.align or Enum.TextXAlignment.Center
	b.TextYAlignment = Enum.TextYAlignment.Center
	b.BackgroundColor3 = opts.fill or C.panel3
	b.BackgroundTransparency = 0
	b.Selectable = true
	local h = opts.h or 40
	if opts.w then
		b.AutomaticSize = Enum.AutomaticSize.None
		b.Size = if opts.w <= 1 then UDim2.new(opts.w, 0, 0, h) else UDim2.fromOffset(opts.w, h)
	else
		b.AutomaticSize = Enum.AutomaticSize.X
		b.Size = UDim2.fromOffset(0, h)
	end
	if opts.order then b.LayoutOrder = opts.order end
	Common.corner(b, opts.radius or 10)
	if opts.stroke then
		Common.stroke(b, 1.5, opts.stroke, opts.strokeT or 0.2)
	else
		Common.drop(b, "Border")
	end
	-- side padding as spaces (a UIPadding per button costs an instance); left-aligned text gets one more
	local padText = if opts.align == Enum.TextXAlignment.Left then "   " else "  "
	Common.setText(b, padText .. text .. "  ")
	return b
end

export type CardOpts = { order: number?, gap: number?, pad: number?, fill: Color3?, stroke: Color3?, strokeT: number?,
	w: number?, radius: number? }
-- a quiet card: panel2 surface, 1 du rim, padding, a vertical list; auto height
function Kit.card(parent: Instance, name: string, o: CardOpts?): Frame
	local opts: CardOpts = o or ({} :: CardOpts)
	local f = Common.get(parent, name, "Frame") :: Frame
	f.Active = false
	f.BackgroundColor3 = opts.fill or C.panel2
	f.BackgroundTransparency = 0
	f.AutomaticSize = Enum.AutomaticSize.Y
	f.Size = if opts.w then UDim2.fromOffset(opts.w, 0) else UDim2.new(1, 0, 0, 0)
	if opts.order then f.LayoutOrder = opts.order end
	Common.corner(f, opts.radius or 14)
	Common.stroke(f, 1, opts.stroke or C.stroke, opts.strokeT or 0.2)
	local p = opts.pad or 14
	Common.pad(f, p, p + 2, p, p + 2)
	Common.list(f, false, opts.gap or 8)
	return f
end

-- a frame with a list layout and no surface (rows, columns)
function Kit.stack(parent: Instance, name: string, horizontal: boolean, gap: number, order: number?): Frame
	local f = Common.get(parent, name, "Frame") :: Frame
	f.Active = false
	f.BackgroundTransparency = 1
	f.AutomaticSize = Enum.AutomaticSize.Y
	f.Size = UDim2.new(1, 0, 0, 0)
	if order then f.LayoutOrder = order end
	Common.list(f, horizontal, gap, { valign = if horizontal then Enum.VerticalAlignment.Center else nil })
	return f
end

-- a control at the right end of a section title row (Sections.header): the hairline flexes to leave it room
-- (UIFlexItem); without flex items it follows the chips
function Kit.headerControl(header: Instance, name: string, text: string, w: number, o: ButtonOpts?): TextButton
	local rule = header:FindFirstChild("Rule")
	local flex = false
	if rule then
		flex = pcall(function()
			local f = Common.get(rule, "Flex", "UIFlexItem") :: any
			f.FlexMode = Enum.UIFlexMode.Fill
		end)
	end
	local opts: ButtonOpts = table.clone(o or ({} :: ButtonOpts))
	opts.w = w
	opts.h = opts.h or 30
	opts.order = if flex then 20 else 5
	local b = Kit.button(header, name, text, opts)
	return b
end

-- ------------------------------------------------------------------------------------------------------ accents
-- the holder a signature draws its accent into (the sheet, the header band or the hero); a new key clears it
function Kit.accent(parent: Instance, key: string): Frame
	local f = Common.get(parent, "Accent", "Frame") :: Frame
	if f:GetAttribute("Sig") ~= key then
		for _, c in f:GetChildren() do c:Destroy() end
		f:SetAttribute("Sig", key)
	end
	f.Active = false
	f.BackgroundTransparency = 1
	f.Size = UDim2.fromScale(1, 1)
	f.Position = UDim2.new()
	f.ClipsDescendants = false
	return f
end

-- a decoration that must sit outside an accent holder (inside a reused button, say) goes when the accent's content
-- goes: a guard object in the holder destroys it
function Kit.tether(holder: Instance, name: string, obj: Instance)
	local guard = holder:FindFirstChild(name)
	if guard and guard:GetAttribute("For") == obj:GetFullName() then return end
	if guard then guard:Destroy() end
	local g = Instance.new("Folder")
	g.Name = name
	g:SetAttribute("For", obj:GetFullName())
	g.Destroying:Connect(function()
		if obj.Parent then obj:Destroy() end
	end)
	g.Parent = holder
end

-- diagonal stripes (R9 without a texture): a repeating gradient; nothing without TileMode
function Kit.stripes(parent: Instance, color: Color3, alpha: number, radius: number?, rotation: number?, name: string?): Frame?
	local key = name or "Stripes"
	if not Theme.caps.TileMode then
		Common.drop(parent, key)
		return nil
	end
	local f = Common.get(parent, key, "Frame") :: Frame
	f.Active = false
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = color
	f.BackgroundTransparency = 0
	if radius then Common.corner(f, radius) end
	local g = Common.get(f, "Tile", "UIGradient") :: UIGradient
	g.Rotation = rotation or 45
	pcall(function()
		g.TileMode = Enum.GradientTileMode.Repeat
		g.Scale = 0.035
	end)
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1 - alpha),
		NumberSequenceKeypoint.new(0.45, 1 - alpha),
		NumberSequenceKeypoint.new(0.46, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	return f
end

-- a big faint display glyph at the right of a header band ("M²", "⚡")
function Kit.watermark(parent: Instance, text: string, color: Color3, alpha: number?): TextLabel
	local l = Common.get(parent, "Watermark", "TextLabel") :: TextLabel
	l.Active = false
	l.AnchorPoint = Vector2.new(1, 0.5)
	l.Position = UDim2.new(1, -140, 0.5, 4)
	l.Size = UDim2.fromOffset(240, 110)
	l.FontFace = Theme.font("title")
	l.TextSize = Theme.size("title") * 2 -- a display decoration (DESIGN.md 9.2 "other display sizes"), never read
	l.TextColor3 = color
	l.TextTransparency = 1 - (alpha or 0.07)
	l.TextXAlignment = Enum.TextXAlignment.Right
	l.TextYAlignment = Enum.TextYAlignment.Center
	l.TextWrapped = false
	l.Text = text
	return l
end

-- the sheet's header band (the accent's usual home)
function Kit.band(sheet: Instance): Frame?
	local b = sheet:FindFirstChild("HeaderBand")
	return if b and b:IsA("Frame") then b else nil
end

-- ------------------------------------------------------------------------------------------------------ hero parts
-- a stat chip under the CTA and the default stat chips (WIDE); index stacks several (1, 2, ...)
function Kit.heroChip(holder: Instance, hero: Frame, name: string, text: string, index: number?): TextLabel?
	if Layout.mode == "COMPACT" then
		Common.drop(holder, name)
		return nil
	end
	local cta = hero:FindFirstChild("Cta") :: GuiObject?
	local stats = hero:FindFirstChild("Stats") :: GuiObject?
	local y = (if cta then cta.Size.Y.Offset + 10 else 0) + (if stats and stats.Visible then 42 else 0) + ((index or 1) - 1) * 42
	local chip = Common.chip(holder, name, text, { rich = true, bg = C.panel2, bgT = 0, h = 34 })
	chip.AnchorPoint = Vector2.new(1, 0)
	chip.Position = UDim2.new(1, 0, 0, y)
	return chip
end

-- the free slot between the resource block and the CTA (WIDE): a holder for a badge / scope; nil on phones
function Kit.heroSlot(holder: Instance, name: string, w: number, h: number): Frame?
	if Layout.mode == "COMPACT" then
		Common.drop(holder, name)
		return nil
	end
	local f = Common.get(holder, name, "Frame") :: Frame
	f.Active = false
	f.BackgroundTransparency = 1
	f.AnchorPoint = Vector2.new(1, 0)
	f.Position = UDim2.new(1, -424, 0, 6)
	f.Size = UDim2.fromOffset(w, h)
	return f
end

-- a claim for display-text lines: the ones `hide` picks leave the body (a signature shows them elsewhere); the
-- others stay NOTES rows (the Skins/Generic look)
function Kit.noteClaim(hide: (h: string) -> boolean): (ph: Frame, id: string, store: any, ctx: any) -> any
	return function(ph: Frame, id: string, store: any, ctx: any): any
		local claim = {}
		function claim.update(_: any, st: any)
			local n = st:get(id)
			local h = if type(n) == "table" and type(n.h) == "string" then n.h else ""
			if hide(h) or not string.find(Common.plain(h), "%S") then
				ph.Visible = false
				ph.Size = UDim2.new()
				ph.AutomaticSize = Enum.AutomaticSize.None
				Common.drop(ph, "Text")
				return
			end
			ph.Visible = true
			ph.Size = UDim2.new(1, 0, 0, 0)
			ph.AutomaticSize = Enum.AutomaticSize.Y
			ph.BackgroundColor3 = C.panel2
			ph.BackgroundTransparency = 0
			Common.corner(ph, 10)
			Common.pad(ph, 10, 14, 10, 16)
			local l = Common.label(ph, "Text", "body", C.text)
			l.TextTransparency = 0.08
			Common.setText(l, Common.html(h, "body", ctx.layer))
		end
		function claim.destroy(_: any)
			Common.drop(ph, "Text")
		end
		return claim
	end
end

-- the first display-text of the tab whose html passes pred, and its html
function Kit.line(store: any, pred: (h: string) -> boolean): string?
	local id = Kit.find(store, "tab", function(n: any): boolean
		return n.cn == "display-text" and type(n.h) == "string" and pred(n.h)
	end, 4)
	return if id then store:get(id).h else nil
end

-- ------------------------------------------------------------------------------------------------------ scrolling
function Kit.scrollTo(ctx: any, obj: GuiObject?, margin: number?)
	local sf = ctx.scroll :: ScrollingFrame?
	if sf == nil or obj == nil then return end
	local s = math.max(Layout.s, 0.01)
	local dy = ((obj :: GuiObject).AbsolutePosition.Y - (sf :: ScrollingFrame).AbsolutePosition.Y) / s
	local y = math.max(0, (sf :: ScrollingFrame).CanvasPosition.Y + dy - (margin or 12))
	;(sf :: ScrollingFrame).CanvasPosition = Vector2.new(0, y)
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="161">
            <Properties>
              <string name="Name">M</string>
              <string name="Source"><![CDATA[--!strict
--[[
	M: the milestone ladders of m, mm, em, cm and pm (DESIGN.md 6 rows m / mm / em / cm, 6.1 "m / mm / em ladder").

	The layer's `milestones` component is claimed and drawn as a ladder on a glowing spine:
	    NEXT       the spotlight card (Ø78 number disc, NEXT MILESTONE, title, effect) with REQUIRES: the need, the unit
	               and the pr bar of the tab's own prestige button (refreshed through the hero hook, which runs whenever
	               the button changes)
	    done       the 4 newest done rows (quiet green: title, then the effect on its own line; infected rows get a
	               danger rim and the malware effect split at the game's <hr>)
	    folds      the older done rows in decade folds ("151 – 160", the count, the decade's first unlock line as sent);
	               a tap opens one decade; the rest folds into "1 – N  SHOW ALL"
	    SHOW ALL   every row in a virtualised pool (Panel/Virtual; the pool is the viewport + 2 rows)
	WIDE adds a right column: NOTES (the tab's display-text lines, claimed and moved here), JUMP TO (NEXT, 25-row blocks,
	MALWARE) and an "Order" button that opens Options (the map's own `opt` action). COMPACT keeps one column with the
	notes on top. m's MALWARE section lists every row that has an INFECT button (the malware node's own action).
	The game's Milestone Showing Mode and Order decide which rows arrive and in which order; the ladder keeps that order
	(newest first reads top-down from NEXT, oldest first is the same ladder upside down).
]]

local Client = script.Parent.Parent
local Core = Client:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Rich = require(Core:WaitForChild("Rich"))
local Motion = require(Core:WaitForChild("Motion"))
local Layout = require(Core:WaitForChild("Layout"))
local Recipes = require(Core:WaitForChild("Recipes"))
local PanelF = Client:WaitForChild("Panel")
local Common = require(PanelF:WaitForChild("Skins"):WaitForChild("Common"))
local Sections = require(PanelF:WaitForChild("Sections"))
local Virtual = require(PanelF:WaitForChild("Virtual"))
local Signatures = require(script.Parent:WaitForChild("Signatures"))
local Kit = require(script.Parent:WaitForChild("Kit"))

local C = Theme.C

-- session memory per layer: SHOW ALL, and the open decade fold
local showAll: { [string]: boolean } = {}
local openFold: { [string]: number } = {}

type Row = { id: string, n: any, num: number }
type Entry = { kind: string, key: string, row: Row?, lo: number?, hi: number?, count: number?, fact: string?, fold: number? }

-- ------------------------------------------------------------------------------------------------------ data
local function numOf(n: any, i: number): number
	local v = tonumber(n.id)
	return if v then v + 1 else i
end

local function collect(store: any, id: string): ({ Row }, number?)
	local rows: { Row } = {}
	local ids = Kit.findAll(store, id, function(n: any): boolean
		return n.t == "ms"
	end, 2)
	for i, cid in ids do
		local n = store:get(cid)
		table.insert(rows, { id = cid, n = n, num = numOf(n, i) })
	end
	local nextIdx: number? = nil
	for i, r in rows do
		if not r.n.done then
			nextIdx = i
			break
		end
	end
	return rows, nextIdx
end

-- the first line of a decade that unlocks something (as sent), else nil
local function factOf(rows: { Row }): string?
	for _, r in rows do
		local t = Common.plain(Common.str(r.n.ds) or "")
		t = string.gsub(string.gsub(t, "^%s+", ""), "%s+$", "")
		if string.find(string.lower(t), "^unlock") then
			t = string.gsub(t, "\n.*$", "")
			return t
		end
	end
	return nil
end

-- the collapsed ladder (newest-first semantics; reversed for oldest-first)
local function entries(rows: { Row }, nextIdx: number?, layer: string): ({ Entry }, boolean)
	local out: { Entry } = {}
	local newestFirst = #rows < 2 or rows[1].num > rows[#rows].num
	local byNum = table.clone(rows)
	table.sort(byNum, function(a: Row, b: Row): boolean
		return a.num > b.num
	end)
	local nextRow = if nextIdx then rows[nextIdx] else nil
	-- future rows past NEXT: the two nearest, faint
	if nextRow then
		local ahead: { Row } = {}
		for _, r in byNum do
			if not r.n.done and r ~= nextRow then table.insert(ahead, r) end
		end
		for i = math.max(1, #ahead - 1), #ahead do
			local r = ahead[i]
			if r then table.insert(out, { kind = "future", key = "U" .. r.num, row = r }) end
		end
		table.insert(out, { kind = "next", key = "Next", row = nextRow })
	end
	local done: { Row } = {}
	for _, r in byNum do
		if r.n.done then table.insert(done, r) end
	end
	for i = 1, math.min(4, #done) do
		table.insert(out, { kind = "done", key = "D" .. done[i].num, row = done[i] })
	end
	-- decade folds for the rest: the first three decades, then everything older in one fold
	local rest: { Row } = {}
	for i = 5, #done do table.insert(rest, done[i]) end
	local decades = 0
	local i = 1
	while i <= #rest do
		local dec = (rest[i].num - 1) // 10
		local group: { Row } = {}
		while i <= #rest and (rest[i].num - 1) // 10 == dec do
			table.insert(group, rest[i])
			i += 1
		end
		decades += 1
		if decades > 3 then
			-- the remaining rows (this group and older) in one fold
			local count = #group + (#rest - i + 1)
			local lo = rest[#rest].num
			table.insert(out, { kind = "rest", key = "Rest", lo = lo, hi = group[1].num, count = count })
			break
		end
		local open = openFold[layer] == dec
		table.insert(out, { kind = "fold", key = "F" .. dec, lo = group[#group].num, hi = group[1].num, count = #group,
			fact = factOf(group), fold = dec })
		if open then
			for _, r in group do table.insert(out, { kind = "done", key = "D" .. r.num, row = r }) end
		end
	end
	if not newestFirst then
		local rev: { Entry } = {}
		for k = #out, 1, -1 do table.insert(rev, out[k]) end
		out = rev
	end
	return out, newestFirst
end

-- ------------------------------------------------------------------------------------------------------ row looks
local function dims(): (number, number)
	-- the number gutter, and the NEXT disc
	if Layout.mode == "COMPACT" then return 56, 46 end
	return 92, 78
end

-- NEXT keeps REQUIRES in its own right-hand block only when the card is wide enough (WIDE); else inline
local function narrow(ctx: any): boolean
	return Layout.mode == "COMPACT" or (Kit.live(ctx).contentW or 0) < 1000
end

-- the effect text of a row (the infected split at the game's <hr>)
local function effect(n: any, role: string, layer: string, color: Color3, t: number): string
	local ds = Common.str(n.ds) or ""
	if n.mal and string.find(ds, "<hr", 1, true) then
		local a, b = string.match(ds, "^(.-)<hr[^>]*>(.*)$")
		if a and b then
			local base = Common.html(a, role, layer)
			local mal = Common.html(b, role, layer)
			local parts: { string } = {}
			if base ~= "" then table.insert(parts, string.format('<font color="%s" transparency="%.2f">%s</font>', Common.hex(color), t, base)) end
			if mal ~= "" then table.insert(parts, string.format('<font color="%s">%s</font>', Common.hex(Theme.lift(C.danger, 0.35)), mal)) end
			return table.concat(parts, "\n")
		end
	end
	local body = Common.html(ds, role, layer)
	if body == "" then return "" end
	return string.format('<font color="%s" transparency="%.2f">%s</font>', Common.hex(color), t, body)
end

-- the number pill in the gutter (a child of the card, stepped back out of its padding). NEXT is a glowing radial disc
-- (a Frame: a gradient on a TextLabel would tint its text too) with the number on it; done / future are small pills.
local function pill(card: GuiObject, kind: string, num: number, hue: Color3, padL: number, top: number?)
	local gutter, disc = dims()
	local cx = -padL - gutter / 2
	if kind == "next" then
		Common.drop(card, "Pill")
		local d = Common.get(card, "Disc", "Frame") :: Frame
		d.Active = false
		d.ZIndex = 5
		d.AnchorPoint = Vector2.new(0.5, 0)
		d.Size = UDim2.fromOffset(disc, disc)
		d.Position = UDim2.new(0, cx, 0, top or -6)
		Common.corner(d, 0.5)
		Recipes.radial(d, { { t = 0, c = Theme.lift(hue, 0.55) }, { t = 0.5, c = hue }, { t = 1, c = Theme.shade(hue, 0.5) } })
		Common.corner(d, 0.5)
		Common.stroke(d, 3, Theme.lift(hue, 0.55), 0)
		Common.glow(d, hue, 0.6, 16)
		local t = Common.get(d, "Num", "TextLabel") :: TextLabel
		t.Active = false
		t.ZIndex = 6
		t.Size = UDim2.fromScale(1, 1)
		Common.text(t, "index", C.text)
		t.TextXAlignment = Enum.TextXAlignment.Center
		t.TextYAlignment = Enum.TextYAlignment.Center
		t.TextWrapped = false
		local st = Common.stroke(t, 2, C.black, 0, "Stroke")
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		Common.setText(t, tostring(num))
		return
	end
	Common.drop(card, "Disc")
	local p = Common.get(card, "Pill", "TextLabel") :: TextLabel
	p.Active = false
	p.ZIndex = 5
	p.TextXAlignment = Enum.TextXAlignment.Center
	p.TextYAlignment = Enum.TextYAlignment.Center
	p.TextWrapped = false
	p.AnchorPoint = Vector2.new(0.5, 0)
	Common.text(p, "badge", if kind == "done" then C.ownedValue else C.soft)
	p.Size = UDim2.fromOffset(if Layout.mode == "COMPACT" then 40 else 48, 28)
	p.Position = UDim2.new(0, cx, 0, top or 2)
	p.BackgroundColor3 = if kind == "done" then Theme.mix(C.deep, C.bought, 0.22) else C.panel2
	p.BackgroundTransparency = 0
	Common.corner(p, 14)
	Common.stroke(p, 1.5, if kind == "done" then C.bought else C.stroke, if kind == "done" then 0.25 else 0)
	Common.setText(p, tostring(num))
end

-- a quiet row card (done / future): one TextLabel is the card
local function rowCard(parent: Instance, e: Entry, ctx: any, order: number): TextLabel
	local r = e.row :: Row
	local n = r.n
	local done = e.kind == "done"
	local c = Common.get(parent, e.key, "TextLabel") :: TextLabel
	c.LayoutOrder = order
	c.Active = false
	Common.text(c, "small", C.text)
	c.TextWrapped = true
	c.TextXAlignment = Enum.TextXAlignment.Left
	c.TextYAlignment = Enum.TextYAlignment.Top
	c.Size = UDim2.new(1, 0, 0, 0)
	c.AutomaticSize = Enum.AutomaticSize.Y
	Common.drop(c, "Fill")
	c.BackgroundColor3 = if done then Theme.mix(C.panel, C.bought, 0.14) else C.panel2
	c.BackgroundTransparency = 0
	Common.corner(c, 12)
	if n.mal then
		Common.stroke(c, 2, C.danger, 0.1)
	else
		Common.stroke(c, 1, if done then C.bought else C.stroke, if done then 0.6 else 0.3)
	end
	local compact = Layout.mode == "COMPACT"
	local padL = if compact then 12 else 16
	Common.pad(c, 9, 14, 10, padL)
	local title = Common.plain(Common.str(n.ti) or "")
	local parts = { Common.title(title, "cardSmall", if done then C.ownedTitle else C.text) }
	local eff = effect(n, "small", ctx.layer, if done then C.text else C.soft, if done then 0.18 else 0.05)
	if eff ~= "" then table.insert(parts, eff) end
	Common.setText(c, table.concat(parts, "\n"))
	pill(c, e.kind, r.num, ctx.hue, padL)
	Common.state(c, if done then "owned" else "notyet")
	return c
end

-- ------------------------------------------------------------------------------------------------------ the claim
local Ladder = {}
Ladder.__index = Ladder

type LadderT = {
	ph: Frame,
	id: string,
	ctx: any,
	layer: string,
	store: any,
	root: Frame,
	left: Frame,
	rows: Frame,
	side: Frame?,
	virtual: any?,
	conns: { RBXScriptConnection },
	nextId: string?,
	data: { Row },
	nextIdx: number?,
	newestFirst: boolean,
}

local current: any = nil -- the ladder on screen (the hero hook refreshes its REQUIRES block)

-- the NEXT spotlight card
local function nextCard(self: any, parent: Instance, e: Entry, order: number): TextLabel
	local ctx = self.ctx
	local r = e.row :: Row
	local n = r.n
	local compact = Layout.mode == "COMPACT"
	local hue = ctx.hue :: Color3
	local c = Common.get(parent, "Next", "TextLabel") :: TextLabel
	c.LayoutOrder = order
	c.Active = false
	Common.text(c, "body", C.text)
	c.TextWrapped = true
	c.TextXAlignment = Enum.TextXAlignment.Left
	c.TextYAlignment = Enum.TextYAlignment.Top
	c.Size = UDim2.new(1, 0, 0, 0)
	c.AutomaticSize = Enum.AutomaticSize.Y
	Common.drop(c, "Fill")
	c.BackgroundColor3 = Theme.mix(C.panel, hue, 0.34)
	c.BackgroundTransparency = 0
	Common.corner(c, 16)
	Common.stroke(c, 2, if n.mal then C.danger else Theme.lift(hue, 0.35), 0)
	Common.glow(c, hue, 0.45, 18)
	local padL = if compact then 14 else 20
	local isNarrow = narrow(ctx)
	c:SetAttribute("Narrow", isNarrow)
	local reqW = if isNarrow then 0 else 230
	Common.pad(c, 14, 18 + reqW, 14, padL)
	local title = Common.plain(Common.str(n.ti) or "")
	local parts = { Common.caps("Next milestone", C.text), Common.title(title, "card", C.text) }
	local eff = effect(n, "body", ctx.layer, C.text, 0.08)
	if eff ~= "" then table.insert(parts, eff) end
	c:SetAttribute("Base", table.concat(parts, "\n"))
	pill(c, "next", r.num, hue, padL, if compact then -4 else -6)
	Common.state(c, "can")
	self:drawReq(c)
	return c
end

function Ladder.drawReq(self: any, card: TextLabel?)
	local c = card or (self.rows:FindFirstChild("Next") :: TextLabel?)
	if c == nil then return end
	local compact = c:GetAttribute("Narrow") == true
	local pb = Kit.resetNode(self.store)
	local base = c:GetAttribute("Base")
	local text = if type(base) == "string" then base else ""
	local need = if pb then Common.str(pb.next) else nil
	local unit = if pb then Common.plain(Common.str(pb.bres) or "") else ""
	local can = pb ~= nil and pb.cls == "can"
	local pr = if can then 1 elseif pb then Common.pr(pb.pr) else nil
	if compact or need == nil then
		Common.drop(c, "Req")
		Common.drop(c, "Bar")
		Common.drop(c, "Pct")
		if need then
			text ..= "\n" .. Common.caps("Requires", C.text) .. "  " .. Common.num(Rich.short(need), "number", C.text, unit)
			if pr then text ..= "   " .. Common.num(Rich.pct(pr), "number", C.text) end
		end
		Common.setText(c, text)
		return
	end
	Common.setText(c, text)
	local req = Common.get(c, "Req", "TextLabel") :: TextLabel
	req.Active = false
	Common.text(req, "numberHeavy", C.text)
	req.RichText = true
	req.LineHeight = 1.25
	req.AnchorPoint = Vector2.new(1, 0)
	req.Position = UDim2.new(1, 230, 0, 0)
	req.Size = UDim2.fromOffset(214, 48)
	req.TextXAlignment = Enum.TextXAlignment.Right
	req.TextYAlignment = Enum.TextYAlignment.Top
	req.TextWrapped = true
	Common.setText(req, Common.caps("Requires", C.text) .. "\n" .. Common.num(need :: string, "numberHeavy", C.text, unit))
	if pr then
		local bar = Common.bar(c, "Bar", pr, Theme.lift(self.ctx.hue, 0.35), 6)
		bar.AnchorPoint = Vector2.new(1, 0)
		bar.Position = UDim2.new(1, 230 - 60, 0, 60)
		bar.Size = UDim2.fromOffset(150, 6)
		local pct = Common.get(c, "Pct", "TextLabel") :: TextLabel
		pct.Active = false
		Common.text(pct, "number", C.text)
		pct.AnchorPoint = Vector2.new(1, 0)
		pct.Position = UDim2.new(1, 230, 0, 52)
		pct.Size = UDim2.fromOffset(52, 22)
		pct.TextXAlignment = Enum.TextXAlignment.Right
		pct.TextYAlignment = Enum.TextYAlignment.Center
		Common.setText(pct, Common.esc(Rich.pct(pr)))
	else
		Common.drop(c, "Bar")
		Common.drop(c, "Pct")
	end
end

-- a decade fold / the rest fold: one button
local function foldRow(self: any, parent: Instance, e: Entry, order: number): TextButton
	local ctx = self.ctx
	local compact = Layout.mode == "COMPACT"
	local b = Common.get(parent, e.key, "TextButton") :: TextButton
	b.LayoutOrder = order
	b.AutoButtonColor = false
	Common.text(b, "small", C.soft)
	b.TextWrapped = false
	b.TextTruncate = Enum.TextTruncate.AtEnd
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.TextYAlignment = Enum.TextYAlignment.Center
	b.Size = UDim2.new(1, 0, 0, if compact then 44 else 48)
	b.AutomaticSize = Enum.AutomaticSize.None
	b.BackgroundColor3 = C.panel
	b.BackgroundTransparency = 0
	Common.corner(b, 12)
	local s = Common.stroke(b, 1, C.strokeHi, 0.2)
	Recipes.dashed(s, { color = C.strokeHi, alpha = 0.8 })
	local padL = if compact then 12 else 16
	Common.pad(b, 0, 14, 0, padL)
	local open = e.kind == "fold" and openFold[ctx.layer] == e.fold
	local chev = Common.run(if open then "–" else "›", "label", Theme.lift(ctx.hue, 0.45))
	local range = Common.num((e.lo :: number) .. " – " .. (e.hi :: number), "number", C.text)
	local count = Common.run(tostring(e.count), "badge", C.ownedValue)
	local text = chev .. "   " .. range .. "   " .. count
	if e.kind == "rest" then
		text ..= "      " .. Common.run(Common.esc("Show all"), "label", Theme.lift(ctx.hue, 0.45))
	elseif e.fact and not compact then
		text ..= "    " .. Common.esc(e.fact :: string)
	end
	Common.setText(b, text)
	-- the dot on the spine
	local gutter = (dims())
	local dot = Common.get(b, "Dot", "Frame") :: Frame
	dot.Active = false
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.new(0, -padL - gutter / 2, 0.5, 0)
	dot.Size = UDim2.fromOffset(10, 10)
	dot.BackgroundColor3 = C.bought
	dot.BackgroundTransparency = 0.2
	dot.ZIndex = 5
	Common.corner(dot, 0.5)
	Common.state(b, "owned")
	local layer = ctx.layer
	Kit.onPress(b, function()
		if e.kind == "rest" then
			showAll[layer] = true
		elseif openFold[layer] == e.fold then
			openFold[layer] = nil
		else
			openFold[layer] = e.fold :: number
		end
		self:draw()
	end)
	return b
end

function Ladder.new(ph: Frame, id: string, store: any, ctx: any): any
	local self = setmetatable({
		ph = ph,
		id = id,
		ctx = ctx,
		layer = ctx.layer,
		store = store,
		virtual = nil,
		conns = {},
		nextId = nil,
		data = {},
		nextIdx = nil,
		newestFirst = true,
	}, Ladder) :: any
	ph.Size = UDim2.new(1, 0, 0, 0)
	ph.AutomaticSize = Enum.AutomaticSize.Y
	ph.BackgroundTransparency = 1
	Common.list(ph, false, if Layout.mode == "COMPACT" then 10 else 14)
	current = self
	return self
end

-- the body: [left: spine + rows] [side] (WIDE) or one column (COMPACT)
function Ladder.frame(self: any)
	local compact = Layout.mode == "COMPACT"
	local ph = self.ph
	local body = Common.get(ph, "Body", "Frame") :: Frame
	body.LayoutOrder = 2
	body.Active = false
	body.Size = UDim2.new(1, 0, 0, 0)
	body.AutomaticSize = Enum.AutomaticSize.Y
	Common.list(body, true, 22, { valign = Enum.VerticalAlignment.Top })
	local sideW = if compact then 0 else 290
	local left = Common.get(body, "Left", "Frame") :: Frame
	left.LayoutOrder = 1
	left.Active = false
	left.AutomaticSize = Enum.AutomaticSize.None
	left.ClipsDescendants = true
	local rows = Common.get(left, "Rows", "Frame") :: Frame
	rows.Active = false
	rows.ZIndex = 2
	rows.Size = UDim2.new(1, 0, 0, 0)
	rows.AutomaticSize = Enum.AutomaticSize.Y
	local gutter = (dims())
	Common.list(rows, false, 10)
	Common.pad(rows, 8, 0, 8, gutter)
	-- the left column follows the rows' height (no automatic size, so the spine can use Scale)
	self.sideW = sideW
	local function fit()
		local s = math.max(Layout.s, 0.01)
		local sw = self.sideW :: number
		left.Size = UDim2.new(1, -(sw + (if sw > 0 then 22 else 0)), 0, math.ceil(rows.AbsoluteSize.Y / s))
	end
	if #self.conns == 0 then
		table.insert(self.conns, rows:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit))
	end
	fit()
	-- the spine: behind the rows, glowing in the hue
	local spine = Common.get(left, "Spine", "Frame") :: Frame
	spine.Active = false
	spine.ZIndex = 1
	spine.AnchorPoint = Vector2.new(0.5, 0)
	spine.Position = UDim2.fromOffset(gutter / 2, 30)
	spine.Size = UDim2.new(0, 3, 1, -50)
	spine.BackgroundColor3 = self.ctx.hue
	spine.BackgroundTransparency = 0
	local sg = Common.get(spine, "Fade", "UIGradient") :: UIGradient
	sg.Rotation = 90
	sg.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(0.6, 0.55),
		NumberSequenceKeypoint.new(1, 0.9),
	})
	Common.glow(spine, self.ctx.hue, 0.5, 10)
	self.left, self.rows = left, rows
	if compact then
		Common.drop(body, "Side")
		self.side = nil
	else
		local side = Common.get(body, "Side", "Frame") :: Frame
		side.LayoutOrder = 2
		side.Active = false
		side.Size = UDim2.fromOffset(sideW, 0)
		side.AutomaticSize = Enum.AutomaticSize.Y
		Common.list(side, false, 14)
		self.side = side
	end
end

-- the notes: the display-text siblings of the ladder (their own frames are claimed away, see M.note)
local function notesOf(store: any, id: string): { string }
	local out: { string } = {}
	local pid = Common.parentId(id)
	if pid == nil then return out end
	for _, cid in store:kids(pid) do
		local n = store:get(cid)
		if type(n) == "table" and n.cn == "display-text" and type(n.h) == "string" and string.find(Common.plain(n.h), "%S") then
			table.insert(out, n.h)
		end
	end
	return out
end

function Ladder.drawNotes(self: any, parent: Instance, order: number)
	local notes = notesOf(self.store, self.id)
	if #notes == 0 then
		Common.drop(parent, "Notes")
		return
	end
	local card = Kit.card(parent, "Notes", { order = order, gap = 8, pad = 14 })
	local head = Common.label(card, "Head", "caps", C.soft, { order = 1, wrap = false })
	Common.setText(head, Common.caps("Notes"))
	local body = Common.label(card, "Text", "body", C.text, { order = 2 })
	Theme.text(body, "small")
	local bullet = Common.run("•", "label", Theme.textHue(self.layer))
	local lines: { string } = {}
	for _, h in notes do
		table.insert(lines, bullet .. "  " .. Common.html(h, "small", self.layer))
	end
	Common.setText(body, table.concat(lines, "\n"))
end

-- JUMP TO (WIDE): NEXT, the 25-row blocks, MALWARE; then the order button
function Ladder.drawSide(self: any, malware: boolean)
	local side = self.side
	if side == nil then return end
	self:drawNotes(side, 1)
	local card = Kit.card(side, "Jump", { order = 2, gap = 6, pad = 12 })
	local head = Common.label(card, "Head", "caps", C.soft, { order = 1, wrap = false })
	Common.setText(head, Common.caps("Jump to"))
	local hue = self.ctx.hue :: Color3
	local used: { [string]: boolean } = { Head = true }
	local k = 1
	local function jump(name: string, text: string, lit: boolean, fn: () -> ())
		k += 1
		used[name] = true
		local b = Kit.button(card, name, text, { fill = if lit then Theme.mix(C.panel, hue, 0.55) else C.panel3, ink = C.text,
			stroke = if lit then Theme.lift(hue, 0.35) else nil, h = 38, w = 1, order = k, align = Enum.TextXAlignment.Left })
		Common.state(b, "can")
		Kit.onPress(b, fn)
	end
	local nextRow = if self.nextIdx then self.data[self.nextIdx] else nil
	if nextRow then
		jump("Next", Common.run(Common.esc("Next"), "label", C.text) .. Common.run(" · ", "label", C.soft)
			.. Common.num(tostring(nextRow.num), "number", C.text), true, function()
			Kit.scrollTo(self.ctx, self.rows:FindFirstChild("Next") :: GuiObject?, 16)
		end)
	end
	-- 25-row blocks under the newest done row (the last block takes the rest)
	local top = 0
	for _, r in self.data do
		if r.n.done and r.num > top then top = r.num end
	end
	local blocks = 0
	local hi = top
	while hi >= 1 and blocks < 5 do
		blocks += 1
		local lo = math.max(1, ((hi - 1) // 25) * 25 + 1)
		if blocks == 5 then lo = 1 end
		local bhi = hi
		jump("B" .. blocks, Common.num(lo .. " – " .. bhi, "number", C.text), false, function()
			self:jumpTo(bhi)
		end)
		hi = lo - 1
	end
	if malware then
		jump("Malware", Common.run(Common.esc("Malware"), "label", Theme.lift(C.danger, 0.35)), false, function()
			Kit.scrollTo(self.ctx, self.ph:FindFirstChild("Malware") :: GuiObject?, 16)
		end)
	end
	for _, c in card:GetChildren() do
		if c:IsA("GuiObject") and not used[c.Name] then c:Destroy() end
	end
	-- the order button: opens Options (the map's own `opt` action)
	local opt = self.store:map().opt
	if opt then
		local order = if self.newestFirst then "Newest first" else "Oldest first"
		local b = Kit.button(side, "Order", Common.run(Common.esc("Order: "), "label", C.soft) .. Common.run(Common.esc(order), "label", C.text)
			.. Common.run("  ›", "label", C.soft), { fill = C.panel2, stroke = C.stroke, h = 40, w = 1, order = 3, align = Enum.TextXAlignment.Left })
		Common.state(b, "can")
		Kit.onPress(b, function()
			local a = self.store:map().opt
			if a then self.ctx.act(a, false) end
		end)
	else
		Common.drop(side, "Order")
	end
end

-- open SHOW ALL and scroll to a milestone number
function Ladder.jumpTo(self: any, num: number)
	showAll[self.layer] = true
	self:draw()
	task.defer(function()
		local v = self.virtual
		local sf = self.ctx.scroll :: ScrollingFrame?
		if v == nil or sf == nil or not self.ph.Parent then return end
		local idx = 1
		for i, r in self.data do
			if r.num == num then idx = i end
		end
		local order = self:allOrder()
		for i, k in order do
			if k == idx then idx = i end
		end
		local s = math.max(Layout.s, 0.01)
		local host = v.o.host :: Frame
		local y = sf.CanvasPosition.Y + (host.AbsolutePosition.Y - sf.AbsolutePosition.Y) / s + (idx - 1) * v:pitch() - 12
		sf.CanvasPosition = Vector2.new(0, math.max(0, y))
	end)
end

-- SHOW ALL order: every row but NEXT, in the game's order
function Ladder.allOrder(self: any): { number }
	local out: { number } = {}
	for i = 1, #self.data do
		if i ~= self.nextIdx then table.insert(out, i) end
	end
	return out
end

-- the expanded list: NEXT, the virtual pool, "Show less"
function Ladder.drawAll(self: any)
	local rows = self.rows
	local used: { [string]: boolean } = {}
	local nextRow = if self.nextIdx then self.data[self.nextIdx] else nil
	local order = 0
	if nextRow and self.newestFirst then
		order += 1
		used.Next = true
		nextCard(self, rows, { kind = "next", key = "Next", row = nextRow }, order)
	end
	order += 1
	used.All = true
	local host = Common.get(rows, "All", "Frame") :: Frame
	host.LayoutOrder = order
	host.Active = false
	local list = self:allOrder()
	if self.virtual == nil then
		local compact = Layout.mode == "COMPACT"
		self.virtual = Virtual.new({
			scroll = self.ctx.scroll,
			host = host,
			top = 0,
			rowH = if compact then 60 else 64,
			gap = 8,
			count = #list,
			draw = function(row: Frame, i: number)
				local idxs = self:allOrder()
				local r = self.data[idxs[i]]
				if r == nil then
					row.Visible = false
					return
				end
				self:drawVirtualRow(row, r)
			end,
		})
	else
		self.virtual:setCount(#list)
		self.virtual:redraw()
	end
	if nextRow and not self.newestFirst then
		order += 1
		used.Next = true
		nextCard(self, rows, { kind = "next", key = "Next", row = nextRow }, order)
	end
	order += 1
	used.Less = true
	local less = Kit.button(rows, "Less", Common.run("–", "label", Theme.lift(self.ctx.hue, 0.45)) .. "   "
		.. Common.run(Common.esc("Show less"), "label", C.text), { fill = C.panel, stroke = C.strokeHi, h = 44, order = order })
	Common.state(less, "can")
	Kit.onPress(less, function()
		showAll[self.layer] = false
		self:draw()
	end)
	for _, c in rows:GetChildren() do
		if c:IsA("GuiObject") and not used[c.Name] then c:Destroy() end
	end
end

-- one pooled row of SHOW ALL (the pool frame is the card)
function Ladder.drawVirtualRow(self: any, row: Frame, r: Row)
	local n = r.n
	local done = n.done == true
	row.BackgroundColor3 = if done then Theme.mix(C.panel, C.bought, 0.14) else C.panel2
	row.BackgroundTransparency = 0
	Common.corner(row, 12)
	Common.stroke(row, if n.mal then 2 else 1, if n.mal then C.danger elseif done then C.bought else C.stroke, if n.mal then 0.1 elseif done then 0.6 else 0.3)
	local t = Common.get(row, "Text", "TextLabel") :: TextLabel
	t.Active = false
	Common.text(t, "small", C.text)
	t.Position = UDim2.fromOffset(16, 6)
	t.Size = UDim2.new(1, -30, 1, -12)
	t.AutomaticSize = Enum.AutomaticSize.None
	t.TextWrapped = true
	t.TextTruncate = Enum.TextTruncate.AtEnd
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextYAlignment = Enum.TextYAlignment.Center
	local title = Common.plain(Common.str(n.ti) or "")
	local parts = { Common.title(title, "cardSmall", if done then C.ownedTitle else C.text) }
	local eff = effect(n, "small", self.layer, if done then C.text else C.soft, if done then 0.18 else 0.05)
	if eff ~= "" then table.insert(parts, eff) end
	Common.setText(t, table.concat(parts, "\n"))
	pill(row, if done then "done" else "future", r.num, self.ctx.hue, 0, 18)
end

-- the collapsed ladder
function Ladder.drawCollapsed(self: any)
	if self.virtual then
		self.virtual:destroy()
		self.virtual = nil
	end
	local rows = self.rows
	local list = entries(self.data, self.nextIdx, self.layer)
	local used: { [string]: boolean } = {}
	for i, e in list do
		used[e.key] = true
		if e.kind == "next" then
			nextCard(self, rows, e, i)
		elseif e.kind == "fold" or e.kind == "rest" then
			foldRow(self, rows, e, i)
		else
			rowCard(rows, e, self.ctx, i)
		end
	end
	for _, c in rows:GetChildren() do
		if c:IsA("GuiObject") and not used[c.Name] then c:Destroy() end
	end
end

-- MALWARE (m): the rows with an INFECT button, each firing the malware node's own action
function Ladder.drawMalware(self: any): boolean
	local store = self.store
	local found: { { row: Row, mid: string, m: any } } = {}
	for _, r in self.data do
		for _, kid in store:kids(r.id) do
			local k = store:get(kid)
			if type(k) == "table" and k.t == "btn" and k.k == "malware" then
				table.insert(found, { row = r, mid = kid, m = k })
				break
			end
		end
	end
	if #found == 0 then
		Common.drop(self.ph, "Malware")
		return false
	end
	local compact = Layout.mode == "COMPACT"
	local sec = Common.get(self.ph, "Malware", "Frame") :: Frame
	sec.LayoutOrder = 3
	sec.Active = false
	sec.Size = UDim2.new(1, 0, 0, 0)
	sec.AutomaticSize = Enum.AutomaticSize.Y
	Common.list(sec, false, 10)
	local infectable = 0
	for _, f in found do
		if f.m.cls ~= "pseudo" then infectable += 1 end
	end
	Sections.header(sec, { name = "Head", text = "MALWARE", hue = C.danger, order = 0,
		chips = { { text = infectable .. " infectable", color = C.dangerText, bg = Theme.mix(C.deep, C.danger, 0.3), bgT = 0 } } })
	local used: { [string]: boolean } = { Head = true }
	for i, f in found do
		local name = "M" .. f.row.num
		used[name] = true
		local row = Common.get(sec, name, "Frame") :: Frame
		row.LayoutOrder = i
		row.Active = false
		row.Size = UDim2.new(1, 0, 0, 0)
		row.AutomaticSize = Enum.AutomaticSize.Y
		row.BackgroundColor3 = C.panel2
		row.BackgroundTransparency = 0
		Common.corner(row, 12)
		local infected = f.m.cls == "pseudo"
		local can = f.m.cls == "can"
		Common.stroke(row, if can then 2 else 1, C.danger, if can then 0.1 elseif infected then 0.35 else 0.6)
		Common.pad(row, 10, 14, 10, 16)
		local t = Common.label(row, "Text", "small", C.text, { order = 1 })
		local btnW = if compact then 150 else 190
		t.Size = UDim2.new(1, -(btnW + 12), 0, 0)
		local title = Common.plain(Common.str(f.row.n.ti) or "")
		local eff = effect(f.row.n, "small", self.layer, C.soft, 0)
		Common.setText(t, Common.title(title, "cardSmall", C.text) .. (if eff ~= "" then "\n" .. eff else ""))
		local b = Common.get(row, "Infect", "TextButton") :: TextButton
		b.AutoButtonColor = false
		b.AnchorPoint = Vector2.new(1, 0)
		b.Position = UDim2.new(1, 0, 0, 0)
		b.Size = UDim2.fromOffset(btnW, 44)
		Common.text(b, "label", C.text)
		b.TextWrapped = false
		b.TextXAlignment = Enum.TextXAlignment.Center
		b.TextYAlignment = Enum.TextYAlignment.Center
		b.BackgroundColor3 = if infected then Theme.mix(C.panel, C.danger, 0.3) elseif can then C.danger else Theme.mix(C.panel, C.locked, 0.3)
		b.BackgroundTransparency = 0
		Common.corner(b, 10)
		local co = Common.str(f.m.co)
		local label = if infected then Common.esc("INFECTED") else Common.esc("INFECT")
		if co and not infected then label ..= "  " .. Common.num(Rich.short(co), "number", C.text) end
		Common.setText(b, label)
		Common.state(b, if infected then "owned" elseif can then "can" else "notyet")
		local mid = f.mid
		Kit.onPress(b, function()
			local m = self.store:get(mid)
			if type(m) == "table" and type(m.a) == "table" then self.ctx.act(m.a, false) end
		end)
	end
	for _, c in sec:GetChildren() do
		if c:IsA("GuiObject") and not used[c.Name] then c:Destroy() end
	end
	return true
end

function Ladder.draw(self: any)
	if not self.ph.Parent then return end
	local compact = Layout.mode == "COMPACT"
	local rows, nextIdx = collect(self.store, self.id)
	self.data, self.nextIdx = rows, nextIdx
	self.newestFirst = #rows < 2 or rows[1].num > rows[#rows].num
	-- the header: the ladder's name and done / total
	local done = 0
	for _, r in rows do
		if r.n.done then done += 1 end
	end
	Sections.header(self.ph, { name = "Head", order = 1, text = Sections.titleOf("milestones", self.layer) or "MILESTONES", hue = self.ctx.hue,
		chips = { { text = done .. " / " .. #rows .. " DONE", color = C.ownedValue, bg = Theme.mix(C.deep, C.bought, 0.16), bgT = 0 } } })
	self:frame()
	-- COMPACT: the notes sit on top of the ladder
	if compact then
		self:drawNotes(self.ph, 0)
	else
		Common.drop(self.ph, "Notes")
	end
	if showAll[self.layer] then self:drawAll() else self:drawCollapsed() end
	local malware = self:drawMalware()
	self:drawSide(malware)
	-- a new milestone: the NEXT card flashes (keyed by the layer, never on the first sight)
	local nextRow = if nextIdx then rows[nextIdx] else nil
	local nid = if nextRow then tostring(nextRow.n.id) else nil
	local key = "ladder:" .. self.layer
	local first = self.ctx.firstSeen(key)
	if nid ~= self.nextId then
		local had = self.nextId ~= nil
		self.nextId = nid
		local card = self.rows:FindFirstChild("Next") :: GuiObject?
		if had and not first and card then
			Motion.flash(card)
			Motion.bump(card, 0.05)
		end
	end
	current = self
end

function Ladder.update(self: any, store: any)
	self.store = store or self.store
	local ok, err = Common.try(function()
		self:draw()
	end)
	if not ok then warn("[MilestoneTree] ladder failed: " .. tostring(err)) end
end

function Ladder.destroy(self: any)
	for _, c in self.conns do c:Disconnect() end
	table.clear(self.conns)
	if self.virtual then
		self.virtual:destroy()
		self.virtual = nil
	end
	if current == self then current = nil end
	for _, name in { "Head", "Body", "Notes", "Malware" } do Common.drop(self.ph, name) end
end

-- ------------------------------------------------------------------------------------------------------ notes claim
-- the ladder's display-text siblings move into its NOTES card; a display-text with no ladder next to it stays a
-- NOTES row (drawn here, the look of Skins/Generic)
local function note(ph: Frame, id: string, store: any, ctx: any): any
	local claim = {}
	local function hasLadder(st: any): boolean
		local pid = Common.parentId(id)
		if pid == nil then return false end
		for _, cid in st:kids(pid) do
			local n = st:get(cid)
			if type(n) == "table" and n.cn == "milestones" then return true end
		end
		return false
	end
	function claim.update(_: any, st: any)
		local n = st:get(id)
		local text = if type(n) == "table" then Common.plain(n.h) else ""
		if hasLadder(st) or not string.find(text, "%S") then
			ph.Visible = false
			ph.Size = UDim2.new()
			ph.AutomaticSize = Enum.AutomaticSize.None
			Common.drop(ph, "Text")
			return
		end
		ph.Visible = true
		ph.Size = UDim2.new(1, 0, 0, 0)
		ph.AutomaticSize = Enum.AutomaticSize.Y
		ph.BackgroundColor3 = C.panel2
		ph.BackgroundTransparency = 0
		Common.corner(ph, 10)
		Common.pad(ph, 10, 14, 10, 16)
		local l = Common.label(ph, "Text", "body", C.text)
		l.TextTransparency = 0.08
		Common.setText(l, Common.html(n.h, "body", ctx.layer))
	end
	function claim.destroy(_: any)
		Common.drop(ph, "Text")
	end
	claim.update(claim, store)
	return claim
end

-- ------------------------------------------------------------------------------------------------------ signatures
local function ladderClaim(ph: Frame, id: string, store: any, ctx: any): any
	return Ladder.new(ph, id, store, ctx)
end

-- the hero hook runs whenever the prestige button changes: the NEXT card's REQUIRES follows it
local function hero(_: Frame, store: any, ctx: any)
	local l = current
	if l and l.ph.Parent and l.layer == ctx.layer then
		l.store = store
		l:drawReq()
	end
end

local function accent(mark: string?): ((sheet: Frame, ctx: any) -> ())?
	if mark == nil then return nil end
	return function(sheet: Frame, ctx: any)
		local band = Kit.band(sheet)
		if band == nil then return end
		local a = Kit.accent(band, "M" .. (mark :: string))
		Kit.watermark(a, mark :: string, Theme.lift(ctx.hue, 0.3), 0.09)
	end
end

-- pm: the glitch title (R12): red / cyan clones behind the real title (in the band's accent, so they draw under it)
local function glitch(sheet: Frame, ctx: any)
	local band = Kit.band(sheet)
	local title = sheet:FindFirstChild("Title")
	if band == nil or title == nil or not title:IsA("TextLabel") then return end
	local a = Kit.accent(band, "Mpm")
	Kit.stripes(a, Theme.lift(ctx.hue, 0.2), 0.05, 22)
	local g = Common.get(a, "Glitch", "TextLabel") :: TextLabel
	g.Active = false
	g.Position = title.Position
	g.Size = title.Size
	g.AutomaticSize = title.AutomaticSize
	g.FontFace = title.FontFace
	g.TextSize = title.TextSize
	g.TextXAlignment = title.TextXAlignment
	g.TextYAlignment = title.TextYAlignment
	g.TextWrapped = false
	g.Text = title.Text
	Recipes.glitch(g, { min = 2, max = 4 })
	local fill = g:FindFirstChild("Fill")
	if fill and fill:IsA("TextLabel") then fill.TextTransparency = 1 end
end

local CLAIMS = {
	{ match = { cn = "milestones" }, make = ladderClaim },
	{ match = { cn = "display-text" }, make = note },
}

local function sig(layers: { string }, mark: string?, extra: { [string]: any }?): any
	local s: any = {
		layers = layers,
		claims = CLAIMS,
		hero = hero,
		accent = accent(mark),
	}
	if extra then
		for k, v in extra do s[k] = v end
	end
	return s
end

local M = {
	sig({ "m" }, nil),
	sig({ "mm" }, "M²"),
	sig({ "em" }, "M³"),
	sig({ "cm" }, nil, { corrupted = true, hug = true }),
	sig({ "pm" }, nil, { accent = glitch }),
}
M.Ladder = Ladder
M.ladderClaim = ladderClaim
M.noteClaim = note
M.hero = hero
-- forget the session memory (tests)
function M.resetMemory()
	table.clear(showAll)
	table.clear(openFold)
end
M.unit = Signatures.unit
return M
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="162">
            <Properties>
              <string name="Name">Mp</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Mp: Multiverse (DESIGN.md 6 row mp).

	    accent   the split rim: violet (m) -> crimson (danger) around the sheet
	    portal   challenge 21 ("Enter The Prestige Multiverse") becomes the full-width PORTAL card: the default challenge
	             card widened, with a turning swirl ring at its right (still with reduced motion); its START button is
	             the challenge's own (the same ["chal", "mp", 21] as the map's gate)
	The other challenges and the upgrades keep the template (P.skin: Hide owned).
]]

local Client = script.Parent.Parent
local Core = Client:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local PanelF = Client:WaitForChild("Panel")
local Skins = PanelF:WaitForChild("Skins")
local Common = require(Skins:WaitForChild("Common"))
local Challenge = require(Skins:WaitForChild("Challenge"))
local Kit = require(script.Parent:WaitForChild("Kit"))
local P = (require(script.Parent:WaitForChild("P")) :: any).P

local C = Theme.C

local function rim(sheet: Frame, ctx: any)
	if Layout.mode == "COMPACT" then return end
	local a = Kit.accent(sheet, "Mp")
	local f = Common.get(a, "Split", "Frame") :: Frame
	f.Active = false
	f.BackgroundTransparency = 1
	f.Size = UDim2.fromScale(1, 1)
	f.ZIndex = 4
	Common.corner(f, 22)
	local s = Common.stroke(f, 3, C.white, 0)
	local g = Common.get(s, "Split", "UIGradient") :: UIGradient
	g.Rotation = 0
	g.Color = ColorSequence.new(Theme.hue("m"), C.danger)
end

local function skin(rec: any, n: any, ctx: any): boolean
	if rec.kind == "chal" then
		-- every challenge (21, "Enter The Prestige Multiverse", included) is the same template card: the full-width
		-- portal banner broke the row rhythm (three small cards, then one big one)
		Common.drop(rec.root, "Portal")
		Common.drop(rec.root, "Clear")
		return Challenge.skin(rec, n, ctx)
	end
	return P.skin(rec, n, ctx)
end

return {
	layers = { "mp" },
	skin = skin,
	accent = rim,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="163">
            <Properties>
              <string name="Name">Options</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Options (DESIGN.md 6 row Options, 6.1 "Options"). Gear emblem, no hero.

	    YOUR SAVE     the game's "[ Saving ]" line becomes the section title with a "Saved with your game" tag; SAVE is
	                  a tile (the title, the game's one-line sub in a well); Offline Production keeps the toggle row.
	                  Saves live in Roblox (autosave), so there is no export, import or hard reset.
	    DISPLAY       "[ Displays ]" becomes the section title; the cyclers and toggles keep the Opt rows
	    HOTKEYS       the about node (Skins/Generic): the unlocked hotkeys only, no credits
	    THIS DEVICE   "Not part of the save": Numbers (suffix / scientific, formatted by the server), Motion, Map detail, Map labels, Interface size as segmented controls,
	                  client-only through Prefs (one press); then Music, Sound effects and Ambience volumes (0 to 100
	                  in steps of 10) as a stepper: - / a 10-cell level bar (a cell sets its level) / the value / +.
	                  A sound-effects change plays a short tick at the new level
	Every game option fires its node's own action; device options never reach the save.
]]

local Client = script.Parent.Parent
local Core = Client:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Prefs = require(Core:WaitForChild("Prefs"))
local Audio = require(Core:WaitForChild("Audio"))
local PanelF = Client:WaitForChild("Panel")
local Skins = PanelF:WaitForChild("Skins")
local Common = require(Skins:WaitForChild("Common"))
local Generic = require(Skins:WaitForChild("Generic"))
local Sections = require(PanelF:WaitForChild("Sections"))
local Kit = require(script.Parent:WaitForChild("Kit"))

local C = Theme.C

local HEADINGS: { [string]: { title: string, tag: string } } = {
	saving = { title = "YOUR SAVE", tag = "Saved with your game" },
	displays = { title = "DISPLAY", tag = "Saved with your game" },
}
local TILES: { [string]: boolean } = { save = true }

local DEVICE: { { key: string, title: string, sub: string, values: { any }, labels: { string } } } = {
	{ key = "notation", title = "Numbers", sub = "1.23M or 1.23e6", values = { "SUFFIX", "SCIENTIFIC" },
		labels = { "Suffix", "Scientific" } },
	{ key = "tut", title = "Tutorial", sub = "The first steps, shown again", values = { 8, 0 },
		labels = { "Done", "Replay" } },
	{ key = "motion", title = "Motion", sub = "Animations and effects", values = { "SYSTEM", "FULL", "REDUCED" },
		labels = { "System", "Full", "Reduced" } },
	{ key = "detail", title = "Map detail", sub = "Lower detail runs lighter", values = { "AUTO", "HIGH", "LOW" },
		labels = { "Auto", "High", "Low" } },
	{ key = "labels", title = "Map labels", sub = "Names under the map nodes", values = { "AUTO", "ALWAYS", "OFF" },
		labels = { "Auto", "Always", "Off" } },
	{ key = "size", title = "Interface size", sub = "Scales every panel and the HUD", values = { 90, 100, 115 },
		labels = { "90%", "100%", "115%" } },
}

local VOLUMES: { { key: string, title: string, sub: string, preview: string? } } = {
	{ key = "music", title = "Music", sub = "The soundtrack" },
	{ key = "sfx", title = "Sound effects", sub = "Clicks, purchases, prestige", preview = "tab" },
	{ key = "ambience", title = "Ambience", sub = "The realm's air and the rift" },
}

-- a section title with its tag chip (sentence case)
local function heading(root: Instance, title: string, tag: string, hue: Color3, order: number?)
	Sections.header(root, { name = "SectionTitle", order = order, text = title, hue = hue,
		chips = { { text = tag, color = C.soft, bg = C.panel2, bgT = 0 } } })
	local h = root:FindFirstChild("SectionTitle")
	-- the tag is a sentence, not a count: small, soft
	local chip = if h then h:FindFirstChild("Chip1") else nil
	if chip and chip:IsA("TextLabel") then Common.text(chip, "small", C.soft) end
end

-- ------------------------------------------------------------------------------------------------------ tiles
local function tile(rec: any, n: any, ctx: any): boolean
	local b = rec.root :: TextButton
	local l = b:FindFirstChild("Label") :: TextLabel?
	if l == nil then return false end
	local label = l :: TextLabel
	local compact = ctx.mode == "COMPACT"
	b.Visible = true
	b.AutoButtonColor = false
	for _, name in { "Gradient", "Glow", "Num", "Limit", "Fill" } do Common.drop(b, name) end
	b.BackgroundColor3 = Theme.mix(C.panel, ctx.hue, 0.3)
	b.BackgroundTransparency = 0
	Common.corner(b, 16)
	Common.stroke(b, 1.5, Theme.lift(ctx.hue, 0.3), 0.1)
	b.Size = UDim2.fromOffset(if compact then math.floor((ctx.contentW - 20) / 3) else 220, if compact then 84 else 104)
	b.AutomaticSize = Enum.AutomaticSize.None
	Common.pad(b, 12, 10, 12, 10)
	Common.text(label, "card", C.text)
	label.Visible = true
	label.ZIndex = 3
	label.Size = UDim2.new(1, 0, 0, 30)
	label.AutomaticSize = Enum.AutomaticSize.None
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextWrapped = false
	local stroke = Common.stroke(label, 2, C.black, 0, "Stroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	local title = string.upper(Common.plain(Common.str(n.ti) or n.h or ""))
	title = string.gsub(title, " SAVE$", "")
	title = string.gsub(title, " A SAVE$", "")
	Common.setText(label, Common.esc(title))
	local sub = string.match(Common.str(n.h) or "", "<br%s*/?>(.*)$")
	local subText = Common.plain(sub or "")
	subText = string.gsub(string.gsub(subText, "^%s+", ""), "%s+$", "")
	if subText ~= "" and not compact then
		local well = Common.chip(label, "Sub", subText, { color = C.text, bg = C.black, bgT = 0.45, h = 26, role = "small" })
		well.AnchorPoint = Vector2.new(0.5, 0)
		well.Position = UDim2.new(0.5, 0, 1, 12)
		well.TextTruncate = Enum.TextTruncate.AtEnd
		local lim = Common.get(well, "Max", "UISizeConstraint") :: UISizeConstraint
		lim.MaxSize = Vector2.new(200, 26)
	else
		Common.drop(label, "Sub")
	end
	Common.state(b, "can")
	return true
end

-- ------------------------------------------------------------------------------------------------------ this device
local function device(root: Instance, ctx: any)
	local compact = ctx.mode == "COMPACT"
	local card = Kit.card(root, "Device", { order = 99, gap = 12, pad = 16 })
	heading(card, "THIS DEVICE", "Not part of the save", ctx.hue, 0)
	local prefs = Prefs.get() :: any
	for i, d in DEVICE do
		local row = Common.get(card, "Row" .. i, "Frame") :: Frame
		row.LayoutOrder = i
		row.Active = false
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, 0)
		row.AutomaticSize = Enum.AutomaticSize.Y
		local t = Common.label(row, "Title", "small", C.soft)
		t.Size = UDim2.new(1, if compact then -250 else -360, 0, 0)
		Common.setText(t, Common.title(d.title, "cardSmall", C.text) .. "\n" .. Common.esc(d.sub))
		local seg = Common.get(row, "Seg", "Frame") :: Frame
		seg.Active = false
		seg.AnchorPoint = Vector2.new(1, 0)
		seg.Position = UDim2.new(1, 0, 0, 0)
		seg.Size = UDim2.fromOffset(if compact then 240 else 340, 38)
		seg.BackgroundColor3 = C.deep
		seg.BackgroundTransparency = 0
		Common.corner(seg, 10)
		Common.list(seg, true, 4, { valign = Enum.VerticalAlignment.Center, align = Enum.HorizontalAlignment.Center })
		for j, v in d.values do
			local on = prefs[d.key] == v
			local b = Kit.button(seg, "O" .. j, Common.esc(d.labels[j]), { fill = if on then Theme.mix(C.panel, ctx.hue, 0.6) else C.panel2,
				ink = if on then C.text else C.soft, h = 32, w = if compact then 76 else 108, order = j, radius = 8 })
			b.FontFace = Font.fromName("Montserrat", Enum.FontWeight.ExtraBold, if on then Enum.FontStyle.Italic else Enum.FontStyle.Normal)
			Common.state(b, if on then "owned" else "can")
			local key, value = d.key, v
			Kit.onPress(b, function()
				Prefs.set(key, value)
				device(root, ctx)
			end)
		end
	end
	-- the volumes
	for i, vd in VOLUMES do
		local row = Common.get(card, "Vol" .. i, "Frame") :: Frame
		row.LayoutOrder = #DEVICE + i
		row.Active = false
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, 0)
		row.AutomaticSize = Enum.AutomaticSize.Y
		local t = Common.label(row, "Title", "small", C.soft)
		t.Size = UDim2.new(1, if compact then -250 else -360, 0, 0)
		Common.setText(t, Common.title(vd.title, "cardSmall", C.text) .. "\n" .. Common.esc(vd.sub))
		local level = math.clamp(math.floor((tonumber(prefs[vd.key]) or 0) / 10 + 0.5), 0, 10)
		local key, preview = vd.key, vd.preview
		local function set(n: number)
			Prefs.set(key, math.clamp(n, 0, 10) * 10)
			if preview then Audio.play(preview) end
			device(root, ctx)
		end
		-- the stepper, in the segmented control's footprint: - [10 cells] value +
		local ctrl = Common.get(row, "Level", "Frame") :: Frame
		ctrl.Active = false
		ctrl.AnchorPoint = Vector2.new(1, 0)
		ctrl.Position = UDim2.new(1, 0, 0, 0)
		ctrl.Size = UDim2.fromOffset(if compact then 240 else 340, 38)
		ctrl.BackgroundColor3 = C.deep
		ctrl.BackgroundTransparency = 0
		Common.corner(ctrl, 10)
		Common.list(ctrl, true, 4, { valign = Enum.VerticalAlignment.Center, align = Enum.HorizontalAlignment.Center })
		local bw, vw = if compact then 34 else 40, if compact then 40 else 48
		local cell = if compact then 9 else 17
		local minus = Kit.button(ctrl, "Minus", "−", { fill = C.panel2, ink = if level > 0 then C.text else C.muted, h = 32,
			w = bw, order = 1, radius = 8 })
		Common.state(minus, if level > 0 then "can" else "locked")
		Kit.onPress(minus, function() set(level - 1) end, true)
		local bar = Common.get(ctrl, "Bar", "Frame") :: Frame
		bar.Active = false
		bar.LayoutOrder = 2
		bar.BackgroundTransparency = 1
		bar.Size = UDim2.fromOffset(cell * 10 + 18, 32)
		Common.list(bar, true, 2, { valign = Enum.VerticalAlignment.Center })
		local lit = Theme.lift(ctx.hue, 0.25)
		for j = 1, 10 do
			local c = Common.get(bar, "C" .. j, "TextButton") :: TextButton
			c.LayoutOrder = j
			c.AutoButtonColor = false
			c.Text = ""
			c.Size = UDim2.fromOffset(cell, if j <= level then 22 else 16)
			c.BackgroundColor3 = if j <= level then lit else C.panel3
			c.BackgroundTransparency = 0
			Common.corner(c, 3)
			local n = j
			Kit.onPress(c, function() set(n) end, true)
		end
		local value = Common.get(ctrl, "Value", "TextLabel") :: TextLabel
		value.LayoutOrder = 3
		value.BackgroundTransparency = 1
		value.Size = UDim2.fromOffset(vw, 32)
		Common.text(value, "number", if level > 0 then C.text else C.soft)
		value.TextXAlignment = Enum.TextXAlignment.Center
		value.TextYAlignment = Enum.TextYAlignment.Center
		Common.setText(value, Common.esc(if level > 0 then tostring(level * 10) else "Off"))
		local plus = Kit.button(ctrl, "Plus", "+", { fill = C.panel2, ink = if level < 10 then C.text else C.muted, h = 32,
			w = bw, order = 4, radius = 8 })
		Common.state(plus, if level < 10 then "can" else "locked")
		Kit.onPress(plus, function() set(level + 1) end, true)
	end
end

-- ------------------------------------------------------------------------------------------------------ the skin
local function skin(rec: any, n: any, ctx: any): boolean
	-- the game's "[ Saving ]" / "[ Displays ]" lines become section titles
	if n.t == "html" and rec.kind == "html" then
		local plain = Common.plain(n.h)
		local word = string.match(plain, "^%s*%[%s*(%a+)%s*%]%s*$")
		local head = if word then HEADINGS[string.lower(word)] else nil
		if head then
			local root = rec.root :: Frame
			root.Visible = true
			root.BackgroundTransparency = 1
			root.Size = UDim2.new(1, 0, 0, 0)
			root.AutomaticSize = Enum.AutomaticSize.Y
			Common.drop(root, "Pad")
			local text = root:FindFirstChild("Text")
			if text and text:IsA("GuiObject") then text.Visible = false end
			heading(root, head.title, head.tag, ctx.hue)
			return true
		end
		return false
	end
	if rec.kind == "btn:opt" then
		if TILES[n.id or ""] then return tile(rec, n, ctx) end
		return false
	end
	-- the tab root: the device options come last
	if rec.id == "tab" and (n.t == "col" or n.t == "row") then
		Generic.skin(rec, n, ctx)
		device(rec.root, ctx)
		return true
	end
	return false
end

-- the gear emblem's accent: a quiet system-violet glow in the header
local function accent(sheet: Frame, ctx: any)
	local band = Kit.band(sheet)
	if band == nil then return end
	local a = Kit.accent(band, "Options")
	Kit.watermark(a, "⚙", Theme.lift(ctx.hue, 0.3), 0.08)
end

return {
	layers = { "options-tab" },
	skin = skin,
	accent = accent,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="164">
            <Properties>
              <string name="Name">P</string>
              <string name="Source"><![CDATA[--!strict
--[[
	P: the tier board layers (DESIGN.md 6 rows p and hp; 5.6 "upgrades" and 5.7 "Tier board").

	The default skins already draw the tier board (the rail with Arabic tier badges, compact owned cards for a fully
	owned tier, the COMPACT owned fold). This signature adds:
	    Hide owned   a mini toggle at the right of the UPGRADES title row (WIDE / MEDIUM; session memory per layer):
	                 owned cards and fully owned tiers leave the board, the chips keep counting them
	    accent       p: sky-blue header stripes; hp: a frost glow in the header corner
	P.skin is shared by the other signatures whose tabs hold an upgrades board (Sp, Badges, Pp, Energy, Ap, T, ...).
]]

local Client = script.Parent.Parent
local Core = Client:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local PanelF = Client:WaitForChild("Panel")
local Skins = PanelF:WaitForChild("Skins")
local Common = require(Skins:WaitForChild("Common"))
local Generic = require(Skins:WaitForChild("Generic"))
local Upgrade = require(Skins:WaitForChild("Upgrade"))
local Kit = require(script.Parent:WaitForChild("Kit"))

local C = Theme.C

local P = {}

-- session memory: the layers whose owned upgrades are hidden
local hideOwned: { [string]: boolean } = {}
P.hideOwned = hideOwned

local function parentNode(ctx: any, id: string): any?
	local pid = Common.parentId(id)
	if pid == nil then return nil end
	return ctx.store:get(pid)
end

-- the Hide owned switch in the section title row (the rule flexes to leave it room at the right)
local function toggle(rec: any, ctx: any)
	local header = rec.root:FindFirstChild("SectionTitle")
	if header == nil or not header:IsA("Frame") then return end
	local on = hideOwned[ctx.layer] == true
	local rule = header:FindFirstChild("Rule")
	local flex = false
	if rule then
		flex = pcall(function()
			local f = Common.get(rule, "Flex", "UIFlexItem") :: any
			f.FlexMode = Enum.UIFlexMode.Fill
		end)
	end
	local b = Common.get(header, "HideOwned", "TextButton") :: TextButton
	b.LayoutOrder = if flex then 20 else 5
	b.AutoButtonColor = false
	b.BackgroundTransparency = 1
	b.Size = UDim2.fromOffset(150, 28)
	b.AutomaticSize = Enum.AutomaticSize.None
	Common.text(b, "label", if on then C.text else C.soft)
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.TextYAlignment = Enum.TextYAlignment.Center
	b.TextWrapped = false
	Common.setText(b, Common.esc("Hide owned"))
	local track = Common.get(b, "Track", "Frame") :: Frame
	track.Active = false
	track.AnchorPoint = Vector2.new(1, 0.5)
	track.Position = UDim2.new(1, -4, 0.5, 0)
	track.Size = UDim2.fromOffset(36, 20)
	track.BackgroundColor3 = if on then Theme.mix(C.deep, C.bought, 0.55) else C.panel3
	track.BackgroundTransparency = 0
	Common.corner(track, 0.5)
	local knob = Common.get(track, "Knob", "Frame") :: Frame
	knob.Active = false
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.new(if on then 1 else 0, if on then -10 else 10, 0.5, 0)
	knob.Size = UDim2.fromOffset(14, 14)
	knob.BackgroundColor3 = if on then C.ownedValue else C.soft
	knob.BackgroundTransparency = 0
	Common.corner(knob, 0.5)
	b:SetAttribute("State", if on then "owned" else "can")
	local layer = ctx.layer
	local render = ctx.render
	Kit.onPress(b, function()
		hideOwned[layer] = not hideOwned[layer]
		if render then render:refresh() end
	end)
end

-- the shared skin: returns true when it drew the node
function P.skin(rec: any, n: any, ctx: any): boolean
	if ctx.mode == "COMPACT" then return false end -- phones fold the owned upgrades into one row (Skins/Upgrade)
	if n.cn == "upgrades" and (n.t == "col" or n.t == "row") then
		Generic.skin(rec, n, ctx)
		toggle(rec, ctx)
		return true
	end
	if not hideOwned[ctx.layer] then return false end
	if rec.kind == "btn:upg" and n.cls == "bought" then
		local b = rec.root :: GuiObject
		b.Visible = false
		Common.state(b, "owned")
		return true
	end
	if n.t == "row" then
		local p = parentNode(ctx, rec.id)
		if type(p) == "table" and p.cn == "upgrades" and Upgrade.tierOwned(ctx.store, rec.id, ctx.cache) then
			(rec.root :: GuiObject).Visible = false
			return true
		end
	end
	return false
end

-- p: sky-blue stripes across the header band
function P.stripes(sheet: Frame, ctx: any)
	local band = Kit.band(sheet)
	if band == nil then return end
	local a = Kit.accent(band, "P")
	Kit.stripes(a, Theme.lift(ctx.hue, 0.3), 0.06, 22)
end

-- hp: a frost glow in the header's right corner
local function frost(sheet: Frame, ctx: any)
	local band = Kit.band(sheet)
	if band == nil then return end
	local a = Kit.accent(band, "Hp")
	a.ClipsDescendants = true
	local blob = Common.blob(a, "Frost", Theme.lift(ctx.hue, 0.5), 0.35)
	if blob then
		blob.AnchorPoint = Vector2.new(0.5, 0.5)
		blob.Position = UDim2.new(1, -120, 0, 0)
		blob.Size = UDim2.fromOffset(420, 220)
	end
end

return {
	{ layers = { "p" }, skin = P.skin, accent = P.stripes },
	{ layers = { "hp" }, skin = P.skin, accent = frost },
	P = P,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="165">
            <Properties>
              <string name="Name">Pp</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Pp: Prestige Power (DESIGN.md 6 row pp).

	    hero     "X Hz" (the game's own Hz value, as sent) over an oscilloscope strip in the free slot between the
	             resource block and the CTA; the wave scrolls (frozen with reduced motion). The source line leaves the
	             body.
	    accent   crimson-pink header stripes
	The Power Scaler buyable and the upgrades keep the template (P.skin: Hide owned).
]]

local Client = script.Parent.Parent
local Core = Client:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Motion = require(Core:WaitForChild("Motion"))
local PanelF = Client:WaitForChild("Panel")
local Common = require(PanelF:WaitForChild("Skins"):WaitForChild("Common"))
local Kit = require(script.Parent:WaitForChild("Kit"))
local P = (require(script.Parent:WaitForChild("P")) :: any).P

local C = Theme.C
local W, H, DOTS = 200, 38, 14

local function hzLine(h: string): boolean
	return string.find(h, "Hz powerful", 1, true) ~= nil
end

local function hero(f: Frame, store: any, ctx: any)
	local a = Kit.accent(f, "Pp")
	local line = Kit.line(store, hzLine)
	local hz = if line then string.match(Common.plain(line), "is%s+(%S+)%s+Hz") else nil
	local slot = if hz then Kit.heroSlot(a, "Scope", 230, 140) else nil
	if slot == nil then
		Common.drop(a, "Scope")
		return
	end
	local s = slot :: Frame
	local hue = Theme.textHue(ctx.layer)
	local value = Common.label(s, "Value", "numberHeavy", C.text, { wrap = false, align = Enum.TextXAlignment.Center })
	value.Position = UDim2.fromOffset(0, 4)
	Common.setText(value, Common.num((hz :: string) .. " Hz", "numberHeavy", C.text))
	-- the strip: two periods of dots on a sine, slid left forever (one write a frame)
	local strip = Common.get(s, "Strip", "Frame") :: Frame
	strip.Active = false
	strip.Position = UDim2.fromOffset(15, 40)
	strip.Size = UDim2.fromOffset(W, H + 16)
	strip.BackgroundColor3 = C.deep
	strip.BackgroundTransparency = 0.1
	strip.ClipsDescendants = true
	Common.corner(strip, 10)
	Common.stroke(strip, 1, hue, 0.5)
	local wave = strip:FindFirstChild("Wave") :: Frame?
	if wave == nil then
		local w = Instance.new("Frame")
		w.Name = "Wave"
		w.Active = false
		w.BackgroundTransparency = 1
		w.Size = UDim2.fromOffset(2 * W, H + 16)
		for i = 0, 2 * DOTS - 1 do
			local d = Instance.new("Frame")
			d.Name = "D" .. i
			d.Active = false
			d.BorderSizePixel = 0
			d.AnchorPoint = Vector2.new(0.5, 0.5)
			local x = (i + 0.5) * W / DOTS
			d.Position = UDim2.fromOffset(x, 8 + H / 2 - math.sin(x / W * 2 * math.pi * 2) * H / 2)
			d.Size = UDim2.fromOffset(5, 5)
			d.BackgroundColor3 = hue
			d.Parent = w
		end
		w.Parent = strip
		local x = 0
		Motion.loop(w, function(dt: number)
			if Motion.reduced() then return end
			x = (x + dt * 60) % W
			w.Position = UDim2.fromOffset(-x, 0)
		end)
	end
	local cap = Common.get(s, "Cap", "TextLabel") :: TextLabel
	cap.Active = false
	Common.text(cap, "caps", C.soft)
	cap.Position = UDim2.fromOffset(0, 104)
	cap.Size = UDim2.new(1, 0, 0, 18)
	cap.TextXAlignment = Enum.TextXAlignment.Center
	Common.setText(cap, Common.caps("Prestige power"))
end

local function accent(sheet: Frame, ctx: any)
	local band = Kit.band(sheet)
	if band == nil then return end
	Kit.stripes(Kit.accent(band, "Pp"), Theme.lift(ctx.hue, 0.2), 0.06, 22)
end

return {
	layers = { "pp" },
	skin = P.skin,
	hero = hero,
	accent = accent,
	claims = ({ { match = { cn = "display-text" }, make = Kit.noteClaim(hzLine) } } :: { any }),
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="166">
            <Properties>
              <string name="Name">Signatures</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Signatures: the per-layer plug-ins of the panel template (plan 2.6, DESIGN.md 6) and the default one.

	    Signatures.register(sig)     a sibling module (Signatures/<X>.luau, packages J1 / J2) registers its tables
	    Signatures.get(key)          the signature of a layer ("m", "p", ..., "options-tab"); the default when none
	    Signatures.title(key, node)  the panel title, CTA word, sub-row line, tree row and short unit helpers the
	    Signatures.cta(key) ...      default signature uses (client labels, never game data: plan P10)

	Every sibling ModuleScript is required once, on the first get(): J1 and J2 add files and never edit this one.
	A signature that fails to load is skipped (with a warning), so one bad file never blanks a panel.

	A signature table (Types.Signature):
	    layers     { "m", "mm" }        the keys it serves
	    cta        "GET +1 MILESTONE"   the CTA word (default: the table below)
	    subRow     "The root of the tree"   the sentence-case line next to the ROW chip
	    corrupted  true                 the D 5.2 corrupted treatment (cp, cm)
	    hug        true                 the sheet hugs its content (min 560 du)
	    order      { "milestones", ... } section order override, by cn
	    hero       fn(hero, store, ctx) adds the hero idea after the default hero drew (called on every update)
	    accent     fn(sheet, ctx)       watermark / tile / rim variant (called when the panel opens or relayouts)
	    claims     { {match = {cn, ci?, sub?, depth?}, make = fn(ph, id, store, ctx) -> Claim} }
	    skin       fn(rec, n, ctx) -> boolean   a per-layer skin that runs before the default skins; true = handled
]]

local Types = require(script.Parent.Parent:WaitForChild("Types"))

type Signature = Types.Signature

-- the context every skin, claim and hero hook receives (a superset of Types.SkinCtx)
export type Ctx = {
	layer: string, -- the panel key: a layer id or "options-tab"
	sub: string?, -- the current subtab ("Main", "Upgrades", ...)
	hue: Color3,
	mode: string, -- Layout.mode
	signature: any,
	act: (action: Types.Action, hold: boolean?) -> (),
	store: any, -- the ViewStore
	render: any, -- the Renderer (skins look up parent records through render.recs)
	s: number, -- Layout.s
	contentW: number, -- the body's content width (du)
	cardW: number, -- the upgrade card width (du)
	corrupted: boolean,
	detail: (card: any) -> (), -- the touch detail sheet (panel.detail)
	firstSeen: (key: string) -> boolean, -- true the first time an animation key is seen since the panel opened
	cache: { [string]: any }, -- per-apply memo (fresh for every Render apply)
	scroll: ScrollingFrame, -- the body's scrolling frame (virtual lists follow it)
}

local Signatures = {}

-- ------------------------------------------------------------------------------------------------------ labels
-- panel titles (the map node's name is the fallback; pm keeps its masked name as sent)
local TITLE: { [string]: string } = {
	m = "Milestone", mm = "Meta Milestone", em = "Extra Milestone", p = "Prestige", pe = "Prestige Energy",
	sp = "Super Prestige", pb = "Prestige Boost", pp = "Prestige Power", se = "Super Energy", hp = "Hyper Prestige",
	ep = "Exotic Prestige", hb = "Hyper Boost", ap = "Atomic Prestige", mp = "Multiverse", t = "Transcend",
	ach = "Achievements", pep = "Prestiged Exotic", cp = "Corrupted Prestige", cm = "Corrupted Milestone",
	ex = "Exploration", ["options-tab"] = "Options",
}
-- the CTA word (plan P10: a label, not game data)
local CTA: { [string]: string } = {
	m = "GET +1 MILESTONE", mm = "GET +1", em = "GET +1", pm = "GET +1", cm = "GET +1",
	pe = "COLLECT", se = "COLLECT", ex = "EXPLORE", cp = "CORRUPT",
	pb = "GET", hb = "GET", mp = "GET", pep = "GET",
}
-- the sentence-case line of the sub row
local SUBROW: { [string]: string } = {
	m = "The root of the tree", mm = "Resets for meta milestones", em = "Resets for extra milestones",
	p = "Resets for prestige points", pe = "Collects prestige energy", sp = "Resets for super prestige points",
	pb = "Resets for prestige boosts", pp = "Resets for prestige power", se = "Collects super energy",
	hp = "Resets for hyper prestige points", ep = "Resets for exotic prestige points", hb = "Resets for hyper boosts",
	ap = "Resets for atomic prestige points", mp = "Resets for multiverse points", t = "Resets for transcend points",
	ach = "Your trophies", pm = "Resets for prestige milestones", pep = "Resets for prestiged exotic points",
	cp = "Corrupts prestige points", cm = "Resets for corrupted milestones", ex = "Explores the zones",
	["options-tab"] = "Your save and this device",
}
-- the game's tree rows (layers/*.js `row`); "side" layers have no chip
local ROW: { [string]: number } = {
	m = 0, pm = 0, mm = 1, p = 1, cm = 1, cp = 1, pep = 1, em = 2, pe = 2, sp = 2, pb = 2, pp = 2, ex = 2,
	se = 3, hp = 3, ep = 3, hb = 4, ap = 4, mp = 4, t = 5,
}
-- short units for resource names (the client's abbreviation table, plan 1.13)
local UNIT: { [string]: string } = {
	["prestige points"] = "PP", ["super-prestige points"] = "SP", ["hyper-prestige points"] = "HP",
	["exotic prestige points"] = "EP", ["atomic-prestige points"] = "AP", ["multiverse prestige points"] = "MP",
	["transcend points"] = "TP", ["prestige energy"] = "PE", ["super energy"] = "SE", ["prestige power"] = "PW",
	["prestige boosts"] = "PB", ["hyper boosts"] = "HB", ["prestiged-exotic prestige points"] = "PEP",
	["exploration points"] = "EX", ["prestige essence"] = "PE", ["prestige essences"] = "PE",
	["corruption essences"] = "CE", ["corrupted milestones"] = "CM", ["milestones"] = "M",
	["meta-milestones"] = "MM", ["extra-milestones"] = "EM", ["points"] = "points",
	-- Prestige Power's upgrades cost its rate ("Hz of Prestige Power"): the hero shows it as "X Hz"
	["hz of prestige power"] = "Hz",
}

function Signatures.title(key: string, node: any?): string
	if key == "pm" and node and type(node.name) == "string" then return node.name end
	return TITLE[key] or (if node and type(node.name) == "string" then node.name else string.upper(key))
end
function Signatures.row(key: string): number?
	return ROW[key]
end
-- a resource name -> its short unit ("prestige points" -> "PP"); the name itself when unknown
function Signatures.unit(res: string?): string
	if type(res) ~= "string" then return "" end
	local k = string.lower((string.gsub(string.gsub(res, "<[^>]*>", ""), "^%s+", "")))
	k = string.gsub(k, "%s+$", "")
	return UNIT[k] or k
end

-- ------------------------------------------------------------------------------------------------------ registry
local registry: { [string]: Signature } = {}
local loaded = false

local DEFAULT: Signature = {
	layers = {},
	cta = nil,
	subRow = nil,
	corrupted = nil,
	hug = nil,
	order = nil,
	hero = nil,
	accent = nil,
	claims = nil,
	skin = nil,
}
Signatures.DEFAULT = DEFAULT

function Signatures.register(sig: Signature)
	if type(sig) ~= "table" or type(sig.layers) ~= "table" then return end
	for _, l in sig.layers do
		if type(l) == "string" then registry[l] = sig end
	end
end

-- require every sibling once (auto-registration); a module may return a Signature or a list of them
local function loadAll()
	if loaded then return end
	loaded = true
	for _, m in script.Parent:GetChildren() do
		if m ~= script and m:IsA("ModuleScript") then
			local ok, res = pcall(require, m)
			if not ok then
				warn("[MilestoneTree] signature " .. m.Name .. " failed to load: " .. tostring(res))
				continue
			end
			if type(res) == "table" then
				local r: any = res
				if type(r.layers) == "table" then
					Signatures.register(r)
				else
					for _, s in r do
						if type(s) == "table" and type(s.layers) == "table" then Signatures.register(s) end
					end
				end
			end
		end
	end
end

function Signatures.get(key: string): Signature
	loadAll()
	return registry[key] or DEFAULT
end

-- the CTA word of a layer: the signature's, else the default table, else PRESTIGE
function Signatures.cta(key: string): string
	local sig = Signatures.get(key)
	return sig.cta or CTA[key] or "PRESTIGE"
end
function Signatures.subRow(key: string): string?
	local sig = Signatures.get(key)
	return sig.subRow or SUBROW[key]
end
-- corrupted treatment: the signature's flag, else cp / cm
function Signatures.corrupted(key: string): boolean
	local sig = Signatures.get(key)
	if sig.corrupted ~= nil then return sig.corrupted == true end
	return key == "cp" or key == "cm"
end

return Signatures
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="167">
            <Properties>
              <string name="Name">Sp</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Sp: Super Prestige (DESIGN.md 6 row sp, 6.1 "sp furnace").

	    Main              the tier board (P.skin: Hide owned)
	    malware tabs      an ember rim over the sheet (Prestige Ashes, Spark Milestones); an infected layer (the resource
	                      name says so) rings the emblem in danger
	    hero              PRESTIGE ASHES as a stat chip under the CTA (the game's highlighted number, as sent)
	    Spark Milestones  the FURNACE: the game's unlock box as a titled card (ember orb, ASHES FILLED with the bar,
	                      "3 / 3 unlocked", IGNITE with its auto-fill state, REIGNITE #n with its cost);
	                      SPARK MILESTONES: one card per milestone with its burn bar (BURNING in flame colours with the
	                      burning %, ASHED grey, PERMANENT gold "Skipped when burning"), the "Show: N" cycler in the title
	                      row (one press, the clickable's own action); the pager « ‹ Page a / b › », hidden on one page
	Every button fires its clickable's own action.
]]

local Client = script.Parent.Parent
local Core = Client:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Rich = require(Core:WaitForChild("Rich"))
local Layout = require(Core:WaitForChild("Layout"))
local PanelF = Client:WaitForChild("Panel")
local Common = require(PanelF:WaitForChild("Skins"):WaitForChild("Common"))
local Sections = require(PanelF:WaitForChild("Sections"))
local Kit = require(script.Parent:WaitForChild("Kit"))
local P = (require(script.Parent:WaitForChild("P")) :: any).P
local M = require(script.Parent:WaitForChild("M")) :: any

local C = Theme.C
local SPARK = "Spark Milestones"

local function trim(s: string): string
	return (string.gsub(string.gsub(s, "^%s+", ""), "%s+$", ""))
end
local function plainOf(n: any): string
	return trim(Common.plain(if type(n) == "table" then n.h else ""))
end
-- a clickable node's action at press time
local function fire(ctx: any, store: any, id: string)
	local n = store:get(id)
	if type(n) == "table" and type(n.a) == "table" then ctx.act(n.a, false) end
end

-- ------------------------------------------------------------------------------------------------------ furnace
local function furnace(ph: Frame, id: string, store: any, ctx: any): any
	local claim = {}
	ph.Size = UDim2.new(1, 0, 0, 0)
	ph.AutomaticSize = Enum.AutomaticSize.Y
	function claim.update(_: any, st: any)
		store = st or store
		local compact = Layout.mode == "COMPACT"
		local ember = C.ember
		local card = Kit.card(ph, "Furnace", { gap = 12, pad = if compact then 12 else 18, fill = Theme.mix(C.panel, ember, 0.14),
			stroke = ember, strokeT = 0.2, radius = 16 })
		-- the game's texts: the unlock line, the ashes pair and the unlocked pair (as sent)
		local info, have, need, unl, tot = "", nil :: string?, nil :: string?, nil :: string?, nil :: string?
		local buttons: { string } = {}
		for _, cid in st:kids(id) do
			local n = st:get(cid)
			if type(n) ~= "table" then continue end
			if n.t == "btn" and n.k == "click" then
				table.insert(buttons, cid)
			elseif n.t == "html" then
				local t = plainOf(n)
				if t ~= "" then
					local a, b = string.match(t, "([%d%.,e%+]+)%s*/%s*([%d%.,e%+]+)%s*Prestige Ashes")
					if a then have, need = a, b end
					local u, v = string.match(t, "Unlocked%s+(%d+)%s*/%s*(%d+)")
					if u then unl, tot = u, v end
					local head = string.match(t, "^(.-):")
					if head and info == "" then info = trim(head) end
				end
			end
		end
		-- the head: ember orb, the title and ASHES FILLED
		local head = Common.label(card, "Head", "body", C.text, { order = 1 })
		Common.pad(head, 0, if unl then 130 else 0, 0, 62, "Clear")
		local lines = { Common.title(if info ~= "" then info else "Spark furnace", "card", C.text) }
		if have and need then
			table.insert(lines, Common.caps("Ashes filled", C.soft) .. "   " .. Common.num(have .. " / " .. need, "number", C.text, "ashes"))
		end
		Common.setText(head, table.concat(lines, "\n"))
		local orb = Common.get(head, "Orb", "Frame") :: Frame
		orb.Active = false
		orb.Size = UDim2.fromOffset(48, 48)
		orb.Position = UDim2.fromOffset(-62, 0)
		Common.corner(orb, 0.5)
		orb.BackgroundColor3 = ember
		orb.BackgroundTransparency = 0
		Common.stroke(orb, 2, Theme.lift(ember, 0.45), 0)
		Common.glow(orb, ember, 0.55, 14)
		local core = Common.get(orb, "Core", "Frame") :: Frame
		core.Active = false
		core.AnchorPoint = Vector2.new(0.5, 0.5)
		core.Position = UDim2.fromScale(0.5, 0.58)
		core.Size = UDim2.fromOffset(18, 22)
		core.BackgroundColor3 = C.ready
		core.BackgroundTransparency = 0
		Common.corner(core, 0.5)
		if unl and tot then
			local chip = Common.chip(head, "Unlocked", unl .. " / " .. tot .. " unlocked", { color = C.ink, bg = C.gold, bgT = 0, h = 28 })
			chip.AnchorPoint = Vector2.new(1, 0)
			chip.Position = UDim2.new(1, 130, 0, 0)
		else
			Common.drop(head, "Unlocked")
		end
		-- the ashes bar
		local p = 0
		local hn, nn = tonumber((string.gsub(have or "", ",", ""))), tonumber((string.gsub(need or "", ",", "")))
		if hn and nn and nn > 0 then p = math.clamp(hn / nn, 0, 1) end
		if have then
			local bar = Common.bar(card, "Bar", p, Theme.lift(ember, 0.15), 8)
			bar.LayoutOrder = 2
		else
			Common.drop(card, "Bar")
		end
		-- IGNITE (with its auto-fill state) and REIGNITE #n (with its cost)
		local row = Kit.stack(card, "Buttons", true, 10, 3)
		local list = row:FindFirstChild("List") :: UIListLayout?
		if list then list.Wraps = true end
		local used: { [string]: boolean } = { List = true }
		for i, cid in buttons do
			local n = st:get(cid)
			local t = Common.plain(Common.str(n.ti) or n.h or "")
			local num = string.match(t, "#(%d+)")
			local can = n.cls == "can"
			local text: string
			local fill: Color3
			if num then
				local cost = string.match(n.h or "", "<b>([^<]+)</b>")
				text = Common.run(Common.esc(Rich.caps("Reignite") .. " #" .. num), "label", C.text)
				if cost then text ..= "   " .. Common.num(trim(cost), "number", C.text, "ashes") end
				fill = if can then Theme.mix(C.panel, ember, 0.45) else C.panel3
			else
				local auto = string.match(Common.plain(n.h or ""), "Auto%-fill:%s*(%u+)")
				text = Common.run(Common.esc("IGNITE"), "tab", if can then C.ink else C.text)
				if auto then
					text ..= "    " .. Common.run(Common.esc("Auto-fill " .. auto), "label", if can then C.ink else C.soft)
				end
				fill = if can then ember else C.panel3
			end
			local name = "B" .. i
			used[name] = true
			local b = Kit.button(row, name, text, { fill = fill, stroke = if can then Theme.lift(ember, 0.4) else C.stroke, h = 42, order = i })
			Common.state(b, if can then "can" else "notyet")
			Kit.onPress(b, function()
				fire(ctx, store, cid)
			end)
		end
		for _, c in row:GetChildren() do
			if c:IsA("GuiObject") and not used[c.Name] then c:Destroy() end
		end
	end
	function claim.destroy(_: any)
		Common.drop(ph, "Furnace")
	end
	return claim
end

-- ------------------------------------------------------------------------------------------------------ sparks
local STATE_COL = { burning = C.ember, ashed = C.muted, permanent = C.gold }

local function sparkList(ph: Frame, id: string, store: any, ctx: any): any
	local claim = {}
	ph.Size = UDim2.new(1, 0, 0, 0)
	ph.AutomaticSize = Enum.AutomaticSize.Y
	Common.list(ph, false, 12)
	function claim.update(_: any, st: any)
		store = st or store
		local compact = Layout.mode == "COMPACT"
		-- each row: a spark milestone and its burn bar
		local items: { { ms: any, bar: any, key: string } } = {}
		for _, rid in st:kids(id) do
			local r = st:get(rid)
			if type(r) ~= "table" then continue end
			local ms, bar = nil, nil
			local function take(x: any)
				if type(x) ~= "table" then return end
				if x.t == "ms" then ms = x elseif x.t == "bar" then bar = x end
			end
			take(r)
			for _, kid in st:kids(rid) do take(st:get(kid)) end
			if ms then table.insert(items, { ms = ms, bar = bar, key = rid }) end
		end
		local ashed, perm = 0, 0
		for _, it in items do
			local s8 = if it.bar then it.bar.st8 else nil
			if s8 == "ashed" then ashed += 1 elseif s8 == "permanent" then perm += 1 end
		end
		local chips: { any } = { { text = ashed .. " / " .. #items .. " ashed", color = C.text, bg = Theme.mix(C.deep, C.ember, 0.3), bgT = 0 } }
		if perm > 0 then table.insert(chips, { text = perm .. " permanent", color = C.ink, bg = C.gold, bgT = 0 }) end
		local header = Sections.header(ph, { name = "Head", order = 0, text = "SPARK MILESTONES", hue = C.ember, chips = chips })
		-- the SHOW cycler: the "Show Multiple Milestones" clickable next to the list (one press)
		local showId = Kit.find(st, Common.parentId(id) or "tab", function(n: any): boolean
			return n.t == "btn" and n.k == "click" and string.find(Common.plain(n.h or ""), "Show Multiple", 1, true) ~= nil
		end, 1)
		if showId then
			local sn = st:get(showId)
			local cur = string.match(Common.plain(sn.h or ""), "Currently:%s*(%d+)") or "?"
			local b = Kit.headerControl(header, "Show", Common.run(Common.esc("Show: "), "label", C.soft)
				.. Common.num(cur, "number", C.text) .. Common.run("  ›", "label", C.soft), 110, { fill = C.panel2, stroke = C.stroke })
			Common.state(b, "can")
			Kit.onPress(b, function()
				fire(ctx, store, showId)
			end)
		else
			Common.drop(header, "Show")
		end
		local used: { [string]: boolean } = { Head = true, List = true }
		for i, it in items do
			local name = "S" .. i
			used[name] = true
			local s8 = if it.bar then (it.bar.st8 or "burning") else "none"
			local col = STATE_COL[s8] or ctx.hue
			local card = Common.get(ph, name, "Frame") :: Frame
			card.LayoutOrder = i
			card.Active = false
			card.Size = UDim2.new(1, 0, 0, 0)
			card.AutomaticSize = Enum.AutomaticSize.Y
			card.BackgroundColor3 = if s8 == "ashed" then C.panel2 else Theme.mix(C.panel, col, 0.12)
			card.BackgroundTransparency = 0
			Common.corner(card, 14)
			Common.stroke(card, if s8 == "ashed" then 1 else 1.5, col, if s8 == "ashed" then 0.5 else 0.3)
			Common.pad(card, 14, 16, 14, if compact then 60 else 76)
			-- the milestone: title, effect, "Currently"
			local barW = if compact then 180 else 320
			local t = Common.label(card, "Text", "body", C.text, { order = 1 })
			t.Size = UDim2.new(1, -(barW + 16), 0, 0)
			local ms = it.ms
			local parts = { Common.title(Common.plain(Common.str(ms.ti) or ""), "card", C.text) }
			local ds = Common.html(ms.ds, "body", ctx.layer)
			if ds ~= "" then table.insert(parts, string.format('<font transparency="%.2f">%s</font>', if s8 == "ashed" then 0.18 else 0.08, ds)) end
			local tip = Common.plain(Common.str(ms.tip) or "")
			if tip ~= "" then
				local v = string.match(tip, "^Currently:%s*(.*)$")
				table.insert(parts, Common.caps("Currently", C.soft) .. "   " .. Common.num(trim(v or tip), "number", C.text))
			end
			Common.setText(t, table.concat(parts, "\n"))
			-- the number disc
			local disc = Common.get(card, "Disc", "TextLabel") :: TextLabel
			disc.Active = false
			disc.Size = UDim2.fromOffset(if compact then 40 else 52, if compact then 40 else 52)
			disc.Position = UDim2.fromOffset(if compact then -50 else -64, 0)
			Common.text(disc, "label", if s8 == "ashed" then C.soft else C.ink)
			disc.TextXAlignment = Enum.TextXAlignment.Center
			disc.TextYAlignment = Enum.TextYAlignment.Center
			disc.BackgroundColor3 = if s8 == "ashed" then C.panel3 else col
			disc.BackgroundTransparency = 0
			Common.corner(disc, 0.5)
			Common.setText(disc, "#" .. (string.match(Common.plain(Common.str(ms.ti) or ""), "#(%d+)") or tostring(i)))
			-- the burn state and bar
			local bar = it.bar
			if bar then
				local state = Common.get(card, "State", "TextLabel") :: TextLabel
				state.Active = false
				Common.text(state, "caps", col)
				state.AnchorPoint = Vector2.new(1, 0)
				state.Position = UDim2.new(1, 0, 0, 2)
				state.Size = UDim2.fromOffset(barW, 20)
				state.TextXAlignment = Enum.TextXAlignment.Left
				state.TextYAlignment = Enum.TextYAlignment.Center
				local word = if s8 == "permanent" then "Permanent" elseif s8 == "ashed" then "Ashed" else "Burning"
				local right = ""
				if s8 == "permanent" then
					right = Common.run(Common.esc("Skipped when burning"), "small", C.soft)
				else
					local bp = Common.pr(bar.bp)
					right = Common.num(Rich.pct(if s8 == "ashed" then 0 else (bp or 0)), "number", C.text)
				end
				Common.setText(state, Common.caps(word, if s8 == "ashed" then C.soft else Theme.lift(col, 0.2)))
				local r = Common.get(state, "Right", "TextLabel") :: TextLabel
				r.Active = false
				Common.text(r, "number", C.text)
				r.Size = UDim2.fromScale(1, 1)
				r.TextXAlignment = Enum.TextXAlignment.Right
				r.TextYAlignment = Enum.TextYAlignment.Center
				Common.setText(r, right)
				local p = if s8 == "permanent" then 1 elseif s8 == "ashed" then 0 else (Common.pr(bar.bp) or math.clamp(tonumber(bar.p) or 0, 0, 1))
				local b = Common.bar(card, "Burn", p, if s8 == "permanent" then C.gold else C.ember, 8)
				b.AnchorPoint = Vector2.new(1, 0)
				b.Position = UDim2.new(1, 0, 0, 30)
				b.Size = UDim2.fromOffset(barW, 8)
				if s8 == "burning" and p > 0.001 and p < 0.999 then
					local g = b:FindFirstChild("Fill") :: UIGradient?
					if g then
						local track = Color3.fromRGB(52, 46, 72)
						g.Color = ColorSequence.new({
							ColorSequenceKeypoint.new(0, C.gold),
							ColorSequenceKeypoint.new(p * 0.6, C.ember),
							ColorSequenceKeypoint.new(p, C.danger),
							ColorSequenceKeypoint.new(math.min(1, p + 0.001), track),
							ColorSequenceKeypoint.new(1, track),
						})
					end
				end
			else
				Common.drop(card, "State")
				Common.drop(card, "Burn")
			end
			Common.state(card, if s8 == "ashed" then "notyet" else "owned")
		end
		for _, c in ph:GetChildren() do
			if c:IsA("GuiObject") and not used[c.Name] then c:Destroy() end
		end
	end
	function claim.destroy(_: any)
		for _, c in ph:GetChildren() do c:Destroy() end
	end
	return claim
end

-- ------------------------------------------------------------------------------------------------------ pager
local function pager(ph: Frame, id: string, store: any, ctx: any): any
	local claim = {}
	function claim.update(_: any, st: any)
		store = st or store
		local keys: { string } = {}
		local page, pages = "1", "1"
		for _, cid in st:kids(id) do
			local n = st:get(cid)
			if type(n) ~= "table" then continue end
			if n.t == "btn" and n.k == "click" then
				table.insert(keys, cid)
			elseif n.t == "html" then
				local a, b = string.match(plainOf(n), "(%d+)%s*/%s*(%d+)")
				if a and b then page, pages = a, b end
			end
		end
		-- hidden when there is one page
		if pages == "1" or #keys == 0 then
			ph.Visible = false
			ph.Size = UDim2.new()
			ph.AutomaticSize = Enum.AutomaticSize.None
			for _, c in ph:GetChildren() do c:Destroy() end
			return
		end
		ph.Visible = true
		ph.Size = UDim2.new(1, 0, 0, 44)
		ph.AutomaticSize = Enum.AutomaticSize.None
		Common.list(ph, true, 8, { align = Enum.HorizontalAlignment.Center, valign = Enum.VerticalAlignment.Center })
		local half = #keys // 2
		for i, cid in keys do
			local n = st:get(cid)
			local t = trim(Common.plain(Common.str(n.ti) or n.h or ""))
			local b = Kit.button(ph, "K" .. i, Common.esc(t), { fill = if n.cls == "can" then Theme.mix(C.panel, ctx.hue, 0.4) else C.panel3,
				stroke = C.stroke, h = 44, w = 52, order = if i <= half then i else i + 1 })
			Common.state(b, if n.cls == "can" then "can" else "notyet")
			Kit.onPress(b, function()
				fire(ctx, store, cid)
			end)
		end
		local label = Common.label(ph, "Page", "label", C.text, { autoX = true, wrap = false, order = half + 1 })
		Common.setText(label, Common.esc("Page ") .. Common.num(page .. " / " .. pages, "number", C.text))
	end
	function claim.destroy(_: any)
		for _, c in ph:GetChildren() do c:Destroy() end
	end
	return claim
end

-- the Spark tab's display-text lines: the ashes line moves into the hero; the rest stay notes
local function sparkNote(ph: Frame, id: string, store: any, ctx: any): any
	local inner = M.noteClaim(ph, id, store, ctx)
	local claim = {}
	function claim.update(_: any, st: any)
		local n = st:get(id)
		local h = if type(n) == "table" and type(n.h) == "string" then n.h else ""
		if string.find(h, "<h2", 1, true) and string.find(h, "Prestige Ashes", 1, true) then
			ph.Visible = false
			ph.Size = UDim2.new()
			ph.AutomaticSize = Enum.AutomaticSize.None
			Common.drop(ph, "Text")
			return
		end
		inner.update(inner, st)
	end
	function claim.destroy(_: any)
		inner.destroy(inner)
	end
	return claim
end

-- the Spark tab's lone "Show Multiple Milestones" clickable: drawn in the SPARK MILESTONES title row instead
local function hidden(ph: Frame, id: string, store: any, ctx: any): any
	ph.Visible = false
	ph.Size = UDim2.new()
	ph.AutomaticSize = Enum.AutomaticSize.None
	return { update = function(_: any, _s: any) end, destroy = function(_: any) end }
end

-- ------------------------------------------------------------------------------------------------------ hero
local function hero(f: Frame, store: any, ctx: any)
	local a = Kit.accent(f, "Sp")
	-- PRESTIGE ASHES as a stat chip under the CTA and the stat chips
	local aid = Kit.find(store, "tab", function(n: any): boolean
		return n.cn == "display-text" and type(n.h) == "string" and string.find(n.h, "Prestige Ashes", 1, true) ~= nil
			and string.find(n.h, "<h2", 1, true) ~= nil
	end, 3)
	local ashes = if aid then Kit.h2(store:get(aid).h)[1] else nil
	if ashes and Layout.mode ~= "COMPACT" then
		local cta = f:FindFirstChild("Cta") :: GuiObject?
		local stats = f:FindFirstChild("Stats") :: GuiObject?
		local y = (if cta then cta.Size.Y.Offset + 10 else 0) + (if stats and stats.Visible then 42 else 0)
		local chip = Common.chip(a, "Ashes", Common.caps("Prestige ashes", C.soft) .. "   " .. Common.num(ashes, "number", Theme.lift(C.ember, 0.3)),
			{ rich = true, bg = C.panel2, bgT = 0, h = 34 })
		chip.AnchorPoint = Vector2.new(1, 0)
		chip.Position = UDim2.new(1, 0, 0, y)
	else
		Common.drop(a, "Ashes")
	end
	-- the malware tabs: an ember rim over the sheet; an infected layer rings the emblem in danger
	local sheet = f.Parent
	if sheet == nil then return end
	local malwareTab = ctx.sub ~= nil and ctx.sub ~= "Main"
	local md = Kit.find(store, "tab", function(n: any): boolean
		return n.cn == "main-display"
	end, 3)
	local infected = md ~= nil and string.find(string.lower(Common.plain(store:get(md).res or "")), "infected", 1, true) ~= nil
	if not malwareTab and not infected then
		Common.drop(sheet, "Accent")
		return
	end
	local sa = Kit.accent(sheet, "SpRim")
	if malwareTab and Layout.mode ~= "COMPACT" then
		local rim = Common.get(sa, "Rim", "Frame") :: Frame
		rim.Active = false
		rim.BackgroundTransparency = 1
		rim.Size = UDim2.fromScale(1, 1)
		rim.ZIndex = 4
		Common.corner(rim, 22)
		Common.stroke(rim, 3, C.ember, 0.1)
		Common.glow(rim, C.ember, 0.35, 22)
	else
		Common.drop(sa, "Rim")
	end
	local emblem = sheet:FindFirstChild("Emblem") :: GuiObject?
	if infected and emblem then
		local ring = Common.get(sa, "Infected", "Frame") :: Frame
		ring.Active = false
		ring.BackgroundTransparency = 1
		ring.ZIndex = 7
		ring.AnchorPoint = Vector2.new(0.5, 0.5)
		ring.Position = UDim2.fromOffset(emblem.Position.X.Offset + emblem.Size.X.Offset / 2, emblem.Position.Y.Offset + emblem.Size.Y.Offset / 2)
		ring.Size = UDim2.fromOffset(emblem.Size.X.Offset + 10, emblem.Size.Y.Offset + 10)
		Common.corner(ring, 0.5)
		Common.stroke(ring, 3, C.danger, 0)
		Common.glow(ring, C.danger, 0.5, 14)
	else
		Common.drop(sa, "Infected")
	end
end

return {
	layers = { "sp" },
	skin = P.skin,
	hero = hero,
	claims = ({
		{ match = { cn = "row", ci = 9, sub = SPARK }, make = furnace },
		{ match = { cn = "column", sub = SPARK }, make = sparkList },
		{ match = { cn = "row", ci = 15, sub = SPARK }, make = pager },
		{ match = { cn = "display-text", sub = SPARK, depth = 2 }, make = sparkNote },
		{ match = { cn = "clickable", sub = SPARK, depth = 2 }, make = hidden },
	} :: { any }),
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="168">
            <Properties>
              <string name="Name">T</string>
              <string name="Source"><![CDATA[--!strict
--[[
	T: Transcend (DESIGN.md 6 row t).

	    accent   the crown rays behind the emblem: a gold glow and 8 thin rays turning once in 30 s (still with reduced
	             motion)
	The challenges, the Upgrades tier board (P.skin: Hide owned) and the special points keep the template.
]]

local Client = script.Parent.Parent
local Core = Client:WaitForChild("Core")
local Theme = require(Core:WaitForChild("Theme"))
local Layout = require(Core:WaitForChild("Layout"))
local Motion = require(Core:WaitForChild("Motion"))
local PanelF = Client:WaitForChild("Panel")
local Common = require(PanelF:WaitForChild("Skins"):WaitForChild("Common"))
local Kit = require(script.Parent:WaitForChild("Kit"))
local P = (require(script.Parent:WaitForChild("P")) :: any).P

local function rays(sheet: Frame, ctx: any)
	local emblem = sheet:FindFirstChild("Emblem") :: GuiObject?
	if emblem == nil or Layout.mode == "COMPACT" then return end
	local a = Kit.accent(sheet, "T")
	local cx = emblem.Position.X.Offset + emblem.Size.X.Offset / 2
	local cy = emblem.Position.Y.Offset + emblem.Size.Y.Offset / 2
	local glow = Common.blob(a, "Glow", ctx.hue, 0.35)
	if glow then
		glow.AnchorPoint = Vector2.new(0.5, 0.5)
		glow.Position = UDim2.fromOffset(cx, cy)
		glow.Size = UDim2.fromOffset(200, 200)
	end
	local holder = Common.get(a, "Rays", "Frame") :: Frame
	holder.Active = false
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromOffset(cx, cy)
	holder.Size = UDim2.fromOffset(180, 180)
	for i = 1, 4 do
		local r = Common.get(holder, "Ray" .. i, "Frame") :: Frame
		r.Active = false
		r.AnchorPoint = Vector2.new(0.5, 0.5)
		r.Position = UDim2.fromScale(0.5, 0.5)
		r.Size = UDim2.fromOffset(170, 6)
		r.Rotation = (i - 1) * 45
		r.BackgroundColor3 = Theme.lift(ctx.hue, 0.3)
		r.BackgroundTransparency = 0
		local g = Common.get(r, "Fade", "UIGradient") :: UIGradient
		g.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, 0.55),
			NumberSequenceKeypoint.new(0.5, 1),
			NumberSequenceKeypoint.new(0.7, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		})
	end
	Motion.loop(holder, function(dt: number)
		if not Motion.reduced() then holder.Rotation = (holder.Rotation + dt * 12) % 360 end
	end)
end

return {
	layers = { "t" },
	skin = P.skin,
	accent = rays,
}
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="169">
          <Properties>
            <string name="Name">Style</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Style: the page's CSS as Roblox GUI properties. The look of each kind of button comes from the game's
	style.css (TMT + NG+): sizes, the locked / bought / can colours, borders and corners. The per-thing style objects
	the game sets (st in a view node) are applied on top with Style.apply.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Html = require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("Html"))

local Style = {}

Style.FONT = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)
Style.BG = Color3.fromRGB(15, 15, 15)            -- --background
Style.TEXT = Color3.fromRGB(223, 223, 223)       -- --color
Style.POINTS = Color3.fromRGB(255, 255, 255)     -- --points
Style.LOCKED = Color3.fromHex("bf8f8f")
Style.BOUGHT = Color3.fromHex("77bf5f")
Style.COMPLETE = Color3.fromHex("ffbf00")
Style.PERK = Color3.fromHex("fdbc30")
Style.PSEUDO = Color3.fromHex("fd3030")
Style.DARK = Color3.new(0, 0, 0)

-- per button kind: w / h (px, h = minimum height when grow), font (px), radius (px or scale when < 1),
-- stroke (px, rgba(0,0,0,0.125)), grow (height follows the text), text colour
export type Kind = { w: number?, h: number, font: number, radius: number, stroke: number, grow: boolean, text: Color3, align: Enum.TextXAlignment? }
local K: { [string]: Kind } = {
	upg = { w = 200, h = 115, font = 10, radius = 0, stroke = 2, grow = true, text = Style.DARK },
	perk = { w = 200, h = 115, font = 10, radius = 0, stroke = 2, grow = true, text = Color3.new(1, 1, 1) },
	click = { w = 200, h = 115, font = 10, radius = 0, stroke = 2, grow = true, text = Style.DARK },
	buy = { w = 200, h = 200, font = 10, radius = 0.25, stroke = 2, grow = true, text = Style.DARK },
	grid = { w = 80, h = 80, font = 10, radius = 0.15, stroke = 2, grow = true, text = Style.DARK },
	reset = { w = 250, h = 90, font = 13, radius = 0, stroke = 4, grow = true, text = Style.DARK },
	tab = { w = nil, h = 38, font = 20, radius = 10, stroke = 2, grow = false, text = Style.TEXT },
	toggle = { w = 40, h = 40, font = 12, radius = 0.25, stroke = 2, grow = false, text = Style.DARK },
	respec = { w = 120, h = 50, font = 10, radius = 0.1, stroke = 2, grow = true, text = Style.DARK },
	master = { w = 120, h = 50, font = 10, radius = 0.1, stroke = 2, grow = true, text = Style.DARK },
	sell = { w = 120, h = 50, font = 10, radius = 0.1, stroke = 2, grow = true, text = Style.DARK },
	chalbtn = { w = 120, h = 50, font = 12, radius = 0.1, stroke = 2, grow = true, text = Style.DARK },
	malware = { w = 260, h = 40, font = 12, radius = 0, stroke = 2, grow = true, text = Color3.new(1, 1, 1) },
	menu = { w = 285, h = 35, font = 18, radius = 0, stroke = 2, grow = false, text = Style.DARK },
	opt = { w = 250, h = 60, font = 13, radius = 0, stroke = 0, grow = true, text = Color3.new(1, 1, 1), align = Enum.TextXAlignment.Left },
}
Style.KIND = K

-- the background a button's class gives it (the game's own style / layer colour comes on top)
function Style.classColor(kind: string, cls: string?): Color3?
	if cls == "locked" or cls == "plocked" then return Style.LOCKED end
	if cls == "bought" then return Style.BOUGHT end
	if cls == "perk" then return Style.PERK end
	if cls == "perked" then return Style.DARK end
	if cls == "pseudo" then return Style.PSEUDO end
	if kind == "opt" then return Color3.fromRGB(22, 22, 22) end
	if kind == "menu" then return Color3.fromHex("a3a3a3") end
	if kind == "tab" then return nil end
	return Style.POINTS
end

local function child<T>(obj: Instance, class: string, name: string): any
	local c = obj:FindFirstChild(name)
	if c and c.ClassName == class then return c end
	if c then c:Destroy() end
	local n = Instance.new(class :: any)
	n.Name = name
	n.Parent = obj
	return n
end
Style.child = child

local function drop(obj: Instance, name: string)
	local c = obj:FindFirstChild(name)
	if c then c:Destroy() end
end
Style.drop = drop

function Style.corner(obj: GuiObject, r: number?)
	if r == nil or r == 0 then drop(obj, "Corner"); return end
	local c = child(obj, "UICorner", "Corner") :: UICorner
	c.CornerRadius = if r < 1 then UDim.new(r, 0) else UDim.new(0, r)   -- < 1: CSS percent / 100
end

function Style.stroke(obj: GuiObject, px: number?, color: Color3?, transparency: number?)
	if px == nil or px <= 0 then drop(obj, "Border"); return end
	local s = child(obj, "UIStroke", "Border") :: UIStroke
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Thickness = math.min(px, 6)
	s.Color = color or Style.DARK
	s.Transparency = transparency or 0.875
end

-- a glow for notify / resetNotify (the page uses a blurred box-shadow)
function Style.glow(obj: GuiObject, color: Color3?)
	if color == nil then drop(obj, "Glow"); return end
	local s = child(obj, "UIStroke", "Glow") :: UIStroke
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Thickness = 3
	s.Color = color
	s.Transparency = 0.1
end

function Style.pad(obj: GuiObject, px: number)
	local p = child(obj, "UIPadding", "Pad") :: UIPadding
	p.PaddingTop, p.PaddingBottom = UDim.new(0, px), UDim.new(0, px)
	p.PaddingLeft, p.PaddingRight = UDim.new(0, px), UDim.new(0, px)
end

-- linear-gradient(...) -> UIGradient. Stops in px (the game's progress-bar trick: colour A up to Npx, then B) are
-- turned into fractions of the element's width.
function Style.gradient(obj: GuiObject, css: string?, widthPx: number?)
	if css == nil or not string.find(css, "gradient") then drop(obj, "Gradient"); return false end
	local stops = Html.gradient(css)
	if #stops == 0 then drop(obj, "Gradient"); return false end
	local w = widthPx or 200
	local pts: { ColorSequenceKeypoint } = {}
	local lastT = -1
	local function add(t: number, c: Color3)
		t = math.clamp(t, 0, 1)
		if t <= lastT then t = math.min(1, lastT + 0.0005) end
		if t <= lastT then return end
		table.insert(pts, ColorSequenceKeypoint.new(t, c))
		lastT = t
	end
	for i, s in stops do
		local t: number
		if (s :: any).px ~= nil then t = (s :: any).px / w
		elseif s.stop ~= nil then t = s.stop
		else t = if #stops == 1 then 0 else (i - 1) / (#stops - 1) end
		if i > 1 and t < lastT then t = lastT end
		add(if i == 1 then 0 else t, s.c)
		if i == 1 and t > 0 then add(t, s.c) end
	end
	if lastT < 1 then add(1, stops[#stops].c) end
	if #pts < 2 then drop(obj, "Gradient"); obj.BackgroundColor3 = stops[1].c; return true end
	while #pts > 20 do table.remove(pts, (#pts - 1)) end -- keep the last stop
	local g = child(obj, "UIGradient", "Gradient") :: UIGradient
	g.Color = ColorSequence.new(pts)
	local dir = string.lower(css)
	g.Rotation = if string.find(dir, "to bottom") then 90 elseif string.find(dir, "to left") then 180 elseif string.find(dir, "to top") then 270 else 0
	obj.BackgroundColor3 = Color3.new(1, 1, 1)
	obj.BackgroundTransparency = 0
	return true
end

export type Applied = { w: number?, h: number?, minH: number?, font: number?, text: Color3?, textT: number?, hidden: boolean }

-- the game's style object on a GUI object: colours, border, corners; sizes and text are returned for the caller
function Style.apply(obj: GuiObject, st: { [string]: string }?, widthPx: number?): Applied
	local out: Applied = { hidden = false }
	if st == nil then drop(obj, "Gradient"); return out end
	local bgc = st["background-color"]
	local bg = st.background or st["background-image"]
	local w = Html.px(st.width, 16) or Html.px(st["min-width"], 16)
	out.w = w
	out.h = Html.px(st.height, 16)
	out.minH = Html.px(st["min-height"] or st.minHeight, 16)
	out.font = Html.px(st["font-size"], 16)
	if not Style.gradient(obj, bg, w or widthPx) then
		local c, t = Html.color(bgc or bg)
		if c then
			obj.BackgroundColor3 = c
			obj.BackgroundTransparency = t
		end
	end
	if st.color then
		local c, t = Html.color(st.color)
		if c then out.text = c; out.textT = t end
	end
	local border = st.border or st["border-width"]
	if border or st["border-color"] then
		local px = if border then (Html.px(string.match(border, "[%d%.]+px") or border, 16) or 2) else 2
		if border and string.find(border, "none") then px = 0 end
		local c, t = Html.color(st["border-color"] or border)
		Style.stroke(obj, px, c or Style.TEXT, if c then t else 0)
	end
	local r = st["border-radius"]
	if r then
		local pct = string.match(r, "^%s*([%d%.]+)%%")
		if pct then Style.corner(obj, math.clamp((tonumber(pct) or 0) / 100, 0, 0.5))
		else Style.corner(obj, Html.px(r, 16)) end
	end
	if st.opacity then
		local o = tonumber(st.opacity)
		if o then obj.BackgroundTransparency = 1 - (1 - obj.BackgroundTransparency) * o end
	end
	if st.visibility == "hidden" or st.display == "none" then out.hidden = true end
	return out
end

return Style
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="170">
          <Properties>
            <string name="Name">Types</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Types: the shapes every client module shares. The view contract of docs/design/IMPLEMENTATION_PLAN.md section 1
	(what the server sends) and the client's own records (section 2.4). No code.

	On the wire JS null arrives as a missing key (inside objects) or `false` (inside arrays), so every optional field
	is `T?` and readers treat nil, false and a missing key alike ("absent == null").
]]

export type Action = { any }
export type Rect = { x: number, y: number, w: number, h: number } -- abs space px (plan 2.9) unless a name says otherwise
export type Camera = { C: Vector2, z: number, V: Vector2, m: number } -- world px, world zoom, map points, device px per point

-- --------------------------------------------------------------------------------------------------- v.map (plan 1.2)
export type Branch = { to: string, col: string, w: number? }
export type Val = {
	t: string,
	can: boolean,
	lit: boolean,
	glow: boolean,
	pulse: boolean,
	pts: string?,
	res: string?,
	tip: string?,
	ra: Action?,
	req: string?,
	rres: string?,
	gain: string?,
	pr: number?, -- per mille (0..1000)
	tot: string?,
	gen: string?, -- the passive gain per second (formatted), while the layer generates on its own
}
export type MapNode = {
	t: string,
	id: string,
	show: boolean,
	dor: boolean,
	need: { r: string, n: string, have: string, pr: number? }?, -- a hidden layer: the count that reveals it
	unl: boolean?,
	col: string?,
	sym: string?,
	name: string?,
	st: { [string]: any }?,
	tab: string?,
	ch: number?,
	cur: boolean?,
	br: { Branch }?,
	a: Action?,
	val: Val?,
}
export type GateReq = { have: string, need: string, pr: number }
export type Gate = {
	t: string,
	show: boolean,
	inside: boolean,
	can: boolean,
	fin: boolean,
	h: string?,
	goal: string?,
	done: boolean,
	a: Action?,
	req: GateReq?,
	rs: { string },
}
export type MapState = {
	ok: boolean, -- false when the map root is missing or failed to build (then nodes is empty)
	inside: boolean,
	open: string?,
	close: Action?,
	opt: Action?,
	gate: Gate?,
	order: { string }, -- the 21 layers in the fixed map order
	nodes: { [string]: MapNode },
	ready: { string }, -- shown and pulsing (can prestige), map order
	canBuy: { string }, -- shown, glowing, not pulsing, map order
}

-- --------------------------------------------------------------------------------------------------- v.hud (plan 1.3)
export type HudWarn = { k: string, v: string, e: string }
export type HudState = {
	t: string,
	pts: string,
	name: string,
	gen: string?,
	dev: string?,
	pass: string?, -- the 2x Speed pass is on ("2×")
	off: string?,
	w: { HudWarn },
	wh: string?,
	x: string?,
	fr: boolean,
}

-- --------------------------------------------------------------------------------------------------- wire patch (plan 1.8)
export type Popup = {
	id: number?,
	title: string?,
	message: string?,
	type: string?,
	color: string?,
	bColor: string?,
	kind: string?, -- milestone | achievement | corruption | other (notices are kind "notice" on the client)
	layer: string?,
}
export type Patch = {
	set: { [string]: any }?,
	del: { string }?,
	full: boolean?,
	tab: string?,
	tabStyle: { [string]: string }?,
	keys: { string }?,
	ended: boolean?,
	pop: { Popup }?,
	notice: { string }?,
	save: string?, -- "saving" | "saved"
	unsaved: boolean?,
	fatal: string?,
	status: string?,
}
export type TabPatch = { set: { [string]: any }, del: { string }, full: boolean }
export type Changes = {
	full: boolean,
	map: boolean,
	hud: boolean,
	tab: boolean, -- a node under the tab root changed
	tabName: boolean, -- patch.tab moved
	keys: boolean,
	ended: boolean,
	mapIds: { [string]: true },
	tabPatch: TabPatch,
}
export type EndScreen = { win: string?, took: string?, again: Action?, keep: Action? }

-- --------------------------------------------------------------------------------------------------- client records
export type Prefs = {
	motion: string, -- SYSTEM | FULL | REDUCED
	detail: string, -- AUTO | HIGH | LOW
	labels: string, -- AUTO | ALWAYS | OFF
	size: number, -- 90 | 100 | 115
	weather: string, -- OFF | RESETS | AMBIENT
	guide: string, -- ON | OFF
	notation: string, -- SUFFIX | SCIENTIFIC
	tut: number, -- the tutorial's next step, 0 to 8 (8 = done)
	music: number, -- 0..100, steps of 10
	sfx: number,
	ambience: number,
	seenPrestige: { string }, -- layers whose first prestige has played
}
export type Mode = string -- "WIDE" | "MEDIUM" | "COMPACT"
export type Handle = { stop: (self: Handle) -> () }

-- the render integration (plan 2.5, 2.6)
export type SkinCtx = {
	layer: string,
	sub: string?,
	hue: Color3,
	mode: string,
	signature: any,
	act: (action: Action, hold: boolean?) -> (),
}
export type Claim = {
	update: (self: Claim, store: any) -> (),
	destroy: (self: Claim) -> (),
}
export type ClaimMatch = { cn: string, ci: number?, sub: string?, depth: number? }
export type ClaimRule = {
	match: ClaimMatch,
	make: (ph: Frame, id: string, store: any, ctx: SkinCtx) -> Claim,
}
export type Signature = {
	layers: { string },
	cta: string?,
	subRow: string?,
	corrupted: boolean?,
	hug: boolean?,
	order: { string }?,
	hero: ((hero: Frame, store: any, ctx: SkinCtx) -> ())?,
	accent: ((sheet: Frame, ctx: SkinCtx) -> ())?,
	claims: { ClaimRule }?,
	skin: ((rec: any, n: any, ctx: SkinCtx) -> boolean)?,
}

return {}
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>