      <Item class="Script" referent="50">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
--[[
	Milestone Tree NG+ on Roblox: server entry point.

	Each player gets their own game (the web game's JavaScript, transpiled to Luau, see Session and Game) running in
	their own Actor (the Worker in ServerStorage), so players' games run in parallel. This script owns the players,
	the remotes and the rate limits; the Worker owns the game and the save.

	Remotes (ReplicatedStorage.MilestoneTreeRemotes):
	  View    server -> client   screen patches (see Session:view)
	  Act     client -> server   (action, hold?) a button on the screen, or { "key", name } for a hotkey
	  Import  client -> server   (text) a pasted save string
	  Ready   client -> server   the client wants the whole screen (first load, UI rebuilt)
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local root = script.Parent
local Config = require(root:WaitForChild("Config"))

local remotes = Instance.new("Folder")
remotes.Name = "MilestoneTreeRemotes"
local function remote(name: string): RemoteEvent
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end
local viewRemote = remote("View")
local actRemote = remote("Act")
local importRemote = remote("Import")
local readyRemote = remote("Ready")
remotes.Parent = ReplicatedStorage

local sessionsFolder = Instance.new("Folder")
sessionsFolder.Name = "Sessions"
sessionsFolder.Parent = root

local template = ServerStorage:WaitForChild("MilestoneTreeWorker") :: Actor

type Entry = { actor: Actor, tokens: number, last: number, lastImport: number }
local entries: { [Player]: Entry } = {}

local function fatal(player: Player, text: string)
	warn("[MilestoneTree] " .. player.Name .. ": " .. text)
	viewRemote:FireClient(player, { fatal = text })
end

local function start(player: Player)
	if entries[player] then return end
	local a = template:Clone()
	a.Name = "Player_" .. player.UserId
	a.Parent = sessionsFolder
	local entry: Entry = { actor = a, tokens = Config.ACTIONS_PER_SECOND, last = os.clock(), lastImport = 0 }
	entries[player] = entry
	-- the Worker binds its messages when it starts running
	local t0 = os.clock()
	while not a:GetAttribute("Ready") and not a:GetAttribute("Error") and os.clock() - t0 < 30 do task.wait() end
	if a:GetAttribute("Error") then
		fatal(player, tostring(a:GetAttribute("Error")))
		return
	elseif not a:GetAttribute("Ready") then
		fatal(player, "The game did not start on the server within 30 seconds (see the Output window).")
		return
	end
	a:SendMessage("start", player)
end

local stopping = 0 -- saves in flight (BindToClose waits for them)

local function stop(player: Player)
	local entry = entries[player]
	if not entry then return end
	entries[player] = nil
	stopping += 1
	entry.actor:SendMessage("stop")
	local t0 = os.clock()
	while not entry.actor:GetAttribute("Stopped") and os.clock() - t0 < 30 do task.wait(0.1) end
	entry.actor:Destroy()
	stopping -= 1
end

Players.PlayerAdded:Connect(start)
Players.PlayerRemoving:Connect(stop)
for _, p in Players:GetPlayers() do task.spawn(start, p) end

-- a token bucket per player: holding a buyable fires 20 presses a second, a burst of clicks a few more
local function allow(entry: Entry): boolean
	local now = os.clock()
	entry.tokens = math.min(Config.ACTIONS_PER_SECOND, entry.tokens + (now - entry.last) * Config.ACTIONS_PER_SECOND)
	entry.last = now
	if entry.tokens < 1 then return false end
	entry.tokens -= 1
	return true
end

local function validAction(a: any): boolean
	if type(a) ~= "table" or #a < 1 or #a > 4 then return false end
	for k, v in a do
		if type(k) ~= "number" then return false end
		local tv = type(v)
		if tv == "string" then
			if #v > 100 then return false end
		elseif tv == "table" then
			if #v > 2 then return false end
			for _, w in v do if type(w) ~= "number" and type(w) ~= "string" then return false end end
		elseif tv ~= "number" then
			return false
		end
	end
	return type(a[1]) == "string"
end

actRemote.OnServerEvent:Connect(function(player: Player, a: any, hold: any)
	local entry = entries[player]
	if not entry or not validAction(a) or not allow(entry) then return end
	entry.actor:SendMessage("act", a, hold == true)
end)

importRemote.OnServerEvent:Connect(function(player: Player, text: any)
	local entry = entries[player]
	if not entry or type(text) ~= "string" or #text > 3000000 then return end
	if os.clock() - entry.lastImport < Config.IMPORT_COOLDOWN then return end
	entry.lastImport = os.clock()
	entry.actor:SendMessage("import", text)
end)

readyRemote.OnServerEvent:Connect(function(player: Player)
	local entry = entries[player]
	if not entry then return end
	if entry.actor:GetAttribute("Error") then
		fatal(player, tostring(entry.actor:GetAttribute("Error")))
	else
		entry.actor:SendMessage("resync")
	end
end)

game:BindToClose(function()
	for player in entries do task.spawn(stop, player) end
	local t0 = os.clock()
	task.wait(0.1)
	while stopping > 0 and os.clock() - t0 < 25 do task.wait(0.1) end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="51">
        <Properties>
          <string name="Name">Runtime</string>
        </Properties>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">BEcore</string>
            <string name="Source"><![CDATA[--!nocheck
-- BEcore: a line-for-line port of the component maths in the game's bundled break_eternity.js.
-- JSRT uses it only when a value is one of break_eternity's special forms (new Decimal(Infinity), Decimal.dInf,
-- and whatever arithmetic on them produces), where the old library's answers differ from any "correct" answer
-- and the game depends on them (e.g. Infinity-cost upgrades count as affordable once you have ee16).
-- Values are triples { s = sign, l = layer, m = mag }.
local abs, floor, log10, huge = math.abs, math.floor, math.log10, math.huge
local EXP_LIMIT = 9e15
local LAYER_DOWN = math.log10(9e15)
local FIRST_NEG_LAYER = 1 / 9e15
local MAX_SIG = 17

local BE = {}
local function sgn(x) if x > 0 then return 1 elseif x < 0 then return -1 elseif x == 0 then return 0 end return x end
local function finite(x) return x == x and x ~= huge and x ~= -huge end
local function pow10(x) return 10 ^ x end
BE.finite = finite

local function NN(s, l, m) return { s = s, l = l, m = m } end
local function normalize(t)
	if t.s == 0 or (t.m == 0 and t.l == 0) then t.s, t.m, t.l = 0, 0, 0; return t end
	if t.l == 0 and t.m < 0 then t.m = -t.m; t.s = -t.s end
	if t.l == 0 and t.m < FIRST_NEG_LAYER then t.l += 1; t.m = log10(t.m); return t end
	local absmag, signmag = abs(t.m), sgn(t.m)
	if absmag >= EXP_LIMIT then
		t.l += 1; t.m = signmag * log10(absmag); return t
	end
	while absmag < LAYER_DOWN and t.l > 0 do
		t.l -= 1
		if t.l == 0 then t.m = pow10(t.m)
		else t.m = signmag * pow10(absmag); absmag = abs(t.m); signmag = sgn(t.m) end
	end
	if t.l == 0 then
		if t.m < 0 then t.m = -t.m; t.s = -t.s
		elseif t.m == 0 then t.s = 0 end
	end
	return t
end
local function FC(s, l, m) return normalize(NN(s, l, m)) end
BE.NN, BE.FC, BE.normalize = NN, FC, normalize

local NaN = 0 / 0
local function dNaN() return NN(NaN, NaN, NaN) end
function BE.fromNumber(x)
	return normalize(NN(sgn(x), 0, abs(x)))
end

function BE.cmpabs(a, b)
	local la = if a.m > 0 then a.l else -a.l
	local lb = if b.m > 0 then b.l else -b.l
	if la > lb then return 1 end
	if la < lb then return -1 end
	if a.m > b.m then return 1 end
	if a.m < b.m then return -1 end
	return 0
end
function BE.cmp(a, b)
	if a.s > b.s then return 1 end
	if a.s < b.s then return -1 end
	return a.s * BE.cmpabs(a, b)
end
function BE.lt(a, b) return BE.cmp(a, b) == -1 end
function BE.gt(a, b) return BE.cmp(a, b) == 1 end
function BE.lte(a, b) return not BE.gt(a, b) end
function BE.gte(a, b) return not BE.lt(a, b) end
function BE.eq(a, b) return a.s == b.s and a.l == b.l and a.m == b.m end

function BE.neg(a) return NN(-a.s, a.l, a.m) end
function BE.abs(a) return NN(if a.s == 0 then 0 else 1, a.l, a.m) end

function BE.add(a0, b0)
	if not finite(a0.l) then return a0 end
	if not finite(b0.l) then return b0 end
	if a0.s == 0 then return b0 end
	if b0.s == 0 then return a0 end
	if a0.s == -b0.s and a0.l == b0.l and a0.m == b0.m then return NN(0, 0, 0) end
	if a0.l >= 2 or b0.l >= 2 then
		if BE.cmpabs(a0, b0) < 0 then return b0 end
		return a0
	end
	local a, b
	if BE.cmpabs(a0, b0) > 0 then a, b = a0, b0 else a, b = b0, a0 end
	if a.l == 0 and b.l == 0 then return BE.fromNumber(a.s * a.m + b.s * b.m) end
	local layera = a.l * sgn(a.m)
	local layerb = b.l * sgn(b.m)
	if layera - layerb >= 2 then return a end
	if layera == 0 and layerb == -1 then
		if abs(b.m - log10(a.m)) > MAX_SIG then return a end
		local magdiff = pow10(log10(a.m) - b.m)
		local mantissa = b.s + a.s * magdiff
		return FC(sgn(mantissa), 1, b.m + log10(abs(mantissa)))
	end
	if layera == 1 and layerb == 0 then
		if abs(a.m - log10(b.m)) > MAX_SIG then return a end
		local magdiff = pow10(a.m - log10(b.m))
		local mantissa = b.s + a.s * magdiff
		return FC(sgn(mantissa), 1, log10(b.m) + log10(abs(mantissa)))
	end
	if abs(a.m - b.m) > MAX_SIG then return a end
	local magdiff = pow10(a.m - b.m)
	local mantissa = b.s + a.s * magdiff
	return FC(sgn(mantissa), 1, b.m + log10(abs(mantissa)))
end
function BE.sub(a, b) return BE.add(a, BE.neg(b)) end

function BE.mul(a0, b0)
	if not finite(a0.l) then return a0 end
	if not finite(b0.l) then return b0 end
	if a0.s == 0 or b0.s == 0 then return NN(0, 0, 0) end
	if a0.l == b0.l and a0.m == -b0.m then return NN(a0.s * b0.s, 0, 1) end
	local a, b
	if a0.l > b0.l or (a0.l == b0.l and abs(a0.m) > abs(b0.m)) then a, b = a0, b0 else a, b = b0, a0 end
	if a.l == 0 and b.l == 0 then return BE.fromNumber(a.s * b.s * a.m * b.m) end
	if a.l >= 3 or (a.l - b.l >= 2) then return FC(a.s * b.s, a.l, a.m) end
	if a.l == 1 and b.l == 0 then return FC(a.s * b.s, 1, a.m + log10(b.m)) end
	if a.l == 1 and b.l == 1 then return FC(a.s * b.s, 1, a.m + b.m) end
	if (a.l == 2 and b.l == 1) or (a.l == 2 and b.l == 2) then
		local nm = BE.add(FC(sgn(a.m), a.l - 1, abs(a.m)), FC(sgn(b.m), b.l - 1, abs(b.m)))
		return FC(a.s * b.s, nm.l + 1, nm.s * nm.m)
	end
	return dNaN()   -- break_eternity throws here; nothing in the game reaches it
end
function BE.recip(a)
	if a.m == 0 then return dNaN() end
	if a.l == 0 then return FC(a.s, 0, 1 / a.m) end
	return FC(a.s, a.l, -a.m)
end
function BE.div(a, b) return BE.mul(a, BE.recip(b)) end

function BE.absLog10(a)
	if a.s == 0 then return dNaN() end
	if a.l > 0 then return FC(sgn(a.m), a.l - 1, abs(a.m)) end
	return FC(1, 0, log10(a.m))
end
function BE.log10(a)
	if a.s <= 0 then return dNaN() end
	if a.l > 0 then return FC(sgn(a.m), a.l - 1, abs(a.m)) end
	return FC(a.s, 0, log10(a.m))
end
function BE.ln(a)
	if a.s <= 0 then return dNaN() end
	if a.l == 0 then return FC(a.s, 0, math.log(a.m)) end
	if a.l == 1 then return FC(sgn(a.m), 0, abs(a.m) * 2.302585092994046) end
	if a.l == 2 then return FC(sgn(a.m), 1, abs(a.m) + 0.36221568869946325) end
	return FC(sgn(a.m), a.l - 1, abs(a.m))
end
function BE.log2(a)
	if a.s <= 0 then return dNaN() end
	if a.l == 0 then return FC(a.s, 0, math.log(a.m, 2)) end
	if a.l == 1 then return FC(sgn(a.m), 0, abs(a.m) * 3.321928094887362) end
	if a.l == 2 then return FC(sgn(a.m), 1, abs(a.m) + 0.5213902276543247) end
	return FC(sgn(a.m), a.l - 1, abs(a.m))
end
function BE.log(a, base)
	if a.s <= 0 then return dNaN() end
	if base.s <= 0 then return dNaN() end
	if base.s == 1 and base.l == 0 and base.m == 1 then return dNaN() end
	if a.l == 0 and base.l == 0 then return FC(a.s, 0, math.log(a.m) / math.log(base.m)) end
	return BE.div(BE.log10(a), BE.log10(base))
end

function BE.pow10(a)
	if not finite(a.l) or not finite(a.m) then return dNaN() end
	if a.l == 0 then
		local nm = 10 ^ (a.s * a.m)
		if finite(nm) and abs(nm) > 0.1 then return FC(1, 0, nm) end
		if a.s == 0 then return NN(1, 0, 1) end
		a = NN(a.s, a.l + 1, log10(a.m))
	end
	if a.s > 0 and a.m > 0 then return FC(a.s, a.l + 1, a.m) end
	if a.s < 0 and a.m > 0 then return FC(-a.s, a.l + 1, -a.m) end
	return NN(1, 0, 1)
end
function BE.toNumber(a)
	if not finite(a.l) then return NaN end
	if a.l == 0 then return a.s * a.m end
	if a.l == 1 then return a.s * 10 ^ a.m end
	if a.m > 0 then return if a.s > 0 then huge else -huge end
	return 0
end
function BE.pow(a, b)
	if a.s == 0 then if BE.eq(b, NN(0, 0, 0)) or b.s == 0 then return NN(1, 0, 1) end return a end
	if a.s == 1 and a.l == 0 and a.m == 1 then return a end
	if b.s == 0 then return NN(1, 0, 1) end
	if b.s == 1 and b.l == 0 and b.m == 1 then return a end
	local result = BE.pow10(BE.mul(BE.absLog10(a), b))
	if a.s == -1 and abs(math.fmod(BE.toNumber(b), 2)) == 1 then return BE.neg(result) end
	return result
end
function BE.root(a, b) return BE.pow(a, BE.recip(b)) end
function BE.sqrt(a)
	if a.l == 0 then local x = a.s * a.m; return BE.fromNumber(if x < 0 then NaN else math.sqrt(x)) end
	if a.l == 1 then return FC(1, 2, log10(a.m) - 0.3010299956639812) end
	local r = BE.div(NN(a.s, a.l - 1, a.m), NN(1, 0, 2))
	r = NN(r.s, r.l + 1, r.m)
	return normalize(r)
end
local function magRound(a, f)
	if a.m < 0 then return NN(0, 0, 0) end
	if a.l == 0 then return FC(a.s, 0, f(a.m)) end
	return a
end
function BE.floor(a) return magRound(a, floor) end
function BE.ceil(a) return magRound(a, math.ceil) end
function BE.round(a) return magRound(a, function(m) return floor(m + 0.5) end) end
function BE.exp(a)
	if a.m < 0 then return NN(1, 0, 1) end
	if a.l == 0 and a.m <= 709.7 then return BE.fromNumber(math.exp(a.s * a.m)) end
	if a.l == 0 then return FC(1, 1, a.s * log10(math.exp(1)) * a.m) end
	if a.l == 1 then return FC(1, 2, a.s * (log10(0.4342944819032518) + a.m)) end
	return FC(1, a.l + 1, a.s * a.m)
end
function BE.max(a, b) if BE.lt(a, b) then return b end return a end
function BE.min(a, b) if BE.gt(a, b) then return b end return a end

return BE
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">JSRT</string>
            <string name="Source"><![CDATA[--!nocheck
-- JSRT: the small slice of JavaScript semantics the transpiled Milestone Tree NG+ needs, plus a break_eternity-style
-- Decimal built on TowerNum. Every JS function value takes `this` as its first parameter.
-- array lengths, key order and key caches are shared by every instance (arrays stay arrays across instances)
local SHARED_LEN = setmetatable({}, { __mode = "k" })
local SHARED_ORDER = setmetatable({}, { __mode = "k" })
local SHARED_KC = setmetatable({}, { __mode = "k" })
return function(TN, BEcore)

local huge, floor, abs, fmod = math.huge, math.floor, math.abs, math.fmod
local sfmt, ssub, sfind, srep, sbyte, schar, slower, supper = string.format, string.sub, string.find, string.rep, string.byte, string.char, string.lower, string.upper
local tinsert, tsort, tconcat, tclear = table.insert, table.sort, table.concat, table.clear

local JS = {}
local LEN = SHARED_LEN     -- array -> length (arrays are 0-based)
local ORDER = SHARED_ORDER   -- object -> string keys in insertion order
local KC = SHARED_KC      -- object -> cached for-in key list (dropped when a key appears/disappears)
JS.LEN, JS.ORDER = LEN, ORDER
JS.NOW = 1.7e12

-- ------------------------------------------------------------------ Decimal (break_eternity API over TowerNum)
local DMT = {}
local DP = {}                                    -- Decimal methods
JS.DMT = DMT
local function isD(x) return type(x) == "table" and getmetatable(x) == DMT end
JS.isD = isD

local parseStr   -- break_eternity's fromString, defined with the other Decimal methods below
local function V(x)
	local t = type(x)
	if t == "number" then return x end
	if t == "table" then
		if getmetatable(x) == DMT then return x.v end
		if rawget(x, "l") ~= nil and rawget(x, "m") ~= nil then return x end   -- a raw TowerNum value
		return 0
	end
	if t == "string" then return (parseStr(x)) end
	return 0
end
-- A NaN carries break_eternity's own components (NaN, 0, NaN), so every operation on it goes through BEcore and
-- answers like the web game (0 * NaN is 0 there; a NaN from x / 0 or log(0) is the layer-NaN kind that stays NaN).
local function mk(v)
	if v ~= v then return setmetatable({ v = v, be = BEcore.NN(0 / 0, 0, 0 / 0) }, DMT) end
	return setmetatable({ v = v }, DMT)
end
local function D(x)
	if isD(x) then local r = mk(x.v); r.be = x.be; return r end
	if type(x) == "string" then local v, be = parseStr(x); local r = mk(v); r.be = be; return r end
	if x == huge or x == -huge then
		local r = mk(x); r.be = BEcore.fromNumber(x); return r      -- break_eternity's layer-1 Infinity
	end
	return mk(V(x))
end
JS.D = function(x) return D(x) end
JS.V = V

-- break_eternity normal form (sign, layer, mag) for the few places that read the fields directly
local EXP_LIMIT = 9e15
local function comps(v)
	if type(v) == "number" then
		if v ~= v then return 0 / 0, 0, 0 / 0 end
		local s = if v > 0 then 1 elseif v < 0 then -1 else 0
		local a = abs(v)
		if a == huge then return s, huge, huge end
		if a < EXP_LIMIT then
			if a < 1 / 9e15 and a > 0 then return s, 1, math.log10(a) end   -- break_eternity's first negative layer
			return s, 0, a
		end
		return s, 1, math.log10(a)
	end
	if v.h ~= nil then return (if v.m < 0 then -1 else 1), huge, huge end
	-- towers {l, m}: l < 0 is the reciprocal 1 / (l-tall tower of m); break_eternity writes that as a negative mag
	local s = if v.m < 0 then -1 else 1
	local l, m = v.l, abs(v.m)
	if l < 0 then l = -l; m = -m end
	while m >= EXP_LIMIT or m <= -EXP_LIMIT do
		l += 1
		m = if m < 0 then -math.log10(-m) else math.log10(m)
	end
	return s, l, m
end
JS.comps = comps
-- method lookups go straight to DP; the break_eternity fields (sign/layer/mag/e/m) are read through JS.P
local function dprop(self, k)
	local be = self.be
	if be then
		if k == "sign" then return be.s elseif k == "layer" then return be.l elseif k == "mag" then return be.m end
	end
	if k == "sign" or k == "layer" or k == "mag" then
		local s, l, m = comps(self.v)
		return if k == "sign" then s elseif k == "layer" then l else m
	end
	if k == "e" or k == "exponent" then
		local s, l, m = comps(self.v)
		if l == 0 then if m == 0 then return 0 end return floor(math.log10(m)) end
		if l == 1 then return floor(m) end
		if l == 2 then return floor(10 ^ m) end
		return huge
	end
	if k == "m" or k == "mantissa" then
		local s, l, m = comps(self.v)
		if l == 0 then
			if m == 0 then return 0 end
			local e = floor(math.log10(m))
			return s * (m / 10 ^ e)
		end
		if l == 1 then return s * 10 ^ (m % 1) end
		return s
	end
	return nil
end
DMT.__index = DP
function JS.P(o, k)
	if type(o) == "table" and getmetatable(o) == DMT then return dprop(o, k) end
	if o == nil then error("Cannot read properties of undefined (reading '" .. k .. "')", 2) end
	if type(o) ~= "table" then return nil end
	return o[k]
end
DMT.__tostring = function(self) return DP.toString(self) end
DMT.__eq = function(a, b) return TN.eq(a.v, b.v) end
DMT.__lt = function(a, b) return TN.lt(V(a), V(b)) end
DMT.__le = function(a, b) return TN.le(V(a), V(b)) end
DMT.__unm = function(a) return mk(TN.neg(a.v)) end

-- ---- break_eternity compatibility -------------------------------------------------------------------------------
-- The game ships an old break_eternity. TowerNum does the arithmetic; where that old version answers differently the
-- game's own answer is reproduced:
--   * new Decimal(Infinity), Decimal.dInf and anything computed from them go through BEcore (a line-for-line port of
--     the old library). E.g. new Decimal(Infinity) ranks BELOW every number from ee15.95 up, so Infinity-cost upgrades
--     become affordable at ee16, and paying that cost leaves the currency unchanged, exactly like the web game.
--   * NaN compares like the old library: gte / lte are true, gt / lt / eq false
--   * log10 / ln / log2 / log of 0 or a negative, x/0 and 1/0 are NaN (not -Infinity / Infinity)
--   * pow of a negative base is |base|^b, negated only for odd integer powers; 0^b is 0 for any b ~= 0
--   * floor / ceil / round / trunc act on the magnitude and keep the sign (floor(-2.5) = -2)
--   * slog is the old linear-approximation version
local BEc = BEcore
local function special(b)
	local t = type(b)
	if t == "table" then return getmetatable(b) == DMT and b.be ~= nil end
	if t == "number" then return b == huge or b == -huge or b ~= b end
	return false
end
local function tri(x)
	if isD(x) then
		if x.be then return x.be end
		local s, l, m = comps(x.v)
		return BEc.NN(s, l, m)
	end
	if type(x) == "number" then return BEc.fromNumber(x) end
	return tri(D(x))
end
local function triToTN(t)
	if t.s == 0 then return 0 end
	if t.l == 0 then return t.s * t.m end
	-- layer l, mag m: 10^(sign(m) * (l-1 tall tower of |m|))
	local x = abs(t.m)
	for _ = 1, t.l - 1 do x = TN.exp10(x) end
	if t.m < 0 then x = TN.neg(x) end
	x = TN.exp10(x)
	if t.s < 0 then x = TN.neg(x) end
	return x
end
local function fromTri(t)
	if BEc.finite(t.l) and BEc.finite(t.m) and t.s == t.s then return mk(triToTN(t)) end
	local d = mk(if t.s ~= t.s or t.l ~= t.l or t.m ~= t.m then 0 / 0 elseif t.s < 0 then -huge elseif t.s > 0 then huge else 0 / 0)
	d.be = t
	return d
end
local function nanL() return fromTri(BEc.NN(0 / 0, 0 / 0, 0 / 0)) end   -- break_eternity's layer-NaN (x / 0, log of 0)
JS.tri, JS.fromTri = tri, fromTri
local function bv_(b)
	local t = type(b)
	if t == "table" and getmetatable(b) == DMT then return b.v end
	if t == "number" then return b end
	return V(b)
end
local tnge, tngt, tnle, tnlt, tneq, tncmp = TN.ge, TN.gt, TN.le, TN.lt, TN.eq, TN.cmp
function DP.gte(a, b)
	if a.be or special(b) then return BEc.gte(tri(a), tri(b)) end
	local av, v = a.v, bv_(b)
	if tnge(av, v) then return true end
	return av ~= av or v ~= v
end
function DP.lte(a, b)
	if a.be or special(b) then return BEc.lte(tri(a), tri(b)) end
	local av, v = a.v, bv_(b)
	if tnle(av, v) then return true end
	return av ~= av or v ~= v
end
function DP.gt(a, b)
	if a.be or special(b) then return BEc.gt(tri(a), tri(b)) end
	local av, v = a.v, bv_(b)
	if av ~= av or v ~= v then return false end    -- TowerNum would rank NaN below towers
	return tngt(av, v)
end
function DP.lt(a, b)
	if a.be or special(b) then return BEc.lt(tri(a), tri(b)) end
	local av, v = a.v, bv_(b)
	if av ~= av or v ~= v then return false end
	return tnlt(av, v)
end
function DP.eq(a, b)
	if a.be or special(b) then return BEc.eq(tri(a), tri(b)) end
	return tneq(a.v, bv_(b))
end
function DP.neq(a, b) return not DP.eq(a, b) end
function DP.cmp(a, b)
	local av, v = a.v, bv_(b)
	if a.be or special(b) or av ~= av or v ~= v then return BEc.cmp(tri(a), tri(b)) end
	return tncmp(av, v)
end
DP.compare = DP.cmp
function DP.max(a, b) if DP.lt(a, b) then return D(b) end return a end
function DP.min(a, b) if DP.gt(a, b) then return D(b) end return a end
function DP.clamp(a, lo, hi) return DP.min(DP.max(a, lo), hi) end
function DP.clampMin(a, lo) return DP.max(a, lo) end
function DP.clampMax(a, hi) return DP.min(a, hi) end
local tnadd, tnsub, tnmul, tndiv = TN.add, TN.sub, TN.mul, TN.div
function DP.add(a, b) if a.be or special(b) then return fromTri(BEc.add(tri(a), tri(b))) end return mk(tnadd(a.v, V(b))) end
function DP.sub(a, b) if a.be or special(b) then return fromTri(BEc.sub(tri(a), tri(b))) end return mk(tnsub(a.v, V(b))) end
function DP.mul(a, b) if a.be or special(b) then return fromTri(BEc.mul(tri(a), tri(b))) end return mk(tnmul(a.v, V(b))) end
function DP.div(a, b)
	if a.be or special(b) then return fromTri(BEc.div(tri(a), tri(b))) end
	local av, bv = a.v, V(b)
	if bv == 0 then return nanL() end
	if type(av) == "number" and type(bv) == "number" and bv < EXP_LIMIT and bv > -EXP_LIMIT then
		local r = av * (1 / bv)      -- break_eternity divides as a * (1/b)
		if r < EXP_LIMIT and r > -EXP_LIMIT then return mk(r) end
	end
	return mk(tndiv(av, bv))
end
DP.plus, DP.minus, DP.times, DP.dividedBy, DP.divide, DP.multiply = DP.add, DP.sub, DP.mul, DP.div, DP.div, DP.mul
local function recipV(v)
	if v == 0 then return 0 / 0 end
	return TN.recip(v)
end
function DP.recip(a) if a.be then return fromTri(BEc.recip(a.be)) end if a.v == 0 then return nanL() end return mk(recipV(a.v)) end
DP.reciprocal = DP.recip
local powV
function powV(av, bv)
	if av == 0 then if bv == 0 then return 1 end return av end
	if av == 1 then return av end
	if bv == 0 then return 1 end
	if bv == 1 then return av end
	if bv ~= bv or av ~= av then return 0 / 0 end
	if type(av) == "number" and type(bv) == "number" and av > 0 and bv < EXP_LIMIT and bv > -EXP_LIMIT then
		-- the old library always goes through logs: 10^(log10(a) * b). Same rounding as the web game.
		local x = math.log10(av) * bv
		if x < EXP_LIMIT and x > -EXP_LIMIT then
			local r = 10 ^ x
			if r == r and r ~= huge and r > 0.1 then return r end
			return fromTri(BEc.pow10(BEc.fromNumber(x))).v
		end
	end
	if type(av) == "number" and av < 0 then
		local r = powV(-av, bv)
		if abs(fmod(TN.toNumber(bv), 2)) == 1 then return TN.neg(r) end
		return r
	end
	if type(av) == "table" and av.h == nil and av.m < 0 then
		local r = TN.pow(TN.neg(av), bv)
		if abs(fmod(TN.toNumber(bv), 2)) == 1 then return TN.neg(r) end
		return r
	end
	return TN.pow(av, bv)
end
JS.powV = powV
function DP.pow(a, b) if a.be or special(b) then return fromTri(BEc.pow(tri(a), tri(b))) end return mk(powV(a.v, V(b))) end
function DP.pow_base(a, b) if a.be or special(b) then return fromTri(BEc.pow(tri(b), tri(a))) end return mk(powV(V(b), a.v)) end
function DP.root(a, n)
	if a.be or special(n) or V(n) == 0 then return fromTri(BEc.root(tri(a), tri(n))) end
	return mk(powV(a.v, recipV(V(n))))
end
function DP.cbrt(a) if a.be then return fromTri(BEc.pow(a.be, BEc.fromNumber(1 / 3))) end return mk(powV(a.v, 1 / 3)) end
function DP.sqrt(a)
	if a.be then return fromTri(BEc.sqrt(a.be)) end
	local v = a.v
	if type(v) == "number" and v ~= 0 and v < 1 / 9e15 and v > -1 / 9e15 then return fromTri(BEc.sqrt(tri(a))) end   -- old library: NaN
	if type(v) == "number" and v < 0 then
		if v > -EXP_LIMIT then return mk(0 / 0) end
		return mk(TN.sqrt(-v))               -- layer 1: the sign is dropped
	end
	if type(v) == "table" and v.h == nil and v.m < 0 then
		local s, l = comps(v)
		local r = TN.sqrt(TN.neg(v))
		if l >= 2 then return mk(TN.neg(r)) end
		return mk(r)
	end
	return mk(TN.sqrt(v))
end
local function positive(v)
	if type(v) == "number" then return v > 0 end
	return v.m > 0
end
function DP.log10(a) if a.be then return fromTri(BEc.log10(a.be)) end if not positive(a.v) then return nanL() end return mk(TN.log10(a.v)) end
function DP.ln(a) if a.be then return fromTri(BEc.ln(a.be)) end if not positive(a.v) then return nanL() end return mk(TN.ln(a.v)) end
function DP.log2(a) if a.be then return fromTri(BEc.log2(a.be)) end if not positive(a.v) then return nanL() end return mk(TN.log2(a.v)) end
local function logV(av, bv)
	if not positive(av) or not positive(bv) or bv == 1 then return 0 / 0 end
	if type(av) == "number" and type(bv) == "number" and av < EXP_LIMIT and bv < EXP_LIMIT then
		return math.log(av) / math.log(bv)
	end
	return TN.div(TN.log10(av), TN.log10(bv))
end
function DP.log(a, base)
	if a.be or special(base) then return fromTri(BEc.log(tri(a), tri(base))) end
	local bv = V(base)
	if not positive(a.v) or not positive(bv) or bv == 1 then return nanL() end
	return mk(logV(a.v, bv))
end
function DP.exp(a)
	if a.be then return fromTri(BEc.exp(a.be)) end
	local v = a.v
	if type(v) == "number" and v <= 709.7 and v >= -709.7 then return mk(math.exp(v)) end
	return fromTri(BEc.exp(tri(a)))
end
local function magRound(a, f, bef)
	if a.be then return fromTri(bef(a.be)) end
	local v = a.v
	if type(v) ~= "number" then
		local s, l, m = comps(v)
		if m < 0 then return mk(0) end      -- tiny (1e-9e15 and below)
		return a
	end
	if v ~= v then return a end
	local m = abs(v)
	if m >= EXP_LIMIT then return a end
	if m < 1 / 9e15 then return mk(0) end
	local r = f(m)
	if v < 0 then r = -r end
	return mk(r)
end
function DP.floor(a) return magRound(a, floor, BEc.floor) end
function DP.ceil(a) return magRound(a, math.ceil, BEc.ceil) end
function DP.round(a) return magRound(a, function(m) return floor(m + 0.5) end, BEc.round) end
function DP.trunc(a) return magRound(a, floor, BEc.floor) end
function DP.abs(a) if a.be then return fromTri(BEc.abs(a.be)) end return mk(TN.abs(a.v)) end
function DP.neg(a) if a.be then return fromTri(BEc.neg(a.be)) end return mk(TN.neg(a.v)) end
DP.negate = DP.neg
function DP.mod(a, b) return mk(TN.mod(a.v, V(b))) end
function DP.tetrate(a, h, payload)
	if h == nil then h = 2 end
	if payload ~= nil and not TN.eq(V(payload), 1) then
		local x = V(payload)
		for _ = 1, floor(TN.toNumber(V(h))) do x = powV(a.v, x) end
		return mk(x)
	end
	return mk(TN.tetrate(a.v, V(h)))
end
function DP.slog(a, base)
	-- the old break_eternity: linear critical section, done on components so every case matches
	local copy = tri(a)
	if copy.m < 0 then return mk(-1) end
	local b = if base == nil then BEc.fromNumber(10) else tri(base)
	local result = 0
	if copy.l - b.l > 3 then
		local loss = copy.l - b.l - 3
		result += loss
		copy = BEc.NN(copy.s, copy.l - loss, copy.m)
	end
	for _ = 1, 100 do
		if BEc.lt(copy, BEc.NN(0, 0, 0)) then
			copy = BEc.pow(b, copy)
			result -= 1
		elseif BEc.lte(copy, BEc.NN(1, 0, 1)) then
			return fromTri(BEc.fromNumber(result + BEc.toNumber(copy) - 1))
		else
			result += 1
			copy = BEc.log(copy, b)
		end
	end
	return fromTri(BEc.fromNumber(result))
end

-- new Decimal(string): the game's break_eternity fromString, step for step. The game leans on its leniency: a number
-- that became a string by accident ("0.02" + a Decimal is "0.021", then "0.0210.02") still reads as its longest
-- numeric prefix (0.021), and text that is no number at all reads as 0, never NaN.
local function jsParseFloat(str_)
	local rest = string.match(str_, "^%s*(.*)$")
	local sign = ssub(rest, 1, 1)
	if sign == "+" or sign == "-" then rest = ssub(rest, 2) else sign = "" end
	if ssub(rest, 1, 8) == "Infinity" then return if sign == "-" then -huge else huge end
	local num = string.match(rest, "^%d+%.?%d*") or string.match(rest, "^%.%d+")
	if num == nil then return 0 / 0 end
	local e = string.match(ssub(rest, #num + 1), "^[eE][%+%-]?%d+")
	local n = tonumber(num .. (e or ""))
	if sign == "-" then n = -n end
	return n
end
JS.parseFloat = jsParseFloat
local function jsSplit(str_, sep)
	local parts, init = {}, 1
	while true do
		local a, b = sfind(str_, sep, init, true)
		if a == nil then parts[#parts + 1] = ssub(str_, init); return parts end
		parts[#parts + 1] = ssub(str_, init, a - 1)
		init = b + 1
	end
end
local function jsFinite(x) return x == x and x ~= huge and x ~= -huge end
local function replaceFirst(str_, a, b)
	local i, j = sfind(str_, a, 1, true)
	if i == nil then return str_ end
	return ssub(str_, 1, i - 1) .. b .. ssub(str_, j + 1)
end
local function tetratedTri(base, height, payload)
	return tri(DP.tetrate(mk(base), height, if payload == 1 then nil else payload))
end
local function beFromString(value)
	value = replaceFirst(value, ",", "")                  -- IGNORE_COMMAS
	local parts = jsSplit(value, "^^^")                   -- x^^^y
	if #parts == 2 then
		local base, height = jsParseFloat(parts[1]), jsParseFloat(parts[2])
		if jsFinite(base) and jsFinite(height) then return tri(mk(TN.pentate(base, height))) end
	end
	parts = jsSplit(value, "^^")                          -- x^^y[;payload]
	if #parts == 2 then
		local base, height = jsParseFloat(parts[1]), jsParseFloat(parts[2])
		local payload = 1
		local hp = jsSplit(parts[2], ";")
		if #hp == 2 then payload = jsParseFloat(hp[2]); if not jsFinite(payload) then payload = 1 end end
		if jsFinite(base) and jsFinite(height) then return tetratedTri(base, height, payload) end
	end
	parts = jsSplit(value, "^")                           -- x^y
	if #parts == 2 then
		local base, exponent = jsParseFloat(parts[1]), jsParseFloat(parts[2])
		if jsFinite(base) and jsFinite(exponent) then return tri(DP.pow(mk(base), exponent)) end
	end
	value = slower(string.match(value, "^%s*(.-)%s*$"))
	for _, sep in { "pt", "p" } do                        -- X pt Y / XpY: 10^^X with payload Y
		parts = jsSplit(value, sep)
		if #parts == 2 then
			local height = jsParseFloat(parts[1])
			local payload = jsParseFloat(replaceFirst(replaceFirst(parts[2], "(", ""), ")", ""))
			if not jsFinite(payload) then payload = 1 end
			if jsFinite(height) then return tetratedTri(10, height, payload) end
		end
	end
	parts = jsSplit(value, "e")
	local ecount = #parts - 1
	if ecount == 0 then
		local n = jsParseFloat(value)
		if jsFinite(n) then return BEc.fromNumber(n) end
	elseif ecount == 1 then
		local n = jsParseFloat(value)
		if jsFinite(n) and n ~= 0 then return BEc.fromNumber(n) end
	end
	local t = BEc.NN(0, 0, 0)
	local newparts = jsSplit(value, "e^")                 -- (e^N)X
	if #newparts == 2 then
		t.s = if ssub(newparts[1], 1, 1) == "-" then -1 else 1
		local np = newparts[2]
		for i = 1, #np do
			local c = sbyte(np, i)
			if not ((c >= 43 and c <= 57) or c == 101) then
				t.l = jsParseFloat(ssub(np, 1, i - 1))
				t.m = jsParseFloat(ssub(np, i + 1))
				if t.l == huge or t.l == -huge then return BEc.NN(0 / 0, 0 / 0, 0 / 0) end   -- the web game hangs here
				return BEc.normalize(t)
			end
		end
	end
	if ecount < 1 then return BEc.NN(0, 0, 0) end
	local mantissa = jsParseFloat(parts[1])
	if mantissa == 0 then return BEc.NN(0, 0, 0) end
	local exponent = jsParseFloat(parts[#parts])
	if ecount >= 2 then
		local me = jsParseFloat(parts[#parts - 1])
		if jsFinite(me) then
			exponent *= (if me > 0 then 1 elseif me < 0 then -1 else me)
			exponent += (if me > 0 then 1 elseif me < 0 then -1 else me) * math.log10(abs(me))
		end
	end
	if not jsFinite(mantissa) then
		t.s = if parts[1] == "-" then -1 else 1
		t.l = ecount
		t.m = exponent
	elseif ecount == 1 then
		t.s = if mantissa > 0 then 1 elseif mantissa < 0 then -1 else mantissa
		t.l = 1
		t.m = exponent + math.log10(abs(mantissa))
	else
		t.s = if mantissa > 0 then 1 elseif mantissa < 0 then -1 else mantissa
		t.l = ecount
		if ecount == 2 then return BEc.mul(BEc.FC(1, 2, exponent), BEc.fromNumber(mantissa)) end
		t.m = exponent
	end
	return BEc.normalize(t)
end
-- strings the game parses are mostly constants ("ee9", "1e1000") read every tick: remember what they came to
local STRCACHE, strCount = {}, 0
function parseStr(x)
	local c = STRCACHE[x]
	if c == nil then
		local t = beFromString(x)
		local d = fromTri(t)
		c = { d.v, d.be }
		if strCount > 4096 then table.clear(STRCACHE); strCount = 0 end
		STRCACHE[x] = c
		strCount += 1
	end
	return c[1], c[2]
end
JS.beFromString = beFromString
function DP.lambertw(a) return mk(TN.lambertw(a.v)) end
function DP.toNumber(a) if a.be then return BEcore.toNumber(a.be) end return TN.toNumber(a.v) end
function DP.sign_(a) return TN.sign(a.v) end
function DP.isNan(a) return TN.isNaN(a.v) end
function DP.isFinite(a) return not TN.isNaN(a.v) and not TN.isInf(a.v) end
function DP.valueOf(a) return DP.toString(a) end
function DP.toJSON(a) return DP.toString(a) end
function DP.fromValue(a, x) a.v = V(x); return a end

-- ------------------------------------------------------------------ JS number -> string
local function jsExp(x) -- shortest round-trip digits + decimal exponent
	-- 15 significant digits always land on the shortest form when they round-trip; else 16, else 17
	for _, p in { 15, 16, 17 } do
		local s = sfmt("%." .. (p - 1) .. "e", x)
		if p == 17 or tonumber(s) == x then
			local mant, ex = string.match(s, "^%-?([%d%.]+)e([%+%-]%d+)$")
			return (string.gsub(mant, "%.", "")), tonumber(ex)
		end
	end
	return "0", 0
end
local INTSTR = {}
local function numToString(x)
	if x == floor(x) and x < 1e15 and x > -1e15 then   -- integers (the common case)
		if x >= 0 and x < 100000 then
			local c = INTSTR[x]
			if c == nil then c = sfmt("%d", x); INTSTR[x] = c end
			return c
		end
		return sfmt("%d", x)
	end
	if x ~= x then return "NaN" end
	if x == huge then return "Infinity" end
	if x == -huge then return "-Infinity" end
	if x == 0 then return "0" end
	local neg = x < 0
	if neg then x = -x end
	local digits, e = jsExp(x)
	digits = string.gsub(digits, "0+$", "")
	if digits == "" then digits = "0" end
	local k, n = #digits, e + 1
	local s
	if k <= n and n <= 21 then s = digits .. srep("0", n - k)
	elseif 0 < n and n <= 21 then s = ssub(digits, 1, n) .. "." .. ssub(digits, n + 1)
	elseif -6 < n and n <= 0 then s = "0." .. srep("0", -n) .. digits
	else
		local es = (if n - 1 >= 0 then "+" else "-") .. tostring(abs(n - 1))
		if k == 1 then s = digits .. "e" .. es else s = ssub(digits, 1, 1) .. "." .. ssub(digits, 2) .. "e" .. es end
	end
	return if neg then "-" .. s else s
end
JS.numToString = numToString

local function toFixed(x, f)
	f = floor(f or 0)
	if x ~= x then return "NaN" end
	if abs(x) >= 1e21 then return numToString(x) end
	local s = sfmt("%." .. f .. "f", x)
	-- JS picks the larger n on an exact tie; C rounds ties to even
	local scaled = abs(x) * 10 ^ f
	if scaled - floor(scaled) == 0.5 and scaled < 2 ^ 52 then
		local up = (floor(scaled) + 1) / 10 ^ f
		s = sfmt("%." .. f .. "f", if x < 0 then -up else up)
	end
	if s == "-0" or string.match(s, "^%-0%.?0*$") then s = ssub(s, 2) end
	return s
end
JS.toFixed = toFixed
local function toPrecision(x, p)
	if x ~= x then return "NaN" end
	if abs(x) == huge then return numToString(x) end
	p = floor(p)
	if x == 0 then return if p > 1 then "0." .. srep("0", p - 1) else "0" end
	local s = sfmt("%." .. (p - 1) .. "e", x)
	local sign, mant, ex = string.match(s, "^(%-?)([%d%.]+)e([%+%-]%d+)$")
	local e = tonumber(ex)
	local digits = string.gsub(mant, "%.", "")
	if e < -6 or e >= p then
		return sign .. ssub(digits, 1, 1) .. (if p > 1 then "." .. ssub(digits, 2) else "") .. "e" .. (if e >= 0 then "+" else "-") .. abs(e)
	end
	if e >= 0 then
		local ip = ssub(digits, 1, e + 1)
		local fp = ssub(digits, e + 2)
		return sign .. ip .. (if #fp > 0 then "." .. fp else "")
	end
	return sign .. "0." .. srep("0", -e - 1) .. digits
end
JS.toPrecision = toPrecision

function DP.toString(a)
	local s, l, m = comps(a.v)
	if s ~= s then return "NaN" end
	if l == huge then return if s < 0 then "-Infinity" else "Infinity" end
	if l == 0 then
		if (m < 1e21 and m > 1e-7) or m == 0 then return numToString(s * m) end
		return numToString(dprop(a, "m")) .. "e" .. numToString(dprop(a, "e"))
	end
	if l == 1 then return numToString(dprop(a, "m")) .. "e" .. numToString(dprop(a, "e")) end
	if l <= 5 then return (if s == -1 then "-" else "") .. srep("e", l) .. numToString(m) end
	return (if s == -1 then "-" else "") .. "(e^" .. l .. ")" .. numToString(m)
end
local function decimalPlaces(v, places)
	local len = places + 1
	local numDigits = math.ceil(math.log10(abs(v)))
	local rounded = math.floor(v * 10 ^ (len - numDigits) + 0.5) * 10 ^ (numDigits - len)
	return toFixed(rounded, math.max(len - numDigits, 0))
end
function DP.toStringWithDecimalPlaces(a, places)
	local s, l, m = comps(a.v)
	if l == 0 then
		if (m < 1e21 and m > 1e-7) or m == 0 then return toFixed(s * m, places) end
		return decimalPlaces(dprop(a, "m"), places) .. "e" .. decimalPlaces(dprop(a, "e"), places)
	end
	if l == 1 then return decimalPlaces(dprop(a, "m"), places) .. "e" .. decimalPlaces(dprop(a, "e"), places) end
	if l <= 5 then return (if s == -1 then "-" else "") .. srep("e", l) .. decimalPlaces(m, places) end
	return (if s == -1 then "-" else "") .. "(e^" .. l .. ")" .. decimalPlaces(m, places)
end
function DP.toFixed(a, places)
	local s, l, m = comps(a.v)
	if l == 0 then return toFixed(s * m, places) end
	return DP.toStringWithDecimalPlaces(a, places)
end
function DP.toPrecision(a, places)
	local e = dprop(a, "e")
	if e <= -7 then return DP.toStringWithDecimalPlaces(a, places - 1) end
	if places > e then return DP.toFixed(a, places - e - 1) end
	return DP.toStringWithDecimalPlaces(a, places - 1)
end

-- static Decimal
local Decimal = {}
JS.Decimal = Decimal
for _, name in { "add", "sub", "mul", "div", "pow", "max", "min", "cmp", "gte", "gt", "lte", "lt", "eq", "log", "root", "tetrate", "slog", "plus", "minus", "times" } do
	Decimal[name] = function(a, ...) return DP[name](D(a), ...) end
end
for _, name in { "log10", "ln", "log2", "exp", "sqrt", "cbrt", "floor", "ceil", "round", "abs", "neg", "recip", "toNumber" } do
	Decimal[name] = function(a) return DP[name](D(a)) end
end
Decimal.fromValue = function(x) return D(x) end
Decimal.fromNumber = Decimal.fromValue
Decimal.fromString = Decimal.fromValue
Decimal.dZero, Decimal.dOne, Decimal.dTen = mk(0), mk(1), mk(10)
Decimal.dInf, Decimal.dNegInf, Decimal.dNaN = mk(huge), mk(-huge), mk(0 / 0)
Decimal.dInf.be = BEcore.NN(1, huge, huge)
Decimal.dNegInf.be = BEcore.NN(-1, huge, huge)
Decimal.dNegOne = mk(-1)
Decimal.affordGeometricSeries = function(res, start, ratio, cur) return mk(TN.affordGeometricSeries(V(res), V(start), V(ratio), V(cur))) end
Decimal.sumGeometricSeries = function(n, start, ratio, cur) return mk(TN.sumGeometricSeries(V(n), V(start), V(ratio), V(cur))) end
Decimal.affordArithmeticSeries = function(res, start, add, cur) return mk(TN.affordArithmeticSeries(V(res), V(start), V(add), V(cur))) end
Decimal.sumArithmeticSeries = function(n, start, add, cur) return mk(TN.sumArithmeticSeries(V(n), V(start), V(add), V(cur))) end
Decimal.isNaN = function(x) return TN.isNaN(V(x)) end

-- ------------------------------------------------------------------ JS core semantics
-- JS null: a real value (object keys can hold it, unlike nil). Falsy, == undefined, typeof "object".
local NULL = setmetatable({}, { __index = function() return nil end, __tostring = function() return "null" end, __jsnull = true })
JS.NULL = NULL
function JS.isnil(x) return x == nil or x == NULL end
function JS.t(x)
	if x == nil or x == false or x == 0 or x == "" or x == NULL then return false end
	if x ~= x then return false end
	return true
end
local truthy = JS.t

function JS.k(k)
	local t = type(k)
	if t == "number" then return k end
	if t == "string" then
		-- canonical integer strings ("0", "11", "-3", no leading zeros) are number keys
		local b = sbyte(k, 1)
		if b and ((b >= 49 and b <= 57) or (b == 48 and #k == 1) or (b == 45 and #k > 1 and sbyte(k, 2) ~= 48)) and #k <= 15
			and not sfind(k, "[^%d]", if b == 45 then 2 else 1) then
			return tonumber(k)
		end
		return k
	end
	if k == nil then return "undefined" end
	if t == "boolean" then return tostring(k) end
	if isD(k) then return JS.k(DP.toString(k)) end
	if t == "table" and LEN[k] then return JS.k(JS.str(k)) end   -- obj[[14]] is obj["14"]
	return k
end

-- loop guards the transpiler puts in (see js2lua guard / forStmt)
function JS.runaway() error("the game got stuck in a loop that never ends", 2) end
function JS.cap(s, l, step)
	if type(s) == "number" and type(l) == "number" and (l - s) / step > 5e6 then JS.runaway() end
	return l
end

function JS.len(x)
	local n = LEN[x]
	if n then return n end
	local t = type(x)
	if t == "string" then return utf8.len(x) or #x end
	if t == "table" then return rawget(x, "length") end
	if t == "function" then return 0 end
	error("Cannot read properties of " .. tostring(x) .. " (reading 'length')", 2)
end
function JS.setlen(a, n)
	KC[a] = nil
	local cur = LEN[a]
	if cur then for i = n, cur - 1 do a[i] = nil end LEN[a] = n return end
	a.length = n
end

function JS.A(n, ...)
	local t = {}
	for i = 1, n do t[i - 1] = (select(i, ...)) end
	LEN[t] = n
	return t
end
local function newArr(list, n) -- 1-based lua list -> JS array
	local t = {}
	n = n or #list
	for i = 1, n do t[i - 1] = list[i] end
	LEN[t] = n
	return t
end
JS.newArr = newArr
local function toList(a) -- JS array -> 1-based list
	local n = LEN[a] or 0
	local l = table.create(n)
	for i = 0, n - 1 do l[i + 1] = a[i] end
	return l, n
end
JS.toList = toList
function JS.isArray(x) return LEN[x] ~= nil end

function JS.O(t, order)
	if order then ORDER[t] = table.clone(order) end
	return t
end
function JS.set(o, k, v)
	local n = LEN[o]
	if n and type(k) == "number" then
		if k >= n then LEN[o] = k + 1 end
		if (rawget(o, k) == nil) ~= (v == nil) then KC[o] = nil end
		o[k] = v
		return
	end
	if type(o) == "table" and (rawget(o, k) == nil) ~= (v == nil) then KC[o] = nil end
	if type(k) == "string" and v ~= nil and rawget(o, k) == nil and type(o) == "table" then
		local ord = ORDER[o]
		if not ord then ord = {}; ORDER[o] = ord end
		ord[#ord + 1] = k
	end
	o[k] = v
end
JS.setk = JS.set

local function sortedKeys(o)
	local nums, strs, seen = {}, {}, {}
	local ord = ORDER[o]
	if ord then
		for _, k in ord do
			if not seen[k] and rawget(o, k) ~= nil then seen[k] = true; strs[#strs + 1] = k end
		end
	end
	local rest = {}
	for k, v in pairs(o) do
		local tk = type(k)
		if tk == "number" then nums[#nums + 1] = k
		elseif tk == "string" and not seen[k] then rest[#rest + 1] = k end
	end
	tsort(nums)
	tsort(rest)
	local out = nums
	for _, k in strs do out[#out + 1] = k end
	for _, k in rest do out[#out + 1] = k end
	return out
end
function JS.keylist(o)
	if o == nil then return {} end
	if type(o) == "string" then local l = {}; for i = 0, #o - 1 do l[i + 1] = i end return l end
	if type(o) ~= "table" or isD(o) then return {} end
	return sortedKeys(o)
end
-- for-in over an array skips an index that is gone by the time the loop gets to it (the game splices arrays while
-- it walks them, e.g. adjustPopupTime); objects keep the fast path
local function liveIdx(st, i)
	local c, a = st[1], st[2]
	while true do
		i += 1
		local k = c[i]
		if k == nil then return nil end
		if type(k) == "number" then
			if k < (LEN[a] or 0) then return i, k end
		elseif rawget(a, k) ~= nil then return i, k end
	end
end
function JS.keys(o)
	if type(o) == "table" then
		local c = KC[o]
		if c == nil then c = JS.keylist(o); KC[o] = c end
		if LEN[o] then return liveIdx, { c, o }, 0 end
		return ipairs(c)
	end
	return ipairs(JS.keylist(o))
end
JS.KC = KC
function JS.vals(o)
	local n = LEN[o]
	if n then local l = {}; for i = 0, n - 1 do l[i + 1] = o[i] end return ipairs(l) end
	if type(o) == "string" then local l = {}; for i = 1, #o do l[i] = ssub(o, i, i) end return ipairs(l) end
	error("not iterable")
end

local function str(x)
	local t = type(x)
	if t == "string" then return x end
	if x == NULL then return "null" end
	if t == "number" then return numToString(x) end
	if x == nil then return "undefined" end
	if t == "boolean" then return if x then "true" else "false" end
	if t == "function" then return "function" end
	if isD(x) then return DP.toString(x) end
	if LEN[x] then
		local l, n = toList(x)
		for i = 1, n do l[i] = if l[i] == nil then "" else str(l[i]) end
		return tconcat(l, ",", 1, n)
	end
	if t == "table" and rawget(x, "toString") then return x:toString() end
	return "[object Object]"
end
JS.str = str

local function tonum(x)
	local t = type(x)
	if t == "number" then return x end
	if t == "string" then
		local s = string.match(x, "^%s*(.-)%s*$")
		if s == "" then return 0 end
		if s == "Infinity" or s == "+Infinity" then return huge end
		if s == "-Infinity" then return -huge end
		local n = tonumber(s)
		if n == nil or string.find(s, "^0[xX]") == nil and string.find(s, "[^%d%.eE%+%-]") then return if n and not string.find(s, "[^%d%.eE%+%-xX]") then n else 0 / 0 end
		return n
	end
	if t == "boolean" then return if x then 1 else 0 end
	if x == nil then return 0 / 0 end
	if x == NULL then return 0 end
	if isD(x) then return tonum(DP.toString(x)) end
	if LEN[x] then local n = LEN[x]; if n == 0 then return 0 end if n == 1 then return tonum(x[0]) end end
	return 0 / 0
end
JS.tonum = tonum

function JS.add(a, b)
	local ta, tb = type(a), type(b)
	if ta == "number" and tb == "number" then return a + b end
	if ta == "string" or tb == "string" or ta == "table" or tb == "table" then return str(a) .. str(b) end
	return tonum(a) + tonum(b)
end

function JS.eq(a, b)
	if a == b then return true end
	if (a == nil or a == NULL) and (b == nil or b == NULL) then return true end
	local ta, tb = type(a), type(b)
	if ta == tb then return false end
	if (ta == "number" and tb == "string") or (ta == "string" and tb == "number") then return tonum(a) == tonum(b) end
	return false
end

function JS.cmp(a, op, b)
	if type(a) == "string" and type(b) == "string" then
		if op == "<" then return a < b elseif op == ">" then return a > b elseif op == "<=" then return a <= b else return a >= b end
	end
	local x, y = tonum(a), tonum(b)
	if op == "<" then return x < y elseif op == ">" then return x > y elseif op == "<=" then return x <= y else return x >= y end
end

function JS.typeof(x)
	local t = type(x)
	if t == "nil" then return "undefined" end
	if t == "table" then
		local mt = getmetatable(x)
		if mt and mt.__call and mt.__jsfunc then return "function" end
		return "object"
	end
	return t
end

function JS.has(o, k) if type(o) ~= "table" then return false end return o[JS.k(k)] ~= nil end
function JS.and_(a, f) if truthy(a) then return f() end return a end
function JS.or_(a, f) if truthy(a) then return a end return f() end
function JS.nc(a, f) if a == nil or a == NULL then return f() end return a end

function JS.mc(o, k, ...)
	local f = o[k]
	if f == nil then error("TypeError: " .. str(k) .. " is not a function", 2) end
	return f(o, ...)
end

-- ------------------------------------------------------------------ regex (only the two this game uses)
function JS.re(p, flags) return { __re = p, flags = flags } end
local function commafy(s) -- /(\d)(?=(\d\d\d)+(?!\d))/g -> "$1,"
	local out, n = {}, #s
	-- apply to every digit run
	local i = 1
	while i <= n do
		local a, b = sfind(s, "%d+", i)
		if not a then out[#out + 1] = ssub(s, i); break end
		out[#out + 1] = ssub(s, i, a - 1)
		local run = ssub(s, a, b)
		local L = #run
		local parts = {}
		local first = L % 3
		if first == 0 then first = 3 end
		parts[1] = ssub(run, 1, first)
		for j = first + 1, L, 3 do parts[#parts + 1] = ssub(run, j, j + 2) end
		out[#out + 1] = tconcat(parts, ",")
		i = b + 1
	end
	return tconcat(out)
end

-- ------------------------------------------------------------------ builtin methods (array / string / number / function)
local function stableSort(list, n, cmp)
	-- merge sort (JS sort is stable)
	if n < 2 then return list end
	local tmp = table.create(n)
	local width = 1
	local src, dst = list, tmp
	while width < n do
		local i = 1
		while i <= n do
			local mid = math.min(i + width, n + 1)
			local hi = math.min(i + 2 * width, n + 1)
			local a, b, k = i, mid, i
			while a < mid and b < hi do
				if cmp(src[b], src[a]) then dst[k] = src[b]; b += 1 else dst[k] = src[a]; a += 1 end
				k += 1
			end
			while a < mid do dst[k] = src[a]; a += 1; k += 1 end
			while b < hi do dst[k] = src[b]; b += 1; k += 1 end
			i += 2 * width
		end
		src, dst = dst, src
		width *= 2
	end
	return src
end

local AM = {}  -- array methods
function AM.push(a, ...) KC[a] = nil;
	local n = LEN[a]
	for i = 1, select("#", ...) do a[n] = (select(i, ...)); n += 1 end
	LEN[a] = n
	return n
end
function AM.pop(a) KC[a] = nil; local n = LEN[a]; if n == 0 then return nil end local v = a[n - 1]; a[n - 1] = nil; LEN[a] = n - 1; return v end
function AM.shift(a) KC[a] = nil;
	local n = LEN[a]; if n == 0 then return nil end
	local v = a[0]
	for i = 1, n - 1 do a[i - 1] = a[i] end
	a[n - 1] = nil; LEN[a] = n - 1
	return v
end
function AM.unshift(a, ...) KC[a] = nil;
	local c = select("#", ...)
	local n = LEN[a]
	for i = n - 1, 0, -1 do a[i + c] = a[i] end
	for i = 1, c do a[i - 1] = (select(i, ...)) end
	LEN[a] = n + c
	return n + c
end
function AM.includes(a, v) local n = LEN[a]; for i = 0, n - 1 do local x = a[i]; if x == v or (x ~= x and v ~= v) then return true end end return false end
function AM.indexOf(a, v) local n = LEN[a]; for i = 0, n - 1 do if a[i] == v then return i end end return -1 end
function AM.lastIndexOf(a, v) for i = LEN[a] - 1, 0, -1 do if a[i] == v then return i end end return -1 end
function AM.join(a, sep)
	if sep == nil then sep = "," end
	local l, n = toList(a)
	for i = 1, n do l[i] = if l[i] == nil then "" else str(l[i]) end
	return tconcat(l, sep, 1, n)
end
AM.toString = function(a) return AM.join(a) end
local function relIdx(i, n, def)
	if i == nil then return def end
	i = tonum(i)
	if i ~= i then return 0 end
	i = if i < 0 then math.max(n + i, 0) else math.min(i, n)
	return floor(i)
end
function AM.slice(a, s, e)
	local n = LEN[a]
	s, e = relIdx(s, n, 0), relIdx(e, n, n)
	local out, k = {}, 0
	for i = s, e - 1 do out[k] = a[i]; k += 1 end
	LEN[out] = math.max(k, 0)
	return out
end
function AM.splice(a, s, dc, ...) KC[a] = nil;
	local n = LEN[a]
	s = relIdx(s, n, 0)
	if dc == nil then dc = n - s end
	dc = math.max(0, math.min(floor(tonum(dc)), n - s))
	local removed = {}
	for i = 0, dc - 1 do removed[i] = a[s + i] end
	LEN[removed] = dc
	local ins = select("#", ...)
	local l = toList(a)
	local nl = {}
	for i = 1, s do nl[#nl + 1] = l[i] end
	for i = 1, ins do nl[#nl + 1] = (select(i, ...)) end
	for i = s + dc + 1, n do nl[#nl + 1] = l[i] end
	local nn = s + ins + (n - s - dc)
	for i = 0, math.max(n, nn) - 1 do a[i] = nl[i + 1] end
	LEN[a] = nn
	return removed
end
function AM.sort(a, cmpf) KC[a] = nil;
	local l, n = toList(a)
	local less
	if cmpf then less = function(x, y) return tonum(cmpf(nil, x, y)) < 0 end
	else less = function(x, y) return str(x) < str(y) end end
	l = stableSort(l, n, less)
	for i = 1, n do a[i - 1] = l[i] end
	return a
end
function AM.reverse(a) KC[a] = nil; local l, n = toList(a); for i = 1, n do a[i - 1] = l[n - i + 1] end return a end
function AM.map(a, f) local n = LEN[a]; local out = {}; for i = 0, n - 1 do out[i] = f(nil, a[i], i, a) end LEN[out] = n; return out end
function AM.filter(a, f) local n = LEN[a]; local out, k = {}, 0; for i = 0, n - 1 do if truthy(f(nil, a[i], i, a)) then out[k] = a[i]; k += 1 end end LEN[out] = k; return out end
function AM.forEach(a, f) local n = LEN[a]; for i = 0, n - 1 do f(nil, a[i], i, a) end end
function AM.find(a, f) local n = LEN[a]; for i = 0, n - 1 do if truthy(f(nil, a[i], i, a)) then return a[i] end end return nil end
function AM.findIndex(a, f) local n = LEN[a]; for i = 0, n - 1 do if truthy(f(nil, a[i], i, a)) then return i end end return -1 end
function AM.some(a, f) local n = LEN[a]; for i = 0, n - 1 do if truthy(f(nil, a[i], i, a)) then return true end end return false end
function AM.every(a, f) local n = LEN[a]; for i = 0, n - 1 do if not truthy(f(nil, a[i], i, a)) then return false end end return true end
function AM.reduce(a, f, ...)
	local n = LEN[a]
	local i, acc = 0, nil
	if select("#", ...) > 0 then acc = (...) else acc = a[0]; i = 1 end
	while i < n do acc = f(nil, acc, a[i], i, a); i += 1 end
	return acc
end
function AM.concat(a, ...)
	local l, n = toList(a)
	for j = 1, select("#", ...) do
		local b = select(j, ...)
		if LEN[b] then local bl, bn = toList(b); for i = 1, bn do n += 1; l[n] = bl[i] end
		else n += 1; l[n] = b end
	end
	return newArr(l, n)
end
function AM.fill(a, v, s, e) KC[a] = nil; local n = LEN[a]; s, e = relIdx(s, n, 0), relIdx(e, n, n); for i = s, e - 1 do a[i] = v end return a end

local SM = {}  -- string methods
local function plainFind(s, sub, init) return sfind(s, sub, init, true) end
function SM.includes(s, sub) return plainFind(s, str(sub), 1) ~= nil end
function SM.indexOf(s, sub, from) local a = plainFind(s, str(sub), (from or 0) + 1); return if a then a - 1 else -1 end
function SM.startsWith(s, p) return ssub(s, 1, #p) == p end
function SM.endsWith(s, p) return p == "" or ssub(s, -#p) == p end
function SM.toUpperCase(s) return supper(s) end
function SM.toLowerCase(s) return slower(s) end
function SM.trim(s) return (string.match(s, "^%s*(.-)%s*$")) end
function SM.charAt(s, i) i = floor(tonum(i or 0)); return ssub(s, i + 1, i + 1) end
function SM.charCodeAt(s, i) return sbyte(s, floor(tonum(i or 0)) + 1) or (0 / 0) end
function SM.rep(s, n) return srep(s, floor(tonum(n))) end
SM["repeat"] = SM.rep
function SM.slice(s, a, b)
	local n = #s
	a, b = relIdx(a, n, 0), relIdx(b, n, n)
	if b <= a then return "" end
	return ssub(s, a + 1, b)
end
function SM.substring(s, a, b)
	local n = #s
	a = math.max(0, math.min(floor(tonum(a or 0)), n)); b = if b == nil then n else math.max(0, math.min(floor(tonum(b)), n))
	if a > b then a, b = b, a end
	return ssub(s, a + 1, b)
end
function SM.substr(s, a, len) local n = #s; a = relIdx(a, n, 0); len = if len == nil then n - a else floor(len); return ssub(s, a + 1, a + len) end
function SM.padStart(s, len, fill) fill = fill or " "; while #s < len do s = fill .. s end return ssub(s, -len) end
function SM.padEnd(s, len, fill) fill = fill or " "; while #s < len do s = s .. fill end return ssub(s, 1, len) end
function SM.toString(s) return s end
SM.valueOf = SM.toString
function SM.split(s, sep)
	if sep == nil then return newArr({ s }, 1) end
	local out = {}
	if sep == "" then for i = 1, #s do out[i] = ssub(s, i, i) end return newArr(out, #s) end
	local i = 1
	while true do
		local a, b = plainFind(s, sep, i)
		if not a then out[#out + 1] = ssub(s, i); break end
		out[#out + 1] = ssub(s, i, a - 1)
		i = b + 1
	end
	return newArr(out, #out)
end
function SM.replace(s, pat, rep)
	if type(pat) == "table" and pat.__re then
		if pat.__re == "(\\d)(?=(\\d\\d\\d)+(?!\\d))" then return commafy(s) end
		if pat.__re == "([^(?:e|F)]*)$" then
			-- '-$1': put a minus in front of the trailing run of characters that are none of ( ? : e | F )
			local i = #s
			while i >= 1 do
				local c = ssub(s, i, i)
				if c == "(" or c == "?" or c == ":" or c == "e" or c == "|" or c == "F" or c == ")" then break end
				i -= 1
			end
			return ssub(s, 1, i) .. "-" .. ssub(s, i + 1)
		end
		error("unsupported regex " .. pat.__re)
	end
	pat = str(pat)
	local a, b = plainFind(s, pat, 1)
	if not a then return s end
	local r = if type(rep) == "function" then str(rep(nil, pat)) else str(rep)
	return ssub(s, 1, a - 1) .. r .. ssub(s, b + 1)
end
function SM.concat(s, ...) local out = s; for i = 1, select("#", ...) do out ..= str((select(i, ...))) end return out end

local NM = {}  -- number methods
NM.toFixed = function(x, f) return toFixed(x, f) end
NM.toPrecision = function(x, p) if p == nil then return numToString(x) end return toPrecision(x, p) end
NM.toString = function(x, radix)
	if radix == nil or radix == 10 then return numToString(x) end
	local n, digits, neg = floor(abs(x)), {}, x < 0
	if n == 0 then return "0" end
	local chars = "0123456789abcdefghijklmnopqrstuvwxyz"
	while n > 0 do local d = n % radix; tinsert(digits, 1, ssub(chars, d + 1, d + 1)); n = floor(n / radix) end
	return (if neg then "-" else "") .. tconcat(digits)
end
NM.toLocaleString = function(x) return commafy(numToString(x)) end
NM.valueOf = function(x) return x end

local FM = {}  -- function methods
function FM.bind(f, thisArg, ...)
	local bound = table.pack(...)
	if bound.n == 0 then return function(_, ...) return f(thisArg, ...) end end
	return function(_, ...)
		local args = table.pack(...)
		local all = table.create(bound.n + args.n)
		for i = 1, bound.n do all[i] = bound[i] end
		for i = 1, args.n do all[bound.n + i] = args[i] end
		return f(thisArg, table.unpack(all, 1, bound.n + args.n))
	end
end
function FM.call(f, thisArg, ...) return f(thisArg, ...) end
function FM.apply(f, thisArg, arr) if arr == nil then return f(thisArg) end local l, n = toList(arr); return f(thisArg, table.unpack(l, 1, n)) end
FM.toString = function() return "function" end

function JS.m(o, name, ...)
	local t = type(o)
	if t == "table" then
		if LEN[o] then
			local f = AM[name]
			if f then return f(o, ...) end
		end
		local mt = getmetatable(o)
		if mt == DMT then
			local f = DP[name]
			if f then return f(o, ...) end
			error("Decimal has no method " .. name, 2)
		end
		local f = rawget(o, name)
		if f ~= nil then return f(o, ...) end
		if name == "hasOwnProperty" then return rawget(o, JS.k((...))) ~= nil end
		if name == "toString" then return str(o) end
		if name == "valueOf" then return o end
		if name == "toFixed" or name == "toPrecision" then return NM[name](tonum(o), ...) end
		error("TypeError: o." .. name .. " is not a function", 2)
	elseif t == "string" then
		local f = SM[name]
		if f then return f(o, ...) end
	elseif t == "number" then
		local f = NM[name]
		if f then return f(o, ...) end
	elseif t == "function" then
		local f = FM[name]
		if f then return f(o, ...) end
	elseif t == "boolean" then
		if name == "toString" then return str(o) end
	end
	error("TypeError: " .. str(o) .. "." .. name .. " is not a function", 2)
end

-- ------------------------------------------------------------------ globals the game touches
local G = {}
JS.G = G

local function callable(tbl, f) tbl.__jsfunc = true; return setmetatable(tbl, { __call = f, __jsfunc = true }) end

local seed = 12345
local JMath = {
	PI = math.pi, E = math.exp(1), LN10 = math.log(10), LN2 = math.log(2), LOG10E = 1 / math.log(10), LOG2E = 1 / math.log(2), SQRT2 = math.sqrt(2),
	floor = function(x) return floor(tonum(x)) end,
	ceil = function(x) return math.ceil(tonum(x)) end,
	round = function(x) x = tonum(x); return floor(x + 0.5) end,
	trunc = function(x) x = tonum(x); if x < 0 then return math.ceil(x) end return floor(x) end,
	abs = function(x) return abs(tonum(x)) end,
	sign = function(x) x = tonum(x); if x > 0 then return 1 elseif x < 0 then return -1 end return x end,
	pow = function(a, b) a, b = tonum(a), tonum(b); if b ~= b then return 0 / 0 end if b == 0 then return 1 end return a ^ b end,
	sqrt = function(x) x = tonum(x); if x < 0 then return 0 / 0 end return math.sqrt(x) end,
	cbrt = function(x) x = tonum(x); if x < 0 then return -((-x) ^ (1 / 3)) end return x ^ (1 / 3) end,
	exp = function(x) return math.exp(tonum(x)) end,
	log = function(x) x = tonum(x); if x < 0 then return 0 / 0 end return math.log(x) end,
	log10 = function(x) x = tonum(x); if x < 0 then return 0 / 0 end return math.log10(x) end,
	log2 = function(x) x = tonum(x); if x < 0 then return 0 / 0 end return math.log(x, 2) end,
	sin = function(x) return math.sin(tonum(x)) end, cos = function(x) return math.cos(tonum(x)) end, tan = function(x) return math.tan(tonum(x)) end,
	atan = function(x) return math.atan(tonum(x)) end, atan2 = function(y, x) return math.atan2(tonum(y), tonum(x)) end,
	hypot = function(a, b) return math.sqrt(tonum(a) ^ 2 + tonum(b) ^ 2) end,
	max = function(...)
		local r = -huge
		for i = 1, select("#", ...) do local v = tonum((select(i, ...))); if v ~= v then return 0 / 0 end if v > r then r = v end end
		return r
	end,
	min = function(...)
		local r = huge
		for i = 1, select("#", ...) do local v = tonum((select(i, ...))); if v ~= v then return 0 / 0 end if v < r then r = v end end
		return r
	end,
	random = function() seed = fmod(seed * 1103515245 + 12345, 2147483648); return seed / 2147483648 end,
}
JS.Math = JMath
function JS.seed(s) seed = s end

local Date = { now = function() return JS.NOW end }
JS.DateCtor = Date

local Object = {
	keys = function(o) local l = JS.keylist(o); for i, k in l do l[i] = if type(k) == "number" then numToString(k) else k end return newArr(l, #l) end,
	values = function(o) local l = JS.keylist(o); for i, k in l do l[i] = o[k] end return newArr(l, #l) end,
	entries = function(o) local l = JS.keylist(o); for i, k in l do l[i] = JS.A(2, if type(k) == "number" then numToString(k) else k, o[k]) end return newArr(l, #l) end,
	assign = function(t, ...)
		for i = 1, select("#", ...) do
			local s = select(i, ...)
			if s ~= nil then for _, k in JS.keylist(s) do JS.set(t, k, s[k]) end end
		end
		return t
	end,
	freeze = function(o) return o end,
	getOwnPropertyNames = function(o) return G.Object.keys(o) end,
}

local function isNaNf(x) local n = tonum(x); return n ~= n end
local Number = callable({
	isFinite = function(x) return type(x) == "number" and x == x and abs(x) ~= huge end,
	isNaN = function(x) return type(x) == "number" and x ~= x end,
	isInteger = function(x) return type(x) == "number" and x == floor(x) and abs(x) ~= huge end,
	parseFloat = function(x) return G.parseFloat(nil, x) end,
	MAX_VALUE = 1.7976931348623157e308, MIN_VALUE = 5e-324, MAX_SAFE_INTEGER = 9007199254740991, EPSILON = 2 ^ -52,
	POSITIVE_INFINITY = huge, NEGATIVE_INFINITY = -huge, NaN = 0 / 0,
}, function(_, _this, x) if x == nil then return 0 end return tonum(x) end)
local String = callable({}, function(_, _this, x) return str(x) end)
local Boolean = callable({}, function(_, _this, x) return truthy(x) end)
local Array = callable({ isArray = function(x) return LEN[x] ~= nil end, from = function(x) local l, n = toList(x); return newArr(l, n) end },
	function(_, _this, n) local a = {}; LEN[a] = n or 0; return a end)

-- JSON (save strings)
local function jsonEnc(v, out)
	local t = type(v)
	if v == nil or v == NULL then out[#out + 1] = "null"
	elseif t == "boolean" then out[#out + 1] = tostring(v)
	elseif t == "number" then out[#out + 1] = if v ~= v or abs(v) == huge then "null" else numToString(v)
	elseif t == "string" then out[#out + 1] = '"' .. string.gsub(v, '[%c"\\]', function(c)
			if c == '"' then return '\\"' elseif c == "\\" then return "\\\\" elseif c == "\n" then return "\\n"
			elseif c == "\t" then return "\\t" elseif c == "\r" then return "\\r" elseif c == "\b" then return "\\b" elseif c == "\f" then return "\\f" end
			return sfmt("\\u%04x", sbyte(c))
		end) .. '"'
	elseif isD(v) then jsonEnc(DP.toString(v), out)
	elseif LEN[v] then
		out[#out + 1] = "["
		for i = 0, LEN[v] - 1 do if i > 0 then out[#out + 1] = "," end jsonEnc(v[i], out) end
		out[#out + 1] = "]"
	elseif t == "table" then
		out[#out + 1] = "{"
		local first = true
		for _, k in JS.keylist(v) do
			local x = v[k]
			if x ~= nil and type(x) ~= "function" then
				if not first then out[#out + 1] = "," end
				first = false
				jsonEnc(if type(k) == "number" then numToString(k) else k, out)
				out[#out + 1] = ":"
				jsonEnc(x, out)
			end
		end
		out[#out + 1] = "}"
	else out[#out + 1] = "null" end
end
local JSON = {
	stringify = function(v) local out = {}; jsonEnc(v, out); return tconcat(out) end,
	parse = function(s)
		local pos = 1
		local function ws() pos = sfind(s, "[^%s]", pos) or #s + 1 end
		local val
		local function strv()
			local out = {}
			pos += 1
			while true do
				local c = ssub(s, pos, pos)
				if c == '"' then pos += 1; break end
				if c == "\\" then
					local e = ssub(s, pos + 1, pos + 1)
					if e == "u" then out[#out + 1] = utf8.char(tonumber(ssub(s, pos + 2, pos + 5), 16)); pos += 6
					else out[#out + 1] = ({ n = "\n", t = "\t", r = "\r", b = "\b", f = "\f" })[e] or e; pos += 2 end
				else out[#out + 1] = c; pos += 1 end
			end
			return tconcat(out)
		end
		function val()
			ws()
			local c = ssub(s, pos, pos)
			if c == "{" then
				local o = {}
				pos += 1; ws()
				if ssub(s, pos, pos) == "}" then pos += 1 return o end
				while true do
					ws()
					local k = JS.k(strv())
					ws(); pos += 1
					JS.set(o, k, val())
					ws()
					local d = ssub(s, pos, pos); pos += 1
					if d == "}" then return o end
				end
			elseif c == "[" then
				local l = {}
				pos += 1; ws()
				if ssub(s, pos, pos) == "]" then pos += 1 return newArr(l, 0) end
				local n = 0
				while true do
					n += 1; l[n] = val(); ws()
					local d = ssub(s, pos, pos); pos += 1
					if d == "]" then return newArr(l, n) end
				end
			elseif c == '"' then return strv()
			elseif ssub(s, pos, pos + 3) == "true" then pos += 4 return true
			elseif ssub(s, pos, pos + 4) == "false" then pos += 5 return false
			elseif ssub(s, pos, pos + 3) == "null" then pos += 4 return NULL
			else
				local a, b = sfind(s, "^%-?[%d%.eE%+%-]+", pos)
				pos = b + 1
				return tonumber(ssub(s, a, b))
			end
		end
		return val()
	end,
}

local stub
stub = setmetatable({}, { __index = function() return stub end, __call = function() return stub end, __newindex = function() end })

G.Math, G.Decimal, G.Object, G.JSON, G.Number, G.String, G.Boolean, G.Array, G.Date = JMath, Decimal, Object, JSON, Number, String, Boolean, Array, Date
G.console = { log = function(...) print(...) end, warn = function(...) print(...) end, error = function(...) print(...) end }
G.isNaN = function(_, x) return isNaNf(x) end
G.isFinite = function(_, x) local n = tonum(x); return n == n and abs(n) ~= huge end
G.parseFloat = function(_, x)
	if type(x) == "number" then return x end
	return jsParseFloat(str(x))
end
G.parseInt = function(_, x) local n = G.parseFloat(nil, x); if n ~= n then return n end return if n < 0 then math.ceil(n) else floor(n) end
G.localStorage = { getItem = function() return nil end, setItem = function() end, removeItem = function() end }
G.document, G.window, G.navigator = stub, stub, stub
G.Vue = { set = function(o, k, v) JS.set(o, k, v) end, component = function() end, delete = function(o, k) o[k] = nil end }
G.setInterval = function() return 0 end
G.setTimeout = function() return 0 end
G.clearInterval = function() end
G.alert = function() end
G.confirm = function() return true end
G.prompt = function() return nil end

function JS.new(C, ...)
	if C == Date then return { getTime = function() return JS.NOW end } end
	if C == Decimal then return D((...)) end
	if C == Array then return Array(nil, ...) end
	if type(C) == "function" then local o = {}; C(o, ...); return o end
	error("cannot construct")
end
function JS.instanceof(x, C)
	if x == nil or x == NULL then return false end
	if C == Decimal then return isD(x) end
	if C == Array then return LEN[x] ~= nil end
	if C == Object then return type(x) == "table" end
	return false
end

Object.name, Decimal.name, Array.name, Number.name, String.name, Boolean.name = "Object", "Decimal", "Array", "Number", "String", "Boolean"
local FunctionCtor = { name = "Function" }
function JS.get(o, k)
	local t = type(o)
	if k == "constructor" then
		if t == "function" then return FunctionCtor end
		if t == "number" then return Number end
		if t == "string" then return String end
		if t == "boolean" then return Boolean end
		if t ~= "table" then return nil end
		if isD(o) then return Decimal end
		if LEN[o] then return Array end
		local c = rawget(o, "constructor")
		if c ~= nil then return c end
		return Object
	end
	if t == "function" then return FM[k] end
	if t ~= "table" then return nil end
	return o[k]
end

-- ------------------------------------------------------------------ environment for the transpiled chunks
local ENV = setmetatable({}, { __index = G })
ENV.JS = JS
ENV.math = math
ENV.bit32 = bit32
ENV.pcall = pcall
ENV.error = error
ENV.type = type
ENV.print = print
JS.ENV = ENV

-- TMT helpers whose JS versions depend on JS object internals
function JS.overrides()
	ENV.isFunction = function(_, f) return type(f) == "function" end
	ENV.isPlainObject = function(_, o) return type(o) == "table" and getmetatable(o) == nil and LEN[o] == nil end
	-- native versions of two per-tick TMT walkers (same behaviour, no JS-emulation overhead)
	local function updateTempData(_, layerData, tmpData, funcsData, useThis)
		for _, item in JS.keys(funcsData) do
			ENV.item = item
			local ld = layerData[item]
			local tl = type(ld)
			if tl == "table" then
				if LEN[ld] then
					if item ~= "tabFormat" and item ~= "content" then updateTempData(nil, ld, tmpData[item], funcsData[item], useThis) end
				elseif getmetatable(ld) == nil then
					updateTempData(nil, ld, tmpData[item], funcsData[item], useThis)
				end
			elseif tl == "function" and type(tmpData[item]) ~= "function" then
				local value
				if useThis ~= nil then value = ld(useThis) else value = ld(layerData) end
				JS.set(tmpData, item, value)
			end
		end
	end
	ENV.updateTempData = updateTempData
	local function NaNcheck(_, data)
		for _, item in JS.keys(data) do
			local v = data[item]
			if v == nil or v == NULL then
			elseif LEN[v] then NaNcheck(nil, v)
			elseif v ~= v or (isD(v) and TN.isNaN(v.v)) then
				if not ENV.NaNalert then
					ENV.NaNalert = true
					print("NaN in player: '" .. str(item) .. "'")
					return
				end
			elseif isD(v) then
			elseif type(v) == "table" and getmetatable(v) == nil then NaNcheck(nil, v)
			end
		end
	end
	ENV.NaNcheck = NaNcheck
	ENV.toNumber = function(_, x)   -- utils.js: Decimals convert, numbers stay, anything else goes through parseFloat
		if isD(x) then return DP.toNumber(x) end
		if type(x) == "number" then return x end
		return G.parseFloat(nil, x)
	end
end

return JS
end
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">Session</string>
          <string name="Source"><![CDATA[--!nocheck
--[[
	Session: one player's Milestone Tree NG+ game. Pure Luau (no Roblox services), so the same code runs in the
	server's per-player Actor and in the command-line tests.

	    local s = Session.new(deps, saveJson?, optionsJson?, nowMs)
	    s:tick(nowMs)                 -- the page's 50 ms interval body (offline time, updateTemp, gameLoop, ...)
	    s:act(action, nowMs, hold)    -- a button press; only actions that are on the player's screen are run
	    local patch = s:view()        -- what changed on the player's screen since the last view (see below)
	    local save, opts = s:save()   -- JSON strings for the DataStore (nil while the game holds a NaN)

	deps = { TN = TowerNum, JSRT = the JSRT factory, BEcore = BEcore, chunks = { function... } in load order }

	A view patch is { set = { [id] = node }, del = { id... }, tab = name, tabStyle = css, keys = { hotkey... },
	ended = bool, pop = { popup... }, full = true on the first patch }. Nodes are the view builder's (rbx/view.js)
	flattened: a container's c lists its children's ids; ids are paths ("tab.3.1") and the three roots are
	"menu", "head" and "tab".
]]

local Session = {}
Session.__index = Session

local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64INV = {}
for i = 1, 64 do B64INV[string.byte(B64, i)] = i - 1 end

local function b64encode(s: string): string
	local out = table.create(math.ceil(#s / 3) * 4)
	for i = 1, #s, 3 do
		local a, b, c = string.byte(s, i, i + 2)
		local n = a * 65536 + (b or 0) * 256 + (c or 0)
		local c1, c2, c3, c4 = bit32.extract(n, 18, 6), bit32.extract(n, 12, 6), bit32.extract(n, 6, 6), bit32.extract(n, 0, 6)
		table.insert(out, string.sub(B64, c1 + 1, c1 + 1) .. string.sub(B64, c2 + 1, c2 + 1)
			.. (if b then string.sub(B64, c3 + 1, c3 + 1) else "=") .. (if c then string.sub(B64, c4 + 1, c4 + 1) else "="))
	end
	return table.concat(out)
end
local function b64decode(s: string): string?
	s = string.gsub(s, "[^%w%+/=]", "")
	local out = {}
	local bits, nbits = 0, 0
	for i = 1, #s do
		local ch = string.byte(s, i)
		if ch == 61 then break end -- "="
		local v = B64INV[ch]
		if v == nil then return nil end
		bits = bit32.bor(bit32.lshift(bits, 6), v)
		nbits += 6
		if nbits >= 8 then
			nbits -= 8
			table.insert(out, string.char(bit32.band(bit32.rshift(bits, nbits), 255)))
		end
		bits = bit32.band(bits, 0xFFFF)
	end
	return table.concat(out)
end
Session.b64encode, Session.b64decode = b64encode, b64decode

-- JS value -> plain Luau (1-based arrays, string keys) that RemoteEvents carry
local function plain(JS, x)
	if x == JS.NULL then return nil end   -- JS null is a sentinel table
	local t = type(x)
	if t ~= "table" then
		if t == "number" and x ~= x then return "NaN" end
		return x
	end
	if JS.isD(x) then return JS.str(x) end
	local n = JS.LEN[x]
	if n then
		local out = table.create(n)
		for i = 0, n - 1 do
			local v = plain(JS, x[i])
			if v == nil then v = false end
			out[i + 1] = v
		end
		return out
	end
	local out = {}
	for k, v in x do
		local tk = type(k)
		if (tk == "string" or tk == "number") and type(v) ~= "function" then
			local pv = plain(JS, v)
			if pv ~= nil then out[if tk == "number" then JS.str(k) else k] = pv end
		end
	end
	return out
end
Session.plain = plain

-- a stable text form of an action (arrays nest: ["click", "sp", [14]])
local function actionKey(a): string
	if type(a) ~= "table" then return tostring(a) end
	local parts = table.create(#a)
	for i, v in a do parts[i] = if type(v) == "table" then "[" .. actionKey(v) .. "]" else tostring(v) end
	return table.concat(parts, "\31")
end
Session.actionKey = actionKey

-- deterministic text form of a flattened node, for change detection
local function sig(v): string
	local t = type(v)
	if t ~= "table" then return tostring(v) end
	local keys = {}
	for k in v do table.insert(keys, k) end
	table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
	local parts = table.create(#keys)
	for i, k in keys do parts[i] = tostring(k) .. "=" .. sig(v[k]) end
	return "{" .. table.concat(parts, ",") .. "}"
end

local function flatten(node, id: string, out: { [string]: any })
	if type(node) ~= "table" then node = { t = "html", h = "" } end
	local entry = {}
	for k, v in node do
		if k ~= "c" then entry[k] = v end
	end
	local kids = node.c
	if type(kids) == "table" then
		local ids = table.create(#kids)
		local n = 0
		for _, child in kids do
			if type(child) == "table" then
				n += 1
				local cid = id .. "." .. n
				ids[n] = cid
				flatten(child, cid, out)
			end
		end
		entry.c = ids
	end
	out[id] = entry
end

local function toJS(JS, v)
	if type(v) ~= "table" then return v end
	local n = #v
	local l = table.create(n)
	for i = 1, n do l[i] = toJS(JS, v[i]) end
	return JS.newArr(l, n)
end

-- ------------------------------------------------------------------------------------------------------ lifecycle
function Session.new(deps, saveJson: string?, optionsJson: string?, nowMs: number)
	local self = setmetatable({}, Session)
	self.deps = deps
	self.prev = {}          -- id -> signature of what the client has
	self.allowed = {}       -- action key -> true, for what is on screen
	self.lastPopup = 0
	self.errors = 0
	self.notices = {}       -- messages for the player (import failed, NaN recovered...)
	self.hardResetArmed = 0
	self:_start(saveJson, optionsJson, nowMs)
	self.goodSave, self.goodOptions = self:save()
	return self
end

function Session:_start(saveJson: string?, optionsJson: string?, nowMs: number)
	local d = self.deps
	local JS = d.JSRT(d.TN, d.BEcore)
	local ENV = JS.ENV
	JS.NOW = nowMs
	JS.seed(math.random(1, 2147483646))
	for _, f in d.chunks do
		setfenv(f, ENV)
		f()
	end
	JS.overrides()
	ENV.rbx_boot(nil, saveJson or "", optionsJson or "")
	self.JS, self.ENV = JS, ENV
	self.prev = {}
	self.lastPopup = 0
	-- popups that were on screen when the game was saved are not news
	local pops = ENV.activePopups
	if pops and JS.LEN[pops] then
		for i = 0, JS.LEN[pops] - 1 do self.lastPopup = math.max(self.lastPopup, (pops[i].id or 0) + 1) end
	end
end

-- back to the last good save (the page's "refresh and you will be un-NaNed")
function Session:_recover(nowMs: number, why: string)
	table.insert(self.notices, why)
	self:_start(self.goodSave, self.goodOptions, nowMs)
end

function Session:tick(nowMs: number): boolean
	local JS, ENV = self.JS, self.ENV
	JS.NOW = nowMs
	local ok, err = pcall(ENV.rbx_tick, nil)
	if not ok then
		self.errors += 1
		self.lastError = tostring(err)
		if self.errors >= 3 then
			self.errors = 0
			self:_recover(nowMs, "The game hit an error and went back to your last save: " .. tostring(err))
		end
		return false
	end
	self.errors = 0
	if ENV.NaNalert then
		self:_recover(nowMs, "An invalid value (NaN) appeared, so the game went back to your last save.")
		return false
	end
	return true
end

-- ---------------------------------------------------------------------------------------------------------- actions
local HOLD_KIND = { click = "hold", grid = "gridHold", buy = "buy" }

function Session:act(a, nowMs: number, hold: boolean?): (boolean, string?)
	if type(a) ~= "table" or type(a[1]) ~= "string" or #a > 4 then return false, "bad action" end
	for _, v in a do
		local tv = type(v)
		if tv ~= "string" and tv ~= "number" and tv ~= "table" then return false, "bad action" end
		if tv == "string" and #v > 200 then return false, "bad action" end
	end
	local key = actionKey(a)
	if a[1] == "key" then
		if not self.hotkeys or not self.hotkeys[a[2]] then return false, "not a hotkey" end
	elseif not self.allowed[key] then
		return false, "not on screen"
	end
	if a[1] == "opt" then return self:_option(a[2], nowMs) end
	local JS, ENV = self.JS, self.ENV
	JS.NOW = nowMs
	local call = a
	if hold then
		local k = HOLD_KIND[a[1]]
		if not k then return false, "not holdable" end
		call = { k, a[2], a[3] }
	end
	local ok, err = pcall(ENV.rbx_do, nil, toJS(JS, call))
	if not ok then return false, tostring(err) end
	return true
end

function Session:_option(name: string, nowMs: number): (boolean, string?)
	if name == "save" then
		self.wantSave = true
		table.insert(self.notices, "Game saved.")
		return true
	elseif name == "hardReset" or name == "playAgain" then
		if name == "hardReset" and nowMs - self.hardResetArmed > 5000 then
			self.hardResetArmed = nowMs
			table.insert(self.notices, "Press Hard Reset again within 5 seconds to wipe your progress.")
			return true
		end
		self.hardResetArmed = 0
		local _, opts = self:save()
		self:_start(nil, opts, nowMs)
		self.goodSave, self.goodOptions = self:save()
		self.wantSave = true
		table.insert(self.notices, "Your progress was reset.")
		return true
	elseif name == "export" then
		self.exportText = self:export()
		return true
	elseif name == "import" then
		self.wantImport = true
		return true
	end
	local ok, err = pcall(self.ENV.rbx_do, nil, toJS(self.JS, { "opt", name }))
	return ok, if ok then nil else tostring(err)
end

-- the web game's export string: base64 of the player JSON (its Import accepts it back)
function Session:export(): string?
	local s = self:save()
	if s == nil then return nil end
	return b64encode(s)
end

-- a save string from the web game (Export, or the localStorage value) or from export(); JSON works too
function Session:import(text: string, nowMs: number): (boolean, string?)
	if type(text) ~= "string" or #text < 2 or #text > 3000000 then return false, "That is not a save." end
	text = string.gsub(text, "^%s+", "")
	text = string.gsub(text, "%s+$", "")
	local json = if string.sub(text, 1, 1) == "{" then text else b64decode(text)
	if json == nil or string.sub(json, 1, 1) ~= "{" then return false, "That is not a save." end
	local okParse, parsed = pcall(self.JS.G.JSON.parse, json)
	if not okParse or type(parsed) ~= "table" or parsed.points == nil then return false, "That is not a save for this game." end
	local oldSave, oldOpts = self:save()
	local ok, err = pcall(self._start, self, json, oldOpts, nowMs)
	if ok then
		ok, err = pcall(self.tick, self, nowMs)
		if ok and self.ENV.NaNalert then ok, err = false, "the save holds invalid values" end
	end
	if not ok then
		self:_start(oldSave, oldOpts, nowMs)
		return false, "That save could not be loaded (" .. tostring(err) .. ")."
	end
	self.goodSave, self.goodOptions = self:save()
	self.wantSave = true
	table.insert(self.notices, "Save imported.")
	return true
end

-- ------------------------------------------------------------------------------------------------------------ saves
function Session:save(): (string?, string?)
	local ok, r = pcall(self.ENV.rbx_saveData, nil)
	if not ok or r == nil or r == self.JS.NULL then return nil, nil end
	return r[0], r[1]
end

-- remember the current state as the one to fall back to; returns what to write to the DataStore
function Session:checkpoint(): (string?, string?)
	local s, o = self:save()
	if s then self.goodSave, self.goodOptions = s, o end
	return s, o
end

-- ------------------------------------------------------------------------------------------------------------- view
function Session:view(): any
	local JS, ENV = self.JS, self.ENV
	local ok, v = pcall(ENV.rbx_view, nil)
	if not ok then
		self.lastError = tostring(v)
		v = nil
	end
	local allowed = {}
	local acts = ENV.rbx_actions
	if acts and JS.LEN[acts] then
		for i = 0, JS.LEN[acts] - 1 do allowed[actionKey(plain(JS, acts[i]))] = true end
	end
	self.allowed = allowed
	local p = if v then plain(JS, v) else { menu = { t = "col", c = {} }, head = { t = "html", h = "" }, tab = { t = "html", h = "The page failed to draw." } }
	local hk = {}
	for _, k in p.keys or {} do hk[k] = true end
	self.hotkeys = hk

	local flat = {}
	flatten(p.menu, "menu", flat)
	flatten(p.head, "head", flat)
	flatten(p.tab, "tab", flat)
	local set, del = {}, {}
	local prev = self.prev
	local nextSig = {}
	local any = false
	for id, e in flat do
		local s = sig(e)
		nextSig[id] = s
		if prev[id] ~= s then set[id] = e; any = true end
	end
	for id in prev do
		if nextSig[id] == nil then table.insert(del, id); any = true end
	end
	local full = next(prev) == nil
	self.prev = nextSig

	local patch = { set = set, del = del, tab = p.tabName, tabStyle = p.tabStyle, keys = p.keys, ended = p.ended, full = full or nil }
	-- popups raised since the last view
	local okp, pops = pcall(ENV.rbx_popups, nil, self.lastPopup)
	if okp and pops and JS.LEN[pops] and JS.LEN[pops] > 0 then
		local list = plain(JS, pops)
		for _, pp in list do self.lastPopup = math.max(self.lastPopup, (pp.id or 0) + 1) end
		patch.pop = list
	end
	if #self.notices > 0 then
		patch.notice = self.notices
		self.notices = {}
	end
	if self.exportText then
		patch.export = self.exportText
		self.exportText = nil
	end
	if self.wantImport then
		patch.askImport = true
		self.wantImport = nil
	end
	return patch, any
end

-- the client lost its copy (rejoined the UI): the next view sends everything
function Session:resetView()
	self.prev = {}
end

return Session
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">Store</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Store: one DataStore record per player, { save = JSON, options = JSON, time = os.time(), lock = { job, t } }.

	The lock keeps two servers from playing the same save at once (a quick server hop): load takes it (waiting for
	a live lock elsewhere to be released, and taking over one older than LOCK_TTL), every save refreshes it, and
	the last save on leaving releases it. A save only writes while this server still holds the lock.
]]
local DataStoreService = game:GetService("DataStoreService")
local Config = require(script.Parent.Config)

local Store = {}

export type Record = { save: string?, options: string?, time: number?, lock: { job: string, t: number }? }

local store: DataStore? = nil
local function ds(): DataStore
	if store == nil then store = DataStoreService:GetDataStore(Config.STORE_NAME) end
	return store :: DataStore
end

local function key(userId: number): string
	return "player_" .. userId
end

local function jobId(): string
	return if game.JobId ~= "" then game.JobId else "studio"
end

-- errors no retry fixes: Studio without API access, a place that was never published (a .rbxlx opened from disk).
-- After one of those the store is off for this server, so nobody waits on it again.
local unavailable: string? = nil
local function permanent(err: any): boolean
	local s = string.lower(tostring(err))
	return string.find(s, "studioaccesstoapisnotallowed", 1, true) ~= nil or string.find(s, "publish", 1, true) ~= nil
		or string.find(s, "api services", 1, true) ~= nil or string.find(s, "not allowed", 1, true) ~= nil
		or string.find(s, "403", 1, true) ~= nil
end

local function retry<T...>(f: () -> T...): (boolean, any)
	if unavailable then return false, unavailable end
	local ok, err
	for attempt = 1, 3 do
		ok, err = pcall(f)
		if ok then return true, err end
		if permanent(err) then
			unavailable = tostring(err)
			warn("[MilestoneTree] saving is off on this server: " .. tostring(err)
				.. " (publish the place and turn on Game Settings > Security > Enable Studio Access to API Services)")
			return false, err
		end
		task.wait(attempt)
	end
	return false, err
end

-- -> record (empty for a new player), or nil + reason when the save could not be read
function Store.load(userId: number): (Record?, string?)
	for _ = 1, 10 do
		local blocked = false
		local ok, result = retry(function()
			return ds():UpdateAsync(key(userId), function(old: Record?): Record?
				local rec: Record = old or {}
				local lock = rec.lock
				if lock and lock.job ~= jobId() and os.time() - lock.t < Config.LOCK_TTL then
					blocked = true
					return nil
				end
				rec.lock = { job = jobId(), t = os.time() }
				return rec
			end)
		end)
		if not ok then return nil, tostring(result) end
		if not blocked then return (result or {}) :: Record, nil end
		task.wait(6) -- another server still has this save open: give it time to save and let go
	end
	-- the other server never let go: take the save over as it is
	local ok, result = retry(function()
		return ds():UpdateAsync(key(userId), function(old: Record?): Record?
			local rec: Record = old or {}
			rec.lock = { job = jobId(), t = os.time() }
			return rec
		end)
	end)
	if not ok then return nil, tostring(result) end
	return (result or {}) :: Record, nil
end

-- write the game; release = true on leaving. false if the lock was lost (another server took the save over).
function Store.save(userId: number, save: string, options: string?, release: boolean?): (boolean, string?)
	local lost = false
	local ok, err = retry(function()
		return ds():UpdateAsync(key(userId), function(old: Record?): Record?
			local rec: Record = old or {}
			if rec.lock and rec.lock.job ~= jobId() then
				lost = true
				return nil
			end
			rec.save = save
			rec.options = options
			rec.time = os.time()
			rec.lock = if release then nil else { job = jobId(), t = os.time() }
			return rec
		end)
	end)
	if not ok then return false, tostring(err) end
	if lost then return false, "another server has this save open" end
	return true, nil
end

return Store
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="56">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Actor" referent="57">
      <Properties>
        <string name="Name">MilestoneTreeWorker</string>
        <bool name="NeedsPivotMigration">false</bool>
      </Properties>
      <Item class="Script" referent="58">
        <Properties>
          <string name="Name">Worker</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nocheck
--[[
	Worker: one player's game, in its own Actor so every player's game runs in parallel (Parallel Luau).

	Main clones this Actor into ServerScriptService.MilestoneTree.Sessions for each player and sends it messages:
	  "start" (player)            load the save, start the game
	  "act"   (action, hold)      a button press / hotkey from the player's screen
	  "import"(text)              a pasted save
	  "resync"                    the client wants the whole screen again
	  "stop"                      save, release the save lock, then set the Actor's Stopped attribute
	The game ticks in the parallel phase; sending to the client and DataStore calls happen in the serial phase.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local actor = script:GetActor()
local root = ServerScriptService:WaitForChild("MilestoneTree")
local Config = require(root:WaitForChild("Config"))
local Session = require(root:WaitForChild("Session"))
local Store = require(root:WaitForChild("Store"))
local remotes = ReplicatedStorage:WaitForChild("MilestoneTreeRemotes")
local viewRemote: RemoteEvent = remotes:WaitForChild("View")

-- the game: the runtime, TowerNum and the transpiled game files in load order. If any of it fails to load, Main
-- shows the error on the player's screen (the Error attribute) instead of leaving it blank.
local deps
local okLoad, loadErr = pcall(function()
	local runtime = root:WaitForChild("Runtime")
	local gameFolder = root:WaitForChild("Game")
	local chunks = {}
	for name in string.gmatch(require(gameFolder:WaitForChild("Manifest")), "[^,]+") do
		table.insert(chunks, require(gameFolder:WaitForChild(name, 10)))
	end
	deps = {
		TN = require(ReplicatedStorage:WaitForChild("TowerNum")),
		JSRT = require(runtime:WaitForChild("JSRT")),
		BEcore = require(runtime:WaitForChild("BEcore")),
		chunks = chunks,
	}
end)
if not okLoad then
	warn("[MilestoneTree] the game failed to load: " .. tostring(loadErr))
	actor:SetAttribute("Error", "The game failed to load on the server: " .. tostring(loadErr))
	return
end

local player: Player? = nil
local session = nil
local canSave = false        -- false when the save could not be loaded: never overwrite it with a new game
local stopping = false
local tickEvery = Config.TICK
local tickCost = 0           -- running average seconds per tick
local sinceTick, sinceView, sinceSave = 0, 0, 0
local pushNow = false        -- refresh the screen at the next heartbeat (after a button press)
local saving = false

local function nowMs(): number
	return DateTime.now().UnixTimestampMillis
end

local function send(patch)
	if player and player.Parent then viewRemote:FireClient(player, patch) end
end

local function notice(text: string)
	if session then table.insert(session.notices, text) end
	pushNow = true
end

-- serial phase only (DataStore yields). The last save (release) waits for an autosave still in flight, so that the
-- autosave cannot take the save lock back after the release.
local function saveNow(release: boolean?)
	if not session or not player or not canSave then return end
	if saving then
		if not release then return end
		local t0 = os.clock()
		while saving and os.clock() - t0 < 30 do task.wait(0.1) end
	end
	saving = true
	local save, options = session:checkpoint()
	if save then
		local ok, err = Store.save(player.UserId, save, options, release)
		if not ok then
			warn("[MilestoneTree] save failed for " .. player.Name .. ": " .. tostring(err))
			if err == "another server has this save open" then
				canSave = false
				notice("Your save was opened on another server, so this server stopped saving it. Rejoin to keep playing.")
			end
		end
	end
	session.wantSave = false
	saving = false
end

local function begin(plr: Player)
	player = plr
	viewRemote:FireClient(plr, { status = "Loading your save..." })
	local rec, err = Store.load(plr.UserId)
	if not plr.Parent then
		if rec then task.spawn(Store.save, plr.UserId, rec.save or "", rec.options, true) end
		actor:SetAttribute("Stopped", true)
		return
	end
	local save, options = nil, nil
	if rec then
		canSave = true
		save, options = rec.save, rec.options
	else
		warn("[MilestoneTree] could not load " .. plr.Name .. "'s save: " .. tostring(err))
	end
	local ok, s = pcall(Session.new, deps, save, options, nowMs())
	if not ok then
		warn("[MilestoneTree] " .. plr.Name .. "'s save would not start (" .. tostring(s) .. "); starting a new game without saving")
		canSave = false
		s = Session.new(deps, nil, nil, nowMs())
		table.insert(s.notices, "Your save could not be started, so this is a new game that will NOT be saved. Rejoin to try again.")
	elseif not rec then
		table.insert(s.notices, "Your save could not be loaded (" .. tostring(err) .. "). Playing without saving; rejoin to try again.")
	end
	session = s
	pushNow = true
end
actor:BindToMessage("start", function(plr: Player)
	task.spawn(function() -- loading yields (DataStore)
		local ok, err = pcall(begin, plr)
		if not ok then
			warn("[MilestoneTree] could not start " .. plr.Name .. "'s game: " .. tostring(err))
			viewRemote:FireClient(plr, { fatal = "Your game could not start on the server: " .. tostring(err) })
		end
	end)
end)

actor:BindToMessageParallel("act", function(a, hold)
	if not session or stopping then return end
	local ok = session:act(a, nowMs(), hold == true)
	if ok then pushNow = true end
end)

actor:BindToMessageParallel("import", function(text)
	if not session or stopping then return end
	local ok, why = session:import(text, nowMs())
	if not ok then table.insert(session.notices, why) end
	pushNow = true
end)

actor:BindToMessageParallel("resync", function()
	if not session then return end
	session:resetView()
	pushNow = true
end)

actor:BindToMessage("stop", function()
	stopping = true
	task.spawn(function()
		saveNow(true)
		actor:SetAttribute("Stopped", true)
	end)
end)

RunService.Heartbeat:ConnectParallel(function(dt: number)
	if not session or stopping then return end
	sinceTick += dt
	sinceView += dt
	sinceSave += dt
	if sinceTick >= tickEvery then
		sinceTick = 0
		local t0 = os.clock()
		session:tick(nowMs())
		local cost = os.clock() - t0
		tickCost = tickCost * 0.9 + cost * 0.1
		-- keep this player's game under its share of a core: slower ticks when they get expensive
		tickEvery = math.clamp(tickCost / Config.TICK_CPU_SHARE, Config.TICK, Config.MAX_TICK)
	end
	local wantSave = session.wantSave or sinceSave >= Config.AUTOSAVE
	if not (pushNow or sinceView >= Config.VIEW or wantSave) then return end
	local patch, changed = nil, false
	if pushNow or sinceView >= Config.VIEW then
		sinceView = 0
		pushNow = false
		patch, changed = session:view()
		if not canSave then patch.unsaved = true end
	end
	task.synchronize()
	if patch and (changed or patch.pop or patch.notice or patch.export or patch.askImport or patch.full) then
		send(patch)
	end
	if wantSave then
		sinceSave = 0
		session.wantSave = false
		task.spawn(saveNow, false)
	end
end)

actor:SetAttribute("Ready", true)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="59">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="60">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="61">
        <Properties>
          <string name="Name">MilestoneTree</string>
        </Properties>
        <Item class="LocalScript" referent="62">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Milestone Tree NG+ on Roblox: the player's screen.

	The game runs on the server; this draws what it sends (the web page's "Revamped" layout: the menu of layers on
	the left, the points at the top, the current layer's tab below) and sends button presses back. Hotkeys work like
	on the web page (arrow keys on the exploration grid, Ctrl+E ...), buyables repeat while held, and hovering shows
	tooltips.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local shared = ReplicatedStorage:WaitForChild("MilestoneTree")
local Html = require(shared:WaitForChild("Html"))
local Style = require(script.Parent:WaitForChild("Style"))
local Render = require(script.Parent:WaitForChild("Render"))

local remotes = ReplicatedStorage:WaitForChild("MilestoneTreeRemotes")
local viewRemote = remotes:WaitForChild("View") :: RemoteEvent
local actRemote = remotes:WaitForChild("Act") :: RemoteEvent
local importRemote = remotes:WaitForChild("Import") :: RemoteEvent
local readyRemote = remotes:WaitForChild("Ready") :: RemoteEvent

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
end)

-- ------------------------------------------------------------------------------------------------------ the screen
local MENU_W = 325

local gui = Instance.new("ScreenGui")
gui.Name = "MilestoneTree"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local page = Instance.new("Frame")
page.Name = "Page"
page.Size = UDim2.fromScale(1, 1)
page.BackgroundColor3 = Style.BG
page.BorderSizePixel = 0
page.Parent = gui
local uiScale = Instance.new("UIScale")
uiScale.Parent = page

local menu = Instance.new("ScrollingFrame")
menu.Name = "Menu"
menu.Size = UDim2.new(0, MENU_W, 1, 0)
menu.BackgroundColor3 = Style.BG
menu.BorderSizePixel = 0
menu.ScrollBarThickness = 6
menu.CanvasSize = UDim2.new()
menu.AutomaticCanvasSize = Enum.AutomaticSize.Y
menu.ZIndex = 5
menu.Parent = page
Style.stroke(menu, 3, Color3.fromRGB(122, 122, 122), 0)
local menuRoot = Instance.new("Frame")
menuRoot.Name = "MenuRoot"
menuRoot.BackgroundTransparency = 1
menuRoot.Size = UDim2.new(1, -8, 0, 0)
menuRoot.Position = UDim2.fromOffset(4, 8)
menuRoot.AutomaticSize = Enum.AutomaticSize.Y
menuRoot.Parent = menu

local main = Instance.new("ScrollingFrame")
main.Name = "Main"
main.BackgroundColor3 = Style.BG
main.BorderSizePixel = 0
main.ScrollBarThickness = 8
main.CanvasSize = UDim2.new()
main.AutomaticCanvasSize = Enum.AutomaticSize.Y
main.Parent = page
local mainList = Instance.new("UIListLayout")
mainList.SortOrder = Enum.SortOrder.LayoutOrder
mainList.HorizontalAlignment = Enum.HorizontalAlignment.Center
mainList.Padding = UDim.new(0, 10)
mainList.Parent = main
local mainPad = Instance.new("UIPadding")
mainPad.PaddingTop = UDim.new(0, 10)
mainPad.PaddingBottom = UDim.new(0, 60)
mainPad.PaddingLeft = UDim.new(0, 8)
mainPad.PaddingRight = UDim.new(0, 8)
mainPad.Parent = main

local function rootFrame(name: string, order: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.Size = UDim2.new(1, 0, 0, 0)
	f.AutomaticSize = Enum.AutomaticSize.Y
	f.LayoutOrder = order
	f.Parent = main
	return f
end
local headRoot = rootFrame("HeadRoot", 1)
local tabRoot = rootFrame("TabRoot", 2)

-- what the page says while the server gets the game ready, and any error that stops it
local status = Instance.new("TextLabel")
status.Name = "Status"
status.LayoutOrder = 0
status.BackgroundTransparency = 1
status.Size = UDim2.new(1, -40, 0, 0)
status.AutomaticSize = Enum.AutomaticSize.Y
status.TextWrapped = true
status.RichText = true
status.FontFace = Style.FONT
status.TextSize = 20
status.TextColor3 = Style.TEXT
status.Text = "Loading your game..."
status.Parent = main
local function setStatus(text: string?, isError: boolean?)
	status.Visible = text ~= nil
	status.Text = if text then Html.escape(text) else ""
	status.TextColor3 = if isError then Color3.fromRGB(255, 90, 90) else Style.TEXT
end

local menuShown = true
local toggle = Instance.new("TextButton")
toggle.Name = "MenuToggle"
toggle.Size = UDim2.fromOffset(40, 60)
toggle.BackgroundColor3 = Style.BG
toggle.TextColor3 = Color3.new(1, 1, 1)
toggle.FontFace = Style.FONT
toggle.TextSize = 30
toggle.ZIndex = 6
toggle.Parent = page
Style.stroke(toggle, 2, Color3.fromRGB(122, 122, 122), 0)

local function layout()
	local cam = Workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
	-- the page is laid out for a 1280 px wide browser window and scaled to the screen
	local s = math.clamp(vp.X / 1280, 0.8, 1.6)
	uiScale.Scale = s
	local narrow = vp.X / s < 900
	menu.Visible = menuShown
	local left = if menuShown then MENU_W + 4 else 0
	main.Position = UDim2.fromOffset(left, 0)
	main.Size = UDim2.new(1, -left, 1, 0)
	toggle.Position = UDim2.fromOffset(if menuShown then MENU_W + 6 else 2, 70)
	toggle.Text = if menuShown then "<" else ">"
	if narrow and menuShown then main.Size = UDim2.new(1, -left, 1, 0) end
end
toggle.Activated:Connect(function()
	menuShown = not menuShown
	layout()
end)

-- --------------------------------------------------------------------------------------------- overlays (on top)
local overlay = Instance.new("ScreenGui")
overlay.Name = "MilestoneTreeOverlay"
overlay.ResetOnSpawn = false
overlay.DisplayOrder = 20
overlay.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
local overlayScale = Instance.new("UIScale")
overlayScale.Parent = overlay

-- tooltip
local tip = Instance.new("Frame")
tip.Name = "Tooltip"
tip.Visible = false
tip.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
tip.BackgroundTransparency = 0.05
tip.AutomaticSize = Enum.AutomaticSize.XY
tip.Size = UDim2.new()
tip.ZIndex = 50
tip.Parent = overlay
Style.pad(tip, 7)
Style.corner(tip, 6)
Style.stroke(tip, 1, Style.TEXT, 0.6)
local tipText = Instance.new("TextLabel")
tipText.BackgroundTransparency = 1
tipText.AutomaticSize = Enum.AutomaticSize.XY
tipText.Size = UDim2.new()
tipText.RichText = true
tipText.TextWrapped = true
tipText.FontFace = Style.FONT
tipText.TextSize = 14
tipText.TextColor3 = Style.TEXT
tipText.ZIndex = 51
tipText.Parent = tip
local tipLimit = Instance.new("UISizeConstraint")
tipLimit.MaxSize = Vector2.new(320, math.huge)
tipLimit.Parent = tipText
local tipOwner: GuiObject? = nil

local function moveTip()
	if not tip.Visible then return end
	local m = UserInputService:GetMouseLocation()
	local s = overlayScale.Scale
	local cam = Workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
	local size = tip.AbsoluteSize
	local x = math.clamp(m.X + 16, 0, math.max(0, vp.X - size.X - 4))
	local y = m.Y - size.Y - 12
	if y < 0 then y = m.Y + 20 end
	tip.Position = UDim2.fromOffset(x / s, y / s)
end

local function showTip(html: string?, over: GuiObject?)
	if html == nil then
		if tipOwner == over then tip.Visible = false; tipOwner = nil end
		return
	end
	tipOwner = over
	tipText.Text = Html.rich(html, 14)
	tip.Visible = true
	moveTip()
end
UserInputService.InputChanged:Connect(function(input: InputObject)
	if input.UserInputType == Enum.UserInputType.MouseMovement then moveTip() end
end)

-- toasts (the page's popups: achievements, milestones, and messages from the server)
local toasts = Instance.new("Frame")
toasts.Name = "Toasts"
toasts.BackgroundTransparency = 1
toasts.AnchorPoint = Vector2.new(1, 0)
toasts.Position = UDim2.new(1, -20, 0, 10)
toasts.Size = UDim2.fromOffset(300, 0)
toasts.AutomaticSize = Enum.AutomaticSize.Y
toasts.Parent = overlay
local toastList = Instance.new("UIListLayout")
toastList.Padding = UDim.new(0, 10)
toastList.SortOrder = Enum.SortOrder.LayoutOrder
toastList.Parent = toasts
local toastN = 0

local POPUP_BG = { ["achievement-popup"] = "7182BC", ["milestone-popup"] = "D1C23C", ["challenge-popup"] = "9BBC71", ["default-popup"] = "5a5a5a" }

local function toast(title: string?, message: string, bg: Color3?, border: Color3?, seconds: number?)
	toastN += 1
	local f = Instance.new("TextButton")
	f.Text = ""
	f.AutoButtonColor = false
	f.LayoutOrder = toastN
	f.Size = UDim2.new(1, 0, 0, 0)
	f.AutomaticSize = Enum.AutomaticSize.Y
	f.BackgroundColor3 = bg or Color3.fromRGB(60, 60, 60)
	f.Parent = toasts
	Style.corner(f, 7)
	Style.stroke(f, 4, border or Style.DARK, if border then 0 else 0.75)
	Style.pad(f, 10)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.new(1, 0, 0, 0)
	l.AutomaticSize = Enum.AutomaticSize.Y
	l.RichText = true
	l.TextWrapped = true
	l.FontFace = Style.FONT
	l.TextSize = 14
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Text = (if title and title ~= "" then Html.rich("<h3>" .. title .. "</h3>", 14) .. "\n" else "") .. Html.rich(message, 16)
	l.Parent = f
	f.Activated:Connect(function() f:Destroy() end)
	task.delay(seconds or 4, function() if f.Parent then f:Destroy() end end)
	while #toasts:GetChildren() > 7 do
		local oldest: Instance? = nil
		for _, c in toasts:GetChildren() do
			if c:IsA("GuiObject") and (oldest == nil or c.LayoutOrder < (oldest :: GuiObject).LayoutOrder) then oldest = c end
		end
		if oldest then oldest:Destroy() else break end
	end
end

-- "not saving" banner
local banner = Instance.new("TextLabel")
banner.Name = "Unsaved"
banner.Visible = false
banner.AnchorPoint = Vector2.new(0.5, 0)
banner.Position = UDim2.new(0.5, 0, 0, 4)
banner.Size = UDim2.fromOffset(520, 26)
banner.BackgroundColor3 = Color3.fromRGB(150, 30, 30)
banner.TextColor3 = Color3.new(1, 1, 1)
banner.FontFace = Style.FONT
banner.TextSize = 14
banner.Text = "Your progress is NOT being saved right now (see the messages). Rejoin to retry."
banner.Parent = overlay
Style.corner(banner, 6)

-- the export / import box
local modal = Instance.new("Frame")
modal.Name = "Modal"
modal.Visible = false
modal.AnchorPoint = Vector2.new(0.5, 0.5)
modal.Position = UDim2.fromScale(0.5, 0.5)
modal.Size = UDim2.fromOffset(560, 300)
modal.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
modal.ZIndex = 40
modal.Parent = overlay
Style.corner(modal, 10)
Style.stroke(modal, 3, Color3.fromRGB(122, 122, 122), 0)
Style.pad(modal, 12)
local modalTitle = Instance.new("TextLabel")
modalTitle.BackgroundTransparency = 1
modalTitle.Size = UDim2.new(1, 0, 0, 28)
modalTitle.FontFace = Style.FONT
modalTitle.TextSize = 20
modalTitle.TextColor3 = Style.TEXT
modalTitle.ZIndex = 41
modalTitle.Parent = modal
local modalBox = Instance.new("TextBox")
modalBox.Position = UDim2.fromOffset(0, 36)
modalBox.Size = UDim2.new(1, 0, 1, -88)
modalBox.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
modalBox.TextColor3 = Style.TEXT
modalBox.FontFace = Font.new("rbxasset://fonts/families/RobotoMono.json")
modalBox.TextSize = 12
modalBox.TextWrapped = true
modalBox.TextXAlignment = Enum.TextXAlignment.Left
modalBox.TextYAlignment = Enum.TextYAlignment.Top
modalBox.MultiLine = true
modalBox.ClearTextOnFocus = false
modalBox.ClipsDescendants = true
modalBox.ZIndex = 41
modalBox.Parent = modal
Style.pad(modalBox, 6)
local function modalButton(text: string, x: number): TextButton
	local b = Instance.new("TextButton")
	b.AnchorPoint = Vector2.new(1, 1)
	b.Position = UDim2.new(1, x, 1, 0)
	b.Size = UDim2.fromOffset(130, 40)
	b.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.FontFace = Style.FONT
	b.TextSize = 16
	b.Text = text
	b.ZIndex = 41
	b.Parent = modal
	Style.corner(b, 6)
	return b
end
local modalOk = modalButton("Import", -140)
local modalClose = modalButton("Close", 0)
local modalMode = "export"
modalClose.Activated:Connect(function() modal.Visible = false end)
modalOk.Activated:Connect(function()
	if modalMode == "import" and modalBox.Text ~= "" then
		importRemote:FireServer(modalBox.Text)
		modal.Visible = false
	end
end)

local function openModal(mode: string, text: string?)
	modalMode = mode
	modal.Visible = true
	modalOk.Visible = mode == "import"
	if mode == "export" then
		modalTitle.Text = "Your save (select it all and copy)"
		modalBox.Text = text or ""
		modalBox.PlaceholderText = ""
		task.defer(function()
			modalBox:CaptureFocus()
			modalBox.SelectionStart = 1
			modalBox.CursorPosition = #modalBox.Text + 1
		end)
	else
		modalTitle.Text = "Paste a save (from Export here or on the web game)"
		modalBox.Text = ""
		modalBox.PlaceholderText = "save string..."
		task.defer(function() modalBox:CaptureFocus() end)
	end
end

-- ---------------------------------------------------------------------------------------------------- the renderer
local lastPress = 0
local renderer = Render.new({ menu = menuRoot, head = headRoot, tab = tabRoot }, {
	press = function(a: any, hold: boolean)
		if not hold and os.clock() - lastPress < 0.03 then return end
		lastPress = os.clock()
		actRemote:FireServer(a, hold)
	end,
	tip = showTip,
})

local keys: { [string]: boolean } = {}

local function applyTabStyle(st: any)
	main.BackgroundColor3 = Style.BG
	main.BackgroundTransparency = 0
	if type(st) == "table" then Style.apply(main, st) else Style.drop(main, "Gradient") end
end

local gotScreen = false
local failed = false
viewRemote.OnClientEvent:Connect(function(patch: any)
	if type(patch) ~= "table" then return end
	if patch.fatal then
		failed = true
		setStatus(tostring(patch.fatal) .. "\n\n(The same error is in Studio's Output window: View > Output.)", true)
		return
	end
	if patch.status then
		if not gotScreen and not failed then setStatus(tostring(patch.status)) end
		return
	end
	local ok, err = pcall(function() renderer:apply(patch) end)
	if not ok then
		warn("[MilestoneTree] drawing the screen failed: " .. tostring(err))
		setStatus("Drawing the screen failed: " .. tostring(err), true)
		failed = true
	elseif patch.set and next(patch.set) ~= nil and not failed then
		gotScreen = true
		setStatus(nil)
	end
	if patch.tabStyle then applyTabStyle(patch.tabStyle) end
	if patch.keys then
		keys = {}
		for _, k in patch.keys do keys[k] = true end
	end
	banner.Visible = patch.unsaved == true
	for _, p in patch.pop or {} do
		local bg = Html.color(p.color ~= "" and p.color or nil) or Color3.fromHex(POPUP_BG[p.type] or "5a5a5a")
		toast(p.title, p.message, bg, Html.color(p.bColor ~= "" and p.bColor or nil), 3)
	end
	for _, msg in patch.notice or {} do toast(nil, msg, nil, nil, 6) end
	if patch.export then openModal("export", patch.export) end
	if patch.askImport then openModal("import") end
end)

-- ------------------------------------------------------------------------------------------------------- hotkeys
local ARROWS = {
	[Enum.KeyCode.Up] = "ArrowUp", [Enum.KeyCode.Down] = "ArrowDown", [Enum.KeyCode.Left] = "ArrowLeft", [Enum.KeyCode.Right] = "ArrowRight",
	[Enum.KeyCode.Return] = "Enter", [Enum.KeyCode.Space] = " ", [Enum.KeyCode.Escape] = "Escape", [Enum.KeyCode.Tab] = "Tab",
}
local function keyName(input: InputObject): string?
	local kc = input.KeyCode
	local name = ARROWS[kc]
	if name == nil then
		local v = kc.Value
		if v >= Enum.KeyCode.A.Value and v <= Enum.KeyCode.Z.Value then
			name = string.char(97 + v - Enum.KeyCode.A.Value)
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift) then name = string.upper(name :: string) end
		elseif v >= Enum.KeyCode.Zero.Value and v <= Enum.KeyCode.Nine.Value then
			name = tostring(v - Enum.KeyCode.Zero.Value)
		end
	end
	if name == nil then return nil end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
		name = "ctrl+" .. (name :: string)
	end
	return name
end
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	if UserInputService:GetFocusedTextBox() then return end
	local name = keyName(input)
	if name and keys[name] then actRemote:FireServer({ "key", name }, false) end
end)

-- ---------------------------------------------------------------------------------------------------------- start
local function watchCamera()
	local cam = Workspace.CurrentCamera
	if cam then cam:GetPropertyChangedSignal("ViewportSize"):Connect(layout) end
	layout()
end
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()

gui.Parent = player:WaitForChild("PlayerGui")
overlay.Parent = player:WaitForChild("PlayerGui")
readyRemote:FireServer()
task.delay(20, function()
	if not gotScreen and not failed then
		setStatus("Still waiting for the server. In Studio, open View > Output and look for red errors from MilestoneTree.", true)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">Render</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Render: view nodes (see the server's Session and rbx/view.js) -> GUI objects, kept in step with patches.

	Every node has an id that is its path ("tab.3.1"), so its parent and its place among its siblings come from the
	id: a patch only has to carry the nodes that changed. A node whose kind is unchanged is updated in place;
	otherwise it is rebuilt and its children move over to the new object.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local shared = ReplicatedStorage:WaitForChild("MilestoneTree")
local Html = require(shared:WaitForChild("Html"))
local ZoneMaps = require(shared:WaitForChild("ZoneMaps"))
local Style = require(script.Parent:WaitForChild("Style"))

export type Hooks = {
	press: (action: any, hold: boolean) -> (),
	tip: (html: string?, over: GuiObject?) -> (),
}

type Rec = {
	id: string,
	kind: string,
	node: any,
	root: GuiObject,
	content: GuiObject,     -- where children go
	autoW: boolean,         -- sized by its content (inside a row) rather than by its parent's width
	text: Color3,           -- text colour children inherit
	textT: number,
	base: number,           -- text size children inherit
	conns: { RBXScriptConnection },
	sig: string?,           -- what the object currently shows (skip redundant updates)
}

local Render = {}
Render.__index = Render

export type Renderer = typeof(setmetatable({} :: {
	roots: { [string]: GuiObject },
	recs: { [string]: Rec },
	kids: { [string]: { [string]: boolean } },
	hooks: Hooks,
}, Render))

function Render.new(roots: { [string]: GuiObject }, hooks: Hooks): Renderer
	local self = setmetatable({ roots = roots, recs = {}, kids = {}, hooks = hooks }, Render)
	return self
end

local function parentOf(id: string): (string?, number)
	local p, i = string.match(id, "^(.*)%.(%d+)$")
	if p == nil then return nil, 0 end
	return p, tonumber(i) :: number
end

local function depth(id: string): number
	local _, n = string.gsub(id, "%.", "")
	return n
end

local function kindOf(n: any): string
	if n.t == "html" and type(n.h) == "string" and string.find(n.h, "<svg", 1, true) then return "svg" end
	if n.t == "btn" then return "btn:" .. tostring(n.k) end
	return tostring(n.t)
end

-- --------------------------------------------------------------------------------------------------------- helpers
local function label(parent: Instance?, name: string): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.RichText = true
	l.TextWrapped = true
	l.FontFace = Style.FONT
	l.TextColor3 = Style.TEXT
	l.TextSize = 16
	l.Size = UDim2.new(1, 0, 0, 0)
	l.AutomaticSize = Enum.AutomaticSize.Y
	l.Text = ""
	l.Parent = parent
	return l
end

local function frame(name: string): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Size = UDim2.new(1, 0, 0, 0)
	f.AutomaticSize = Enum.AutomaticSize.Y
	return f
end

local function list(obj: GuiObject, horizontal: boolean, pad: number, wraps: boolean?): UIListLayout
	local l = Style.child(obj, "UIListLayout", "List") :: UIListLayout
	l.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center
	l.VerticalAlignment = if horizontal then Enum.VerticalAlignment.Center else Enum.VerticalAlignment.Top
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, pad)
	l.Wraps = wraps == true
	return l
end

local function sizeConstraint(obj: GuiObject, minX: number?, minY: number?, maxX: number?)
	if minX == nil and minY == nil and maxX == nil then Style.drop(obj, "Limit"); return end
	local c = Style.child(obj, "UISizeConstraint", "Limit") :: UISizeConstraint
	c.MinSize = Vector2.new(minX or 0, minY or 0)
	c.MaxSize = Vector2.new(maxX or math.huge, math.huge)
end

local function px(v: any, base: number?): number?
	if type(v) == "number" then return v end
	if type(v) == "string" then return Html.px(v, base) end
	return nil
end

-- ------------------------------------------------------------------------------------------------------- the nodes
function Render._inherit(self: Renderer, parentId: string?): (boolean, Color3, number, number)
	if parentId and self.recs[parentId] then
		local p = self.recs[parentId]
		return p.autoW or p.kind == "row" or p.kind == "tabs", p.text, p.textT, p.base
	end
	return false, Style.TEXT, 0, 16
end

function Render._build(self: Renderer, id: string, n: any): Rec
	local parentId = parentOf(id)
	local autoW, text, textT, base = self:_inherit(parentId)
	local kind = kindOf(n)
	local rec: Rec = { id = id, kind = kind, node = n, root = nil :: any, content = nil :: any, autoW = autoW, text = text, textT = textT, base = base, conns = {} }
	local t = n.t
	if t == "col" or t == "row" or t == "tabs" then
		local f = frame(id)
		if autoW then
			f.Size = UDim2.new(0, 0, 0, 0)
			f.AutomaticSize = Enum.AutomaticSize.XY
		end
		rec.root, rec.content = f, f
	elseif t == "html" or t == "svg" or kind == "svg" then
		local f = frame(id)
		if autoW then f.Size = UDim2.new(0, 0, 0, 0); f.AutomaticSize = Enum.AutomaticSize.XY end
		rec.root, rec.content = f, f
	elseif t == "blank" or t == "hr" then
		local f = Instance.new("Frame")
		f.Name = id
		f.BorderSizePixel = 0
		f.BackgroundTransparency = 1
		rec.root, rec.content = f, f
	elseif t == "btn" then
		local b = Instance.new("TextButton")
		b.Name = id
		b.AutoButtonColor = false
		b.Text = ""
		b.BorderSizePixel = 0
		b.ClipsDescendants = false
		local l = label(b, "Label")
		l.ZIndex = 3
		rec.root, rec.content = b, b
		self:_wireButton(rec, b)
	elseif t == "ms" or t == "chal" or t == "ach" or t == "info" or t == "bar" then
		local f = frame(id)
		f.BackgroundTransparency = 0
		f.Size = UDim2.new(0, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		local l = label(f, "Label")
		l.LayoutOrder = 0
		local kids = frame("Kids")
		kids.LayoutOrder = 1
		kids.Parent = f
		list(kids, t ~= "chal", 6, true)
		rec.root, rec.content = f, kids
		if t == "info" then
			local b = Instance.new("TextButton")
			b.Name = "Title"
			b.AutoButtonColor = false
			b.LayoutOrder = -1
			b.Size = UDim2.new(1, 0, 0, 0)
			b.AutomaticSize = Enum.AutomaticSize.Y
			b.Text = ""
			b.Parent = f
			label(b, "Label")
			self:_wireButton(rec, b)
		elseif t == "bar" then
			local fill = Instance.new("Frame")
			fill.Name = "Fill"
			fill.BorderSizePixel = 0
			fill.ZIndex = 0
			fill.Parent = f
		end
		self:_wireTip(rec, f)
	else
		local f = frame(id)
		rec.root, rec.content = f, f
	end
	return rec
end

function Render._wireTip(self: Renderer, rec: Rec, obj: GuiObject)
	table.insert(rec.conns, obj.MouseEnter:Connect(function()
		local tip = rec.node.tip
		if type(tip) == "string" and tip ~= "" then self.hooks.tip(tip, obj) end
	end))
	table.insert(rec.conns, obj.MouseLeave:Connect(function() self.hooks.tip(nil, obj) end))
end

function Render._wireButton(self: Renderer, rec: Rec, b: GuiButton)
	local holding = 0
	local scale = Style.child(b, "UIScale", "Hover") :: UIScale
	table.insert(rec.conns, b.Activated:Connect(function()
		local a = rec.node.a
		if a then self.hooks.press(a, false) end
	end))
	-- hold to repeat (buyables, and clickables / grid tiles that have onHold): after 0.25 s, 20 presses a second
	table.insert(rec.conns, b.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		if not rec.node.hold then return end
		holding += 1
		local mine = holding
		task.delay(0.25, function()
			while holding == mine and rec.root.Parent do
				local a = rec.node.a
				if a then self.hooks.press(a, true) end
				task.wait(0.05)
			end
		end)
	end))
	table.insert(rec.conns, b.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then holding += 1 end
	end))
	table.insert(rec.conns, b.MouseEnter:Connect(function()
		if rec.node.cls == "can" or rec.node.cls == "perk" or rec.node.cls == "pseudo" then scale.Scale = 1.06 end
		local tip = rec.node.tip
		if type(tip) == "string" and tip ~= "" then self.hooks.tip(tip, b) end
	end))
	table.insert(rec.conns, b.MouseLeave:Connect(function()
		holding += 1
		scale.Scale = 1
		self.hooks.tip(nil, b)
	end))
end

-- the text of a node, drawn into a label (svg blocks become little canvases next to it)
local function setRich(l: TextLabel, html: string?, base: number, preLine: boolean?)
	local r = Html.rich(html or "", base, preLine)
	if l.Text ~= r then l.Text = r end
	l.TextSize = base
	l.Visible = r ~= ""
end

local function drawSvg(parent: GuiObject, svg: any, order: number): Frame
	local canvas = Instance.new("Frame")
	canvas.Name = "Svg" .. order
	canvas.LayoutOrder = order
	canvas.BackgroundTransparency = 1
	canvas.Size = UDim2.fromOffset(svg.w, svg.h)
	canvas.ClipsDescendants = true
	local lines = svg.bg and ZoneMaps[svg.bg]
	if lines then
		for _, ln in lines do
			local x1, y1, x2, y2, col, w = ln[1], ln[2], ln[3], ln[4], ln[5], ln[6]
			local dx, dy = x2 - x1, y2 - y1
			local len = math.sqrt(dx * dx + dy * dy)
			local seg = Instance.new("Frame")
			seg.BorderSizePixel = 0
			seg.BackgroundColor3 = Color3.fromHex(col)
			seg.AnchorPoint = Vector2.new(0.5, 0.5)
			seg.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
			seg.Size = UDim2.fromOffset(math.max(len, w), w)
			seg.Rotation = math.deg(math.atan2(dy, dx))
			seg.Parent = canvas
		end
	end
	for _, t in svg.texts do
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.AnchorPoint = Vector2.new(0, 1)
		l.Position = UDim2.fromOffset(t.x, t.y + t.size * 0.2)
		l.AutomaticSize = Enum.AutomaticSize.XY
		l.Size = UDim2.fromOffset(0, 0)
		l.FontFace = Style.FONT
		l.TextSize = t.size
		l.TextColor3 = if t.color then Color3.fromHex(t.color) else Style.TEXT
		l.Text = t.text
		l.Parent = canvas
	end
	canvas.Parent = parent
	return canvas
end

local function btnKind(k: string?): Style.Kind
	return Style.KIND[k or ""] or Style.KIND.upg
end

function Render._update(self: Renderer, rec: Rec, n: any)
	rec.node = n
	local t, root = n.t, rec.root
	local extraStyle = n.cst
	if t == "col" or t == "row" or t == "tabs" then
		list(root, t ~= "col", if t == "col" then 6 else 8, t ~= "col" and not rec.autoW)
		local a = Style.apply(root, n.st)
		if n.st and (n.st["border-style"] or n.st.border) and not n.st.border then Style.stroke(root, 2, Style.TEXT, 0.4) end
		if a.w then root.Size = UDim2.new(0, a.w, root.Size.Y.Scale, root.Size.Y.Offset); root.AutomaticSize = Enum.AutomaticSize.Y end
		if extraStyle then Style.apply(root, extraStyle) end
	elseif rec.kind == "svg" then
		for _, c in root:GetChildren() do if c:IsA("GuiObject") then c:Destroy() end end
		list(root, false, 4)
		local order = 0
		for _, part in Html.split(n.h) do
			order += 1
			if type(part) == "string" then
				if string.find(part, "%S") then
					local l = label(root, "Text" .. order)
					l.LayoutOrder = order
					l.TextColor3, l.TextTransparency = rec.text, rec.textT
					setRich(l, part, rec.base)
				end
			else
				drawSvg(root, part, order)
			end
		end
	elseif t == "html" then
		local l = root:FindFirstChild("Text") :: TextLabel?
		if not l then l = label(root, "Text") end
		local lbl = l :: TextLabel
		local a = Style.apply(root, extraStyle)
		lbl.TextColor3 = a.text or rec.text
		lbl.TextTransparency = a.textT or rec.textT
		if rec.autoW then
			lbl.Size = UDim2.new(0, 0, 0, 0)
			lbl.AutomaticSize = Enum.AutomaticSize.XY
			lbl.TextWrapped = true
			sizeConstraint(lbl, nil, nil, 640)
		end
		setRich(lbl, n.h, a.font or rec.base)
		lbl.Visible = lbl.Text ~= ""
		root.Visible = lbl.Visible
	elseif t == "blank" then
		root.Size = UDim2.fromOffset(px(n.w, rec.base) or 8, px(n.hh, rec.base) or 17)
	elseif t == "hr" then
		root.BackgroundTransparency = 0.5
		root.BackgroundColor3 = Style.TEXT
		local w = px(n.w, rec.base)
		root.Size = if w then UDim2.fromOffset(w, 2) else UDim2.new(if rec.autoW then 0 else 0.95, if rec.autoW then 300 else 0, 0, 2)
	elseif t == "btn" then
		self:_updateButton(rec, n)
	elseif t == "ms" then
		root.Size = UDim2.new(0, 600, 0, 0)
		root.BackgroundColor3 = if n.done then Style.BOUGHT else Style.LOCKED
		root.BackgroundTransparency = 0
		Style.corner(root, 4)
		Style.stroke(root, 4)
		Style.pad(root, 6)
		list(root, false, 4)
		local a = Style.apply(root, n.st)
		if a.w then root.Size = UDim2.fromOffset(math.max(a.w, 120), 0) end
		rec.text, rec.textT, rec.base = a.text or Style.DARK, a.textT or 0.5, a.font or 14
		local l = root:FindFirstChild("Label") :: TextLabel
		l.TextColor3, l.TextTransparency = rec.text, rec.textT
		setRich(l, n.h, rec.base)
		sizeConstraint(root, nil, 35, nil)
	elseif t == "chal" then
		root.Size = UDim2.fromOffset(310, 0)
		root.BackgroundColor3 = if n.cls == "canComplete" then Style.COMPLETE elseif n.cls == "done" then Style.BOUGHT else Style.LOCKED
		root.BackgroundTransparency = 0
		Style.corner(root, 0.2)
		Style.stroke(root, 4)
		Style.glow(root, if n.active then Color3.new(1, 1, 1) else nil)
		Style.pad(root, 14)
		list(root, false, 8)
		local a = Style.apply(root, n.st)
		rec.text, rec.textT, rec.base = a.text or Style.DARK, a.textT or 0.5, a.font or 14
		local l = root:FindFirstChild("Label") :: TextLabel
		l.Visible = false
		sizeConstraint(root, nil, 310, nil)
		for _, kid in self:_children(rec.id) do
			local kr = self.recs[kid]
			if kr then kr.text, kr.textT, kr.base = rec.text, rec.textT, rec.base; kr.sig = nil; self:_update(kr, kr.node) end
		end
	elseif t == "ach" then
		root.Size = UDim2.fromOffset(90, 90)
		root.AutomaticSize = Enum.AutomaticSize.None
		root.BackgroundColor3 = if n.done then Style.BOUGHT else Style.LOCKED
		root.BackgroundTransparency = 0
		Style.corner(root, 0.1)
		Style.stroke(root, 2)
		Style.pad(root, 4)
		Style.apply(root, n.st)
		local l = root:FindFirstChild("Label") :: TextLabel
		l.TextColor3 = Color3.new(1, 1, 1)
		local stroke = Style.child(l, "UIStroke", "Shadow") :: UIStroke
		stroke.Thickness = 1
		stroke.Transparency = 0.3
		setRich(l, n.h, 10)
		local num = Style.child(root, "TextLabel", "Num") :: TextLabel
		num.BackgroundTransparency = 1
		num.Size = UDim2.fromOffset(30, 14)
		num.Position = UDim2.new(1, -30, 1, -14)
		num.FontFace = Style.FONT
		num.TextSize = 10
		num.TextColor3 = Color3.new(1, 1, 1)
		num.Text = tostring(n.num or "")
	elseif t == "info" then
		local color = Html.color(n.color) or Style.TEXT
		root.Size = UDim2.fromOffset(600, 0)
		root.BackgroundColor3 = Style.BG
		root.BackgroundTransparency = 0
		Style.stroke(root, 4, color, 0)
		Style.corner(root, if n.shut then 0 else 8)
		list(root, false, 4)
		local title = root:FindFirstChild("Title") :: TextButton
		title.BackgroundColor3 = color
		local tl = title:FindFirstChild("Label") :: TextLabel
		tl.TextColor3 = Style.DARK
		tl.TextXAlignment = Enum.TextXAlignment.Left
		setRich(tl, (if n.shut then "+ " else "- ") .. (n.title or ""), 24)
		local l = root:FindFirstChild("Label") :: TextLabel
		l.TextXAlignment = Enum.TextXAlignment.Left
		setRich(l, if n.shut then "" else n.body, 16)
	elseif t == "bar" then
		local w, h = px(n.w) or 200, px(n.hh) or 50
		root.Size = UDim2.fromOffset(w, h)
		root.AutomaticSize = Enum.AutomaticSize.None
		root.BackgroundColor3 = Style.BG
		Style.stroke(root, 2, Style.TEXT, 0)
		Style.apply(root, n.base)
		local fill = root:FindFirstChild("Fill") :: Frame
		local p = math.clamp(tonumber(n.p) or 0, 0, 1)
		local dir = n.dir
		fill.BackgroundColor3 = Style.TEXT
		Style.apply(fill, n.fill)
		if dir == 0 then fill.Size = UDim2.fromScale(1, p); fill.Position = UDim2.fromScale(0, 1 - p)
		elseif dir == 1 then fill.Size = UDim2.fromScale(1, p); fill.Position = UDim2.fromScale(0, 0)
		elseif dir == 2 then fill.Size = UDim2.fromScale(p, 1); fill.Position = UDim2.fromScale(1 - p, 0)
		else fill.Size = UDim2.fromScale(p, 1); fill.Position = UDim2.fromScale(0, 0) end
		local l = root:FindFirstChild("Label") :: TextLabel
		l.Size = UDim2.fromScale(1, 1)
		l.AutomaticSize = Enum.AutomaticSize.None
		l.ZIndex = 2
		setRich(l, n.h, 14)
	end
end

function Render._updateButton(self: Renderer, rec: Rec, n: any)
	local b = rec.root :: TextButton
	local k = btnKind(n.k)
	local w = k.w
	-- class colours, then the game's style on top
	local base = Style.classColor(n.k, n.cls)
	if base then b.BackgroundColor3 = base; b.BackgroundTransparency = 0 else b.BackgroundTransparency = 1 end
	Style.corner(b, k.radius)
	Style.stroke(b, k.stroke)
	Style.pad(b, if n.k == "tab" then 6 else 5)
	local a = Style.apply(b, n.st)
	if n.cst then
		local a2 = Style.apply(b, n.cst)
		a.w, a.h, a.minH, a.font, a.text = a2.w or a.w, a2.h or a.h, a2.minH or a.minH, a2.font or a.font, a2.text or a.text
	end
	if n.k == "tab" then
		local c = n.st and Html.color(n.st["border-color"])
		Style.stroke(b, 2, c or Style.TEXT, 0)
		b.BackgroundTransparency = if n.cls == "cur" then 0.75 else 1
		b.BackgroundColor3 = c or Style.TEXT
	elseif n.k == "menu" and n.cls == "cur" then
		Style.stroke(b, 3, Color3.new(1, 1, 1), 0)
	end
	Style.glow(b, if n.glow then (Html.color(n.glow) or Color3.new(1, 0, 0)) elseif n.pulse then Color3.new(1, 1, 1) else nil)
	local width = a.w or w
	local minH = a.minH or a.h or k.h
	if width then
		b.Size = UDim2.fromOffset(width, if k.grow then 0 else (a.h or k.h))
		b.AutomaticSize = if k.grow then Enum.AutomaticSize.Y else Enum.AutomaticSize.None
	else
		b.Size = UDim2.fromOffset(0, a.h or k.h)
		b.AutomaticSize = Enum.AutomaticSize.X
	end
	sizeConstraint(b, nil, if k.grow then minH else nil, nil)
	local l = b:FindFirstChild("Label") :: TextLabel
	l.TextColor3 = a.text or k.text
	l.TextTransparency = a.textT or 0
	l.TextXAlignment = k.align or Enum.TextXAlignment.Center
	if width then
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.TextWrapped = true
	else
		l.Size = UDim2.new(0, 0, 1, 0)
		l.AutomaticSize = Enum.AutomaticSize.X
		l.TextWrapped = false
	end
	if not k.grow then
		l.Size = UDim2.new(if width then 1 else 0, 0, 1, 0)
		l.AutomaticSize = if width then Enum.AutomaticSize.None else Enum.AutomaticSize.X
		l.TextScaled = false
	end
	setRich(l, n.h, a.font or k.font, n.k == "buy" or n.k == "click" or n.k == "grid")
	-- the upgrade's number, big and faint behind the text (upgNum)
	if n.n ~= nil and n.k == "upg" then
		local num = Style.child(b, "TextLabel", "Num") :: TextLabel
		num.BackgroundTransparency = 1
		num.Position = UDim2.fromOffset(1, 50)
		num.Size = UDim2.fromOffset(80, 60)
		num.TextXAlignment = Enum.TextXAlignment.Left
		num.FontFace = Style.FONT
		num.TextSize = 60
		num.TextColor3 = Style.DARK
		num.TextTransparency = 0.65
		num.ZIndex = 2
		num.Text = tostring(n.n)
	else
		Style.drop(b, "Num")
	end
	b.Active = n.a ~= nil
	b.Visible = not a.hidden
end

-- ---------------------------------------------------------------------------------------------------------- patches
function Render._children(self: Renderer, id: string): { string }
	local out = {}
	local set = self.kids[id]
	if set then for k in set do table.insert(out, k) end end
	return out
end

function Render._destroy(self: Renderer, id: string, keepKids: boolean?)
	local rec = self.recs[id]
	if not rec then return end
	if not keepKids then
		for _, k in self:_children(id) do self:_destroy(k) end
		self.kids[id] = nil
	end
	for _, c in rec.conns do c:Disconnect() end
	rec.root:Destroy()
	self.recs[id] = nil
	local p = parentOf(id)
	if p and self.kids[p] then self.kids[p][id] = nil end
end

function Render._place(self: Renderer, rec: Rec)
	local p, index = parentOf(rec.id)
	local parentObj: GuiObject? = nil
	if p == nil then
		parentObj = self.roots[rec.id]
	elseif self.recs[p] then
		parentObj = self.recs[p].content
	end
	rec.root.LayoutOrder = index
	rec.root.Parent = parentObj
	if p then
		self.kids[p] = self.kids[p] or {}
		self.kids[p][rec.id] = true
	end
end

function Render.apply(self: Renderer, patch: any)
	if patch.full then
		for id in self.recs do
			if parentOf(id) == nil then self:_destroy(id) end
		end
	end
	for _, id in patch.del or {} do self:_destroy(id) end
	local ids = {}
	for id in patch.set or {} do table.insert(ids, id) end
	table.sort(ids, function(a, b)
		local da, db = depth(a), depth(b)
		if da ~= db then return da < db end
		return a < b
	end)
	for _, id in ids do
		local n = patch.set[id]
		local rec: Rec? = self.recs[id]
		if rec and rec.kind ~= kindOf(n) then
			-- rebuilt: keep the children and move them to the new object
			local kids = self:_children(id)
			-- take the children out first: destroying the old object would destroy them too, and Roblox never
			-- lets a destroyed object be parented again
			for _, k in kids do
				local kr = self.recs[k]
				if kr then kr.root.Parent = nil end
			end
			self:_destroy(id, true)
			local built = self:_build(id, n)
			rec = built
			self.recs[id] = built
			self:_place(built)
			self.kids[id] = {}
			for _, k in kids do
				local kr = self.recs[k]
				if kr then self:_place(kr) end
			end
		elseif not rec then
			local built = self:_build(id, n)
			rec = built
			self.recs[id] = built
			self:_place(built)
		end
		self:_update(rec :: Rec, n)
	end
end

function Render.clear(self: Renderer)
	for id in self.recs do
		if parentOf(id) == nil then self:_destroy(id) end
	end
end

return Render
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Style</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Style: the page's CSS as Roblox GUI properties. The look of each kind of button comes from the game's
	style.css (TMT + NG+): sizes, the locked / bought / can colours, borders and corners. The per-thing style objects
	the game sets (st in a view node) are applied on top with Style.apply.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Html = require(ReplicatedStorage:WaitForChild("MilestoneTree"):WaitForChild("Html"))

local Style = {}

Style.FONT = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)
Style.BG = Color3.fromRGB(15, 15, 15)            -- --background
Style.TEXT = Color3.fromRGB(223, 223, 223)       -- --color
Style.POINTS = Color3.fromRGB(255, 255, 255)     -- --points
Style.LOCKED = Color3.fromHex("bf8f8f")
Style.BOUGHT = Color3.fromHex("77bf5f")
Style.COMPLETE = Color3.fromHex("ffbf00")
Style.PERK = Color3.fromHex("fdbc30")
Style.PSEUDO = Color3.fromHex("fd3030")
Style.DARK = Color3.new(0, 0, 0)

-- per button kind: w / h (px, h = minimum height when grow), font (px), radius (px or scale when < 1),
-- stroke (px, rgba(0,0,0,0.125)), grow (height follows the text), text colour
export type Kind = { w: number?, h: number, font: number, radius: number, stroke: number, grow: boolean, text: Color3, align: Enum.TextXAlignment? }
local K: { [string]: Kind } = {
	upg = { w = 200, h = 115, font = 10, radius = 0, stroke = 2, grow = true, text = Style.DARK },
	perk = { w = 200, h = 115, font = 10, radius = 0, stroke = 2, grow = true, text = Color3.new(1, 1, 1) },
	click = { w = 200, h = 115, font = 10, radius = 0, stroke = 2, grow = true, text = Style.DARK },
	buy = { w = 200, h = 200, font = 10, radius = 0.25, stroke = 2, grow = true, text = Style.DARK },
	grid = { w = 80, h = 80, font = 10, radius = 0.15, stroke = 2, grow = true, text = Style.DARK },
	reset = { w = 250, h = 90, font = 13, radius = 0, stroke = 4, grow = true, text = Style.DARK },
	tab = { w = nil, h = 38, font = 20, radius = 10, stroke = 2, grow = false, text = Style.TEXT },
	toggle = { w = 40, h = 40, font = 12, radius = 0.25, stroke = 2, grow = false, text = Style.DARK },
	respec = { w = 120, h = 50, font = 10, radius = 0.1, stroke = 2, grow = true, text = Style.DARK },
	master = { w = 120, h = 50, font = 10, radius = 0.1, stroke = 2, grow = true, text = Style.DARK },
	sell = { w = 120, h = 50, font = 10, radius = 0.1, stroke = 2, grow = true, text = Style.DARK },
	chalbtn = { w = 120, h = 50, font = 12, radius = 0.1, stroke = 2, grow = true, text = Style.DARK },
	malware = { w = 260, h = 40, font = 12, radius = 0, stroke = 2, grow = true, text = Color3.new(1, 1, 1) },
	menu = { w = 285, h = 35, font = 18, radius = 0, stroke = 2, grow = false, text = Style.DARK },
	opt = { w = 250, h = 60, font = 13, radius = 0, stroke = 0, grow = true, text = Color3.new(1, 1, 1), align = Enum.TextXAlignment.Left },
}
Style.KIND = K

-- the background a button's class gives it (the game's own style / layer colour comes on top)
function Style.classColor(kind: string, cls: string?): Color3?
	if cls == "locked" or cls == "plocked" then return Style.LOCKED end
	if cls == "bought" then return Style.BOUGHT end
	if cls == "perk" then return Style.PERK end
	if cls == "perked" then return Style.DARK end
	if cls == "pseudo" then return Style.PSEUDO end
	if kind == "opt" then return Color3.fromRGB(22, 22, 22) end
	if kind == "menu" then return Color3.fromHex("a3a3a3") end
	if kind == "tab" then return nil end
	return Style.POINTS
end

local function child<T>(obj: Instance, class: string, name: string): any
	local c = obj:FindFirstChild(name)
	if c and c.ClassName == class then return c end
	if c then c:Destroy() end
	local n = Instance.new(class :: any)
	n.Name = name
	n.Parent = obj
	return n
end
Style.child = child

local function drop(obj: Instance, name: string)
	local c = obj:FindFirstChild(name)
	if c then c:Destroy() end
end
Style.drop = drop

function Style.corner(obj: GuiObject, r: number?)
	if r == nil or r == 0 then drop(obj, "Corner"); return end
	local c = child(obj, "UICorner", "Corner") :: UICorner
	c.CornerRadius = if r < 1 then UDim.new(r, 0) else UDim.new(0, r)   -- < 1: CSS percent / 100
end

function Style.stroke(obj: GuiObject, px: number?, color: Color3?, transparency: number?)
	if px == nil or px <= 0 then drop(obj, "Border"); return end
	local s = child(obj, "UIStroke", "Border") :: UIStroke
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Thickness = math.min(px, 6)
	s.Color = color or Style.DARK
	s.Transparency = transparency or 0.875
end

-- a glow for notify / resetNotify (the page uses a blurred box-shadow)
function Style.glow(obj: GuiObject, color: Color3?)
	if color == nil then drop(obj, "Glow"); return end
	local s = child(obj, "UIStroke", "Glow") :: UIStroke
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Thickness = 3
	s.Color = color
	s.Transparency = 0.1
end

function Style.pad(obj: GuiObject, px: number)
	local p = child(obj, "UIPadding", "Pad") :: UIPadding
	p.PaddingTop, p.PaddingBottom = UDim.new(0, px), UDim.new(0, px)
	p.PaddingLeft, p.PaddingRight = UDim.new(0, px), UDim.new(0, px)
end

-- linear-gradient(...) -> UIGradient. Stops in px (the game's progress-bar trick: colour A up to Npx, then B) are
-- turned into fractions of the element's width.
function Style.gradient(obj: GuiObject, css: string?, widthPx: number?)
	if css == nil or not string.find(css, "gradient") then drop(obj, "Gradient"); return false end
	local stops = Html.gradient(css)
	if #stops == 0 then drop(obj, "Gradient"); return false end
	local w = widthPx or 200
	local pts: { ColorSequenceKeypoint } = {}
	local lastT = -1
	local function add(t: number, c: Color3)
		t = math.clamp(t, 0, 1)
		if t <= lastT then t = math.min(1, lastT + 0.0005) end
		if t <= lastT then return end
		table.insert(pts, ColorSequenceKeypoint.new(t, c))
		lastT = t
	end
	for i, s in stops do
		local t: number
		if (s :: any).px ~= nil then t = (s :: any).px / w
		elseif s.stop ~= nil then t = s.stop
		else t = if #stops == 1 then 0 else (i - 1) / (#stops - 1) end
		if i > 1 and t < lastT then t = lastT end
		add(if i == 1 then 0 else t, s.c)
		if i == 1 and t > 0 then add(t, s.c) end
	end
	if lastT < 1 then add(1, stops[#stops].c) end
	if #pts < 2 then drop(obj, "Gradient"); obj.BackgroundColor3 = stops[1].c; return true end
	while #pts > 20 do table.remove(pts, (#pts - 1)) end -- keep the last stop
	local g = child(obj, "UIGradient", "Gradient") :: UIGradient
	g.Color = ColorSequence.new(pts)
	local dir = string.lower(css)
	g.Rotation = if string.find(dir, "to bottom") then 90 elseif string.find(dir, "to left") then 180 elseif string.find(dir, "to top") then 270 else 0
	obj.BackgroundColor3 = Color3.new(1, 1, 1)
	obj.BackgroundTransparency = 0
	return true
end

export type Applied = { w: number?, h: number?, minH: number?, font: number?, text: Color3?, textT: number?, hidden: boolean }

-- the game's style object on a GUI object: colours, border, corners; sizes and text are returned for the caller
function Style.apply(obj: GuiObject, st: { [string]: string }?, widthPx: number?): Applied
	local out: Applied = { hidden = false }
	if st == nil then drop(obj, "Gradient"); return out end
	local bgc = st["background-color"]
	local bg = st.background or st["background-image"]
	local w = Html.px(st.width, 16) or Html.px(st["min-width"], 16)
	out.w = w
	out.h = Html.px(st.height, 16)
	out.minH = Html.px(st["min-height"] or st.minHeight, 16)
	out.font = Html.px(st["font-size"], 16)
	if not Style.gradient(obj, bg, w or widthPx) then
		local c, t = Html.color(bgc or bg)
		if c then
			obj.BackgroundColor3 = c
			obj.BackgroundTransparency = t
		end
	end
	if st.color then
		local c, t = Html.color(st.color)
		if c then out.text = c; out.textT = t end
	end
	local border = st.border or st["border-width"]
	if border or st["border-color"] then
		local px = if border then (Html.px(string.match(border, "[%d%.]+px") or border, 16) or 2) else 2
		if border and string.find(border, "none") then px = 0 end
		local c, t = Html.color(st["border-color"] or border)
		Style.stroke(obj, px, c or Style.TEXT, if c then t else 0)
	end
	local r = st["border-radius"]
	if r then
		local pct = string.match(r, "^%s*([%d%.]+)%%")
		if pct then Style.corner(obj, math.clamp((tonumber(pct) or 0) / 100, 0, 0.5))
		else Style.corner(obj, Html.px(r, 16)) end
	end
	if st.opacity then
		local o = tonumber(st.opacity)
		if o then obj.BackgroundTransparency = 1 - (1 - obj.BackgroundTransparency) * o end
	end
	if st.visibility == "hidden" or st.display == "none" then out.hidden = true end
	return out
end

return Style
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>