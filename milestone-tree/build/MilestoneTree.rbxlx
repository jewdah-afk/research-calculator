		end
	end
	do return playerdata end
end
getStartLayerData = function(this, layer)
	layerdata = JS.O({})
	if JS.t(layers[JS.k(layer)].startData) then
		layerdata = layers[JS.k(layer)]:startData()
	end
	if (layerdata.unlocked == nil) then
		JS.setk(layerdata, "unlocked", true)
