setupBuyables = function(this, layer)
	for _, __k6 in JS.keys(layers[JS.k(layer)].buyables) do
		id = __k6
		if isPlainObject(nil, layers[JS.k(layer)].buyables[id]) then
			local b = layers[JS.k(layer)].buyables[id]
