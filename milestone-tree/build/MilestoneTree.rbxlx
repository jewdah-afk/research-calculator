			if ((not (t[JS.k(id)] == nil)) and JS.t(t[JS.k(id)].unlocked)) then
				ch = rbx_challenge(nil, layer, id)
				if JS.t(ch) then
					JS.m(row, "push", ch)
				end
			end
		end
		if JS.t(JS.len(row)) then
			JS.m(out, "push", JS.O({
