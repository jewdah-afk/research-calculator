			layerDataReset(nil, "p", JS.A(1, "upgrades"))
		else
			layerDataReset(nil, "p", JS.A(0))
		end
	end
	if (l == "hp") then
		if player.m.best:gte(65) then
			layerDataReset(nil, "p", JS.A(1, "upgrades"))
		else
			layerDataReset(nil, "p", JS.A(0))
		end
	end
	if (l == "ap") then
		if player.m.best:gte(81) then
			layerDataReset(nil, "p", JS.A(1, "upgrades"))
		else
			layerDataReset(nil, "p", JS.A(0))
		end
	end
	if (l == "t") then
		if player.m.best:gte(100) then
			layerDataReset(nil, "p", JS.A(1, "upgrades"))
		else
			layerDataReset(nil, "p", JS.A(0))
		end
	end
	if (l == "hb") then
