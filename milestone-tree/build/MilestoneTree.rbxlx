      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">UiKit</string>
          <string name="Source"><![CDATA[--!strict
-- GENERATED by art/gems/upload.js --kit ui from art/substance/ui_kit.json + uploaded.json. Do not edit by hand:
--   cd art && python3 substance/kit.py build && node gems/upload.js --kit ui
-- The UI kit (Substance Painter textures, or the interim ones in art/substance/base): 9-sliced slots in one 1024
-- atlas. rect = { x, y, w, h } atlas px, slice = the corner size (px), tint = multiply by the layer hue.
-- id = nil: Core/Skin draws nothing and the procedural Sleek surfaces stay.

export type Slot = { rect: { number }, slice: number, tint: boolean }
export type UiKit = { id: string?, size: number, slots: { [string]: Slot } }

local UiKit: UiKit = {
	id = "rbxassetid://101444218779066",
	size = 1024,
	slots = {
		cta = { rect = { 512, 0, 512, 128 }, slice = 36, tint = true },
		button = { rect = { 512, 128, 384, 96 }, slice = 28, tint = false },
		tile = { rect = { 512, 224, 160, 160 }, slice = 44, tint = false },
		panel = { rect = { 0, 0, 512, 512 }, slice = 110, tint = false },
		plate = { rect = { 672, 224, 256, 128 }, slice = 36, tint = false },
	},
}

return UiKit
]]></string>
        </Properties>
      </Item>
