	do return ((JS.m(player[JS.k(layer)].milestones, "includes", toNumber(nil, id)) or JS.m(player[JS.k(layer)].milestones, "includes", JS.m(id, "toString"))) and (not JS.t(tmp[JS.k(layer)].deactivated))) end
