				glow = (if JS.t(glow) then rbx_str(nil, (if JS.t(data[JS.k(tab)].glowColor) then data[JS.k(tab)].glowColor else defaultGlow)) else JS.NULL),
				pulse = (if JS.t(subtabResetNotify(nil, layer, name, tab)) then true else JS.NULL),
