	color = "#FFFF00",
	requires1 = function(this)
	if player.m.best:gte(156) then
		do return JS.D("1e400") end
	end
	if player.m.best:gte(137) then
		do return JS.D("1e640") end
	end
	do return JS.D("1e850") end
end,
