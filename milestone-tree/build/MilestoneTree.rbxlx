	local t, shut
	t = tmp[JS.k(layer)].infoboxes
	if (not ((JS.t(t) and (not (t[JS.k(id)] == nil))) and JS.t(t[JS.k(id)].unlocked))) then
		do return JS.NULL end
	end
	shut = player.infoboxes[JS.k(layer)][JS.k(id)]
	do return JS.O({
