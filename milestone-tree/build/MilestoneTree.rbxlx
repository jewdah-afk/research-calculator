rbx_upgrade = function(this, layer, id)
	local t, L, req, bought, can, h, ti, ds, ef, co, cn, custom, title, e, cd, cur, n
	t = tmp[JS.k(layer)].upgrades[JS.k(id)]
	L = layers[JS.k(layer)].upgrades[JS.k(id)]
	if (t == nil) then
		do return JS.NULL end
	end
	if (JS.t(perkUnl(nil, layer, id)) and (not JS.t(t.unlocked))) then
		req = rbx_str(nil, rbx_v(nil, t, L, "perkReq"))
		do return JS.O({
			t = "btn",
			k = "perk",
			cls = (if JS.t(t.perkCan) then "perk" else "perked"),
			a = rbx_act(nil, JS.A(3, "perk", layer, id)),
			h = ("<h3>Explore A New Perk Upgrade</h3><br>" .. JS.str(req)),
			id = id,
			req = req
		}, {"t", "k", "cls", "a", "h", "id", "req"}) end
	end
	if (not JS.t(t.unlocked)) then
		do return JS.NULL end
	end
	bought = hasUpgrade(nil, layer, id)
	can = (canAffordUpgrade(nil, layer, id) and (not JS.t(bought)))
	h = ""
	ti = JS.NULL
	ds = JS.NULL
	ef = JS.NULL
	co = JS.NULL
	cn = JS.NULL
	custom = true
	if JS.t(L.fullDisplay) then
		h = rbx_str(nil, run(nil, L.fullDisplay, L))
	else
		title = rbx_v(nil, t, L, "title")
		if JS.t(title) then
			h = (JS.str(h) .. (("<h3>" .. JS.str(title)) .. "</h3><br>"))
		end
		ti = rbx_txt(nil, title)
		ds = rbx_str(nil, rbx_v(nil, t, L, "description"))
		h = JS.add(h, ds)
		if JS.t(L.effectDisplay) then
			e = run(nil, L.effectDisplay, L)
			h = (JS.str(h) .. ("<br>Currently: " .. JS.str(e)))
			ef = rbx_txt(nil, e)
		end
		h = (JS.str(h) .. "<br>")
		cd = rbx_v(nil, t, L, "costDescription")
		if JS.t(cd) then
			h = JS.add(h, cd)
			co = rbx_str(nil, cd)
		else
			cur = rbx_v(nil, t, L, "currencyDisplayName")
			co = formatWhole(nil, t.cost)
			cn = rbx_str(nil, (if JS.t(cur) then cur else tmp[JS.k(layer)].resource))
			h = (JS.str(h) .. ((("Cost: " .. JS.str(co)) .. " ") .. JS.str(cn)))
			custom = false
		end
	end
	n = JS.O({
		t = "btn",
		k = "upg",
		cls = (if JS.t(bought) then "bought" else (if JS.t(can) then "can" else "locked")),
		n = (if JS.t(L.fullDisplay) then JS.NULL else id),
		h = h,
		a = rbx_act(nil, JS.A(3, "upg", layer, id)),
		tip = rbx_v(nil, t, L, "tooltip"),
		st = rbx_css(nil, JS.A(3, (if JS.t(can) then JS.O({
		["background-color"] = tmp[JS.k(layer)].color
	}) else JS.NULL), tmp[JS.k(layer)].componentStyles.upgrade, rbx_v(nil, t, L, "style")))
	}, {"t", "k", "cls", "n", "h", "a", "tip", "st"})
	JS.setk(n, "id", id)
	JS.setk(n, "ti", ti)
	JS.setk(n, "ds", ds)
	JS.setk(n, "ef", ef)
	JS.setk(n, "co", co)
	JS.setk(n, "cur", cn)
	JS.setk(n, "pr", (if (((JS.t(bought) or JS.t(can)) or JS.t(custom)) or (t.cost == nil)) then JS.NULL else rbx_prCap(nil, rbx_pr(nil, rbx_upgHave(nil, layer, t), t.cost))))
	do return n end
end
rbx_upgHave = function(this, layer, t)
	local name
	name = t.currencyInternalName
	if JS.t(name) then
		if JS.t(t.currencyLocation) then
			do return t.currencyLocation[JS.k(name)] end
		end
		if JS.t(t.currencyLayer) then
			do return player[JS.k(t.currencyLayer)][JS.k(name)] end
		end
		do return player[JS.k(name)] end
	end
	do return player[JS.k(layer)].points end
end
rbx_lbStats = function(this)
	local out, i, l, d, v
	out = JS.A(1, JS.A(2, "points", player.points))
	for i = 0, JS.cap(0, (JS.len(rbx_LB_LAYERS)) - 1, 1) do
		l = rbx_LB_LAYERS[JS.k(i)]
		d = player[JS.k(l)]
		if (not JS.t(d)) then
			continue
		end
		v = (if (not (d.best == nil)) then d.best else d.points)
		if (not (v == nil)) then
			JS.m(out, "push", JS.A(2, l, v))
		end
	end
	JS.m(out, "push", JS.A(2, "ach", JS.len(player.ach.achievements)))
	do return out end
end
rbx_buyAllOn = function(this, l)
	local nx, k, n, sd
	nx = rbx_BUYALL_AFTER[JS.k(l)]
	if ((((not JS.t(nx)) or (not JS.t(player[JS.k(l)]))) or (not JS.t(player[JS.k(nx)]))) or (not JS.t(tmp[JS.k(nx)]))) then
		do return false end
	end
	if (rbx_BUYALL_STARTUNL == JS.NULL) then
		rbx_BUYALL_STARTUNL = JS.O({})
		for _, __k2 in JS.keys(rbx_BUYALL_AFTER) do
			k = __k2
			n = rbx_BUYALL_AFTER[k]
			sd = (if (JS.t(layers[JS.k(n)]) and JS.t(layers[JS.k(n)].startData)) then layers[JS.k(n)]:startData() else JS.NULL)
			JS.set(rbx_BUYALL_STARTUNL, JS.k(n), (if (JS.t(sd) and JS.t(sd.unlocked)) then true else false))
		end
	end
	if ((JS.t(player[JS.k(nx)].unlocked) and (not JS.t(rbx_BUYALL_STARTUNL[JS.k(nx)]))) or JS.eq(tmp[JS.k(nx)].layerShown, true)) then
		do return true end
	end
	do return ((not (player[JS.k(nx)].best == nil)) and (JS.D(player[JS.k(nx)].best)):gt(0)) end
end
rbx_buyAllIds = function(this, l)
	local t, out, r, c, id
	t = tmp[JS.k(l)].upgrades
	out = JS.A(0)
	if (((not JS.t(t)) or (not JS.t(player[JS.k(l)].unlocked))) or JS.t(player[JS.k(l)].deactivated)) then
		do return out end
	end
	for r = 1, JS.cap(1, JS.tonum(t.rows), 1) do
		for c = 1, JS.cap(1, JS.tonum(t.cols), 1) do
			id = JS.add((JS.tonum(r) * 10), c)
			if ((t[JS.k(id)] == nil) or (not (layers[JS.k(l)].upgrades[JS.k(id)].perkUnl == nil))) then
				continue
			end
			if ((JS.t(t[JS.k(id)].unlocked) and (not hasUpgrade(nil, l, id))) and canAffordUpgrade(nil, l, id)) then
				JS.m(out, "push", id)
			end
		end
	end
	do return out end
end
rbx_buyAll = function(this, l)
	local n, pass, ids, got, i, id, U, ok
	if ((not JS.t(rbx_buyAllOn(nil, l))) or (not JS.t(player[JS.k(l)].unlocked))) then
		do return 0 end
	end
	n = 0
	for pass = 0, (6) - 1 do
		ids = rbx_buyAllIds(nil, l)
		got = 0
		for i = 0, JS.cap(0, (JS.len(ids)) - 1, 1) do
			id = ids[JS.k(i)]
			U = layers[JS.k(l)].upgrades[JS.k(id)]
			if (not (U.canAfford == nil)) then
				ok = false
				do
					local __ok3, __e4 = pcall(function()
						ok = (if JS.t(run(nil, U.canAfford, U)) then true else false)
					end)
					if not __ok3 then
						local e = __e4
						ok = false
					end
				end
				JS.setk(tmp[JS.k(l)].upgrades[JS.k(id)], "canAfford", ok)
			end
			if (not canAffordUpgrade(nil, l, id)) then
				continue
			end
			buyUpg(nil, l, id)
			if hasUpgrade(nil, l, id) then
				got = (JS.tonum(got) + 1)
			end
		end
		if JS.eq(got, 0) then
			break
		end
		n = JS.add(n, got)
		updateTemp(nil)
	end
	do return n end
end
rbx_upgrades = function(this, layer)
	local t, rows, r, row, c, id, u, col
	t = tmp[JS.k(layer)].upgrades
	if (not JS.t(t)) then
		do return JS.NULL end
	end
	rows = JS.A(0)
	for r = 1, JS.cap(1, JS.tonum(t.rows), 1) do
		row = JS.A(0)
		for c = 1, JS.cap(1, JS.tonum(t.cols), 1) do
			id = JS.add((JS.tonum(r) * 10), c)
			if (not (t[JS.k(id)] == nil)) then
				u = rbx_upgrade(nil, layer, id)
				if JS.t(u) then
					JS.m(row, "push", u)
				end
			end
		end
		if JS.t(JS.len(row)) then
			JS.m(rows, "push", JS.O({
				t = "row",
				c = row
			}, {"t", "c"}))
		end
	end
	col = JS.O({
		t = "col",
		c = rows
	}, {"t", "c"})
	if JS.t(rbx_buyAllOn(nil, layer)) then
		JS.setk(col, "ba", rbx_act(nil, JS.A(2, "buyall", layer)))
		JS.setk(col, "bn", JS.len(rbx_buyAllIds(nil, layer)))
	end
	do return col end
end
