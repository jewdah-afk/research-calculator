		for c = 1, JS.cap(1, JS.tonum(t.cols), 1) do
			id = JS.add((JS.tonum(rows[JS.k(i)]) * 10), c)
			if ((not (t[JS.k(id)] == nil)) and JS.t(t[JS.k(id)].unlocked)) then
				a = rbx_achievement(nil, layer, id)
				if JS.t(a) then
					JS.m(row, "push", a)
				end
			end
		end
		if JS.t(JS.len(row)) then
			JS.m(out, "push", JS.O({
