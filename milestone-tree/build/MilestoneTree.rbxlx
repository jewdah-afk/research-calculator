		table_ = (JS.str(table_) .. (("<hr color='darkred' size='3'>Exotic Booster effect base is ^" .. JS.str(format(nil, tmp.m.milestones[0].effect))) .. " better based on points gain."))
	end
	do return table_ end
end,
	effect = function(this)
