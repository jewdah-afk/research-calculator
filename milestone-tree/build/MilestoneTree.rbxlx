      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">AudioIds</string>
          <string name="Source"><![CDATA[--!strict
-- GENERATED by art/audio/upload.js from art/audio/sheets/map.json + art/audio/uploaded.json. Do not edit by hand:
--   python3 art/audio/pack.py && node art/audio/upload.js [--dry-run]
-- The game's sounds (Core/Audio). A sound plays a region { start, length } (seconds) of a sheet; several regions
-- are its variants; a loop's region is exactly one period. id = nil: that sheet is not uploaded or not approved by
-- moderation yet, and every sound on it stays silent. review = the id of a sheet still in moderation: only Studio
-- (where its owner can hear it) tries it. lufs = each variant's loudness (momentary max; loops: integrated).

export type Sheet = { id: string?, review: string?, moderation: string?, length: number }
export type Sound = { sheet: string, bus: string, loop: boolean, regions: { { number } }, lufs: { number } }
export type AudioIds = { version: string, sheets: { [string]: Sheet }, sounds: { [string]: Sound } }

local AudioIds: AudioIds = {
	version = "ab7e208d5ae4",
	sheets = {
		ui = { id = "rbxassetid://111667343125733", review = nil, moderation = "Approved", length = 16.96 },
		fx = { id = "rbxassetid://91457771301733", review = nil, moderation = "Approved", length = 19.44 },
		bed = { id = "rbxassetid://72123564730814", review = nil, moderation = "Approved", length = 34 },
	},
	sounds = {
		hover = { sheet = "ui", bus = "UI", loop = false, regions = { { 0.05, 0.21 }, { 0.56, 0.21 }, { 1.07, 0.21 }, { 1.58, 0.21 }, { 2.09, 0.21 } }, lufs = { -26.41, -26.45, -26.47, -26.45, -26.51 } },
		press = { sheet = "ui", bus = "UI", loop = false, regions = { { 2.6, 0.18 }, { 3.08, 0.18 }, { 3.56, 0.18 }, { 4.04, 0.18 } }, lufs = { -22.5, -22.44, -22.47, -22.47 } },
		tab = { sheet = "ui", bus = "UI", loop = false, regions = { { 4.52, 0.31 }, { 5.13, 0.31 }, { 5.74, 0.31 }, { 6.35, 0.31 } }, lufs = { -21.95, -21.96, -21.96, -21.93 } },
		panel_open = { sheet = "ui", bus = "UI", loop = false, regions = { { 6.96, 0.76 } }, lufs = { -18.53 } },
		panel_close = { sheet = "ui", bus = "UI", loop = false, regions = { { 8.02, 0.49 } }, lufs = { -20.52 } },
		buy = { sheet = "ui", bus = "UI", loop = false, regions = { { 8.81, 0.91 }, { 10.02, 0.91 }, { 11.23, 0.91 }, { 12.44, 0.91 } }, lufs = { -14.47, -14.44, -14.46, -14.47 } },
		toast = { sheet = "ui", bus = "UI", loop = false, regions = { { 13.65, 1.01 }, { 14.96, 1.01 } }, lufs = { -18.46, -18.44 } },
		error = { sheet = "ui", bus = "UI", loop = false, regions = { { 16.27, 0.39 } }, lufs = { -19.41 } },
		unlock = { sheet = "fx", bus = "Impacts", loop = false, regions = { { 0.05, 1.46 } }, lufs = { -11.56 } },
		prestige_small = { sheet = "fx", bus = "Impacts", loop = false, regions = { { 1.81, 1.51 }, { 3.62, 1.51 } }, lufs = { -11.89, -11.88 } },
		prestige_big = { sheet = "fx", bus = "Impacts", loop = false, regions = { { 5.43, 4.41 } }, lufs = { -8.14 } },
		portal_loop = { sheet = "fx", bus = "Ambience", loop = true, regions = { { 10.64, 8 } }, lufs = { -20.68 } },
		ambience = { sheet = "bed", bus = "Ambience", loop = true, regions = { { 1, 32 } }, lufs = { -17.99 } },
	},
}

return AudioIds
]]></string>
        </Properties>
