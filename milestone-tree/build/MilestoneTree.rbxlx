end
maxedChallenge = function(this, layer, id)
	do return (JS.cmp(player[JS.k(layer)].challenges[JS.k(id)], ">=", tmp[JS.k(layer)].challenges[JS.k(id)].completionLimit) and (not JS.t(tmp[JS.k(layer)].deactivated))) end
