		JS.set(player.sp.timer, JS.k(player.sp.ashedMilestones), 240)
		if (JS.eq(player.sp.timer[JS.k((JS.tonum(player.sp.ashedMilestones) - 1))], 0) and (JS.tonum(player.sp.ashedMilestones) > 0)) then
