end
startPlayerBase = function(this)
	do return JS.O({
		tab = layoutInfo.startTab,
		navTab = (if JS.t(layoutInfo.showTree) then layoutInfo.startNavTab else "none"),
		time = Date.now(),
		notify = JS.O({}),
		versionType = modInfo.id,
