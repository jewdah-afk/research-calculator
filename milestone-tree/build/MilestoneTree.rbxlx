      <Item class="LocalScript" referent="4">
        <Properties>
          <string name="Name">Boot</string>
          <string name="Source"><![CDATA[--!strict
-- The loading screen from the first frame: replaces Roblox's default one. The game's overlay (Overlay/Screens) drives
-- it from there (status, the asset preload's progress) and fades it out once the player's game is on screen and its
-- images are fetched (App + Core/Preload).
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local BootScreen = require(script.Parent:WaitForChild("BootScreen"))

pcall(function() ReplicatedFirst:RemoveDefaultLoadingScreen() end)
BootScreen.show()
-- a safety net: if the game's client never took over (a script error), do not cover the screen for good
task.delay(45, function()
	if BootScreen.visible() and not BootScreen.claimed() then BootScreen.hide() end
end)

-- a holding server (the game was updated, see server/SoftShutdown) sends everyone back to a public server itself;
-- if this player is still here long after that, they go back on their own (a client may teleport itself)
task.spawn(function()
	local function holding(): boolean return workspace:GetAttribute("MT_Holding") == true end
	if not holding() then workspace:GetAttributeChangedSignal("MT_Holding"):Wait() end
	task.wait(40)
	for _ = 1, 3 do
		pcall(function()
			game:GetService("TeleportService"):Teleport(game.PlaceId, game:GetService("Players").LocalPlayer)
		end)
		task.wait(20)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">BootScreen</string>
          <string name="Source"><![CDATA[--!strict
--[[
	BootScreen: the loading screen, from the first frame (ReplicatedFirst) until the player's game is on screen.
	No other modules: it runs before ReplicatedStorage has replicated.

	    BootScreen.show()                   build it (idempotent); Boot.client.luau calls it at once
	    BootScreen.set("Loading your save…") the status line   BootScreen.set({ done = 3, total = 9 }) the asset count
	    BootScreen.hide()                   fill the line, fade out, destroy; never before MIN_SHOW seconds on screen
	    BootScreen.visible()   BootScreen.claim() (the overlay drives it)   BootScreen.claimed()

	Look (Sleek, DESIGN.md Style 1): the void, a soft violet glow, four corner ticks, a diamond emblem that breathes
	and turns, THE MILESTONE TREE in tracked heavy italic caps with NG+ in the Milestone violet, a 2 px progress line
	with the % at its right, the status in caps above it, and a rotating tip under it. The % is the client's asset
	preload (Core/Preload): done / total of the images and fonts, up to 95%; the rest fills as it fades. Until the
	first count arrives (the client's scripts are still replicating) it creeps towards 15% so it never looks stuck.

	The screen stays at least MIN_SHOW seconds, also when the game is ready sooner (a fast device, a warm cache): the
	title and the tree get their moment. Once asked to hide it reads ENTERING THE TREE and the line fills to 100% by the
	end of that time, then it fades.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local BootScreen = {}

local VOID = Color3.fromHex("05070c")
local HUE = Color3.fromHex("b35cff") -- the Milestone violet
local TEXT = Color3.fromHex("f3f6fb")
local SOFT = Color3.fromHex("aab4c4")
local MUTED = Color3.fromHex("6b7486")
local HAIR = Color3.new(1, 1, 1)
local MIN_SHOW = 4 -- seconds on screen at the least
BootScreen.MIN_SHOW = MIN_SHOW
local CREEP = 0.15 -- how far the line creeps before the first asset count
local LOADED = 0.95 -- every asset fetched; the last 5% fills as the screen fades

local TIPS = {
	"Tap a node on the tree to open its layer",
	"Hold a READY gem to prestige without opening the layer",
	"Locked layers say how many milestones reveal them",
	"Right-click a node (or press and hold it) to peek at it",
	"Options › Numbers switches between 1.23M and 1.23e6",
	"The game keeps running while you are away",
}

local gui: ScreenGui? = nil
local parts: { [string]: any } = {}
local status = "Loading the realm"
local target = 0
local shown = 0
local counted = false -- the client reported an asset count: the line follows it from then on
local started = 0
local hiding = false
local hideAt, hideFrom, hold = 0, 0, 0 -- when hide() was asked, the line then, the time left to MIN_SHOW
local claimed = false
local conn: RBXScriptConnection? = nil

-- tracked caps: a hair space between the letters (the engine has no letter spacing)
local function caps(s: string): string
	local out = {}
	for _, c in utf8.codes(string.upper(s)) do
		table.insert(out, utf8.char(c))
	end
	return table.concat(out, "\u{200A}")
end

local function frame(parent: Instance, name: string, props: { [string]: any }): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BorderSizePixel = 0
	f.BackgroundTransparency = 1
	for k, v in props do (f :: any)[k] = v end
	f.Parent = parent
	return f
end
local function label(parent: Instance, name: string, text: string, size: number, color: Color3, font: Font,
	props: { [string]: any }?): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Text = text
	l.TextSize = size
	l.TextColor3 = color
	l.FontFace = font
	l.Size = UDim2.new(1, 0, 0, size + 6)
	l.TextXAlignment = Enum.TextXAlignment.Center
	if props then
		for k, v in props do (l :: any)[k] = v end
	end
	l.Parent = parent
	return l
end
local function font(weight: Enum.FontWeight, italic: boolean?): Font
	return Font.fromName("Montserrat", weight, if italic then Enum.FontStyle.Italic else Enum.FontStyle.Normal)
end

-- an L of two 2 px bars in a screen corner
local function tick(parent: Instance, name: string, ax: number, ay: number)
	local holder = frame(parent, name, {
		AnchorPoint = Vector2.new(ax, ay), Position = UDim2.new(ax, if ax == 0 then 28 else -28, ay, if ay == 0 then 28 else -28),
		Size = UDim2.fromOffset(22, 22),
	})
	frame(holder, "H", { BackgroundTransparency = 0.55, BackgroundColor3 = HAIR, Size = UDim2.fromOffset(22, 2),
		Position = UDim2.fromScale(0, ay), AnchorPoint = Vector2.new(0, ay) })
	frame(holder, "V", { BackgroundTransparency = 0.55, BackgroundColor3 = HAIR, Size = UDim2.fromOffset(2, 22),
		Position = UDim2.fromScale(ax, 0), AnchorPoint = Vector2.new(ax, 0) })
end

local function build(): ScreenGui
	local g = Instance.new("ScreenGui")
	g.Name = "MilestoneBoot"
	g.IgnoreGuiInset = true
	g.ResetOnSpawn = false
	g.DisplayOrder = 1000
	g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	pcall(function() g.ScreenInsets = Enum.ScreenInsets.None end)

	local back = frame(g, "Back", { BackgroundTransparency = 0, BackgroundColor3 = VOID, Size = UDim2.fromScale(1, 1) })
	-- a soft violet glow from the middle (a vertical fade: radial gradients are still a beta)
	local glow = frame(back, "Glow", { BackgroundTransparency = 0, BackgroundColor3 = HUE, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.46), Size = UDim2.new(1.2, 0, 0.9, 0) })
	local gg = Instance.new("UIGradient")
	gg.Rotation = 90
	gg.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.9), NumberSequenceKeypoint.new(1, 1),
	})
	gg.Parent = glow
	tick(back, "TickTL", 0, 0)
	tick(back, "TickTR", 1, 0)
	tick(back, "TickBL", 0, 1)
	tick(back, "TickBR", 1, 1)

	-- the centre column, scaled to the screen (the design is 1920 x 1080; phones keep it readable)
	local col = frame(back, "Column", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(640, 420) })
	local scale = Instance.new("UIScale")
	scale.Parent = col
	parts.scale = scale

	-- the emblem: an outer square outline turning slowly, a diamond outline, a filled core that breathes
	local emblem = frame(col, "Emblem", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(120, 120) })
	local outer = frame(emblem, "Outer", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(84, 84) })
	local os_ = Instance.new("UIStroke")
	os_.Color = HAIR
	os_.Transparency = 0.8
	os_.Thickness = 1
	os_.Parent = outer
	local diamond = frame(emblem, "Diamond", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(62, 62), Rotation = 45 })
	local ds = Instance.new("UIStroke")
	ds.Color = HUE
	ds.Thickness = 2
	ds.Parent = diamond
	local core = frame(emblem, "Core", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(26, 26), Rotation = 45, BackgroundTransparency = 0, BackgroundColor3 = HUE })
	local cg = Instance.new("UIGradient")
	cg.Color = ColorSequence.new(Color3.fromHex("e6c8ff"), HUE)
	cg.Rotation = 90
	cg.Parent = core
	parts.outer, parts.diamond, parts.core = outer, diamond, core

	-- the title
	label(col, "Title", caps("The Milestone Tree"), 46, TEXT, font(Enum.FontWeight.Heavy, true),
		{ Position = UDim2.fromOffset(0, 138), Size = UDim2.new(1, 0, 0, 56) })
	label(col, "Edition", caps("NG+  ·  An incremental tree"), 14, HUE, font(Enum.FontWeight.Bold),
		{ Position = UDim2.fromOffset(0, 198) })

	-- the progress: status (left) and % (right) above a 2 px line
	local bar = frame(col, "Bar", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 268),
		Size = UDim2.fromOffset(420, 40) })
	parts.status = label(bar, "Status", caps(status), 12, SOFT, font(Enum.FontWeight.Bold),
		{ Size = UDim2.new(1, -60, 0, 16), TextXAlignment = Enum.TextXAlignment.Left })
	parts.pct = label(bar, "Pct", "0%", 12, TEXT, font(Enum.FontWeight.Bold),
		{ AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(60, 16),
			TextXAlignment = Enum.TextXAlignment.Right })
	local track = frame(bar, "Track", { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 2),
		BackgroundTransparency = 0.88, BackgroundColor3 = HAIR })
	local fill = frame(track, "Fill", { Size = UDim2.fromScale(0, 1), BackgroundTransparency = 0, BackgroundColor3 = HUE })
	local fg = Instance.new("UIGradient")
	fg.Color = ColorSequence.new(HUE, Color3.fromHex("e6c8ff"))
	fg.Parent = fill
	frame(track, "CapL", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(2, 10),
		BackgroundTransparency = 0.4, BackgroundColor3 = HAIR })
	frame(track, "CapR", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(2, 10),
		BackgroundTransparency = 0.4, BackgroundColor3 = HAIR })
	parts.fill = fill

	-- the tip
	parts.tip = label(col, "Tip", "", 15, MUTED, font(Enum.FontWeight.SemiBold),
		{ Position = UDim2.fromOffset(0, 336), Size = UDim2.new(1, 0, 0, 40), TextWrapped = true })
	return g
end

local function layout(g: ScreenGui)
	local cam = workspace.CurrentCamera
	local v = if cam then cam.ViewportSize else Vector2.new(1920, 1080)
	local s = math.clamp(math.min(v.X / 1920, v.Y / 1080) * 1.25, 0.55, 2)
	if parts.scale then parts.scale.Scale = s end
	local _ = g
end

local function step()
	local g = gui
	if g == nil then return end
	local t = os.clock() - started
	-- creep to 15% on its own until the client counts its assets; then the count alone moves it (never backwards)
	local creep = if counted then 0 else CREEP * (1 - math.exp(-t / 4))
	if hiding then
		-- the rest of the line fills evenly by the end of the hold (smoothstep), so a fast load still reads as a load
		local k = math.clamp((os.clock() - hideAt) / hold, 0, 1)
		shown = hideFrom + (1 - hideFrom) * k * k * (3 - 2 * k)
	else
		-- paced: never ahead of the MIN_SHOW clock, so a fast load climbs evenly instead of jumping to 95% and waiting
		local pace = LOADED * math.min(1, t / MIN_SHOW)
		shown += (math.max(shown, math.min(math.max(target, creep), pace)) - shown) * math.min(1, 0.12)
	end
	if parts.fill then parts.fill.Size = UDim2.fromScale(shown, 1) end
	if parts.pct then parts.pct.Text = string.format("%d%%", math.floor(shown * 100 + 0.5)) end
	-- the emblem: the outer square turns, the core breathes
	if parts.outer then parts.outer.Rotation = (t * 18) % 360 end
	if parts.core then
		local b = 0.5 + 0.5 * math.sin(t * 2.4)
		parts.core.Size = UDim2.fromOffset(24 + 6 * b, 24 + 6 * b)
		parts.core.BackgroundTransparency = 0.15 * (1 - b)
	end
	if parts.tip then
		local i = math.floor(t / 4.5) % #TIPS + 1
		local tip = TIPS[i]
		if parts.tip.Text ~= tip then parts.tip.Text = tip end
	end
end

function BootScreen.visible(): boolean
	return gui ~= nil and not hiding
end
-- the game's overlay took over (it drives the screen from now on)
function BootScreen.claim()
	claimed = true
end
function BootScreen.claimed(): boolean
	return claimed
end

function BootScreen.show()
	if gui then return end
	local lp = Players.LocalPlayer
	if lp == nil then return end
	local pg = lp:FindFirstChildOfClass("PlayerGui") or lp:WaitForChild("PlayerGui", 10)
	if pg == nil then return end
	local existing = pg:FindFirstChild("MilestoneBoot")
	if existing then existing:Destroy() end
	started = os.clock()
	shown, target, hiding, counted = 0, 0, false, false
	local g = build()
	g.Parent = pg
	gui = g
	layout(g)
	local cam = workspace.CurrentCamera
	if cam then cam:GetPropertyChangedSignal("ViewportSize"):Connect(function() if gui then layout(gui) end end) end
	conn = RunService.Heartbeat:Connect(step)
end

-- a status string, or { done, total } for the progress (the asset preload's count)
function BootScreen.set(data: any)
	if gui == nil or hiding then return end
	if type(data) == "string" then
		status = string.gsub(data, "[%.…]+$", "")
		if parts.status then parts.status.Text = caps(status) end
	elseif type(data) == "table" and type(data.done) == "number" and type(data.total) == "number" then
		local p = if data.total > 0 then math.clamp(data.done / data.total, 0, 1) else 1
		counted = true
		target = math.max(target, LOADED * p)
	end
end

function BootScreen.hide()
	local g = gui
	if g == nil or hiding then return end
	hiding = true
	target = 1
	hideAt, hideFrom = os.clock(), shown
	hold = math.max(0.25, MIN_SHOW - (hideAt - started))
	status = "Entering the tree"
	if parts.status then parts.status.Text = caps(status) end
	task.delay(hold, function()
		local info = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		for _, d in g:GetDescendants() do
			if d:IsA("Frame") and d.BackgroundTransparency < 1 then
				TweenService:Create(d, info, { BackgroundTransparency = 1 }):Play()
			elseif d:IsA("TextLabel") then
				TweenService:Create(d, info, { TextTransparency = 1 }):Play()
			elseif d:IsA("UIStroke") then
				TweenService:Create(d, info, { Transparency = 1 }):Play()
			end
		end
		task.delay(0.4, function()
			if conn then
				conn:Disconnect()
				conn = nil
			end
			g:Destroy()
			if gui == g then gui = nil end
		end)
	end)
end

return BootScreen
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="6">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="7">
      <Properties>
        <string name="Name">MilestoneTree</string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Assets</string>
          <string name="Source"><![CDATA[--!strict
-- GENERATED by art/roblox/upload.js from art/roblox/manifest.json + art/roblox/uploaded.json. Do not edit by hand:
--   cd art && node roblox/tile.js && node roblox/upload.js [--dry-run]
-- The realm parallax textures (art/REALM.md section 3). Each layer is a grid of tiles in layer-local px (x, y, w, h);
-- the image holds the tile plus a `gutter` px border, so ImageRectOffset = (gutter, gutter) and ImageRectSize = (rw, rh).
-- id = nil means that image is not uploaded yet: skip the tile (the layers behind show through) or fall back to
-- the other tier. Fully transparent tiles are left out. Sprite regions are HIGH atlas px; the LOW atlas is half size.
-- Place tiles by the snapped recipe of art/REALM.md 9.3: the column / row edges (x, x + w; y, y + h) rounded to whole
-- device pixels, each edge shared by the two neighbours. No overlap: a tile drawn wider blends its edge strip twice.

export type Tile = { i: number, j: number, x: number, y: number, w: number, h: number, rw: number, rh: number, id: string? }
export type Layer = { depth: number, f: number, w: number, h: number, scale: number, cols: number, rows: number, opaque: boolean, zHide: number, zShow: number, tiles: { Tile } }
export type Tier = { layers: { [string]: Layer }, order: { string }, atlas: { id: string?, w: number, h: number } }
export type Assets = { version: string, complete: boolean, uploaded: number, total: number, gutter: number, tiers: { HIGH: Tier, LOW: Tier }, sprites: { atlas: { HIGH: string?, LOW: string? }, size: { HIGH: { number }, LOW: { number } }, regions: { [string]: { number } }, sample: { [string]: { number } } } }

local Assets: Assets = {
	version = "7e2e0975ef46",
	complete = true,
	uploaded = 64,
	total = 64,
	gutter = 2,
	tiers = {
		HIGH = {
			layers = {
				sky = { depth = 0, f = 0.05, w = 2784, h = 1616, scale = 0.625, cols = 2, rows = 1, opaque = true, zHide = 0, zShow = 0, tiles = {
					{ i = 0, j = 0, x = 0, y = 0, w = 1392, h = 1616, rw = 870, rh = 1010, id = "rbxassetid://96132035924004" },
					{ i = 1, j = 0, x = 1392, y = 0, w = 1392, h = 1616, rw = 870, rh = 1010, id = "rbxassetid://75872250280491" },
				} },
				clouds = { depth = 1, f = 0.12, w = 3040, h = 1840, scale = 0.375, cols = 2, rows = 1, opaque = false, zHide = 0, zShow = 0, tiles = {
					{ i = 0, j = 0, x = 0, y = 0, w = 1520, h = 1840, rw = 570, rh = 690, id = "rbxassetid://70439967440926" },
					{ i = 1, j = 0, x = 1520, y = 0, w = 1520, h = 1840, rw = 570, rh = 690, id = "rbxassetid://106017688034160" },
				} },
				far = { depth = 2, f = 0.25, w = 3552, h = 2272, scale = 0.5, cols = 2, rows = 2, opaque = false, zHide = 0, zShow = 0, tiles = {
					{ i = 0, j = 0, x = 0, y = 0, w = 1776, h = 1136, rw = 888, rh = 568, id = "rbxassetid://100908535342428" },
					{ i = 1, j = 0, x = 1776, y = 0, w = 1776, h = 1136, rw = 888, rh = 568, id = "rbxassetid://96559078177114" },
					{ i = 0, j = 1, x = 0, y = 1136, w = 1776, h = 1136, rw = 888, rh = 568, id = "rbxassetid://113528897482450" },
					{ i = 1, j = 1, x = 1776, y = 1136, w = 1776, h = 1136, rw = 888, rh = 568, id = "rbxassetid://138155396539641" },
				} },
				mid = { depth = 3, f = 0.45, w = 4352, h = 2928, scale = 0.75, cols = 4, rows = 3, opaque = false, zHide = 0, zShow = 0, tiles = {
					{ i = 0, j = 0, x = 0, y = 0, w = 1088, h = 976, rw = 816, rh = 732, id = "rbxassetid://85792634806924" },
					{ i = 1, j = 0, x = 1088, y = 0, w = 1088, h = 976, rw = 816, rh = 732, id = "rbxassetid://117431302284336" },
					{ i = 2, j = 0, x = 2176, y = 0, w = 1088, h = 976, rw = 816, rh = 732, id = "rbxassetid://89163236153024" },
					{ i = 3, j = 0, x = 3264, y = 0, w = 1088, h = 976, rw = 816, rh = 732, id = "rbxassetid://133417146514539" },
					{ i = 0, j = 1, x = 0, y = 976, w = 1088, h = 976, rw = 816, rh = 732, id = "rbxassetid://71475368570441" },
					{ i = 1, j = 1, x = 1088, y = 976, w = 1088, h = 976, rw = 816, rh = 732, id = "rbxassetid://130340050944025" },
					{ i = 2, j = 1, x = 2176, y = 976, w = 1088, h = 976, rw = 816, rh = 732, id = "rbxassetid://135414485603581" },
					{ i = 3, j = 1, x = 3264, y = 976, w = 1088, h = 976, rw = 816, rh = 732, id = "rbxassetid://77708698922622" },
					{ i = 0, j = 2, x = 0, y = 1952, w = 1088, h = 976, rw = 816, rh = 732, id = "rbxassetid://129142843937608" },
					{ i = 1, j = 2, x = 1088, y = 1952, w = 1088, h = 976, rw = 816, rh = 732, id = "rbxassetid://139835071451547" },
					{ i = 2, j = 2, x = 2176, y = 1952, w = 1088, h = 976, rw = 816, rh = 732, id = "rbxassetid://130503279501890" },
					{ i = 3, j = 2, x = 3264, y = 1952, w = 1088, h = 976, rw = 816, rh = 732, id = "rbxassetid://75476646110258" },
				} },
				near = { depth = 4, f = 0.7, w = 5440, h = 3920, scale = 0.45, cols = 4, rows = 2, opaque = false, zHide = 0, zShow = 0, tiles = {
					{ i = 0, j = 0, x = 0, y = 0, w = 1360, h = 1960, rw = 612, rh = 882, id = "rbxassetid://119765970761181" },
					{ i = 1, j = 0, x = 1360, y = 0, w = 1360, h = 1960, rw = 612, rh = 882, id = "rbxassetid://126309339663220" },
					{ i = 2, j = 0, x = 2720, y = 0, w = 1360, h = 1960, rw = 612, rh = 882, id = "rbxassetid://79532038301416" },
