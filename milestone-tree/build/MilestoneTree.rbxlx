		end)
		if not __ok2 then
			local e = __e3
			n = rbx_err(nil, rbx_str(nil, name), e)
		end
	end
	if (not JS.t(n)) then
		do return JS.NULL end
	end
	st = rbx_css(nil, JS.A(2, tmp[JS.k(layer)].componentStyles[JS.k(name)], style))
	if JS.t(JS.len(Object.keys(st))) then
		JS.setk(n, "cst", st)
	end
	do return n end
end
