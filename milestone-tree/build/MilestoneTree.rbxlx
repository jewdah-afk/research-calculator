	description = "Hyper Boost Upgrade 12 is boosted.",
	cost = JS.D(40)
}, {"title", "description", "cost"}),
	[24] = JS.O({
	title = "Hyper Boost Upgrade 24",
	description = "Hyper Boost Upgrade 12 is boosted.",
	cost = JS.D(42)
}, {"title", "description", "cost"}),
	[31] = JS.O({
