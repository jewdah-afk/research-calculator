fixData = function(this, defaultData, newData)
	for _, __k10 in JS.keys(defaultData) do
		item = __k10
		if JS.isnil(defaultData[item]) then
			if (newData[item] == nil) then
				JS.set(newData, item, JS.NULL)
			end
