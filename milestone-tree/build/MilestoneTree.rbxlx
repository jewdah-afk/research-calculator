		hp = { 292, 146, 146, 146 },
		hp_locked = { 292, 584, 146, 146 },
		ep = { 438, 146, 146, 146 },
		ep_locked = { 438, 584, 146, 146 },
		hb = { 584, 146, 146, 146 },
		hb_locked = { 584, 584, 146, 146 },
		ap = { 730, 146, 146, 146 },
		ap_locked = { 730, 584, 146, 146 },
		mp = { 876, 146, 146, 146 },
		mp_locked = { 876, 584, 146, 146 },
		t = { 0, 292, 146, 146 },
		t_locked = { 0, 730, 146, 146 },
