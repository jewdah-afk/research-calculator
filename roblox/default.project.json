{
  "name": "Peckwood",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Peckwood": { "$path": "src/shared" },
      "TreeAssets": { "$path": "assets/TreeAssets.rbxm" }
    },
    "ServerScriptService": {
      "Peckwood": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": { "CameraMaxZoomDistance": 2000, "DevComputerMovementMode": "KeyboardMouse" },
      "StarterPlayerScripts": {
        "Peckwood": { "$path": "src/client" }
      },
      "StarterCharacterScripts": {
        "Animate": { "$className": "LocalScript", "$properties": { "Source": "-- bird rig: hop/tilt is driven by Peckwood client (Visual motor); default R15 Animate disabled\n" } }
      }
    },
    "Workspace": {
      "$properties": { "FilteringEnabled": true, "StreamingEnabled": false, "Gravity": 196.2 },
      "Terrain": { "$properties": { "Decoration": true } }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future", "GlobalShadows": true, "ShadowSoftness": 0.18, "ClockTime": 17.1, "GeographicLatitude": 38,
        "Brightness": 3.4, "ColorShift_Top": [1, 0.86, 0.66], "ColorShift_Bottom": [0.42, 0.5, 0.72],
        "EnvironmentDiffuseScale": 0.45, "EnvironmentSpecularScale": 0.2, "Ambient": [0.24, 0.27, 0.36],
        "OutdoorAmbient": [0.38, 0.44, 0.62], "ExposureCompensation": 0.05, "FogColor": [0.55, 0.62, 0.78], "FogStart": 520, "FogEnd": 1500
      },
      "Sky": { "$className": "Sky", "$properties": { "CelestialBodiesShown": false, "StarCount": 0 } },
      "ColorCorrection": { "$className": "ColorCorrectionEffect", "$properties": { "Saturation": 0.06, "Contrast": 0.16, "Brightness": -0.02, "TintColor": [1, 0.92, 0.8] } },
      "Bloom": { "$className": "BloomEffect", "$properties": { "Intensity": 0.3, "Size": 28, "Threshold": 1.6 } },
      "SunRays": { "$className": "SunRaysEffect", "$properties": { "Intensity": 0.05, "Spread": 0.6 } }
    }
  }
}
