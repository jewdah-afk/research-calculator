-- the egg yard (owner 2026-10-09: "a fenced in area where your eggs spawn"): the meadow inside the ring path,
-- found by flood fill from the centre over grass tiles (the path ring stops it). Eggs only spawn here; the client
-- fences its outline.
local yard: { [number]: boolean }? = nil
function M.inYard(i: number, j: number): boolean
	if not yard then
		local y: { [number]: boolean } = {}
		local q = { { 20, 15 } }
		y[20 * 100 + 15] = true
		local head = 1
		while head <= #q do
			local c = q[head]; head += 1
			for _, o in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
				local ni, nj = c[1] + o[1], c[2] + o[2]
				local r = M.rows[nj + 1]
				local t = if r then tonumber(string.sub(r, ni + 1, ni + 1)) else 0
				if t == 1 and not y[ni * 100 + nj] then y[ni * 100 + nj] = true; table.insert(q, { ni, nj }) end
			end
		end
		yard = y
	end
	return (yard :: any)[i * 100 + j] == true
end
function M.height(i: number, j: number): number return M.H[i .. "," .. j] or 0 end
