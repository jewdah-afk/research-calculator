--!nonstrict
-- World: every island on one world tile grid (approved concept rc-main/concepts/islands.html), plus brick bridges
-- between EVERY pair of side-by-side islands (QoL: no running back through the chain).
--   * world tile (i, j): the Park keeps its MapData coords (0..39, 0..29); island g at grid (gx, gz) is centred on
--     (20 + gx*DX, 15 + gz*DZ). World studs = (i - 20) * S, so Island.toWorld / Controller.toWorld stay valid.
--   * tile codes: 0 void, 1 grass, 2 path, 3 water, 4 alt top (sand/stone/tilled/rock), 5 bridge deck
--   * an island only exists while it is unlocked (World.setOpen(state.island)); a bridge needs both ends open
local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("Peckwood")
local Map = require(Shared:WaitForChild("MapData"))
local Defs = require(Shared:WaitForChild("Defs"))
local Data = require(Shared:WaitForChild("IslandData"))
local Isle = require(Shared:WaitForChild("IsleData"))
local Ascent = require(Shared:WaitForChild("AscentData"))

local World = {}
-- "isle" = the World Guide's Peckwood Isle (one big generated island, areas placed on it, owner 2026-10-09);
-- "grid" = the older 3x3 grid of islands joined by generated land
-- "ascent" = Peckwood Ascent (owner 2026-10-09): the Park in a valley, the areas on rising terraces around the rim,
-- the Echo Field on the summit (generated by tools/ascent_gen.py; World.base gives each tile's terrace height)
World.LAYOUT = "ascent"
local ASCENT = World.LAYOUT == "ascent"
local ISLE = World.LAYOUT ~= "grid"
if ASCENT then Isle = Ascent end
local DX, DZ = 44, 34
local PCX, PCY = Map.COLS / 2, Map.ROWS / 2
World.DX, World.DZ = DX, DZ

local function needOf(id)
	for k, d in Defs.ISLANDS do if d.id == id then return k end end
	return 99
end

-- ---------------------------------------------------------------- islands
local ORDER = { "park", "garden", "castle", "bridge", "forest", "mine", "desert", "expedition", "echo" }
World.list, World.byId = {}, {}
for _, id in ORDER do
	local isl
	if id == "park" then
		isl = { id = "park", name = "THE PARK", gx = 0, gz = 0, W = Map.COLS, N = Map.ROWS, oi = 0, oj = 0, need = 1, park = true, props = {} }
		local codes = {}
		for j = 0, Map.ROWS - 1 do codes[j] = {}; for i = 0, Map.COLS - 1 do codes[j][i] = Map.tile(i, j) end end
		isl.codes = codes
		isl.H = function(i, j) return Map.height(i, j) end
		for _, o in Map.objects do table.insert(isl.props, { kind = o[1], x = o[2] / Map.PX, z = o[3] / Map.PX, park = true }) end
	else
		local d = Data[id]
		isl = { id = id, name = d.name, gx = d.gx, gz = d.gz, W = d.W, N = d.N, need = needOf(id), data = d, props = {} }
		isl.oi = PCX + d.gx * DX - math.floor(d.W / 2)
		isl.oj = PCY + d.gz * DZ - math.floor(d.N / 2)
		if ASCENT and Ascent.cores[id] then isl.oi, isl.oj, isl.base = Ascent.cores[id][1], Ascent.cores[id][2], Ascent.cores[id][3]
		elseif ISLE and Isle.off[id] then isl.oi += Isle.off[id][1]; isl.oj += Isle.off[id][2] end
		local codes, hs = {}, {}
		for j = 0, d.N - 1 do
			codes[j], hs[j] = {}, {}
			for i = 0, d.W - 1 do
				codes[j][i] = tonumber(string.sub(d.rows[j + 1], i + 1, i + 1))
				hs[j][i] = tonumber(string.sub(d.H[j + 1], i + 1, i + 1))
			end
		end
		isl.codes = codes
		isl.H = function(i, j) local r = hs[j - isl.oj]; return r and r[i - isl.oi] or 0 end
		for _, p in d.props do
			table.insert(isl.props, { kind = p[1], x = isl.oi + p[2], z = isl.oj + p[3], rot = p[4], bob = p[5], parts = p[6] })
		end
	end
	isl.cx, isl.cz = isl.oi + isl.W / 2, isl.oj + isl.N / 2
	table.insert(World.list, isl); World.byId[id] = isl
end

local function rawIsland(isl, i, j)
	local r = isl.codes[j - isl.oj]
	return r and r[i - isl.oi] or 0
end
local owner = {}   -- tile key -> island (land tiles only)
local function key(i, j) return (j + 500) * 2000 + i + 500 end
for _, isl in World.list do
	for j = isl.oj, isl.oj + isl.N - 1 do
		for i = isl.oi, isl.oi + isl.W - 1 do
			if rawIsland(isl, i, j) ~= 0 then
				if owner[key(i, j)] then warn("[World] overlap at " .. i .. "," .. j) end
				owner[key(i, j)] = isl
			end
		end
	end
end
function World.islandOfTile(i, j) return owner[key(i, j)] end
-- islands + land joins (joins are filled in further down)
function World.all()
	local out = table.clone(World.list)
	for _, j in World.joins or {} do table.insert(out, j) end
	return out
end

-- ---------------------------------------------------------------- props that block (footprint radius in tiles)
local WALK_PROPS = { rails = true, tilledrow = true, flowers = true, bones = true, twigs = true, pier = true, footbridge = true, log = true, vine = true }
for _, isl in World.list do
	for _, p in isl.props do
		if isl.park then p.r = if p.kind == "arch" then 0 else 0.8
		elseif WALK_PROPS[p.kind] then p.r = 0
		else
			local mnx, mxx, mnz, mxz = math.huge, -math.huge, math.huge, -math.huge
			local c, s = math.cos(p.rot or 0), math.sin(p.rot or 0)
			for _, q in p.parts do
				if q[6] - q[3] / 2 < 0.9 and q[13] == 0 then   -- parts touching the ground
					local x, z = q[5] * c + q[7] * s, -q[5] * s + q[7] * c
					mnx = math.min(mnx, x - q[2] / 2); mxx = math.max(mxx, x + q[2] / 2)
					mnz = math.min(mnz, z - q[4] / 2); mxz = math.max(mxz, z + q[4] / 2)
				end
			end
			p.r = if mnx == math.huge then 0 else math.clamp(math.min(mxx - mnx, mxz - mnz) / 2, 0.15, 2.6)
			if mnx ~= math.huge then p.box = { p.x + mnx, p.x + mxx, p.z + mnz, p.z + mxz } end
		end
	end
	-- small props scattered onto a bigger one (a cactus on the pyramid, a bush in the keep) are removed
	local list = {}
	for _, p in isl.props do if p.box then table.insert(list, p) end end
	table.sort(list, function(a, b) return (a.box[2] - a.box[1]) * (a.box[4] - a.box[3]) > (b.box[2] - b.box[1]) * (b.box[4] - b.box[3]) end)
	for k, big in list do
		if big.dropped then continue end
		for q = k + 1, #list do
			local sm = list[q]
			if sm.dropped then continue end
			local b, c = big.box, sm.box
			if c[2] > b[1] + 0.15 and c[1] < b[2] - 0.15 and c[4] > b[3] + 0.15 and c[3] < b[4] - 0.15 then sm.dropped = true end
		end
	end
end
-- inside a prop's ground footprint (+ margin, tiles)
function World.inProp(x, z, margin)
	for _, isl in World.all() do
		for _, p in isl.props do
			local b = p.box
			if b and not p.dropped and x > b[1] - margin and x < b[2] + margin and z > b[3] - margin and z < b[4] + margin then return p end
		end
	end
	return nil
end
local function propNear(x, z, rad)
	for _, isl in World.all() do
		for _, p in isl.props do
			if not p.dropped and (p.x - x) ^ 2 + (p.z - z) ^ 2 < (rad + (p.r or 0.8)) ^ 2 and (p.r or 0) > 0 then return true end
		end
	end
	return false
end

-- ---------------------------------------------------------------- bridges between grid neighbours
World.bridges = {}
local function walk(isl, i, j)
	local c = rawIsland(isl, i, j)
	return (c == 1 or c == 2 or c == 4) and isl.H(i, j) == 0
end
local function makeBridge(a, b)
	-- axis: X when side by side, Z when stacked. u runs from a to b, v across the lane.
	local alongX = a.gz == b.gz
	local function T(u, v) if alongX then return u, v else return v, u end end
	local lo, hi
	if alongX then lo, hi = math.max(a.oj, b.oj) + 2, math.min(a.oj + a.N, b.oj + b.N) - 4
	else lo, hi = math.max(a.oi, b.oi) + 2, math.min(a.oi + a.W, b.oi + b.W) - 4 end
	local mid = math.floor(((if alongX then a.cz + b.cz else a.cx + b.cx) / 2)) - 1   -- lane v0..v0+1 straddles the midline
	local dir = if (alongX and b.gx > a.gx) or (not alongX and b.gz > a.gz) then 1 else -1
	-- score every lane: water / hills at a landing are fatal, a Park prop in the way is fatal (approved layout),
	-- an island prop in the way costs a little (it gets cleared), and distance from the middle breaks ties
	local best, bestScore
	for o = 0, 16 do
		for _, sgn in { 1, -1 } do
			local v0 = mid + o * sgn
			if v0 < lo or v0 > hi or (o == 0 and sgn < 0) then continue end
			local score, ea, sb = o * 0.5, nil, nil
			for v = v0, v0 + 1 do
				local u = math.floor(if alongX then a.cx else a.cz)
				local last
				for _ = 1, 40 do local i, j = T(u, v); if rawIsland(a, i, j) ~= 0 then last = u end; u += dir end
				local u2 = math.floor(if alongX then b.cx else b.cz)
				local first
				for _ = 1, 40 do local i, j = T(u2, v); if rawIsland(b, i, j) ~= 0 then first = u2 end; u2 -= dir end
				if not last or not first then score = math.huge; break end
				for k = 0, 2 do
					for _, side in { { a, last - k * dir }, { b, first + k * dir } } do
						local i, j = T(side[2], v)
						if not walk(side[1], i, j) then score += (if k < 2 then 1000 else 20) end
						for _, p in side[1].props do
							if (p.r or 0) > 0 and (p.x - i - 0.5) ^ 2 + (p.z - j - 0.5) ^ 2 < (p.r + 0.7) ^ 2 then score += if p.park then 1000 else 3 end
						end
					end
				end
				ea = if ea then (if dir > 0 then math.max(ea, last) else math.min(ea, last)) else last
				sb = if sb then (if dir > 0 then math.min(sb, first) else math.max(sb, first)) else first
			end
			if score < 1000 and (not bestScore or score < bestScore) then best, bestScore = { v0 = v0, ea = ea, sb = sb }, score end
		end
	end
	if not best then warn("[World] no bridge lane " .. a.id .. " -> " .. b.id); return end
	local br = { a = a, b = b, alongX = alongX, dir = dir, v0 = best.v0, tiles = {} }
	-- deck tiles (only over void), ordered from a to b; the path stripes 3 tiles inland on both sides
	local u = best.ea + dir
	while u ~= best.sb do
		for v = best.v0, best.v0 + 1 do
			local i, j = T(u, v)
			if not World.islandOfTile(i, j) then
				table.insert(br.tiles, { i = i, j = j, u = math.abs(u - best.ea) })
			end
		end
		u += dir
	end
	br.len = math.abs(best.sb - best.ea) - 1
	br.lo, br.hi = lo, hi
	br.landA = { T(best.ea, best.v0) }; br.landB = { T(best.sb, best.v0) }
	-- walk targets (game px) on the lane centre, one tile inland on each side
	do
		local ax, ay = T(best.ea - dir + 0.5, best.v0 + 1)
		local bx, by = T(best.sb + dir + 0.5, best.v0 + 1)
		br.pa = { ax * 16, ay * 16 }; br.pb = { bx * 16, by * 16 }
	end
	br.stripe = {}
	for k = 0, 2 do
		for v = best.v0, best.v0 + 1 do
			for _, side in { { a, best.ea - k * dir }, { b, best.sb + k * dir } } do
				local i, j = T(side[2], v)
				local isl = side[1]
				table.insert(br.stripe, { i, j })
				if rawIsland(isl, i, j) == 1 or rawIsland(isl, i, j) == 4 then isl.codes[j - isl.oj][i - isl.oi] = 2 end
			end
		end
	end
	table.insert(World.bridges, br)
	return br
end
for _, a in (if ISLE then {} else World.list) do
	for _, b in World.list do
		if (b.gx == a.gx + 1 and b.gz == a.gz) or (b.gz == a.gz + 1 and b.gx == a.gx) then
			-- build from the earlier-unlocked island towards the later one
			if a.need <= b.need then makeBridge(a, b) else makeBridge(b, a) end
		end
	end
end
-- island props standing on a landing stripe are cleared (the Park keeps its approved props; lanes avoid them)
for _, br in World.bridges do
	for _, isl in { br.a, br.b } do
		if isl.park then continue end
		for _, p in isl.props do
			if (p.r or 0) <= 0 then continue end
			for _, t in br.stripe do
				if (p.x - t[1] - 0.5) ^ 2 + (p.z - t[2] - 0.5) ^ 2 < (p.r + 0.7) ^ 2 then p.dropped = true end
			end
		end
	end
end

-- ---------------------------------------------------------------- land joins (owner 2026-10-07: no bridges)
-- Every pair of neighbouring islands is joined by generated land instead of a rope bridge, so the open islands
-- read as ONE growing landmass rising out of the sea. A join fills the sea between the two facing coasts across
-- most of their shared width (ragged coastline), keeps the old bridge lane as a 2-wide path, and builds hierarchy
-- away from the path: grass flats -> hills -> rock mountains with snow caps, plus a few ponds and trees.
-- Colours blend from island a's palette to island b's along the join. A join opens when both islands are open.
World.joins = {}
local function noise(x, z)   -- smooth value noise, 0..1
	local xi, zi = math.floor(x), math.floor(z)
	local xf, zf = x - xi, z - zi
	local function h(a, b) local n = math.sin(a * 127.1 + b * 311.7) * 43758.5453; return n - math.floor(n) end
	local u, v = xf * xf * (3 - 2 * xf), zf * zf * (3 - 2 * zf)
	local a0 = h(xi, zi) + (h(xi + 1, zi) - h(xi, zi)) * u
	local a1 = h(xi, zi + 1) + (h(xi + 1, zi + 1) - h(xi, zi + 1)) * u
	return a0 + (a1 - a0) * v
end
local function fbm(x, z) return noise(x / 7, z / 7) * 0.6 + noise(x / 3.2 + 9, z / 3.2 + 4) * 0.3 + noise(x / 1.6 + 2, z / 1.6 + 7) * 0.1 end
-- prop templates borrowed from the islands' own concept props (same brick parts), by kind
local TEMPLATE_KINDS = { tree = true, pine = true, bush = true, rock = true, flowers = true, palm = true, cactus = true, mushroom = true, crystal = true }
local function templatesOf(isl)
	local out = {}
	for _, p in isl.props do if TEMPLATE_KINDS[p.kind] and p.parts and not out[p.kind] then out[p.kind] = p end end
	return out
end
local anyTemplates = {}
for _, isl in World.list do for k, p in templatesOf(isl) do anyTemplates[k] = anyTemplates[k] or p end end
local function makeJoin(br)
	local a, b, alongX, dir = br.a, br.b, br.alongX, br.dir
	local function T(u, v) if alongX then return u, v else return v, u end end
	local function U(isl) if alongX then return isl.oi, isl.oi + isl.W - 1 else return isl.oj, isl.oj + isl.N - 1 end end
	local function V(isl) if alongX then return isl.oj, isl.oj + isl.N - 1 else return isl.oi, isl.oi + isl.W - 1 end end
	local au0, au1 = U(a); local bu0, bu1 = U(b)
	local aEdge, bEdge = if dir > 0 then au1 else au0, if dir > 0 then bu0 else bu1
	local av0, av1 = V(a); local bv0, bv1 = V(b)
	local vlo, vhi = math.max(av0, bv0), math.min(av1, bv1)
	local laneMid = br.v0 + 0.5
	local uFrom, uTo = aEdge - 7 * dir, bEdge + 7 * dir
	local span = math.abs(uTo - uFrom)
	local j = { id = "join:" .. a.id .. ":" .. b.id, join = true, a = a, b = b, br = br, need = math.max(a.need, b.need),
		name = a.name, props = {}, cells = {} }
	local cells = {}   -- key -> cell
	local u = uFrom
	while true do
		local f = math.abs(u - uFrom) / span                        -- 0 at a, 1 at b
		local pinch = math.sin(f * math.pi) * (1.5 + noise(u * 0.35, 3) * 3)   -- waist in the middle (still wide)
		for v = vlo, vhi do
			local i, jj = T(u, v)
			if World.islandOfTile(i, jj) then continue end
			local m = 1.5 + pinch + noise(u * 0.45, v * 0.2) * 2.5    -- ragged coast
			local inLane = math.abs(v + 0.5 - laneMid) <= 3
			if inLane or (v >= vlo + m and v <= vhi - m) then
				cells[key(i, jj)] = { i = i, j = jj, u = u, v = v, f = f, code = 1, h = 0 }
			end
		end
		if u == uTo then break end
		u += dir
	end
	-- coast distance (land = join cells + island land), up to 6
	local function isLand(i, jj) return cells[key(i, jj)] ~= nil or World.islandOfTile(i, jj) ~= nil end
	for _, c in cells do
		local d = 6
		for r = 1, 5 do
			local hit = false
			for x = -r, r do
				for z = -r, r do
					if (math.abs(x) == r or math.abs(z) == r) and not isLand(c.i + x, c.j + z) then hit = true; break end
				end
				if hit then break end
			end
			if hit then d = r - 1; break end
		end
		c.cd = d
	end
	-- terrain hierarchy
	for _, c in cells do
		local dv = math.abs(c.v + 0.5 - laneMid)
		if dv <= 1 then c.code = 2
		elseif dv > 2.5 then
			local n = fbm(c.i, c.j)
			local ridge = math.clamp((dv - 2.5) / 4, 0, 1) * math.clamp((c.cd - 1) / 3, 0, 1)
			c.h = math.clamp(math.floor((n - 0.18) * ridge * 11), 0, 5)
			if c.h >= 2 then c.code = 4 end
			if c.h == 0 and dv >= 4 and c.cd >= 2 and noise(c.i * 0.5 + 40, c.j * 0.5) < 0.16 then c.code = 3 end
		end
	end
	-- the lane joins the island landing stripes: the first / last lane cells are path too (already 2)
	local mn, mx = Vector2.new(math.huge, math.huge), Vector2.new(-math.huge, -math.huge)
	for _, c in cells do mn = mn:Min(Vector2.new(c.i, c.j)); mx = mx:Max(Vector2.new(c.i, c.j)) end
	j.oi, j.oj, j.W, j.N = mn.X, mn.Y, mx.X - mn.X + 1, mx.Y - mn.Y + 1
	j.cx, j.cz = j.oi + j.W / 2, j.oj + j.N / 2
	j.cells = cells
	j.codes = setmetatable({}, { __index = function(t, row)   -- codes[j - oj][i - oi], like an island
		local r = setmetatable({}, { __index = function(_, col) local c = cells[key(col + j.oi, row + j.oj)]; return c and c.code or 0 end })
		t[row] = r
		return r
	end })
	j.H = function(i, jj) local c = cells[key(i, jj)]; return if c and (c.code == 1 or c.code == 4) then c.h else 0 end
	-- palette: lerp a -> b along the join; mountains go rock grey, high peaks snow
	local da, db = a.data or { grass = { "8cc06a", "84b863" }, path = { "d9bf91", "cfb487" }, alt = { "8d8478", "7f776c" } }, b.data
	j.data = { grass = da.grass, path = da.path, alt = da.alt, spills = {} }
	function j.blend(i, jj, code, alt2)
		local c = cells[key(i, jj)]
		local f = if c then math.clamp((c.f - 0.15) / 0.7, 0, 1) else 0
		f = f * f * (3 - 2 * f)
		local idx = (i + jj) % 2 + 1
		local function mixHex(x, y) return Color3.fromHex(x):Lerp(Color3.fromHex(y), f) end
		if code == 2 then return mixHex(da.path[idx], db.path[idx]) end
		if code == 4 then
			if c and c.h >= 4 and not alt2 then return Color3.fromHex(if idx == 1 then "f4f7fb" else "e6ecf4") end   -- snow cap (top plate only; alt2 = cliff side)
			local rock = mixHex(da.alt[idx], db.alt[idx]):Lerp(Color3.fromHex(if idx == 1 then "8d8478" else "7f776c"), 0.55)
			return rock
		end
		return mixHex(da.grass[idx], db.grass[idx])
	end
	-- trees / bushes / rocks on the flats, never on the lane, thicker near the mountains
	local ta, tb = templatesOf(a), templatesOf(b)
	local function pick(f, n)
		local t = if f < 0.5 then ta else tb
		local order = if n < 0.45 then { "pine", "tree", "palm", "cactus" } elseif n < 0.7 then { "tree", "pine", "bush" } elseif n < 0.85 then { "bush", "flowers" } else { "rock", "mushroom", "crystal" }
		for _, k in order do if t[k] then return t[k] end end
		for _, k in order do if anyTemplates[k] then return anyTemplates[k] end end
		return nil
	end
	for _, c in cells do
		if c.code ~= 1 or c.h ~= 0 or c.cd < 1 then continue end
		local dv = math.abs(c.v + 0.5 - laneMid)
		if dv < 3 then continue end
		local hsh = noise(c.i * 3.1 + 0.5, c.j * 2.7 + 0.5)
		if hsh > 0.27 then continue end
		local tpl = pick(c.f, noise(c.i * 0.8, c.j * 0.8 + 20))
		if not tpl then continue end
		local p = { kind = tpl.kind, x = c.i + 0.5, z = c.j + 0.5, rot = hsh * 40, bob = tpl.bob, parts = tpl.parts, r = 0.6, join = true }
		if tpl.kind ~= "flowers" then p.box = { c.i + 0.1, c.i + 0.9, c.j + 0.1, c.j + 0.9 } else p.r = 0 end
		table.insert(j.props, p)
	end
	for k in cells do owner[k] = j end
	br.join = j
	World.byId[j.id] = j
	table.insert(World.joins, j)
end
for _, br in World.bridges do makeJoin(br) end

-- ---------------------------------------------------------------- highlands: the gap inside every 2x2 block of islands
-- Once all four islands around a gap are open (and so their four joins), the inland sea between them fills in as a
-- mountain range: grass foothills where it meets the existing land, rock slopes, snow-capped peaks in the middle.
-- This is what turns the ring of joins into one solid landmass with a real height hierarchy.
local function makeHighland(q)
	local cells = {}
	local mnI, mxI = math.huge, -math.huge
	local mnJ, mxJ = math.huge, -math.huge
	for _, isl in q do
		mnI = math.min(mnI, isl.cx); mxI = math.max(mxI, isl.cx)
		mnJ = math.min(mnJ, isl.cz); mxJ = math.max(mxJ, isl.cz)
	end
	-- flood the void reachable from the block centre without leaving the box spanned by the four centres
	local ci, cj = math.floor((mnI + mxI) / 2), math.floor((mnJ + mxJ) / 2)
	if owner[key(ci, cj)] then return end
	local list, seen = {}, { [key(ci, cj)] = true }
	local fq, head = { { ci, cj } }, 1
	while head <= #fq do
		local c = fq[head]; head += 1
		table.insert(list, c)
		for _, o in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
			local ni, nj = c[1] + o[1], c[2] + o[2]
			local kk = key(ni, nj)
			if not seen[kk] and ni > mnI and ni < mxI and nj > mnJ and nj < mxJ and not owner[kk] then seen[kk] = true; table.insert(fq, { ni, nj }) end
		end
	end
	if #list == 0 then return end
	-- distance from the existing land (BFS inwards from the cells that touch it)
	local dist = {}
	local bq, bh = {}, 1
	for _, c in list do
		for _, o in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
			if owner[key(c[1] + o[1], c[2] + o[2])] then dist[key(c[1], c[2])] = 1; table.insert(bq, c); break end
		end
	end
	while bh <= #bq do
		local c = bq[bh]; bh += 1
		local d0 = dist[key(c[1], c[2])]
		for _, o in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
			local kk = key(c[1] + o[1], c[2] + o[2])
			if seen[kk] and not dist[kk] then dist[kk] = d0 + 1; table.insert(bq, { c[1] + o[1], c[2] + o[2] }) end
		end
	end
	local maxD = 1
	for _, d in dist do maxD = math.max(maxD, d) end
	local need = 0
	for _, isl in q do need = math.max(need, isl.need) end
	local h = { id = "highland:" .. q[1].id, join = true, highland = true, quad = q, need = need, name = q[1].name, props = {} }
	for _, c in list do
		local d = dist[key(c[1], c[2])] or maxD
		local r = d / maxD                                    -- 0 at the shore, 1 at the heart
		local n = fbm(c[1] * 1.3, c[2] * 1.3)
		local lift = math.clamp((d - 3) / math.max(1, maxD - 3), 0, 1)
		local ridge = 1 - math.abs(noise(c[1] * 0.28 + 11, c[2] * 0.28 + 5) * 2 - 1)   -- ridge lines -> separate summits
		local ht = math.clamp(math.floor(lift ^ 1.1 * 7.5 * (0.3 + 0.45 * n + 0.45 * ridge)), 0, 6)
		local code = if ht >= 2 then 4 else 1
		-- a few tarns in the foothills
		if ht == 0 and d >= 2 and noise(c[1] * 0.45 + 70, c[2] * 0.45) < 0.13 then code = 3 end
		cells[key(c[1], c[2])] = { i = c[1], j = c[2], f = 1 - r, code = code, h = ht, cd = d }
	end
	local mn, mx = Vector2.new(math.huge, math.huge), Vector2.new(-math.huge, -math.huge)
	for _, c in cells do mn = mn:Min(Vector2.new(c.i, c.j)); mx = mx:Max(Vector2.new(c.i, c.j)) end
	h.oi, h.oj, h.W, h.N = mn.X, mn.Y, mx.X - mn.X + 1, mx.Y - mn.Y + 1
	h.cx, h.cz = h.oi + h.W / 2, h.oj + h.N / 2
	h.cells = cells
	h.codes = setmetatable({}, { __index = function(t, row)
		local r = setmetatable({}, { __index = function(_, col) local c = cells[key(col + h.oi, row + h.oj)]; return c and c.code or 0 end })
		t[row] = r
		return r
	end })
	h.H = function(i, jj) local c = cells[key(i, jj)]; return if c and (c.code == 1 or c.code == 4) then c.h else 0 end
	-- colours: each quarter takes the palette of the island in that corner; rock + snow above
	local function nearestIsl(i, jj)
		local best, bd = q[1], math.huge
		for _, isl in q do local d = (isl.cx - i) ^ 2 + (isl.cz - jj) ^ 2; if d < bd then best, bd = isl, d end end
		return best.data or { grass = { "8cc06a", "84b863" }, path = { "d9bf91", "cfb487" }, alt = { "8d8478", "7f776c" } }
	end
	h.data = { grass = q[1].data and q[1].data.grass or { "8cc06a", "84b863" }, path = { "d9bf91", "cfb487" }, alt = { "8d8478", "7f776c" }, spills = {} }
	function h.blend(i, jj, code, side)
		local c = cells[key(i, jj)]
		local d = nearestIsl(i, jj)
		local idx = (i + jj) % 2 + 1
		if code == 4 then
			if c and c.h >= 5 and not side then return Color3.fromHex(if idx == 1 then "f4f7fb" else "e6ecf4") end
			return Color3.fromHex(d.alt[idx]):Lerp(Color3.fromHex(if idx == 1 then "8d8478" else "7f776c"), 0.6)
		end
		if code == 2 then return Color3.fromHex(d.path[idx]) end
		return Color3.fromHex(d.grass[idx])
	end
	-- pines on the slopes' feet, bushes and rocks on the foothills
	local tpl = {}
	for _, isl in q do for k, p in templatesOf(isl) do tpl[k] = tpl[k] or p end end
	for k, p in anyTemplates do tpl[k] = tpl[k] or p end
	for _, c in cells do
		if c.code ~= 1 or c.h ~= 0 then continue end
		local hsh = noise(c.i * 3.3 + 0.5, c.j * 2.9 + 0.5)
		if hsh > 0.3 then continue end
		local kind = if c.cd >= 3 then "pine" elseif hsh < 0.12 then "rock" else "bush"
		local t = tpl[kind] or tpl.tree
		if not t then continue end
		table.insert(h.props, { kind = t.kind, x = c.i + 0.5, z = c.j + 0.5, rot = hsh * 40, bob = t.bob, parts = t.parts, r = 0.6, join = true,
			box = { c.i + 0.1, c.i + 0.9, c.j + 0.1, c.j + 0.9 } })
	end
	for kk in cells do owner[kk] = h end
	World.byId[h.id] = h
	table.insert(World.joins, h)
end
if not ISLE then
	local at = {}
	for _, isl in World.list do at[isl.gx .. "," .. isl.gz] = isl end
	for _, isl in World.list do
		local q = { isl, at[(isl.gx + 1) .. "," .. isl.gz], at[isl.gx .. "," .. (isl.gz + 1)], at[(isl.gx + 1) .. "," .. (isl.gz + 1)] }
		if q[2] and q[3] and q[4] then makeHighland(q) end
	end
end

-- ---------------------------------------------------------------- Peckwood Isle regions
-- The generated land between the areas (grass, beaches, hills, rock and snow ranges, ponds, roads, trees) belongs
-- to the nearest area and rises out of the sea when that area unlocks, so the open areas grow into one island.
-- Tiles, heights and colours come straight from the World Guide generator (IsleData).
if ISLE then
	for _, isl in World.list do
		local src = Isle.regions[isl.id]
		if not src then continue end
		local cells = {}
		local mnI, mnJ, mxI, mxJ = math.huge, math.huge, -math.huge, -math.huge
		for rec in string.gmatch(src, "[^;]+") do
			local i, jj, code, h, top, side, base
			if ASCENT then
				i, jj, code, h, base = string.match(rec, "^(-?%d+),(-?%d+),(%d+),(%d+),(%d+)$")
			else
				i, jj, code, h, top, side = string.match(rec, "^(-?%d+),(-?%d+),(%d+),(%d+),(%x+),([%x%-]+)$")
			end
			i, jj = tonumber(i), tonumber(jj)
			if owner[key(i, jj)] then continue end   -- handmade land always wins
			local grass = isl.data and isl.data.grass or { "8cc06a", "84b863" }
			local c = { i = i, j = jj, code = tonumber(code), h = tonumber(h), base = tonumber(base) or 0,
				top = if top then Color3.fromHex(top) else Color3.fromHex(grass[(i + jj) % 2 + 1]),
				side = if side and side ~= "-" then Color3.fromHex(side) else nil }
			c.f = math.clamp(math.sqrt((i - isl.cx) ^ 2 + (jj - isl.cz) ^ 2) / 40, 0, 1)   -- rises outward from the area
			cells[key(i, jj)] = c
			mnI = math.min(mnI, i); mnJ = math.min(mnJ, jj); mxI = math.max(mxI, i); mxJ = math.max(mxJ, jj)
		end
		if mnI == math.huge then continue end
		local r = { id = "region:" .. isl.id, join = true, highland = true, area = isl.id, need = isl.need, name = isl.name,
			props = {}, cells = cells, oi = mnI, oj = mnJ, W = mxI - mnI + 1, N = mxJ - mnJ + 1 }
		r.cx, r.cz = r.oi + r.W / 2, r.oj + r.N / 2
		r.codes = setmetatable({}, { __index = function(t, row)
			local rr = setmetatable({}, { __index = function(_, col) local c = cells[key(col + r.oi, row + r.oj)]; return c and c.code or 0 end })
			t[row] = rr
			return rr
		end })
		r.H = function(i, jj) local c = cells[key(i, jj)]; return if c and (c.code == 1 or c.code == 4) then c.h else 0 end
		r.data = { grass = isl.data and isl.data.grass or { "8cc06a", "84b863" }, path = isl.data and isl.data.path or { "d9bf91", "cfb487" },
			alt = isl.data and isl.data.alt or { "8d8478", "7f776c" }, spills = {} }
		function r.blend(i, jj, code, side)
			local c = cells[key(i, jj)]
			if not c then return Color3.fromHex(r.data.grass[(i + jj) % 2 + 1]) end
			if side and c.side then return c.side end
			return c.top
		end
		for kk in cells do owner[kk] = r end
		World.byId[r.id] = r
		table.insert(World.joins, r)
	end
	-- trees, bushes, rocks: the guide's picks, built from each area's own prop bricks
	for rec in string.gmatch(Isle.props, "[^;]+") do
		local area, kind, x, z, rot = string.match(rec, "^(%w+),(%w+),([%d%.%-]+),([%d%.%-]+),([%d%.%-]+)$")
		local r, isl = World.byId["region:" .. area], World.byId[area]
		if not r or not isl then continue end
		local tpl = templatesOf(isl)[kind] or anyTemplates[kind]
		x, z = tonumber(x), tonumber(z)
		if not tpl or owner[key(math.floor(x), math.floor(z))] ~= r then continue end
		local p = { kind = tpl.kind, x = x, z = z, rot = tonumber(rot), bob = tpl.bob, parts = tpl.parts, r = 0.6, join = true }
		if tpl.kind ~= "flowers" then p.box = { x - 0.4, x + 0.4, z - 0.4, z + 0.4 } else p.r = 0 end
		table.insert(r.props, p)
	end
end

-- walkable decks on props (the Bridge island's footbridge over the river, the pier): every tile under a flat plank
-- becomes walkable at the plank's height (studs), so the bird climbs the hump instead of hitting the water
local decks = {}   -- key -> { isl, h }
local DECK_KINDS = { footbridge = true, pier = true }
for _, isl in World.list do
	if isl.park then continue end
	for _, p in isl.props do
		if not DECK_KINDS[p.kind] or p.dropped then continue end
		local i0, j0 = math.floor(p.x), math.floor(p.z)
		local c0 = rawIsland(isl, i0, j0)
		local base = if c0 == 3 then -0.2 elseif c0 == 2 then -0.4 else isl.H(i0, j0) * 2.4
		local c, s = math.cos(p.rot or 0), math.sin(p.rot or 0)
		for _, q in p.parts do
			if q[3] > 0.3 or (q[2] < 0.8 and q[4] < 0.8) then continue end   -- flat planks only
			local x, z = q[5] * c + q[7] * s, -q[5] * s + q[7] * c
			local hx = math.abs(q[2] / 2 * c) + math.abs(q[4] / 2 * s) + 0.08   -- planks have hairline gaps
			local hz = math.abs(q[2] / 2 * s) + math.abs(q[4] / 2 * c) + 0.08
			local top = base + (q[6] + q[3] / 2) * 4
			for j = math.floor(p.z + z - hz), math.floor(p.z + z + hz) do
				for i = math.floor(p.x + x - hx), math.floor(p.x + x + hx) do
					if math.abs(i + 0.5 - p.x - x) <= hx and math.abs(j + 0.5 - p.z - z) <= hz then
						local k = key(i, j)
						if not decks[k] or decks[k].h < top then decks[k] = { isl = isl, h = top } end
					end
				end
			end
		end
	end
end
function World.deckH(i, j)
	local d = decks[key(i, j)]
	if d then return d.h end
	return nil
end

-- ---------------------------------------------------------------- open state
World.open = 1
function World.setOpen(n) World.open = n end
function World.isOpen(isl) return World.open >= isl.need end
function World.bridgeOpen(br) return World.isOpen(br.a) and World.isOpen(br.b) end

-- raw (ignores unlocks) and live tile queries
function World.rawTile(i, j)
	local isl = World.islandOfTile(i, j)
	if isl then return rawIsland(isl, i, j), isl end
	return 0
end
function World.tile(i, j)
	local dk = decks[key(i, j)]
	if dk and World.isOpen(dk.isl) then return 5 end
	local isl = World.islandOfTile(i, j)
	if isl then return if World.isOpen(isl) then rawIsland(isl, i, j) else 0 end
	return 0
end
-- terrace height (studs) of a world tile: the Park and handmade cores carry their area's base, region tiles their own
function World.base(i, j)
	local isl = World.islandOfTile(i, j)
	if not isl then return 0 end
	if isl.cells then local c = isl.cells[key(i, j)]; return c and c.base or 0 end
	return isl.base or 0
end
function World.height(i, j)
	local isl = World.islandOfTile(i, j)
	return if isl then isl.H(i, j) else 0
end
-- island whose box is nearest a world tile point (camera / zone)
function World.nearest(x, z)
	local best, bd = World.list[1], math.huge
	for _, isl in World.list do
		if not World.isOpen(isl) then continue end
		local d = (math.max(0, math.abs(x - isl.cx) - isl.W / 2)) ^ 2 + (math.max(0, math.abs(z - isl.cz) - isl.N / 2)) ^ 2
		if d < bd then best, bd = isl, d end
	end
	return best
end
-- a free walkable tile near the island centre (for "Go to ...")
function World.arrival(isl)
	local best, bd
	for j = isl.oj, isl.oj + isl.N - 1 do
		for i = isl.oi, isl.oi + isl.W - 1 do
			local c = rawIsland(isl, i, j)
			if (c == 1 or c == 2 or c == 4) and isl.H(i, j) == 0 and not propNear(i + 0.5, j + 0.5, 1) then
				local d = (i + 0.5 - isl.cx) ^ 2 + (j + 0.5 - isl.cz - 3) ^ 2
				if not bd or d < bd then best, bd = { i, j }, d end
			end
		end
	end
	return best[1] + 0.5, best[2] + 0.5
end
-- the neighbour this island unlocks from (open earlier, adjacent; its bridge is built first)
function World.sourceBridge(isl)
	local best
	for _, br in World.bridges do
		if br.b == isl and (not best or br.a.need > best.a.need) and br.a.need < isl.need then best = br end
	end
	return best
end
return World
