--!nonstrict
-- Soundscape: the world's sound (spec: BUILD_BIBLE section 6). Everything is driven by where the hen stands, the hour
-- and the shared weather, so the mix is always right without per-place scripting.
--   * listener: SoundService listener follows the HEN (the camera is ~400 studs away with FOV 11, so a camera listener
--     would hear every 3D sound at the same far distance). Orientation follows the camera so left/right stays honest.
--   * beds: looping 2D layers (wind, leaves, shore, far sea, birds by day, crickets by night, rain, cave tone, crystal
--     hum) crossfaded by a per-zone mix x context (coast distance, foliage nearby, wind gusts, rain blend, night).
--   * spots: 3D loops placed on real things near the hen (the nearest pond / inland water, the nearest lanterns at
--     night) found from the map data and the WorldTree, refreshed at 1 Hz.
--   * one-shots: scheduled randomly around the hen in 3D (bird chirps near trees by day, seagulls near the coast, an owl
--     at night, wind gusts on gust peaks, far thunder in rain, drips in caves), never the same take twice in a row.
--   * footsteps: Birds calls Soundscape.footstep on every hop landing of the local hen; surface from the tile under her
--     (grass / dirt path / sand / wood deck / stone) with per-zone overrides; soft, pitched up (she is small).
--   * zones: per-island mix + reverb (SoundService.AmbientReverb). Soundscape.setZone("cave") forces a zone.
--   * menus: Soundscape.setMuffled(true) low-passes the world behind open windows; Soundscape.duck(k, s) dips it.
-- Ids: AmbienceIds.luau (generated by tools/audio/find_sounds.py, licensed Creator Store sounds). A slot with id 0
-- is silent. Volume: SoundGroup "Peckwoodambience" = Sfx category "ambience" (Settings slider via Sfx.setVolume).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("Peckwood")
local World = require(Shared:WaitForChild("World"))
local WorldTree = require(Shared:WaitForChild("WorldTree"))
local IDS = require(script.Parent:WaitForChild("AmbienceIds"))
local IslandView = require(script.Parent:WaitForChild("IslandView"))
local Ambience = require(script.Parent:WaitForChild("Ambience"))
local Sfx = require(script.Parent:WaitForChild("UI"):WaitForChild("Sfx"))

local Soundscape = {}
local S = 4                      -- studs per tile
local function tileOf(p: Vector3) return math.floor(p.X / S + 20), math.floor(p.Z / S + 15) end
local function worldOf(i, j) return Vector3.new((i + 0.5 - 20) * S, 0, (j + 0.5 - 15) * S) end
local rng = Random.new()

-- ---------------------------------------------------------------- mix tables
-- bed base volumes (Sound.Volume at full presence)
local BED = {
	wind_soft = 0.32, leaves = 0.3, sea_shore = 0.55, sea_far = 0.16, birds_day = 0.28, night_crickets = 0.26,
	rain_light = 0.55, cave_tone = 0.5, crystal_hum = 0.14,
}
-- per zone: multipliers on the beds + one-shot rates (per minute) + reverb + footstep surface override
local ZONES = {
	park       = { birds_day = 1, leaves = 1, sea = 1, wind_soft = 1, gulls = 3, chirps = 7 },
	garden     = { birds_day = 1.2, leaves = 0.8, sea = 0.8, wind_soft = 0.8, gulls = 1, chirps = 9 },
	castle     = { birds_day = 0.7, leaves = 0.6, sea = 0.9, wind_soft = 1.2, gulls = 2, chirps = 4, reverb = Enum.ReverbType.Plain },
	bridge     = { birds_day = 0.5, leaves = 0.4, sea = 1.5, wind_soft = 1.2, gulls = 8, chirps = 2 },
	forest     = { birds_day = 1.4, leaves = 1.6, sea = 0.5, wind_soft = 0.7, gulls = 0, chirps = 12, reverb = Enum.ReverbType.Forest },
	mine       = { birds_day = 0.2, leaves = 0.2, sea = 0.4, wind_soft = 0.9, cave_tone = 0.35, drips = 6, gulls = 0, chirps = 1, reverb = Enum.ReverbType.Quarry, surface = "stone" },
	desert     = { birds_day = 0.1, leaves = 0, sea = 0.6, wind_soft = 1.6, gulls = 1, chirps = 0, surface = "dirt" },
	expedition = { birds_day = 0.9, leaves = 1.2, sea = 0.8, wind_soft = 1.1, gulls = 2, chirps = 6, reverb = Enum.ReverbType.Mountains },
	echo       = { birds_day = 0.3, leaves = 0.3, sea = 0.7, wind_soft = 0.8, crystal_hum = 1, gulls = 1, chirps = 2, reverb = Enum.ReverbType.Auditorium },
	cave       = { birds_day = 0, leaves = 0, sea = 0, wind_soft = 0.15, cave_tone = 1, crystal_hum = 0.8, drips = 14, gulls = 0, chirps = 0, reverb = Enum.ReverbType.Cave, surface = "stone" },
}
local SURFACE = { [1] = "grass", [2] = "dirt", [4] = "dirt", [5] = "wood" }   -- tile code -> footstep slot suffix
local FOOT = { grass = { 0.22, 1.35 }, dirt = { 0.2, 1.5 }, wood = { 0.24, 1.6 }, stone = { 0.2, 1.7 } }   -- volume, speed

-- ---------------------------------------------------------------- state
local group, eq
local beds = {}                  -- slot -> { snd, cur, target }
local spots = {}                 -- name -> { att, snd, cur, target }
local shotAtts, shotK = {}, 0
local lastTake = {}              -- slot -> last id (no immediate repeats)
local zoneForced: string? = nil
local zone = "park"
local ctx = { coast = 0, foliage = 0, night = 0, gust = 0.5, rain = 0, breezy = 0 }
local muffled, duckK = false, 1
local anchorPart

local function idList(slot) local l = IDS[slot]; return if l and l[1] and l[1] > 0 then l else nil end
local function newSound(parent, id, vol, looped)
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. id
	s.Volume = vol; s.Looped = looped; s.SoundGroup = group
	s.RollOffMode = Enum.RollOffMode.InverseTapered; s.RollOffMinDistance = 10; s.RollOffMaxDistance = 90
	s.Parent = parent
	return s
end

-- ---------------------------------------------------------------- setup
function Soundscape.start()
	Sfx.CATEGORY.ambience = Sfx.CATEGORY.ambience or 0.8
	group = SoundService:FindFirstChild("Peckwoodambience") or Instance.new("SoundGroup")
	group.Name = "Peckwoodambience"; group.Volume = Sfx.CATEGORY.ambience; group.Parent = SoundService
	eq = Instance.new("EqualizerSoundEffect")   -- the "behind a menu" low-pass (0 = open air)
	eq.LowGain = 0; eq.MidGain = 0; eq.HighGain = 0; eq.Priority = 1; eq.Parent = group
	-- beds: 2D (parented to the group's service, not a part), random start so two players never hear the same loop
	for slot in BED do
		local l = idList(slot)
		if not l then continue end
		local s = newSound(SoundService, l[1], 0, true)
		s.Name = "Bed_" .. slot
		beds[slot] = { snd = s, cur = 0, target = 0 }
	end
	-- 3D anchors live in the WorldTree (Atmosphere), one part with attachments moved around the hen
	anchorPart = Instance.new("Part")
	anchorPart.Name = "SoundAnchors"; anchorPart.Anchored = true; anchorPart.CanCollide = false; anchorPart.CanQuery = false
	anchorPart.CanTouch = false; anchorPart.Transparency = 1; anchorPart.Size = Vector3.one * 0.2; anchorPart.CFrame = CFrame.new()
	anchorPart.Parent = WorldTree.get("Atmosphere")
	for _, name in { "pond", "lamp1", "lamp2" } do
		local slot = if name == "pond" then "pond" else "lamp_crackle"
		local l = idList(slot)
		local att = Instance.new("Attachment"); att.Name = name; att.Parent = anchorPart
		local snd = l and newSound(att, l[1], 0, true)
		spots[name] = { att = att, snd = snd, cur = 0, target = 0, base = if name == "pond" then 0.5 else 0.3 }
	end
	for k = 1, 6 do local a = Instance.new("Attachment"); a.Name = "Shot" .. k; a.Parent = anchorPart; shotAtts[k] = a end
	RunService.RenderStepped:Connect(Soundscape.frame)
	task.spawn(Soundscape.scanLoop)
	task.spawn(Soundscape.shotLoop)
end

-- ---------------------------------------------------------------- per frame: listener on the hen, smooth volumes
local mixT = 0
function Soundscape.frame(dt)
	local cam = workspace.CurrentCamera
	local hen = IslandView.birdPos or cam.Focus.Position
	local look = cam.CFrame - cam.CFrame.Position
	SoundService:SetListener(Enum.ListenerType.CFrame, CFrame.new(hen + Vector3.new(0, 4, 0)) * look)
	mixT += dt
	if mixT < 0.1 then return end    -- volumes at 10 Hz, eased (time constant ~1.2 s)
	local step = mixT; mixT = 0
	local k = 1 - math.exp(-step / 1.2)
	Soundscape.mix()
	for _, b in beds do
		b.cur += (b.target * duckK - b.cur) * k
		b.snd.Volume = b.cur
		local on = b.cur > 0.004
		if on and not b.snd.IsPlaying then b.snd.TimePosition = rng:NextNumber() * math.max(0, b.snd.TimeLength - 1); b.snd:Play()
		elseif not on and b.snd.IsPlaying then b.snd:Stop() end
	end
	for _, sp in spots do
		if not sp.snd then continue end
		sp.cur += (sp.target * duckK - sp.cur) * k
		sp.snd.Volume = sp.cur
		local on = sp.cur > 0.004
		if on and not sp.snd.IsPlaying then sp.snd:Play() elseif not on and sp.snd.IsPlaying then sp.snd:Stop() end
	end
end

-- the mix: zone x context -> bed targets
function Soundscape.mix()
	local Z = ZONES[zone] or ZONES.park
	local day = 1 - ctx.night
	local h = IslandView.hour()
	local dawn = if h > 5 and h < 8.5 then 1 - math.abs(h - 6.6) / 1.9 else 0   -- dawn chorus
	local set = function(slot, v) local b = beds[slot]; if b then b.target = math.clamp(v, 0, 1.2) * BED[slot] end end
	set("wind_soft", (Z.wind_soft or 1) * (0.45 + ctx.gust * 0.55 + ctx.breezy * 0.6) * (1 - ctx.rain * 0.3))
	set("leaves", (Z.leaves or 0) * ctx.foliage * (0.35 + ctx.gust * 0.65 + ctx.breezy * 0.5))
	set("sea_shore", (Z.sea or 0) * ctx.coast)
	set("sea_far", (Z.sea or 0) * (0.4 + 0.6 * (1 - ctx.coast)))
	set("birds_day", (Z.birds_day or 0) * day * (0.55 + 0.45 * ctx.foliage + dawn * 0.8) * (1 - ctx.rain * 0.85))
	set("night_crickets", ctx.night * (if zone == "cave" or zone == "mine" then 0.1 else 1) * (1 - ctx.rain * 0.7))
	set("rain_light", ctx.rain * (if zone == "cave" then 0 else 1))
	set("cave_tone", Z.cave_tone or 0)
	set("crystal_hum", Z.crystal_hum or 0)
	eq.HighGain = if muffled then -22 else 0
	eq.MidGain = if muffled then -6 else 0
	SoundService.AmbientReverb = Z.reverb or Enum.ReverbType.NoReverb
end

-- ---------------------------------------------------------------- 1 Hz scan: zone, coast distance, foliage, spots
local foliageCache, lampCache, cacheT = {}, {}, 0
local function rebuildCaches()
	foliageCache, lampCache = {}, {}
	local islands = WorldTree.get("Islands")
	for _, isl in islands:GetChildren() do
		local fol = isl:FindFirstChild("Foliage")
		if fol then for _, m in fol:GetChildren() do if m:IsA("Model") then table.insert(foliageCache, m:GetPivot().Position) end end end
		local props = isl:FindFirstChild("Props")
		if props then for _, m in props:GetChildren() do if m.Name == "lantern" and m:IsA("Model") then table.insert(lampCache, m:GetPivot().Position) end end end
	end
end
function Soundscape.scanLoop()
	while true do
		local hen = IslandView.birdPos or workspace.CurrentCamera.Focus.Position
		local i, j = tileOf(hen)
		-- zone: forced (cave) or the nearest open island's area
		local isl = World.nearest(i, j)
		local id = isl and ((isl.area or isl.id) :: string):gsub("^region:", "") or "park"
		zone = zoneForced or (if ZONES[id] then id else "park")
		-- coast: nearest sea tile within 8 tiles (16 directions), 1 = standing on the shore
		local d = 9
		for r = 1, 8 do
			for a = 0, 15 do
				local ang = a / 16 * math.pi * 2
				if World.tile(math.floor(i + math.cos(ang) * r + 0.5), math.floor(j + math.sin(ang) * r + 0.5)) == 0 then d = r; break end
			end
			if d <= r then break end
		end
		ctx.coast = math.clamp(1 - (d - 1) / 7, 0, 1)
		-- foliage + lanterns from the WorldTree (cached, refreshed every 5 s or when islands mount)
		cacheT -= 1
		if cacheT <= 0 then rebuildCaches(); cacheT = 5 end
		local n = 0
		for _, p in foliageCache do if (p - hen).Magnitude < 40 then n += 1 end end
		ctx.foliage = math.clamp(n / 8, 0, 1)
		-- pond: nearest inland water tile (code 3) within 10 tiles
		local best, bd = nil, math.huge
		for dj = -10, 10 do for di = -10, 10 do
			if World.tile(i + di, j + dj) == 3 then local dd = di * di + dj * dj; if dd < bd then best, bd = Vector3.new(i + di, 0, j + dj), dd end end
		end end
		local pond = spots.pond
		if best then pond.att.WorldPosition = worldOf(best.X, best.Z) + Vector3.new(0, 1, 0); pond.target = pond.base else pond.target = 0 end
		-- lanterns: the two nearest within 35 studs crackle softly at night
		table.sort(lampCache, function(a, b) return (a - hen).Magnitude < (b - hen).Magnitude end)
		for k2, name in { "lamp1", "lamp2" } do
			local sp, p = spots[name], lampCache[k2]
			if p and (p - hen).Magnitude < 35 then sp.att.WorldPosition = p + Vector3.new(0, 6, 0); sp.target = sp.base * ctx.night else sp.target = 0 end
		end
		-- time + weather (shared with Ambience, so particles and sound always agree)
		local h = IslandView.hour()
		ctx.night = if h >= 20 or h < 5 then 1 elseif h > 18.5 then (h - 18.5) / 1.5 elseif h < 6.5 then 1 - (h - 5) / 1.5 else 0
		local b = Ambience.blend or {}
		ctx.rain, ctx.breezy = b.rain or 0, b.breezy or 0
		ctx.gust = IslandView.wind(workspace:GetServerTimeNow())
		task.wait(1)
	end
end

-- ---------------------------------------------------------------- one-shots
local function playShot(slot, pos: Vector3?, vol, speed, maxLen: number?)
	local l = idList(slot); if not l then return end
	local id = l[rng:NextInteger(1, #l)]
	if #l > 1 and id == lastTake[slot] then id = l[(table.find(l, id) :: number) % #l + 1] end
	lastTake[slot] = id
	local parent
	if pos then shotK = shotK % #shotAtts + 1; local a = shotAtts[shotK]; a.WorldPosition = pos; parent = a else parent = SoundService end
	local s = newSound(parent, id, vol * (0.85 + rng:NextNumber() * 0.3) * duckK, false)
	s.PlaybackSpeed = (speed or 1) * (0.92 + rng:NextNumber() * 0.16)
	s.Ended:Once(function() s:Destroy() end)
	s:Play()
	if maxLen then   -- library takes often hold several hits: keep the first, fade the tail
		task.delay(maxLen, function()
			if not s.Parent then return end
			local tw = TweenService:Create(s, TweenInfo.new(0.06), { Volume = 0 }); tw:Play()
			tw.Completed:Once(function() s:Destroy() end)
		end)
	end
	task.delay(12, function() if s.Parent then s:Destroy() end end)
end
local function around(hen, rMin, rMax)
	local a, r = rng:NextNumber() * math.pi * 2, rMin + rng:NextNumber() * (rMax - rMin)
	return hen + Vector3.new(math.cos(a) * r, 3 + rng:NextNumber() * 6, math.sin(a) * r)
end
function Soundscape.shotLoop()
	local lastGust = 0
	while true do
		task.wait(0.5)
		local hen = IslandView.birdPos or workspace.CurrentCamera.Focus.Position
		local Z = ZONES[zone] or ZONES.park
		local day, p = 1 - ctx.night, 0.5 / 60   -- per-minute rates -> chance per 0.5 s tick
		if rng:NextNumber() < (Z.chirps or 0) * day * (0.3 + ctx.foliage) * (1 - ctx.rain) * p then
			-- a chirp from the nearest tree when there is one, else somewhere around
			local tree
			for _, q in foliageCache do if (q - hen).Magnitude < 30 then tree = q; break end end
			playShot("bird_chirp", if tree then tree + Vector3.new(0, 8, 0) else around(hen, 12, 30), 0.35, 1.05)
		end
		if rng:NextNumber() < (Z.gulls or 0) * ctx.coast * day * p then playShot("seagull", around(hen, 25, 45), 0.4) end
		if rng:NextNumber() < 1.5 * ctx.night * (if zone == "cave" then 0 else 1) * p then playShot("night_owl", around(hen, 30, 50), 0.32) end
		if rng:NextNumber() < (Z.drips or 0) * p then playShot("cave_drip", around(hen, 6, 22), 0.4, 1) end
		if ctx.rain > 0.6 and rng:NextNumber() < 1.2 * p then playShot("thunder_far", nil, 0.3 * ctx.rain, 0.9) end
		-- a gust whoosh on each rising gust peak (shared wind signal), at most every 8 s
		local now = os.clock()
		if ctx.gust + ctx.breezy * 0.4 > 0.95 and now - lastGust > 8 and zone ~= "cave" then lastGust = now; playShot("wind_gust", nil, 0.22) end
	end
end

-- ---------------------------------------------------------------- footsteps (Birds.onStep -> here)
local lastFoot = 0
function Soundscape.footstep(feet: Vector3, heavy: boolean?)
	local now = os.clock()
	if now - lastFoot < 0.07 then return end
	lastFoot = now
	local Z = ZONES[zone] or ZONES.park
	local i, j = tileOf(feet)
	local surf = Z.surface or SURFACE[World.tile(i, j)] or "grass"
	if World.tile(i, j) == 5 then surf = "wood" end   -- decks are wood everywhere
	local f = FOOT[surf]
	playShot("step_" .. surf, nil, f[1] * (if heavy then 1.6 else 1), f[2] * (if heavy then 0.85 else 1), if heavy then 0.32 else 0.18)
end

-- ---------------------------------------------------------------- API for other systems
function Soundscape.setZone(z: string?) zoneForced = z end                 -- "cave" in caves; nil = follow the map
function Soundscape.setMuffled(on: boolean) muffled = on end               -- UI: a window is open
function Soundscape.duck(k: number, seconds: number)                       -- big moments: dip the world, ease back
	duckK = k
	task.delay(seconds, function() duckK = 1 end)
end
Soundscape.ZONES, Soundscape.BED = ZONES, BED
return Soundscape
